          </Properties>
          <Item class="ModuleScript" referent="RBX0000003A">
            <Properties>
              <string name="Name">Editor</string>
              <ProtectedString name="Source">--!nonstrict
-- Редактор карты: вкладки, инструменты, выбор объектов, ручки, тест и публикация

local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Workshop"):WaitForChild("Shared")
local UiText = require(Shared.UiText)
local Model = require(Shared.Model)
local Util = require(Shared.Util)
local Closet = require(Shared.Closet)
local Prefabs = require(Shared.Prefabs)
local Remotes = require(Shared.Roblox.Remotes)
local Convert = require(Shared.Roblox.Convert)
local WorldBuilder = require(Shared.Roblox.WorldBuilder)

local Kit = require(script.Parent.Parent.UI.Kit)
local State = require(script.Parent.State)
local Preview = require(script.Parent.Preview)
local FreeCamera = require(script.Parent.FreeCamera)
local Gizmo = require(script.Parent.Gizmo)
local Panels = script.Parent.Panels

local L, H = UiText.L, UiText.H

local Editor = {}
Editor.__index = Editor

local TABS = {
	{ id = "map", title = L.TabMap },
	{ id = "objects", title = L.TabObjects },
	{ id = "models", title = L.TabModels },
	{ id = "creatures", title = L.TabCreatures },
	{ id = "anim", title = L.TabAnimation },
	{ id = "logic", title = L.TabLogic },
	{ id = "camera", title = L.TabCamera },
	{ id = "texts", title = L.TabTexts },
}

local STATUS = {
	saved = { L.SaveSaved, Kit.C.good },
	dirty = { L.SaveDirty, Kit.C.dim },
	saving = { L.SaveSaving, Kit.C.dim },
	failed = { L.SaveFailed, Kit.C.bad },
	readonly = { L.SaveReadOnly, Kit.C.warn },
}

function Editor.new(app, project, readOnly: boolean)
	local self = setmetatable({}, Editor)
	self.app = app
	self.state = State.new(project, readOnly)
	self.preview = Preview.new(self.state)
	self.camera = FreeCamera.new(Preview.ORIGIN + Vector3.new(0, 4, 0))
	self.gizmo = Gizmo.new(self.camera)
	self.selection = {} :: { string }
	self.selPart = nil :: string?
	self.modelEdit = nil :: string?
	self.tool = "move"
	self.grid = 1
	self.multi = false
	self.tab = "map"
	self.pickCallback = nil
	self.logicErrors = {}
	self.panelCleanup = nil
	self.helpers = {}
	self.selectionChanged = State.signal()

	self:buildUi()
	self.camera.onTap = function(pos)
		self:onTap(pos)
	end
	self.state.changed.connect(function()
		self:afterChange()
	end)
	self.state.resynced.connect(function()
		self:afterChange()
		self:renderPanel()
	end)
	self.state.status.connect(function(st)
		self:setStatus(st)
	end)
	self.state.rejected.connect(function(reason)
		if reason == "frozen" then
			Kit.toast(self.gui, H.FrozenHint)
		elseif reason == "name_taken" then
			Kit.toast(self.gui, H.NameTakenHint, Kit.C.bad, 4)
		end
	end)
	self.preview.onRebuilt = function(id)
		if table.find(self.selection, id) then
			task.defer(function()
				self:updateGizmo()
			end)
		end
	end
	self.keyConn = UserInputService.InputBegan:Connect(function(input, processed)
		if processed or UserInputService:GetFocusedTextBox() then
			return
		end
		local ctrl = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.LeftMeta)
		if ctrl and input.KeyCode == Enum.KeyCode.Z then
			self.state:undo()
		elseif ctrl and input.KeyCode == Enum.KeyCode.Y then
			self.state:redo()
		elseif ctrl and input.KeyCode == Enum.KeyCode.C then
			self:copySelection()
		elseif ctrl and input.KeyCode == Enum.KeyCode.V then
			self:paste()
		elseif ctrl and input.KeyCode == Enum.KeyCode.D then
			self:duplicate()
		elseif input.KeyCode == Enum.KeyCode.F then
			self:focusSelection()
		elseif input.KeyCode == Enum.KeyCode.Delete then
			self:deleteSelection()
		elseif input.KeyCode == Enum.KeyCode.One then
			self:setTool("select")
		elseif input.KeyCode == Enum.KeyCode.Two then
			self:setTool("move")
		elseif input.KeyCode == Enum.KeyCode.Three then
			self:setTool("rotate")
		elseif input.KeyCode == Enum.KeyCode.Four then
			self:setTool("scale")
		end
	end)
	self:setStatus(if readOnly then "readonly" else "saved")
	self:selectTab("map")
	local count = 0
	for _ in project.map.objects do
		count += 1
	end
	if count &lt; 3 and not app.startGuideShown then
		app.startGuideShown = true
		self:showStartGuide()
	end
	return self
end

-- ---------------------------------------------------------------------------
-- Интерфейс

function Editor:buildUi()
	local gui = Instance.new("ScreenGui")
	gui.Name = "WsEditor"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = self.app.playerGui
	self.gui = gui
	local compact = Kit.compact()
	self.compact = compact
	-- размеры раскладки: на телефоне всё тоньше, чтобы карта занимала большую часть экрана
	local TOP = if compact then 44 else 52
	local TABH = if compact then 40 else 44
	local RAIL = if compact then 64 else 80
	self.L = { top = TOP, tabs = TABH, rail = RAIL, head = TOP + TABH }
	self.panelOpen = not compact
	self.uiHidden = false
	self.chrome = {} -- всё, что прячет кнопка «Скрыть интерфейс»

	-- верхняя строка
	local top = Kit.frame(gui, { Size = UDim2.new(1, 0, 0, TOP), BackgroundColor3 = Kit.C.bg })
	Kit.pad(top, 4)
	table.insert(self.chrome, top)
	Kit.button(top, "←", function()
		self.app:closeEditor()
	end, { Size = UDim2.new(0, TOP, 1, 0), TextSize = 20 })
	self.nameLabel = Kit.label(top, self.state.project.meta.name, {
		Position = UDim2.fromOffset(TOP + 6, 0), Size = UDim2.new(0.35, -TOP - 6, 1, 0), Font = Kit.FONT_BOLD, TextSize = if compact then 14 else 16,
		TextTruncate = Enum.TextTruncate.AtEnd, TextWrapped = false,
	})
	local right = Kit.frame(top, { BackgroundTransparency = 1, Size = UDim2.new(0.65, 0, 1, 0), Position = UDim2.new(0.35, 0, 0, 0) })
	local rl = Kit.list(right, 4, true)
	rl.HorizontalAlignment = Enum.HorizontalAlignment.Right
	self.statusLabel = Kit.label(right, "", { Size = UDim2.new(0, if compact then 86 else 120, 1, 0), TextXAlignment = Enum.TextXAlignment.Right, TextSize = 13, LayoutOrder = 1 })
	Kit.button(right, if compact then "▶" else L.Test, function()
		self:startTest()
	end, { Size = UDim2.new(0, if compact then TOP else 130, 1, 0), LayoutOrder = 2, BackgroundColor3 = Kit.C.accentDim, TextSize = if compact then 18 else 15 })
	Kit.button(right, if compact then "⬆" else L.Publish, function()
		self:publish()
	end, { Size = UDim2.new(0, if compact then TOP else 130, 1, 0), LayoutOrder = 3, BackgroundColor3 = Kit.C.accent, TextSize = if compact then 18 else 15 })
	Kit.button(right, L.HideUi, function()
		self:setUiHidden(true)
	end, { Size = UDim2.new(0, TOP, 1, 0), LayoutOrder = 4, TextSize = 18 })

	-- вкладки
	local tabs = Kit.scroll(gui, {
		Size = UDim2.new(1, 0, 0, TABH), Position = UDim2.fromOffset(0, TOP), BackgroundTransparency = 0,
		BackgroundColor3 = Kit.C.panel, ScrollingDirection = Enum.ScrollingDirection.X,
		AutomaticCanvasSize = Enum.AutomaticSize.X, ScrollBarThickness = 0,
	})
	table.insert(self.chrome, tabs)
	Kit.pad(tabs, 2)
	Kit.list(tabs, 4, true)
	self.tabButtons = {}
	for i, t in TABS do
		self.tabButtons[t.id] = Kit.button(tabs, t.title, function()
			self:selectTab(t.id)
			self:setPanelOpen(true)
		end, { Size = UDim2.new(0, if compact then 96 else 112, 1, 0), LayoutOrder = i, TextSize = if compact then 13 else 15 })
	end

	-- инструменты слева
	local rail = Kit.scroll(gui, {
		Size = UDim2.new(0, RAIL, 1, -(TOP + TABH)), Position = UDim2.fromOffset(0, TOP + TABH), BackgroundTransparency = 0.15,
		BackgroundColor3 = Kit.C.bg, ScrollBarThickness = 3,
	})
	table.insert(self.chrome, rail)
	Kit.pad(rail, 3)
	Kit.list(rail, 4)
	self.rail = rail
	self.toolButtons = {}
	local function railButton(text: string, fn: () -&gt; (), order: number)
		return Kit.button(rail, text, fn, { Size = UDim2.new(1, 0, 0, Kit.TAP), TextSize = if compact then 11 else 13, LayoutOrder = order })
	end
	local tools = { { "select", L.IconSelect }, { "move", L.IconMove }, { "rotate", L.IconRotate }, { "scale", L.IconScale } }
	for i, t in tools do
		self.toolButtons[t[1]] = railButton(t[2], function()
			self:setTool(t[1])
		end, i)
	end
	self.gridButton = railButton(L.Grid, function()
		self.grid = if self.grid == 1 then 0.5 elseif self.grid == 0.5 then 0 else 1
		self:updateGridButton()
	end, 10)
	self.multiButton = railButton(L.MultiSelect, function()
		self.multi = not self.multi
		Kit.setActive(self.multiButton, self.multi)
	end, 11)
	railButton("↶\n" .. L.Undo, function()
		self.state:undo()
	end, 20)
	railButton("↷\n" .. L.Redo, function()
		self.state:redo()
	end, 21)
	self.freezeButton = railButton(L.Freeze, function()
		self:toggleFreeze()
	end, 30)
	railButton(L.Glue, function()
		self:glue()
	end, 31)
	self:updateGridButton()

	-- панель вкладки: справа на планшете, снизу на телефоне; на телефоне закрыта, пока не нужна
	local panelFrame = Kit.frame(gui, { BackgroundTransparency = 0.04 })
	Kit.corner(panelFrame, 12)
	table.insert(self.chrome, panelFrame)
	self.panelFrame = panelFrame
	local closeH = if compact then 36 else 0
	if compact then
		local grip = Kit.button(panelFrame, "▾  " .. L.Close, function()
			self:setPanelOpen(false)
		end, { Size = UDim2.new(1, 0, 0, closeH), BackgroundTransparency = 1, TextSize = 13, TextColor3 = Kit.C.dim })
		grip.ZIndex = 3
	end
	local panel = Kit.frame(panelFrame, { BackgroundTransparency = 1, Position = UDim2.fromOffset(8, closeH + 4), Size = UDim2.new(1, -16, 1, -closeH - 12) })
	self.panel = panel

	-- нижняя полоса (шкала анимации)
	local bottom = Kit.frame(gui, { Visible = false, BackgroundTransparency = 0.05 })
	Kit.corner(bottom, 10)
	Kit.pad(bottom, 6)
	table.insert(self.chrome, bottom)
	self.bottom = bottom

	self.hint = Kit.label(gui, "", {
		Position = UDim2.new(0, RAIL + 8, 0, TOP + TABH + 4), Size = UDim2.new(0.6, 0, 0, 40), TextColor3 = Kit.C.text,
		TextStrokeTransparency = 0.4, TextSize = 14, Visible = false,
	})

	-- кнопки поверх карты: небольшие и полупрозрачные
	self.addButton = Kit.button(gui, L.AddBig, function()
		self:openAddMenu()
	end, { Size = UDim2.fromOffset(if compact then 130 else 160, Kit.TAP), BackgroundColor3 = Kit.C.accent, Font = Kit.FONT_BOLD, TextSize = 17, ZIndex = 4 })
	table.insert(self.chrome, self.addButton)

	local camBar = Kit.frame(gui, { BackgroundTransparency = 1, ZIndex = 4, Size = UDim2.fromOffset(4 * (Kit.TAP + 4), Kit.TAP) })
	Kit.list(camBar, 4, true)
	table.insert(self.chrome, camBar)
	local function camButton(text: string, fn: () -&gt; (), order: number)
		return Kit.button(camBar, text, fn, { Size = UDim2.fromOffset(Kit.TAP, Kit.TAP), TextSize = 20, LayoutOrder = order, BackgroundTransparency = 0.3 })
	end
	camButton(L.ZoomIn, function()
		self.camera.dist = math.max(4, self.camera.dist * 0.75)
	end, 1)
	camButton(L.ZoomOut, function()
		self.camera.dist = math.min(400, self.camera.dist * 1.33)
	end, 2)
	camButton("◎", function()
		self:focusSelection()
	end, 3)
	self.flyButton = camButton("✈", function()
		self:setFly(not self.flyOn)
	end, 4)
	self.camBar = camBar

	-- полёт пальцем: держите стрелки, ⇧ и ⇩ поднимают и опускают камеру
	local pad = Kit.frame(gui, { BackgroundTransparency = 1, Visible = false, ZIndex = 4, Size = UDim2.fromOffset(3 * (Kit.TAP + 4) + Kit.TAP + 8, 2 * (Kit.TAP + 4)) })
	table.insert(self.chrome, pad)
	self.flyPad = pad
	local function hold(text: string, dir: Vector3, x: number, y: number)
		local b = Kit.button(pad, text, nil, { Size = UDim2.fromOffset(Kit.TAP, Kit.TAP), Position = UDim2.fromOffset(x, y), BackgroundTransparency = 0.3, TextSize = 20 })
		b.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
				self.camera.padMove += dir
				self.camera.blockDrag = true
			end
		end)
		b.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
				self.camera.padMove -= dir
				if self.camera.padMove.Magnitude &lt; 0.01 then
					self.camera.padMove = Vector3.zero
				end
				self.camera.blockDrag = false
			end
		end)
	end
	local s = Kit.TAP + 4
	hold("▲", Vector3.new(0, 0, -1), s, 0)
	hold("◀", Vector3.new(-1, 0, 0), 0, s)
	hold("▼", Vector3.new(0, 0, 1), s, s)
	hold("▶", Vector3.new(1, 0, 0), 2 * s, s)
	hold("⇧", Vector3.new(0, 1, 0), 3 * s + 8, 0)
	hold("⇩", Vector3.new(0, -1, 0), 3 * s + 8, s)

	-- полоса действий для выбранного объекта (как контекстное меню Studio)
	local selBar = Kit.scroll(gui, {
		BackgroundTransparency = 0.2, BackgroundColor3 = Kit.C.bg, Visible = false, ZIndex = 4,
		ScrollingDirection = Enum.ScrollingDirection.X, AutomaticCanvasSize = Enum.AutomaticSize.X, ScrollBarThickness = 0,
	})
	Kit.corner(selBar, 10)
	Kit.pad(selBar, 4)
	Kit.list(selBar, 4, true)
	table.insert(self.chrome, selBar)
	self.selBar = selBar
	local function selButton(text: string, fn: () -&gt; (), order: number, color: Color3?)
		return Kit.button(selBar, text, fn, { Size = UDim2.new(0, if compact then 84 else 100, 1, 0), TextSize = 13, LayoutOrder = order, BackgroundColor3 = color or Kit.C.panel2, ZIndex = 5 })
	end
	selButton(L.PropertiesShort, function()
		self:setPanelOpen(true)
		if self.tab ~= "map" and self.tab ~= "models" and self.tab ~= "texts" then
			self:selectTab("map")
		end
	end, 1, Kit.C.accentDim)
	selButton(L.Copy, function()
		self:copySelection()
	end, 2)
	selButton(L.Paste, function()
		self:paste()
	end, 3)
	selButton(L.Duplicate, function()
		self:duplicate()
	end, 4)
	selButton(L.Rotate90, function()
		self:rotate90()
	end, 5)
	selButton(L.DropToFloor, function()
		self:dropToFloor()
	end, 6)
	selButton(L.SnapToGrid, function()
		self:snapToGrid()
	end, 7)
	selButton(L.Delete, function()
		self:deleteSelection()
	end, 8, Kit.C.bad)

	-- вернуть интерфейс
	self.showUiButton = Kit.button(gui, L.HideUi, function()
		self:setUiHidden(false)
	end, { Size = UDim2.fromOffset(Kit.TAP, Kit.TAP), Position = UDim2.new(1, -Kit.TAP - 8, 0, 8), Visible = false, BackgroundTransparency = 0.3, TextSize = 18, ZIndex = 9 })

	-- платформа редактора: видна только автору, нужна для прицела и ориентира на пустой карте
	local ground = Instance.new("Part")
	ground.Name = "WsGround"
	ground.Anchored = true
	ground.CanCollide = false
	ground.Size = Vector3.new(2048, 0.2, 2048)
	ground.CFrame = CFrame.new(Preview.ORIGIN + Vector3.new(0, -0.15, 0))
	ground.Color = Color3.fromRGB(70, 74, 82)
	ground.Material = Enum.Material.SmoothPlastic
	ground.Transparency = 0.55
	ground.Parent = self.preview.folder
	local grid = Instance.new("Texture")
	grid.Texture = "rbxasset://textures/SpawnLocation.png"
	grid.Face = Enum.NormalId.Top
	grid.StudsPerTileU = 4
	grid.StudsPerTileV = 4
	grid.Transparency = 0.85
	grid.Parent = ground
	self.ground = ground

	self:layout()
	self.layoutConn = workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
		self:layout()
	end)
end

-- Раскладка: панель, шкала анимации и кнопки над картой не перекрывают друг друга
function Editor:layout()
	local L0 = self.L
	local compact = self.compact
	local wide = self.tab == "logic"
	local panelOpen = self.panelOpen and self.tab ~= "anim"
	local panelFrame = self.panelFrame
	local sheet = 0 -- доля экрана снизу, занятая панелью или шкалой
	if compact then
		local h = if wide then 0.62 else 0.48
		panelFrame.Size = UDim2.new(1, -L0.rail - 8, h, -4)
		panelFrame.Position = UDim2.new(0, L0.rail + 4, 1 - h, 0)
		panelFrame.Visible = panelOpen and not self.uiHidden
		if panelOpen then
			sheet = h
		end
		self.bottom.Size = UDim2.new(1, -L0.rail - 8, 0.46, -4)
		self.bottom.Position = UDim2.new(0, L0.rail + 4, 0.54, 0)
		if self.tab == "anim" then
			sheet = 0.46
		end
	else
		local w = if wide then 560 else 340
		panelFrame.Size = UDim2.new(0, w, 1, -L0.head - 4)
		panelFrame.Position = UDim2.new(1, -w - 4, 0, L0.head + 2)
		panelFrame.Visible = panelOpen and not self.uiHidden
		self.bottom.Size = UDim2.new(1, -L0.rail - 352, 0, 210)
		self.bottom.Position = UDim2.new(0, L0.rail + 4, 1, -214)
	end
	self.bottom.Visible = self.tab == "anim" and not self.uiHidden
	local rightInset = if not compact and panelOpen then (if wide then 568 else 348) else 8
	local bottomPx = if not compact and self.tab == "anim" then 220 else 0
	local y = UDim2.new(0, 0, 1 - sheet, -bottomPx - Kit.TAP - 10)
	self.addButton.Position = UDim2.new(0, L0.rail + 8, y.Y.Scale, y.Y.Offset)
	self.camBar.Position = UDim2.new(1, -rightInset - self.camBar.Size.X.Offset, y.Y.Scale, y.Y.Offset)
	self.flyPad.Position = UDim2.new(0, L0.rail + 8, y.Y.Scale, y.Y.Offset - self.flyPad.Size.Y.Offset - 8)
	local barW = math.min(8 * 104, Kit.viewport().X - L0.rail - rightInset - 24)
	self.selBar.Size = UDim2.new(0, barW, 0, Kit.TAP + 8)
	self.selBar.Position = UDim2.new(0, L0.rail + 8, y.Y.Scale, y.Y.Offset - Kit.TAP - 16)
	local hasSel = (#self.selection &gt; 0 or self.selPart ~= nil) and not self.uiHidden and self.tab ~= "anim"
	self.selBar.Visible = hasSel
	if hasSel and self.flyOn then
		self.flyPad.Position = UDim2.new(0, L0.rail + 8, y.Y.Scale, y.Y.Offset - Kit.TAP - 24 - self.flyPad.Size.Y.Offset)
	end
	self.flyPad.Visible = self.flyOn == true and not self.uiHidden
end

function Editor:setPanelOpen(open: boolean)
	self.panelOpen = open
	self:layout()
end

function Editor:setUiHidden(hidden: boolean)
	self.uiHidden = hidden
	for _, g in self.chrome do
		if g ~= self.panelFrame and g ~= self.bottom and g ~= self.selBar and g ~= self.flyPad then
			g.Visible = not hidden
		end
	end
	self.showUiButton.Visible = hidden
	self:layout()
end

function Editor:setFly(on: boolean)
	self.flyOn = on
	Kit.setActive(self.flyButton, on)
	if on then
		Kit.toast(self.gui, H.FlyHint, nil, 3)
	else
		self.camera.padMove = Vector3.zero
	end
	self:layout()
end

-- Studio-подобные действия над выбором
function Editor:copySelection()
	local list = {}
	for _, id in self.selection do
		local o = self.state:obj(id)
		if o then
			table.insert(list, Util.deepCopy(o))
		end
	end
	if #list &gt; 0 then
		self.app.clipboard = list
		Kit.toast(self.gui, L.Copied, nil, 1.5)
	end
end

function Editor:paste()
	local clip = self.app.clipboard
	if not clip or #clip == 0 then
		return
	end
	local op, copies = Model.paste(self.state.project, clip, self.preview:placementPoint(self.grid))
	if op and self.state:apply(op) then
		local ids = {}
		for _, c in copies do
			table.insert(ids, c.id)
		end
		self:select(ids)
	end
end

function Editor:rotate90()
	local ops = {}
	for _, id in self.selection do
		local o = self.state:obj(id)
		if o and not o.frozen then
			table.insert(ops, { op = "set", id = id, path = { "rot" }, value = { o.rot[1], (o.rot[2] + 90) % 360, o.rot[3] } })
		end
	end
	if #ops &gt; 0 then
		self.state:apply({ op = "batch", ops = ops })
	else
		Kit.toast(self.gui, H.FrozenHint)
	end
end

function Editor:snapToGrid()
	local step = if self.grid &gt; 0 then self.grid else 1
	local ops = {}
	for _, id in self.selection do
		local o = self.state:obj(id)
		if o and not o.frozen then
			local p = {}
			for i = 1, 3 do
				p[i] = math.floor(o.pos[i] / step + 0.5) * step
			end
			-- высота у детали: низ на сетке
			if o.size then
				p[2] = math.floor((o.pos[2] - o.size[2] / 2) / step + 0.5) * step + o.size[2] / 2
			end
			table.insert(ops, { op = "set", id = id, path = { "pos" }, value = p })
		end
	end
	if #ops &gt; 0 then
		self.state:apply({ op = "batch", ops = ops })
	end
end

-- «На пол»: опустить объект на ближайшую поверхность под ним
function Editor:dropToFloor()
	for _, id in self.selection do
		local o = self.state:obj(id)
		local h = self.preview.handles[id]
		if o and h and not o.frozen then
			local cf, size
			if h.root:IsA("Model") then
				cf, size = (h.root :: Model):GetBoundingBox()
			else
				local part = h.root :: BasePart
				cf = part.CFrame
				local x, y, z, r00, r01, r02, r10, r11, r12 = cf:GetComponents()
				local _ = x + y + z + r00 + r01 + r02
				local half = 0.5 * (math.abs(r10) * part.Size.X + math.abs(r11) * part.Size.Y + math.abs(r12) * part.Size.Z)
				size = Vector3.new(0, half * 2, 0)
			end
			local bottom = cf.Position.Y - size.Y / 2
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			params.FilterDescendantsInstances = { h.root }
			local hit = workspace:Raycast(Vector3.new(cf.Position.X, bottom + 0.05, cf.Position.Z), Vector3.new(0, -500, 0), params)
			local floorY = if hit then hit.Position.Y else Preview.ORIGIN.Y
			local dy = floorY - bottom
			if math.abs(dy) &gt; 0.01 then
				local p = table.clone(o.pos)
				p[2] = math.floor((p[2] + dy) * 1000 + 0.5) / 1000
				self.state:apply({ op = "set", id = id, path = { "pos" }, value = p })
			end
		end
	end
end

function Editor:openAddMenu()
	local Catalog = require(Shared.Catalog)
	Kit.choose(self.gui, L.AddBig, {
		{ id = "shape", title = L.AddShape, hint = L.Shapes },
		{ id = "prefab", title = L.AddFromCatalog, hint = L.AddPrefab },
		{ id = "mine", title = L.MyModels },
	}, function(kind)
		if kind == "shape" then
			local opts = {}
			for _, s in Catalog.SHAPES do
				table.insert(opts, { id = s.id, title = s.title })
			end
			Kit.choose(self.gui, L.Shapes, opts, function(shape)
				self:addShape(shape)
			end)
		elseif kind == "prefab" then
			local opts = {}
			for _, p in Catalog.PREFABS do
				table.insert(opts, { id = p.id, title = p.title, hint = p.group })
			end
			Kit.choose(self.gui, L.AddFromCatalog, opts, function(pid)
				self:addPrefab(pid)
			end)
		else
			self:addFromLibrary()
		end
	end)
end

function Editor:addFromLibrary()
	local res = Remotes.fn("Request"):InvokeServer("ListLibrary")
	if not res or not res.ok then
		Kit.toast(self.gui, L.LoadFailed, Kit.C.bad)
		return
	end
	local opts = {}
	for _, m in res.models do
		table.insert(opts, { id = m.id, title = m.name })
	end
	if #opts == 0 then
		Kit.toast(self.gui, L.NothingHere)
		return
	end
	Kit.choose(self.gui, L.MyModels, opts, function(assetId)
		local r = Remotes.fn("Request"):InvokeServer("GetLibraryModel", assetId)
		if r and r.ok then
			self:addObjects({ Model.fromAsset(self.state.project, r.asset, self.preview:placementPoint(self.grid)) })
		else
			Kit.toast(self.gui, L.LoadFailed, Kit.C.bad)
		end
	end)
end

function Editor:focusSelection()
	local id = self.modelEdit or self.selection[1]
	local h = id and self.preview.handles[id]
	if not h then
		return
	end
	local pos = if h.root:IsA("Model") then (h.root :: Model):GetPivot().Position else (h.root :: BasePart).Position
	self.camera:focusOn(pos + Vector3.new(0, 2, 0))
	self.camera.dist = math.clamp(self.camera.dist, 10, 40)
end

-- Короткая подсказка «Как начать»: три шага, закрывается кнопкой «Понятно»
function Editor:showStartGuide()
	local shade = Kit.frame(self.gui, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.45, ZIndex = 60 })
	local v = Kit.viewport()
	local w = math.min(460, v.X - 32)
	local box = Kit.frame(shade, { Size = UDim2.fromOffset(w, 0), AutomaticSize = Enum.AutomaticSize.Y, Position = UDim2.new(0.5, -w / 2, 0.15, 0), ZIndex = 61 })
	Kit.corner(box, 14)
	Kit.pad(box, 14)
	Kit.list(box, 10)
	Kit.label(box, L.HowToStart, { Font = Kit.FONT_BOLD, TextSize = 22, ZIndex = 62, LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 30) })
	for i, key in { "StartStep1", "StartStep2", "StartStep3" } do
		Kit.label(box, tostring(i) .. "   " .. H[key], {
			TextSize = 16, ZIndex = 62, LayoutOrder = 1 + i, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		})
	end
	Kit.button(box, L.GotIt, function()
		shade:Destroy()
	end, { ZIndex = 62, LayoutOrder = 10, BackgroundColor3 = Kit.C.accent, Font = Kit.FONT_BOLD })
end

function Editor:updateGridButton()
	self.gizmo.grid = self.grid
	self.gizmo.rotStep = if self.grid &gt; 0 then 15 else 0
	if self.grid == 0 then
		self.gridButton.Text = L.GridOff
		Kit.setActive(self.gridButton, false)
	else
		self.gridButton.Text = L.Grid .. "\n" .. tostring(self.grid)
		Kit.setActive(self.gridButton, true)
	end
end

function Editor:setStatus(st: string)
	local s = STATUS[st]
	if s then
		self.statusLabel.Text = s[1]
		self.statusLabel.TextColor3 = s[2]
	end
	if st == "readonly" then
		Kit.toast(self.gui, H.ReadOnlyHint, Kit.C.panel2, 5)
	elseif st == "failed" then
		Kit.toast(self.gui, H.SaveFailedHint, Kit.C.panel2, 4)
	end
end

function Editor:showHint(text: string?)
	self.hint.Text = text or ""
	self.hint.Visible = text ~= nil
end

function Editor:selectTab(id: string)
	self.tab = id
	for tid, b in self.tabButtons do
		Kit.setActive(b, tid == id)
	end
	if id ~= "anim" and self.animController then
		self.animController:stop()
	end
	self:layout()
	self:renderPanel()
	self:updateGizmo()
end

function Editor:renderPanel()
	if self.panelCleanup then
		self.panelCleanup()
		self.panelCleanup = nil
	end
	for _, c in self.panel:GetChildren() do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
	for _, c in self.bottom:GetChildren() do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
	local moduleName = ({
		map = "MapPanel", models = "MapPanel", creatures = "CreaturePanel", anim = "AnimPanel",
		logic = "LogicPanel", camera = "SettingsPanel", texts = "TextsPanel", objects = "ExplorerPanel",
	})[self.tab]
	local mod = require(Panels:WaitForChild(moduleName) :: ModuleScript) :: any
	self.panelCleanup = mod.render(self, self.panel, self.bottom)
end

-- ---------------------------------------------------------------------------
-- Выбор

function Editor:onTap(pos: Vector2)
	local id, partId = self.preview:pick(pos)
	if self.pickCallback then
		local cb = self.pickCallback
		if id then
			self.pickCallback = nil
			self:showHint(nil)
			cb(id)
		end
		return
	end
	if self.tab == "anim" and self.animController then
		self.animController:onTap(id, partId)
		return
	end
	if self.modelEdit then
		if id == self.modelEdit then
			self.selPart = partId
		else
			self.selPart = nil
		end
		self:afterSelection()
		return
	end
	if not id then
		if not self.multi then
			self.selection = {}
		end
	elseif self.multi then
		local i = table.find(self.selection, id)
		if i then
			table.remove(self.selection, i)
		else
			table.insert(self.selection, id)
		end
	else
		self.selection = { id }
	end
	self:afterSelection()
end

function Editor:select(ids: { string })
	self.selection = ids
	self:afterSelection()
end

function Editor:afterSelection()
	local ids = self.selection
	if self.modelEdit then
		ids = { self.modelEdit }
	end
	self.preview:setHighlight(ids)
	self:layout()
	self:updateGizmo()
	self:updateFreezeButton()
	self.selectionChanged.fire()
	if self.tab ~= "logic" and self.tab ~= "camera" then
		self:renderPanel()
	end
end

function Editor:afterChange()
	-- выбранные объекты могли быть удалены
	local alive = {}
	for _, id in self.selection do
		if self.state:obj(id) then
			table.insert(alive, id)
		end
	end
	self.selection = alive
	if self.modelEdit and not self.state:obj(self.modelEdit) then
		self.modelEdit = nil
		self.selPart = nil
	end
	self.nameLabel.Text = self.state.project.meta.name
	self.preview:setHighlight(if self.modelEdit then { self.modelEdit } else self.selection)
	self:updateFreezeButton()
	task.defer(function()
		self:updateGizmo()
	end)
	if self.onProjectChanged then
		self.onProjectChanged()
	end
end

function Editor:updateFreezeButton()
	local obj = self.selection[1] and self.state:obj(self.selection[1])
	self.freezeButton.Text = if obj and obj.frozen then L.Unfreeze else L.Freeze
	Kit.setActive(self.freezeButton, obj ~= nil and obj.frozen == true)
end

function Editor:setTool(tool: string)
	self.tool = tool
	for t, b in self.toolButtons do
		Kit.setActive(b, t == tool)
	end
	self.gizmo:setTool(tool)
end

-- Прокси для ручек модели целиком
function Editor:proxy(name: string, cf: CFrame, size: Vector3, color: Color3?): BasePart
	local p = self.helpers[name]
	if not p or not p.Parent then
		p = Instance.new("Part")
		p.Name = name
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.Material = Enum.Material.ForceField
		p.Parent = self.preview.folder
		self.helpers[name] = p
	end
	p.Size = size
	p.CFrame = cf
	p.Color = color or Color3.fromRGB(88, 140, 255)
	p.Transparency = if color then 0.3 else 1
	return p
end

function Editor:clearHelpers(except: { [string]: boolean }?)
	for name, p in self.helpers do
		if not except or not except[name] then
			p:Destroy()
			self.helpers[name] = nil
		end
	end
end

function Editor:updateGizmo()
	if self.tab == "anim" then
		return -- ручками управляет шкала анимации
	end
	self.tool = self.tool or "move"
	self.gizmo:setTool(self.tool)
	local keep = {}
	-- точки шкафа показываются, пока шкаф выбран
	local selObj = #self.selection == 1 and self.state:obj(self.selection[1]) or nil
	if selObj and selObj.role and selObj.role.type == "closet" and not self.modelEdit then
		local base = self.preview:worldCF(selObj.pos, selObj.rot)
		for _, which in { "entry", "inside", "exit" } do
			local pose = selObj.role[which]
			local cf = base * Convert.cfFrom(pose.pos, pose.rot) * CFrame.new(0, 2.5, 0)
			local colors = { entry = Color3.fromRGB(80, 200, 120), inside = Color3.fromRGB(240, 180, 60), exit = Color3.fromRGB(235, 80, 80) }
			local p = self:proxy("Closet_" .. which, cf, Vector3.new(1.6, 5, 0.8), colors[which])
			keep["Closet_" .. which] = true
			local face = p:FindFirstChild("Face") :: BasePart?
			if not face then
				local nose = Instance.new("Part")
				nose.Name = "Face"
				nose.Anchored = true
				nose.CanCollide = false
				nose.CanQuery = false
				nose.Size = Vector3.new(0.6, 0.6, 0.6)
				nose.Color = Color3.new(1, 1, 1)
				nose.Parent = p
				face = nose
			end
			(face :: BasePart).CFrame = cf * CFrame.new(0, 1.8, -0.6)
		end
	end
	if self.closetPoint and selObj and selObj.role and selObj.role.type == "closet" then
		keep["Closet_" .. self.closetPoint] = true
		self:clearHelpers(keep)
		local which = self.closetPoint
		local p = self.helpers["Closet_" .. which]
		local base = self.preview:worldCF(selObj.pos, selObj.rot)
		local id = selObj.id
		self.gizmo:setTarget({
			adornee = p, cf = p.CFrame, size = p.Size, allowMove = true, allowRotate = true, allowScale = false,
			onLive = function(cf)
				p.CFrame = cf
			end,
			onCommit = function(cf)
				local localCF = base:ToObjectSpace(cf * CFrame.new(0, -2.5, 0))
				local pos, rot = Convert.posRot(localCF)
				self.state:apply({ op = "set", id = id, path = { "role", which }, value = { pos = pos, rot = rot } })
			end,
		})
		return
	end
	self:clearHelpers(keep)
	if self.modelEdit then
		local obj = self.state:obj(self.modelEdit)
		local h = self.preview.handles[self.modelEdit]
		local pid = self.selPart
		if not obj or not h or not pid or not h.parts[pid] then
			self.gizmo:setTarget(nil)
			return
		end
		local part = h.parts[pid]
		local base = self.preview:worldCF(obj.pos, obj.rot)
		local mid = self.modelEdit
		self.gizmo:setTarget({
			adornee = part, cf = part.CFrame, size = part.Size, allowMove = true, allowRotate = true, allowScale = true,
			onLive = function(cf, size)
				part.CFrame = cf
				part.Size = size
			end,
			onCommit = function(cf, size)
				local pos, rot = Convert.posRot(base:ToObjectSpace(cf))
				self.state:apply({ op = "batch", ops = {
					{ op = "set", id = mid, path = { "model", "parts", pid, "pos" }, value = pos },
					{ op = "set", id = mid, path = { "model", "parts", pid, "rot" }, value = rot },
					{ op = "set", id = mid, path = { "model", "parts", pid, "size" }, value = Convert.fromV3(size) },
				} })
			end,
		})
		return
	end
	if #self.selection ~= 1 then
		self.gizmo:setTarget(nil)
		return
	end
	local id = self.selection[1]
	local obj = self.state:obj(id)
	local h = self.preview.handles[id]
	if not obj or not h then
		self.gizmo:setTarget(nil)
		return
	end
	local frozen = obj.frozen
	if obj.kind == "part" then
		local part = h.part
		self.gizmo:setTarget({
			adornee = part, cf = part.CFrame, size = part.Size,
			allowMove = not frozen, allowRotate = not frozen, allowScale = true, symmetric = frozen,
			onLive = function(cf, size)
				part.CFrame = cf
				part.Size = size
			end,
			onCommit = function(cf, size)
				local pos, rot = self.preview:toProject(cf)
				local ops = { { op = "set", id = id, path = { "size" }, value = Convert.fromV3(size) } }
				if not frozen then
					table.insert(ops, { op = "set", id = id, path = { "pos" }, value = pos })
					table.insert(ops, { op = "set", id = id, path = { "rot" }, value = rot })
				end
				self.state:apply({ op = "batch", ops = ops })
			end,
		})
	else
		local cf = WorldBuilder.objectCFrame(obj, Preview.ORIGIN)
		local proxy = self:proxy("ModelProxy", cf, Vector3.new(3, 3, 3))
		keep.ModelProxy = true
		local model = h.root :: Model
		local startPivot = model:GetPivot()
		local offset = cf:ToObjectSpace(startPivot)
		self.gizmo:setTarget({
			adornee = proxy, cf = cf, size = proxy.Size,
			allowMove = not frozen, allowRotate = not frozen, allowScale = false,
			onLive = function(newCf)
				proxy.CFrame = newCf
				model:PivotTo(newCf * offset)
			end,
			onCommit = function(newCf)
				local pos, rot = self.preview:toProject(newCf)
				self.state:apply({ op = "batch", ops = {
					{ op = "set", id = id, path = { "pos" }, value = pos },
					{ op = "set", id = id, path = { "rot" }, value = rot },
				} })
			end,
		})
	end
end

-- Выбор цели для действия или поля: касанием на карте
function Editor:pickTarget(cb: (string) -&gt; ())
	self.pickCallback = cb
	self:showHint(H.PickTargetHint)
end

-- ---------------------------------------------------------------------------
-- Команды

function Editor:addObjects(objs)
	local ops = {}
	for _, o in objs do
		table.insert(ops, { op = "add", obj = o })
	end
	local ok, err = self.state:apply({ op = "batch", ops = ops })
	if ok then
		local ids = {}
		for _, o in objs do
			table.insert(ids, o.id)
		end
		self:select(ids)
	else
		Kit.toast(self.gui, tostring(err), Kit.C.bad)
	end
end

function Editor:addPrefab(prefabId: string)
	local at = self.preview:placementPoint(self.grid)
	local objs = Prefabs.build(self.state.project, prefabId, at)
	if objs then
		self:addObjects(objs)
	end
end

function Editor:addShape(shape: string)
	if self.modelEdit then
		-- деталь добавляется в редактируемую модель
		local obj = self.state:obj(self.modelEdit)
		local n = obj.model.nextPart or 1
		local pid = "p" .. tostring(n)
		local part = {
			id = pid, name = L.AddShape, shape = shape, size = { 2, 2, 2 }, pos = { 0, 3, 0 }, rot = { 0, 0, 0 },
			color = { 200, 200, 200 }, material = "SmoothPlastic", transparency = 0, pivot = { 0, 0, 0 },
		}
		self.state:apply({ op = "batch", ops = {
			{ op = "set", id = obj.id, path = { "model", "parts", pid }, value = part },
			{ op = "set", id = obj.id, path = { "model", "nextPart" }, value = n + 1 },
		} })
		self.selPart = pid
		self:afterSelection()
		return
	end
	local at = self.preview:placementPoint(self.grid)
	local p = Prefabs.shape(self.state.project, shape, at)
	self:addObjects({ p })
end

function Editor:deleteSelection()
	if self.modelEdit and self.selPart then
		local obj = self.state:obj(self.modelEdit)
		-- дети удалённой детали переходят к её родителю, потом деталь удаляется
		-- (дорожки клипов этой детали остаются, редактор анимации подсветит их)
		local ops = {}
		for pid, part in obj.model.parts do
			if part.parent == self.selPart then
				table.insert(ops, { op = "set", id = obj.id, path = { "model", "parts", pid, "parent" }, value = obj.model.parts[self.selPart].parent })
			end
		end
		table.insert(ops, { op = "set", id = obj.id, path = { "model", "parts", self.selPart }, value = nil })
		self.state:apply({ op = "batch", ops = ops })
		self.selPart = nil
		self:afterSelection()
		return
	end
	if #self.selection == 0 then
		return
	end
	local ops = {}
	for _, id in self.selection do
		table.insert(ops, { op = "remove", id = id })
	end
	self.state:apply({ op = "batch", ops = ops })
	self:select({})
end

function Editor:duplicate()
	if #self.selection == 0 then
		return
	end
	local op, copies = Model.duplicate(self.state.project, self.selection, { 2, 0, 2 })
	if self.state:apply(op) then
		local ids = {}
		for _, c in copies do
			table.insert(ids, c.id)
		end
		self:select(ids)
	end
end

function Editor:toggleFreeze()
	if #self.selection == 0 then
		return
	end
	local first = self.state:obj(self.selection[1])
	local value = not first.frozen
	local ops = {}
	for _, id in self.selection do
		table.insert(ops, { op = "set", id = id, path = { "frozen" }, value = value })
	end
	self.state:apply({ op = "batch", ops = ops })
	if value then
		Kit.toast(self.gui, H.FrozenHint)
	end
end

function Editor:glue()
	if #self.selection &lt; 1 then
		Kit.toast(self.gui, H.GlueHint)
		return
	end
	local op, res = Model.glue(self.state.project, self.selection, L.DefaultModelName)
	if not op then
		Kit.toast(self.gui, if res == "has role" then H.GlueRoleHint else tostring(res), Kit.C.bad)
		return
	end
	if self.state:apply(op) then
		self:select({ res.id })
	end
end

function Editor:enterModelEdit(id: string?)
	self.modelEdit = id
	self.selPart = nil
	self.closetPoint = nil
	self:showHint(if id then H.ModelEditHint else nil)
	self:afterSelection()
end

function Editor:assignRole(roleType: string?)
	local id = self.selection[1]
	local obj = id and self.state:obj(id)
	if not obj then
		return
	end
	local size = if obj.size then obj.size else { 4, 7, 3 }
	local role = nil
	if roleType == "closet" then
		role = Closet.newRole(size[3])
	elseif roleType == "door" then
		role = { type = "door", open = false, openAngle = 95, openTime = 0.6, hinge = { -size[1] / 2, 0, 0 }, locked = false }
	elseif roleType == "light" then
		role = { type = "light", on = true, brightness = 3, range = 24, color = { 255, 214, 170 } }
	elseif roleType == "npc" then
		role = Prefabs.npcRole()
	elseif roleType == "statue" then
		role = { type = "statue", username = self.app.playerGui.Parent.Name, pose = "admire", orb = true }
	elseif roleType == "creature" then
		role = { type = "creature", speed = 14 }
	elseif roleType then
		role = { type = roleType }
	end
	local ok, err = self.state:apply({ op = "set", id = id, path = { "role" }, value = role })
	if not ok then
		Kit.toast(self.gui, tostring(err), Kit.C.bad)
	end
	self:renderPanel()
end

-- ---------------------------------------------------------------------------
-- Тест и публикация

function Editor:showLogicErrors(errors)
	self.logicErrors = errors or {}
	self:selectTab("logic")
	Kit.toast(self.gui, H.PublishFailedHint, Kit.C.bad, 4)
end

function Editor:startTest()
	local res = Remotes.fn("Request"):InvokeServer("StartTest")
	if not res or not res.ok then
		if res and res.error == "logic" then
			self:showLogicErrors(res.errors)
		elseif res and res.error == "filter" then
			Kit.toast(self.gui, H.FilterFailedHint, Kit.C.bad)
		else
			Kit.toast(self.gui, L.LoadFailed, Kit.C.bad)
		end
		return
	end
	self:setEnabled(false)
end

function Editor:publish()
	local res = Remotes.fn("Request"):InvokeServer("Publish")
	if not res or not res.ok then
		if res and res.error == "logic" then
			self:showLogicErrors(res.errors)
		elseif res and res.error == "filter" then
			Kit.toast(self.gui, H.FilterFailedHint, Kit.C.bad)
		else
			Kit.toast(self.gui, H.PublishFailedHint, Kit.C.bad)
		end
		return
	end
	self.state.project.meta.publishCode = res.code
	self.state.project.meta.publishedVersion = res.version
	local options = {
		{ id = "ok", title = string.format(L.PublishedVersion, res.version), hint = H.PublishHint },
	}
	if self.app.mode and self.app.mode.creator then
		table.insert(options, { id = "showcase", title = L.ShowcaseSet, hint = H.ShowcaseHint })
	end
	Kit.choose(self.gui, string.format(L.PublishedAs, res.code), options, function(choice)
		if choice == "showcase" then
			local r = Remotes.fn("Request"):InvokeServer("SetShowcase", res.code)
			if r and r.ok then
				Kit.toast(self.gui, L.ShowcaseSetDone, Kit.C.good)
			else
				Kit.toast(self.gui, H.ShowcaseOnlyCreators, Kit.C.bad)
			end
		end
	end)
end

function Editor:setEnabled(on: boolean)
	self.gui.Enabled = on
	self.camera.enabled = on
	self.gizmo:setEnabled(on)
	self.preview.folder.Parent = if on then workspace else nil
	if on then
		self.camera:apply()
	end
end

function Editor:destroy()
	if self.panelCleanup then
		self.panelCleanup()
	end
	self.keyConn:Disconnect()
	self.layoutConn:Disconnect()
	self.gizmo:destroy()
	self.camera:destroy()
	self.preview:destroy()
	self.state:destroy()
	self.gui:Destroy()
end

return Editor
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX0000003B">
            <Properties>
              <string name="Name">FreeCamera</string>
              <ProtectedString name="Source">--!nonstrict
-- Камера редактора. Касание: один палец вращает, два пальца двигают и приближают
-- Мышь: правая кнопка вращает, средняя двигает, колесо приближает; WASD, Q и E летают
-- Камера никогда не двигает объекты: объект меняется только ручками

local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local FreeCamera = {}
FreeCamera.__index = FreeCamera

function FreeCamera.new(focus: Vector3)
	local self = setmetatable({}, FreeCamera)
	self.focus = focus
	self.yaw = math.rad(30)
	self.pitch = math.rad(-35)
	self.dist = 45
	self.enabled = true
	self.blockDrag = false -- выставляет Gizmo, пока тянут ручку
	self.padMove = Vector3.zero -- полёт с экранных кнопок
	self.onTap = nil :: ((Vector2) -&gt; ())?
	self.touches = {} :: { [InputObject]: Vector2 }
	self.touchStart = {} :: { [InputObject]: { pos: Vector2, t: number, moved: boolean } }
	self.mouseDown = nil :: { pos: Vector2, t: number, moved: boolean }?
	self.rmb = false
	self.mmb = false
	self.conns = {}
	local cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Scriptable

	local function overGui(pos: Vector2): boolean
		local player = game:GetService("Players").LocalPlayer
		local gui = player:FindFirstChildOfClass("PlayerGui")
		if not gui then
			return false
		end
		for _, g in gui:GetGuiObjectsAtPosition(pos.X, pos.Y) do
			if g.Visible and g:FindFirstAncestorOfClass("ScreenGui") and (g:IsA("GuiButton") or g:IsA("TextBox") or g:IsA("ScrollingFrame") or (g:IsA("Frame") and g.BackgroundTransparency &lt; 1)) then
				return true
			end
		end
		return false
	end

	table.insert(self.conns, UserInputService.InputBegan:Connect(function(input, processed)
		if not self.enabled then
			return
		end
		local t = input.UserInputType
		if t == Enum.UserInputType.Touch then
			local p = Vector2.new(input.Position.X, input.Position.Y)
			if processed or overGui(p) then
				return
			end
			self.touches[input] = p
			self.touchStart[input] = { pos = p, t = os.clock(), moved = false }
		elseif processed then
			return
		elseif t == Enum.UserInputType.MouseButton1 then
			self.mouseDown = { pos = Vector2.new(input.Position.X, input.Position.Y), t = os.clock(), moved = false }
		elseif t == Enum.UserInputType.MouseButton2 then
			self.rmb = true
		elseif t == Enum.UserInputType.MouseButton3 then
			self.mmb = true
		end
	end))

	table.insert(self.conns, UserInputService.InputChanged:Connect(function(input, processed)
		if not self.enabled then
			return
		end
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseWheel and not processed then
			self.dist = math.clamp(self.dist * (1 - input.Position.Z * 0.12), 4, 400)
		elseif t == Enum.UserInputType.MouseMovement then
			local d = input.Delta
			if self.mouseDown and (Vector2.new(input.Position.X, input.Position.Y) - self.mouseDown.pos).Magnitude &gt; 6 then
				self.mouseDown.moved = true
			end
			if self.rmb then
				self:orbit(d.X, d.Y)
			elseif self.mmb then
				self:pan(d.X, d.Y)
			end
		elseif t == Enum.UserInputType.Touch and self.touches[input] then
			local p = Vector2.new(input.Position.X, input.Position.Y)
			local prev = self.touches[input]
			local st = self.touchStart[input]
			if st and (p - st.pos).Magnitude &gt; 10 then
				st.moved = true
			end
			local count = 0
			local other: InputObject? = nil
			for k in self.touches do
				count += 1
				if k ~= input then
					other = k
				end
			end
			if count == 1 then
				if not self.blockDrag then
					local d = p - prev
					self:orbit(d.X, d.Y)
				end
			elseif count &gt;= 2 and other then
				local op = self.touches[other]
				local before = (prev - op).Magnitude
				local after = (p - op).Magnitude
				if before &gt; 1 then
					self.dist = math.clamp(self.dist * before / math.max(after, 1), 4, 400)
				end
				local d = (p - prev) / 2
				self:pan(d.X, d.Y)
			end
			self.touches[input] = p
		end
	end))

	table.insert(self.conns, UserInputService.InputEnded:Connect(function(input)
		local t = input.UserInputType
		if t == Enum.UserInputType.Touch then
			local st = self.touchStart[input]
			local count = 0
			for _ in self.touches do
				count += 1
			end
			self.touches[input] = nil
			self.touchStart[input] = nil
			if st and not st.moved and count == 1 and os.clock() - st.t &lt; 0.35 and self.onTap and not self.blockDrag then
				self.onTap(st.pos)
			end
		elseif t == Enum.UserInputType.MouseButton1 then
			local md = self.mouseDown
			self.mouseDown = nil
			if md and not md.moved and os.clock() - md.t &lt; 0.5 and self.onTap and not self.blockDrag then
				self.onTap(md.pos)
			end
		elseif t == Enum.UserInputType.MouseButton2 then
			self.rmb = false
		elseif t == Enum.UserInputType.MouseButton3 then
			self.mmb = false
		end
	end))

	table.insert(self.conns, RunService.RenderStepped:Connect(function(dt)
		if not self.enabled then
			return
		end
		local move = Vector3.zero
		if not UserInputService:GetFocusedTextBox() then
			local k = UserInputService
			if k:IsKeyDown(Enum.KeyCode.W) then move += Vector3.new(0, 0, -1) end
			if k:IsKeyDown(Enum.KeyCode.S) then move += Vector3.new(0, 0, 1) end
			if k:IsKeyDown(Enum.KeyCode.A) then move += Vector3.new(-1, 0, 0) end
			if k:IsKeyDown(Enum.KeyCode.D) then move += Vector3.new(1, 0, 0) end
			if k:IsKeyDown(Enum.KeyCode.E) then move += Vector3.new(0, 1, 0) end
			if k:IsKeyDown(Enum.KeyCode.Q) then move += Vector3.new(0, -1, 0) end
		end
		move += self.padMove
		if move.Magnitude &gt; 0 then
			local rot = CFrame.Angles(0, self.yaw, 0)
			self.focus += rot:VectorToWorldSpace(move) * dt * math.max(12, self.dist * 0.8)
		end
		self:apply()
	end))
	self:apply()
	return self
end

function FreeCamera:orbit(dx: number, dy: number)
	self.yaw -= dx * 0.008
	self.pitch = math.clamp(self.pitch - dy * 0.008, math.rad(-88), math.rad(88))
end

function FreeCamera:pan(dx: number, dy: number)
	local cam = workspace.CurrentCamera
	local scale = self.dist * 0.0025
	self.focus += cam.CFrame.RightVector * (-dx * scale) + cam.CFrame.UpVector * (dy * scale)
end

function FreeCamera:apply()
	local cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Scriptable
	local rot = CFrame.Angles(0, self.yaw, 0) * CFrame.Angles(self.pitch, 0, 0)
	cam.CFrame = CFrame.new(self.focus) * rot * CFrame.new(0, 0, self.dist)
	cam.FieldOfView = 70
end

function FreeCamera:focusOn(pos: Vector3)
	self.focus = pos
end

function FreeCamera:destroy()
	for _, c in self.conns do
		c:Disconnect()
	end
end

return FreeCamera
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX0000003C">
            <Properties>
              <string name="Name">Gizmo</string>
              <ProtectedString name="Source">--!nonstrict
-- Ручки перемещения, вращения и размера. Объект меняется только через ручки:
-- пока ручку тянут, объект двигается на экране сразу, а правка уходит на сервер
-- при отпускании (одна запись в истории отмены)

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local Gizmo = {}
Gizmo.__index = Gizmo

local AXIS_OF_FACE = {
	[Enum.NormalId.Right] = 1, [Enum.NormalId.Left] = 1,
	[Enum.NormalId.Top] = 2, [Enum.NormalId.Bottom] = 2,
	[Enum.NormalId.Back] = 3, [Enum.NormalId.Front] = 3,
}

function Gizmo.new(camera)
	local self = setmetatable({}, Gizmo)
	self.camera = camera
	self.tool = "select"
	self.grid = 1
	self.rotStep = 15
	self.target = nil
	local gui = Players.LocalPlayer:WaitForChild("PlayerGui")
	self.enabled = true

	self.move = Instance.new("Handles")
	self.move.Style = Enum.HandlesStyle.Movement
	self.move.Color3 = Color3.fromRGB(255, 200, 60)
	self.move.Parent = gui

	self.scale = Instance.new("Handles")
	self.scale.Style = Enum.HandlesStyle.Resize
	self.scale.Color3 = Color3.fromRGB(80, 200, 255)
	self.scale.Parent = gui

	self.rotate = Instance.new("ArcHandles")
	self.rotate.Parent = gui

	local start: { cf: CFrame, size: Vector3 }? = nil
	local function begin()
		if not self.target then
			return
		end
		start = { cf = self.target.cf, size = self.target.size }
		self.camera.blockDrag = true
	end
	local function finish()
		self.camera.blockDrag = false
		if start and self.target and self.target.onCommit then
			self.target.onCommit(self.target.cf, self.target.size)
		end
		start = nil
	end
	local function snap(v: number, step: number)
		if step &lt;= 0 then
			return v
		end
		return math.floor(v / step + 0.5) * step
	end

	for _, h in { self.move, self.scale } do
		h.MouseButton1Down:Connect(begin)
		h.MouseButton1Up:Connect(finish)
	end
	self.rotate.MouseButton1Down:Connect(begin)
	self.rotate.MouseButton1Up:Connect(finish)
	-- палец или кнопку могли отпустить вне ручки
	self.endConn = UserInputService.InputEnded:Connect(function(input)
		local t = input.UserInputType
		if start and (t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch) then
			finish()
		end
	end)

	self.move.MouseDrag:Connect(function(face, distance)
		local t = self.target
		if not start or not t then
			return
		end
		local dir = start.cf:VectorToWorldSpace(Vector3.FromNormalId(face))
		local d = snap(distance, self.grid)
		t.cf = start.cf + dir * d
		t.onLive(t.cf, t.size)
	end)

	self.scale.MouseDrag:Connect(function(face, distance)
		local t = self.target
		if not start or not t then
			return
		end
		local axis = AXIS_OF_FACE[face]
		local d = snap(distance, self.grid)
		local s = { start.size.X, start.size.Y, start.size.Z }
		local grow = if t.symmetric then d * 2 else d
		s[axis] = math.clamp(s[axis] + grow, 0.2, 512)
		local real = s[axis] - ({ start.size.X, start.size.Y, start.size.Z })[axis]
		t.size = Vector3.new(s[1], s[2], s[3])
		if t.symmetric then
			t.cf = start.cf
		else
			-- противоположная грань остаётся на месте
			local dir = start.cf:VectorToWorldSpace(Vector3.FromNormalId(face))
			t.cf = start.cf + dir * (real / 2)
		end
		t.onLive(t.cf, t.size)
	end)

	self.rotate.MouseDrag:Connect(function(axis, relativeAngle)
		local t = self.target
		if not start or not t then
			return
		end
		local step = math.rad(self.rotStep)
		local a = if self.rotStep &gt; 0 then math.floor(relativeAngle / step + 0.5) * step else relativeAngle
		local pivot = t.pivot or CFrame.new()
		-- вращение вокруг точки вращения в координатах объекта
		t.cf = start.cf * pivot * CFrame.fromAxisAngle(Vector3.FromAxis(axis), a) * pivot:Inverse()
		t.onLive(t.cf, t.size)
	end)

	self:refresh()
	return self
end

-- target = { adornee, cf, size, allowMove, allowRotate, allowScale, symmetric, pivot, onLive, onCommit }
function Gizmo:setTarget(target)
	self.target = target
	self:refresh()
end

function Gizmo:setTool(tool: string)
	self.tool = tool
	self:refresh()
end

function Gizmo:setEnabled(on: boolean)
	self.enabled = on
	self:refresh()
end

function Gizmo:refresh()
	local t = if self.enabled then self.target else nil
	local adornee = t and t.adornee
	self.move.Adornee = if t and self.tool == "move" and t.allowMove then adornee else nil
	self.scale.Adornee = if t and self.tool == "scale" and t.allowScale then adornee else nil
	self.rotate.Adornee = if t and self.tool == "rotate" and t.allowRotate then adornee else nil
	self.move.Visible = self.move.Adornee ~= nil
	self.scale.Visible = self.scale.Adornee ~= nil
	self.rotate.Visible = self.rotate.Adornee ~= nil
end

function Gizmo:destroy()
	self.camera.blockDrag = false
	self.endConn:Disconnect()
	self.move:Destroy()
	self.scale:Destroy()
	self.rotate:Destroy()
end

return Gizmo
</ProtectedString>
            </Properties>
          </Item>
          <Item class="Folder" referent="RBX0000003D">
            <Properties>
              <string name="Name">Panels</string>
            </Properties>
            <Item class="ModuleScript" referent="RBX0000003E">
              <Properties>
                <string name="Name">AnimPanel</string>
                <ProtectedString name="Source">--!nonstrict
-- Ручная анимация с ключевыми кадрами
-- Автор выбирает модель и деталь, ставит указатель времени, тянет деталь ручкой
-- (деталь двигается сразу, дети по суставам следуют за ней) и сохраняет ключ
-- Между ключами при прокрутке времени видна промежуточная поза

local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Workshop"):WaitForChild("Shared")
local UiText = require(Shared.UiText)
local Util = require(Shared.Util)
local Anim = require(Shared.Anim)
local Rig = require(Shared.Rig)
local Format = require(Shared.Format)
local Convert = require(Shared.Roblox.Convert)
local WorldBuilder = require(Shared.Roblox.WorldBuilder)

local Kit = require(script.Parent.Parent.Parent.UI.Kit)

local L, H = UiText.L, UiText.H

local AnimPanel = {}

local LIFT = CFrame.new(0, 2.5, 0)

local function uniqueId(prefix: string, taken: { [string]: any }): string
	local n = 1
	while taken[prefix .. tostring(n)] do
		n += 1
	end
	return prefix .. tostring(n)
end

function AnimPanel.render(editor, panel: Frame, bottom: Frame)
	local project = editor.state.project
	local target = editor.animTarget
	if not target or not project.map.objects[target.id] then
		local sel = editor.selection[1]
		local o = sel and project.map.objects[sel]
		if o and o.kind == "model" then
			target = { kind = "model", id = sel }
		else
			target = nil
		end
	end
	editor.animTarget = target

	local side = Kit.scroll(panel)
	Kit.list(side, 6)
	if not target then
		Kit.label(side, H.ClipsNeedModelHint, { TextColor3 = Kit.C.dim, Size = UDim2.new(1, 0, 0, 60) })
		editor.animController = { onTap = function(_, id)
			local o = id and project.map.objects[id]
			if o and o.kind == "model" then
				editor.animTarget = { kind = "model", id = id }
				editor:select({ id })
				editor:renderPanel()
			end
		end, stop = function() end }
		editor.gizmo:setTarget(nil)
		return function()
			editor.animController = nil
		end
	end

	local c = {
		clipId = nil :: string?,
		time = 0,
		playing = false,
		part = nil :: string?,
		clipboard = nil,
		live = nil, -- временная поза детали, пока тянут ручку
	}
	local obj = project.map.objects[target.id]

	local function getClip()
		local o = project.map.objects[target.id]
		if not o then
			return nil
		end
		if target.kind == "closet" then
			return o.role and o.role[target.which]
		end
		if c.clipId and o.model.clips[c.clipId] then
			return o.model.clips[c.clipId]
		end
		return nil
	end
	local function clipPath(): { any }
		if target.kind == "closet" then
			return { "role", target.which }
		end
		return { "model", "clips", c.clipId :: string }
	end
	local function saveClip(clip)
		local ok, err = editor.state:apply({ op = "set", id = target.id, path = clipPath(), value = clip })
		if not ok then
			Kit.toast(editor.gui, tostring(err), Kit.C.bad)
		end
	end

	if target.kind == "model" then
		local first = nil
		for id, clip in obj.model.clips do
			if not first or clip.name &lt; obj.model.clips[first].name then
				first = id
			end
		end
		c.clipId = editor.animClipId and obj.model.clips[editor.animClipId] and editor.animClipId or first
	else
		c.part = "PlayerRoot"
	end

	-- -----------------------------------------------------------------------
	-- поза на экране

	local function handle()
		return editor.preview.handles[target.id]
	end
	local function baseCF(): CFrame
		local o = project.map.objects[target.id]
		return WorldBuilder.objectCFrame(o, editor.preview.ORIGIN or Vector3.new(0, 0, -6000))
	end

	local function currentSample()
		local clip = getClip()
		local s = if clip then Anim.sample(clip, c.time) else {}
		if c.live then
			s[c.live.track] = { pos = c.live.pos, rot = c.live.rot }
		end
		return s
	end

	local function proxyFor(track: string): BasePart
		local size = if track == "Camera" then Vector3.new(0.8, 0.8, 1.4) else Vector3.new(2, 5, 1)
		local color = if track == "Camera" then Color3.fromRGB(240, 180, 60) else Color3.fromRGB(80, 200, 120)
		return editor:proxy("Anim_" .. track, CFrame.new(), size, color)
	end

	local function trackWorld(track: string, s): CFrame?
		local v = s[track]
		if not v then
			return nil
		end
		local cf = baseCF() * Convert.cfFrom(v.pos, v.rot)
		if track == "PlayerRoot" then
			cf *= LIFT
		end
		return cf
	end

	local updateGizmo

	local function showPose()
		local h = handle()
		if not h then
			return
		end
		local s = currentSample()
		if target.kind == "model" then
			WorldBuilder.poseModel(h, s, baseCF())
		else
			for _, track in { "PlayerRoot", "Camera" } do
				local cf = trackWorld(track, s)
				local p = proxyFor(track)
				p.CFrame = cf or baseCF()
			end
		end
	end

	function updateGizmo()
		local h = handle()
		if not h or not c.part or c.playing then
			editor.gizmo:setTarget(nil)
			return
		end
		local clip = getClip()
		if not clip then
			editor.gizmo:setTarget(nil)
			return
		end
		local track = c.part :: string
		if target.kind == "closet" then
			local p = proxyFor(track)
			editor.gizmo:setTarget({
				adornee = p, cf = p.CFrame, size = p.Size, allowMove = true, allowRotate = true, allowScale = false,
				onLive = function(cf)
					p.CFrame = cf
				end,
				onCommit = function(cf)
					local localCF = baseCF():ToObjectSpace(if track == "PlayerRoot" then cf * LIFT:Inverse() else cf)
					local pos, rot = Convert.posRot(localCF)
					local copy = Util.deepCopy(clip)
					Anim.setKey(copy, track, c.time, pos, rot, "smooth")
					saveClip(copy)
				end,
			})
			return
		end
		local part = h.parts[track]
		local o = project.map.objects[target.id]
		local data = o.model.parts[track]
		if not part or not data then
			editor.gizmo:setTarget(nil)
			return
		end
		local modelTf = Convert.tf(baseCF())
		editor.gizmo:setTarget({
			adornee = part, cf = part.CFrame, size = part.Size, allowMove = true, allowRotate = true, allowScale = false,
			pivot = CFrame.new(Convert.v3(data.pivot)),
			onLive = function(cf)
				-- деталь и все её дети двигаются сразу
				local s = Anim.sample(clip, c.time)
				local world = Rig.pose(o.model, s, modelTf)
				local dp, dr = Rig.solveDelta(o.model, world, modelTf, track, Convert.tf(cf))
				c.live = { track = track, pos = dp, rot = dr }
				showPose()
			end,
			onCommit = function()
				local live = c.live
				c.live = nil
				if not live then
					return
				end
				local copy = Util.deepCopy(clip)
				Anim.setKey(copy, track, c.time, live.pos, live.rot, "smooth")
				saveClip(copy)
			end,
		})
	end

	-- -----------------------------------------------------------------------
	-- боковая панель: клипы, детали, суставы, метки

	local renderTimeline

	local function renderSide()
		for _, ch in side:GetChildren() do
			if ch:IsA("GuiObject") then
				ch:Destroy()
			end
		end
		local o = project.map.objects[target.id]
		if not o then
			return
		end
		local order = 0
		local function n()
			order += 1
			return order
		end
		Kit.titleBlock(side, o.name, if target.kind == "closet" then (if target.which == "enterClip" then "EnterCloset" else "ExitCloset") else o.latin, n())
		local clip = getClip()
		if target.kind == "model" then
			Kit.label(side, L.Clips, { Font = Kit.FONT_BOLD, LayoutOrder = n() })
			local ids = Util.keys(o.model.clips)
			table.sort(ids, function(a, b)
				return o.model.clips[a].name &lt; o.model.clips[b].name
			end)
			for _, cid in ids do
				local b = Kit.button(side, o.model.clips[cid].name, function()
					c.clipId = cid
					editor.animClipId = cid
					c.time = 0
					renderSide()
					renderTimeline()
					showPose()
					updateGizmo()
				end, { LayoutOrder = n() })
				Kit.setActive(b, cid == c.clipId)
			end
			Kit.button(side, L.NewClip, function()
				local cid = uniqueId("c", o.model.clips)
				local nc = Format.newClip(cid, L.NewClip .. " " .. tostring(Util.count(o.model.clips) + 1))
				local ok = editor.state:apply({ op = "set", id = target.id, path = { "model", "clips", cid }, value = nc })
				if ok then
					c.clipId = cid
					editor.animClipId = cid
				end
			end, { LayoutOrder = n() })
		end
		if clip then
			if target.kind == "model" then
				Kit.textbox(side, clip.name, L.ClipName, function(text)
					if text ~= "" and text ~= clip.name then
						local copy = Util.deepCopy(clip)
						copy.name = text
						saveClip(copy)
					end
				end, { LayoutOrder = n() })
				Kit.button(side, L.Delete, function()
					editor.state:apply({ op = "set", id = target.id, path = { "model", "clips", c.clipId :: string }, value = nil })
					c.clipId = nil
				end, { LayoutOrder = n(), BackgroundColor3 = Kit.C.bad })
			end
			Kit.stepper(side, L.ClipLength, clip.length, 0.1, 0.1, 120, function(v)
				local copy = Util.deepCopy(clip)
				Anim.setLength(copy, v)
				saveClip(copy)
			end, n())
			local modeRow = Kit.frame(side, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, Kit.TAP), LayoutOrder = n() })
			local once = Kit.button(modeRow, L.ModeOnce, function()
				local copy = Util.deepCopy(clip)
				copy.loop = false
				saveClip(copy)
			end, { Size = UDim2.new(0.5, -3, 1, 0) })
			local loop = Kit.button(modeRow, L.ModeLoop, function()
				local copy = Util.deepCopy(clip)
				copy.loop = true
				saveClip(copy)
			end, { Size = UDim2.new(0.5, -3, 1, 0), Position = UDim2.new(0.5, 3, 0, 0) })
			Kit.setActive(once, not clip.loop)
			Kit.setActive(loop, clip.loop)

			-- метки на шкале времени
			Kit.label(side, L.Marker, { Font = Kit.FONT_BOLD, LayoutOrder = n() })
			for _, mk in clip.markers do
				local r = Kit.frame(side, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, Kit.TAP), LayoutOrder = n() })
				Kit.button(r, string.format("%.2f  %s", mk.t, mk.name), function()
					c.time = mk.t
					renderTimeline()
					showPose()
				end, { Size = UDim2.new(1, -52, 1, 0), TextXAlignment = Enum.TextXAlignment.Left })
				Kit.button(r, "✕", function()
					local copy = Util.deepCopy(clip)
					Anim.removeMarker(copy, mk.id)
					saveClip(copy)
				end, { Size = UDim2.new(0, 46, 1, 0), Position = UDim2.new(1, -46, 0, 0), BackgroundColor3 = Kit.C.bad })
			end
			local markerName = Kit.textbox(side, "", L.Marker, nil, { LayoutOrder = n() })
			Kit.button(side, L.AddMarker, function()
				local name = Util.trim(markerName.Text)
				if name == "" then
					return
				end
				local copy = Util.deepCopy(clip)
				local taken = {}
				for _, mk in copy.markers do
					taken[mk.id] = true
				end
				Anim.addMarker(copy, uniqueId("k", taken), c.time, name)
				saveClip(copy)
			end, { LayoutOrder = n() })
		end

		if target.kind == "closet" then
			for _, track in { "PlayerRoot", "Camera" } do
				local b = Kit.button(side, track, function()
					c.part = track
					renderSide()
					renderTimeline()
					updateGizmo()
				end, { LayoutOrder = n() })
				Kit.setActive(b, c.part == track)
			end
			return
		end

		-- суставы выбранной детали
		Kit.label(side, L.Joints, { Font = Kit.FONT_BOLD, LayoutOrder = n() })
		local pid = c.part
		local part = pid and o.model.parts[pid]
		if not part then
			Kit.label(side, L.PickPart, { TextColor3 = Kit.C.dim, LayoutOrder = n() })
		else
			Kit.label(side, part.name, { LayoutOrder = n() })
			local _, slot = Kit.row(side, L.JointParent, n())
			local parentName = if part.parent and o.model.parts[part.parent] then o.model.parts[part.parent].name else L.NoParent
			Kit.button(slot, parentName, function()
				local opts = { { id = false, title = L.NoParent } }
				for qid, q in o.model.parts do
					if qid ~= pid then
						table.insert(opts, { id = qid, title = q.name, hint = qid })
					end
				end
				Kit.choose(editor.gui, L.JointParent, opts, function(parentId)
					local copy = Util.deepCopy(o.model)
					if Rig.setParent(copy, pid :: string, if parentId then parentId else nil) then
						editor.state:apply({ op = "set", id = target.id, path = { "model", "parts", pid :: string, "parent" }, value = copy.parts[pid :: string].parent })
					end
				end)
			end, { TextSize = 13 })
			for axis = 1, 3 do
				Kit.stepper(side, L.Pivot .. " " .. ({ "X", "Y", "Z" })[axis], part.pivot[axis], 0.1, -512, 512, function(v)
					local p = table.clone(part.pivot)
					p[axis] = v
					editor.state:apply({ op = "set", id = target.id, path = { "model", "parts", pid :: string, "pivot" }, value = p })
				end, n())
			end
		end

		-- дорожки удалённых деталей: ключи сохранены, их можно перенести
		if clip then
			local missing = Anim.validate(clip, o.model.parts)
			if #missing &gt; 0 then
				Kit.label(side, H.MissingTrackHint, { TextColor3 = Kit.C.bad, TextSize = 13, LayoutOrder = n(), Size = UDim2.new(1, 0, 0, 60) })
				for _, trackId in missing do
					Kit.button(side, L.MissingPart .. "\n" .. trackId, function()
						if not c.part or not o.model.parts[c.part] then
							Kit.toast(editor.gui, L.PickPart)
							return
						end
						local copy = Util.deepCopy(clip)
						if Anim.retarget(copy, trackId, c.part) then
							saveClip(copy)
						end
					end, { LayoutOrder = n(), BackgroundColor3 = Kit.C.bad, Size = UDim2.new(1, 0, 0, 52) })
				end
			end
		end
	end

	-- -----------------------------------------------------------------------
	-- шкала времени

	local tl = Kit.frame(bottom, { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) })
	local controls = Kit.scroll(tl, {
		Size = UDim2.new(1, 0, 0, Kit.TAP), ScrollingDirection = Enum.ScrollingDirection.X,
		AutomaticCanvasSize = Enum.AutomaticSize.X, ScrollBarThickness = 0,
	})
	Kit.list(controls, 4, true)
	local timeLabel = Kit.label(controls, "0.00", { Size = UDim2.new(0, 64, 1, 0), TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = 0 })
	local playButton
	local function stepT(): number
		return if editor.grid &gt; 0 then 0.1 else 0.05
	end
	local buttons = {
		{ L.Preview, function()
			c.playing = not c.playing
			playButton.Text = if c.playing then L.Stop else L.Preview
			updateGizmo()
		end },
		{ L.KeyAdd, function()
			local clip = getClip()
			if not clip or not c.part then
				Kit.toast(editor.gui, L.PickPart)
				return
			end
			local s = currentSample()[c.part]
			local copy = Util.deepCopy(clip)
			Anim.setKey(copy, c.part, c.time, if s then s.pos else { 0, 0, 0 }, if s then s.rot else { 0, 0, 0 }, "smooth")
			saveClip(copy)
		end },
		{ L.KeyDelete, function()
			local clip = getClip()
			if clip and c.part then
				local copy = Util.deepCopy(clip)
				if Anim.removeKey(copy, c.part, c.time) then
					saveClip(copy)
				end
			end
		end },
		{ L.KeyCopy, function()
			local clip = getClip()
			local k = clip and c.part and Anim.findKey(clip, c.part, c.time)
			if k then
				c.clipboard = Util.deepCopy(k)
			end
		end },
		{ L.KeyPaste, function()
			local clip = getClip()
			if clip and c.part and c.clipboard then
				local copy = Util.deepCopy(clip)
				Anim.setKey(copy, c.part, c.time, c.clipboard.pos, c.clipboard.rot, c.clipboard.ease)
				saveClip(copy)
			end
		end },
		{ L.KeyMoveLeft, function()
			local clip = getClip()
			if clip and c.part then
				local copy = Util.deepCopy(clip)
				local to = math.max(0, c.time - stepT())
				if Anim.moveKey(copy, c.part, c.time, to) then
					c.time = to
					saveClip(copy)
				end
			end
		end },
		{ L.KeyMoveRight, function()
			local clip = getClip()
			if clip and c.part then
				local copy = Util.deepCopy(clip)
				local to = math.min(clip.length, c.time + stepT())
				if Anim.moveKey(copy, c.part, c.time, to) then
					c.time = to
					saveClip(copy)
				end
			end
		end },
	}
	for i, b in buttons do
		local btn = Kit.button(controls, b[1], b[2], { Size = UDim2.new(0, 108, 1, 0), LayoutOrder = i, TextSize = 13 })
		if i == 1 then
			playButton = btn
		end
	end

	local area = Kit.scroll(tl, { Position = UDim2.fromOffset(0, Kit.TAP + 4), Size = UDim2.new(1, 0, 1, -Kit.TAP - 4) })
	Kit.list(area, 2)
	local NAME_W = 130

	local scrub = Kit.frame(area, { BackgroundColor3 = Kit.C.bg, Size = UDim2.new(1, -8, 0, 34), LayoutOrder = 0 })
	Kit.corner(scrub, 6)
	local playhead = Kit.frame(scrub, { BackgroundColor3 = Kit.C.accent, Size = UDim2.new(0, 3, 1, 0) })
	local rowsHolder = Kit.frame(area, { BackgroundTransparency = 1, Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1 })
	Kit.list(rowsHolder, 2)

	local function laneX(t: number, width: number): number
		local clip = getClip()
		local len = if clip then clip.length else 1
		return NAME_W + (width - NAME_W) * (t / len)
	end

	local function updatePlayhead()
		timeLabel.Text = string.format("%.2f", c.time)
		local w = scrub.AbsoluteSize.X
		playhead.Position = UDim2.fromOffset(laneX(c.time, w), 0)
	end

	function renderTimeline()
		for _, ch in rowsHolder:GetChildren() do
			if ch:IsA("GuiObject") then
				ch:Destroy()
			end
		end
		local clip = getClip()
		updatePlayhead()
		if not clip then
			return
		end
		local o = project.map.objects[target.id]
		local tracks = {}
		local seen = {}
		for trackId in clip.tracks do
			table.insert(tracks, trackId)
			seen[trackId] = true
		end
		if c.part and not seen[c.part] then
			table.insert(tracks, c.part)
		end
		table.sort(tracks)
		local missing = {}
		if target.kind == "model" then
			for _, m in Anim.validate(clip, o.model.parts) do
				missing[m] = true
			end
		end
		local width = rowsHolder.AbsoluteSize.X
		for i, trackId in tracks do
			local row = Kit.frame(rowsHolder, { BackgroundColor3 = if missing[trackId] then Color3.fromRGB(90, 30, 30) else Kit.C.panel2, Size = UDim2.new(1, 0, 0, 36), LayoutOrder = i })
			Kit.corner(row, 6)
			local name = trackId
			if target.kind == "model" and o.model.parts[trackId] then
				name = o.model.parts[trackId].name
			elseif missing[trackId] then
				name = L.MissingPart
			end
			local nb = Kit.button(row, name, function()
				if target.kind == "closet" or o.model.parts[trackId] then
					c.part = trackId
					renderSide()
					renderTimeline()
					updateGizmo()
				end
			end, { Size = UDim2.new(0, NAME_W - 6, 1, 0), TextSize = 12, BackgroundTransparency = if c.part == trackId then 0 else 1 })
			if missing[trackId] then
				nb.TextColor3 = Kit.C.bad
			end
			local track = clip.tracks[trackId]
			for _, k in (track and track.keys) or {} do
				local dot = Kit.button(row, "", function()
					c.time = k.t
					c.part = if target.kind == "closet" or o.model.parts[trackId] then trackId else c.part
					renderTimeline()
					showPose()
					updateGizmo()
				end, {
					Size = UDim2.fromOffset(18, 18),
					Position = UDim2.fromOffset(laneX(k.t, width) - 9, 9),
					BackgroundColor3 = if math.abs(k.t - c.time) &lt; Anim.KEY_EPS then Kit.C.warn else Kit.C.text,
				})
				Kit.corner(dot, 9)
			end
		end
		for _, mk in clip.markers do
			local m = Kit.frame(scrub, { BackgroundColor3 = Kit.C.warn, Size = UDim2.fromOffset(4, 34), Position = UDim2.fromOffset(laneX(mk.t, scrub.AbsoluteSize.X) - 2, 0) })
			m.Name = "Marker"
		end
	end

	-- перетаскивание указателя времени
	local scrubbing = false
	local function scrubAt(x: number)
		local clip = getClip()
		if not clip then
			return
		end
		local w = scrub.AbsoluteSize.X
		local a = math.clamp((x - scrub.AbsolutePosition.X - NAME_W) / math.max(w - NAME_W, 1), 0, 1)
		local step = if editor.grid &gt; 0 then 1 / 30 else 1 / 120
		c.time = math.floor(a * clip.length / step + 0.5) * step
		updatePlayhead()
		showPose()
	end
	local conns = {}
	table.insert(conns, scrub.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			scrubbing = true
			c.playing = false
			playButton.Text = L.Preview
			scrubAt(input.Position.X)
		end
	end))
	table.insert(conns, UserInputService.InputChanged:Connect(function(input)
		if scrubbing and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			scrubAt(input.Position.X)
		end
	end))
	table.insert(conns, UserInputService.InputEnded:Connect(function(input)
		if scrubbing and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			scrubbing = false
			renderTimeline()
			updateGizmo()
		end
	end))

	-- предпросмотр «Один раз» / «Повтор»
	table.insert(conns, RunService.RenderStepped:Connect(function(dt)
		if not c.playing then
			return
		end
		local clip = getClip()
		if not clip then
			return
		end
		c.time += dt
		if c.time &gt;= clip.length then
			if clip.loop then
				c.time %= clip.length
			else
				c.time = clip.length
				c.playing = false
				playButton.Text = L.Preview
				updateGizmo()
			end
		end
		updatePlayhead()
		showPose()
	end))
	table.insert(conns, scrub:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		renderTimeline()
	end))

	editor.animController = {
		onTap = function(id: string?, partId: string?)
			if target.kind == "model" and id == target.id and partId then
				c.part = partId
				renderSide()
				renderTimeline()
				updateGizmo()
			elseif id and id ~= target.id then
				local o = project.map.objects[id]
				if o and o.kind == "model" then
					editor.animTarget = { kind = "model", id = id }
					editor:select({ id })
				end
			end
		end,
		stop = function()
			c.playing = false
		end,
	}

	local prevChanged = editor.onProjectChanged
	editor.onProjectChanged = function()
		project = editor.state.project
		if not project.map.objects[target.id] then
			return
		end
		if target.kind == "model" and c.clipId and not project.map.objects[target.id].model.clips[c.clipId] then
			c.clipId = nil
		end
		renderSide()
		renderTimeline()
		showPose()
		updateGizmo()
	end

	renderSide()
	task.defer(function()
		renderTimeline()
		showPose()
		updateGizmo()
	end)

	return function()
		for _, cn in conns do
			cn:Disconnect()
		end
		editor.onProjectChanged = prevChanged
		editor.animController = nil
		editor.gizmo:setTarget(nil)
		editor:clearHelpers()
		local h = handle()
		if h then
			WorldBuilder.restWorld(h, baseCF())
		end
	end
end

return AnimPanel
</ProtectedString>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="RBX0000003F">
              <Properties>
                <string name="Name">CreaturePanel</string>
                <ProtectedString name="Source">--!nonstrict
-- Вкладка «Существа»: человекоподобные NPC «Новый» и «Ретро», лисик и существа с нуля
-- Внешность правится теми же инструментами, что и любая модель

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Workshop"):WaitForChild("Shared")
local UiText = require(Shared.UiText)
local Format = require(Shared.Format)
local Ids = require(Shared.Ids)

local Kit = require(script.Parent.Parent.Parent.UI.Kit)
local MapPanel = require(script.Parent.MapPanel)

local L = UiText.L

local CreaturePanel = {}

function CreaturePanel.render(editor, panel: Frame, bottom: Frame)
	if editor.modelEdit then
		return MapPanel.render(editor, panel, bottom)
	end
	local project = editor.state.project
	local wrap = Kit.frame(panel, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
	local g = Instance.new("UIGridLayout")
	g.CellSize = UDim2.new(0.5, -4, 0, 52)
	g.CellPadding = UDim2.fromOffset(6, 6)
	g.Parent = wrap
	Kit.button(wrap, L.BodyNew, function()
		editor:addPrefab("npcNew")
	end)
	Kit.button(wrap, L.BodyRetro, function()
		editor:addPrefab("npcRetro")
	end)
	Kit.button(wrap, L.Fox, function()
		editor:addPrefab("fox")
	end)
	Kit.button(wrap, L.NewCreature, function()
		local m = Format.newModel(Ids.alloc(project, "o"))
		m.name = L.NewCreature
		m.latin = Ids.suggestLatin(project, "Creature")
		m.pos = editor.preview:placementPoint(editor.grid)
		m.model.parts.p1 = {
			id = "p1", name = L.BodyPart, shape = "Block", size = { 2, 2, 3 }, pos = { 0, 1.5, 0 }, rot = { 0, 0, 0 },
			color = { 218, 133, 65 }, material = "Fabric", transparency = 0, pivot = { 0, 0, 0 },
		}
		m.model.nextPart = 2
		m.role = { type = "creature", speed = 12 }
		editor:addObjects({ m })
		editor:enterModelEdit(m.id)
	end)
	local rest = Kit.frame(panel, { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 118), Size = UDim2.new(1, 0, 1, -118) })
	return MapPanel.render(editor, rest, bottom)
end

return CreaturePanel
</ProtectedString>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="RBX00000040">
              <Properties>
                <string name="Name">ExplorerPanel</string>
                <ProtectedString name="Source">--!nonstrict
-- Вкладка «Объекты»: список всего, что есть на карте (как Explorer в Studio)
-- Касание строки выбирает объект и показывает его камерой

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Workshop"):WaitForChild("Shared")
local UiText = require(Shared.UiText)
local Kit = require(script.Parent.Parent.Parent.UI.Kit)

local L = UiText.L

local ExplorerPanel = {}

local ROLE_ICON = {
	closet = "🚪", door = "🚪", light = "💡", npc = "🙂", creature = "🦊",
	zone = "▢", waypoint = "•", spawn = "⚑",
}

function ExplorerPanel.render(editor, panel: Frame)
	local search = Kit.textbox(panel, editor.explorerQuery or "", L.Search, nil, { Size = UDim2.new(1, 0, 0, Kit.TAP) })
	local count = Kit.label(panel, "", { Position = UDim2.fromOffset(0, Kit.TAP + 4), TextColor3 = Kit.C.dim, TextSize = 13 })
	local list = Kit.scroll(panel, { Position = UDim2.fromOffset(0, Kit.TAP + 30), Size = UDim2.new(1, 0, 1, -Kit.TAP - 30) })
	Kit.list(list, 4)

	local function fill()
		for _, c in list:GetChildren() do
			if c:IsA("GuiObject") then
				c:Destroy()
			end
		end
		local q = string.lower(search.Text)
		local rows = {}
		for id, obj in editor.state.project.map.objects do
			local hay = string.lower(obj.name .. " " .. (obj.latin or ""))
			if q == "" or string.find(hay, q, 1, true) then
				table.insert(rows, { id = id, obj = obj })
			end
		end
		table.sort(rows, function(a, b)
			return a.obj.name &lt; b.obj.name
		end)
		count.Text = string.format(L.ObjectsCount, #rows)
		for i, r in rows do
			local o = r.obj
			local icon = if o.role then ROLE_ICON[o.role.type] or "◆" elseif o.kind == "model" then "▣" else "■"
			local marks = (if o.frozen then "  ❄" else "") .. (if o.hidden then "  ◌" else "")
			local b = Kit.button(list, icon .. "  " .. o.name .. marks .. "\n" .. (o.latin or ""), function()
				editor:select({ r.id })
				editor:focusSelection()
			end, { LayoutOrder = i, Size = UDim2.new(1, -6, 0, Kit.TAP + 4), TextXAlignment = Enum.TextXAlignment.Left, TextSize = 14 })
			Kit.pad(b, 8)
			Kit.setActive(b, table.find(editor.selection, r.id) ~= nil)
		end
	end
	search:GetPropertyChangedSignal("Text"):Connect(function()
		editor.explorerQuery = search.Text
		fill()
	end)
	fill()
	local prev = editor.onProjectChanged
	editor.onProjectChanged = function()
		fill()
		if prev then
			prev()
		end
	end
	return function()
		editor.onProjectChanged = prev
	end
end

return ExplorerPanel
</ProtectedString>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="RBX00000041">
              <Properties>
                <string name="Name">LogicPanel</string>
                <ProtectedString name="Source">--!nonstrict
-- Логика карты: блоки в духе Scratch и текстовый режим с командами, похожими на Luau
-- Оба режима редактируют одно дерево и пользуются одним набором команд

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Workshop"):WaitForChild("Shared")
local UiText = require(Shared.UiText)
local Util = require(Shared.Util)
local Logic = require(Shared.Logic)
local Commands = require(Shared.Logic.Commands)

local Kit = require(script.Parent.Parent.Parent.UI.Kit)
local Picker = require(script.Parent.Parent.Picker)

local L, H = UiText.L, UiText.H

local LogicPanel = {}

local function sortedDefs(t)
	local out = {}
	for name, def in t do
		table.insert(out, { id = name, title = def.title, hint = name })
	end
	table.sort(out, function(a, b)
		return a.title &lt; b.title
	end)
	return out
end

local function defaultArg(spec)
	local t = spec.type
	if t == "number" then
		return { kind = "num", value = spec.min or 1 }
	elseif t == "bool" then
		return { kind = "bool", value = true }
	elseif t == "weather" then
		return { kind = "str", value = "Rain" }
	elseif t == "text" or t == "string" or t == "clip" or t == "sound" then
		return { kind = "str", value = "" }
	end
	return { kind = "ref", ref = "" }
end

local function defaultArgs(def)
	local args = {}
	for i, spec in def.args do
		if not spec.optional then
			args[i] = defaultArg(spec)
		end
	end
	return args
end

function LogicPanel.render(editor, panel: Frame)
	local project = editor.state.project
	local root = Kit.frame(panel, { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) })

	local header = Kit.frame(root, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, Kit.TAP) })
	Kit.list(header, 6, true)
	local body = Kit.frame(root, { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, Kit.TAP + 6), Size = UDim2.new(1, 0, 1, -Kit.TAP - 6) })

	local errorsBox: Frame
	local errorsByBid: { [string]: string } = {}
	local errorsByLine: { [number]: string } = {}

	local function compileErrors()
		local _, errs = Logic.compile(editor.state.project)
		local all = table.clone(errs or {})
		for _, e in editor.logicErrors or {} do
			if e.runtime then
				table.insert(all, e)
			end
		end
		return all
	end

	local render

	local function showErrors(errs)
		table.clear(errorsByBid)
		table.clear(errorsByLine)
		for _, ch in errorsBox:GetChildren() do
			if ch:IsA("GuiObject") then
				ch:Destroy()
			end
		end
		if #errs == 0 then
			Kit.label(errorsBox, L.NoErrors, { TextColor3 = Kit.C.good, TextSize = 14 })
			return
		end
		for i, e in errs do
			if e.bid then
				errorsByBid[e.bid] = e.message
			end
			if e.line then
				errorsByLine[e.line] = e.message
			end
			local text = if e.line and project.logic.mode == "text"
				then string.format(L.ErrorAtLine, e.line, e.message)
				else string.format(L.ErrorInBlock, e.message)
			Kit.label(errorsBox, text, { TextColor3 = Kit.C.bad, TextSize = 13, LayoutOrder = i, Size = UDim2.new(1, 0, 0, 40) })
		end
	end

	local function setTree(tree)
		local ok, err = editor.state:apply({ op = "setProject", path = { "logic", "blocks" }, value = tree })
		if not ok then
			Kit.toast(editor.gui, tostring(err), Kit.C.bad)
		end
		editor.logicErrors = {}
		render()
	end

	local modeBlocks = Kit.button(header, L.LogicBlocks, function()
		if project.logic.mode == "blocks" then
			return
		end
		local tree, errs = Logic.Parser.parse(project.logic.text.source, Logic.nameResolver(project))
		if not tree or (errs and #errs &gt; 0) then
			showErrors(errs or {})
			Kit.toast(editor.gui, H.LogicErrorHint, Kit.C.bad)
			return
		end
		editor.state:apply({ op = "batch", ops = {
			{ op = "setProject", path = { "logic", "blocks" }, value = tree },
			{ op = "setProject", path = { "logic", "mode" }, value = "blocks" },
		} })
		render()
	end, { Size = UDim2.new(0, 110, 1, 0), LayoutOrder = 1 })
	local modeText = Kit.button(header, L.LogicText, function()
		if project.logic.mode == "text" then
			return
		end
		local source = Logic.toText(project, project.logic.blocks)
		editor.state:apply({ op = "batch", ops = {
			{ op = "setProject", path = { "logic", "text" }, value = { source = source, refs = Logic.collectRefs(project.logic.blocks) } },
			{ op = "setProject", path = { "logic", "mode" }, value = "text" },
		} })
		render()
	end, { Size = UDim2.new(0, 110, 1, 0), LayoutOrder = 2 })
	Kit.button(header, L.Check, function()
		showErrors(compileErrors())
	end, { Size = UDim2.new(0, 110, 1, 0), LayoutOrder = 3 })

	-- -----------------------------------------------------------------------
	-- блоки

	local nextBid = 0
	local function freshBid(tree): string
		local used = {}
		local function walk(v)
			if type(v) ~= "table" then
				return
			end
			if type(v.bid) == "string" then
				used[v.bid] = true
			end
			for _, x in v do
				walk(x)
			end
		end
		walk(tree)
		repeat
			nextBid += 1
		until not used["b" .. nextBid]
		return "b" .. nextBid
	end

	local function argField(parent: Instance, tree, node, def, i: number, order: number)
		local spec = def.args[i]
		local a = node.args[i]
		local title = spec.title
		local t = spec.type
		if Commands.TARGET_TYPES[t] then
			Picker.field(editor, parent, title, t, a and a.ref, function(id)
				node.args[i] = { kind = "ref", ref = id }
				setTree(tree)
			end, order)
		elseif t == "clip" then
			local _, slot = Kit.row(parent, title, order)
			local modelId = nil
			for j, s in def.args do
				if s.type == "model" and node.args[j] and node.args[j].kind == "ref" then
					modelId = node.args[j].ref
					break
				end
			end
			Kit.button(slot, if a and a.kind == "str" and a.value ~= "" then a.value else "…", function()
				local m = modelId and project.map.objects[modelId]
				local opts = {}
				if spec.optional then
					table.insert(opts, { id = false, title = L.None })
				end
				if m and m.kind == "model" then
					for _, cl in m.model.clips do
						table.insert(opts, { id = cl.name, title = cl.name })
					end
				end
				Kit.choose(editor.gui, title, opts, function(name)
					if name then
						node.args[i] = { kind = "str", value = name }
					else
						node.args[i] = nil
					end
					setTree(tree)
				end)
			end, { TextSize = 13 })
		elseif t == "weather" then
			local _, slot = Kit.row(parent, title, order)
			local cur = a and a.kind == "str" and Commands.WEATHER_TITLES[a.value] or "…"
			Kit.button(slot, cur, function()
				local opts = {}
				for _, id in { "Clear", "Rain", "Snow", "Fog", "Storm" } do
					table.insert(opts, { id = id, title = Commands.WEATHER_TITLES[id] })
				end
				Kit.choose(editor.gui, title, opts, function(id)
					node.args[i] = { kind = "str", value = id }
					setTree(tree)
				end)
			end, { TextSize = 13 })
		elseif t == "bool" then
			local v = a and a.kind == "bool" and a.value
			Kit.toggle(parent, title, v == true, function(nv)
				node.args[i] = { kind = "bool", value = nv }
				setTree(tree)
			end, order)
		elseif t == "number" then
			local _, slot = Kit.row(parent, title, order)
			local text = if a and a.kind == "num" then tostring(a.value) elseif a then Logic.Printer.exprText(a, Logic.nameOf(project)) else ""
			Kit.textbox(slot, text, "—", function(s)
				local n = tonumber((string.gsub(s, ",", ".")))
				if n then
					node.args[i] = { kind = "num", value = n }
				elseif s == "" and spec.optional then
					node.args[i] = nil
				else
					return
				end
				-- необязательные аргументы не должны оставлять дыр
				setTree(tree)
			end)
		else
			local _, slot = Kit.row(parent, title, order)
			Kit.textbox(slot, if a and a.kind == "str" then a.value else "", title, function(s)
				node.args[i] = { kind = "str", value = s }
				setTree(tree)
			end, { MultiLine = t == "text", TextWrapped = true })
			if t == "text" then
				slot.Parent.Size = UDim2.new(1, 0, 0, 64)
			end
		end
	end

	local function fixHoles(args)
		-- аргументы идут подряд: после пропущенного необязательного остальные не учитываются
		local n = 0
		for k in args do
			if type(k) == "number" and k &gt; n then
				n = k
			end
		end
		for k = 1, n do
			if args[k] == nil then
				for j = k, n do
					args[j] = nil
				end
				break
			end
		end
	end

	local renderBody

	local function card(parent: Instance, bid: string?, depth: number, order: number): Frame
		local f = Kit.frame(parent, {
			BackgroundColor3 = if depth == 0 then Kit.C.accentDim else Kit.C.panel2,
			Size = UDim2.new(1, -depth * 12, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = order,
		})
		Kit.corner(f, 8)
		Kit.pad(f, 6)
		Kit.list(f, 4)
		if bid and errorsByBid[bid] then
			local s = Instance.new("UIStroke")
			s.Color = Kit.C.bad
			s.Thickness = 2
			s.Parent = f
			Kit.label(f, errorsByBid[bid], { TextColor3 = Kit.C.bad, TextSize = 13, LayoutOrder = 999, Size = UDim2.new(1, 0, 0, 36) })
		end
		return f
	end

	local function moveButtons(parent: Instance, tree, list, index: number)
		local row = Kit.frame(parent, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 36), LayoutOrder = 900 })
		Kit.list(row, 4, true)
		Kit.button(row, "↑", function()
			if index &gt; 1 then
				list[index], list[index - 1] = list[index - 1], list[index]
				setTree(tree)
			end
		end, { Size = UDim2.new(0, 52, 1, 0), LayoutOrder = 1 })
		Kit.button(row, "↓", function()
			if index &lt; #list then
				list[index], list[index + 1] = list[index + 1], list[index]
				setTree(tree)
			end
		end, { Size = UDim2.new(0, 52, 1, 0), LayoutOrder = 2 })
		Kit.button(row, L.Delete, function()
			table.remove(list, index)
			setTree(tree)
		end, { Size = UDim2.new(0, 100, 1, 0), LayoutOrder = 3, BackgroundColor3 = Kit.C.bad })
	end

	local function condEditor(parent: Instance, tree, holder, key: string)
		local cond = holder[key]
		local negated = cond and cond.kind == "not"
		local inner = if negated then cond.e else cond
		if inner and inner.kind ~= "cond" then
			Kit.label(parent, Logic.Printer.exprText(cond, Logic.nameOf(project)), { TextSize = 13, LayoutOrder = 2 })
			return
		end
		local def = inner and Commands.conditions[inner.name]
		Kit.button(parent, if def then def.title else L.AddCondition, function()
			Kit.choose(editor.gui, L.AddCondition, sortedDefs(Commands.conditions), function(name)
				local c = { kind = "cond", name = name, args = defaultArgs(Commands.conditions[name]) }
				holder[key] = if negated then { kind = "not", e = c } else c
				setTree(tree)
			end)
		end, { LayoutOrder = 2 })
		Kit.toggle(parent, "not", negated, function(v)
			if inner then
				holder[key] = if v then { kind = "not", e = inner } else inner
				setTree(tree)
			end
		end, 3)
		if def then
			for i = 1, #def.args do
				argField(parent, tree, inner, def, i, 10 + i)
			end
		end
	end

	function renderBody(parent: Instance, tree, list, depth: number, baseOrder: number)
		for index, st in list do
			local f = card(parent, st.bid, depth, baseOrder + index)
			if st.kind == "call" then
				local def = Commands.actions[st.name]
				Kit.button(f, if def then def.title else tostring(st.name), function()
					Kit.choose(editor.gui, L.AddAction, sortedDefs(Commands.actions), function(name)
						st.name = name
						st.args = defaultArgs(Commands.actions[name])
						setTree(tree)
					end)
				end, { LayoutOrder = 1, Font = Kit.FONT_BOLD })
				if def then
					for i = 1, #def.args do
						argField(f, tree, st, def, i, 10 + i)
					end
					fixHoles(st.args)
				end
			elseif st.kind == "if" then
				Kit.label(f, L.AddIf, { Font = Kit.FONT_BOLD, LayoutOrder = 1 })
				local br = st.branches[1]
				condEditor(f, tree, br, "cond")
				local inner = Kit.frame(f, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 50 })
				Kit.list(inner, 4)
				renderBody(inner, tree, br.body, depth + 1, 0)
				st.elseBody = st.elseBody or {}
				Kit.label(f, L.AddElse, { Font = Kit.FONT_BOLD, LayoutOrder = 60 })
				local elseF = Kit.frame(f, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 61 })
				Kit.list(elseF, 4)
				renderBody(elseF, tree, st.elseBody, depth + 1, 0)
			elseif st.kind == "for" then
				Kit.label(f, L.AddRepeat, { Font = Kit.FONT_BOLD, LayoutOrder = 1 })
				local count = if st.to.kind == "num" then st.to.value else 1
				Kit.stepper(f, L.AddRepeat, count, 1, 1, 1000, function(v)
					st.from = { kind = "num", value = 1 }
					st.to = { kind = "num", value = v }
					setTree(tree)
				end, 2)
				local inner = Kit.frame(f, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 50 })
				Kit.list(inner, 4)
				renderBody(inner, tree, st.body, depth + 1, 0)
			else
				-- переменные редактируются в текстовом режиме
				Kit.label(f, Logic.Printer.stmtText(st, Logic.nameOf(project)), { TextSize = 13, LayoutOrder = 1, Font = Enum.Font.Code })
			end
			moveButtons(f, tree, list, index)
		end
		-- добавление блоков
		local adds = Kit.frame(parent, { BackgroundTransparency = 1, Size = UDim2.new(1, -depth * 12, 0, 40), LayoutOrder = baseOrder + #list + 1 })
		Kit.list(adds, 4, true)
		Kit.button(adds, "+ " .. L.AddAction, function()
			Kit.choose(editor.gui, L.AddAction, sortedDefs(Commands.actions), function(name)
				table.insert(list, { kind = "call", name = name, args = defaultArgs(Commands.actions[name]), bid = freshBid(tree) })
				setTree(tree)
			end)
		end, { Size = UDim2.new(0, 140, 1, 0), LayoutOrder = 1, TextSize = 13 })
		Kit.button(adds, "+ " .. L.AddIf, function()
			table.insert(list, {
				kind = "if", bid = freshBid(tree),
				branches = { { cond = { kind = "cond", name = "LightIsOn", args = { { kind = "ref", ref = "" } } }, body = {} } },
				elseBody = {},
			})
			setTree(tree)
		end, { Size = UDim2.new(0, 100, 1, 0), LayoutOrder = 2, TextSize = 13 })
		Kit.button(adds, "+ " .. L.AddRepeat, function()
			table.insert(list, { kind = "for", var = "i", from = { kind = "num", value = 1 }, to = { kind = "num", value = 3 }, body = {}, bid = freshBid(tree) })
			setTree(tree)
		end, { Size = UDim2.new(0, 130, 1, 0), LayoutOrder = 3, TextSize = 13 })
	end

	local function renderBlocks(container: Instance)
		local tree = Util.deepCopy(project.logic.blocks)
		local list = Kit.scroll(container)
		Kit.list(list, 8)
		for hi, h in tree.handlers do
			local f = card(list, h.bid, 0, hi)
			local def = Commands.events[h.event]
			Kit.button(f, if def then def.title else tostring(h.event), function()
				Kit.choose(editor.gui, L.AddEvent, sortedDefs(Commands.events), function(name)
					h.event = name
					h.args = defaultArgs(Commands.events[name])
					setTree(tree)
				end)
			end, { LayoutOrder = 1, Font = Kit.FONT_BOLD })
			if def then
				for i = 1, #def.args do
					argField(f, tree, h, def, i, 10 + i)
				end
			end
			local inner = Kit.frame(f, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 50 })
			Kit.list(inner, 4)
			renderBody(inner, tree, h.body, 1, 0)
			moveButtons(f, tree, tree.handlers, hi)
		end
		Kit.button(list, "+ " .. L.AddEvent, function()
			Kit.choose(editor.gui, L.AddEvent, sortedDefs(Commands.events), function(name)
				table.insert(tree.handlers, { kind = "handler", event = name, args = defaultArgs(Commands.events[name]), body = {}, bid = freshBid(tree) })
				setTree(tree)
			end)
		end, { LayoutOrder = #tree.handlers + 1 })
	end

	-- -----------------------------------------------------------------------
	-- текст

	local function renderText(container: Instance)
		Logic.refreshText(project)
		local src = project.logic.text.source
		local scroll = Kit.scroll(container, { ScrollingDirection = Enum.ScrollingDirection.XY, AutomaticCanvasSize = Enum.AutomaticSize.XY })
		local gutter = Kit.label(scroll, "", {
			Size = UDim2.new(0, 34, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Font = Enum.Font.Code, TextSize = 15,
			TextXAlignment = Enum.TextXAlignment.Right, TextYAlignment = Enum.TextYAlignment.Top, TextColor3 = Kit.C.dim, RichText = true,
			TextWrapped = false,
		})
		local box = Kit.textbox(scroll, src, "on MapStarted() do\n  Wait(1)\nend", nil, {
			MultiLine = true, TextWrapped = false, Font = Enum.Font.Code, TextSize = 15,
			TextYAlignment = Enum.TextYAlignment.Top, Position = UDim2.fromOffset(40, 0),
			Size = UDim2.new(1, -44, 0, 0), AutomaticSize = Enum.AutomaticSize.XY,
		})
		local function updateGutter()
			local lines = {}
			local n = 1
			for _ in string.gmatch(box.Text, "\n") do
				n += 1
			end
			for i = 1, n do
				if errorsByLine[i] then
					table.insert(lines, string.format('&lt;font color="#eb5050"&gt;%d&lt;/font&gt;', i))
				else
					table.insert(lines, tostring(i))
				end
			end
			gutter.Text = table.concat(lines, "\n")
		end
		updateGutter()
		box:GetPropertyChangedSignal("Text"):Connect(updateGutter)
		box.FocusLost:Connect(function()
			-- введённый код сохраняется всегда, даже с ошибками, чтобы его можно было исправить
			local text = box.Text
			local tree = Logic.Parser.parse(text, Logic.nameResolver(project))
			local refs = if tree then Logic.collectRefs(tree) else project.logic.text.refs
			editor.state:apply({ op = "setProject", path = { "logic", "text" }, value = { source = text, refs = refs } })
			editor.logicErrors = {}
			showErrors(compileErrors())
			updateGutter()
		end)
	end

	function render()
		project = editor.state.project
		for _, ch in body:GetChildren() do
			if ch:IsA("GuiObject") then
				ch:Destroy()
			end
		end
		Kit.setActive(modeBlocks, project.logic.mode == "blocks")
		Kit.setActive(modeText, project.logic.mode == "text")
		errorsBox = Kit.frame(body, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
		Kit.list(errorsBox, 2)
		local errs = compileErrors()
		for _, e in editor.logicErrors or {} do
			if not e.runtime then
				table.insert(errs, e)
			end
		end
		showErrors(errs)
		local content = Kit.frame(body, { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 0), Size = UDim2.fromScale(1, 1) })
		errorsBox:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
			content.Position = UDim2.fromOffset(0, errorsBox.AbsoluteSize.Y + 6)
			content.Size = UDim2.new(1, 0, 1, -errorsBox.AbsoluteSize.Y - 6)
		end)
		content.Position = UDim2.fromOffset(0, errorsBox.AbsoluteSize.Y + 6)
		content.Size = UDim2.new(1, 0, 1, -errorsBox.AbsoluteSize.Y - 6)
		if project.logic.mode == "text" then
			renderText(content)
		else
			renderBlocks(content)
		end
	end

	render()
	return nil
end

return LogicPanel
</ProtectedString>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="RBX00000042">
              <Properties>
                <string name="Name">MapPanel</string>
                <ProtectedString name="Source">--!nonstrict
-- Вкладки «Карта» и «Модели»: добавление фигур и готовых моделей, свойства, назначения

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Workshop"):WaitForChild("Shared")
local UiText = require(Shared.UiText)
local Catalog = require(Shared.Catalog)
local Format = require(Shared.Format)
local Ids = require(Shared.Ids)
local Logic = require(Shared.Logic)
local Closet = require(Shared.Closet)
local Model = require(Shared.Model)
local Remotes = require(Shared.Roblox.Remotes)

local Kit = require(script.Parent.Parent.Parent.UI.Kit)
local Picker = require(script.Parent.Parent.Picker)

local L, H = UiText.L, UiText.H

local MapPanel = {}

local ROLE_TITLES = {
	closet = L.RoleCloset, door = L.RoleDoor, light = L.RoleLight, npc = L.RoleNpc,
	creature = L.RoleCreature, zone = L.RoleZone, waypoint = L.RoleWaypoint, spawn = L.RoleSpawn, statue = L.RoleStatue,
}

local ASSIGN = {
	{ id = "closet", title = L.AssignCloset },
	{ id = "door", title = L.AssignDoor },
	{ id = "light", title = L.AssignLight },
	{ id = "npc", title = L.AssignNpc },
	{ id = "creature", title = L.AssignCreature },
	{ id = "zone", title = L.AssignZone },
	{ id = "waypoint", title = L.AssignWaypoint },
	{ id = "spawn", title = L.AssignSpawn },
	{ id = "statue", title = L.AssignStatue },
}

local function section(list: Instance, title: string, order: number)
	Kit.label(list, title, { Font = Kit.FONT_BOLD, TextSize = 15, LayoutOrder = order, Size = UDim2.new(1, 0, 0, 28) })
end

-- Палитра цветов сеткой: крупные квадраты под палец
local function palette(list: Instance, current, onPick, order: number, root: Instance?)
	local grid = Kit.frame(list, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order })
	local g = Instance.new("UIGridLayout")
	g.CellSize = UDim2.fromOffset(40, 40)
	g.CellPadding = UDim2.fromOffset(6, 6)
	g.Parent = grid
	for _, c in Catalog.PALETTE do
		local b = Kit.button(grid, "", function()
			onPick(c)
		end, { BackgroundColor3 = Color3.fromRGB(c[1], c[2], c[3]) })
		if current and current[1] == c[1] and current[2] == c[2] and current[3] == c[3] then
			local s = Instance.new("UIStroke")
			s.Thickness = 3
			s.Color = Color3.new(1, 1, 1)
			s.Parent = b
		end
	end
	-- любой цвет через полную палитру
	Kit.button(grid, L.AnyColor, function()
		Kit.colorPicker(root or list:FindFirstAncestorOfClass("ScreenGui"), current, onPick)
	end, { TextSize = 20, BackgroundColor3 = Kit.C.panel2 })
end

-- Свойства детали (отдельной или детали модели). base — путь к детали
local function partProps(editor, list: Instance, id: string, base: { any }, data, order: number)
	local function set(path: { any }, value)
		local full = table.clone(base)
		for _, k in path do
			table.insert(full, k)
		end
		local ok, err = editor.state:apply({ op = "set", id = id, path = full, value = value })
		if not ok then
			Kit.toast(editor.gui, tostring(err), Kit.C.bad)
		end
		return ok
	end
	section(list, L.Size, order)
	for axis = 1, 3 do
		local names = { "X", "Y", "Z" }
		Kit.stepper(list, L.Size .. " " .. names[axis], data.size[axis], if editor.grid &gt; 0 then editor.grid else 0.1, 0.2, 512, function(v)
			local s = table.clone(data.size)
			s[axis] = v
			if set({ "size" }, s) then
				data.size = s
			end
		end, order + axis)
	end
	local shapeRow, shapeSlot = Kit.row(list, L.Shapes, order + 5)
	local _ = shapeRow
	local shapeTitle = data.shape
	for _, s in Catalog.SHAPES do
		if s.id == data.shape then
			shapeTitle = s.title
		end
	end
	Kit.button(shapeSlot, shapeTitle, function()
		local opts = {}
		for _, s in Catalog.SHAPES do
			table.insert(opts, { id = s.id, title = s.title })
		end
		Kit.choose(editor.gui, L.Shapes, opts, function(shape)
			set({ "shape" }, shape)
			editor:renderPanel()
		end)
	end)
	section(list, L.Color, order + 6)
	palette(list, data.color, function(c)
		set({ "color" }, c)
		editor:renderPanel()
	end, order + 7)
	local _, matSlot = Kit.row(list, L.Material, order + 8)
	Kit.button(matSlot, Catalog.MATERIAL_TITLES[data.material] or data.material, function()
		local opts = {}
		for _, m in Format.MATERIALS do
			table.insert(opts, { id = m, title = Catalog.MATERIAL_TITLES[m] or m })
		end
		Kit.choose(editor.gui, L.Material, opts, function(m)
			set({ "material" }, m)
			editor:renderPanel()
		end)
	end)
	local _, texSlot = Kit.row(list, L.Texture, order + 9)
	local texTitle = L.NoTexture
	if data.texture and Catalog.TEXTURE_SET[data.texture] then
		texTitle = Catalog.TEXTURE_SET[data.texture].title
	elseif data.texture then
		texTitle = data.texture
	end
	Kit.button(texSlot, texTitle, function()
		local opts = { { id = false, title = L.NoTexture } }
		for _, t in Catalog.TEXTURES do
			table.insert(opts, { id = t.id, title = t.title })
		end
		table.insert(opts, { id = "custom", title = L.TextureById, hint = H.TextureIdHint })
		Kit.choose(editor.gui, L.Texture, opts, function(t)
			if t == "custom" then
				Kit.prompt(editor.gui, L.TextureById, H.TextureIdHint, L.TextureIdPlaceholder, function(text)
					local id = string.match(text, "(%d+)")
					if id then
						set({ "texture" }, "rbxassetid://" .. id)
					end
					editor:renderPanel()
				end)
				return
			end
			set({ "texture" }, if t then t else nil)
			editor:renderPanel()
		end)
	end, { TextSize = 13, TextTruncate = Enum.TextTruncate.AtEnd })
	if data.texture then
		Kit.stepper(list, L.TextureTile, data.textureTile or 4, 0.5, 0.5, 64, function(v)
			set({ "textureTile" }, v)
		end, order + 9)
	end
	Kit.slider(list, L.Transparency, data.transparency or 0, 0, 1, function(v)
		set({ "transparency" }, v)
	end, order + 10)
end

local function nudgePad(editor, list: Instance, obj, order: number)
	if obj.frozen then
		Kit.label(list, H.FrozenHint, { TextColor3 = Kit.C.warn, TextSize = 13, LayoutOrder = order, Size = UDim2.new(1, 0, 0, 36) })
		return
	end
	section(list, L.Nudge, order)
	local pad = Kit.frame(list, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order + 1 })
	local g = Instance.new("UIGridLayout")
	g.CellSize = UDim2.new(0.25, -6, 0, Kit.TAP)
	g.CellPadding = UDim2.fromOffset(6, 6)
	g.Parent = pad
	local step = if editor.grid &gt; 0 then editor.grid else 0.25
	local function move(axis: number, d: number)
		local pos = table.clone(obj.pos)
		pos[axis] += d
		editor.state:apply({ op = "set", id = obj.id, path = { "pos" }, value = pos })
		obj = editor.state:obj(obj.id)
	end
	local function turn(d: number)
		local rot = table.clone(obj.rot)
		rot[2] = (rot[2] + d) % 360
		editor.state:apply({ op = "set", id = obj.id, path = { "rot" }, value = rot })
		obj = editor.state:obj(obj.id)
	end
	for _, b in {
		{ "X −", function() move(1, -step) end }, { "X +", function() move(1, step) end },
		{ "Y −", function() move(2, -step) end }, { "Y +", function() move(2, step) end },
		{ "Z −", function() move(3, -step) end }, { "Z +", function() move(3, step) end },
		{ "⟲ 15°", function() turn(-15) end }, { "⟳ 15°", function() turn(15) end },
	} do
		Kit.button(pad, b[1], b[2], { TextSize = 14 })
	end
end

local function clipNames(obj)
	local names = {}
	if obj.kind == "model" then
		for _, c in obj.model.clips do
			table.insert(names, { id = c.name, title = c.name })
		end
	end
	table.sort(names, function(a, b)
		return a.title &lt; b.title
	end)
	return names
end

local function roleProps(editor, list: Instance, obj, order: number)
	local role = obj.role
	local id = obj.id
	local function set(path, value)
		local full = { "role" }
		for _, k in path do
			table.insert(full, k)
		end
		local ok, err = editor.state:apply({ op = "set", id = id, path = full, value = value })
		if not ok then
			Kit.toast(editor.gui, tostring(err), Kit.C.bad)
		end
	end
	local t = role.type
	if t == "closet" then
		Kit.label(list, H.ClosetHint, { TextColor3 = Kit.C.dim, TextSize = 13, LayoutOrder = order, Size = UDim2.new(1, 0, 0, 36) })
		for i, which in { { "entry", L.ClosetEntry }, { "inside", L.ClosetInside }, { "exit", L.ClosetExit } } do
			local b = Kit.button(list, which[2], function()
				editor.closetPoint = if editor.closetPoint == which[1] then nil else which[1]
				if editor.tool == "select" or editor.tool == "scale" then
					editor:setTool("move")
				end
				editor:updateGizmo()
				editor:renderPanel()
			end, { LayoutOrder = order + i })
			Kit.setActive(b, editor.closetPoint == which[1])
		end
		Kit.button(list, L.ResetClosetClips, function()
			local enter, leave = Closet.defaultClips(role.entry, role.inside, role.exit)
			editor.state:apply({ op = "batch", ops = {
				{ op = "set", id = id, path = { "role", "enterClip" }, value = enter },
				{ op = "set", id = id, path = { "role", "exitClip" }, value = leave },
			} })
		end, { LayoutOrder = order + 5 })
		Kit.button(list, L.EditEnterClip, function()
			editor.animTarget = { kind = "closet", id = id, which = "enterClip" }
			editor:selectTab("anim")
		end, { LayoutOrder = order + 6, Size = UDim2.new(1, 0, 0, 52) })
		Kit.button(list, L.EditExitClip, function()
			editor.animTarget = { kind = "closet", id = id, which = "exitClip" }
			editor:selectTab("anim")
		end, { LayoutOrder = order + 7, Size = UDim2.new(1, 0, 0, 52) })
	elseif t == "door" then
		Kit.stepper(list, L.DoorAngle, role.openAngle, 5, -180, 180, function(v)
			set({ "openAngle" }, v)
		end, order + 1)
		Kit.stepper(list, L.DoorTime, role.openTime, 0.1, 0, 10, function(v)
			set({ "openTime" }, v)
		end, order + 2)
		Kit.stepper(list, L.HingeOffset, role.hinge[1], 0.1, -200, 200, function(v)
			set({ "hinge" }, { v, role.hinge[2], role.hinge[3] })
		end, order + 3)
		Kit.toggle(list, L.OpenOnStart, role.open, function(v)
			set({ "open" }, v)
		end, order + 4)
		Kit.toggle(list, L.Locked, role.locked == true, function(v)
			set({ "locked" }, v)
		end, order + 5)
		Kit.toggle(list, L.OwnedRoom, role.owned == true, function(v)
			set({ "owned" }, v)
		end, order + 6)
	elseif t == "statue" then
		Kit.textbox(list, role.username, L.StatueUser, function(text)
			local name = string.match(text, "^%s*@?([%w_]+)%s*$")
			if name and #name &lt;= 20 then
				set({ "username" }, name)
			end
			editor:renderPanel()
		end, { LayoutOrder = order + 1 })
		local _, poseSlot = Kit.row(list, L.StatuePose, order + 2)
		Kit.button(poseSlot, if role.pose == "stand" then L.PoseStand else L.PoseAdmire, function()
			Kit.choose(editor.gui, L.StatuePose, {
				{ id = "admire", title = L.PoseAdmire },
				{ id = "stand", title = L.PoseStand },
			}, function(v)
				set({ "pose" }, v)
				editor:renderPanel()
			end)
		end)
		Kit.toggle(list, L.StatueOrb, role.orb ~= false, function(v)
			set({ "orb" }, v)
		end, order + 3)
	elseif t == "light" then
		Kit.toggle(list, L.LightOn, role.on, function(v)
			set({ "on" }, v)
		end, order + 1)
		Kit.slider(list, L.Brightness, role.brightness, 0, 10, function(v)
			set({ "brightness" }, v)
		end, order + 2)
		Kit.slider(list, L.Range, role.range, 0, 60, function(v)
			set({ "range" }, v)
		end, order + 3)
		palette(list, role.color, function(c)
			set({ "color" }, c)
			editor:renderPanel()
		end, order + 4)
	elseif t == "creature" then
		Kit.stepper(list, L.Speed, role.speed, 1, 1, 100, function(v)
			set({ "speed" }, v)
		end, order + 1)
	elseif t == "waypoint" then
		Picker.field(editor, list, L.NextPoint, "waypoint", role.next and role.next.ref, function(pick)
			set({ "next" }, if pick then { ref = pick } else nil)
			editor:renderPanel()
		end, order + 1, true)
	elseif t == "npc" then
		local triggers = {
			{ id = "roomEnter", title = L.TriggerRoomEnter },
			{ id = "interact", title = L.TriggerInteract },
			{ id = "logic", title = L.TriggerLogic },
		}
		local cur = L.TriggerInteract
		for _, tr in triggers do
			if tr.id == role.trigger then
				cur = tr.title
			end
		end
		local _, trSlot = Kit.row(list, L.NpcTrigger, order + 1)
		Kit.button(trSlot, cur, function()
			Kit.choose(editor.gui, L.NpcTrigger, triggers, function(v)
				set({ "trigger" }, v)
				editor:renderPanel()
			end)
		end, { TextSize = 13 })
		if role.trigger == "roomEnter" then
			Picker.field(editor, list, L.RoleZone, "zone", role.zone and role.zone.ref, function(pick)
				set({ "zone" }, if pick then { ref = pick } else nil)
				editor:renderPanel()
			end, order + 2)
		end
		local _, clipSlot = Kit.row(list, L.GreetingClip, order + 3)
		Kit.button(clipSlot, role.greetingClip or L.None, function()
			local opts = clipNames(obj)
			table.insert(opts, 1, { id = false, title = L.None })
			Kit.choose(editor.gui, L.GreetingClip, opts, function(v)
				set({ "greetingClip" }, if v then v else nil)
				editor:renderPanel()
			end)
		end, { TextSize = 13 })
		Picker.field(editor, list, L.TextAnchor, nil, role.anchor and role.anchor.ref, function(pick)
			set({ "anchor" }, if pick then { ref = pick } else nil)
			editor:renderPanel()
		end, order + 4, true)
		Kit.stepper(list, L.TextSize, role.textSize, 2, 8, 60, function(v)
			set({ "textSize" }, v)
		end, order + 5)
		section(list, L.Lines, order + 6)
		for i, line in role.lines do
			local box = Kit.frame(list, { BackgroundColor3 = Kit.C.panel2, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order + 6 + i })
			Kit.corner(box, 8)
			Kit.pad(box, 6)
			Kit.list(box, 4)
			Kit.textbox(box, line.text, L.LabelText, function(text)
				set({ "lines", i, "text" }, text)
			end, { MultiLine = true, TextWrapped = true, Size = UDim2.new(1, 0, 0, 70), TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = 1 })
			Kit.stepper(box, L.LineDelay, line.delay, 0.5, 0, 120, function(v)
				set({ "lines", i, "delay" }, v)
			end, 2)
			Kit.stepper(box, L.LineDuration, line.duration, 0.5, 0.5, 60, function(v)
				set({ "lines", i, "duration" }, v)
			end, 3)
			Kit.button(box, L.Delete, function()
				local lines = table.clone(role.lines)
				table.remove(lines, i)
				set({ "lines" }, lines)
				editor:renderPanel()
			end, { LayoutOrder = 4, BackgroundColor3 = Kit.C.bad })
		end
		Kit.button(list, L.AddLine, function()
			local lines = table.clone(role.lines)
			local last = lines[#lines]
			table.insert(lines, { text = "…", delay = if last then last.delay + last.duration + 0.5 else 0, duration = 3 })
			set({ "lines" }, lines)
			editor:renderPanel()
		end, { LayoutOrder = order + 60 })
	end
end

function MapPanel.render(editor, panel: Frame)
	local list = Kit.scroll(panel)
	Kit.list(list, 6)
	local order = 0
	local function nextOrder(): number
		order += 1
		return order
	end
	local project = editor.state.project

	-- добавление
	local adds = Kit.frame(list, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = nextOrder() })
	local g = Instance.new("UIGridLayout")
	g.CellSize = UDim2.new(0.5, -4, 0, Kit.TAP)
	g.CellPadding = UDim2.fromOffset(6, 6)
	g.Parent = adds
	Kit.button(adds, L.AddShape, function()
		local opts = {}
		for _, s in Catalog.SHAPES do
			table.insert(opts, { id = s.id, title = s.title })
		end
		Kit.choose(editor.gui, L.Shapes, opts, function(shape)
			editor:addShape(shape)
		end)
	end)
	if not editor.modelEdit then
		Kit.button(adds, L.AddPrefab, function()
			local opts = {}
			for _, p in Catalog.PREFABS do
				table.insert(opts, { id = p.id, title = p.title, hint = p.group })
			end
			Kit.choose(editor.gui, L.AddPrefab, opts, function(pid)
				editor:addPrefab(pid)
			end)
		end)
		Kit.button(adds, L.MyModels, function()
			local res = Remotes.fn("Request"):InvokeServer("ListLibrary")
			if not res or not res.ok then
				Kit.toast(editor.gui, L.LoadFailed, Kit.C.bad)
				return
			end
			local opts = {}
			for _, m in res.models do
				table.insert(opts, { id = m.id, title = m.name })
			end
			if #opts == 0 then
				Kit.toast(editor.gui, L.NothingHere)
				return
			end
			Kit.choose(editor.gui, L.MyModels, opts, function(assetId)
				local r = Remotes.fn("Request"):InvokeServer("GetLibraryModel", assetId)
				if r and r.ok then
					local obj = Model.fromAsset(project, r.asset, editor.preview:placementPoint(editor.grid))
					editor:addObjects({ obj })
				else
					Kit.toast(editor.gui, L.LoadFailed, Kit.C.bad)
				end
			end)
		end)
	end

	local selId = editor.selection[1]
	local obj = selId and project.map.objects[selId]
	if editor.modelEdit then
		local m = project.map.objects[editor.modelEdit]
		Kit.button(adds, L.DoneEditing, function()
			editor:enterModelEdit(nil)
		end, { BackgroundColor3 = Kit.C.accent })
		Kit.label(list, H.ModelEditHint, { TextColor3 = Kit.C.dim, TextSize = 13, LayoutOrder = nextOrder(), Size = UDim2.new(1, 0, 0, 40) })
		if m and editor.selPart and m.model.parts[editor.selPart] then
			local part = m.model.parts[editor.selPart]
			Kit.textbox(list, part.name, L.Name, function(text)
				editor.state:apply({ op = "set", id = m.id, path = { "model", "parts", editor.selPart, "name" }, value = text })
			end, { LayoutOrder = nextOrder() })
			partProps(editor, list, m.id, { "model", "parts", editor.selPart }, part, nextOrder() * 100)
		else
			Kit.label(list, L.PickPart, { LayoutOrder = nextOrder() })
		end
		return nil
	end

	if obj and #editor.selection == 1 then
		if obj.kind == "model" then
			Kit.button(adds, L.EditModel, function()
				editor:enterModelEdit(obj.id)
			end)
			Kit.button(adds, L.SaveToMyModels, function()
				local r = Remotes.fn("Request"):InvokeServer("SaveLibraryModel", obj.id, obj.name)
				Kit.toast(editor.gui, if r and r.ok then H.SavedToLibraryHint else L.SaveFailed, if r and r.ok then Kit.C.good else Kit.C.bad)
			end)
			Kit.button(adds, L.Unglue, function()
				local op = Model.unglue(project, obj.id)
				if op then
					editor.state:apply(op)
				end
			end)
		end
	end

	if not obj then
		Kit.label(list, H.SelectHint, { TextColor3 = Kit.C.dim, LayoutOrder = nextOrder(), Size = UDim2.new(1, 0, 0, 40) })
		Kit.label(list, H.TouchHint, { TextColor3 = Kit.C.dim, TextSize = 13, LayoutOrder = nextOrder(), Size = UDim2.new(1, 0, 0, 40) })
		return nil
	end
	if #editor.selection &gt; 1 then
		Kit.label(list, H.GlueHint, { TextColor3 = Kit.C.dim, LayoutOrder = nextOrder(), Size = UDim2.new(1, 0, 0, 40) })
		return nil
	end

	section(list, L.Properties, nextOrder())
	Kit.textbox(list, obj.name, L.Name, function(text)
		editor.state:apply({ op = "set", id = obj.id, path = { "name" }, value = text })
	end, { LayoutOrder = nextOrder() })
	Kit.textbox(list, obj.latin or "", L.LatinName, function(text)
		if text == (obj.latin or "") then
			return
		end
		if not Ids.isValidLatin(text) then
			Kit.toast(editor.gui, H.LatinHint, Kit.C.bad)
			editor:renderPanel()
			return
		end
		if Logic.isReservedName(text) then
			Kit.toast(editor.gui, H.LatinTakenHint, Kit.C.bad)
			editor:renderPanel()
			return
		end
		local ok = editor.state:apply({ op = "set", id = obj.id, path = { "latin" }, value = text })
		if not ok then
			Kit.toast(editor.gui, H.LatinTakenHint, Kit.C.bad)
			editor:renderPanel()
		end
	end, { LayoutOrder = nextOrder() })

	nudgePad(editor, list, obj, nextOrder() * 10)
	order += 10

	if obj.kind == "part" then
		partProps(editor, list, obj.id, {}, obj, nextOrder() * 100)
		order = order * 100 + 20
	end

	Kit.toggle(list, L.Anchored, obj.physics.anchored, function(v)
		editor.state:apply({ op = "set", id = obj.id, path = { "physics", "anchored" }, value = v })
	end, nextOrder())
	Kit.toggle(list, L.CanCollide, obj.physics.canCollide, function(v)
		editor.state:apply({ op = "set", id = obj.id, path = { "physics", "canCollide" }, value = v })
	end, nextOrder())
	Kit.toggle(list, L.HiddenAtStart, obj.hidden == true, function(v)
		editor.state:apply({ op = "set", id = obj.id, path = { "hidden" }, value = v })
	end, nextOrder())

	-- назначение
	section(list, if obj.role then ROLE_TITLES[obj.role.type] or L.AssignAs else L.NoRole, nextOrder())
	Kit.button(list, L.AssignAs, function()
		Kit.choose(editor.gui, L.AssignAs, ASSIGN, function(roleType)
			editor:assignRole(roleType)
		end)
	end, { LayoutOrder = nextOrder() })
	if obj.role then
		Kit.button(list, L.ClearRole, function()
			editor:assignRole(nil)
		end, { LayoutOrder = nextOrder() })
		roleProps(editor, list, obj, nextOrder() * 100)
	end

	-- привязки, требующие внимания
	for _, b in Logic.brokenBindings(project) do
		if b.objectId == obj.id then
			Kit.label(list, H.BrokenBindingHint, { TextColor3 = Kit.C.bad, TextSize = 13, LayoutOrder = 99999999, Size = UDim2.new(1, 0, 0, 40) })
			break
		end
	end
	return nil
end

return MapPanel
</ProtectedString>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="RBX00000043">
              <Properties>
                <string name="Name">SettingsPanel</string>
                <ProtectedString name="Source">--!nonstrict
-- Вкладка «Камера»: камера от первого лица, полоска здоровья, название карты

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Workshop"):WaitForChild("Shared")
local UiText = require(Shared.UiText)
local Kit = require(script.Parent.Parent.Parent.UI.Kit)

local L, H = UiText.L, UiText.H

local SettingsPanel = {}

function SettingsPanel.render(editor, panel: Frame)
	local project = editor.state.project
	local cam = project.settings.camera
	local list = Kit.scroll(panel)
	Kit.list(list, 8)
	local function set(path, value)
		local ok, err = editor.state:apply({ op = "setProject", path = path, value = value })
		if not ok then
			Kit.toast(editor.gui, tostring(err), Kit.C.bad)
		end
	end
	Kit.textbox(list, project.meta.name, L.MapNamePlaceholder, function(text)
		if text ~= "" and text ~= project.meta.name then
			set({ "meta", "name" }, text)
		end
	end, { LayoutOrder = 1 })

	local modeRow = Kit.frame(list, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 52), LayoutOrder = 2 })
	local first = Kit.button(modeRow, L.CameraFirst, function()
		set({ "settings", "camera", "mode" }, "first")
		editor:renderPanel()
	end, { Size = UDim2.new(0.5, -3, 1, 0) })
	local default = Kit.button(modeRow, L.CameraDefault, function()
		set({ "settings", "camera", "mode" }, "default")
		editor:renderPanel()
	end, { Size = UDim2.new(0.5, -3, 1, 0), Position = UDim2.new(0.5, 3, 0, 0) })
	Kit.setActive(first, cam.mode == "first")
	Kit.setActive(default, cam.mode == "default")

	Kit.slider(list, L.Sensitivity, cam.sensitivity, 0.1, 3, function(v)
		set({ "settings", "camera", "sensitivity" }, math.max(v, 0.1))
	end, 3)
	Kit.slider(list, L.Fov, cam.fov, 50, 100, function(v)
		set({ "settings", "camera", "fov" }, math.floor(v + 0.5))
	end, 4)
	Kit.slider(list, L.Bob, cam.bob, 0, 2, function(v)
		set({ "settings", "camera", "bob" }, v)
	end, 5)
	Kit.label(list, H.BobHint, { TextColor3 = Kit.C.dim, TextSize = 13, LayoutOrder = 6 })
	Kit.toggle(list, L.HealthBar, project.settings.hud.health, function(v)
		set({ "settings", "hud", "health" }, v)
	end, 7)

	-- время суток и смена дня и ночи
	local lt = project.settings.lighting or {}
	Kit.slider(list, L.TimeOfDay, lt.clockTime or 14, 0, 24, function(v)
		set({ "settings", "lighting", "clockTime" }, math.floor(v * 4 + 0.5) / 4 % 24)
	end, 8)
	Kit.toggle(list, L.DayNight, lt.dayNight == true, function(v)
		set({ "settings", "lighting", "dayNight" }, v)
	end, 9)
	Kit.stepper(list, L.DayLength, lt.dayMinutes or 12, 1, 1, 240, function(v)
		set({ "settings", "lighting", "dayMinutes" }, v)
	end, 10)
	Kit.label(list, H.DayNightHint, { TextColor3 = Kit.C.dim, TextSize = 13, LayoutOrder = 11, Size = UDim2.new(1, 0, 0, 40) })

	-- погода
	local w = project.settings.weather or { type = "Clear", auto = false, minutes = 5 }
	local titles = { Clear = L.WeatherClear, Rain = L.WeatherRain, Snow = L.WeatherSnow, Fog = L.WeatherFog, Storm = L.WeatherStorm }
	local _, wSlot = Kit.row(list, L.Weather, 12)
	Kit.button(wSlot, titles[w.type] or L.WeatherClear, function()
		local opts = {}
		for _, id in { "Clear", "Rain", "Snow", "Fog", "Storm" } do
			table.insert(opts, { id = id, title = titles[id] })
		end
		Kit.choose(editor.gui, L.Weather, opts, function(id)
			set({ "settings", "weather" }, { type = id, auto = w.auto == true, minutes = w.minutes or 5 })
			editor:renderPanel()
		end)
	end)
	Kit.toggle(list, L.WeatherAuto, w.auto == true, function(v)
		set({ "settings", "weather" }, { type = w.type or "Clear", auto = v, minutes = w.minutes or 5 })
	end, 13)
	Kit.stepper(list, L.WeatherMinutes, w.minutes or 5, 1, 1, 120, function(v)
		set({ "settings", "weather" }, { type = w.type or "Clear", auto = w.auto == true, minutes = v })
	end, 14)

	-- музыка карты
	local m = project.settings.music
	Kit.textbox(list, if m then m.id else "", L.Music, function(text)
		local id = string.match(text, "(%d+)")
		if id then
			set({ "settings", "music" }, { id = id, volume = if m then m.volume else 0.5 })
		elseif text == "" then
			set({ "settings", "music" }, nil)
		end
		editor:renderPanel()
	end, { LayoutOrder = 15 })
	if m then
		Kit.slider(list, L.MusicVolume, m.volume, 0, 1, function(v)
			set({ "settings", "music", "volume" }, v)
		end, 16)
	end
	return nil
end

return SettingsPanel
</ProtectedString>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="RBX00000044">
              <Properties>
                <string name="Name">TextsPanel</string>
                <ProtectedString name="Source">--!nonstrict
-- Вкладка «Тексты»: надписи на табличках, дверях и над объектами, реплики NPC
-- и предпросмотр на маленьком экране

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Workshop"):WaitForChild("Shared")
local UiText = require(Shared.UiText)
local Catalog = require(Shared.Catalog)
local Util = require(Shared.Util)

local Kit = require(script.Parent.Parent.Parent.UI.Kit)
local Bubble = require(script.Parent.Parent.Parent.Play.Bubble)

local L = UiText.L

local TextsPanel = {}

local PHONE = Vector2.new(667, 375)
local FACES = { "Front", "Back", "Left", "Right", "Top", "Bottom" }

function TextsPanel.render(editor, panel: Frame)
	local project = editor.state.project
	local list = Kit.scroll(panel)
	Kit.list(list, 8)

	-- все тексты карты
	local items = {}
	for id, obj in project.map.objects do
		if obj.label then
			table.insert(items, { id = id, title = obj.name, hint = obj.label.text })
		elseif obj.role and obj.role.type == "npc" and #obj.role.lines &gt; 0 then
			table.insert(items, { id = id, title = obj.name, hint = obj.role.lines[1].text })
		end
	end
	table.sort(items, function(a, b)
		return a.title &lt; b.title
	end)
	for i, it in items do
		local hint = it.hint
		if utf8.len(hint) and (utf8.len(hint) :: number) &gt; 40 then
			hint = string.sub(hint, 1, (utf8.offset(hint, 40) :: number) - 1) .. "…"
		end
		Kit.button(list, it.title .. "\n" .. hint, function()
			editor:select({ it.id })
		end, { LayoutOrder = i, Size = UDim2.new(1, 0, 0, 52), TextXAlignment = Enum.TextXAlignment.Left, TextSize = 13 })
	end

	local id = editor.selection[1]
	local obj = id and project.map.objects[id]
	local base = 100
	local previewText: string? = nil
	local previewSize = 22
	local previewWrap = true
	if obj then
		Kit.titleBlock(list, obj.name, obj.latin, base)
		local label = obj.label
		local function set(path, value)
			local full = { "label" }
			for _, k in path do
				table.insert(full, k)
			end
			local ok, err = editor.state:apply({ op = "set", id = obj.id, path = full, value = value })
			if not ok then
				Kit.toast(editor.gui, tostring(err), Kit.C.bad)
			end
		end
		if not label then
			Kit.button(list, L.AddLabel, function()
				editor.state:apply({ op = "set", id = obj.id, path = { "label" }, value = {
					text = obj.name, mode = if obj.kind == "model" then "billboard" else "surface",
					face = "Front", size = 24, wrap = true, color = { 17, 17, 17 }, visible = true,
				} })
				editor:renderPanel()
			end, { LayoutOrder = base + 1 })
		else
			Kit.textbox(list, label.text, L.LabelText, function(text)
				set({ "text" }, text)
				editor:renderPanel()
			end, { MultiLine = true, TextWrapped = true, Size = UDim2.new(1, 0, 0, 80), TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = base + 2 })
			local modeRow = Kit.frame(list, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, Kit.TAP), LayoutOrder = base + 3 })
			local surf = Kit.button(modeRow, L.LabelOnSurface, function()
				set({ "mode" }, "surface")
				editor:renderPanel()
			end, { Size = UDim2.new(0.5, -3, 1, 0), TextSize = 13 })
			local above = Kit.button(modeRow, L.LabelAbove, function()
				set({ "mode" }, "billboard")
				editor:renderPanel()
			end, { Size = UDim2.new(0.5, -3, 1, 0), Position = UDim2.new(0.5, 3, 0, 0), TextSize = 13 })
			Kit.setActive(surf, label.mode == "surface")
			Kit.setActive(above, label.mode == "billboard")
			if label.mode == "surface" then
				local _, slot = Kit.row(list, L.Position, base + 4)
				Kit.button(slot, label.face or "Front", function()
					local opts = {}
					for _, f in FACES do
						table.insert(opts, { id = f, title = f })
					end
					Kit.choose(editor.gui, L.Position, opts, function(f)
						set({ "face" }, f)
						editor:renderPanel()
					end)
				end)
			end
			Kit.stepper(list, L.TextSize, label.size, 2, 6, 80, function(v)
				set({ "size" }, v)
			end, base + 5)
			Kit.toggle(list, L.Wrap, label.wrap, function(v)
				set({ "wrap" }, v)
			end, base + 6)
			local grid = Kit.frame(list, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = base + 7 })
			local g = Instance.new("UIGridLayout")
			g.CellSize = UDim2.fromOffset(40, 40)
			g.CellPadding = UDim2.fromOffset(6, 6)
			g.Parent = grid
			for _, c in Catalog.PALETTE do
				Kit.button(grid, "", function()
					set({ "color" }, c)
				end, { BackgroundColor3 = Color3.fromRGB(c[1], c[2], c[3]) })
			end
			Kit.button(grid, L.AnyColor, function()
				Kit.colorPicker(editor.gui, label.color, function(c)
					set({ "color" }, c)
					editor:renderPanel()
				end)
			end, { TextSize = 20 })
			Kit.button(list, L.RemoveLabel, function()
				editor.state:apply({ op = "set", id = obj.id, path = { "label" }, value = nil })
				editor:renderPanel()
			end, { LayoutOrder = base + 8, BackgroundColor3 = Kit.C.bad })
			previewText, previewSize, previewWrap = label.text, label.size, label.wrap
		end
		if obj.role and obj.role.type == "npc" and obj.role.lines[1] then
			-- самая длинная реплика — худший случай для маленького экрана
			local longest = obj.role.lines[1].text
			for _, line in obj.role.lines do
				if #line.text &gt; #longest then
					longest = line.text
				end
			end
			previewText, previewSize, previewWrap = longest, obj.role.textSize, true
		end
	end

	if previewText then
		Kit.label(list, L.PhonePreview, { Font = Kit.FONT_BOLD, LayoutOrder = base + 20, Size = UDim2.new(1, 0, 0, 44) })
		local holder = Kit.frame(list, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 200), LayoutOrder = base + 21 })
		local screen = Kit.frame(holder, { BackgroundColor3 = Color3.fromRGB(60, 70, 90), Size = UDim2.fromOffset(PHONE.X, PHONE.Y) })
		Kit.corner(screen, 18)
		local scale = Instance.new("UIScale")
		scale.Parent = screen
		local function fit()
			local w = math.max(holder.AbsoluteSize.X, 100)
			scale.Scale = w / PHONE.X
			holder.Size = UDim2.new(1, 0, 0, PHONE.Y * scale.Scale)
		end
		holder:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit)
		task.defer(fit)
		local b = Bubble.make(screen, previewText, Bubble.textSize(previewSize, PHONE), Bubble.maxWidth(PHONE), previewWrap)
		b.Position = UDim2.new(0.5, -b.Size.X.Offset / 2, 0.4, -b.Size.Y.Offset)
		if b.Size.Y.Offset &gt; PHONE.Y * 0.5 then
			b.BackgroundColor3 = Color3.fromRGB(255, 230, 200)
		end
		local _ = Util
	end
	return nil
end

return TextsPanel
</ProtectedString>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="RBX00000045">
            <Properties>
              <string name="Name">Picker</string>
              <ProtectedString name="Source">--!nonstrict
-- Выбор цели: касанием на карте или из списка. Показывает понятное название и
-- латинское имя; внутри хранится постоянный ID

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Workshop"):WaitForChild("Shared")
local UiText = require(Shared.UiText)
local Commands = require(Shared.Logic.Commands)
local Kit = require(script.Parent.Parent.UI.Kit)

local L, H = UiText.L, UiText.H

local Picker = {}

function Picker.display(project, id: string?): (string, boolean)
	if not id or id == "" then
		return L.NeedsRebind, false
	end
	local obj = project.map.objects[id]
	if not obj then
		return L.NeedsRebind, false
	end
	if obj.latin then
		return string.format(L.ObjectNameFormat, obj.name, obj.latin), true
	end
	return obj.name, true
end

local function accepts(argType: string?, obj): boolean
	if not argType then
		return true
	end
	local check = Commands.TARGET_TYPES[argType]
	return check == nil or check(obj)
end

function Picker.pick(editor, argType: string?, onPick: (string) -&gt; ())
	Kit.choose(editor.gui, L.PickOnMap, {
		{ id = "map", title = L.PickOnMap },
		{ id = "list", title = L.PickFromList },
	}, function(how)
		if how == "map" then
			editor:pickTarget(function(id)
				local obj = editor.state:obj(id)
				if obj and accepts(argType, obj) then
					onPick(id)
				else
					Kit.toast(editor.gui, H.WrongTargetHint, Kit.C.bad)
				end
			end)
		else
			local options = {}
			for id, obj in editor.state.project.map.objects do
				if accepts(argType, obj) then
					table.insert(options, { id = id, title = obj.name, hint = obj.latin })
				end
			end
			table.sort(options, function(a, b)
				return a.title &lt; b.title
			end)
			Kit.choose(editor.gui, L.PickFromList, options, onPick)
		end
	end)
end

-- Кнопка-поле со ссылкой на объект. Удалённая цель подсвечивается красным
function Picker.field(editor, parent: Instance, title: string, argType: string?, currentId: string?, onPick: (string?) -&gt; (), order: number?, optional: boolean?)
	local _, slot = Kit.row(parent, title, order)
	local text, ok = Picker.display(editor.state.project, currentId)
	if optional and (currentId == nil or currentId == "") then
		text, ok = L.None, true
	end
	local b = Kit.button(slot, text, function()
		Picker.pick(editor, argType, function(id)
			onPick(id)
		end)
	end, { TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left })
	Kit.pad(b, 6)
	if not ok then
		b.BackgroundColor3 = Kit.C.bad
	end
	slot.Parent.Size = UDim2.new(1, 0, 0, 52)
	return b
end

return Picker
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00000046">
            <Properties>
              <string name="Name">Preview</string>
              <ProtectedString name="Source">--!nonstrict
-- Локальный предпросмотр карты в редакторе (экземпляры видны только автору)

local Lighting = game:GetService("Lighting")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Workshop"):WaitForChild("Shared")
local WorldBuilder = require(Shared.Roblox.WorldBuilder)
local Convert = require(Shared.Roblox.Convert)

local Preview = {}
Preview.__index = Preview

Preview.ORIGIN = Vector3.new(0, 0, -6000)

function Preview.new(state)
	local self = setmetatable({}, Preview)
	self.state = state
	self.handles = {}
	self.folder = Instance.new("Folder")
	self.folder.Name = "WsEditor"
	self.folder.Parent = workspace
	self.highlights = {}
	self.savedLighting = { ClockTime = Lighting.ClockTime, Ambient = Lighting.Ambient, Brightness = Lighting.Brightness }
	Lighting.ClockTime = 14
	Lighting.Ambient = Color3.fromRGB(110, 110, 120)
	self:rebuildAll()
	self.unsub = {
		state.changed.connect(function(ids)
			for id in ids do
				self:rebuild(id)
			end
		end),
		state.resynced.connect(function()
			self:rebuildAll()
		end),
	}
	return self
end

function Preview:rebuild(id: string)
	local old = self.handles[id]
	if old then
		old.root:Destroy()
		self.handles[id] = nil
	end
	local obj = self.state:obj(id)
	if not obj then
		return
	end
	local h = WorldBuilder.build(obj, self.folder, Preview.ORIGIN, "edit")
	if obj.label then
		WorldBuilder.applyLabel(h, obj.label, obj.label.text)
	end
	self.handles[id] = h
	if self.onRebuilt then
		self.onRebuilt(id, h)
	end
end

function Preview:rebuildAll()
	for _, h in self.handles do
		h.root:Destroy()
	end
	self.handles = {}
	for id in self.state.project.map.objects do
		self:rebuild(id)
	end
	if self.onRebuiltAll then
		self.onRebuiltAll()
	end
end

-- Луч из точки экрана: объект и деталь модели под пальцем
function Preview:pick(screenPos: Vector2): (string?, string?, Vector3?)
	local cam = workspace.CurrentCamera
	local ray = cam:ViewportPointToRay(screenPos.X, screenPos.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { self.folder }
	local hit = workspace:Raycast(ray.Origin, ray.Direction * 2000, params)
	if not hit then
		return nil, nil, nil
	end
	local inst: Instance? = hit.Instance
	local partId = hit.Instance:GetAttribute("WsPart") :: string?
	while inst and inst:GetAttribute("WsId") == nil do
		inst = inst.Parent
	end
	if not inst then
		return nil, nil, hit.Position
	end
	return inst:GetAttribute("WsId") :: string, partId, hit.Position
end

-- Точка на полу перед камерой: туда ставятся новые объекты (в координатах проекта)
function Preview:placementPoint(grid: number): { number }
	local cam = workspace.CurrentCamera
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { self.folder }
	local hit = workspace:Raycast(cam.CFrame.Position, cam.CFrame.LookVector * 300, params)
	local p = if hit then hit.Position else cam.CFrame.Position + cam.CFrame.LookVector * 20
	local local3 = p - Preview.ORIGIN
	local function snap(v: number)
		if grid &lt;= 0 then
			return math.floor(v * 10 + 0.5) / 10
		end
		return math.floor(v / grid + 0.5) * grid
	end
	return { snap(local3.X), math.max(0, math.floor(local3.Y * 10 + 0.5) / 10), snap(local3.Z) }
end

function Preview:worldCF(pos, rot): CFrame
	return CFrame.new(Preview.ORIGIN) * Convert.cfFrom(pos, rot)
end

function Preview:toProject(cf: CFrame)
	return Convert.posRot(CFrame.new(-Preview.ORIGIN) * cf)
end

function Preview:setHighlight(ids: { string }, color: Color3?)
	for _, h in self.highlights do
		h:Destroy()
	end
	self.highlights = {}
	for _, id in ids do
		local handle = self.handles[id]
		if handle then
			local hl = Instance.new("Highlight")
			hl.FillTransparency = 0.85
			hl.OutlineColor = color or Color3.fromRGB(88, 140, 255)
			hl.FillColor = color or Color3.fromRGB(88, 140, 255)
			hl.Adornee = handle.root
			hl.Parent = self.folder
			table.insert(self.highlights, hl)
		end
	end
end

function Preview:destroy()
	for _, u in self.unsub do
		u()
	end
	self.folder:Destroy()
	for k, v in self.savedLighting do
		(Lighting :: any)[k] = v
	end
end

return Preview
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00000047">
            <Properties>
              <string name="Name">State</string>
              <ProtectedString name="Source">--!nonstrict
-- Состояние редактора на клиенте: локальная копия проекта, отмена и повтор,
-- отправка правок на сервер и обработка отказов

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Workshop"):WaitForChild("Shared")
local Ops = require(Shared.Ops)
local Remotes = require(Shared.Roblox.Remotes)

local State = {}
State.__index = State

local function signal()
	local handlers = {}
	return {
		connect = function(fn)
			table.insert(handlers, fn)
			return function()
				local i = table.find(handlers, fn)
				if i then
					table.remove(handlers, i)
				end
			end
		end,
		fire = function(...)
			for _, fn in table.clone(handlers) do
				task.spawn(fn, ...)
			end
		end,
	}
end
State.signal = signal

-- ID объектов, которых касается операция
function State.touchedIds(op, out)
	out = out or {}
	if op.op == "batch" then
		for _, o in op.ops do
			State.touchedIds(o, out)
		end
	elseif op.op == "add" then
		out[op.obj.id] = true
	elseif op.op == "remove" or op.op == "set" then
		out[op.id] = true
	end
	return out
end

function State.new(project, readOnly: boolean)
	local self = setmetatable({}, State)
	self.project = project
	self.readOnly = readOnly
	self.history = Ops.newHistory(150)
	self.seq = 0
	self.changed = signal() -- (ids, op)
	self.resynced = signal()
	self.status = signal() -- (state)
	self.rejected = signal() -- (reason)
	self.connections = {}
	table.insert(self.connections, Remotes.event("EditAck").OnClientEvent:Connect(function(seq, ok, reason, serverProject)
		if ok then
			return
		end
		self.rejected.fire(reason)
		if serverProject then
			-- сервер не принял правку: берём его копию, историю сбрасываем
			self.project = serverProject
			self.history = Ops.newHistory(150)
			if reason == "readonly" then
				self.readOnly = true
			end
			self.resynced.fire()
		end
	end))
	table.insert(self.connections, Remotes.event("SaveStatus").OnClientEvent:Connect(function(state)
		if state == "readonly" then
			self.readOnly = true
		elseif state == "saved" then
			self.readOnly = false
		end
		self.status.fire(state)
	end))
	return self
end

function State:destroy()
	for _, c in self.connections do
		c:Disconnect()
	end
end

-- Применяет правку локально и отправляет на сервер
function State:apply(op, record: boolean?): (boolean, any)
	if self.readOnly then
		return false, "readonly"
	end
	local ok, inv = Ops.apply(self.project, op, { validate = true })
	if not ok then
		return false, inv
	end
	if record ~= false then
		Ops.record(self.history, inv, op)
	end
	self.seq += 1
	Remotes.event("EditOps"):FireServer(self.seq, op)
	self.changed.fire(State.touchedIds(op), op)
	return true, inv
end

function State:undo(): boolean
	local op = Ops.popUndo(self.history)
	if not op then
		return false
	end
	local ok = self:apply(op, false)
	return ok
end

function State:redo(): boolean
	local op = Ops.popRedo(self.history)
	if not op then
		return false
	end
	local ok = self:apply(op, false)
	return ok
end

function State:obj(id: string)
	return self.project.map.objects[id]
end

return State
</ProtectedString>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="RBX00000048">
          <Properties>
            <string name="Name">Mafia</string>
          </Properties>
          <Item class="ModuleScript" referent="RBX00000049">
            <Properties>
              <string name="Name">MafiaClient</string>
              <ProtectedString name="Source">--!nonstrict
-- Клиент «Мафии»: лобби с выбором стиля, своя роль, таймер фаз, голосования,
-- ночные действия, блокнот шерифа, переключатель чатов, панель ведущего, вид призрака

local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TextChatService = game:GetService("TextChatService")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Workshop"):WaitForChild("Shared")
local UiText = require(Shared.UiText)
local Remotes = require(Shared.Roblox.Remotes)
local MafiaSounds = require(Shared.MafiaSounds)

local Kit = require(script.Parent.Parent.UI.Kit)
local FreeCamera = require(script.Parent.Parent.Editor.FreeCamera)
local WeatherFx = require(script.Parent.Parent.Play.WeatherFx)

local L, H = UiText.L, UiText.H

local MafiaClient = {}
MafiaClient.__index = MafiaClient

local player = Players.LocalPlayer

local PHASE_TITLE = {
	lobby = L.PhaseLobby, reveal = L.PhaseReveal, dusk = L.PhaseDusk, night = L.PhaseNight,
	morning = L.PhaseMorning, day = L.PhaseDay, vote = L.PhaseVote, verdict = L.PhaseVerdict, ended = L.PhaseEnded,
}
local ROLE_TITLE = { mafia = L.RoleMafia, doctor = L.RoleDoctor, sheriff = L.RoleSheriff, civilian = L.RoleCivilian }
local ROLE_HINT = { mafia = H.MafiaRoleHint, doctor = H.DoctorRoleHint, sheriff = H.SheriffRoleHint, civilian = H.CivilianRoleHint }
local ROLE_COLOR = {
	mafia = Color3.fromRGB(170, 40, 50), doctor = Color3.fromRGB(60, 160, 110),
	sheriff = Color3.fromRGB(70, 110, 200), civilian = Color3.fromRGB(110, 110, 120),
}
local CLOCK = { lobby = 14, reveal = 19, dusk = 19.5, night = 0, morning = 6.5, day = 13, vote = 16, verdict = 17.5, ended = 14 }

local function request(...)
	local ok, res = pcall(function(...)
		return Remotes.fn("MafiaRequest"):InvokeServer(...)
	end, ...)
	return if ok then res else nil
end

function MafiaClient.new(app)
	local self = setmetatable({}, MafiaClient)
	self.app = app
	self.state = {}
	self.notes = ""
	local gui = Instance.new("ScreenGui")
	gui.Name = "WsMafia"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = app.playerGui
	self.gui = gui
	self.weather = WeatherFx.new()

	-- фаза и таймер: название и время двумя строками
	self.phaseBox = Kit.frame(gui, { Size = UDim2.fromOffset(170, 52), Position = UDim2.new(0.5, -85, 0, 6), BackgroundTransparency = 0.25, BackgroundColor3 = Kit.C.bg })
	Kit.corner(self.phaseBox, 12)
	self.phaseLabel = Kit.label(self.phaseBox, "", { Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, Font = Kit.FONT_BOLD, TextSize = 16 })
	-- своя роль
	self.roleChip = Kit.button(gui, "", function()
		self:showRoleCard()
	end, { Size = UDim2.fromOffset(150, 40), Position = UDim2.new(0.5, -75, 0, 62), TextSize = 14, Visible = false })
	-- крупное объявление
	self.banner = Kit.label(gui, "", {
		Size = UDim2.new(0.8, 0, 0, 90), Position = UDim2.new(0.1, 0, 0.22, 0), TextXAlignment = Enum.TextXAlignment.Center,
		Font = Kit.FONT_BOLD, TextSize = 28, TextStrokeTransparency = 0.3, Visible = false,
	})
	-- переключатель чатов слева
	self.chatBar = Kit.frame(gui, { BackgroundTransparency = 1, Size = UDim2.fromOffset(110, 3 * (Kit.TAP + 4)), Position = UDim2.new(0, 6, 0.42, 0) })
	Kit.list(self.chatBar, 4)
	self.chatButtons = {}
	for i, ch in { { "general", L.ChatTown, "MafiaTown" }, { "mafia", L.ChatMafia, "MafiaRoom" }, { "ghost", L.ChatGhost, "GhostRoom" } } do
		self.chatButtons[ch[1]] = Kit.button(self.chatBar, ch[2], function()
			self:setChannel(ch[3], ch[1])
		end, { Size = UDim2.new(1, 0, 0, Kit.TAP), LayoutOrder = i, TextSize = 13, Visible = false, BackgroundTransparency = 0.2 })
	end
	-- нижняя панель: лобби, голосование, ночные действия
	self.sheet = Kit.frame(gui, { Size = UDim2.new(0, math.min(520, Kit.viewport().X - 24), 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Position = UDim2.new(0.5, 0, 1, -8), AnchorPoint = Vector2.new(0.5, 1), BackgroundTransparency = 0.08 })
	Kit.corner(self.sheet, 14)
	Kit.pad(self.sheet, 10)
	-- кнопки справа: блокнот шерифа и панель ведущего
	self.side = Kit.frame(gui, { BackgroundTransparency = 1, Size = UDim2.fromOffset(120, 2 * (Kit.TAP + 4)), Position = UDim2.new(1, -126, 0.42, 0) })
	Kit.list(self.side, 4)
	self.noteButton = Kit.button(self.side, L.Notebook, function()
		self:openNotebook()
	end, { Size = UDim2.new(1, 0, 0, Kit.TAP), LayoutOrder = 1, Visible = false, TextSize = 13 })
	self.hostButton = Kit.button(self.side, L.HostPanel, function()
		self:openHostPanel()
	end, { Size = UDim2.new(1, 0, 0, Kit.TAP), LayoutOrder = 2, Visible = false, TextSize = 13, BackgroundColor3 = Kit.C.accentDim })

	self.conn = Remotes.event("Mafia").OnClientEvent:Connect(function(msg)
		self:onMessage(msg)
	end)
	self.tick = RunService.Heartbeat:Connect(function()
		self:updateTimer()
	end)
	return self
end

-- ---------------------------------------------------------------------------

function MafiaClient:sound(key: string?)
	local id = key and MafiaSounds[key]
	if not id or id == "" then
		return
	end
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = 0.6
	s.Parent = SoundService
	s.Ended:Once(function()
		s:Destroy()
	end)
	s:Play()
	task.delay(15, function()
		if s.Parent then
			s:Destroy()
		end
	end)
end

function MafiaClient:announce(text: string)
	self.banner.Text = text
	self.banner.Visible = true
	local token = {}
	self.bannerToken = token
	task.delay(4, function()
		if self.bannerToken == token then
			self.banner.Visible = false
		end
	end)
	-- то же сообщение в чате как системное
	local tc = TextChatService:FindFirstChild("TextChannels")
	local town = tc and tc:FindFirstChild("MafiaTown")
	if town then
		pcall(function()
			(town :: TextChannel):DisplaySystemMessage((string.gsub(text, "\n", " ")))
		end)
	end
end

function MafiaClient:updateTimer()
	local st = self.state
	local title = PHASE_TITLE[st.phase or "lobby"] or ""
	if st.phase and st.phase ~= "lobby" and st.endsAt then
		local left = math.max(0, math.floor(st.endsAt - workspace:GetServerTimeNow()))
		self.phaseLabel.Text = string.format("%s\n%d:%02d", title, left // 60, left % 60)
	else
		self.phaseLabel.Text = title
	end
end

function MafiaClient:setChannel(name: string, key: string)
	local tc = TextChatService:FindFirstChild("TextChannels")
	local c = tc and tc:FindFirstChild(name)
	if c then
		pcall(function()
			TextChatService.ChatInputBarConfiguration.TargetTextChannel = c
		end)
	end
	self.channel = key
	for k, b in self.chatButtons do
		Kit.setActive(b, k == key)
	end
end

function MafiaClient:applyChat()
	local chat = self.state.chat or {}
	local firstSend = nil
	for key, b in self.chatButtons do
		local rights = chat[key]
		b.Visible = rights ~= nil and rights.see == true
		if rights and rights.send and not firstSend then
			firstSend = key
		end
	end
	pcall(function()
		TextChatService.ChannelTabsConfiguration.Enabled = true
	end)
	local cur = self.channel and chat[self.channel]
	if not cur or not cur.send then
		local key = firstSend or "general"
		local names = { general = "MafiaTown", mafia = "MafiaRoom", ghost = "GhostRoom" }
		self:setChannel(names[key], key)
	end
end

-- ---------------------------------------------------------------------------
-- мир: время суток, окна, погода, крыши для призраков

function MafiaClient:applyWorld()
	local st = self.state
	local clock = CLOCK[st.phase or "lobby"] or 14
	TweenService:Create(Lighting, TweenInfo.new(3), { ClockTime = clock }):Play()
	local village = workspace:FindFirstChild("MafiaVillage")
	local night = clock &lt; 6 or clock &gt; 18.5
	if village then
		for _, d in village:GetDescendants() do
			if d:IsA("BasePart") and d:GetAttribute("NightGlow") then
				d.Material = if night then Enum.Material.Neon else Enum.Material.Glass
			end
		end
	end
	local ghost = st.role ~= nil and st.alive == false or (st.alive == false and st.phase ~= "lobby")
	-- призракам крыши прозрачны, чтобы видеть всё сверху
	if village then
		for _, d in village:GetDescendants() do
			if d:IsA("BasePart") and d:GetAttribute("Roof") then
				d.LocalTransparencyModifier = if ghost then 0.85 else 0
			end
		end
	end
	if ghost and not self.ghostCam and self.world then
		self.ghostCam = FreeCamera.new(self.world.center + Vector3.new(0, 4, 0))
		self.ghostCam.dist = 150
		self.ghostCam.pitch = math.rad(-62)
	elseif not ghost and self.ghostCam then
		self.ghostCam:destroy()
		self.ghostCam = nil
		workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
	end
	if self.world then
		self.weather:set({ weather = self.world.weather or "Clear", at = 0, auto = false, minutes = 5 })
		-- фоновый звук сезона, если указан в MafiaSounds
		local style = self.world.style or "spring"
		local id = MafiaSounds["ambient" .. string.upper(string.sub(style, 1, 1)) .. string.sub(style, 2)]
		if self.ambientStyle ~= style then
			self.ambientStyle = style
			if self.ambient then
				self.ambient:Destroy()
				self.ambient = nil
			end
			if id and id ~= "" then
				local s = Instance.new("Sound")
				s.SoundId = id
				s.Looped = true
				s.Volume = 0.35
				s.Parent = SoundService
				s:Play()
				self.ambient = s
			end
		end
	end
end

-- ---------------------------------------------------------------------------
-- сообщения сервера

function MafiaClient:onMessage(msg)
	local t = msg.type
	if t == "state" then
		local prevRole = self.state.role
		self.state = msg
		self.roleChip.Visible = msg.role ~= nil or msg.youHost
		if msg.youHost then
			self.roleChip.Text = L.RoleHost
			self.roleChip.BackgroundColor3 = Kit.C.accentDim
		elseif msg.role then
			self.roleChip.Text = if msg.alive then ROLE_TITLE[msg.role] else L.RoleGhost
			self.roleChip.BackgroundColor3 = if msg.alive then ROLE_COLOR[msg.role] else Kit.C.panel2
		end
		self.noteButton.Visible = msg.role == "sheriff"
		self.hostButton.Visible = msg.youHost == true or (msg.hostId == nil and msg.creator == true and msg.phase ~= "lobby")
		if not self.hostButton.Visible and self.hostPanel then
			self.hostPanel:Destroy()
			self.hostPanel = nil
		end
		if msg.role and msg.role ~= prevRole then
			self:showRoleCard()
		end
		self:applyChat()
		self:applyWorld()
		self:renderSheet()
		if self.hostPanel then
			self:openHostPanel(true)
		end
	elseif t == "phase" then
		self.state.phase = msg.phase
		self.state.endsAt = msg.endsAt
		if msg.world then
			self.world = msg.world
		end
		if msg.phase == "night" then
			self:announce(H.NightSilenceHint)
		end
		self:applyWorld()
		self:renderSheet()
	elseif t == "announce" then
		self:announce(msg.text)
		self:sound(msg.sound)
	elseif t == "sound" then
		self:sound(msg.sound)
	elseif t == "ghost" then
		self:announce(H.GhostHint)
	elseif t == "joined" then
		self:sound("join")
	end
end

-- ---------------------------------------------------------------------------
-- карточка роли

function MafiaClient:showRoleCard()
	local st = self.state
	if self.card then
		self.card:Destroy()
	end
	local role = st.role
	local title = if st.youHost then L.RoleHost elseif role then ROLE_TITLE[role] else nil
	if not title then
		return
	end
	local hint = if st.youHost then H.HostRoleHint else ROLE_HINT[role]
	local w = math.min(360, Kit.viewport().X - 32)
	local card = Kit.frame(self.gui, { Size = UDim2.fromOffset(w, 0), AutomaticSize = Enum.AutomaticSize.Y, Position = UDim2.new(0.5, -w / 2, 0.2, 0), BackgroundColor3 = if role then ROLE_COLOR[role] else Kit.C.accentDim, ZIndex = 40 })
	Kit.corner(card, 16)
	Kit.pad(card, 16)
	Kit.list(card, 8)
	Kit.label(card, title, { Font = Kit.FONT_BOLD, TextSize = 30, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 40), ZIndex = 41, LayoutOrder = 1 })
	Kit.label(card, hint or "", { TextSize = 16, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, ZIndex = 41, LayoutOrder = 2 })
	if st.house then
		Kit.label(card, string.format(L.YourHouse, st.house), { TextSize = 15, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 41, LayoutOrder = 3 })
	end
	if role == "mafia" and st.mafiaTeam then
		local names = {}
		for _, p in st.players or {} do
			if table.find(st.mafiaTeam, p.userId) and p.userId ~= player.UserId then
				table.insert(names, p.name)
			end
		end
		if #names &gt; 0 then
			Kit.label(card, table.concat(names, ", "), { TextSize = 15, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 41, LayoutOrder = 4 })
		end
	end
	Kit.button(card, L.GotIt, function()
		card:Destroy()
		self.card = nil
	end, { ZIndex = 42, LayoutOrder = 10, BackgroundColor3 = Kit.C.bg })
	self.card = card
end

-- ---------------------------------------------------------------------------
-- нижняя панель по фазе

local function clear(f: Instance)
	for _, c in f:GetChildren() do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
end

function MafiaClient:playerGrid(order: number, filter, onPick, marked, labelOf)
	local grid = Kit.frame(self.sheet, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order })
	local g = Instance.new("UIGridLayout")
	g.CellSize = UDim2.new(0.5, -4, 0, Kit.TAP)
	g.CellPadding = UDim2.fromOffset(6, 6)
	g.SortOrder = Enum.SortOrder.LayoutOrder
	g.Parent = grid
	for i, p in self.state.players or {} do
		if filter(p) then
			local b = Kit.button(grid, if labelOf then labelOf(p) else p.name, function()
				self:sound("click")
				onPick(p)
			end, { LayoutOrder = i, TextSize = 14 })
			if marked and marked(p) then
				Kit.setActive(b, true)
			end
		end
	end
	return grid
end

function MafiaClient:renderSheet()
	local st = self.state
	clear(self.sheet)
	Kit.list(self.sheet, 8)
	local phase = st.phase
	self.sheet.Visible = true
	if phase == "lobby" then
		self:renderLobby()
		return
	end
	local me = nil
	for _, p in st.players or {} do
		if p.userId == player.UserId then
			me = p
		end
	end
	if phase == "ended" then
		Kit.label(self.sheet, L.AllRoles, { Font = Kit.FONT_BOLD, LayoutOrder = 1 })
		for i, p in st.players or {} do
			Kit.label(self.sheet, p.name .. "   " .. (ROLE_TITLE[p.role] or ""), { TextSize = 14, LayoutOrder = 1 + i, TextColor3 = ROLE_COLOR[p.role] or Kit.C.text })
		end
		return
	end
	if not st.alive or not st.role then
		self.sheet.Visible = false
		return
	end
	if phase == "vote" then
		Kit.label(self.sheet, L.ChooseExile, { Font = Kit.FONT_BOLD, LayoutOrder = 1 })
		local tally = st.tally or {}
		self:playerGrid(2, function(p)
			return p.alive
		end, function(p)
			request("Vote", p.userId)
		end, function(p)
			return st.vote == p.userId
		end, function(p)
			local n = tally[tostring(p.userId)]
			return if n then p.name .. "   " .. tostring(n) else p.name
		end)
		local skip = Kit.button(self.sheet, L.VoteSkip .. (if tally.skip then "   " .. tally.skip else ""), function()
			request("Vote", "skip")
		end, { LayoutOrder = 3 })
		Kit.setActive(skip, st.vote == "skip")
	elseif phase == "night" then
		local role = st.role
		if role == "mafia" then
			Kit.label(self.sheet, L.ChooseVictim, { Font = Kit.FONT_BOLD, LayoutOrder = 1 })
			local myPick = st.mafiaVotes and st.mafiaVotes[tostring(player.UserId)]
			self:playerGrid(2, function(p)
				return p.alive and not table.find(st.mafiaTeam or {}, p.userId)
			end, function(p)
				request("Night", p.userId)
			end, function(p)
				return myPick == p.userId
			end)
			-- выбор остальных мафиози, чтобы договориться
			local byId = {}
			for _, p in st.players do
				byId[tostring(p.userId)] = p.name
			end
			local order = 3
			for voter, target in st.mafiaVotes or {} do
				order += 1
				Kit.label(self.sheet, string.format(L.MafiaVotesFormat, byId[voter] or "?", byId[tostring(target)] or "?"), { TextSize = 13, TextColor3 = Kit.C.dim, LayoutOrder = order })
			end
		elseif role == "doctor" then
			Kit.label(self.sheet, L.ChooseHeal, { Font = Kit.FONT_BOLD, LayoutOrder = 1 })
			self:playerGrid(2, function(p)
				return p.alive and p.userId ~= st.lastHeal
			end, function(p)
				request("Night", p.userId)
			end, function(p)
				return st.heal == p.userId
			end)
		elseif role == "sheriff" then
			Kit.label(self.sheet, L.ChooseCheck, { Font = Kit.FONT_BOLD, LayoutOrder = 1 })
			local checked = false
			for _, c in st.checks or {} do
				if c.round == st.round then
					checked = true
					Kit.label(self.sheet, string.format(if c.mafia then L.IsMafia else L.NotMafia, c.name), { Font = Kit.FONT_BOLD, TextSize = 18, LayoutOrder = 3, Size = UDim2.new(1, 0, 0, 48), TextColor3 = if c.mafia then Kit.C.bad else Kit.C.good })
				end
			end
			if not checked then
				self:playerGrid(2, function(p)
					return p.alive and p.userId ~= player.UserId
				end, function(p)
					request("Night", p.userId)
				end)
			end
		else
			self.sheet.Visible = false
		end
	else
		self.sheet.Visible = false
	end
	local _ = me
end

function MafiaClient:renderLobby()
	local st = self.state
	local s = st.settings or {}
	local n = #(st.players or {})
	local order = 0
	local function o()
		order += 1
		return order
	end
	Kit.label(self.sheet, string.format(L.PlayersFormat, n), { Font = Kit.FONT_BOLD, LayoutOrder = o() })
	local hostName = nil
	for _, p in Players:GetPlayers() do
		if p.UserId == st.hostId then
			hostName = p.DisplayName
		end
	end
	Kit.label(self.sheet, if hostName then string.format(L.HostFormat, hostName) else L.NoHost, { TextSize = 14, TextColor3 = Kit.C.dim, LayoutOrder = o(), Size = UDim2.new(1, 0, 0, 40) })
	Kit.button(self.sheet, if st.youHost then L.StopHosting else L.BecomeHost, function()
		request("BecomeHost", not st.youHost)
	end, { LayoutOrder = o(), Visible = st.youHost or st.hostId == nil or st.creator })
	if st.canStart then
		-- стиль деревни
		local row = Kit.frame(self.sheet, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, Kit.TAP), LayoutOrder = o() })
		Kit.list(row, 4, true)
		for i, sty in { { "summer", L.StyleSummer }, { "spring", L.StyleSpring }, { "autumn", L.StyleAutumn }, { "winter", L.StyleWinter } } do
			local b = Kit.button(row, sty[2], function()
				request("Settings", { style = sty[1], theme = "plain", auto = s.auto, counts = s.counts })
			end, { Size = UDim2.new(0.25, -3, 1, 0), LayoutOrder = i, TextSize = 14 })
			Kit.setActive(b, s.style == sty[1])
		end
		local themes = ({
			summer = {},
			spring = { { "april", L.ThemeApril } },
			autumn = { { "halloween", L.ThemeHalloween } },
			winter = { { "newyear", L.ThemeNewYear } },
		})[s.style or "spring"] or {}
		if #themes &gt; 0 then
			local trow = Kit.frame(self.sheet, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, Kit.TAP), LayoutOrder = o() })
			Kit.list(trow, 4, true)
			local plain = Kit.button(trow, L.ThemePlain, function()
				request("Settings", { style = s.style, theme = "plain", auto = s.auto, counts = s.counts })
			end, { Size = UDim2.new(0.5, -2, 1, 0), LayoutOrder = 1, TextSize = 14 })
			Kit.setActive(plain, s.theme == "plain")
			for i, th in themes do
				local b = Kit.button(trow, th[2], function()
					request("Settings", { style = s.style, theme = th[1], auto = s.auto, counts = s.counts })
				end, { Size = UDim2.new(0.5, -2, 1, 0), LayoutOrder = 1 + i, TextSize = 14 })
				Kit.setActive(b, s.theme == th[1])
			end
		end
		-- роли: сами или вручную
		local rrow = Kit.frame(self.sheet, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, Kit.TAP), LayoutOrder = o() })
		Kit.list(rrow, 4, true)
		local auto = Kit.button(rrow, L.RolesAuto, function()
			request("Settings", { style = s.style, theme = s.theme, auto = true, counts = s.counts })
		end, { Size = UDim2.new(0.5, -2, 1, 0), LayoutOrder = 1, TextSize = 14 })
		local manual = Kit.button(rrow, L.RolesManual, function()
			request("Settings", { style = s.style, theme = s.theme, auto = false, counts = s.counts })
		end, { Size = UDim2.new(0.5, -2, 1, 0), LayoutOrder = 2, TextSize = 14 })
		Kit.setActive(auto, s.auto ~= false)
		Kit.setActive(manual, s.auto == false)
		if s.auto == false then
			for _, k in { { "mafia", L.CountMafia, 1, 6 }, { "doctor", L.CountDoctor, 1, 3 }, { "sheriff", L.CountSheriff, 1, 3 } } do
				Kit.stepper(self.sheet, k[2], (s.counts or {})[k[1]] or k[3], 1, k[3], k[4], function(v)
					local c = table.clone(s.counts or {})
					c[k[1]] = v
					request("Settings", { style = s.style, theme = s.theme, auto = false, counts = c })
				end, o())
			end
		end
		Kit.button(self.sheet, L.StartGame, function()
			local res = request("Start")
			if res and not res.ok then
				Kit.toast(self.gui, if res.error == "few" then H.FewPlayersHint else tostring(res.error), Kit.C.bad)
			end
		end, { LayoutOrder = o(), BackgroundColor3 = Kit.C.accent, Font = Kit.FONT_BOLD })
	end
	if not (self.app.mode and self.app.mode.showcase and self.app.mode.showcase.code == "MAFIA" and not self.app.mode.creator) then
		Kit.button(self.sheet, L.LeaveMafia, function()
			request("Leave")
			self.app:leaveMafia()
		end, { LayoutOrder = o(), BackgroundColor3 = Kit.C.panel2 })
	end
end

-- ---------------------------------------------------------------------------
-- блокнот шерифа: только у себя на устройстве

function MafiaClient:openNotebook()
	if self.notebook then
		self.notebook:Destroy()
		self.notebook = nil
		return
	end
	local w = math.min(380, Kit.viewport().X - 24)
	local box = Kit.frame(self.gui, { Size = UDim2.fromOffset(w, 320), Position = UDim2.new(0.5, -w / 2, 0.15, 0), ZIndex = 30 })
	Kit.corner(box, 12)
	Kit.pad(box, 10)
	Kit.label(box, L.Notebook, { Font = Kit.FONT_BOLD, ZIndex = 31, Size = UDim2.new(1, -50, 0, 28) })
	Kit.button(box, "✕", function()
		box:Destroy()
		self.notebook = nil
	end, { Size = UDim2.fromOffset(40, 32), Position = UDim2.new(1, -40, 0, -2), ZIndex = 31 })
	local history = {}
	for _, c in self.state.checks or {} do
		table.insert(history, (string.gsub(string.format(if c.mafia then L.IsMafia else L.NotMafia, c.name), "\n", " — ")))
	end
	local t = Kit.textbox(box, self.notes, "…", function(text)
		self.notes = text
	end, { MultiLine = true, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, Position = UDim2.fromOffset(0, 34), Size = UDim2.new(1, 0, 1, -34 - (#history &gt; 0 and 60 or 0)), ZIndex = 31 })
	t:GetPropertyChangedSignal("Text"):Connect(function()
		self.notes = t.Text
	end)
	if #history &gt; 0 then
		Kit.label(box, table.concat(history, "\n"), { Position = UDim2.new(0, 0, 1, -56), Size = UDim2.new(1, 0, 0, 56), TextSize = 13, ZIndex = 31, TextColor3 = Kit.C.dim })
	end
	self.notebook = box
end

-- ---------------------------------------------------------------------------
-- панель ведущего

function MafiaClient:openHostPanel(refresh: boolean?)
	if self.hostPanel then
		self.hostPanel:Destroy()
		self.hostPanel = nil
		if not refresh then
			return
		end
	elseif refresh then
		return
	end
	local st = self.state
	local w = math.min(420, Kit.viewport().X - 24)
	local box = Kit.frame(self.gui, { Size = UDim2.fromOffset(w, math.min(460, Kit.viewport().Y - 140)), Position = UDim2.new(1, -w - 12, 0, 110), ZIndex = 30 })
	Kit.corner(box, 12)
	Kit.pad(box, 10)
	Kit.label(box, L.HostPanel, { Font = Kit.FONT_BOLD, ZIndex = 31, Size = UDim2.new(1, -50, 0, 28) })
	Kit.button(box, "✕", function()
		box:Destroy()
		self.hostPanel = nil
	end, { Size = UDim2.fromOffset(40, 32), Position = UDim2.new(1, -40, 0, -2), ZIndex = 31 })
	local list = Kit.scroll(box, { Position = UDim2.fromOffset(0, 34), Size = UDim2.new(1, 0, 1, -34), ZIndex = 31 })
	Kit.list(list, 6)
	local row = Kit.frame(list, { BackgroundTransparency = 1, Size = UDim2.new(1, -6, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, ZIndex = 31 })
	local g = Instance.new("UIGridLayout")
	g.CellSize = UDim2.new(0.5, -4, 0, Kit.TAP)
	g.CellPadding = UDim2.fromOffset(6, 6)
	g.Parent = row
	for _, a in { { "next", L.HostNext }, { "more", L.HostMore }, { "home", L.HostHome }, { "table", L.HostTable } } do
		Kit.button(row, a[2], function()
			request("Host", a[1])
		end, { ZIndex = 32, TextSize = 14 })
	end
	local roles = st.allRoles or {}
	for i, p in st.players or {} do
		local card = Kit.frame(list, { BackgroundColor3 = Kit.C.panel2, Size = UDim2.new(1, -6, 0, Kit.TAP * 2 + 14), LayoutOrder = 10 + i, ZIndex = 31 })
		Kit.corner(card, 8)
		Kit.pad(card, 4)
		local role = roles[tostring(p.userId)]
		Kit.label(card, p.name .. "   " .. (if role then ROLE_TITLE[role] else "") .. (if p.alive then "" else "   " .. L.RoleGhost), { Size = UDim2.new(1, 0, 0, Kit.TAP), ZIndex = 32, TextSize = 14, TextColor3 = if role then ROLE_COLOR[role]:Lerp(Color3.new(1, 1, 1), 0.35) else Kit.C.text })
		local br = Kit.frame(card, { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, Kit.TAP + 4), Size = UDim2.new(1, 0, 0, Kit.TAP), ZIndex = 32 })
		Kit.list(br, 4, true)
		for j, a in { { "toss", L.HostToss }, { "bring", L.HostBring }, { "sendHome", L.HostSendHome } } do
			Kit.button(br, a[2], function()
				request("Host", a[1], p.userId)
			end, { Size = UDim2.new(1 / 3, -3, 1, 0), LayoutOrder = j, ZIndex = 33, TextSize = 13 })
		end
	end
	self.hostPanel = box
end

function MafiaClient:destroy()
	self.conn:Disconnect()
	self.tick:Disconnect()
	self.weather:destroy()
	if self.ambient then
		self.ambient:Destroy()
	end
	if self.ghostCam then
		self.ghostCam:destroy()
	end
	workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
	self.gui:Destroy()
	pcall(function()
		TextChatService.ChatInputBarConfiguration.TargetTextChannel = nil
	end)
end

return MafiaClient
</ProtectedString>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="RBX0000004A">
          <Properties>
            <string name="Name">Main</string>
            <ProtectedString name="Source">--!nonstrict
-- Точка входа клиента мастерской: меню, редактор и игра

local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Workshop"):WaitForChild("Shared")
local Remotes = require(Shared.Roblox.Remotes)
local UiText = require(Shared.UiText)

local Kit = require(script.Parent.UI.Kit)
local Menu = require(script.Parent.UI.Menu)
local AdminButton = require(script.Parent.UI.AdminButton)
local Editor = require(script.Parent.Editor.Editor)
local PlayClient = require(script.Parent.Play.PlayClient)
local MafiaClient = require(script.Parent.Mafia.MafiaClient)

local player = Players.LocalPlayer

local app: any = {
	playerGui = player:WaitForChild("PlayerGui"),
	editor = nil,
	play = nil,
	pendingLogicErrors = {},
}

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
end)

app.mode = { creator = false, showcase = nil }
app.menu = Menu.new(app)

-- Заставка на время входа в витрину: игрок не видит меню создателя
local splash = Instance.new("ScreenGui")
splash.Name = "WsSplash"
splash.ResetOnSpawn = false
splash.IgnoreGuiInset = true
splash.DisplayOrder = 30
splash.Enabled = true -- до ответа сервера меню не показываем
splash.Parent = app.playerGui
app.menu:setVisible(false)
do
	local bg = Kit.frame(splash, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Kit.C.bg })
	Kit.label(bg, UiText.L.Loading, { Size = UDim2.new(1, 0, 0, 40), Position = UDim2.new(0, 0, 0.5, -20), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 20 })
end

local function applyMode(mode)
	app.mode = mode
	local hideMenu = mode.showcase ~= nil and not mode.creator
	if hideMenu then
		if app.editor then
			app.editor:destroy()
			app.editor = nil
		end
		app.menu:setVisible(false)
		splash.Enabled = app.play == nil and app.mafia == nil
	else
		splash.Enabled = false
		if not app.editor and not app.play then
			app.menu:setVisible(true)
		end
		app.menu:updateShowcase()
	end
end

-- создатель из витрины переходит в своё меню
function app:openCreatorMenu()
	Remotes.fn("Request"):InvokeServer("OpenCreatorMenu")
end

function app:openShowcase()
	if self.mode.showcase then
		self:joinByCode(self.mode.showcase.code)
	end
end

function app:openEditor(project, readOnly)
	if self.editor then
		self.editor:destroy()
	end
	self.menu:setVisible(false)
	self.editor = Editor.new(self, project, readOnly == true)
end

function app:openProject(projectId: string)
	local res = Remotes.fn("Request"):InvokeServer("OpenProject", projectId)
	if res and res.ok then
		self:openEditor(res.project, res.readOnly)
	else
		-- при ошибке загрузки ничего не создаём и ничего не перезаписываем
		self.menu:showError("load_failed")
	end
end

function app:closeEditor()
	Remotes.fn("Request"):InvokeServer("CloseProject")
	if self.editor then
		self.editor:destroy()
		self.editor = nil
	end
	workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
	self.menu:setVisible(true)
end

-- «Мафия»: отдельный режим со своим экраном
local function openMafia()
	if app.mafia then
		return app.mafia
	end
	if app.editor then
		app.editor:destroy()
		app.editor = nil
	end
	if app.play then
		app.play:destroy()
		app.play = nil
	end
	app.menu:setVisible(false)
	splash.Enabled = false
	app.mafia = MafiaClient.new(app)
	return app.mafia
end

function app:joinMafia()
	Remotes.fn("Request"):InvokeServer("CloseProject")
	openMafia()
	local ok, res = pcall(function()
		return Remotes.fn("MafiaRequest"):InvokeServer("Join")
	end)
	if not ok or not res or not res.ok then
		self:leaveMafia()
		self.menu:showError(nil)
	end
end

function app:leaveMafia()
	if self.mafia then
		self.mafia:destroy()
		self.mafia = nil
	end
	workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
	self.menu:setVisible(true)
end

Remotes.event("Mafia").OnClientEvent:Connect(function(msg)
	-- сервер сам привёл игрока в мафию (например, «Мафия для всех»)
	if not app.mafia and type(msg) == "table" and msg.type == "state" then
		openMafia():onMessage(msg)
	end
end)

function app:joinByCode(code: string)
	if self.editor then
		self.editor:destroy()
		self.editor = nil
	end
	local res = Remotes.fn("Request"):InvokeServer("JoinByCode", code)
	if not res or not res.ok then
		self.menu:setVisible(true)
		self.menu:showError(res and res.error)
	end
end

function app:stopPlay()
	Remotes.fn("Request"):InvokeServer("StopPlay")
end

local function leavePlay()
	if app.play then
		app.play:destroy()
		app.play = nil
	end
	if app.mode.showcase and not app.mode.creator then
		-- игрок витрины не попадает в меню создателя: возвращаем его в карту
		splash.Enabled = true
		workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
		Remotes.fn("Request"):InvokeServer("RejoinShowcase")
		return
	end
	if app.editor then
		-- вернулись из теста: ошибки сценария показываем в редакторе
		app.editor:setEnabled(true)
		if #app.pendingLogicErrors &gt; 0 then
			app.editor.logicErrors = app.pendingLogicErrors
			app.pendingLogicErrors = {}
			app.editor:selectTab("logic")
			Kit.toast(app.editor.gui, UiText.H.LogicErrorHint, Kit.C.bad, 4)
		end
	else
		workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
		app.menu:setVisible(true)
	end
end

Remotes.event("Play").OnClientEvent:Connect(function(msg)
	if type(msg) ~= "table" then
		return
	end
	if msg.type == "mode" then
		applyMode({ creator = msg.creator == true, showcase = msg.showcase })
		return
	end
	if msg.type == "enter" then
		splash.Enabled = false
		if app.play then
			app.play:destroy()
		end
		app.menu:setVisible(false)
		if app.editor then
			app.editor:setEnabled(false)
		end
		app.pendingLogicErrors = {}
		app.play = PlayClient.new(app, msg)
	elseif msg.type == "leave" then
		leavePlay()
	elseif app.play then
		app.play:onMessage(msg)
	end
end)

task.spawn(AdminButton.mount, app.playerGui)
task.spawn(function()
	local res = Remotes.fn("Request"):InvokeServer("Status")
	if res and res.ok then
		applyMode({ creator = res.creator == true, showcase = res.showcase })
	else
		applyMode({ creator = false, showcase = nil })
	end
end)
</ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item>
        <Item class="Folder" referent="RBX0000004B">
          <Properties>
            <string name="Name">Play</string>
          </Properties>
          <Item class="ModuleScript" referent="RBX0000004C">
            <Properties>
              <string name="Name">Bubble</string>
              <ProtectedString name="Source">--!nonstrict
-- Пузырь реплики. Один и тот же код рисует реплику в игре и в предпросмотре
-- редактора, поэтому автор видит на маленьком экране ровно то, что увидят игроки

local TextService = game:GetService("TextService")

local Bubble = {}

Bubble.FONT = Enum.Font.GothamMedium

-- Размер текста подстраивается под экран: не меньше 16 на телефоне
function Bubble.textSize(authorSize: number, viewport: Vector2): number
	local scale = math.clamp(math.min(viewport.X, viewport.Y) / 600, 0.75, 1.25)
	return math.clamp(math.floor(authorSize * scale + 0.5), 16, 40)
end

function Bubble.maxWidth(viewport: Vector2): number
	return math.floor(math.clamp(viewport.X * 0.62, 220, 460))
end

function Bubble.make(parent: Instance, text: string, textSize: number, maxWidth: number, wrap: boolean?): Frame
	local pad = 12
	local bounds = TextService:GetTextSize(text, textSize, Bubble.FONT, Vector2.new(if wrap == false then 10000 else maxWidth - pad * 2, 10000))
	local w = math.min(bounds.X + pad * 2 + 2, if wrap == false then 10000 else maxWidth)
	local h = bounds.Y + pad * 2
	local f = Instance.new("Frame")
	f.Name = "Bubble"
	f.BackgroundColor3 = Color3.fromRGB(250, 250, 252)
	f.BackgroundTransparency = 0.04
	f.BorderSizePixel = 0
	f.Size = UDim2.fromOffset(w, h)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 12)
	c.Parent = f
	local s = Instance.new("UIStroke")
	s.Color = Color3.fromRGB(30, 30, 40)
	s.Transparency = 0.6
	s.Parent = f
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = UDim2.new(1, -pad * 2, 1, -pad * 2)
	l.Position = UDim2.fromOffset(pad, pad)
	l.Font = Bubble.FONT
	l.TextSize = textSize
	l.TextColor3 = Color3.fromRGB(20, 22, 30)
	l.TextWrapped = wrap ~= false
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.TextYAlignment = Enum.TextYAlignment.Top
	l.Text = text
	l.Parent = f
	f.Parent = parent
	return f
end

return Bubble
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX0000004D">
            <Properties>
              <string name="Name">CameraController</string>
              <ProtectedString name="Source">--!nonstrict
-- Камера игры: от первого лица в духе DOORS с настраиваемой чувствительностью,
-- полем зрения и покачиванием (до нуля). Для шкафов и кат-сцен камера временно
-- идёт по заданной траектории, затем возвращается к управлению игрока

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Workshop"):WaitForChild("Shared")
local Anim = require(Shared.Anim)
local Convert = require(Shared.Roblox.Convert)

local CameraController = {}
CameraController.__index = CameraController

local player = Players.LocalPlayer

function CameraController.new(settings)
	local self = setmetatable({}, CameraController)
	self.settings = settings.camera
	self.mode = "player" -- player | track | inside
	self.yaw = 0
	self.pitch = 0
	self.bobT = 0
	self.track = nil
	self.inside = nil
	self.lookTouch = nil :: InputObject?
	self.conns = {}
	local cam = workspace.CurrentCamera
	self.firstPerson = self.settings.mode == "first"

	if self.firstPerson then
		cam.CameraType = Enum.CameraType.Scriptable
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if hrp then
			local _, y = hrp.CFrame:ToOrientation()
			self.yaw = y
		end
	else
		cam.CameraType = Enum.CameraType.Custom
	end
	cam.FieldOfView = self.settings.fov

	-- поворот взгляда: мышь (центр зафиксирован) или палец на свободной части экрана
	table.insert(self.conns, UserInputService.InputChanged:Connect(function(input, processed)
		if not self.firstPerson or self.mode == "track" then
			return
		end
		local sens = self.settings.sensitivity
		if input.UserInputType == Enum.UserInputType.MouseMovement then
			self:look(input.Delta.X * 0.0035 * sens, input.Delta.Y * 0.0035 * sens)
		elseif input.UserInputType == Enum.UserInputType.Touch and input == self.lookTouch and not processed then
			self:look(input.Delta.X * 0.006 * sens, input.Delta.Y * 0.006 * sens)
		end
	end))
	table.insert(self.conns, UserInputService.TouchStarted:Connect(function(input, processed)
		if processed or self.lookTouch then
			return
		end
		-- левая нижняя часть экрана занята джойстиком движения
		local v = workspace.CurrentCamera.ViewportSize
		if input.Position.X &lt; v.X * 0.4 and input.Position.Y &gt; v.Y * 0.45 then
			return
		end
		self.lookTouch = input
	end))
	table.insert(self.conns, UserInputService.TouchEnded:Connect(function(input)
		if input == self.lookTouch then
			self.lookTouch = nil
		end
	end))

	RunService:BindToRenderStep("WsCamera", Enum.RenderPriority.Camera.Value + 1, function(dt)
		self:update(dt)
	end)
	return self
end

function CameraController:look(dx: number, dy: number)
	self.yaw -= dx
	local limit = if self.mode == "inside" then math.rad(35) else math.rad(80)
	self.pitch = math.clamp(self.pitch - dy, -limit, limit)
	if self.mode == "inside" and self.inside then
		self.yaw = math.clamp(self.yaw, self.inside.yaw - math.rad(55), self.inside.yaw + math.rad(55))
	end
end

local function setCharacterVisible(visible: boolean)
	local char = player.Character
	if not char then
		return
	end
	for _, d in char:GetDescendants() do
		if d:IsA("BasePart") or d:IsA("Decal") then
			(d :: any).LocalTransparencyModifier = if visible then 0 else 1
		end
	end
end

function CameraController:update(dt: number)
	local cam = workspace.CurrentCamera
	if self.mode == "track" and self.track then
		local tr = self.track
		tr.elapsed += dt
		local t = math.min(tr.elapsed, tr.clip.length)
		local s = Anim.sample(tr.clip, t).Camera
		cam.CameraType = Enum.CameraType.Scriptable
		if s then
			cam.CFrame = tr.base * Convert.cfFrom(s.pos, s.rot)
		end
		if tr.elapsed &gt;= tr.clip.length then
			self.track = nil
			self.mode = tr.after or "player"
			if tr.done then
				task.spawn(tr.done)
			end
		end
		if self.firstPerson then
			setCharacterVisible(false)
		end
		return
	end
	if self.mode == "inside" and self.inside then
		cam.CameraType = Enum.CameraType.Scriptable
		local eye = self.inside.eye
		cam.CFrame = CFrame.new(eye.Position) * CFrame.fromOrientation(self.pitch, self.yaw, 0)
		if self.firstPerson then
			setCharacterVisible(false)
		end
		return
	end
	if not self.firstPerson then
		if cam.CameraType ~= Enum.CameraType.Custom then
			cam.CameraType = Enum.CameraType.Custom
		end
		return
	end
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum then
		return
	end
	cam.CameraType = Enum.CameraType.Scriptable
	cam.FieldOfView = self.settings.fov
	-- заставка: игрока ведут к дому, камера плавно идёт сзади и чуть сбоку
	if self.walkMode then
		hum.AutoRotate = true
		local look = hrp.CFrame.LookVector
		local flatLook = Vector3.new(look.X, 0, look.Z)
		flatLook = if flatLook.Magnitude &gt; 0.01 then flatLook.Unit else Vector3.new(0, 0, -1)
		local right = Vector3.new(-flatLook.Z, 0, flatLook.X)
		local want = CFrame.lookAt(hrp.Position - flatLook * 10 + Vector3.new(0, 4.5, 0) + right * 2.5, hrp.Position + flatLook * 8 + Vector3.new(0, 2.5, 0))
		self.walkCF = if self.walkCF then self.walkCF:Lerp(want, 1 - math.exp(-dt * 3)) else want
		cam.CFrame = self.walkCF
		setCharacterVisible(true)
		return
	end
	self.walkCF = nil
	if UserInputService.MouseEnabled and not UserInputService.TouchEnabled then
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		UserInputService.MouseIconEnabled = false
	end
	-- мягкая камера от первого лица: взгляд догоняет поворот, шаги дают плавное
	-- покачивание вверх-вниз и из стороны в сторону, при шаге вбок камера слегка
	-- наклоняется, на месте едва заметно «дышит». Интенсивность 0 всё отключает
	local vel = hrp.AssemblyLinearVelocity
	local speed = Vector3.new(vel.X, 0, vel.Z).Magnitude
	local bob = self.settings.bob
	local onGround = hum.FloorMaterial ~= Enum.Material.Air
	local moving = speed &gt; 0.5 and onGround
	self.bobAmp = (self.bobAmp or 0) + ((if moving then 1 else 0) - (self.bobAmp or 0)) * math.min(1, dt * 6)
	self.bobT += dt * math.clamp(speed / 14, 0.5, 1.7) * 8.5
	self.idleT = (self.idleT or 0) + dt
	local amp = self.bobAmp * bob
	local offset = Vector3.new(
		math.sin(self.bobT * 0.5) * 0.08 * amp,
		(math.abs(math.sin(self.bobT * 0.5)) * 0.16 - 0.08) * amp + math.sin(self.idleT * 1.6) * 0.015 * bob,
		0
	)
	-- наклон при шаге и при движении вбок
	local localVel = CFrame.fromOrientation(0, self.yaw, 0):VectorToObjectSpace(vel)
	local strafe = math.clamp(localVel.X / 16, -1, 1)
	local rollTarget = (-strafe * math.rad(2.2) + math.sin(self.bobT * 0.5) * math.rad(0.6) * self.bobAmp) * bob
	self.roll = (self.roll or 0) + (rollTarget - (self.roll or 0)) * math.min(1, dt * 8)
	-- сглаживание взгляда
	self.viewYaw = self.viewYaw or self.yaw
	self.viewPitch = self.viewPitch or self.pitch
	local k = 1 - math.exp(-dt * 22)
	local dy = (self.yaw - self.viewYaw + math.pi) % (2 * math.pi) - math.pi
	self.viewYaw += dy * k
	self.viewPitch += (self.pitch - self.viewPitch) * k
	local headY = if hum.RigType == Enum.HumanoidRigType.R6 then 1.5 else hum.HipHeight * 0.75
	local eye = hrp.Position + Vector3.new(0, headY, 0)
	local rot = CFrame.fromOrientation(self.viewPitch, self.viewYaw, 0) * CFrame.Angles(0, 0, self.roll)
	cam.CFrame = CFrame.new(eye) * rot * CFrame.new(offset)
	-- персонаж поворачивается вслед за взглядом
	if not hrp.Anchored then
		hum.AutoRotate = false
		local flat = CFrame.fromOrientation(0, self.yaw, 0)
		hrp.CFrame = CFrame.new(hrp.Position) * flat
	end
	setCharacterVisible(false)
end

-- Режим заставки при проводке по маршруту
function CameraController:setWalk(on: boolean)
	self.walkMode = on
	if not on then
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if hrp then
			local _, y = hrp.CFrame:ToOrientation()
			self.yaw = y
			self.viewYaw = y
			self.pitch = 0
			self.viewPitch = 0
		end
	end
end

-- Временная траектория камеры (дорожка Camera клипа в системе координат base)
function CameraController:playTrack(base: CFrame, clip, after: string?, done: (() -&gt; ())?)
	if not clip.tracks.Camera then
		if done then
			task.spawn(done)
		end
		return
	end
	self.mode = "track"
	self.track = { base = base, clip = clip, elapsed = 0, after = after, done = done }
end

function CameraController:enterInside(eye: CFrame)
	local _, y = eye:ToOrientation()
	self.inside = { eye = eye, yaw = y }
	self.yaw = y
	self.pitch = 0
	if self.mode ~= "track" then
		self.mode = "inside"
	elseif self.track then
		self.track.after = "inside"
	end
end

-- Возврат управления игроку (после выхода, прерывания или смерти)
function CameraController:restore()
	self.track = nil
	self.inside = nil
	self.mode = "player"
	self.pitch = 0
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if hrp then
		local _, y = hrp.CFrame:ToOrientation()
		self.yaw = y
	end
end

function CameraController:destroy()
	RunService:UnbindFromRenderStep("WsCamera")
	for _, c in self.conns do
		c:Disconnect()
	end
	UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	UserInputService.MouseIconEnabled = true
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.AutoRotate = true
	end
	setCharacterVisible(true)
	local cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Custom
	cam.FieldOfView = 70
end

return CameraController
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX0000004E">
            <Properties>
              <string name="Name">PlayClient</string>
              <ProtectedString name="Source">--!nonstrict
-- Клиент игры: чистый экран, камера, шкафы, реплики, компактная полоска здоровья
-- Кнопки строительства, шкала анимации и служебные сообщения сюда не попадают

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local Lighting = game:GetService("Lighting")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Workshop"):WaitForChild("Shared")
local UiText = require(Shared.UiText)
local Remotes = require(Shared.Roblox.Remotes)
local Convert = require(Shared.Roblox.Convert)
local Closet = require(Shared.Closet)
local Format = require(Shared.Format)

local Kit = require(script.Parent.Parent.UI.Kit)
local CameraController = require(script.Parent.CameraController)
local Bubble = require(script.Parent.Bubble)
local WeatherFx = require(script.Parent.WeatherFx)
local SoundService = game:GetService("SoundService")
local TextService = game:GetService("TextService")

local L = UiText.L

local PlayClient = {}
PlayClient.__index = PlayClient

local player = Players.LocalPlayer

function PlayClient.new(app, msg)
	local self = setmetatable({}, PlayClient)
	self.app = app
	self.kind = msg.kind
	self.isOwner = msg.isOwner
	self.settings = msg.settings
	self.closetId = nil :: string?
	self.bubbles = {}
	local gui = Instance.new("ScreenGui")
	gui.Name = "WsPlay"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.Parent = app.playerGui
	self.gui = gui
	self.camera = CameraController.new(msg.settings)
	self.weather = WeatherFx.new()
	local w = msg.settings.weather
	if w then
		self.weather:set({ weather = w.type, at = workspace:GetServerTimeNow(), auto = w.auto == true, minutes = w.minutes or 5 })
	end
	self.savedLighting = { ClockTime = Lighting.ClockTime, Ambient = Lighting.Ambient, Brightness = Lighting.Brightness }
	local lt = msg.settings.lighting
	-- смена дня и ночи считается на каждом клиенте по общему серверному времени
	self.time = { clock = (lt and lt.clockTime) or 14, at = workspace:GetServerTimeNow(), dayNight = lt and lt.dayNight == true, dayMinutes = (lt and lt.dayMinutes) or 12 }
	self.timeConn = game:GetService("RunService").RenderStepped:Connect(function()
		local t = self.time
		Lighting.ClockTime = Format.clockAt(t, t.clock, t.at, workspace:GetServerTimeNow())
	end)
	if lt then
		Lighting.ClockTime = lt.clockTime or 14
		Lighting.Brightness = lt.brightness or 1
		if lt.ambient then
			Lighting.Ambient = Color3.fromRGB(lt.ambient[1], lt.ambient[2], lt.ambient[3])
		end
	end

	-- в витрине игроки видят только карту; создатель — маленькую кнопку своего меню
	local mode = app.mode or {}
	local inShowcase = mode.showcase ~= nil and msg.code ~= nil and msg.code == mode.showcase.code
	self.inShowcase = inShowcase
	if inShowcase then
		if mode.creator then
			Kit.button(gui, L.CreatorMenu, function()
				app:openCreatorMenu()
			end, { Size = UDim2.fromOffset(170, 40), Position = UDim2.new(1, -180, 0, 60), BackgroundTransparency = 0.35, TextSize = 14 })
		end
	-- выход из теста — только у автора и только в тесте (это часть редактора)
	elseif self.kind == "test" and self.isOwner then
		Kit.button(gui, L.StopTest, function()
			app:stopPlay()
		end, { Size = UDim2.fromOffset(190, 40), Position = UDim2.new(1, -200, 0, 60), BackgroundTransparency = 0.25, TextSize = 14 })
	else
		Kit.button(gui, L.Back, function()
			app:stopPlay()
		end, { Size = UDim2.fromOffset(96, 40), Position = UDim2.new(1, -106, 0, 60), BackgroundTransparency = 0.4, TextSize = 14 })
	end

	-- компактная полоска здоровья, если карте она нужна
	if self.settings.hud.health then
		local bar = Kit.frame(gui, { Size = UDim2.fromOffset(160, 8), Position = UDim2.new(0, 16, 1, -24), BackgroundColor3 = Color3.fromRGB(20, 20, 24), BackgroundTransparency = 0.3 })
		Kit.corner(bar, 4)
		local fill = Kit.frame(bar, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Kit.C.good })
		Kit.corner(fill, 4)
		self.healthFill = fill
		self:trackHealth()
	end

	-- кнопка выхода из шкафа появляется только внутри
	self.leaveButton = Kit.button(gui, L.LeaveCloset, function()
		self:requestCloset()
	end, { Size = UDim2.fromOffset(150, 56), Position = UDim2.new(0.5, -75, 1, -110), Visible = false, BackgroundTransparency = 0.2 })
	ContextActionService:BindAction("WsLeaveCloset", function(_, state)
		if state == Enum.UserInputState.Begin and self.closetId and self.leaveButton.Visible then
			self:requestCloset()
			return Enum.ContextActionResult.Sink
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.E, Enum.KeyCode.ButtonX)

	self.errorConn = nil
	return self
end

function PlayClient:trackHealth()
	local function bind(char: Model)
		local hum = char:WaitForChild("Humanoid") :: Humanoid
		local function upd()
			if self.healthFill then
				self.healthFill.Size = UDim2.fromScale(math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1), 1)
			end
		end
		hum.HealthChanged:Connect(upd)
		upd()
	end
	if player.Character then
		task.spawn(bind, player.Character)
	end
	self.charConn = player.CharacterAdded:Connect(bind)
end

function PlayClient:requestCloset()
	if self.closetId then
		Remotes.event("PlayInput"):FireServer({ type = "closet", id = self.closetId })
	end
end

-- Реплика над выбранной точкой, только на время показа
function PlayClient:say(msg)
	local part = msg.part
	if typeof(part) ~= "Instance" or not part:IsA("BasePart") then
		return
	end
	local old = self.bubbles[part]
	if old then
		old:Destroy()
	end
	local v = Kit.viewport()
	local size = Bubble.textSize(msg.size or 22, v)
	local maxW = Bubble.maxWidth(v)
	local bb = Instance.new("BillboardGui")
	bb.Adornee = part
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.MaxDistance = 120
	bb.StudsOffsetWorldSpace = Vector3.new(0, part.Size.Y / 2 + 1.2, 0)
	bb.Parent = self.app.playerGui
	local b = Bubble.make(bb, msg.text, size, maxW, true)
	bb.Size = UDim2.fromOffset(b.Size.X.Offset, b.Size.Y.Offset)
	bb.SizeOffset = Vector2.new(0, 0.5)
	self.bubbles[part] = bb
	task.delay(msg.seconds or 3, function()
		if self.bubbles[part] == bb then
			self.bubbles[part] = nil
		end
		bb:Destroy()
	end)
end

function PlayClient:onCloset(msg)
	local base: CFrame = msg.base
	if msg.phase == "enter" then
		self.closetId = msg.closetId
		self.leaveButton.Visible = false
		self.camera:playTrack(base, msg.clip, "inside", nil)
		local inside = msg.clip.tracks.Camera and msg.clip.tracks.Camera.keys[#msg.clip.tracks.Camera.keys]
		if inside then
			self.camera:enterInside(base * Convert.cfFrom(inside.pos, inside.rot))
		end
	elseif msg.phase == "inside" then
		self.closetId = msg.closetId
		local eye = base * Convert.cfFrom(msg.pose.pos, msg.pose.rot) * CFrame.new(0, Closet.EYE_HEIGHT, 0)
		if not self.camera.inside then
			self.camera:enterInside(eye)
		elseif self.camera.mode ~= "track" then
			self.camera.mode = "inside"
		end
		self.leaveButton.Visible = true
	elseif msg.phase == "exit" then
		self.leaveButton.Visible = false
		self.camera.inside = nil
		self.camera:playTrack(base, msg.clip, "player", nil)
	elseif msg.phase == "free" or msg.phase == "released" then
		-- шкаф освобождён: управление и камера возвращаются игроку
		self.closetId = nil
		self.leaveButton.Visible = false
		self.camera:restore()
	end
end

function PlayClient:onMessage(msg)
	local t = msg.type
	if t == "say" then
		self:say(msg)
	elseif t == "closet" then
		self:onCloset(msg)
	elseif t == "cutscene" then
		self.camera:playTrack(msg.base, msg.clip, if self.closetId then "inside" else "player", nil)
	elseif t == "walk" then
		-- во время проводки управление выключено, камера показывает путь
		self.camera:setWalk(msg.on == true)
		local ok, controls = pcall(function()
			local pm = require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule") :: ModuleScript) :: any
			return pm:GetControls()
		end)
		if ok and controls then
			if msg.on then
				controls:Disable()
			else
				controls:Enable()
			end
		end
	elseif t == "weather" then
		self.weather:set({ weather = msg.weather, at = msg.at, auto = msg.auto, minutes = msg.minutes })
	elseif t == "music" then
		if self.music then
			self.music:Destroy()
			self.music = nil
		end
		if msg.id then
			local s = Instance.new("Sound")
			s.SoundId = "rbxassetid://" .. tostring(msg.id)
			s.Volume = math.clamp(msg.volume or 0.6, 0, 1)
			s.Looped = true
			s.Parent = SoundService
			s:Play()
			self.music = s
		end
	elseif t == "sound" then
		local s = Instance.new("Sound")
		s.SoundId = "rbxassetid://" .. tostring(msg.id)
		s.Volume = math.clamp(msg.volume or 0.6, 0, 1)
		local part = msg.part
		s.Parent = if typeof(part) == "Instance" then part else SoundService
		s.Ended:Once(function()
			s:Destroy()
		end)
		s:Play()
		task.delay(60, function()
			if s.Parent then
				s:Destroy()
			end
		end)
	elseif t == "message" then
		self:showMessage(msg.text, msg.seconds)
	elseif t == "time" then
		self.time = { clock = msg.clock, at = msg.at, dayNight = msg.dayNight, dayMinutes = msg.dayMinutes }
	elseif t == "respawn" then
		self.closetId = nil
		self.leaveButton.Visible = false
		self.camera:restore()
	elseif t == "logicError" then
		-- ошибка сценария видна только автору в тесте, игровой экран остаётся чистым
		if self.kind == "test" and self.isOwner then
			table.insert(self.app.pendingLogicErrors, { line = msg.line, bid = msg.bid, message = msg.message, runtime = true })
		end
	end
end

-- Сообщение автора карты по центру сверху экрана
function PlayClient:showMessage(text: string, seconds: number?)
	if self.messageFrame then
		self.messageFrame:Destroy()
	end
	local v = Kit.viewport()
	local w = math.min(560, v.X - 40)
	local size = TextService:GetTextSize(text, 20, Kit.FONT_BOLD, Vector2.new(w - 32, 1000))
	local f = Kit.frame(self.gui, {
		Size = UDim2.fromOffset(w, size.Y + 28), Position = UDim2.new(0.5, -w / 2, 0, 90),
		BackgroundColor3 = Color3.fromRGB(15, 16, 20), BackgroundTransparency = 0.25,
	})
	Kit.corner(f, 12)
	Kit.label(f, text, {
		Size = UDim2.new(1, -32, 1, -28), Position = UDim2.fromOffset(16, 14), Font = Kit.FONT_BOLD, TextSize = 20,
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	self.messageFrame = f
	task.delay(seconds or 3, function()
		if self.messageFrame == f then
			self.messageFrame = nil
		end
		f:Destroy()
	end)
end

function PlayClient:destroy()
	self.weather:destroy()
	if self.music then
		self.music:Destroy()
	end
	if self.timeConn then
		self.timeConn:Disconnect()
	end
	ContextActionService:UnbindAction("WsLeaveCloset")
	for _, bb in self.bubbles do
		bb:Destroy()
	end
	if self.charConn then
		self.charConn:Disconnect()
	end
	self.camera:destroy()
	self.gui:Destroy()
	for k, v in self.savedLighting do
		(Lighting :: any)[k] = v
	end
	UserInputService.MouseBehavior = Enum.MouseBehavior.Default
end

return PlayClient
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX0000004F">
            <Properties>
              <string name="Name">WeatherFx</string>
              <ProtectedString name="Source">--!nonstrict
-- Погода на клиенте: дождь, снег, туман, гроза. Частицы летят вокруг камеры,
-- а под крышей дождь и снег выключаются, чтобы в помещении было сухо

local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Workshop"):WaitForChild("Shared")
local Format = require(Shared.Format)

local WeatherFx = {}
WeatherFx.__index = WeatherFx

local PRESETS = {
	Clear = { rate = 0, density = 0, haze = 0, dim = 0 },
	Rain = { rate = 700, speed = NumberRange.new(70, 90), life = NumberRange.new(0.6, 0.8), size = 0.07, squash = 8, color = Color3.fromRGB(170, 190, 210), density = 0.32, haze = 1.2, dim = 0.15 },
	Snow = { rate = 260, speed = NumberRange.new(5, 9), life = NumberRange.new(5, 7), size = 0.28, squash = 0, color = Color3.fromRGB(255, 255, 255), density = 0.3, haze = 1, dim = 0.05, spread = 35 },
	Fog = { rate = 0, density = 0.62, haze = 2.6, dim = 0.1 },
	Storm = { rate = 1400, speed = NumberRange.new(90, 110), life = NumberRange.new(0.5, 0.7), size = 0.08, squash = 10, color = Color3.fromRGB(160, 175, 200), density = 0.45, haze = 1.8, dim = 0.3, lightning = true },
}

function WeatherFx.new()
	local self = setmetatable({}, WeatherFx)
	self.state = { weather = "Clear", at = 0, auto = false, minutes = 5 }
	self.current = nil
	local emitterPart = Instance.new("Part")
	emitterPart.Name = "WsWeather"
	emitterPart.Anchored = true
	emitterPart.CanCollide = false
	emitterPart.CanQuery = false
	emitterPart.CanTouch = false
	emitterPart.Transparency = 1
	emitterPart.Size = Vector3.new(90, 1, 90)
	emitterPart.Parent = workspace
	self.part = emitterPart
	local e = Instance.new("ParticleEmitter")
	e.EmissionDirection = Enum.NormalId.Bottom
	e.Rate = 0
	e.LightInfluence = 0.6
	e.Parent = emitterPart
	self.emitter = e
	self.atmosphere = Instance.new("Atmosphere")
	self.atmosphere.Density = 0
	self.atmosphere.Parent = Lighting
	self.flash = Instance.new("ColorCorrectionEffect")
	self.flash.Parent = Lighting
	self.nextFlash = 0
	self.conn = RunService.RenderStepped:Connect(function()
		self:update()
	end)
	return self
end

function WeatherFx:set(state)
	self.state = state
end

function WeatherFx:apply(name: string)
	local p = PRESETS[name] or PRESETS.Clear
	self.current = name
	self.preset = p
	local e = self.emitter
	if p.rate &gt; 0 then
		e.Speed = p.speed
		e.Lifetime = p.life
		e.Size = NumberSequence.new(p.size)
		e.Squash = NumberSequence.new(p.squash)
		e.Color = ColorSequence.new(p.color)
		e.Transparency = NumberSequence.new(0.35)
		local spread = p.spread or 4
		e.SpreadAngle = Vector2.new(spread, spread)
	end
	self.atmosphere.Density = p.density
	self.atmosphere.Haze = p.haze
	self.atmosphere.Color = Color3.fromRGB(190, 195, 205)
	self.flash.Brightness = -p.dim
	self.flash.Saturation = -p.dim
end

function WeatherFx:update()
	local s = self.state
	local name = Format.weatherAt({ auto = s.auto, minutes = s.minutes }, s.weather, s.at, workspace:GetServerTimeNow())
	if name ~= self.current then
		self:apply(name)
	end
	local p = self.preset
	local cam = workspace.CurrentCamera
	if not cam or not p then
		return
	end
	local pos = cam.CFrame.Position
	self.part.CFrame = CFrame.new(pos + Vector3.new(0, 30, 0))
	-- под крышей осадков нет
	local covered = false
	if p.rate &gt; 0 then
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		local char = game:GetService("Players").LocalPlayer.Character
		params.FilterDescendantsInstances = { self.part, char }
		covered = workspace:Raycast(pos, Vector3.new(0, 80, 0), params) ~= nil
	end
	self.emitter.Rate = if covered then 0 else p.rate
	-- молния в грозу
	if p.lightning then
		local now = os.clock()
		if now &gt;= self.nextFlash then
			self.nextFlash = now + 6 + math.random() * 9
			self.flash.Brightness = 0.6
			task.delay(0.12, function()
				self.flash.Brightness = -p.dim
			end)
		end
	end
end

function WeatherFx:destroy()
	self.conn:Disconnect()
	self.part:Destroy()
	self.atmosphere:Destroy()
	self.flash:Destroy()
end

return WeatherFx
</ProtectedString>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="RBX00000050">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="RBX00000051">
            <Properties>
              <string name="Name">AdminButton</string>
              <ProtectedString name="Source">--!nonstrict
-- Маленькая кнопка админ-панели рядом с меню Roblox (в свободной области верхней панели)
-- Кнопка видна только администраторам, но каждое действие проверяется на сервере

local GuiService = game:GetService("GuiService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Workshop"):WaitForChild("Shared")
local UiText = require(Shared.UiText)
local Remotes = require(Shared.Roblox.Remotes)
local Kit = require(script.Parent.Kit)

local L = UiText.L

local AdminButton = {}

function AdminButton.mount(playerGui: PlayerGui)
	local res = Remotes.fn("Request"):InvokeServer("AdminStatus")
	if not res or not res.admin then
		return
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = "WsAdmin"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 20
	gui.Parent = playerGui
	local button = Kit.button(gui, L.Admin, nil, { Size = UDim2.fromOffset(64, 32), TextSize = 13, BackgroundTransparency = 0.2 })
	local function place()
		-- TopbarInset — свободная часть верхней панели справа от кнопок Roblox
		local inset = GuiService.TopbarInset
		local h = inset.Height
		if h &lt;= 0 then
			button.Position = UDim2.fromOffset(104, 4)
		else
			button.Position = UDim2.fromOffset(inset.Min.X + 6, inset.Min.Y + math.max(0, (h - 32) / 2))
		end
	end
	place()
	GuiService:GetPropertyChangedSignal("TopbarInset"):Connect(place)

	local panel: Frame? = nil
	local function close()
		if panel then
			panel:Destroy()
			panel = nil
		end
	end
	local function open()
		close()
		local w = math.min(420, Kit.viewport().X - 24)
		local p = Kit.frame(gui, { Size = UDim2.fromOffset(w, 420), Position = UDim2.fromOffset(12, 64) })
		panel = p
		Kit.corner(p, 12)
		Kit.pad(p, 10)
		Kit.label(p, L.AdminTitle, { Font = Kit.FONT_BOLD, TextSize = 17, Size = UDim2.new(1, -50, 0, 28) })
		Kit.button(p, "✕", close, { Size = UDim2.fromOffset(40, 32), Position = UDim2.new(1, -40, 0, -2) })
		local list = Kit.scroll(p, { Position = UDim2.fromOffset(0, 36), Size = UDim2.new(1, 0, 1, -36 - Kit.TAP * 2 - 12) })
		Kit.list(list, 6)
		local r = Remotes.fn("Request"):InvokeServer("AdminAction", "ListSessions")
		if r and r.ok then
			for i, s in r.sessions do
				local title = (s.code or L.SessionTest) .. "\n" .. string.format(L.PlayersCount, #s.players)
				Kit.button(list, title .. "\n" .. L.AdminEndSession, function()
					Remotes.fn("Request"):InvokeServer("AdminAction", "EndSession", s.id)
					open()
				end, { LayoutOrder = i * 10, Size = UDim2.new(1, -8, 0, 64) })
				for j, pl in s.players do
					Kit.button(list, pl.name .. "\n" .. L.AdminKick, function()
						Remotes.fn("Request"):InvokeServer("AdminAction", "Kick", pl.userId)
						open()
					end, { LayoutOrder = i * 10 + j, Size = UDim2.new(1, -24, 0, 52), TextSize = 13 })
				end
			end
		end
		local code = Kit.textbox(p, "", L.CodePlaceholder, nil, { Position = UDim2.new(0, 0, 1, -Kit.TAP * 2 - 6) })
		Kit.button(p, L.AdminUnlist, function()
			Remotes.fn("Request"):InvokeServer("AdminAction", "Unlist", code.Text)
			code.Text = ""
		end, { Position = UDim2.new(0, 0, 1, -Kit.TAP), BackgroundColor3 = Kit.C.bad })
	end
	button.Activated:Connect(function()
		if panel then
			close()
		else
			open()
		end
	end)
end

return AdminButton
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00000052">
            <Properties>
              <string name="Name">Kit</string>
              <ProtectedString name="Source">--!nonstrict
-- Небольшой набор элементов интерфейса, рассчитанный на касание:
-- кнопки не меньше 44 пикселей, крупный текст, прокрутка списков пальцем

local UserInputService = game:GetService("UserInputService")
local TextService = game:GetService("TextService")

local Kit = {}

Kit.C = {
	bg = Color3.fromRGB(22, 24, 30),
	panel = Color3.fromRGB(32, 35, 44),
	panel2 = Color3.fromRGB(42, 46, 58),
	line = Color3.fromRGB(60, 65, 80),
	text = Color3.fromRGB(235, 237, 242),
	dim = Color3.fromRGB(160, 166, 180),
	accent = Color3.fromRGB(88, 140, 255),
	accentDim = Color3.fromRGB(52, 78, 140),
	good = Color3.fromRGB(80, 190, 120),
	warn = Color3.fromRGB(240, 180, 60),
	bad = Color3.fromRGB(235, 80, 80),
}

local UIS = game:GetService("UserInputService")
-- на сенсорных экранах кнопки крупнее, чтобы попадать пальцем
Kit.TAP = if UIS.TouchEnabled then 52 else 44
local UiText = require(game:GetService("ReplicatedStorage"):WaitForChild("Workshop"):WaitForChild("Shared"):WaitForChild("UiText"))
Kit.YES = UiText.L.Yes
local L_CANCEL = UiText.L.Cancel
local L_APPLY = UiText.L.Apply
local L_CUSTOM_COLOR = UiText.L.CustomColor
Kit.NO = UiText.L.No
Kit.FONT = Enum.Font.GothamMedium
Kit.FONT_BOLD = Enum.Font.GothamBold

function Kit.isTouch(): boolean
	return UserInputService.TouchEnabled and not UserInputService.MouseEnabled
end

function Kit.viewport(): Vector2
	local cam = workspace.CurrentCamera
	return if cam then cam.ViewportSize else Vector2.new(1024, 768)
end

-- Компактный режим: телефон или узкое окно
function Kit.compact(): boolean
	local v = Kit.viewport()
	return v.X &lt; 900 or v.Y &lt; 520
end

local function corner(parent: Instance, r: number?)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 8)
	c.Parent = parent
	return c
end
Kit.corner = corner

function Kit.pad(parent: Instance, p: number)
	local u = Instance.new("UIPadding")
	u.PaddingLeft = UDim.new(0, p)
	u.PaddingRight = UDim.new(0, p)
	u.PaddingTop = UDim.new(0, p)
	u.PaddingBottom = UDim.new(0, p)
	u.Parent = parent
	return u
end

function Kit.list(parent: Instance, gap: number?, horizontal: boolean?)
	local l = Instance.new("UIListLayout")
	l.Padding = UDim.new(0, gap or 6)
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.FillDirection = if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical
	l.Parent = parent
	return l
end

function Kit.frame(parent: Instance?, props: { [string]: any }?): Frame
	local f = Instance.new("Frame")
	f.BackgroundColor3 = Kit.C.panel
	f.BorderSizePixel = 0
	if props then
		for k, v in props do
			(f :: any)[k] = v
		end
	end
	f.Parent = parent
	return f
end

function Kit.label(parent: Instance?, text: string, props: { [string]: any }?): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Font = Kit.FONT
	l.TextColor3 = Kit.C.text
	l.TextSize = 16
	l.Text = text
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.TextWrapped = true
	l.Size = UDim2.new(1, 0, 0, 22)
	if props then
		for k, v in props do
			(l :: any)[k] = v
		end
	end
	l.Parent = parent
	return l
end

-- Заголовок и уточнение выводятся двумя строками, а не через точку
function Kit.titleBlock(parent: Instance?, title: string, subtitle: string?, order: number?)
	local f = Kit.frame(parent, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, if subtitle then 48 else 26), LayoutOrder = order or 0 })
	Kit.label(f, title, { Font = Kit.FONT_BOLD, TextSize = 18, Size = UDim2.new(1, 0, 0, 24) })
	if subtitle then
		Kit.label(f, subtitle, { TextColor3 = Kit.C.dim, TextSize = 14, Position = UDim2.fromOffset(0, 26), Size = UDim2.new(1, 0, 0, 20) })
	end
	return f
end

function Kit.button(parent: Instance?, text: string, onClick: (() -&gt; ())?, props: { [string]: any }?): TextButton
	local b = Instance.new("TextButton")
	b.AutoButtonColor = true
	b.BackgroundColor3 = Kit.C.panel2
	b.BorderSizePixel = 0
	b.Font = Kit.FONT
	b.TextColor3 = Kit.C.text
	b.TextSize = 15
	b.TextWrapped = true
	b.Text = text
	b.Size = UDim2.new(1, 0, 0, Kit.TAP)
	corner(b)
	if props then
		for k, v in props do
			(b :: any)[k] = v
		end
	end
	if onClick then
		b.Activated:Connect(onClick)
	end
	b.Parent = parent
	return b
end

function Kit.setActive(b: GuiObject, active: boolean)
	b.BackgroundColor3 = if active then Kit.C.accent else Kit.C.panel2
end

function Kit.scroll(parent: Instance?, props: { [string]: any }?): ScrollingFrame
	local s = Instance.new("ScrollingFrame")
	s.BackgroundTransparency = 1
	s.BorderSizePixel = 0
	s.ScrollBarThickness = 6
	s.ScrollingDirection = Enum.ScrollingDirection.Y
	s.AutomaticCanvasSize = Enum.AutomaticSize.Y
	s.CanvasSize = UDim2.new()
	s.Size = UDim2.fromScale(1, 1)
	s.ElasticBehavior = Enum.ElasticBehavior.WhenScrollable
	if props then
		for k, v in props do
			(s :: any)[k] = v
		end
	end
	s.Parent = parent
	return s
end

function Kit.textbox(parent: Instance?, text: string, placeholder: string, onDone: ((string) -&gt; ())?, props: { [string]: any }?): TextBox
	local t = Instance.new("TextBox")
	t.BackgroundColor3 = Kit.C.bg
	t.BorderSizePixel = 0
	t.Font = Kit.FONT
	t.TextColor3 = Kit.C.text
	t.PlaceholderColor3 = Kit.C.dim
	t.PlaceholderText = placeholder
	t.TextSize = 16
	t.Text = text
	t.ClearTextOnFocus = false
	t.TextXAlignment = Enum.TextXAlignment.Left
	t.Size = UDim2.new(1, 0, 0, Kit.TAP)
	corner(t, 6)
	Kit.pad(t, 8)
	if props then
		for k, v in props do
			(t :: any)[k] = v
		end
	end
	if onDone then
		t.FocusLost:Connect(function()
			onDone(t.Text)
		end)
	end
	t.Parent = parent
	return t
end

-- Подпись слева, элемент справа
function Kit.row(parent: Instance?, title: string, order: number?): (Frame, Frame)
	local r = Kit.frame(parent, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, Kit.TAP), LayoutOrder = order or 0 })
	Kit.label(r, title, { Size = UDim2.new(0.42, -4, 1, 0), TextColor3 = Kit.C.dim, TextSize = 14 })
	local slot = Kit.frame(r, { BackgroundTransparency = 1, Position = UDim2.new(0.42, 0, 0, 0), Size = UDim2.new(0.58, 0, 1, 0) })
	return r, slot
end

function Kit.toggle(parent: Instance?, title: string, value: boolean, onChange: (boolean) -&gt; (), order: number?)
	local _, slot = Kit.row(parent, title, order)
	local state = value
	local b
	b = Kit.button(slot, "", function()
		state = not state
		b.Text = if state then Kit.YES else Kit.NO
		Kit.setActive(b, state)
		onChange(state)
	end)
	b.Text = if state then Kit.YES else Kit.NO
	Kit.setActive(b, state)
	return b
end

-- Число с кнопками «−» и «+» и полем ввода (удобно пальцем)
function Kit.stepper(parent: Instance?, title: string, value: number, step: number, lo: number, hi: number, onChange: (number) -&gt; (), order: number?)
	local _, slot = Kit.row(parent, title, order)
	local cur = value
	local box: TextBox
	local function fmt(v: number): string
		if v == math.floor(v) then
			return string.format("%d", v)
		end
		return string.format("%.2f", v)
	end
	local function set(v: number)
		v = math.clamp(math.floor(v / step * 1000 + 0.5) / 1000 * step, lo, hi)
		cur = v
		box.Text = fmt(v)
		onChange(v)
	end
	Kit.button(slot, "−", function()
		set(cur - step)
	end, { Size = UDim2.new(0, Kit.TAP, 1, 0) })
	box = Kit.textbox(slot, fmt(cur), "", function(t)
		local n = tonumber((string.gsub(t, ",", ".")))
		if n then
			set(n)
		else
			box.Text = fmt(cur)
		end
	end, { Position = UDim2.new(0, Kit.TAP + 4, 0, 0), Size = UDim2.new(1, -2 * Kit.TAP - 8, 1, 0), TextXAlignment = Enum.TextXAlignment.Center })
	Kit.button(slot, "+", function()
		set(cur + step)
	end, { Position = UDim2.new(1, -Kit.TAP, 0, 0), Size = UDim2.new(0, Kit.TAP, 1, 0) })
	return function(v: number)
		cur = v
		box.Text = fmt(v)
	end
end

-- Ползунок для пальца: перетаскивание по всей ширине
function Kit.slider(parent: Instance?, title: string, value: number, lo: number, hi: number, onChange: (number) -&gt; (), order: number?)
	local _, slot = Kit.row(parent, title, order)
	local bar = Kit.frame(slot, { BackgroundColor3 = Kit.C.bg, Size = UDim2.new(1, -52, 0, 10), Position = UDim2.new(0, 0, 0.5, -5) })
	corner(bar, 5)
	local fill = Kit.frame(bar, { BackgroundColor3 = Kit.C.accent, Size = UDim2.fromScale(0, 1) })
	corner(fill, 5)
	local valueLabel = Kit.label(slot, "", { Size = UDim2.new(0, 48, 1, 0), Position = UDim2.new(1, -48, 0, 0), TextXAlignment = Enum.TextXAlignment.Right, TextSize = 14 })
	local hit = Instance.new("TextButton")
	hit.BackgroundTransparency = 1
	hit.Text = ""
	hit.Size = UDim2.new(1, -52, 1, 0)
	hit.Parent = slot
	local function show(v: number)
		local a = (v - lo) / (hi - lo)
		fill.Size = UDim2.fromScale(math.clamp(a, 0, 1), 1)
		valueLabel.Text = string.format("%.2f", v)
	end
	show(value)
	local dragging = false
	local function at(x: number)
		local a = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
		local v = lo + (hi - lo) * a
		v = math.floor(v * 100 + 0.5) / 100
		show(v)
		return v
	end
	local last = value
	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			last = at(input.Position.X)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			last = at(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			dragging = false
			onChange(last)
		end
	end)
	return show
end

-- Всплывающий список для выбора варианта
function Kit.choose(root: Instance, title: string, options: { { id: any, title: string, hint: string? } }, onPick: (any) -&gt; ())
	local shade = Instance.new("TextButton")
	shade.Text = ""
	shade.AutoButtonColor = false
	shade.BackgroundColor3 = Color3.new(0, 0, 0)
	shade.BackgroundTransparency = 0.45
	shade.Size = UDim2.fromScale(1, 1)
	shade.ZIndex = 50
	shade.Parent = root
	local v = Kit.viewport()
	local w = math.min(380, v.X - 32)
	local h = math.min(#options * 50 + 70, v.Y - 60)
	local box = Kit.frame(shade, {
		Size = UDim2.fromOffset(w, h),
		Position = UDim2.new(0.5, -w / 2, 0.5, -h / 2),
		ZIndex = 51,
	})
	corner(box, 12)
	Kit.pad(box, 10)
	Kit.label(box, title, { Font = Kit.FONT_BOLD, TextSize = 17, ZIndex = 52, Size = UDim2.new(1, -50, 0, 28) })
	Kit.button(box, "✕", function()
		shade:Destroy()
	end, { Size = UDim2.fromOffset(40, 32), Position = UDim2.new(1, -40, 0, -2), ZIndex = 52 })
	local list = Kit.scroll(box, { Position = UDim2.fromOffset(0, 36), Size = UDim2.new(1, 0, 1, -36), ZIndex = 52 })
	Kit.list(list, 6)
	for i, o in options do
		local text = o.title
		if o.hint then
			text = o.title .. "\n" .. o.hint
		end
		Kit.button(list, text, function()
			shade:Destroy()
			onPick(o.id)
		end, { LayoutOrder = i, ZIndex = 53, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -8, 0, if o.hint then 52 else Kit.TAP) })
	end
	shade.Activated:Connect(function()
		shade:Destroy()
	end)
	return shade
end

-- Полная палитра: любой цвет. Квадрат насыщенности и яркости, полоса оттенка,
-- код цвета #RRGGBB и недавние цвета. Всё рассчитано на палец
Kit.recentColors = {} :: { { number } }

local function toRGB(c: Color3)
	return { math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5) }
end

function Kit.colorPicker(root: Instance, initial, onDone: ({ number }) -&gt; ())
	local shade = Kit.frame(root, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.45, ZIndex = 60 })
	local v = Kit.viewport()
	local w = math.min(380, v.X - 24)
	local box = Kit.frame(shade, { Size = UDim2.fromOffset(w, 0), AutomaticSize = Enum.AutomaticSize.Y, Position = UDim2.new(0.5, -w / 2, 0, math.max(8, v.Y * 0.06)), ZIndex = 61 })
	corner(box, 14)
	Kit.pad(box, 12)
	Kit.list(box, 10)
	local start = initial or { 200, 200, 200 }
	local h, s, val = Color3.fromRGB(start[1], start[2], start[3]):ToHSV()

	local head = Kit.frame(box, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 44), LayoutOrder = 1, ZIndex = 62 })
	Kit.label(head, L_CUSTOM_COLOR, { Font = Kit.FONT_BOLD, TextSize = 17, ZIndex = 62, Size = UDim2.new(1, -110, 1, 0) })
	local preview = Kit.frame(head, { Size = UDim2.fromOffset(100, 40), Position = UDim2.new(1, -100, 0, 2), ZIndex = 62 })
	corner(preview, 8)

	-- квадрат: слева направо насыщенность, снизу вверх яркость
	local sq = math.min(w - 24, math.floor(v.Y * 0.38))
	local square = Kit.frame(box, { Size = UDim2.fromOffset(w - 24, sq), LayoutOrder = 2, ZIndex = 62 })
	corner(square, 8)
	local white = Kit.frame(square, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 63 })
	corner(white, 8)
	local g1 = Instance.new("UIGradient")
	g1.Transparency = NumberSequence.new(0, 1)
	g1.Parent = white
	local black = Kit.frame(square, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), ZIndex = 64 })
	corner(black, 8)
	local g2 = Instance.new("UIGradient")
	g2.Transparency = NumberSequence.new(1, 0)
	g2.Rotation = 90
	g2.Parent = black
	local dot = Kit.frame(square, { Size = UDim2.fromOffset(22, 22), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, ZIndex = 66 })
	local ring = Instance.new("UIStroke")
	ring.Thickness = 3
	ring.Color = Color3.new(1, 1, 1)
	ring.Parent = dot
	corner(dot, 11)

	-- полоса оттенка
	local hueBar = Kit.frame(box, { Size = UDim2.new(1, 0, 0, 34), LayoutOrder = 3, BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 62 })
	corner(hueBar, 8)
	local hg = Instance.new("UIGradient")
	local keys = {}
	for i = 0, 6 do
		table.insert(keys, ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i / 6 % 1, 1, 1)))
	end
	hg.Color = ColorSequence.new(keys)
	hg.Parent = hueBar
	local hueMark = Kit.frame(hueBar, { Size = UDim2.new(0, 6, 1, 6), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 63 })
	corner(hueMark, 3)

	local hex = Kit.textbox(box, "", "#RRGGBB", nil, { LayoutOrder = 4, ZIndex = 62, TextXAlignment = Enum.TextXAlignment.Center, Font = Enum.Font.Code })

	local recentRow = Kit.frame(box, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 40), LayoutOrder = 5, ZIndex = 62 })
	Kit.list(recentRow, 6, true)

	local function current(): { number }
		return toRGB(Color3.fromHSV(h, s, val))
	end
	local function refresh(fromHex: boolean?)
		local c = Color3.fromHSV(h, s, val)
		preview.BackgroundColor3 = c
		square.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		dot.Position = UDim2.fromScale(s, 1 - val)
		hueMark.Position = UDim2.fromScale(h, 0.5)
		if not fromHex then
			local rgb = toRGB(c)
			hex.Text = string.format("#%02X%02X%02X", rgb[1], rgb[2], rgb[3])
		end
	end
	for i, c in Kit.recentColors do
		if i &gt; 7 then
			break
		end
		Kit.button(recentRow, "", function()
			h, s, val = Color3.fromRGB(c[1], c[2], c[3]):ToHSV()
			refresh()
		end, { Size = UDim2.fromOffset(40, 40), BackgroundColor3 = Color3.fromRGB(c[1], c[2], c[3]), LayoutOrder = i, ZIndex = 63 })
	end
	hex:GetPropertyChangedSignal("Text"):Connect(function()
		local r, g, b = string.match(hex.Text, "^#?(%x%x)(%x%x)(%x%x)$")
		if r then
			h, s, val = Color3.fromRGB(tonumber(r, 16), tonumber(g, 16), tonumber(b, 16)):ToHSV()
			refresh(true)
		end
	end)

	-- перетаскивание пальцем или мышью
	local drag: string? = nil
	local function at(pos: Vector3)
		if drag == "square" then
			s = math.clamp((pos.X - square.AbsolutePosition.X) / square.AbsoluteSize.X, 0, 1)
			val = 1 - math.clamp((pos.Y - square.AbsolutePosition.Y) / square.AbsoluteSize.Y, 0, 1)
		elseif drag == "hue" then
			h = math.clamp((pos.X - hueBar.AbsolutePosition.X) / hueBar.AbsoluteSize.X, 0, 0.999)
		end
		refresh()
	end
	local function begin(kind: string)
		return function(input: InputObject)
			if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
				drag = kind
				at(input.Position)
			end
		end
	end
	black.InputBegan:Connect(begin("square"))
	hueBar.InputBegan:Connect(begin("hue"))
	local c1 = UIS.InputChanged:Connect(function(input)
		if drag and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
			at(input.Position)
		end
	end)
	local c2 = UIS.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			drag = nil
		end
	end)
	local function close()
		c1:Disconnect()
		c2:Disconnect()
		shade:Destroy()
	end

	local row = Kit.frame(box, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, Kit.TAP), LayoutOrder = 6, ZIndex = 62 })
	Kit.button(row, L_CANCEL, close, { Size = UDim2.new(0.5, -4, 1, 0), ZIndex = 63 })
	Kit.button(row, L_APPLY, function()
		local c = current()
		close()
		table.insert(Kit.recentColors, 1, c)
		while #Kit.recentColors &gt; 7 do
			table.remove(Kit.recentColors)
		end
		onDone(c)
	end, { Size = UDim2.new(0.5, -4, 1, 0), Position = UDim2.new(0.5, 4, 0, 0), ZIndex = 63, BackgroundColor3 = Kit.C.accent })
	refresh()
	return shade
end

-- Окно с одним полем ввода (например, ID своей текстуры)
function Kit.prompt(root: Instance, title: string, hint: string?, placeholder: string, onDone: (string) -&gt; ())
	local shade = Kit.frame(root, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.45, ZIndex = 50 })
	local w = math.min(400, Kit.viewport().X - 32)
	local box = Kit.frame(shade, { Size = UDim2.fromOffset(w, 0), AutomaticSize = Enum.AutomaticSize.Y, Position = UDim2.new(0.5, -w / 2, 0.2, 0), ZIndex = 51 })
	corner(box, 12)
	Kit.pad(box, 12)
	Kit.list(box, 8)
	Kit.label(box, title, { Font = Kit.FONT_BOLD, TextSize = 17, ZIndex = 52, LayoutOrder = 1 })
	if hint then
		Kit.label(box, hint, { TextColor3 = Kit.C.dim, TextSize = 13, ZIndex = 52, LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 36) })
	end
	local t = Kit.textbox(box, "", placeholder, nil, { ZIndex = 52, LayoutOrder = 3 })
	local row = Kit.frame(box, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, Kit.TAP), LayoutOrder = 4, ZIndex = 52 })
	Kit.button(row, L_CANCEL, function()
		shade:Destroy()
	end, { Size = UDim2.new(0.5, -4, 1, 0), ZIndex = 53 })
	Kit.button(row, L_APPLY, function()
		local v = t.Text
		shade:Destroy()
		onDone(v)
	end, { Size = UDim2.new(0.5, -4, 1, 0), Position = UDim2.new(0.5, 4, 0, 0), ZIndex = 53, BackgroundColor3 = Kit.C.accent })
	return shade
end

-- Короткое уведомление внизу экрана (только в редакторе и меню)
function Kit.toast(root: Instance, text: string, color: Color3?, seconds: number?)
	local v = Kit.viewport()
	local w = math.min(520, v.X - 32)
	local size = TextService:GetTextSize(text, 15, Kit.FONT, Vector2.new(w - 24, 1000))
	local f = Kit.frame(root, {
		Size = UDim2.fromOffset(w, size.Y + 24),
		Position = UDim2.new(0.5, -w / 2, 1, -size.Y - 90),
		BackgroundColor3 = color or Kit.C.panel2,
		ZIndex = 80,
	})
	corner(f, 10)
	Kit.label(f, text, { Size = UDim2.new(1, -24, 1, -24), Position = UDim2.fromOffset(12, 12), TextSize = 15, ZIndex = 81 })
	task.delay(seconds or 3, function()
		f:Destroy()
	end)
	return f
end

return Kit
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00000053">
            <Properties>
              <string name="Name">Menu</string>
              <ProtectedString name="Source">--!nonstrict
-- Главное меню мастерской: мои карты, новая карта, демосцена, каталог и вход по коду

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Workshop"):WaitForChild("Shared")
local UiText = require(Shared.UiText)
local Remotes = require(Shared.Roblox.Remotes)
local Kit = require(script.Parent.Kit)

local L, H = UiText.L, UiText.H

local Menu = {}
Menu.__index = Menu

local ERRORS = {
	not_found = H.NotFoundHint,
	bad_code = H.CodeHint,
	load_failed = H.LoadFailedHint,
}

function Menu.new(app)
	local self = setmetatable({}, Menu)
	self.app = app
	local gui = Instance.new("ScreenGui")
	gui.Name = "WsMenu"
	gui.ResetOnSpawn = false
	gui.Parent = app.playerGui
	self.gui = gui
	local bg = Kit.frame(gui, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Kit.C.bg, BackgroundTransparency = 0.15 })
	local v = Kit.viewport()
	local w = math.min(720, v.X - 24)
	local box = Kit.frame(bg, { Size = UDim2.new(0, w, 1, -40), Position = UDim2.new(0.5, -w / 2, 0, 20), BackgroundTransparency = 1 })
	-- название и подзаголовок — двумя строками
	Kit.label(box, L.AppTitle, { Font = Kit.FONT_BOLD, TextSize = 30, Size = UDim2.new(1, 0, 0, 38) })
	Kit.label(box, L.AppSubtitle, { TextColor3 = Kit.C.dim, TextSize = 16, Position = UDim2.fromOffset(0, 40), Size = UDim2.new(1, 0, 0, 22) })

	local actions = Kit.frame(box, { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 76), Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
	local g = Instance.new("UIGridLayout")
	g.CellSize = UDim2.new(if Kit.compact() then 0.5 else 0.25, -6, 0, 56)
	g.CellPadding = UDim2.fromOffset(6, 6)
	g.Parent = actions
	Kit.button(actions, L.NewMap, function()
		self:createMap(nil)
	end, { BackgroundColor3 = Kit.C.accent })
	Kit.button(actions, L.Mafia, function()
		self.app:joinMafia()
	end, { BackgroundColor3 = Color3.fromRGB(120, 30, 40) })
	Kit.button(actions, L.NewDemo, function()
		self:createMap("demo")
	end)
	Kit.button(actions, L.Catalog, function()
		self:showCatalog()
	end)
	Kit.button(actions, L.EnterCode, function()
		self:enterCode()
	end)

	-- витрина включена: создатель видит её название и может выключить или открыть
	self.showcaseBanner = Kit.frame(box, {
		Position = UDim2.new(0, 0, 1, -(Kit.TAP * 2 + 34)), Size = UDim2.new(1, 0, 0, Kit.TAP * 2 + 30),
		BackgroundColor3 = Kit.C.accentDim, Visible = false, ZIndex = 5,
	})
	Kit.corner(self.showcaseBanner, 10)
	Kit.pad(self.showcaseBanner, 8)
	self.showcaseTitle = Kit.label(self.showcaseBanner, "", { Font = Kit.FONT_BOLD, Size = UDim2.new(1, 0, 0, 40), ZIndex = 6 })
	Kit.button(self.showcaseBanner, L.ShowcaseOpen, function()
		self.app:openShowcase()
	end, { Size = UDim2.new(0.5, -4, 0, Kit.TAP), Position = UDim2.new(0, 0, 1, -Kit.TAP), ZIndex = 6 })
	Kit.button(self.showcaseBanner, L.ShowcaseTurnOff, function()
		local r = Remotes.fn("Request"):InvokeServer("SetShowcase", nil)
		if r and r.ok then
			self.app.mode.showcase = nil
			self:updateShowcase()
		end
	end, { Size = UDim2.new(0.5, -4, 0, Kit.TAP), Position = UDim2.new(0.5, 4, 1, -Kit.TAP), ZIndex = 6, BackgroundColor3 = Kit.C.bad })

	-- создатель может сделать «Мафию» тем, что видят все вместо меню
	self.mafiaShowcase = Kit.button(box, L.ShowcaseMafia, function()
		local r = Remotes.fn("Request"):InvokeServer("SetShowcase", "MAFIA")
		if r and r.ok then
			Kit.toast(self.gui, L.ShowcaseSetDone, Kit.C.good)
		end
	end, { Size = UDim2.fromOffset(220, 52), Position = UDim2.new(1, -220, 0, 0), Visible = false, TextSize = 13, BackgroundColor3 = Color3.fromRGB(120, 30, 40) })

	self.nameBox = Kit.textbox(box, "", L.MapNamePlaceholder, nil, { Position = UDim2.fromOffset(0, if Kit.compact() then 200 else 140), Size = UDim2.new(1, 0, 0, Kit.TAP) })
	local listTop = if Kit.compact() then 252 else 192
	self.mapsTitle = Kit.label(box, L.MyMaps, { Font = Kit.FONT_BOLD, TextSize = 18, Position = UDim2.fromOffset(0, listTop), Size = UDim2.new(1, 0, 0, 26) })
	self.listTop = listTop + 32
	self.list = Kit.scroll(box, { Position = UDim2.fromOffset(0, listTop + 32), Size = UDim2.new(1, 0, 1, -(listTop + 32)) })
	Kit.list(self.list, 6)
	self:refresh()
	return self
end

function Menu:refresh()
	for _, c in self.list:GetChildren() do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
	Kit.label(self.list, L.Loading, { TextColor3 = Kit.C.dim })
	task.spawn(function()
		local res = Remotes.fn("Request"):InvokeServer("ListProjects")
		for _, c in self.list:GetChildren() do
			if c:IsA("GuiObject") then
				c:Destroy()
			end
		end
		if not res or not res.ok then
			-- ошибка загрузки показывается как ошибка, а не как пустой список
			Kit.label(self.list, H.LoadFailedHint, { TextColor3 = Kit.C.bad, Size = UDim2.new(1, 0, 0, 44) })
			return
		end
		if #res.projects == 0 then
			Kit.label(self.list, H.EmptyMaps, { TextColor3 = Kit.C.dim, Size = UDim2.new(1, 0, 0, 44) })
			return
		end
		self.mapsTitle.Text = L.MyMaps .. "   " .. string.format(L.SavesCount, #res.projects, 10)
		for i, p in res.projects do
			local sub = if p.publishCode then string.format(L.PublishedAs, p.publishCode) else nil
			local text = p.name
			if sub then
				text = p.name .. "\n" .. string.gsub(sub, "\n", " ")
			end
			local row = Kit.frame(self.list, { BackgroundTransparency = 1, LayoutOrder = i, Size = UDim2.new(1, -8, 0, 56) })
			Kit.button(row, text, function()
				self.app:openProject(p.id)
			end, { Size = UDim2.new(1, -62, 1, 0), TextXAlignment = Enum.TextXAlignment.Left })
			Kit.button(row, "✕", function()
				Kit.choose(self.gui, L.Delete .. "\n" .. p.name, {
					{ id = "yes", title = L.Delete },
					{ id = "no", title = L.Cancel },
				}, function(choice)
					if choice == "yes" then
						Remotes.fn("Request"):InvokeServer("DeleteProject", p.id)
						self:refresh()
					end
				end)
			end, { Size = UDim2.new(0, 56, 1, 0), Position = UDim2.new(1, -56, 0, 0), BackgroundColor3 = Kit.C.bad })
		end
	end)
end

function Menu:createMap(template: string?)
	local name = self.nameBox.Text
	if name == "" then
		name = if template == "demo" then L.DemoMapName else L.NewMap
	end
	local res = Remotes.fn("Request"):InvokeServer("CreateProject", name, template)
	if res and res.ok then
		self.app:openEditor(res.project, res.readOnly)
	elseif res and res.error == "name_taken" then
		Kit.toast(self.gui, H.NameTakenHint, Kit.C.bad, 4)
	elseif res and res.error == "too_many_projects" then
		Kit.toast(self.gui, H.TooManyHint, Kit.C.bad, 4)
	else
		Kit.toast(self.gui, H.LoadFailedHint, Kit.C.bad)
	end
end

function Menu:showCatalog()
	local res = Remotes.fn("Request"):InvokeServer("ListCatalog")
	if not res or not res.ok then
		Kit.toast(self.gui, H.LoadFailedHint, Kit.C.bad)
		return
	end
	local opts = {}
	for _, e in res.entries do
		table.insert(opts, { id = e.code, title = e.name, hint = e.code })
	end
	if #opts == 0 then
		Kit.toast(self.gui, L.NothingHere)
		return
	end
	Kit.choose(self.gui, L.Catalog, opts, function(code)
		self.app:joinByCode(code)
	end)
end

function Menu:enterCode()
	local shade = Kit.frame(self.gui, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.45, ZIndex = 40 })
	local w = math.min(380, Kit.viewport().X - 32)
	local box = Kit.frame(shade, { Size = UDim2.fromOffset(w, 200), Position = UDim2.new(0.5, -w / 2, 0.3, 0), ZIndex = 41 })
	Kit.corner(box, 12)
	Kit.pad(box, 12)
	Kit.label(box, L.EnterCode, { Font = Kit.FONT_BOLD, TextSize = 18, ZIndex = 42 })
	Kit.label(box, H.CodeHint, { TextColor3 = Kit.C.dim, TextSize = 13, Position = UDim2.fromOffset(0, 26), Size = UDim2.new(1, 0, 0, 36), ZIndex = 42 })
	local t = Kit.textbox(box, "", L.CodePlaceholder, nil, { Position = UDim2.fromOffset(0, 68), ZIndex = 42, TextXAlignment = Enum.TextXAlignment.Center, TextSize = 22 })
	Kit.button(box, L.Cancel, function()
		shade:Destroy()
	end, { Size = UDim2.new(0.5, -4, 0, Kit.TAP), Position = UDim2.new(0, 0, 1, -Kit.TAP), ZIndex = 42 })
	Kit.button(box, L.Play, function()
		local code = t.Text
		shade:Destroy()
		self.app:joinByCode(code)
	end, { Size = UDim2.new(0.5, -4, 0, Kit.TAP), Position = UDim2.new(0.5, 4, 1, -Kit.TAP), ZIndex = 42, BackgroundColor3 = Kit.C.accent })
end

function Menu:updateShowcase()
	local mode = self.app.mode or {}
	local sc = mode.showcase
	self.showcaseBanner.Visible = sc ~= nil and mode.creator == true
	self.mafiaShowcase.Visible = mode.creator == true and (sc == nil or sc.code ~= "MAFIA")
	local extra = if self.showcaseBanner.Visible then Kit.TAP * 2 + 42 else 0
	self.list.Size = UDim2.new(1, 0, 1, -(self.listTop + extra))
	if sc then
		self.showcaseTitle.Text = string.format(L.ShowcaseOnTitle, sc.name or sc.code)
	end
end

function Menu:showError(code: string?)
	Kit.toast(self.gui, ERRORS[code or ""] or H.LoadFailedHint, Kit.C.bad)
end

function Menu:setVisible(v: boolean)
	self.gui.Enabled = v
	if v then
		self:refresh()
		self:updateShowcase()
	end
end

return Menu
</ProtectedString>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
