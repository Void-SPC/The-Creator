        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="RBX00000038">
        <Properties>
          <string name="Name">Workshop</string>
        </Properties>
        <Item class="Folder" referent="RBX00000039">
