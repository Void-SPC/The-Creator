        <Item class="ModuleScript" referent="RBX0000001A">
          <Properties>
            <string name="Name">Ops</string>
            <ProtectedString name="Source">--!nonstrict
-- Операции правки проекта. Одна и та же функция применяется на клиенте (сразу)
-- и на сервере (с проверкой). Каждая операция возвращает обратную, на этом
-- построены отмена и повтор

local Util = require(script.Parent.Util)
local Format = require(script.Parent.Format)
local Ids = require(script.Parent.Ids)

local Ops = {}

local OBJECT_ROOTS = {
	name = true, latin = true, pos = true, rot = true, size = true, shape = true,
	color = true, material = true, texture = true, transparency = true, frozen = true,
	physics = true, role = true, label = true, model = true, hidden = true, textureTile = true,
}

local PROJECT_ROOTS = { settings = true, logic = true, meta = true }
local META_KEYS = { name = true }

local function getPath(root, path)
	local cur = root
	for i = 1, #path do
		if type(cur) ~= "table" then
			return nil
		end
		cur = cur[path[i]]
	end
	return cur
end

local function setPath(root, path, value): boolean
	local cur = root
	for i = 1, #path - 1 do
		local nxt = cur[path[i]]
		if type(nxt) ~= "table" then
			if value == nil then
				return true
			end
			nxt = {}
			cur[path[i]] = nxt
		end
		cur = nxt
	end
	cur[path[#path]] = Util.deepCopy(value)
	return true
end

local function validPath(path, maxDepth): boolean
	if type(path) ~= "table" or #path == 0 or #path &gt; maxDepth then
		return false
	end
	for _, k in path do
		local t = type(k)
		if t == "string" then
			if #k == 0 or #k &gt; 40 then
				return false
			end
		elseif t == "number" then
			if k ~= math.floor(k) or k &lt; 1 or k &gt; 10000 then
				return false
			end
		else
			return false
		end
	end
	return true
end

local applyOne

local function applyBatch(project, ops, opts)
	if type(ops) ~= "table" or #ops &gt; 500 then
		return false, "batch"
	end
	local inverses = {}
	for _, op in ops do
		local ok, res = applyOne(project, op, opts)
		if not ok then
			for i = #inverses, 1, -1 do
				applyOne(project, inverses[i], { validate = false })
			end
			return false, res
		end
		table.insert(inverses, res)
	end
	local rev = {}
	for i = #inverses, 1, -1 do
		table.insert(rev, inverses[i])
	end
	return true, { op = "batch", ops = rev }
end

function applyOne(project, op, opts): (boolean, any)
	opts = opts or {}
	local validate = opts.validate ~= false
	if type(op) ~= "table" then
		return false, "op"
	end
	local kind = op.op
	local objects = project.map.objects

	if kind == "batch" then
		return applyBatch(project, op.ops, opts)
	elseif kind == "add" then
		local obj = op.obj
		if type(obj) ~= "table" or type(obj.id) ~= "string" then
			return false, "add: object"
		end
		if objects[obj.id] then
			return false, "add: id exists"
		end
		if validate then
			local e = Format.validateObject(obj)
			if e then
				return false, e
			end
			if Util.count(objects) &gt;= Format.LIMITS.objects then
				return false, "limit: objects"
			end
			if obj.latin and Ids.latinTaken(project, obj.latin, obj.id) then
				return false, "latin taken"
			end
		end
		objects[obj.id] = Util.deepCopy(obj)
		-- счётчик ID не должен отставать от выданных клиентом ID
		local n = tonumber(string.match(obj.id, "_([0-9a-z]+)$") or "", 36)
		if n and n &gt;= (project.nextId or 1) then
			project.nextId = n + 1
		end
		return true, { op = "remove", id = obj.id }
	elseif kind == "remove" then
		local obj = objects[op.id]
		if not obj then
			return false, "remove: no object"
		end
		objects[op.id] = nil
		return true, { op = "add", obj = obj }
	elseif kind == "set" then
		local obj = objects[op.id]
		if not obj then
			return false, "set: no object"
		end
		if not validPath(op.path, 12) or not OBJECT_ROOTS[op.path[1]] then
			return false, "set: path"
		end
		local root = op.path[1]
		if validate and obj.frozen and (root == "pos" or root == "rot") then
			return false, "frozen"
		end
		local old = Util.deepCopy(getPath(obj, op.path))
		setPath(obj, op.path, op.value)
		if validate then
			local e = Format.validateObject(obj)
			if not e and root == "latin" and obj.latin and Ids.latinTaken(project, obj.latin, obj.id) then
				e = "latin taken"
			end
			if e then
				setPath(obj, op.path, old)
				return false, e
			end
		end
		return true, { op = "set", id = op.id, path = op.path, value = old }
	elseif kind == "setProject" then
		if not validPath(op.path, 12) or not PROJECT_ROOTS[op.path[1]] then
			return false, "setProject: path"
		end
		if op.path[1] == "meta" and not META_KEYS[op.path[2]] then
			return false, "setProject: meta"
		end
		local old = Util.deepCopy(getPath(project, op.path))
		setPath(project, op.path, op.value)
		if validate then
			local e = Format.validateSettings(project.settings)
			if not e and (type(project.meta.name) ~= "string" or #project.meta.name &gt; Format.LIMITS.nameLen * 4) then
				e = "meta.name"
			end
			if not e then
				local lg = project.logic
				if type(lg) ~= "table" or type(lg.text) ~= "table" or type(lg.text.source) ~= "string"
					or #lg.text.source &gt; Format.LIMITS.codeLen or type(lg.blocks) ~= "table"
					or (lg.mode ~= "blocks" and lg.mode ~= "text") then
					e = "logic"
				elseif Util.approxSize(lg) &gt; 400000 then
					e = "logic too large"
				end
			end
			if e then
				setPath(project, op.path, old)
				return false, e
			end
		end
		return true, { op = "setProject", path = op.path, value = old }
	end
	return false, "unknown op"
end

function Ops.apply(project, op, opts): (boolean, any)
	return applyOne(project, op, opts)
end

-- Стек отмены на клиенте
function Ops.newHistory(limit: number?)
	return { undo = {}, redo = {}, limit = limit or 100 }
end

function Ops.record(history, inverse, forward)
	table.insert(history.undo, { inverse = inverse, forward = forward })
	if #history.undo &gt; history.limit then
		table.remove(history.undo, 1)
	end
	table.clear(history.redo)
end

-- Возвращает операцию, которую нужно применить и отправить на сервер
function Ops.popUndo(history)
	local entry = table.remove(history.undo)
	if not entry then
		return nil
	end
	table.insert(history.redo, entry)
	return entry.inverse
end

function Ops.popRedo(history)
	local entry = table.remove(history.redo)
	if not entry then
		return nil
	end
	table.insert(history.undo, entry)
	return entry.forward
end

return Ops
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX0000001B">
          <Properties>
            <string name="Name">Prefabs</string>
            <ProtectedString name="Source">--!nonstrict
-- Каталог готовых моделей. Всё собирается из тех же фигур, что и в «Создателе моделей»,
-- поэтому любую готовую модель можно открыть и изменить теми же инструментами

local Format = require(script.Parent.Format)
local Ids = require(script.Parent.Ids)
local Anim = require(script.Parent.Anim)
local Closet = require(script.Parent.Closet)
local MathX = require(script.Parent.MathX)
local OfficeModels = require(script.Parent.OfficeModels)

local Prefabs = {}

local WOOD = { 124, 92, 70 }
local DARK_WOOD = { 86, 66, 54 }
local WALL = { 214, 205, 186 }
local FLOOR = { 105, 64, 40 }
local ORANGE = { 218, 133, 65 }
local WHITE = { 245, 245, 245 }
local BLACK = { 17, 17, 17 }
local SKIN = { 234, 184, 146 }

local function looseP(project, name, shape, size, pos, color, material)
	local p = Format.newPart(Ids.alloc(project, "o"), shape)
	p.name = name
	p.size = size
	p.pos = pos
	p.color = color
	p.material = material or "SmoothPlastic"
	return p
end

local function addPart(m, name, shape, size, pos, color, material, parent, pivot, rot)
	local pid = "p" .. tostring(m.model.nextPart)
	m.model.nextPart += 1
	m.model.parts[pid] = {
		id = pid,
		name = name,
		shape = shape,
		size = size,
		pos = pos,
		rot = rot or { 0, 0, 0 },
		color = color,
		material = material or "SmoothPlastic",
		texture = nil,
		transparency = 0,
		pivot = pivot or { 0, 0, 0 },
		parent = parent,
	}
	return pid
end

local function newModel(project, name, latinBase)
	local m = Format.newModel(Ids.alloc(project, "o"))
	m.name = name
	m.latin = Ids.suggestLatin(project, latinBase)
	return m
end

local function offsetAll(objs, origin)
	for _, o in objs do
		o.pos = MathX.add(o.pos, origin)
	end
	return objs
end

local function latin(project, objs, base)
	for _, o in objs do
		if not o.latin then
			o.latin = Ids.suggestLatin(project, base)
			-- имя должно быть занято сразу, иначе соседние детали получат одинаковые
			project.map.objects[o.id] = o
		end
	end
	for _, o in objs do
		project.map.objects[o.id] = nil
	end
end

-- Комната: пол, потолок и четыре стены; в передней стене проём под дверь
function Prefabs.room(project, w: number?, d: number?, h: number?)
	w, d, h = w or 20, d or 20, h or 10
	local W, D, H = w :: number, d :: number, h :: number
	local gap, gapH = 5, 8
	local side = (W - gap) / 2
	local objs = {
		looseP(project, "Пол", "Block", { W, 1, D }, { 0, 0.5, 0 }, FLOOR, "WoodPlanks"),
		looseP(project, "Потолок", "Block", { W, 1, D }, { 0, H + 1.5, 0 }, WALL, "SmoothPlastic"),
		looseP(project, "Стена сзади", "Block", { W, H, 1 }, { 0, H / 2 + 1, D / 2 - 0.5 }, WALL, "Concrete"),
		looseP(project, "Стена слева", "Block", { 1, H, D - 2 }, { -W / 2 + 0.5, H / 2 + 1, 0 }, WALL, "Concrete"),
		looseP(project, "Стена справа", "Block", { 1, H, D - 2 }, { W / 2 - 0.5, H / 2 + 1, 0 }, WALL, "Concrete"),
		looseP(project, "Стена у двери", "Block", { side, H, 1 }, { -(gap + side) / 2, H / 2 + 1, -D / 2 + 0.5 }, WALL, "Concrete"),
		looseP(project, "Стена у двери", "Block", { side, H, 1 }, { (gap + side) / 2, H / 2 + 1, -D / 2 + 0.5 }, WALL, "Concrete"),
		looseP(project, "Над проёмом", "Block", { gap, H - gapH, 1 }, { 0, gapH + (H - gapH) / 2 + 1, -D / 2 + 0.5 }, WALL, "Concrete"),
	}
	latin(project, objs, "Wall")
	return objs
end

-- Платформа под постройки: большая плита на уровне пола, заморожена от случайного сдвига
function Prefabs.baseplate(project)
	local p = looseP(project, "Платформа", "Block", { 256, 1, 256 }, { 0, 0.5, 0 }, { 99, 95, 98 }, "Plastic")
	p.latin = "Baseplate"
	p.frozen = true
	return { p }
end

-- Статуя на ступенчатом постаменте. В редакторе фигура — каменная заготовка,
-- в игре на её месте появляется каменная копия аватара Roblox в выбранной позе
function Prefabs.statue(project, username: string?)
	local stone = { 196, 194, 190 }
	local base = newModel(project, "Постамент", "Pedestal")
	addPart(base, "Нижняя ступень", "Block", { 9, 1, 9 }, { 0, 0.5, 0 }, stone, "Marble")
	addPart(base, "Средняя ступень", "Block", { 7, 1, 7 }, { 0, 1.5, 0 }, stone, "Marble")
	addPart(base, "Тумба", "Block", { 4.6, 2, 4.6 }, { 0, 3, 0 }, stone, "Marble")
	addPart(base, "Карниз", "Block", { 5.2, 0.4, 5.2 }, { 0, 4.2, 0 }, stone, "Marble")
	base.frozen = true
	local fig = looseP(project, "Статуя", "Block", { 2, 5.4, 1.2 }, { 0, 4.4 + 2.7, 0 }, stone, "Marble")
	fig.latin = Ids.suggestLatin(project, "Statue")
	fig.role = { type = "statue", username = username or "Nataliaavira13", pose = "admire", orb = true }
	return { base, fig }
end

-- Деревянные перила длиной length вдоль оси X: стойки, поручень и средняя перекладина
function Prefabs.railing(project, length: number?)
	local len = length or 16
	local wood = { 124, 92, 70 }
	local m = newModel(project, "Перила", "Railing")
	local posts = math.max(2, math.floor(len / 3) + 1)
	for i = 0, posts - 1 do
		local x = -len / 2 + i * (len / (posts - 1))
		addPart(m, "Стойка", "Block", { 0.35, 3.2, 0.35 }, { x, 1.6, 0 }, { 86, 66, 54 }, "Wood")
	end
	addPart(m, "Поручень", "Block", { len + 0.4, 0.3, 0.5 }, { 0, 3.3, 0 }, wood, "Wood")
	addPart(m, "Перекладина", "Block", { len, 0.2, 0.2 }, { 0, 1.7, 0 }, wood, "Wood")
	return { m }
end

-- Рабочее место: стол, стул и настольная лампа
function Prefabs.desk(project)
	local m = newModel(project, "Рабочее место", "Desk")
	addPart(m, "Столешница", "Block", { 6, 0.3, 3.2 }, { 0, 3.1, 0 }, { 230, 225, 215 }, "Wood")
	for _, xz in { { -2.7, -1.3 }, { 2.7, -1.3 }, { -2.7, 1.3 }, { 2.7, 1.3 } } do
		addPart(m, "Ножка", "Block", { 0.25, 3, 0.25 }, { xz[1], 1.5, xz[2] }, { 60, 60, 66 }, "Metal")
	end
	addPart(m, "Монитор", "Block", { 2.4, 1.5, 0.15 }, { 0, 4.1, 0.9 }, { 27, 31, 39 }, "SmoothPlastic")
	addPart(m, "Экран", "Block", { 2.2, 1.3, 0.05 }, { 0, 4.1, 0.81 }, { 110, 170, 220 }, "Neon")
	addPart(m, "Подставка", "Block", { 0.3, 0.6, 0.3 }, { 0, 3.5, 0.95 }, { 27, 31, 39 }, "Metal")
	addPart(m, "Клавиатура", "Block", { 1.8, 0.1, 0.6 }, { 0, 3.3, -0.3 }, { 50, 50, 56 }, "SmoothPlastic")
	addPart(m, "Сиденье", "Block", { 1.8, 0.3, 1.8 }, { 0, 2, -2.4 }, { 40, 44, 56 }, "Fabric")
	addPart(m, "Спинка", "Block", { 1.8, 2, 0.25 }, { 0, 3.2, -3.25 }, { 40, 44, 56 }, "Fabric")
	addPart(m, "Ножка стула", "Cylinder", { 1.8, 0.3, 0.3 }, { 0, 1, -2.4 }, { 60, 60, 66 }, "Metal", nil, nil, { 0, 0, 90 })
	return { m }
end

function Prefabs.corridor(project)
	local objs = {
		looseP(project, "Пол коридора", "Block", { 8, 1, 24 }, { 0, 0.5, 0 }, FLOOR, "WoodPlanks"),
		looseP(project, "Потолок коридора", "Block", { 8, 1, 24 }, { 0, 11.5, 0 }, WALL),
		looseP(project, "Стена коридора", "Block", { 1, 10, 24 }, { -4.5, 6, 0 }, WALL, "Concrete"),
		looseP(project, "Стена коридора", "Block", { 1, 10, 24 }, { 4.5, 6, 0 }, WALL, "Concrete"),
	}
	latin(project, objs, "Corridor")
	return objs
end

function Prefabs.floorAbove(project)
	local objs = Prefabs.room(project, 20, 20, 10)
	for _, o in objs do
		o.pos = MathX.add(o.pos, { 0, 12, 0 })
	end
	return objs
end

function Prefabs.wall(project)
	local p = looseP(project, "Стена", "Block", { 12, 10, 1 }, { 0, 5, 0 }, WALL, "Concrete")
	p.latin = Ids.suggestLatin(project, "Wall")
	return { p }
end

function Prefabs.stairs(project)
	local m = newModel(project, "Лестница", "Stairs")
	for i = 1, 10 do
		addPart(m, "Ступень " .. i, "Block", { 4, 1.2, 1.4 }, { 0, (i - 1) * 1.2 + 0.6, (i - 1) * 1.4 }, DARK_WOOD, "Wood")
	end
	return { m }
end

function Prefabs.door(project)
	local p = looseP(project, "Дверь", "Block", { 4.8, 7.8, 0.4 }, { 0, 4.9, 0 }, DARK_WOOD, "Wood")
	p.latin = Ids.suggestLatin(project, "Door")
	p.role = { type = "door", open = false, openAngle = 95, openTime = 0.6, hinge = { -2.4, 0, 0 }, locked = false }
	return { p }
end

function Prefabs.lamp(project)
	local p = looseP(project, "Лампа", "Ball", { 1.2, 1.2, 1.2 }, { 0, 9, 0 }, { 255, 230, 180 }, "Neon")
	p.latin = Ids.suggestLatin(project, "Lamp")
	p.physics.canCollide = false
	p.role = { type = "light", on = true, brightness = 3, range = 24, color = { 255, 214, 170 } }
	return { p }
end

function Prefabs.closet(project)
	local m = newModel(project, "Шкаф", "Closet")
	addPart(m, "Задняя стенка", "Block", { 4, 7, 0.3 }, { 0, 3.5, 1.35 }, DARK_WOOD, "Wood")
	addPart(m, "Бок", "Block", { 0.3, 7, 3 }, { -1.85, 3.5, 0 }, DARK_WOOD, "Wood")
	addPart(m, "Бок", "Block", { 0.3, 7, 3 }, { 1.85, 3.5, 0 }, DARK_WOOD, "Wood")
	addPart(m, "Крыша", "Block", { 4, 0.3, 3 }, { 0, 7.15, 0 }, DARK_WOOD, "Wood")
	addPart(m, "Дно", "Block", { 4, 0.3, 3 }, { 0, 0.15, 0 }, DARK_WOOD, "Wood")
	local dl = addPart(m, "Дверца", "Block", { 1.75, 6.6, 0.2 }, { -0.9, 3.6, -1.4 }, WOOD, "Wood", nil, { -0.875, 0, 0 })
	local dr = addPart(m, "Дверца", "Block", { 1.75, 6.6, 0.2 }, { 0.9, 3.6, -1.4 }, WOOD, "Wood", nil, { 0.875, 0, 0 })
	m.model.parts[dl].transparency = 0.35
	m.model.parts[dr].transparency = 0.35
	m.role = Closet.newRole(3)
	-- клип модели: дверцы приоткрываются, его можно запускать из логики
	local open = Format.newClip(Ids.alloc(project, "c"), "Дверцы")
	open.length = 0.5
	Anim.setKey(open, dl, 0, { 0, 0, 0 }, { 0, 0, 0 })
	Anim.setKey(open, dl, 0.25, { 0, 0, 0 }, { 0, 70, 0 })
	Anim.setKey(open, dl, 0.5, { 0, 0, 0 }, { 0, 0, 0 })
	Anim.setKey(open, dr, 0, { 0, 0, 0 }, { 0, 0, 0 })
	Anim.setKey(open, dr, 0.25, { 0, 0, 0 }, { 0, -70, 0 })
	Anim.setKey(open, dr, 0.5, { 0, 0, 0 }, { 0, 0, 0 })
	m.model.clips[open.id] = open
	return { m }
end

function Prefabs.bookshelf(project)
	local m = newModel(project, "Книжный шкаф", "Bookshelf")
	addPart(m, "Каркас", "Block", { 6, 8, 0.3 }, { 0, 4, 0.85 }, DARK_WOOD, "Wood")
	addPart(m, "Бок", "Block", { 0.3, 8, 2 }, { -2.85, 4, 0 }, DARK_WOOD, "Wood")
	addPart(m, "Бок", "Block", { 0.3, 8, 2 }, { 2.85, 4, 0 }, DARK_WOOD, "Wood")
	local colors = { { 196, 40, 28 }, { 13, 105, 172 }, { 75, 151, 75 }, { 245, 205, 48 }, { 107, 50, 124 } }
	for shelf = 0, 3 do
		addPart(m, "Полка", "Block", { 5.4, 0.25, 1.8 }, { 0, 0.15 + shelf * 2.4, 0 }, WOOD, "Wood")
		if shelf &lt; 3 then
			for b = 0, 6 do
				local h = 1.2 + (b % 3) * 0.25
				addPart(m, "Книга", "Block", { 0.55, h, 1.3 }, { -2.2 + b * 0.72, 0.3 + shelf * 2.4 + h / 2, 0.1 }, colors[(b + shelf) % 5 + 1])
			end
		end
	end
	return { m }
end

function Prefabs.table(project)
	local m = newModel(project, "Стол", "Table")
	addPart(m, "Столешница", "Block", { 6, 0.4, 3.5 }, { 0, 3.2, 0 }, WOOD, "Wood")
	for _, xz in { { -2.7, -1.5 }, { 2.7, -1.5 }, { -2.7, 1.5 }, { 2.7, 1.5 } } do
		addPart(m, "Ножка", "Block", { 0.4, 3, 0.4 }, { xz[1], 1.5, xz[2] }, DARK_WOOD, "Wood")
	end
	return { m }
end

function Prefabs.chair(project)
	local m = newModel(project, "Стул", "Chair")
	addPart(m, "Сиденье", "Block", { 2, 0.3, 2 }, { 0, 2, 0 }, WOOD, "Wood")
	addPart(m, "Спинка", "Block", { 2, 2.4, 0.3 }, { 0, 3.3, 0.85 }, WOOD, "Wood")
	for _, xz in { { -0.8, -0.8 }, { 0.8, -0.8 }, { -0.8, 0.8 }, { 0.8, 0.8 } } do
		addPart(m, "Ножка", "Block", { 0.3, 2, 0.3 }, { xz[1], 1, xz[2] }, DARK_WOOD, "Wood")
	end
	return { m }
end

function Prefabs.bed(project)
	local m = newModel(project, "Кровать", "Bed")
	addPart(m, "Рама", "Block", { 5, 1, 8 }, { 0, 1, 0 }, DARK_WOOD, "Wood")
	addPart(m, "Матрас", "Block", { 4.6, 0.8, 7.6 }, { 0, 1.9, 0 }, WHITE, "Fabric")
	addPart(m, "Подушка", "Block", { 3, 0.5, 1.4 }, { 0, 2.5, 3 }, { 175, 221, 255 }, "Fabric")
	addPart(m, "Изголовье", "Block", { 5, 3, 0.4 }, { 0, 2.5, 4.1 }, DARK_WOOD, "Wood")
	return { m }
end

function Prefabs.sign(project)
	local p = looseP(project, "Табличка", "Block", { 4, 2, 0.2 }, { 0, 5, 0 }, WOOD, "Wood")
	p.latin = Ids.suggestLatin(project, "Sign")
	p.label = { text = "Надпись", mode = "surface", face = "Front", size = 24, wrap = true, color = BLACK, visible = true }
	return { p }
end

function Prefabs.spawn(project)
	local p = looseP(project, "Старт игрока", "Block", { 4, 0.4, 4 }, { 0, 1.2, 0 }, { 75, 151, 75 }, "Neon")
	p.latin = Ids.suggestLatin(project, "Spawn")
	p.transparency = 0.5
	p.physics.canCollide = false
	p.role = { type = "spawn" }
	return { p }
end

function Prefabs.zone(project)
	local p = looseP(project, "Зона", "Block", { 10, 8, 10 }, { 0, 5, 0 }, { 13, 105, 172 }, "Neon")
	p.latin = Ids.suggestLatin(project, "Zone")
	p.transparency = 0.8
	p.physics.canCollide = false
	p.role = { type = "zone" }
	return { p }
end

function Prefabs.waypoint(project)
	local p = looseP(project, "Точка", "Ball", { 1.2, 1.2, 1.2 }, { 0, 1.6, 0 }, { 75, 200, 75 }, "Neon")
	p.latin = Ids.suggestLatin(project, "Point")
	p.transparency = 0.3
	p.physics.canCollide = false
	p.role = { type = "waypoint" }
	return { p }
end

-- Человекоподобные NPC: «Новый» (сегменты рук и ног) и «Ретро» (цельные блоки)
local function humanoidClips(project, m, parts)
	local wave = Format.newClip(Ids.alloc(project, "c"), "Приветствие")
	wave.length = 1.6
	Anim.setKey(wave, parts.rArm, 0, { 0, 0, 0 }, { 0, 0, 0 })
	Anim.setKey(wave, parts.rArm, 0.4, { 0, 0, 0 }, { 0, 0, 160 })
	Anim.setKey(wave, parts.rArm, 0.8, { 0, 0, 0 }, { 0, 0, 130 })
	Anim.setKey(wave, parts.rArm, 1.2, { 0, 0, 0 }, { 0, 0, 160 })
	Anim.setKey(wave, parts.rArm, 1.6, { 0, 0, 0 }, { 0, 0, 0 })
	Anim.setKey(wave, parts.head, 0, { 0, 0, 0 }, { 0, 0, 0 })
	Anim.setKey(wave, parts.head, 0.8, { 0, 0, 0 }, { -10, 0, 8 })
	Anim.setKey(wave, parts.head, 1.6, { 0, 0, 0 }, { 0, 0, 0 })
	m.model.clips[wave.id] = wave

	local walk = Format.newClip(Ids.alloc(project, "c"), "Ходьба")
	walk.length = 1
	walk.loop = true
	for _, t in { 0, 0.5, 1 } do
		local s = if t == 0.5 then -1 else 1
		Anim.setKey(walk, parts.lLeg, t, { 0, 0, 0 }, { 30 * s, 0, 0 })
		Anim.setKey(walk, parts.rLeg, t, { 0, 0, 0 }, { -30 * s, 0, 0 })
		Anim.setKey(walk, parts.lArm, t, { 0, 0, 0 }, { -25 * s, 0, 0 })
		Anim.setKey(walk, parts.rArm, t, { 0, 0, 0 }, { 25 * s, 0, 0 })
	end
	m.model.clips[walk.id] = walk
end

function Prefabs.npcNew(project)
