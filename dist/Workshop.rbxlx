	},
	GiveCoins = { title = "Дать монеты", args = { arg("coins", "number", "Монеты", { min = 1, max = 100000 }) } },
	TakeCoins = { title = "Забрать монеты", args = { arg("coins", "number", "Монеты", { min = 1, max = 100000 }) } },
	AddScore = { title = "Добавить очки", args = { arg("amount", "number", "Очки", { min = -100000, max = 100000 }) } },
	SetTime = {
		title = "Установить время суток",
		args = { arg("hours", "number", "Часы, 0–24", { min = 0, max = 24 }) },
	},
	PlayCutscene = {
		title = "Кат-сцена камеры",
		args = { arg("model", "model", "Модель"), arg("clip", "clip", "Клип с дорожкой камеры") },
	},
	SetVisible = {
		title = "Показать или скрыть объект",
		args = { arg("target", "any", "Объект"), arg("visible", "bool", "Виден") },
	},
}

-- Какие роли подходят под тип аргумента
Commands.TARGET_TYPES = {
	door = function(obj)
		return obj.role ~= nil and obj.role.type == "door"
	end,
	light = function(obj)
		return obj.role ~= nil and obj.role.type == "light"
	end,
	zone = function(obj)
		return obj.role ~= nil and obj.role.type == "zone"
	end,
	closet = function(obj)
		return obj.role ~= nil and obj.role.type == "closet"
	end,
	waypoint = function(obj)
		return obj.role ~= nil and obj.role.type == "waypoint"
	end,
	model = function(obj)
		return obj.kind == "model"
	end,
	any = function(_obj)
		return true
	end,
}

Commands.WEATHER_TITLES = { Clear = "Ясно", Rain = "Дождь", Snow = "Снег", Fog = "Туман", Storm = "Гроза" }

function Commands.lookup(category: string, name: string)
	local t = (Commands :: any)[category]
	return t and t[name]
end

function Commands.minArgs(def): number
	local n = 0
	for i, a in def.args do
		if not a.optional then
			n = i
		end
	end
	return n
end

return Commands
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00000011">
            <Properties>
              <string name="Name">Interpreter</string>
              <ProtectedString name="Source">--!nonstrict
-- Исполнитель логики карты. Работает только с деревом, которое прошло Validator,
-- и только через команды хоста (сервер реализует их для объектов текущей карты)
-- Каждый запуск обработчика — отдельный поток с лимитом операций и времени жизни

local Interpreter = {}

Interpreter.DEFAULT_LIMITS = {
	opsPerRun = 5000, -- операций на один запуск обработчика
	opsPerSecond = 40000, -- операций всех потоков за секунду
	threads = 32, -- одновременно живущих потоков
	runSeconds = 300, -- максимальное время жизни потока
	maxWait = 60, -- максимальная пауза одной командой Wait
	forIterations = 1000,
}

local RuntimeError = {}
RuntimeError.__index = RuntimeError

local function rtError(node, msg: string)
	error(setmetatable({ line = node and node.line, bid = node and node.bid, message = msg }, RuntimeError), 0)
end

local function sameValue(a, b): boolean
	if type(a) == "table" and type(b) == "table" then
		return a.ref == b.ref
	end
	return a == b
end

function Interpreter.new(tree, host, limits)
	local L = {}
	for k, v in Interpreter.DEFAULT_LIMITS do
		L[k] = (limits and limits[k]) or v
	end
	local rt = {
		tree = tree,
		host = host,
		limits = L,
		threads = {},
		secondStart = 0,
		secondOps = 0,
		stopped = false,
	}

	local function chargeGlobal(node)
		local now = host.now()
		if now - rt.secondStart &gt;= 1 then
			rt.secondStart = now
			rt.secondOps = 0
		end
		rt.secondOps += 1
		if rt.secondOps &gt; L.opsPerSecond then
			rtError(node, "логика выполняет слишком много операций в секунду")
		end
	end

	local function run(thread, handler, eventArgs)
		local env: { [string]: any } = {}
		local function charge(node)
			thread.ops += 1
			if thread.ops &gt; L.opsPerRun then
				rtError(node, "превышен лимит операций сценария")
			end
			chargeGlobal(node)
		end

		local eval
		local function evalArgs(owner, list)
			local out = table.create(#list)
			for i, a in list do
				out[i] = eval(owner, a)
			end
			return out
		end
		function eval(owner, e)
			charge(owner)
			local k = e.kind
			if k == "num" or k == "str" or k == "bool" then
				return e.value
			elseif k == "ref" then
				return { ref = e.ref }
			elseif k == "var" then
				local v = env[e.name]
				if v == nil then
					rtError(owner, "переменная «" .. e.name .. "» не задана")
				end
				return v
			elseif k == "cond" then
				local ok, res = pcall(host.condition, e.name, evalArgs(owner, e.args), eventArgs)
				if not ok then
					rtError(owner, tostring(res))
				end
				return res == true
			elseif k == "not" then
				return not eval(owner, e.e)
			elseif k == "neg" then
				local v = eval(owner, e.e)
				if type(v) ~= "number" then
					rtError(owner, "минус применим только к числу")
				end
				return -v
			elseif k == "bin" then
				local op = e.op
				if op == "and" then
					return eval(owner, e.a) and eval(owner, e.b)
				elseif op == "or" then
					return eval(owner, e.a) or eval(owner, e.b)
				end
				local a, b = eval(owner, e.a), eval(owner, e.b)
				if op == "==" then
					return sameValue(a, b)
				elseif op == "~=" then
					return not sameValue(a, b)
				end
				if type(a) ~= "number" or type(b) ~= "number" then
					rtError(owner, "операция «" .. op .. "» работает только с числами")
				end
				if op == "+" then
					return a + b
				elseif op == "-" then
					return a - b
				elseif op == "*" then
					return a * b
				elseif op == "/" then
					if b == 0 then
						rtError(owner, "деление на ноль")
					end
					return a / b
				elseif op == "&lt;" then
					return a &lt; b
				elseif op == "&gt;" then
					return a &gt; b
				elseif op == "&lt;=" then
					return a &lt;= b
				elseif op == "&gt;=" then
					return a &gt;= b
				end
			end
			rtError(owner, "неизвестное выражение")
			return nil
		end

		local exec
		function exec(body)
			for _, st in body do
				if rt.stopped or thread.dead then
					return
				end
				charge(st)
				local k = st.kind
				if k == "call" then
					local args = evalArgs(st, st.args)
					if st.name == "Wait" then
						local s = args[1]
						if type(s) ~= "number" then
							rtError(st, "Wait ждёт число секунд")
						end
						s = math.clamp(s, 0, L.maxWait)
						thread.wakeAt = host.now() + s
						thread.node = st
						coroutine.yield()
						if host.now() - thread.startedAt &gt; L.runSeconds then
							rtError(st, "сценарий работает слишком долго")
						end
					else
						local ok, res = pcall(host.action, st.name, args, st, eventArgs)
						if not ok then
							if getmetatable(res :: any) == RuntimeError then
								error(res, 0)
							end
							rtError(st, tostring(res))
						end
					end
				elseif k == "if" then
					local done = false
					for _, br in st.branches do
						if eval(st, br.cond) then
							exec(br.body)
							done = true
							break
						end
					end
					if not done and st.elseBody then
						exec(st.elseBody)
					end
				elseif k == "for" then
					local from, to = eval(st, st.from), eval(st, st.to)
					if type(from) ~= "number" or type(to) ~= "number" then
						rtError(st, "границы цикла должны быть числами")
					end
					if to - from + 1 &gt; L.forIterations then
						rtError(st, "слишком много повторов в цикле")
					end
					for i = math.floor(from), math.floor(to) do
						env[st.var] = i
						exec(st.body)
					end
				elseif k == "local" or k == "assign" then
					env[st.name] = eval(st, st.value)
				end
			end
		end
		exec(handler.body)
	end

	local function startThread(handler, eventArgs)
		local alive = 0
		for _, t in rt.threads do
			if not t.dead then
				alive += 1
			end
		end
		if alive &gt;= L.threads then
			host.onError({ line = handler.line, bid = handler.bid, message = "слишком много одновременно работающих сценариев" })
			return
		end
		local thread = { ops = 0, startedAt = host.now(), wakeAt = nil, dead = false, handler = handler, node = nil }
		thread.co = coroutine.create(function()
			run(thread, handler, eventArgs)
		end)
		table.insert(rt.threads, thread)
		rt.resume(thread)
	end

	function rt.resume(thread)
		thread.wakeAt = nil
		local ok, res = coroutine.resume(thread.co)
		if not ok then
			thread.dead = true
			if getmetatable(res :: any) == RuntimeError then
				host.onError(res)
			else
				host.onError({ line = thread.handler.line, bid = thread.handler.bid, message = "внутренняя ошибка: " .. tostring(res) })
			end
		elseif coroutine.status(thread.co) == "dead" then
			thread.dead = true
		end
	end

	function rt.dispatch(event: string, args: { any })
		if rt.stopped then
			return 0
		end
		local started = 0
		for _, h in rt.tree.handlers do
			if h.event == event then
				local match = true
				for i, a in h.args do
					local v = args[i]
					if a.kind == "ref" then
						if type(v) ~= "table" or v.ref ~= a.ref then
							match = false
							break
						end
					elseif a.kind == "str" or a.kind == "num" then
						if v ~= a.value then
							match = false
							break
						end
					end
				end
				if match then
					started += 1
					startThread(h, args)
				end
			end
		end
		return started
	end

	function rt.update()
		if rt.stopped then
			return
		end
		local now = host.now()
		local i = 1
		while i &lt;= #rt.threads do
			local t = rt.threads[i]
			if t.dead then
				table.remove(rt.threads, i)
			else
				if t.wakeAt and now &gt;= t.wakeAt then
					rt.resume(t)
				end
				i += 1
			end
		end
	end

	function rt.stop()
		rt.stopped = true
		for _, t in rt.threads do
			t.dead = true
		end
		table.clear(rt.threads)
	end

	function rt.activeCount(): number
		local n = 0
		for _, t in rt.threads do
			if not t.dead then
				n += 1
			end
		end
		return n
	end

	return rt
end

return Interpreter
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00000012">
            <Properties>
              <string name="Name">Parser</string>
              <ProtectedString name="Source">--!nonstrict
-- Разбор текстового режима логики карты. Синтаксис похож на Luau:
--
--   on DoorOpened(FrontDoor) do
--     PlayClip(Fox, "Появление")
--     Wait(1.5)
--     if LightIsOn(HallLamp) then
--       SetLight(HallLamp, false)
--     end
--   end
--
-- Результат: то же дерево, которое редактирует блочный режим

local Parser = {}

local KEYWORDS = {
	on = true, ["do"] = true, ["end"] = true, ["if"] = true, ["then"] = true,
	["elseif"] = true, ["else"] = true, ["for"] = true, ["local"] = true,
	["not"] = true, ["and"] = true, ["or"] = true, ["true"] = true, ["false"] = true,
}

Parser.KEYWORDS = KEYWORDS

local function err(line: number, col: number, msg: string)
	return { line = line, col = col, message = msg }
end

function Parser.lex(src: string)
	local tokens = {}
	local i, n = 1, #src
	local line, lineStart = 1, 1
	while i &lt;= n do
		local c = string.sub(src, i, i)
		local col = i - lineStart + 1
		if c == "\n" then
			line += 1
			i += 1
			lineStart = i
		elseif c == " " or c == "\t" or c == "\r" then
			i += 1
		elseif string.sub(src, i, i + 1) == "--" then
			local e = string.find(src, "\n", i, true)
			i = if e then e else n + 1
		elseif string.match(c, "[%a_]") then
			local s, e = string.find(src, "^[%w_]+", i)
			local word = string.sub(src, s :: number, e :: number)
			table.insert(tokens, {
				t = if KEYWORDS[word] then word else "name",
				v = word, line = line, col = col, s = s, e = e,
			})
			i = (e :: number) + 1
		elseif string.match(c, "%d") or (c == "." and string.match(string.sub(src, i + 1, i + 1), "%d")) then
			local s, e = string.find(src, "^%d*%.?%d+", i)
			if not s then
				s, e = string.find(src, "^%d+", i)
			end
			local text = string.sub(src, s :: number, e :: number)
			table.insert(tokens, { t = "number", v = tonumber(text), line = line, col = col, s = s, e = e })
			i = (e :: number) + 1
		elseif c == '"' or c == "'" then
			local q = c
			local j = i + 1
			local buf = {}
			local closed = false
			while j &lt;= n do
				local d = string.sub(src, j, j)
				if d == "\\" then
					local nx = string.sub(src, j + 1, j + 1)
					if nx == "n" then
						table.insert(buf, "\n")
					elseif nx == "t" then
						table.insert(buf, "\t")
					else
						table.insert(buf, nx)
					end
					j += 2
				elseif d == q then
					closed = true
					break
				elseif d == "\n" then
					break
				else
					table.insert(buf, d)
					j += 1
				end
			end
			if not closed then
				return nil, err(line, col, "строка не закрыта кавычкой")
			end
			table.insert(tokens, { t = "string", v = table.concat(buf), line = line, col = col, s = i, e = j })
			i = j + 1
		else
			local two = string.sub(src, i, i + 1)
			if two == "==" or two == "~=" or two == "&lt;=" or two == "&gt;=" then
				table.insert(tokens, { t = two, v = two, line = line, col = col, s = i, e = i + 1 })
				i += 2
			elseif string.find("(),=&lt;&gt;+-*/", c, 1, true) then
				table.insert(tokens, { t = c, v = c, line = line, col = col, s = i, e = i })
				i += 1
			else
				return nil, err(line, col, "непонятный символ «" .. c .. "»")
			end
		end
	end
	table.insert(tokens, { t = "eof", v = "", line = line, col = 1, s = n + 1, e = n + 1 })
	return tokens, nil
end

-- resolveName(name) -&gt; id или nil. Имена локальных переменных разрешаются раньше
function Parser.parse(src: string, resolveName: (string) -&gt; string?)
	local tokens, lexErr = Parser.lex(src)
	if not tokens then
		return nil, { lexErr }
	end
	local pos = 1
	local nextBid = 0
	local errors = {}
	local scopes: { { [string]: boolean } } = {}

	local function bid()
		nextBid += 1
		return "t" .. tostring(nextBid)
	end
	local function peek()
		return tokens[pos]
	end
	local function advance()
		local t = tokens[pos]
		pos += 1
		return t
	end
	local function fail(tok, msg)
		error({ parseError = err(tok.line, tok.col, msg) }, 0)
	end
	local function expect(t: string, what: string?)
		local tok = peek()
		if tok.t ~= t then
			fail(tok, "ожидалось «" .. (what or t) .. "», найдено «" .. (if tok.t == "eof" then "конец текста" else tostring(tok.v)) .. "»")
		end
		return advance()
	end
	local function isLocal(name: string)
		for i = #scopes, 1, -1 do
			if scopes[i][name] then
				return true
			end
		end
		return false
	end

	local parseExpr

	local function parseArgs()
		expect("(")
		local args = {}
		if peek().t ~= ")" then
			table.insert(args, parseExpr())
			while peek().t == "," do
				advance()
				table.insert(args, parseExpr())
			end
		end
		expect(")")
		return args
	end

	local function parsePrimary()
		local tok = peek()
		if tok.t == "number" then
			advance()
			return { kind = "num", value = tok.v, line = tok.line }
		elseif tok.t == "string" then
			advance()
			return { kind = "str", value = tok.v, line = tok.line }
		elseif tok.t == "true" or tok.t == "false" then
			advance()
			return { kind = "bool", value = tok.t == "true", line = tok.line }
		elseif tok.t == "(" then
			advance()
			local e = parseExpr()
			expect(")")
			return e
		elseif tok.t == "name" then
			advance()
			if peek().t == "(" then
				local args = parseArgs()
				return { kind = "cond", name = tok.v, args = args, line = tok.line }
			end
			if isLocal(tok.v) then
				return { kind = "var", name = tok.v, line = tok.line }
			end
			local id = resolveName(tok.v)
			if not id then
				table.insert(errors, err(tok.line, tok.col, "на карте нет объекта «" .. tok.v .. "»"))
				return { kind = "ref", ref = "", name = tok.v, line = tok.line }
			end
			return { kind = "ref", ref = id, name = tok.v, line = tok.line }
		end
		fail(tok, "ожидалось значение")
		return nil
	end

	local function parseUnary()
		local tok = peek()
		if tok.t == "not" then
			advance()
			return { kind = "not", e = parseUnary(), line = tok.line }
		elseif tok.t == "-" then
			advance()
			return { kind = "neg", e = parseUnary(), line = tok.line }
		end
		return parsePrimary()
	end

	local PREC = {
		["or"] = 1, ["and"] = 2,
		["=="] = 3, ["~="] = 3, ["&lt;"] = 3, ["&gt;"] = 3, ["&lt;="] = 3, ["&gt;="] = 3,
		["+"] = 4, ["-"] = 4, ["*"] = 5, ["/"] = 5,
	}

	local function parseBin(minPrec: number)
		local left = parseUnary()
		while true do
			local tok = peek()
			local p = PREC[tok.t]
			if not p or p &lt; minPrec then
				break
			end
			advance()
			local right = parseBin(p + 1)
			left = { kind = "bin", op = tok.t, a = left, b = right, line = tok.line }
		end
		return left
	end

	function parseExpr()
		return parseBin(1)
	end

	local parseBlock

	local function parseStatement()
		local tok = peek()
		if tok.t == "if" then
			advance()
			local node = { kind = "if", branches = {}, elseBody = nil, line = tok.line, bid = bid() }
			local cond = parseExpr()
			expect("then")
			table.insert(node.branches, { cond = cond, body = parseBlock() })
			while peek().t == "elseif" do
				advance()
				local c = parseExpr()
				expect("then")
				table.insert(node.branches, { cond = c, body = parseBlock() })
			end
			if peek().t == "else" then
				advance()
				node.elseBody = parseBlock()
			end
			expect("end")
			return node
		elseif tok.t == "for" then
			advance()
			local var = expect("name", "имя переменной")
			expect("=")
			local from = parseExpr()
			expect(",")
			local to = parseExpr()
			expect("do")
			table.insert(scopes, { [var.v] = true })
			local body = parseBlock()
			table.remove(scopes)
			expect("end")
			return { kind = "for", var = var.v, from = from, to = to, body = body, line = tok.line, bid = bid() }
		elseif tok.t == "local" then
			advance()
			local name = expect("name", "имя переменной")
			expect("=")
			local value = parseExpr()
			scopes[#scopes][name.v] = true
			return { kind = "local", name = name.v, value = value, line = tok.line, bid = bid() }
		elseif tok.t == "name" then
			advance()
			if peek().t == "=" then
				advance()
				if not isLocal(tok.v) then
					fail(tok, "переменная «" .. tok.v .. "» не объявлена через local")
				end
				return { kind = "assign", name = tok.v, value = parseExpr(), line = tok.line, bid = bid() }
			end
			local args = parseArgs()
			return { kind = "call", name = tok.v, args = args, line = tok.line, bid = bid() }
		end
		fail(tok, "ожидалась команда")
		return nil
	end

	function parseBlock()
		local body = {}
		table.insert(scopes, {})
		while true do
			local t = peek().t
			if t == "end" or t == "else" or t == "elseif" or t == "eof" then
				break
			end
			table.insert(body, parseStatement())
		end
		table.remove(scopes)
		return body
	end

	local function parseHandler()
		local tok = expect("on", "on")
		local name = expect("name", "имя события")
		local args = parseArgs()
		expect("do")
		local body = parseBlock()
		expect("end")
		return { kind = "handler", event = name.v, args = args, body = body, line = tok.line, bid = bid() }
	end

	local ok, res = pcall(function()
		local script = { handlers = {} }
		while peek().t ~= "eof" do
			table.insert(script.handlers, parseHandler())
		end
		return script
	end)
	if not ok then
		if type(res) == "table" and res.parseError then
			table.insert(errors, 1, res.parseError)
			return nil, errors
		end
		error(res, 0)
	end
	if #errors &gt; 0 then
		return res, errors
	end
	return res, nil
end

-- Переименование идентификаторов в исходнике без изменения остального текста
function Parser.renameIdentifiers(src: string, renames: { [string]: string }): string
	local tokens = Parser.lex(src)
	if not tokens then
		return src
	end
	local out = {}
	local last = 1
	for _, tok in tokens do
		if tok.t == "name" and renames[tok.v] then
			table.insert(out, string.sub(src, last, tok.s - 1))
			table.insert(out, renames[tok.v])
			last = tok.e + 1
		end
	end
	table.insert(out, string.sub(src, last))
	return table.concat(out)
end

return Parser
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00000013">
            <Properties>
              <string name="Name">Printer</string>
              <ProtectedString name="Source">--!nonstrict
-- Печать дерева логики в текстовый режим (блоки -&gt; текст)

local Printer = {}

local function quote(s: string): string
	s = string.gsub(s, "\\", "\\\\")
	s = string.gsub(s, '"', '\\"')
	s = string.gsub(s, "\n", "\\n")
	return '"' .. s .. '"'
end

local PREC = {
	["or"] = 1, ["and"] = 2,
	["=="] = 3, ["~="] = 3, ["&lt;"] = 3, ["&gt;"] = 3, ["&lt;="] = 3, ["&gt;="] = 3,
	["+"] = 4, ["-"] = 4, ["*"] = 5, ["/"] = 5,
}

function Printer.print(script, nameOf: (string) -&gt; string): string
	local out = {}
	local function emit(depth: number, s: string)
		table.insert(out, string.rep("  ", depth) .. s)
	end
	local expr
	local function args(list)
		local parts = {}
		for _, a in list do
			table.insert(parts, expr(a, 0))
		end
		return table.concat(parts, ", ")
	end
	function expr(e, parentPrec: number): string
		local k = e.kind
		if k == "num" then
			local v = e.value
			if v == math.floor(v) then
				return string.format("%d", v)
			end
			return tostring(v)
		elseif k == "str" then
			return quote(e.value)
		elseif k == "bool" then
			return if e.value then "true" else "false"
		elseif k == "ref" then
			return nameOf(e.ref)
		elseif k == "var" then
			return e.name
		elseif k == "cond" then
			return e.name .. "(" .. args(e.args) .. ")"
		elseif k == "not" then
			return "not " .. expr(e.e, 6)
		elseif k == "neg" then
			return "-" .. expr(e.e, 6)
		elseif k == "bin" then
			local p = PREC[e.op]
			local s = expr(e.a, p) .. " " .. e.op .. " " .. expr(e.b, p + 1)
			if p &lt; parentPrec then
				return "(" .. s .. ")"
			end
			return s
		end
		return "nil"
	end
	local block
	function block(body, depth: number)
		for _, st in body do
			local k = st.kind
			if k == "call" then
				emit(depth, st.name .. "(" .. args(st.args) .. ")")
			elseif k == "local" then
				emit(depth, "local " .. st.name .. " = " .. expr(st.value, 0))
			elseif k == "assign" then
				emit(depth, st.name .. " = " .. expr(st.value, 0))
			elseif k == "for" then
				emit(depth, "for " .. st.var .. " = " .. expr(st.from, 0) .. ", " .. expr(st.to, 0) .. " do")
				block(st.body, depth + 1)
				emit(depth, "end")
			elseif k == "if" then
				for i, br in st.branches do
					emit(depth, (if i == 1 then "if " else "elseif ") .. expr(br.cond, 0) .. " then")
					block(br.body, depth + 1)
				end
				if st.elseBody then
					emit(depth, "else")
					block(st.elseBody, depth + 1)
				end
				emit(depth, "end")
			end
		end
	end
	for i, h in script.handlers do
		if i &gt; 1 then
			table.insert(out, "")
		end
		emit(0, "on " .. h.event .. "(" .. args(h.args) .. ") do")
		block(h.body, 1)
		emit(0, "end")
	end
	return table.concat(out, "\n") .. (if #out &gt; 0 then "\n" else "")
end

-- Текст одного выражения (для подписи в блоке)
function Printer.exprText(e, nameOf: (string) -&gt; string): string
	local text = Printer.print({ handlers = { { event = "X", args = { e }, body = {} } } }, nameOf)
	return string.match(text, "^on X%((.*)%) do\nend\n$") or text
end

-- Текст одной команды без отступа
function Printer.stmtText(st, nameOf: (string) -&gt; string): string
	local text = Printer.print({ handlers = { { event = "X", args = {}, body = { st } } } }, nameOf)
	local inner = string.match(text, "^on X%(%) do\n(.*)\nend\n$") or text
	return (string.gsub(inner, "\n  ", "\n"):gsub("^  ", ""))
end

return Printer
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00000014">
            <Properties>
              <string name="Name">Validator</string>
              <ProtectedString name="Source">--!nonstrict
-- Проверка логики карты. Одна и та же проверка работает в редакторе (подсветка
-- блока или строки) и на сервере перед запуском. Сервер не исполняет сценарий,
-- который ссылается на чужие объекты или неизвестные команды

local Commands = require(script.Parent.Commands)

local Validator = {}

Validator.LIMITS = { handlers = 100, statements = 2000, depth = 12, textLen = 600 }

local function clipNames(obj)
	local names = {}
	if obj and obj.kind == "model" then
		for _, clip in obj.model.clips do
			names[clip.name] = true
		end
	end
	return names
end

function Validator.validate(tree, project)
	local errors = {}
	local objects = project.map.objects
	local statements = 0

	local function report(node, msg: string, extra: { [string]: any }?)
		local e = { line = node and node.line, bid = node and node.bid, message = msg }
		if extra then
			for k, v in extra do
				e[k] = v
			end
		end
		table.insert(errors, e)
	end

	if type(tree) ~= "table" or type(tree.handlers) ~= "table" then
		report(nil, "логика повреждена")
		return errors
	end
	if #tree.handlers &gt; Validator.LIMITS.handlers then
		report(nil, "слишком много событий в логике")
	end

	local function checkArgs(owner, def, args, title: string)
		if type(args) ~= "table" then
			report(owner, title .. ": неверные аргументы")
			return
		end
		local minArgs = Commands.minArgs(def)
		if #args &lt; minArgs or #args &gt; #def.args then
			report(owner, string.format("%s: нужно аргументов %d–%d, указано %d", title, minArgs, #def.args, #args))
			return
		end
		local modelObj = nil
		for i, a in args do
			local spec = def.args[i]
			local t = spec.type
			local check = Commands.TARGET_TYPES[t]
			if check then
				if a.kind ~= "ref" then
					report(a.line and a or owner, string.format("%s: «%s» должен быть объектом карты", title, spec.title))
				else
					local obj = objects[a.ref]
					if not obj then
						report(owner, string.format("%s: цель «%s» удалена, нужна новая привязка", title, spec.title), {
							broken = true, argIndex = i, ref = a.ref,
						})
					elseif not check(obj) then
						report(owner, string.format("%s: «%s» не подходит для поля «%s»", title, obj.name, spec.title))
					elseif t == "model" and not modelObj then
						modelObj = obj
					end
				end
			elseif t == "weather" then
				if a.kind ~= "str" or not Commands.WEATHER_TITLES[a.value] then
					report(owner, title .. ": погода бывает Clear, Rain, Snow, Fog или Storm")
				end
			elseif t == "sound" then
				local id = a.kind == "str" and (string.match(a.value, "^%d+$") or string.match(a.value, "^rbxassetid://(%d+)$"))
				if not id or #id &gt; 20 then
					report(owner, title .. ": нужен ID звука Roblox, например \"1837849285\"")
				end
			elseif t == "clip" then
				if a.kind ~= "str" then
					report(owner, title .. ": имя клипа должно быть строкой")
				elseif modelObj and not clipNames(modelObj)[a.value] then
					report(owner, string.format("%s: у модели «%s» нет клипа «%s»", title, modelObj.name, a.value))
				end
			elseif t == "text" or t == "string" then
				if a.kind ~= "str" then
					report(owner, string.format("%s: «%s» должен быть текстом в кавычках", title, spec.title))
				elseif utf8.len(a.value) == nil or (utf8.len(a.value) :: number) &gt; Validator.LIMITS.textLen then
					report(owner, title .. ": текст слишком длинный")
				end
			elseif t == "number" then
				if a.kind == "num" then
					if (spec.min and a.value &lt; spec.min) or (spec.max and a.value &gt; spec.max) then
						report(owner, string.format("%s: «%s» вне диапазона %s–%s", title, spec.title, tostring(spec.min), tostring(spec.max)))
					end
				elseif a.kind == "str" or a.kind == "bool" or a.kind == "ref" then
					report(owner, string.format("%s: «%s» должно быть числом", title, spec.title))
				end
			elseif t == "bool" then
				if a.kind == "num" or a.kind == "str" or a.kind == "ref" then
					report(owner, string.format("%s: «%s» должно быть true или false", title, spec.title))
				end
			end
		end
	end

	local checkExpr
	function checkExpr(owner, e, depth: number)
		if type(e) ~= "table" then
			report(owner, "повреждённое выражение")
			return
		end
		if depth &gt; 20 then
			report(owner, "слишком сложное выражение")
			return
		end
		local k = e.kind
		if k == "cond" then
			local def = Commands.conditions[e.name]
			if not def then
				report(owner, "неизвестное условие «" .. tostring(e.name) .. "»")
				return
			end
			checkArgs(owner, def, e.args, def.title)
		elseif k == "not" or k == "neg" then
			checkExpr(owner, e.e, depth + 1)
		elseif k == "bin" then
			checkExpr(owner, e.a, depth + 1)
			checkExpr(owner, e.b, depth + 1)
		elseif k == "ref" then
			if not objects[e.ref] then
				report(owner, "объект удалён, нужна новая привязка", { broken = true, ref = e.ref })
			end
		elseif k ~= "num" and k ~= "str" and k ~= "bool" and k ~= "var" then
			report(owner, "неизвестное выражение")
		end
	end

	local checkBody
	function checkBody(body, depth: number)
		if type(body) ~= "table" then
			return
		end
		if depth &gt; Validator.LIMITS.depth then
			report(nil, "слишком глубокая вложенность")
			return
		end
		for _, st in body do
			statements += 1
			local k = st.kind
			if k == "call" then
				local def = Commands.actions[st.name]
				if not def then
					report(st, "неизвестная команда «" .. tostring(st.name) .. "»")
				else
					checkArgs(st, def, st.args, def.title)
					for _, a in st.args do
						if a.kind ~= "ref" then
							checkExpr(st, a, 0)
						end
					end
				end
			elseif k == "if" then
				for _, br in st.branches or {} do
					checkExpr(st, br.cond, 0)
					checkBody(br.body, depth + 1)
				end
				if st.elseBody then
					checkBody(st.elseBody, depth + 1)
				end
			elseif k == "for" then
				checkExpr(st, st.from, 0)
				checkExpr(st, st.to, 0)
				checkBody(st.body, depth + 1)
			elseif k == "local" or k == "assign" then
				checkExpr(st, st.value, 0)
			else
				report(st, "неизвестный блок")
			end
		end
	end

	for _, h in tree.handlers do
		local def = Commands.events[h.event]
		if not def then
			report(h, "неизвестное событие «" .. tostring(h.event) .. "»")
		else
			checkArgs(h, def, h.args, def.title)
		end
		checkBody(h.body, 1)
	end
	if statements &gt; Validator.LIMITS.statements then
		report(nil, "слишком много блоков в логике")
	end
	return errors
end

return Validator
</ProtectedString>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="RBX00000015">
          <Properties>
            <string name="Name">MafiaRules</string>
            <ProtectedString name="Source">--!nonstrict
-- Правила «Мафии» без Roblox API: раздача ролей, голосования, ночь, победа, чаты

local Rules = {}

Rules.MAX_PLAYERS = 13
Rules.MIN_PLAYERS = 4

Rules.ROLES = { mafia = true, doctor = true, sheriff = true, civilian = true }

Rules.LIMITS = {
	mafia = { 1, 6 },
	doctor = { 1, 3 },
	sheriff = { 1, 3 },
}

-- Автоматически: 1 доктор, 1 шериф, мафии примерно треть игроков (8 → 2, 12 → 4)
function Rules.autoCounts(n: number)
	local mafia = math.clamp(math.floor(n / 3), 1, 6)
	local doctor = if n &gt;= 4 then 1 else 0
	local sheriff = if n &gt;= 5 then 1 else 0
	return { mafia = mafia, doctor = doctor, sheriff = sheriff }
end

-- Проверка ручных настроек. Возвращает nil или текст проблемы
function Rules.checkCounts(n: number, c): string?
	for role, lim in Rules.LIMITS do
		local v = c[role]
		if type(v) ~= "number" or v ~= math.floor(v) or v &lt; lim[1] or v &gt; lim[2] then
			return role
		end
	end
	if c.mafia + c.doctor + c.sheriff &gt; n then
		return "too_many_roles"
	end
	if c.mafia * 2 &gt;= n then
		return "too_much_mafia"
	end
	return nil
end

-- Раздача ролей случайно. ids — список игроков (без ведущего), rand(a, b) — целое
function Rules.assign(ids: { any }, counts, rand: (number, number) -&gt; number)
	local pool = table.clone(ids)
	-- перемешивание Фишера — Йейтса
	for i = #pool, 2, -1 do
		local j = rand(1, i)
		pool[i], pool[j] = pool[j], pool[i]
	end
	local roles = {}
	local k = 1
	for _, role in { "mafia", "doctor", "sheriff" } do
		for _ = 1, counts[role] or 0 do
			if pool[k] ~= nil then
				roles[pool[k]] = role
				k += 1
			end
		end
	end
	for i = k, #pool do
		roles[pool[i]] = "civilian"
	end
	return roles
end

-- Дневное голосование: votes[voter] = цель или "skip". Изгоняется тот, у кого больше
-- всех голосов, если голосов за него больше, чем за «пропустить», и нет ничьей
function Rules.dayResult(votes, alive)
	local tally = {}
	local skip = 0
	for voter, target in votes do
		if alive[voter] then
			if target == "skip" then
				skip += 1
			elseif alive[target] then
				tally[target] = (tally[target] or 0) + 1
			end
		end
	end
	local best, bestN, tie = nil, 0, false
	for target, n in tally do
		if n &gt; bestN then
			best, bestN, tie = target, n, false
		elseif n == bestN then
			tie = true
		end
	end
	if not best or tie or bestN &lt;= skip then
		return nil, tally, skip
	end
	return best, tally, skip
end

-- Мафия должна прийти к общему решению: цель засчитывается, только если все живые
-- мафиози выбрали одного и того же
function Rules.mafiaTarget(votes, roles, alive)
	local target = nil
	local total, voted = 0, 0
	for id, role in roles do
		if role == "mafia" and alive[id] then
			total += 1
			local v = votes[id]
			if v ~= nil then
				voted += 1
				if target == nil then
					target = v
				elseif target ~= v then
					return nil, false
				end
			end
		end
	end
	if total == 0 or voted &lt; total or not alive[target] then
		return nil, false
	end
	return target, true
end

-- Итог ночи: жертва мафии погибает, если её не вылечил ни один доктор
function Rules.nightResult(target, heals)
	if target == nil then
		return nil, false
	end
	for _, healed in heals do
		if healed == target then
			return nil, true
		end
	end
	return target, false
end

-- Победа: мафия, когда мирных (всех остальных) не больше мафии; город, когда мафии нет
function Rules.winner(roles, alive): string?
	local mafia, town = 0, 0
	for id, role in roles do
		if alive[id] then
			if role == "mafia" then
				mafia += 1
			else
				town += 1
			end
		end
	end
	if mafia == 0 then
		return "town"
	end
	if mafia &gt;= town then
		return "mafia"
	end
	return nil
end

-- Чаты. who = { role = ..., alive = bool, host = bool }, phase = "lobby" | "day" | "vote" | "night" | ...
-- Возвращает, может ли игрок писать и видеть канал
function Rules.chat(channel: string, who, phase: string)
	if who.host then
		return true, true
	end
	local night = phase == "night"
	if channel == "general" then
		-- общий видят все; писать могут живые, и не ночью
		return who.alive and not night and phase ~= "reveal", true
	elseif channel == "mafia" then
		local isMafia = who.role == "mafia" and who.alive
		return isMafia, isMafia
	elseif channel == "ghost" then
		local ghost = not who.alive and who.role ~= nil
		return ghost, ghost
	end
	return false, false
end

return Rules
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000016">
          <Properties>
            <string name="Name">MafiaSounds</string>
            <ProtectedString name="Source">--!nonstrict
-- Звуки «Мафии». Встроенные звуки Roblox работают сразу. Свои звуки: загрузите их в
-- Roblox или возьмите публичные из библиотеки и впишите сюда как "rbxassetid://ID"
return {
	start = "rbxasset://sounds/electronicpingshort.wav",
	night = "rbxasset://sounds/button.wav",
	death = "rbxasset://sounds/uuhhh.mp3",
	vote = "rbxasset://sounds/clickfast.wav",
	click = "rbxasset://sounds/clickfast.wav",
	save = "rbxasset://sounds/electronicpingshort.wav",
	win = "rbxasset://sounds/electronicpingshort.wav",
	whoosh = "rbxasset://sounds/swoosh.wav",
	join = "rbxasset://sounds/button.wav",
	-- фоновые звуки сезонов (впишите ID, чтобы включить)
	ambientSummer = "",
	ambientSpring = "",
	ambientAutumn = "",
	ambientWinter = "",
}
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000017">
          <Properties>
            <string name="Name">MathX</string>
            <ProtectedString name="Source">--!nonstrict
-- Чистая математика трансформаций без зависимостей от Roblox
-- Вектор: {x, y, z}; матрица поворота 3x3: {r00, r01, r02, r10, ..., r22} (по строкам)
-- Трансформ: {p = vec, m = mat}; совпадает по смыслу с CFrame
-- Эйлеровы углы хранятся в градусах в порядке YXZ, как CFrame.fromOrientation

local MathX = {}

local rad, deg = math.rad, math.deg
local sin, cos, sqrt = math.sin, math.cos, math.sqrt
local asin, atan2 = math.asin, math.atan2

function MathX.v(x: number?, y: number?, z: number?)
	return { x or 0, y or 0, z or 0 }
end

function MathX.add(a, b)
	return { a[1] + b[1], a[2] + b[2], a[3] + b[3] }
end

function MathX.sub(a, b)
	return { a[1] - b[1], a[2] - b[2], a[3] - b[3] }
end

function MathX.scale(a, s: number)
	return { a[1] * s, a[2] * s, a[3] * s }
end

function MathX.lerp(a, b, t: number)
	return { a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t, a[3] + (b[3] - a[3]) * t }
end

function MathX.len(a)
	return sqrt(a[1] * a[1] + a[2] * a[2] + a[3] * a[3])
end

function MathX.identity()
	return { 1, 0, 0, 0, 1, 0, 0, 0, 1 }
end

function MathX.matMul(a, b)
	local r = table.create(9, 0)
	for i = 0, 2 do
		for j = 0, 2 do
			local s = 0
			for k = 0, 2 do
				s += a[i * 3 + k + 1] * b[k * 3 + j + 1]
			end
			r[i * 3 + j + 1] = s
		end
	end
	return r
end

function MathX.matT(a)
	return { a[1], a[4], a[7], a[2], a[5], a[8], a[3], a[6], a[9] }
end

function MathX.matApply(m, v)
	return {
		m[1] * v[1] + m[2] * v[2] + m[3] * v[3],
		m[4] * v[1] + m[5] * v[2] + m[6] * v[3],
		m[7] * v[1] + m[8] * v[2] + m[9] * v[3],
	}
end

local function rotX(a)
	local c, s = cos(a), sin(a)
	return { 1, 0, 0, 0, c, -s, 0, s, c }
end
local function rotY(a)
	local c, s = cos(a), sin(a)
	return { c, 0, s, 0, 1, 0, -s, 0, c }
end
local function rotZ(a)
	local c, s = cos(a), sin(a)
	return { c, -s, 0, s, c, 0, 0, 0, 1 }
end

-- Углы в градусах, порядок как у CFrame.fromOrientation: R = Ry * Rx * Rz
function MathX.matFromEuler(e)
	return MathX.matMul(MathX.matMul(rotY(rad(e[2])), rotX(rad(e[1]))), rotZ(rad(e[3])))
end

function MathX.eulerFromMat(m)
	-- m[6] = r12 = -sin(x)
	local sx = -m[6]
	if sx &gt; 1 then
		sx = 1
	elseif sx &lt; -1 then
		sx = -1
	end
	local x = asin(sx)
	local y, z
	if math.abs(sx) &lt; 0.99999 then
		y = atan2(m[3], m[9])
		z = atan2(m[4], m[5])
	else
		y = atan2(-m[7], m[1])
		z = 0
	end
	local function clean(v: number)
		local d = deg(v)
		local r = math.floor(d * 1000 + 0.5) / 1000
		if r == 0 then
			r = 0
		end
		return r
	end
	return { clean(x), clean(y), clean(z) }
end

function MathX.tf(p, e)
	return { p = { p[1], p[2], p[3] }, m = MathX.matFromEuler(e or { 0, 0, 0 }) }
end

function MathX.tfIdentity()
	return { p = { 0, 0, 0 }, m = MathX.identity() }
end

function MathX.mul(a, b)
	return { p = MathX.add(a.p, MathX.matApply(a.m, b.p)), m = MathX.matMul(a.m, b.m) }
end

function MathX.inv(a)
	local mt = MathX.matT(a.m)
	return { p = MathX.scale(MathX.matApply(mt, a.p), -1), m = mt }
end

function MathX.apply(a, v)
	return MathX.add(a.p, MathX.matApply(a.m, v))
end

-- Трансформ b в системе координат base
function MathX.toLocal(base, b)
	return MathX.mul(MathX.inv(base), b)
end

function MathX.toWorld(base, localTf)
	return MathX.mul(base, localTf)
end

function MathX.decompose(t)
	return { t.p[1], t.p[2], t.p[3] }, MathX.eulerFromMat(t.m)
end

-- Кватернионы {w, x, y, z}
function MathX.quatFromMat(m)
	local tr = m[1] + m[5] + m[9]
	local w, x, y, z
	if tr &gt; 0 then
		local s = sqrt(tr + 1) * 2
		w = 0.25 * s
		x = (m[8] - m[6]) / s
		y = (m[3] - m[7]) / s
		z = (m[4] - m[2]) / s
	elseif m[1] &gt; m[5] and m[1] &gt; m[9] then
		local s = sqrt(1 + m[1] - m[5] - m[9]) * 2
		w = (m[8] - m[6]) / s
		x = 0.25 * s
		y = (m[2] + m[4]) / s
		z = (m[3] + m[7]) / s
	elseif m[5] &gt; m[9] then
		local s = sqrt(1 + m[5] - m[1] - m[9]) * 2
		w = (m[3] - m[7]) / s
		x = (m[2] + m[4]) / s
		y = 0.25 * s
		z = (m[6] + m[8]) / s
	else
		local s = sqrt(1 + m[9] - m[1] - m[5]) * 2
		w = (m[4] - m[2]) / s
		x = (m[3] + m[7]) / s
		y = (m[6] + m[8]) / s
		z = 0.25 * s
	end
	return { w, x, y, z }
end

function MathX.matFromQuat(q)
	local w, x, y, z = q[1], q[2], q[3], q[4]
	return {
		1 - 2 * (y * y + z * z), 2 * (x * y - z * w), 2 * (x * z + y * w),
		2 * (x * y + z * w), 1 - 2 * (x * x + z * z), 2 * (y * z - x * w),
		2 * (x * z - y * w), 2 * (y * z + x * w), 1 - 2 * (x * x + y * y),
	}
end

function MathX.slerp(a, b, t: number)
	local dot = a[1] * b[1] + a[2] * b[2] + a[3] * b[3] + a[4] * b[4]
	local bb = b
	if dot &lt; 0 then
		bb = { -b[1], -b[2], -b[3], -b[4] }
		dot = -dot
	end
	if dot &gt; 0.9995 then
		local r = {
			a[1] + (bb[1] - a[1]) * t,
			a[2] + (bb[2] - a[2]) * t,
			a[3] + (bb[3] - a[3]) * t,
			a[4] + (bb[4] - a[4]) * t,
		}
		local l = sqrt(r[1] * r[1] + r[2] * r[2] + r[3] * r[3] + r[4] * r[4])
		return { r[1] / l, r[2] / l, r[3] / l, r[4] / l }
	end
	local theta0 = math.acos(dot)
	local theta = theta0 * t
	local s0 = cos(theta) - dot * sin(theta) / sin(theta0)
	local s1 = sin(theta) / sin(theta0)
	return {
		a[1] * s0 + bb[1] * s1,
		a[2] * s0 + bb[2] * s1,
		a[3] * s0 + bb[3] * s1,
		a[4] * s0 + bb[4] * s1,
	}
end

function MathX.tfLerp(a, b, t: number)
	local q = MathX.slerp(MathX.quatFromMat(a.m), MathX.quatFromMat(b.m), t)
	return { p = MathX.lerp(a.p, b.p, t), m = MathX.matFromQuat(q) }
end

function MathX.near(a: number, b: number, eps: number?)
	return math.abs(a - b) &lt;= (eps or 1e-4)
end

function MathX.vNear(a, b, eps: number?)
	return MathX.near(a[1], b[1], eps) and MathX.near(a[2], b[2], eps) and MathX.near(a[3], b[3], eps)
end

function MathX.snap(v: number, step: number)
	if step &lt;= 0 then
		return v
	end
	return math.floor(v / step + 0.5) * step
end

return MathX
