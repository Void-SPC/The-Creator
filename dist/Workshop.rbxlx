        <Item class="ModuleScript" referent="RBX0000000B">
          <Properties>
            <string name="Name">Closet</string>
            <ProtectedString name="Source">--!nonstrict
-- Шкаф: состояния «Свободен» -&gt; «Вход» -&gt; «Внутри» -&gt; «Выход» -&gt; «Свободен»
-- Точки входа, внутри и выхода хранятся относительно шкафа, поэтому при
-- перемещении и повороте шкафа они переезжают вместе с ним

local MathX = require(script.Parent.MathX)
local Format = require(script.Parent.Format)
local Anim = require(script.Parent.Anim)

local Closet = {}

Closet.FREE = "Free"
Closet.ENTERING = "Entering"
Closet.INSIDE = "Inside"
Closet.EXITING = "Exiting"

Closet.ENTER_CLIP = "EnterCloset"
Closet.EXIT_CLIP = "ExitCloset"

function Closet.new()
	return { state = Closet.FREE, occupant = nil, token = 0, since = 0, clipLength = 0 }
end

-- Нажатие «Спрятаться» или «Выйти». Повторное нажатие во время клипа отклоняется,
-- поэтому клипы не накладываются
function Closet.request(c, userId: number, now: number, clipLengths: { enter: number, exit: number })
	if c.state == Closet.FREE then
		c.state = Closet.ENTERING
		c.occupant = userId
		c.token += 1
		c.since = now
		c.clipLength = clipLengths.enter
		return true, "enter", c.token
	elseif c.state == Closet.INSIDE then
		if c.occupant ~= userId then
			return false, "occupied", nil
		end
		c.state = Closet.EXITING
		c.token += 1
		c.since = now
		c.clipLength = clipLengths.exit
		return true, "exit", c.token
	end
	if c.occupant == userId then
		return false, "busy", nil
	end
	return false, "occupied", nil
end

-- Клип завершился. Устаревший токен (после прерывания) игнорируется
function Closet.complete(c, token: number, now: number)
	if token ~= c.token then
		return false
	end
	if c.state == Closet.ENTERING then
		c.state = Closet.INSIDE
		c.since = now
		return true
	elseif c.state == Closet.EXITING then
		c.state = Closet.FREE
		c.occupant = nil
		c.since = now
		return true
	end
	return false
end

-- Освобождение при смерти, выходе игрока, удалении шкафа или прерывании клипа
function Closet.release(c, now: number)
	local who = c.occupant
	local was = c.state
	c.state = Closet.FREE
	c.occupant = nil
	c.token += 1
	c.since = now
	return who, was
end

-- Сторож: клип не может длиться дольше своей длины с запасом
function Closet.isStuck(c, now: number): boolean
	if c.state ~= Closet.ENTERING and c.state ~= Closet.EXITING then
		return false
	end
	return now - c.since &gt; c.clipLength + 2
end

-- Мировая поза точки шкафа
function Closet.worldPose(closetPos, closetRot, localPose)
	local base = MathX.tf(closetPos, closetRot)
	return MathX.mul(base, MathX.tf(localPose.pos, localPose.rot))
end

local function key(clip, track, t, pose)
	Anim.setKey(clip, track, t, pose.pos, pose.rot, "smooth")
end

-- Поза камеры: на уровне глаз над точкой персонажа (точки шкафа стоят на полу)
Closet.EYE_HEIGHT = 4.6
local function eye(pose)
	return { pos = { pose.pos[1], pose.pos[2] + Closet.EYE_HEIGHT, pose.pos[3] }, rot = { pose.rot[1], pose.rot[2], pose.rot[3] } }
end

function Closet.defaultClips(entry, inside, exit)
	local enter = Format.newClip(Closet.ENTER_CLIP, Closet.ENTER_CLIP)
	enter.length = 0.9
	key(enter, "PlayerRoot", 0, entry)
	key(enter, "PlayerRoot", 0.9, inside)
	key(enter, "Camera", 0, eye(entry))
	key(enter, "Camera", 0.9, eye(inside))
	local leave = Format.newClip(Closet.EXIT_CLIP, Closet.EXIT_CLIP)
	leave.length = 0.8
	key(leave, "PlayerRoot", 0, inside)
	key(leave, "PlayerRoot", 0.8, exit)
	key(leave, "Camera", 0, eye(inside))
	key(leave, "Camera", 0.8, eye(exit))
	return enter, leave
end

-- Роль шкафа для модели глубиной depth (передняя сторона смотрит в -Z, как у Roblox)
function Closet.newRole(depth: number?)
	local d = depth or 3
	local entry = { pos = { 0, 0, -(d / 2 + 2) }, rot = { 0, 180, 0 } }
	local inside = { pos = { 0, 0, 0 }, rot = { 0, 0, 0 } } -- внутри лицом к дверце
	local exit = { pos = { 0, 0, -(d / 2 + 2.5) }, rot = { 0, 0, 0 } }
	local enterClip, exitClip = Closet.defaultClips(entry, inside, exit)
	return {
		type = "closet",
		entry = entry,
		inside = inside,
		exit = exit,
		enterClip = enterClip,
		exitClip = exitClip,
	}
end

-- Поза игрока (PlayerRoot) и камеры в мире для клипа шкафа в момент t
function Closet.sampleWorld(closetPos, closetRot, clip, t: number)
	local s = Anim.sample(clip, t)
	local base = MathX.tf(closetPos, closetRot)
	local out = {}
	for track, v in s do
		out[track] = MathX.mul(base, MathX.tf(v.pos, v.rot))
	end
	return out
end

return Closet
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX0000000C">
          <Properties>
            <string name="Name">Demo</string>
            <ProtectedString name="Source">--!nonstrict
-- Демонстрационная сцена: игрок открывает дверь, лисик выбирается из книжного шкафа
-- и бежит на шум; на метке клипа «Скример» гаснет лампа, затем лисик убегает
-- Любой объект сцены можно заменить в редакторе: логика ссылается на ID, а не на имена

local Format = require(script.Parent.Format)
local Prefabs = require(script.Parent.Prefabs)
local Logic = require(script.Parent.Logic)

local Demo = {}

Demo.SOURCE = [[
-- Демосцена: шум за дверью
on DoorOpened(FrontDoor) do
  SetVisible(Fox, true)
  PlayClip(Fox, "Появление")
  Wait(1.4)
  MoveTo(Fox, NoisePoint, "Бег", 14)
end

on Arrived(Fox, NoisePoint) do
  Say(Fox, "Кто здесь шумит?", 2.5)
  PlayClip(Fox, "Скример")
end

on MarkerReached(Fox, "Скример", "Погасить") do
  SetLight(HallLamp, false)
end

on ClipFinished(Fox, "Скример") do
  MoveTo(Fox, EscapePoint, "Бег", 22)
end

on Arrived(Fox, EscapePoint) do
  SetVisible(Fox, false)
  Wait(3)
  SetLight(HallLamp, true)
end
]]

local function put(project, objs)
	for _, o in objs do
		project.map.objects[o.id] = o
	end
	return objs[1]
end

function Demo.build(projectId: string, ownerId: number)
	local p = Format.newProject(projectId, "Шум за дверью", ownerId)

	put(p, Prefabs.room(p, 28, 24, 10))
	local spawn = put(p, Prefabs.build(p, "spawn", { 0, 0, -30 }))
	spawn.latin = "Start"

	-- коридор перед дверью
	local corridor = Prefabs.build(p, "corridor", { 0, 0, -23.5 }) :: any
	put(p, corridor)

	local door = put(p, Prefabs.build(p, "door", { 0, 0, -11.5 }))
	door.name = "Входная дверь"
	door.latin = "FrontDoor"

	local lamp = put(p, Prefabs.build(p, "lamp", { 0, 0, 0 }))
	lamp.name = "Лампа в холле"
	lamp.latin = "HallLamp"

	local shelf = put(p, Prefabs.build(p, "bookshelf", { 8, 1, 10 }))
	shelf.rot = { 0, 0, 0 }
	shelf.latin = "Bookshelf01"

	-- лисик стоит перед полками; клип «Появление» начинается с позы внутри шкафа
	local fox = put(p, Prefabs.build(p, "fox", { 8, 1, 7 }))
	fox.latin = "Fox"
	fox.rot = { 0, 0, 0 }
	fox.hidden = true

	local noise = put(p, Prefabs.build(p, "waypoint", { -6, 0, -4 }))
	noise.name = "Источник шума"
	noise.latin = "NoisePoint"

	local escape = put(p, Prefabs.build(p, "waypoint", { -10, 0, 9 }))
	escape.name = "Точка побега"
	escape.latin = "EscapePoint"

	local closet = put(p, Prefabs.build(p, "closet", { -11, 1, -6 }))
	closet.rot = { 0, -90, 0 } -- дверцами в комнату
	closet.latin = "Closet01"

	local sign = put(p, Prefabs.build(p, "sign", { 0, 5, -12.15 }))
	sign.label.text = "Не открывай после полуночи"
	sign.latin = "WarningSign"

	local npc = put(p, Prefabs.build(p, "npcNew", { -2.5, 1, -20 }))
	npc.name = "Сторож"
	npc.latin = "Keeper"
	npc.rot = { 0, -90, 0 }
	npc.role.lines = {
		{ text = "Здравствуй! Говорят, в этом доме по ночам кто-то шуршит за книжным шкафом. Если услышишь шум, спрячься в шкаф у стены и не выходи, пока свет снова не загорится.", delay = 0, duration = 7 },
		{ text = "Удачи!", delay = 7.5, duration = 2 },
	}

	p.settings.lighting.clockTime = 0

	local tree, errors = Logic.Parser.parse(Demo.SOURCE, Logic.nameResolver(p))
	assert(tree and not errors, "demo logic must parse")
	p.logic.mode = "blocks"
	p.logic.blocks = tree
	p.logic.text.source = Demo.SOURCE
	p.logic.text.refs = Logic.collectRefs(tree)
	return p
end

-- Вспомогательное для проверки: ID объекта по латинскому имени
function Demo.idOf(project, latin: string): string?
	for id, o in project.map.objects do
		if o.latin == latin then
			return id
		end
	end
	return nil
end

return Demo
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX0000000D">
          <Properties>
            <string name="Name">Format</string>
            <ProtectedString name="Source">--!nonstrict
-- Формат данных проекта мастерской
-- Всё, что делает автор (карта, модели, клипы, роли, логика, камера, тексты), хранится
-- в одной таблице, совместимой с DataStore. У формата есть версия и цепочка миграций

local Util = require(script.Parent.Util)
local Catalog = require(script.Parent.Catalog)

local Format = {}

Format.VERSION = 2

Format.LIMITS = {
	objects = 1500,
	partsPerModel = 120,
	clipsPerModel = 24,
	keysPerTrack = 400,
	markersPerClip = 64,
	nameLen = 60,
	latinLen = 40,
	textLen = 600,
	codeLen = 20000,
	coord = 20000,
	sizeMin = 0.01, -- Roblox допускает от 0.001; у деталей Office встречается 0.03
	sizeMax = 512,
	clipLength = 120,
	dataBytes = 3_500_000,
}

Format.SHAPES = { Block = true, Ball = true, Cylinder = true, Wedge = true, CornerWedge = true, Ellipsoid = true }

-- Все материалы Roblox: у каждого своя встроенная текстура поверхности
Format.MATERIALS = {
	"Plastic", "SmoothPlastic", "Wood", "WoodPlanks", "Brick", "Concrete", "Marble", "Granite",
	"Slate", "Metal", "DiamondPlate", "CorrodedMetal", "Fabric", "Grass", "Sand", "Glass",
	"Neon", "Ice", "Cobblestone", "Pebble", "Basalt", "CrackedLava", "Limestone", "Pavement",
	"Rock", "Sandstone", "Foil", "LeafyGrass", "Snow", "Mud", "Ground", "Asphalt", "Salt",
	"Glacier", "ForceField", "Cardboard", "Carpet", "CeramicTiles", "ClayRoofTiles",
	"RoofShingles", "Leather", "Plaster", "Rubber",
}
local MATERIAL_SET = {}
for _, m in Format.MATERIALS do
	MATERIAL_SET[m] = true
end
Format.MATERIAL_SET = MATERIAL_SET

Format.ROLES = {
	closet = true, door = true, light = true, npc = true, creature = true,
	zone = true, waypoint = true, spawn = true, statue = true,
}

local function vec(x: number, y: number, z: number)
	return { x, y, z }
end

function Format.newSettings()
	return {
		camera = {
			mode = "first", -- first | default
			sensitivity = 1,
			fov = 70,
			bob = 0.5, -- 0 отключает покачивание
		},
		hud = { health = false },
		-- погода: Clear, Rain, Snow, Fog, Storm; auto — менять сама каждые minutes минут
		weather = { type = "Clear", auto = false, minutes = 5 },
		-- музыка карты: ID звука Roblox (число) и громкость 0–1, или nil
		music = nil,
		-- clockTime — время суток в часах; dayNight включает смену дня и ночи,
		-- dayMinutes — сколько реальных минут длятся одни игровые сутки
		lighting = { ambient = { 40, 40, 48 }, clockTime = 14, brightness = 1, dayNight = false, dayMinutes = 12 },
	}
end

function Format.newProject(id: string, name: string, ownerId: number)
	return {
		format = Format.VERSION,
		id = id,
		ownerId = ownerId,
		nextId = 1,
		meta = {
			name = name,
			createdAt = os.time(),
			publishCode = nil,
			publishedVersion = 0,
		},
		map = { objects = {} },
		logic = {
			mode = "blocks",
			blocks = { handlers = {} },
			text = { source = "", refs = {} },
		},
		settings = Format.newSettings(),
	}
end

function Format.newPart(id: string, shape: string?)
	return {
		id = id,
		kind = "part",
		name = "Деталь",
		latin = nil,
		pos = vec(0, 2, 0),
		rot = vec(0, 0, 0),
		size = vec(4, 4, 4),
		shape = shape or "Block",
		color = { 200, 200, 200 },
		material = "SmoothPlastic",
		texture = nil,
		transparency = 0,
		frozen = false,
		physics = { anchored = true, canCollide = true },
		role = nil,
		label = nil,
	}
end

function Format.newModel(id: string)
	return {
		id = id,
		kind = "model",
		name = "Модель",
		latin = nil,
		pos = vec(0, 0, 0),
		rot = vec(0, 0, 0),
		frozen = false,
		physics = { anchored = true, canCollide = true },
		model = {
			parts = {}, -- [partId] = деталь с pos/rot относительно начала модели, parent, pivot
			clips = {}, -- [clipId] = клип
			nextPart = 1,
			body = nil, -- "new" | "retro" для человекоподобных NPC
		},
		role = nil,
		label = nil,
	}
end

function Format.newClip(id: string, name: string)
	return { id = id, name = name, length = 2, loop = false, tracks = {}, markers = {} }
end

-- ---------------------------------------------------------------------------
-- Миграции: каждая функция поднимает данные на одну версию

local MIGRATIONS = {}

-- v1 (ранний прототип): объекты массивом в project.objects, камера в settings.fov/sensitivity,
-- у логики был только блочный режим в project.script
MIGRATIONS[1] = function(p)
	local objects = {}
	for _, obj in p.objects or {} do
		if type(obj) == "table" and type(obj.id) == "string" then
			objects[obj.id] = obj
		end
	end
	p.objects = nil
	p.map = { objects = objects }
	local s = p.settings or {}
	local settings = Format.newSettings()
	settings.camera.fov = s.fov or settings.camera.fov
	settings.camera.sensitivity = s.sensitivity or settings.camera.sensitivity
	p.settings = settings
	p.logic = {
		mode = "blocks",
		blocks = p.script or { handlers = {} },
		text = { source = "", refs = {} },
	}
	p.script = nil
	p.meta = p.meta or { name = p.name or "Карта", createdAt = os.time(), publishedVersion = 0 }
	p.name = nil
	p.format = 2
	return p
end

function Format.migrate(data: any): (boolean, any)
	if type(data) ~= "table" then
		return false, "not a table"
	end
	local v = data.format
	if type(v) ~= "number" then
		return false, "no format version"
	end
	if v &gt; Format.VERSION then
		return false, "format from the future: " .. tostring(v)
	end
	while v &lt; Format.VERSION do
		local step = MIGRATIONS[v]
		if not step then
			return false, "no migration from " .. tostring(v)
		end
		local ok, res = pcall(step, data)
		if not ok then
			return false, "migration " .. tostring(v) .. " failed: " .. tostring(res)
		end
		data = res
		v = data.format
	end
	return true, data
end

-- ---------------------------------------------------------------------------
-- Проверка данных. Используется сервером на каждой правке и перед сохранением

local L = Format.LIMITS

local function isNum(v)
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

-- Текстура: из каталога или своё изображение Roblox по ID (rbxassetid://123)
function Format.isTexture(t): boolean
	if type(t) ~= "string" then
		return false
	end
	if Catalog.TEXTURE_SET[t] ~= nil then
		return true
	end
	local id = string.match(t, "^rbxassetid://(%d+)$")
	return id ~= nil and #id &lt;= 20
end

local function checkVec(v, lo, hi, what)
	if type(v) ~= "table" or #v ~= 3 then
		return what .. ": vector expected"
	end
	for i = 1, 3 do
		if not isNum(v[i]) or v[i] &lt; lo or v[i] &gt; hi then
			return what .. ": bad component"
		end
	end
	return nil
end

local function checkStr(v, maxLen, what, optional)
	if v == nil and optional then
		return nil
	end
	if type(v) ~= "string" then
		return what .. ": string expected"
	end
	if utf8.len(v) == nil then
		return what .. ": bad utf8"
	end
	if #v &gt; maxLen * 4 or (utf8.len(v) :: number) &gt; maxLen then
		return what .. ": too long"
	end
	return nil
end

local function checkColor(c, what)
	if type(c) ~= "table" or #c ~= 3 then
		return what .. ": color expected"
	end
	for i = 1, 3 do
		if not isNum(c[i]) or c[i] &lt; 0 or c[i] &gt; 255 then
			return what .. ": bad color"
		end
	end
	return nil
end

local function checkRef(r, what, optional)
	if r == nil and optional then
		return nil
	end
	if type(r) ~= "table" or type(r.ref) ~= "string" or #r.ref &gt; 32 then
		return what .. ": reference expected"
	end
	return nil
end

local function checkPose(pose, what)
	if type(pose) ~= "table" then
		return what .. ": pose expected"
	end
	return checkVec(pose.pos, -200, 200, what .. ".pos") or checkVec(pose.rot, -720, 720, what .. ".rot")
end

function Format.validateClip(clip): string?
	if type(clip) ~= "table" then
		return "clip: table expected"
	end
	local e = checkStr(clip.id, 32, "clip.id") or checkStr(clip.name, L.nameLen, "clip.name")
	if e then
		return e
	end
	if not isNum(clip.length) or clip.length &lt;= 0 or clip.length &gt; L.clipLength then
		return "clip.length"
	end
	if type(clip.loop) ~= "boolean" then
		return "clip.loop"
	end
	if type(clip.tracks) ~= "table" or type(clip.markers) ~= "table" then
		return "clip.tracks"
	end
	for trackId, track in clip.tracks do
		if type(trackId) ~= "string" or type(track) ~= "table" or type(track.keys) ~= "table" then
			return "clip.track"
		end
		if #track.keys &gt; L.keysPerTrack then
			return "clip.track: too many keys"
		end
		for _, k in track.keys do
			if type(k) ~= "table" or not isNum(k.t) or k.t &lt; 0 or k.t &gt; clip.length + 1e-6 then
				return "clip.key.t"
			end
			local ke = checkVec(k.pos, -L.coord, L.coord, "key.pos") or checkVec(k.rot, -720, 720, "key.rot")
			if ke then
				return ke
			end
			if k.ease ~= nil and k.ease ~= "linear" and k.ease ~= "smooth" and k.ease ~= "step" then
				return "clip.key.ease"
			end
		end
	end
	if #clip.markers &gt; L.markersPerClip then
		return "clip: too many markers"
	end
	for _, m in clip.markers do
		if type(m) ~= "table" or not isNum(m.t) or m.t &lt; 0 or m.t &gt; clip.length + 1e-6 then
			return "clip.marker"
		end
		local me = checkStr(m.name, L.nameLen, "marker.name")
		if me then
			return me
		end
	end
	return nil
end

local function validateRole(role): string?
	if role == nil then
		return nil
	end
	if type(role) ~= "table" or not Format.ROLES[role.type] then
		return "role.type"
	end
	local t = role.type
	if t == "closet" then
		local e = checkPose(role.entry, "closet.entry")
			or checkPose(role.inside, "closet.inside")
			or checkPose(role.exit, "closet.exit")
			or Format.validateClip(role.enterClip)
			or Format.validateClip(role.exitClip)
		if e then
			return e
		end
	elseif t == "door" then
		if type(role.open) ~= "boolean" then
			return "door.open"
		end
		if not isNum(role.openAngle) or math.abs(role.openAngle) &gt; 180 then
			return "door.openAngle"
		end
		if not isNum(role.openTime) or role.openTime &lt; 0 or role.openTime &gt; 10 then
			return "door.openTime"
		end
		local e = checkVec(role.hinge, -200, 200, "door.hinge")
		if e then
			return e
		end
		-- личная комната: дверь достаётся одному игроку, запереть её может только он
		if role.owned ~= nil and type(role.owned) ~= "boolean" then
			return "door.owned"
		end
	elseif t == "statue" then
		-- каменная статуя аватара Roblox по имени пользователя
		local e = checkStr(role.username, 20, "statue.username")
		if e then
			return e
		end
		if not string.match(role.username, "^[%w_]+$") then
			return "statue.username"
		end
		if role.pose ~= "admire" and role.pose ~= "stand" then
			return "statue.pose"
		end
		if role.orb ~= nil and type(role.orb) ~= "boolean" then
			return "statue.orb"
		end
	elseif t == "light" then
		if type(role.on) ~= "boolean" then
			return "light.on"
		end
		if not isNum(role.brightness) or role.brightness &lt; 0 or role.brightness &gt; 40 then
			return "light.brightness"
		end
		if not isNum(role.range) or role.range &lt; 0 or role.range &gt; 60 then
			return "light.range"
		end
		local e = checkColor(role.color, "light.color")
		if e then
			return e
		end
	elseif t == "npc" then
		if type(role.lines) ~= "table" or #role.lines &gt; 40 then
			return "npc.lines"
		end
		for _, line in role.lines do
			local e = checkStr(line.text, L.textLen, "npc.line")
			if e then
				return e
			end
			if not isNum(line.delay) or line.delay &lt; 0 or line.delay &gt; 120 then
				return "npc.line.delay"
			end
			if not isNum(line.duration) or line.duration &lt; 0.5 or line.duration &gt; 60 then
				return "npc.line.duration"
			end
		end
		if role.trigger ~= "roomEnter" and role.trigger ~= "interact" and role.trigger ~= "logic" then
			return "npc.trigger"
		end
		local e = checkRef(role.zone, "npc.zone", true)
			or checkStr(role.greetingClip, 60, "npc.greetingClip", true)
			or checkRef(role.anchor, "npc.anchor", true)
		if e then
			return e
		end
		if not isNum(role.textSize) or role.textSize &lt; 8 or role.textSize &gt; 60 then
			return "npc.textSize"
		end
	elseif t == "creature" then
		if not isNum(role.speed) or role.speed &lt;= 0 or role.speed &gt; 100 then
			return "creature.speed"
		end
		local e = checkStr(role.idleClip, 60, "creature.idleClip", true)
		if e then
			return e
		end
	elseif t == "waypoint" then
		-- маршрут: точка может ссылаться на следующую
		local e = checkRef(role.next, "waypoint.next", true)
		if e then
			return e
		end
	end
	return nil
end

local function validateLabel(label): string?
	if label == nil then
		return nil
	end
	if type(label) ~= "table" then
		return "label"
	end
	local e = checkStr(label.text, L.textLen, "label.text")
	if e then
		return e
	end
	if label.mode ~= "surface" and label.mode ~= "billboard" then
		return "label.mode"
	end
	if not isNum(label.size) or label.size &lt; 6 or label.size &gt; 80 then
		return "label.size"
	end
	if type(label.wrap) ~= "boolean" then
		return "label.wrap"
	end
	return checkColor(label.color, "label.color")
end

local function validatePartFields(p, what): string?
	if not Format.SHAPES[p.shape] then
		return what .. ".shape"
	end
	local e = checkVec(p.size, L.sizeMin, L.sizeMax, what .. ".size") or checkColor(p.color, what .. ".color")
	if e then
		return e
	end
	if not MATERIAL_SET[p.material] then
		return what .. ".material"
	end
	if p.texture ~= nil and not Format.isTexture(p.texture) then
		return what .. ".texture"
	end
	if p.textureTile ~= nil and (not isNum(p.textureTile) or p.textureTile &lt; 0.5 or p.textureTile &gt; 64) then
		return what .. ".textureTile"
	end
	if not isNum(p.transparency) or p.transparency &lt; 0 or p.transparency &gt; 1 then
		return what .. ".transparency"
	end
	return nil
end

function Format.validateObject(obj): string?
	if type(obj) ~= "table" then
		return "object: table expected"
	end
	local e = checkStr(obj.id, 32, "id")
		or checkStr(obj.name, L.nameLen, "name")
		or checkStr(obj.latin, L.latinLen, "latin", true)
		or checkVec(obj.pos, -L.coord, L.coord, "pos")
		or checkVec(obj.rot, -720, 720, "rot")
	if e then
		return e
	end
	if obj.latin ~= nil and not string.match(obj.latin, "^[A-Za-z][A-Za-z0-9_]*$") then
		return "latin: only A-Z, 0-9 and _"
	end
	if type(obj.frozen) ~= "boolean" then
		return "frozen"
	end
	if obj.hidden ~= nil and type(obj.hidden) ~= "boolean" then
		return "hidden"
	end
	if type(obj.physics) ~= "table" or type(obj.physics.anchored) ~= "boolean" or type(obj.physics.canCollide) ~= "boolean" then
		return "physics"
	end
	if obj.kind == "part" then
		e = validatePartFields(obj, "part")
		if e then
			return e
		end
	elseif obj.kind == "model" then
		local m = obj.model
		if type(m) ~= "table" or type(m.parts) ~= "table" or type(m.clips) ~= "table" then
			return "model"
		end
		local n = 0
		for pid, part in m.parts do
			n += 1
			if type(pid) ~= "string" or type(part) ~= "table" or part.id ~= pid then
				return "model.part.id"
			end
			e = validatePartFields(part, "model.part")
				or checkStr(part.name, L.nameLen, "model.part.name")
				or checkVec(part.pos, -L.coord, L.coord, "model.part.pos")
				or checkVec(part.rot, -720, 720, "model.part.rot")
				or checkVec(part.pivot, -L.sizeMax, L.sizeMax, "model.part.pivot")
			if e then
				return e
			end
			if part.parent ~= nil and (type(part.parent) ~= "string" or m.parts[part.parent] == nil) then
				return "model.part.parent"
			end
		end
		if n &gt; L.partsPerModel then
			return "model: too many parts"
		end
		-- запрет циклов в иерархии суставов
		for pid in m.parts do
			local seen = {}
			local cur = pid
			while cur do
				if seen[cur] then
					return "model: joint cycle"
				end
				seen[cur] = true
				cur = m.parts[cur] and m.parts[cur].parent
			end
		end
		local nc = 0
		for cid, clip in m.clips do
			nc += 1
			if clip.id ~= cid then
				return "model.clip.id"
			end
			e = Format.validateClip(clip)
			if e then
				return e
			end
		end
		if nc &gt; L.clipsPerModel then
			return "model: too many clips"
		end
		if m.body ~= nil and m.body ~= "new" and m.body ~= "retro" then
			return "model.body"
		end
	else
		return "kind"
	end
	return validateRole(obj.role) or validateLabel(obj.label)
end

function Format.validateSettings(s): string?
	if type(s) ~= "table" or type(s.camera) ~= "table" or type(s.hud) ~= "table" then
		return "settings"
	end
	local c = s.camera
	if c.mode ~= "first" and c.mode ~= "default" then
		return "camera.mode"
	end
	if not isNum(c.sensitivity) or c.sensitivity &lt; 0.05 or c.sensitivity &gt; 5 then
		return "camera.sensitivity"
	end
	if not isNum(c.fov) or c.fov &lt; 40 or c.fov &gt; 110 then
		return "camera.fov"
	end
	if not isNum(c.bob) or c.bob &lt; 0 or c.bob &gt; 2 then
		return "camera.bob"
	end
	if type(s.hud.health) ~= "boolean" then
		return "hud.health"
	end
	local w = s.weather
	if w ~= nil then
		if type(w) ~= "table" or not Format.WEATHER_SET[w.type] then
			return "weather.type"
		end
		if w.auto ~= nil and type(w.auto) ~= "boolean" then
			return "weather.auto"
		end
		if w.minutes ~= nil and (not isNum(w.minutes) or w.minutes &lt; 1 or w.minutes &gt; 120) then
			return "weather.minutes"
		end
	end
	local m = s.music
	if m ~= nil then
		if type(m) ~= "table" or not Format.isSoundId(m.id) then
			return "music.id"
		end
		if not isNum(m.volume) or m.volume &lt; 0 or m.volume &gt; 1 then
			return "music.volume"
		end
	end
	local lt = s.lighting
	if lt ~= nil then
		if type(lt) ~= "table" then
			return "lighting"
		end
		if lt.clockTime ~= nil and (not isNum(lt.clockTime) or lt.clockTime &lt; 0 or lt.clockTime &gt; 24) then
			return "lighting.clockTime"
		end
		if lt.dayNight ~= nil and type(lt.dayNight) ~= "boolean" then
			return "lighting.dayNight"
		end
		if lt.dayMinutes ~= nil and (not isNum(lt.dayMinutes) or lt.dayMinutes &lt; 1 or lt.dayMinutes &gt; 240) then
			return "lighting.dayMinutes"
		end
		if lt.brightness ~= nil and (not isNum(lt.brightness) or lt.brightness &lt; 0 or lt.brightness &gt; 10) then
			return "lighting.brightness"
		end
	end
	return nil
end

Format.WEATHER = { "Clear", "Rain", "Snow", "Fog", "Storm" }
Format.WEATHER_SET = { Clear = true, Rain = true, Snow = true, Fog = true, Storm = true }

-- Погода в момент now. При автосмене последовательность одинакова у сервера и всех
-- клиентов: она зависит только от общего серверного времени
function Format.weatherAt(weather, base: string, at: number, now: number): string
	if not weather or not weather.auto then
		return base
	end
	local period = math.max(1, weather.minutes or 5) * 60
	local step = math.floor(math.max(0, now - at) / period)
	if step == 0 then
		return base
	end
	local list = Format.WEATHER
	local idx = (table.find(list, base) or 1) - 1
	-- каждый следующий период — другая погода; выбор повторяем на всех клиентах
	for j = 1, math.min(step, 100000) do
		local h = (j * 1103515245 + 12345) % 2147483648
		idx = (idx + 1 + (h // 65536) % (#list - 1)) % #list
	end
	return list[idx + 1]
end

function Format.isSoundId(s): boolean
	if type(s) ~= "string" then
		return false
	end
	local id = string.match(s, "^%d+$") or string.match(s, "^rbxassetid://(%d+)$")
	return id ~= nil and #id &lt;= 20
end

-- Время суток в момент now (секунды), если сутки начались в момент at со значения base
function Format.clockAt(lighting, base: number, at: number, now: number): number
	if not lighting or not lighting.dayNight then
		return base
	end
	local minutes = lighting.dayMinutes or 12
	return (base + (now - at) / (minutes * 60) * 24) % 24
end

function Format.isNight(clock: number): boolean
	return clock &lt; 6 or clock &gt;= 18
end

function Format.validateProject(p): string?
	if type(p) ~= "table" or p.format ~= Format.VERSION then
		return "format"
	end
	if type(p.map) ~= "table" or type(p.map.objects) ~= "table" then
		return "map"
	end
	if type(p.meta) ~= "table" then
		return "meta"
	end
	local e = checkStr(p.meta.name, L.nameLen, "meta.name")
	if e then
		return e
	end
	local n = 0
	for id, obj in p.map.objects do
		n += 1
		if obj.id ~= id then
			return "object id mismatch"
		end
		e = Format.validateObject(obj)
		if e then
			return id .. ": " .. e
		end
	end
	if n &gt; L.objects then
		return "too many objects"
	end
	if type(p.logic) ~= "table" or type(p.logic.text) ~= "table" then
		return "logic"
	end
	if type(p.logic.text.source) ~= "string" or #p.logic.text.source &gt; L.codeLen then
		return "logic.text"
	end
	e = Format.validateSettings(p.settings)
	if e then
		return e
	end
	if Util.approxSize(p) &gt; L.dataBytes then
		return "project too large"
	end
	return nil
end

return Format
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX0000000E">
          <Properties>
            <string name="Name">Ids</string>
            <ProtectedString name="Source">--!nonstrict
-- Постоянные ID объектов проекта
-- ID выдаются из счётчика проекта и никогда не переиспользуются
-- Имена (отображаемое и латинское) можно менять, ссылки хранят только ID

local Ids = {}

local DIGITS = "0123456789abcdefghijklmnopqrstuvwxyz"

local function base36(n: number): string
	if n == 0 then
		return "0"
	end
	local s = ""
	while n &gt; 0 do
		local d = n % 36
		s = string.sub(DIGITS, d + 1, d + 1) .. s
		n = n // 36
	end
	return s
end

function Ids.alloc(project, prefix: string): string
	local n = project.nextId or 1
	project.nextId = n + 1
	return prefix .. "_" .. base36(n)
end

-- Латинское имя: только буквы, цифры, подчёркивание; начинается с буквы
function Ids.isValidLatin(s: string): boolean
	return string.match(s, "^[A-Za-z][A-Za-z0-9_]*$") ~= nil and #s &lt;= 40
end

function Ids.latinTaken(project, latin: string, exceptId: string?): boolean
	for id, obj in project.map.objects do
		if id ~= exceptId and obj.latin == latin then
			return true
		end
	end
	return false
end

-- Предлагает свободное латинское имя: Closet01, Closet02, ...
function Ids.suggestLatin(project, base: string, exceptId: string?): string
	local clean = string.gsub(base, "[^A-Za-z0-9_]", "")
	if clean == "" or not string.match(clean, "^[A-Za-z]") then
		clean = "Obj" .. clean
	end
	clean = string.gsub(clean, "%d+$", "")
	if clean == "" then
		clean = "Obj"
	end
	clean = string.sub(clean, 1, 34)
	for i = 1, 9999 do
		local candidate = string.format("%s%02d", clean, i)
		if not Ids.latinTaken(project, candidate, exceptId) then
			return candidate
		end
	end
	return clean .. tostring(os.time())
end

-- Обходит значение и вызывает fn для каждой ссылки на объект карты
-- Ссылка в данных: таблица {ref = "o_xx"}
function Ids.forEachRef(value: any, fn: (holder: any) -&gt; ())
	if type(value) ~= "table" then
		return
	end
	if type(value.ref) == "string" then
		fn(value)
	end
	for _, v in value do
		if type(v) == "table" then
			Ids.forEachRef(v, fn)
		end
	end
end

return Ids
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX0000000F">
          <Properties>
            <string name="Name">Logic</string>
            <ProtectedString name="Source">--!nonstrict
-- Логика карты: общий вход для блоков и текста

local Parser = require(script.Parser)
local Printer = require(script.Printer)
local Validator = require(script.Validator)
local Commands = require(script.Commands)

local Logic = {}

Logic.Parser = Parser
Logic.Printer = Printer
Logic.Validator = Validator
Logic.Commands = Commands
Logic.Interpreter = require(script.Interpreter)

-- Латинское имя объекта не должно совпадать с командой или ключевым словом
function Logic.isReservedName(name: string): boolean
	return Parser.KEYWORDS[name] ~= nil
		or Commands.actions[name] ~= nil
		or Commands.conditions[name] ~= nil
		or Commands.events[name] ~= nil
end

function Logic.nameResolver(project)
	local byLatin = {}
	for id, obj in project.map.objects do
		if obj.latin then
			byLatin[obj.latin] = id
		end
	end
	return function(name: string): string?
		return byLatin[name]
	end
end

function Logic.nameOf(project)
	return function(id: string): string
		local obj = project.map.objects[id]
		if obj and obj.latin then
			return obj.latin
		end
		return "Missing_" .. string.gsub(id, "[^%w]", "_")
	end
end

-- Текст хранится как есть, плюс таблица «имя -&gt; ID» на момент сохранения
-- Если объект переименовали, имя в тексте обновится; если удалили, проверка покажет строку
function Logic.refreshText(project): boolean
	local text = project.logic.text
	local renames = {}
	local changed = false
	local newRefs = {}
	for name, id in text.refs or {} do
		local obj = project.map.objects[id]
		if obj and obj.latin and obj.latin ~= name then
			renames[name] = obj.latin
			newRefs[obj.latin] = id
			changed = true
		else
			newRefs[name] = id
		end
	end
	if changed then
		text.source = Parser.renameIdentifiers(text.source, renames)
		text.refs = newRefs
	end
	return changed
end

-- Собирает таблицу ссылок для сохранения текста
function Logic.collectRefs(tree)
	local refs = {}
	local function walk(v)
		if type(v) ~= "table" then
			return
		end
		if v.kind == "ref" and v.name and v.ref ~= "" then
			refs[v.name] = v.ref
		end
		for _, x in v do
			if type(x) == "table" then
				walk(x)
			end
		end
	end
	walk(tree)
	return refs
end

-- Возвращает дерево и список ошибок (пустой, если всё в порядке)
function Logic.compile(project)
	local lg = project.logic
	local tree
	if lg.mode == "text" then
		local parsed, parseErrors = Parser.parse(lg.text.source, Logic.nameResolver(project))
		if parseErrors then
			return parsed, parseErrors
		end
		tree = parsed
	else
		tree = lg.blocks
	end
	local errors = Validator.validate(tree, project)
	return tree, errors
end

function Logic.toText(project, tree): string
	return Printer.print(tree, Logic.nameOf(project))
end

-- Объекты и роли, которые ссылаются на удалённые цели
function Logic.brokenBindings(project)
	local out = {}
	local objects = project.map.objects
	for id, obj in objects do
		local role = obj.role
		if role then
			for _, field in { "zone", "anchor", "next" } do
				local r = role[field]
				if type(r) == "table" and r.ref and not objects[r.ref] then
					table.insert(out, { objectId = id, field = field, ref = r.ref })
				end
			end
		end
	end
	local tree, errors = Logic.compile(project)
	if tree then
		for _, e in errors do
			if e.broken then
				table.insert(out, { logic = true, line = e.line, bid = e.bid, message = e.message, ref = e.ref })
			end
		end
	end
	return out
end

return Logic
</ProtectedString>
          </Properties>
          <Item class="ModuleScript" referent="RBX00000010">
