	end
	chandelier(c, 0, -11, 3)
	chandelier(c, 0, -23, 3)
	d.windowZ = { -16 }
end

L.kitchen = function(c)
	local d, o = c.d, c.origin
	hide(c, slotBack(d, o, -8))
	hide(c, slotBack(d, o, 7))
	local _, t1 = Props.counter(c.m, slotL(d, o, -9), 10)
