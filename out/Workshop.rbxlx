        <Item class="ModuleScript" referent="RBX0000000A">
          <Properties>
            <string name="Name">Anim</string>
            <ProtectedString name="Source">--!nonstrict
-- Клипы с ключевыми кадрами: правка ключей, интерполяция, метки, проверка дорожек
-- Дорожка клипа привязана к детали модели по её ID. Ключ хранит смещение детали
-- относительно позы покоя: pos (в координатах детали) и rot (градусы, YXZ)

local MathX = require(script.Parent.MathX)

local Anim = {}

Anim.KEY_EPS = 1 / 120
Anim.SPECIAL_TRACKS = { PlayerRoot = true, Camera = true }

local function sortKeys(track)
	table.sort(track.keys, function(a, b)
		return a.t &lt; b.t
	end)
end

local function roundT(t: number): number
	return math.floor(t * 1000 + 0.5) / 1000
end

function Anim.ensureTrack(clip, trackId: string)
	local track = clip.tracks[trackId]
	if not track then
		track = { keys = {} }
		clip.tracks[trackId] = track
	end
	return track
end

function Anim.findKey(clip, trackId: string, t: number)
	local track = clip.tracks[trackId]
	if not track then
		return nil, nil
	end
	for i, k in track.keys do
		if math.abs(k.t - t) &lt;= Anim.KEY_EPS then
			return k, i
		end
	end
	return nil, nil
end

function Anim.setKey(clip, trackId: string, t: number, pos, rot, ease: string?)
	t = roundT(math.clamp(t, 0, clip.length))
	local track = Anim.ensureTrack(clip, trackId)
	local existing = Anim.findKey(clip, trackId, t)
	if existing then
		existing.pos = { pos[1], pos[2], pos[3] }
		existing.rot = { rot[1], rot[2], rot[3] }
		existing.ease = ease or existing.ease or "smooth"
		return existing
	end
	local key = { t = t, pos = { pos[1], pos[2], pos[3] }, rot = { rot[1], rot[2], rot[3] }, ease = ease or "smooth" }
	table.insert(track.keys, key)
	sortKeys(track)
	return key
end

function Anim.removeKey(clip, trackId: string, t: number): boolean
	local _, i = Anim.findKey(clip, trackId, t)
	if not i then
		return false
	end
	table.remove(clip.tracks[trackId].keys, i)
	return true
end

function Anim.copyKey(clip, trackId: string, fromT: number, toT: number): boolean
	local k = Anim.findKey(clip, trackId, fromT)
	if not k then
		return false
	end
	Anim.setKey(clip, trackId, toT, k.pos, k.rot, k.ease)
	return true
end

function Anim.moveKey(clip, trackId: string, fromT: number, toT: number): boolean
	local k, i = Anim.findKey(clip, trackId, fromT)
	if not k or not i then
		return false
	end
	local pos, rot, ease = k.pos, k.rot, k.ease
	table.remove(clip.tracks[trackId].keys, i)
	Anim.setKey(clip, trackId, toT, pos, rot, ease)
	return true
end

-- Копирует все ключи в момент fromT (по всем дорожкам) в момент toT
function Anim.copyFrame(clip, fromT: number, toT: number): number
	local n = 0
	for trackId in clip.tracks do
		if Anim.copyKey(clip, trackId, fromT, toT) then
			n += 1
		end
	end
	return n
end

function Anim.setLength(clip, length: number)
	clip.length = math.clamp(length, 0.1, 120)
	for _, track in clip.tracks do
		for _, k in track.keys do
			if k.t &gt; clip.length then
				k.t = clip.length
			end
		end
		-- после обрезки могли появиться ключи в одной точке: оставляем последний
		local seen = {}
		for i = #track.keys, 1, -1 do
			local tt = roundT(track.keys[i].t)
			if seen[tt] then
				table.remove(track.keys, i)
			else
				seen[tt] = true
			end
		end
		sortKeys(track)
	end
end

local function ease(kind: string?, a: number): number
	if kind == "step" then
		return 0
	elseif kind == "linear" then
		return a
	end
	return a * a * (3 - 2 * a)
end

-- Значение дорожки в момент t: pos, rot (эйлер) или nil, если ключей нет
function Anim.sampleTrack(track, t: number)
	local keys = track.keys
	local n = #keys
	if n == 0 then
		return nil, nil
	end
	if t &lt;= keys[1].t then
		return keys[1].pos, keys[1].rot
	end
	if t &gt;= keys[n].t then
		return keys[n].pos, keys[n].rot
	end
	for i = 1, n - 1 do
		local k0, k1 = keys[i], keys[i + 1]
		if t &gt;= k0.t and t &lt;= k1.t then
			local span = k1.t - k0.t
			local a = if span &gt; 0 then (t - k0.t) / span else 1
			a = ease(k0.ease, a)
			local pos = MathX.lerp(k0.pos, k1.pos, a)
			local q = MathX.slerp(
				MathX.quatFromMat(MathX.matFromEuler(k0.rot)),
				MathX.quatFromMat(MathX.matFromEuler(k1.rot)),
				a
			)
			return pos, MathX.eulerFromMat(MathX.matFromQuat(q))
		end
	end
	return keys[n].pos, keys[n].rot
end

function Anim.sample(clip, t: number)
	local out = {}
	for trackId, track in clip.tracks do
		local pos, rot = Anim.sampleTrack(track, t)
		if pos then
			out[trackId] = { pos = pos, rot = rot }
		end
	end
	return out
end

-- Приводит время воспроизведения к клипу. Возвращает локальное время и признак завершения
function Anim.wrapTime(clip, elapsed: number): (number, boolean)
	if clip.loop then
		if clip.length &lt;= 0 then
			return 0, false
		end
		return elapsed % clip.length, false
	end
	if elapsed &gt;= clip.length then
		return clip.length, true
	end
	return elapsed, false
end

-- Метки, пройденные при переходе от прошедшего времени e0 к e1 (e0 &lt; m &lt;= e1)
function Anim.markersCrossed(clip, e0: number, e1: number)
	local out = {}
	if e1 &lt;= e0 or #clip.markers == 0 then
		return out
	end
	local len = clip.length
	local function scan(a: number, b: number)
		for _, m in clip.markers do
			if m.t &gt; a and m.t &lt;= b then
				table.insert(out, m)
			end
		end
	end
	if not clip.loop then
		-- метка ровно на нуле срабатывает в первом кадре
		if e0 &lt;= 0 then
			for _, m in clip.markers do
				if m.t == 0 then
					table.insert(out, m)
				end
			end
		end
		scan(e0, math.min(e1, len))
		return out
	end
	local cycle0 = e0 // len
	local cycle1 = e1 // len
	if cycle0 == cycle1 then
		scan(e0 - cycle0 * len, e1 - cycle0 * len)
	else
		scan(e0 - cycle0 * len, len)
		for _ = cycle0 + 1, math.min(cycle1 - 1, cycle0 + 3) do
			scan(-1, len)
		end
		scan(-1, e1 - cycle1 * len)
	end
	return out
end

function Anim.addMarker(clip, id: string, t: number, name: string)
	local m = { id = id, t = roundT(math.clamp(t, 0, clip.length)), name = name }
	table.insert(clip.markers, m)
	table.sort(clip.markers, function(a, b)
		return a.t &lt; b.t
	end)
	return m
end

function Anim.removeMarker(clip, id: string): boolean
	for i, m in clip.markers do
		if m.id == id then
			table.remove(clip.markers, i)
			return true
		end
	end
	return false
end

-- Проверка клипа на модели: какие дорожки ссылаются на отсутствующие детали
-- Ключи таких дорожек не удаляются: автор может вернуть деталь или перенести кадры
function Anim.validate(clip, parts: { [string]: any }, allowSpecial: boolean?)
	local missing = {}
	for trackId, track in clip.tracks do
		local special = allowSpecial and Anim.SPECIAL_TRACKS[trackId]
		if not special and parts[trackId] == nil and #track.keys &gt; 0 then
			table.insert(missing, trackId)
		end
	end
	table.sort(missing)
	return missing
end

-- Переносит дорожку на другую деталь (например, после замены удалённой лапы)
function Anim.retarget(clip, fromTrack: string, toTrack: string): boolean
	local t = clip.tracks[fromTrack]
	if not t or clip.tracks[toTrack] then
		return false
	end
	clip.tracks[toTrack] = t
	clip.tracks[fromTrack] = nil
	return true
end

return Anim
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX0000000B">
          <Properties>
            <string name="Name">CastleLayout</string>
            <ProtectedString name="Source">--!nonstrict
-- План замка без Roblox API: сетка 7 × 7 клеток по 32 studs на каждом ярусе,
-- какие клетки заняты какими комнатами, где коридоры, лестницы и двери.
-- Сборщик строит стены по этому плану, а тесты проверяют, что в каждую комнату можно дойти

local Layout = {}

Layout.C = 32 -- размер клетки
Layout.N = 7 -- клеток по стороне
Layout.H = 18 -- высота этажа
Layout.HALF = Layout.C * Layout.N / 2 -- 112: край главного здания
-- верх пола каждого яруса
Layout.LEVELS = { U = -18, G = 0, F1 = 18, F2 = 36 }
Layout.ORDER = { "U", "G", "F1", "F2" }

-- центр клетки
function Layout.center(i: number, j: number): (number, number)
	return (i - 3) * Layout.C, (j - 3) * Layout.C
end

-- прямоугольные комнаты: { kind, i0, i1, j0, j1, tall = двойная высота, special = строится отдельно }
local PLAN = {
	U = {
		{ "library", 2, 6, 0, 4, special = true },
		{ "storeroom", 0, 1, 0, 1 },
		{ "prison_guard", 0, 0, 2, 2, stairsFrom = "G" },
		{ "guardroom", 1, 1, 2, 2 },
		{ "prison", 0, 1, 3, 6, special = true },
		{ "cellar", 2, 6, 5, 5 },
		{ "storage", 2, 2, 6, 6 },
		{ "sewer", 3, 6, 6, 6, special = true },
	},
	G = {
		{ "grand_hall", 2, 4, 0, 1, tall = true },
		{ "throne", 2, 4, 4, 6, tall = true, special = true },
		{ "kitchen", 0, 1, 0, 1 },
		{ "dining", 0, 1, 4, 5 },
		{ "servants", 0, 1, 6, 6 },
		{ "stairs_down", 0, 0, 2, 2, down = "prison" },
		{ "stairs", 1, 1, 2, 2 },
		{ "shop", 2, 2, 2, 2 },
		{ "casino", 4, 4, 2, 2 },
		{ "stairs", 5, 5, 2, 2 },
		{ "stairs_down", 6, 6, 2, 2, down = "library" },
		{ "barracks", 5, 6, 0, 1 },
		{ "training", 5, 6, 4, 5 },
		{ "chapel", 5, 6, 6, 6 },
	},
	F1 = {
		{ "bedroom", 0, 0, 0, 0 },
		{ "bedroom", 1, 1, 0, 0 },
		{ "study", 0, 0, 1, 1 },
		{ "bedroom", 1, 1, 1, 1 },
		{ "sitting", 0, 0, 2, 2 },
		{ "stairs", 1, 1, 2, 2 },
		{ "reading", 2, 2, 2, 2 },
		{ "trophy", 4, 4, 2, 2 },
		{ "stairs", 5, 5, 2, 2 },
		{ "sitting", 6, 6, 2, 2 },
		{ "music", 0, 1, 4, 5 },
		{ "bath", 0, 0, 6, 6 },
		{ "bedroom", 1, 1, 6, 6 },
		{ "bedroom", 5, 5, 0, 0 },
		{ "bedroom", 6, 6, 0, 0 },
		{ "gallery", 5, 6, 1, 1 },
		{ "lounge", 5, 6, 4, 4 },
		{ "nursery", 5, 5, 5, 5 },
		{ "wardrobe", 6, 6, 5, 5 },
		{ "guest_suite", 5, 6, 6, 6 },
	},
	F2 = {
		{ "observatory", 0, 0, 0, 0 },
		{ "treasury", 1, 2, 0, 1 },
		{ "council", 4, 5, 0, 1 },
		{ "map_room", 6, 6, 0, 0 },
		{ "study", 0, 0, 1, 1 },
		{ "trophy", 6, 6, 1, 1 },
		{ "bedroom", 0, 0, 2, 2 },
		{ "landing", 1, 1, 2, 2 },
		{ "bedroom", 2, 2, 2, 2 },
		{ "bedroom", 4, 4, 2, 2 },
		{ "landing", 5, 5, 2, 2 },
		{ "sitting", 6, 6, 2, 2 },
		{ "bedroom", 0, 0, 4, 4 },
		{ "royal_dining", 1, 2, 4, 4 },
		{ "lounge", 4, 5, 4, 4 },
		{ "bath", 6, 6, 4, 4 },
		{ "wardrobe", 0, 0, 5, 5 },
		{ "chapel_small", 0, 0, 6, 6 },
		{ "queen", 1, 2, 5, 6 },
		{ "king", 4, 5, 5, 6 },
		{ "bath", 6, 6, 5, 5 },
		{ "study", 6, 6, 6, 6 },
	},
}

-- клетки коридоров на каждом ярусе
local HALLS = {
	U = {},
	G = { { 3, 2 } },
	F1 = { { 3, 2 } },
	F2 = { { 3, 0 }, { 3, 1 }, { 3, 2 }, { 3, 4 }, { 3, 5 }, { 3, 6 } },
}
-- ряд j = 3 — коридор на всех надземных ярусах
for _, lv in { "G", "F1", "F2" } do
	for i = 0, 6 do
		table.insert(HALLS[lv], { i, 3 })
	end
end
-- клетки над залами двойной высоты пустые
local VOID = { F1 = {} }
for i = 2, 4 do
	for _, j in { 0, 1, 4, 5, 6 } do
		table.insert(VOID.F1, { i, j })
	end
end

-- Строит план уровня: grid[i][j] = id комнаты (или "void"), rooms[id] = комната, doors = список
function Layout.build(level: string)
	local grid = {}
	for i = 0, 6 do
		grid[i] = {}
	end
	local rooms = {}
	local function add(room)
		room.id = #rooms + 1
		room.level = level
		rooms[room.id] = room
		for i = room.i0, room.i1 do
			for j = room.j0, room.j1 do
				assert(grid[i][j] == nil, string.format("%s: клетка %d,%d занята дважды", level, i, j))
				grid[i][j] = room.id
			end
		end
		return room
	end
	for _, r in PLAN[level] do
		add({ kind = r[1], i0 = r[2], i1 = r[3], j0 = r[4], j1 = r[5], tall = r.tall, special = r.special, down = r.down })
	end
	local hall = nil
	for _, c in HALLS[level] do
		if not hall then
			hall = add({ kind = "hall", i0 = c[1], i1 = c[1], j0 = c[2], j1 = c[2], cells = {} })
			table.insert(hall.cells, c)
		else
			grid[c[1]][c[2]] = hall.id
			table.insert(hall.cells, c)
		end
	end
	for _, c in (VOID[level] or {}) do
		assert(grid[c[1]][c[2]] == nil, "void over room")
		grid[c[1]][c[2]] = "void"
	end
	for i = 0, 6 do
		for j = 0, 6 do
			assert(grid[i][j] ~= nil, string.format("%s: пустая клетка %d,%d", level, i, j))
		end
	end

	-- соседство: пары клеток через общую стену
	local edges = {} -- [a.."-"..b] = список { i, j, side } (сторона +x или +z от клетки i,j)
	local function key(a, b)
		return if a &lt; b then a .. "-" .. b else b .. "-" .. a
	end
	for i = 0, 6 do
		for j = 0, 6 do
			for _, d in { { 1, 0, "x" }, { 0, 1, "z" } } do
				local ni, nj = i + d[1], j + d[2]
				if ni &lt;= 6 and nj &lt;= 6 then
					local a, b = grid[i][j], grid[ni][nj]
					if a ~= b and type(a) == "number" and type(b) == "number" then
						local k = key(a, b)
						edges[k] = edges[k] or { a = math.min(a, b), b = math.max(a, b), list = {} }
						table.insert(edges[k].list, { i = i, j = j, axis = d[3] })
					end
				end
			end
		end
	end

	-- лестничные клетки и особые зоны соединяются только с коридором
	local function onlyHall(room)
		return room.kind == "stairs" or room.kind == "stairs_down" or room.kind == "landing" or room.special or room.kind == "prison_guard"
	end
	local doors = {}
	local connected = {}
	local function addDoor(e, wide)
		local mid = e.list[math.ceil(#e.list / 2)]
		table.insert(doors, { a = e.a, b = e.b, i = mid.i, j = mid.j, axis = mid.axis, wide = wide })
		connected[e.a] = true
		connected[e.b] = true
	end
	local function allowed(ra, rb)
		local function pair(x, y)
			return (ra.kind == x and rb.kind == y) or (ra.kind == y and rb.kind == x)
		end
		-- библиотека открывается в винный погреб с верхней галереи
		if ra.kind == "library" or rb.kind == "library" then
			return pair("library", "cellar")
		end
		-- в тюрьму и в тайный ход обычных дверей нет
		if ra.kind == "sewer" or rb.kind == "sewer" or ra.kind == "prison" or rb.kind == "prison" then
			return false
		end
		if pair("prison_guard", "guardroom") then
			return true
		end
		if onlyHall(ra) and rb.kind ~= "hall" then
			return false
		end
		if onlyHall(rb) and ra.kind ~= "hall" then
			return false
		end
		return true
	end
	-- 1) все комнаты, касающиеся коридора, получают дверь в коридор
	local sorted = {}
	for _, e in edges do
		table.insert(sorted, e)
	end
	table.sort(sorted, function(x, y)
		if x.a ~= y.a then
			return x.a &lt; y.a
		end
		return x.b &lt; y.b
	end)
	for _, e in sorted do
		local ra, rb = rooms[e.a], rooms[e.b]
		if (ra.kind == "hall" or rb.kind == "hall") and allowed(ra, rb) then
			addDoor(e, (ra.tall or rb.tall or ra.kind == "throne" or rb.kind == "throne") == true)
		end
	end
	-- 2) остальные подключаются к уже связанным соседям (обход в ширину)
	if not hall then
		-- подземный ярус: начало у лестницы из главного зала
		for _, r in rooms do
			if r.kind == "prison_guard" or r.kind == "library" then
				connected[r.id] = true
			end
		end
	end
	local changed = true
	while changed do
		changed = false
		for _, e in sorted do
			local ra, rb = rooms[e.a], rooms[e.b]
			if connected[e.a] ~= connected[e.b] and allowed(ra, rb) then
				addDoor(e, false)
				changed = true
			end
		end
	end
	-- 3) немного дополнительных дверей между жилыми комнатами, чтобы было как в старом доме
	local extra = 0
	for _, e in sorted do
		local ra, rb = rooms[e.a], rooms[e.b]
		local has = false
		for _, d in doors do
			if (d.a == e.a and d.b == e.b) then
				has = true
			end
		end
		if not has and allowed(ra, rb) and ra.kind ~= "hall" and rb.kind ~= "hall" and (e.a + e.b) % 3 == 0 and extra &lt; 4 then
			addDoor(e, false)
			extra += 1
		end
	end
	return { level = level, grid = grid, rooms = rooms, doors = doors, connected = connected }
end

-- Проверка связности (для тестов): из какой комнаты в какую можно пройти
function Layout.reachable(plan, startId)
	local adj = {}
	for _, d in plan.doors do
		adj[d.a] = adj[d.a] or {}
		adj[d.b] = adj[d.b] or {}
		table.insert(adj[d.a], d.b)
		table.insert(adj[d.b], d.a)
	end
	local seen = { [startId] = true }
	local queue = { startId }
	while #queue &gt; 0 do
		local id = table.remove(queue, 1)
		for _, n in adj[id] or {} do
			if not seen[n] then
				seen[n] = true
				table.insert(queue, n)
			end
		end
	end
	return seen
end

return Layout
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX0000000C">
          <Properties>
            <string name="Name">CastleRules</string>
            <ProtectedString name="Source">--!nonstrict
-- Правила «The Castle» без Roblox API: роли, предметы, голод и жажда, инвентарь, казино

local Rules = {}

-- Роли и сколько их может быть одновременно
Rules.ROLES = {
	king = { max = 1, weapon = true, rank = 7 },
	queen = { max = 1, weapon = false, rank = 6 },
	commander = { max = 1, weapon = true, rank = 5 },
	guard = { max = 6, weapon = true, rank = 4 },
	cook = { max = 3, weapon = false, rank = 2 },
	servant = { max = 6, weapon = false, rank = 2 },
	librarian = { max = 2, weapon = false, rank = 2 },
	peasant = { max = 99, weapon = false, rank = 1 },
}
Rules.ROLE_ORDER = { "king", "queen", "commander", "guard", "cook", "servant", "librarian", "peasant" }
-- роли, которые нельзя взять самому: короля сажает трон, королеву и военачальника назначает король
Rules.APPOINTED = { king = true, queen = true, commander = true }

-- Предметы. food/drink — сколько восстанавливают; roles — кому можно держать
Rules.ITEMS = {
	bread = { kind = "food", food = 25 },
	apple = { kind = "food", food = 15, drink = 5 },
	meat = { kind = "food", food = 40 },
	soup = { kind = "food", food = 35, drink = 20 },
	cake = { kind = "food", food = 30 },
	water = { kind = "drink", drink = 40 },
	juice = { kind = "drink", drink = 30, food = 5 },
	spoon = { kind = "tool" },
	broom = { kind = "tool" },
	book = { kind = "tool" },
	scepter = { kind = "tool", roles = { king = true } },
	sword = { kind = "weapon", damage = 20, cooldown = 0.8, roles = { king = true, commander = true, guard = true } },
	cuffs = { kind = "tool", roles = { king = true, commander = true, guard = true } },
	backpack = { kind = "backpack" },
}

Rules.MAX = 100
Rules.HUNGER_PER_SEC = 100 / 900 -- полная сытость на 15 минут
Rules.THIRST_PER_SEC = 100 / 600 -- полная жажда на 10 минут
Rules.STARVE_DAMAGE = 2 -- урон в секунду, когда еда или вода на нуле

function Rules.capacity(hasBackpack: boolean): number
	return if hasBackpack then 5 else 3
end

function Rules.canHold(item: string, role: string?): boolean
	local def = Rules.ITEMS[item]
	if not def then
		return false
	end
	return def.roles == nil or (role ~= nil and def.roles[role] == true)
end

-- Добавить предмет в инвентарь (список имён). Рюкзак сам слот не занимает
function Rules.addItem(inv: { string }, item: string, hasBackpack: boolean): (boolean, string?)
	if not Rules.ITEMS[item] then
		return false, "unknown"
	end
	if item == "backpack" then
		return not hasBackpack, if hasBackpack then "have" else nil
	end
	if #inv &gt;= Rules.capacity(hasBackpack) then
		return false, "full"
	end
	table.insert(inv, item)
	return true, nil
end

function Rules.removeItem(inv: { string }, item: string): boolean
	local i = table.find(inv, item)
	if not i then
		return false
	end
	table.remove(inv, i)
	return true
end

-- Голод и жажда за dt секунд. Король не голодает
function Rules.tick(stats, dt: number, isKing: boolean)
	if isKing then
		stats.food, stats.drink = Rules.MAX, Rules.MAX
		return 0
	end
	stats.food = math.max(0, stats.food - Rules.HUNGER_PER_SEC * dt)
	stats.drink = math.max(0, stats.drink - Rules.THIRST_PER_SEC * dt)
	if stats.food &lt;= 0 or stats.drink &lt;= 0 then
		return Rules.STARVE_DAMAGE * dt
	end
	return 0
end

-- Съесть или выпить. Сытый не может есть, кроме короля
function Rules.consume(stats, item: string, isKing: boolean): (boolean, string?)
	local def = Rules.ITEMS[item]
	if not def or (def.kind ~= "food" and def.kind ~= "drink") then
		return false, "not_food"
	end
	local food, drink = def.food or 0, def.drink or 0
	if not isKing then
		local helps = (food &gt; 0 and stats.food &lt; Rules.MAX) or (drink &gt; 0 and stats.drink &lt; Rules.MAX)
		if not helps then
			return false, "full"
		end
	end
	stats.food = math.min(Rules.MAX, stats.food + food)
	stats.drink = math.min(Rules.MAX, stats.drink + drink)
	return true, nil
end

-- Можно ли взять роль (без учёта назначаемых)
function Rules.canTake(role: string, counts: { [string]: number }): boolean
	local def = Rules.ROLES[role]
	if not def or Rules.APPOINTED[role] then
		return false
	end
	return (counts[role] or 0) &lt; def.max
end

-- Казино: игровой автомат. rand(a, b) — целое число
Rules.SLOT_SYMBOLS = { "crown", "sword", "apple", "bell", "skull" }
function Rules.slots(bet: number, rand: (number, number) -&gt; number)
	local s = {}
	for i = 1, 3 do
		s[i] = Rules.SLOT_SYMBOLS[rand(1, #Rules.SLOT_SYMBOLS)]
	end
	local win = 0
	if s[1] == s[2] and s[2] == s[3] then
		win = if s[1] == "crown" then bet * 10 elseif s[1] == "skull" then 0 else bet * 5
	elseif s[1] == s[2] or s[2] == s[3] or s[1] == s[3] then
		win = math.floor(bet * 1.5)
	end
	return s, win
end

-- Орёл или решка: чуть меньше половины шансов удвоить ставку
function Rules.coinFlip(bet: number, rand: (number, number) -&gt; number)
	local roll = rand(1, 100)
	return roll &lt;= 48, if roll &lt;= 48 then bet * 2 else 0
end

Rules.BETS = { 10, 50, 100 }
Rules.START_GOLD = 100

-- Магазин: украшения навсегда, цена в золоте
Rules.SHOP = {
	{ id = "flower_crown", price = 150 },
	{ id = "cape_red", price = 250 },
	{ id = "cape_blue", price = 250 },
	{ id = "halo", price = 400 },
	{ id = "glasses", price = 120 },
	{ id = "feather_hat", price = 200 },
	{ id = "backpack", price = 300 },
	{ id = "wings", price = 800 },
}
Rules.SHOP_BY_ID = {}
for _, s in Rules.SHOP do
	Rules.SHOP_BY_ID[s.id] = s
end

-- Король может призвать до 6 стражников-NPC, по 2 за раз, раз в 120 секунд
Rules.MINION_MAX = 6
Rules.MINION_BATCH = 2
Rules.MINION_COOLDOWN = 120

function Rules.canSummon(alive: number, lastAt: number?, now: number): (boolean, string?)
	if alive &gt;= Rules.MINION_MAX then
		return false, "max"
	end
	if lastAt and now - lastAt &lt; Rules.MINION_COOLDOWN then
		return false, "cooldown"
	end
	return true, nil
end

return Rules
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX0000000D">
          <Properties>
            <string name="Name">CastleSounds</string>
            <ProtectedString name="Source">--!nonstrict
-- Звуки замка. Встроенные звуки Roblox работают сразу. Звук дождя взят из открытой
-- библиотеки; если он не играет, впишите сюда свой "rbxassetid://ID"
return {
	steps = "rbxasset://sounds/action_footsteps_plastic.mp3",
	splash = "rbxasset://sounds/impact_water.mp3",
	rain = "rbxassetid://183881450",
	click = "rbxasset://sounds/clickfast.wav",
	coin = "rbxasset://sounds/electronicpingshort.wav",
	open = "rbxasset://sounds/swoosh.wav",
	thunder = "rbxasset://sounds/collide.wav",
	-- музыка меню (пусто — без музыки; админ может включить музыку по ID)
	menuMusic = "",
}
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX0000000E">
          <Properties>
            <string name="Name">Catalog</string>
            <ProtectedString name="Source">--!nonstrict
-- Справочники редактора: фигуры, материалы, текстуры, палитра
-- Текстуры можно выбирать только из этого списка; сервер проверяет ID

local Catalog = {}

Catalog.SHAPES = {
	{ id = "Block", title = "Блок" },
	{ id = "Ball", title = "Сфера" },
	{ id = "Cylinder", title = "Цилиндр" },
	{ id = "Wedge", title = "Клин" },
	{ id = "CornerWedge", title = "Угловой клин" },
	{ id = "Ellipsoid", title = "Эллипсоид" },
}

Catalog.MATERIAL_TITLES = {
	Plastic = "Пластик",
	SmoothPlastic = "Гладкий пластик",
	Wood = "Дерево",
	WoodPlanks = "Доски",
	Brick = "Кирпич",
	Concrete = "Бетон",
	Marble = "Мрамор",
	Granite = "Гранит",
	Slate = "Сланец",
	Metal = "Металл",
	DiamondPlate = "Рифлёный металл",
	CorrodedMetal = "Ржавчина",
	Fabric = "Ткань",
	Grass = "Трава",
	Sand = "Песок",
	Glass = "Стекло",
	Neon = "Неон",
	Ice = "Лёд",
	Cobblestone = "Брусчатка",
	Pebble = "Галька",
	Basalt = "Базальт",
	CrackedLava = "Застывшая лава",
	Limestone = "Известняк",
	Pavement = "Тротуар",
	Rock = "Скала",
	Sandstone = "Песчаник",
	Foil = "Фольга",
	LeafyGrass = "Густая трава",
	Snow = "Снег",
	Mud = "Грязь",
	Ground = "Земля",
	Asphalt = "Асфальт",
	Salt = "Соль",
	Glacier = "Ледник",
	ForceField = "Силовое поле",
	Cardboard = "Картон",
	Carpet = "Ковёр",
	CeramicTiles = "Кафель",
	ClayRoofTiles = "Черепица",
	RoofShingles = "Кровельная плитка",
	Leather = "Кожа",
	Plaster = "Штукатурка",
	Rubber = "Резина",
}

-- image — изображение для Texture на всех гранях детали
-- Свои текстуры: загрузите изображение в Roblox и добавьте строку с rbxassetid://ID
Catalog.TEXTURES = {
	{ id = "spawn", title = "Плитка старта", image = "rbxasset://textures/SpawnLocation.png", tile = 4 },
	{ id = "face", title = "Лицо", image = "rbxasset://textures/face.png", tile = 0 },
}

Catalog.TEXTURE_SET = {}
for _, t in Catalog.TEXTURES do
	Catalog.TEXTURE_SET[t.id] = t
end

Catalog.PALETTE = {
	{ 245, 245, 245 }, { 163, 162, 165 }, { 99, 95, 98 }, { 27, 42, 53 }, { 17, 17, 17 },
	{ 196, 40, 28 }, { 218, 133, 65 }, { 245, 205, 48 }, { 75, 151, 75 }, { 13, 105, 172 },
	{ 107, 50, 124 }, { 255, 152, 220 }, { 124, 92, 70 }, { 86, 66, 54 }, { 204, 142, 105 },
	{ 234, 184, 146 }, { 255, 201, 201 }, { 175, 221, 255 }, { 0, 255, 255 }, { 255, 176, 0 },
}

-- Готовые модели в каталоге (строятся в Prefabs)
Catalog.PREFABS = {
	{ id = "baseplate", title = "Платформа", group = "Строения" },
	{ id = "room", title = "Комната", group = "Строения" },
	{ id = "railing", title = "Перила", group = "Строения" },
	{ id = "statue", title = "Статуя на постаменте", group = "Мебель" },
	{ id = "desk", title = "Рабочее место", group = "Мебель" },
	{ id = "corridor", title = "Коридор", group = "Строения" },
	{ id = "floorAbove", title = "Этаж выше", group = "Строения" },
	{ id = "stairs", title = "Лестница", group = "Строения" },
	{ id = "wall", title = "Стена", group = "Строения" },
	{ id = "door", title = "Дверь", group = "Интерактивное" },
	{ id = "closet", title = "Шкаф", group = "Интерактивное" },
	{ id = "lamp", title = "Лампа", group = "Интерактивное" },
	{ id = "bookshelf", title = "Книжный шкаф", group = "Мебель" },
	{ id = "table", title = "Стол", group = "Мебель" },
	{ id = "chair", title = "Стул", group = "Мебель" },
	{ id = "bed", title = "Кровать", group = "Мебель" },
	{ id = "sign", title = "Табличка", group = "Надписи" },
	{ id = "spawn", title = "Старт игрока", group = "Точки" },
	{ id = "zone", title = "Зона срабатывания", group = "Точки" },
	{ id = "waypoint", title = "Точка назначения", group = "Точки" },
	{ id = "npcNew", title = "NPC «Новый»", group = "Персонажи" },
	{ id = "npcRetro", title = "NPC «Ретро»", group = "Персонажи" },
	{ id = "fox", title = "Лисик", group = "Персонажи" },
	{ id = "officeInspector", title = "Билетёрша", group = "Джентльмен и Билетёрша" },
	{ id = "officeCoin", title = "Монета-джентльмен", group = "Джентльмен и Билетёрша" },
	{ id = "officeCoinMoustache", title = "Монета-джентльмен с усами", group = "Джентльмен и Билетёрша" },
}

return Catalog
</ProtectedString>
