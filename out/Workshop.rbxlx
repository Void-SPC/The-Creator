        <Item class="ModuleScript" referent="RBX00000008">
          <Properties>
            <string name="Name">Materials</string>
            <ProtectedString name="Source">--!nonstrict
-- Материалы с защитой: если какого-то материала нет в версии Roblox, берётся SmoothPlastic
return setmetatable({}, {
	__index = function(t, k)
		local ok, v = pcall(function()
			return (Enum.Material :: any)[k]
		end)
		local m = if ok and v then v else Enum.Material.SmoothPlastic
		rawset(t, k, m)
		return m
	end,
})
</ProtectedString>
          </Properties>
        </Item>
        <Item class="Folder" referent="RBX00000009">
          <Properties>
            <string name="Name">Roblox</string>
          </Properties>
          <Item class="ModuleScript" referent="RBX0000000A">
            <Properties>
              <string name="Name">Remotes</string>
              <ProtectedString name="Source">--!nonstrict
-- Сетевые каналы игры. Сервер создаёт их, клиент ждёт появления

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Remotes = {}

local FUNCTIONS = { "Request", "AdminRequest" }
local EVENTS = { "Game" }

local folder: Folder

local function root(): Folder
	if folder then
		return folder
	end
	local ws = ReplicatedStorage:WaitForChild("Workshop")
	if RunService:IsServer() then
		local f = ws:FindFirstChild("Remotes") :: Folder?
		if not f then
			local nf = Instance.new("Folder")
			nf.Name = "Remotes"
			for _, name in FUNCTIONS do
				local rf = Instance.new("RemoteFunction")
				rf.Name = name
				rf.Parent = nf
			end
			for _, name in EVENTS do
				local re = Instance.new("RemoteEvent")
				re.Name = name
				re.Parent = nf
			end
			nf.Parent = ws
			f = nf
		end
		folder = f :: Folder
	else
		folder = ws:WaitForChild("Remotes") :: Folder
	end
	return folder
end

function Remotes.fn(name: string): RemoteFunction
	return root():WaitForChild(name) :: RemoteFunction
end

function Remotes.event(name: string): RemoteEvent
	return root():WaitForChild(name) :: RemoteEvent
end

return Remotes
</ProtectedString>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="RBX0000000B">
          <Properties>
            <string name="Name">RoomPlan</string>
            <ProtectedString name="Source">--!nonstrict
-- План забега без Roblox API: какой зал музея за каждой дверью, где настоящий выход и
-- ложные двери, размер дверей (служебная, обычная, парадная), сколько шкафчиков,
-- замки, Монетчик, Тьма, аномалии. Путь идёт «лесенкой» и не налезает на старые залы

local Rules = require(script.Parent.Rules)

local Plan = {}

-- w — ширина, l — длина, h — высота, dy — подъём пола к выходу, exits — возможные
-- выходы, branch — сколько дверей (лишние ложные), min — с какой двери встречается,
-- door — какие двери любит зал, hides — сколько шкафчиков самое большее
Plan.TEMPLATES = {
	corridor = { w = 12, l = 40, h = 13, weight = 6, exits = { "front", "side" }, door = "normal", hides = 1 },
	longhall = { w = 12, l = 70, h = 13, weight = 3, min = 5, exits = { "front", "side" }, door = "normal", hides = 2 },
	shorthall = { w = 12, l = 22, h = 13, weight = 3, exits = { "front" }, door = "normal", hides = 1 },
	gallery = { w = 30, l = 44, h = 16, weight = 10, exits = { "front", "side" }, branch = 2, door = "grand", hides = 2 },
	sculpture = { w = 36, l = 40, h = 18, weight = 10, exits = { "front", "frontL", "frontR", "side" }, door = "grand", hides = 2 },
	cases = { w = 30, l = 34, h = 14, weight = 9, exits = { "front", "frontL", "frontR", "side" }, door = "normal", hides = 2 },
	fossil = { w = 44, l = 56, h = 24, weight = 7, min = 8, exits = { "front", "side" }, door = "grand", hides = 3 },
	armory = { w = 28, l = 36, h = 14, weight = 7, exits = { "front", "side" }, door = "normal", hides = 2 },
	ceramics = { w = 26, l = 30, h = 14, weight = 7, exits = { "front", "frontL", "frontR" }, door = "normal", hides = 2 },
	archive = { w = 34, l = 40, h = 16, weight = 5, min = 6, exits = { "frontL", "frontR", "side" }, branch = 2, door = "normal", hides = 2 },
	storage = { w = 30, l = 34, h = 14, weight = 4, min = 6, exits = { "frontL", "frontR", "side" }, branch = 2, door = "small", hides = 2 },
	tech = { w = 12, l = 34, h = 10, weight = 3, min = 12, exits = { "front" }, door = "small", hides = 2 },
	stairsup = { w = 16, l = 40, h = 13, weight = 2, min = 4, dy = 10, exits = { "front" }, door = "normal", hides = 1 },
	stairsdown = { w = 16, l = 40, h = 13, weight = 2, min = 4, dy = -10, exits = { "front" }, door = "normal", hides = 1 },
	restroom = { w = 24, l = 26, h = 12, weight = 3, exits = { "front" }, door = "small", hides = 1 },
	cafe = { w = 32, l = 32, h = 14, weight = 4, exits = { "front", "side" }, door = "normal", hides = 1 },
	rotunda = { w = 46, l = 46, h = 24, weight = 6, min = 10, exits = { "front", "frontL", "frontR", "side" }, branch = 3, door = "grand", hides = 3 },
	oddities = { w = 30, l = 30, h = 14, weight = 7, exits = { "front", "frontL", "frontR" }, door = "normal", hides = 2 },
	blank = { w = 30, l = 30, h = 14, weight = 2, min = 15, exits = { "front", "frontL", "frontR" }, door = "normal", hides = 1 },
	clocks = { w = 30, l = 36, h = 16, weight = 6, min = 3, exits = { "front", "frontL", "frontR", "side" }, door = "normal", hides = 2 },
	music = { w = 32, l = 34, h = 16, weight = 6, min = 3, exits = { "front", "frontL", "frontR", "side" }, door = "normal", hides = 2 },
	archaeology = { w = 40, l = 44, h = 18, weight = 5, min = 8, exits = { "front", "frontL", "frontR", "side" }, branch = 2, door = "grand", hides = 2 },
	mechanisms = { w = 34, l = 38, h = 18, weight = 5, min = 12, exits = { "front", "frontL", "frontR", "side" }, door = "small", hides = 2 },
	-- особые: выбираются отдельно
	figures = { w = 40, l = 40, h = 16, exits = { "front" }, door = "normal", hides = 0 },
	voidhall = { w = 12, l = 180, h = 14, exits = { "front" }, door = "normal", hides = 2 },
	start = { w = 30, l = 30, h = 16, exits = { "front" }, door = "grand", hides = 0 },
	codehall = { w = 76, l = 44, h = 18, exits = { "front" }, door = "grand", hides = 2 },
	passage = { w = 18, l = 44, h = 16, exits = { "front" }, door = "grand", hides = 1 },
	arena = { w = 80, l = 104, h = 26, dy = -10, stairW = 56, exits = { "front" }, door = "grand", hides = 0 },
	lifthall = { w = 30, l = 30, h = 16, exits = { "front" }, door = "small", hides = 0 },
	final = { w = 50, l = 60, h = 20, exits = { "front" }, door = "normal", hides = 0 },
}

Plan.ORDER = { "corridor", "longhall", "shorthall", "gallery", "sculpture", "cases", "fossil", "armory", "ceramics", "archive", "storage", "tech", "stairsup", "stairsdown", "restroom", "cafe", "rotunda", "oddities", "blank", "clocks", "music", "archaeology", "mechanisms" }

Plan.DOORS = { small = { w = 4, h = 7.5 }, normal = { w = 5, h = 8 }, grand = { w = 8, h = 11 } }
local RANK = { small = 1, normal = 2, grand = 3 }

local SPECIAL = { [0] = "start", [Rules.CODE_ROOM] = "codehall", [Rules.PASS_ROOM] = "passage", [Rules.BOSS_ROOM] = "arena", [Rules.LIFT_ROOM] = "lifthall", [Rules.FINAL_ROOM] = "final" }

-- перед особыми залами путь прямой и спокойный
local function straightZone(door: number): boolean
	return (door &gt;= Rules.CODE_ROOM - 5 and door &lt;= Rules.BOSS_ROOM + 1) or door &gt;= Rules.LIFT_ROOM - 3
end

function Plan.exitPos(t, name: string, side: number): (number, number, number)
	if name == "front" then
		return 0, -t.l, 0
	elseif name == "frontL" then
		return -t.w / 4, -t.l, 0
	elseif name == "frontR" then
		return t.w / 4, -t.l, 0
	end
	return side * t.w / 2, -(t.l - 6), side
end

function Plan.rng(seed: number)
	local s = math.floor(seed) % 2147483647
	if s &lt;= 0 then
		s += 2147483646
	end
	return function(): number
		s = (s * 48271) % 2147483647
		return s / 2147483647
	end
end

function Plan.new(seed: number)
	local rand = Plan.rng(seed)
	local side = if rand() &lt; 0.5 then -1 else 1
	local first = Rules.DARK_FIRST[1] + math.floor(rand() * (Rules.DARK_FIRST[2] - Rules.DARK_FIRST[1] + 1))
	return {
		seed = seed,
		heading = 0,
		side = side,
		rand = rand,
		ox = 0,
		oy = 0,
		oz = 0,
		rects = {},
		firstDark = first,
		lastDark = -99,
		lastFig = 0,
		lastVoid = 0,
		lastHides = 1,
		lastExit = nil,
		nextKind = nil,
	}
end

local function frame(h: number): (number, number, number, number)
	if h == 0 then
		return 0, -1, 1, 0
	elseif h &lt; 0 then
		return -1, 0, 0, -1
	end
	return 1, 0, 0, 1
end
Plan.frame = frame

local function footprint(state, w: number, l: number)
	local fx, fz, rx, rz = frame(state.heading)
	local xs, zs = {}, {}
	for _, c in { { -w / 2, 0 }, { w / 2, 0 }, { -w / 2, l }, { w / 2, l } } do
		table.insert(xs, state.ox + rx * c[1] + fx * c[2])
		table.insert(zs, state.oz + rz * c[1] + fz * c[2])
	end
	return { math.min(table.unpack(xs)), math.min(table.unpack(zs)), math.max(table.unpack(xs)), math.max(table.unpack(zs)) }
end
Plan.footprint = footprint

-- налезает ли (или стоит вплотную) на недавние залы, кроме предыдущего
Plan.GAP = 2.4
local function overlaps(state, r): boolean
	for i, o in state.rects do
		if i &lt; #state.rects then
			local ox = math.min(r[3], o[3]) - math.max(r[1], o[1])
			local oz = math.min(r[4], o[4]) - math.max(r[2], o[2])
			if ox &gt; -Plan.GAP and oz &gt; -Plan.GAP then
				return true
			end
		end
	end
	return false
end
Plan.overlaps = overlaps

-- залы, к которым сбоку может быть пристроен туалет: где в боковой стене дверь (z)
Plan.ANNEX = { sculpture = -26, cases = -22, armory = -24.5, fossil = -44 }
Plan.ANNEX_SIZE = { w = 18, l = 16, h = 11 }

-- какой зал будет за дверью door (выбирается заранее, чтобы знать размер двери)
local function pickKind(state, door: number): string
	if SPECIAL[door] then
		return SPECIAL[door]
	end
	local rand = state.rand
	local calm = straightZone(door)
	if not calm and state.lastHides &gt; 0 and door &gt;= Rules.MIMIC.from and door - state.lastFig &gt;= Rules.MIMIC.gap and rand() &lt; Rules.MIMIC.chance then
		return "figures"
	end
	if not calm and door &gt;= 25 and door - state.lastVoid &gt;= 20 and rand() &lt; 0.035 then
		return "voidhall"
	end
	local total = 0
	local function ok(id)
		local t = Plan.TEMPLATES[id]
		return door &gt;= (t.min or 0) and not (calm and t.dy)
	end
	for _, id in Plan.ORDER do
		if ok(id) then
			total += Plan.TEMPLATES[id].weight
		end
	end
	local r = rand() * total
	for _, id in Plan.ORDER do
		if ok(id) then
			r -= Plan.TEMPLATES[id].weight
			if r &lt;= 0 then
				return id
			end
		end
	end
	return "corridor"
end

local function after(state, x: number, z: number, turn: number)
	local fx, fz, rx, rz = frame(state.heading)
	return { ox = state.ox + rx * x + fx * -z, oz = state.oz + rz * x + fz * -z, heading = state.heading + turn }
end

local function turnAllowed(state, turn: number): boolean
	if turn == 0 then
		return true
	end
	local h = state.heading + turn
	if h &lt; -1 or h &gt; 1 then
		return false
	end
	if state.heading == 0 then
		return turn == state.side
	end
	return h == 0
end

-- Зал за дверью door. Вызывать по порядку с 0
function Plan.room(state, door: number)
	local rand = state.rand
	local d = { door = door, zone = Rules.zone(door), decoys = {} }
	d.kind = state.nextKind or pickKind(state, door)
	if SPECIAL[door] then
		d.kind = SPECIAL[door]
	end
	local special = SPECIAL[door] ~= nil
	local calm = special or door &lt;= 1 or straightZone(door)
	-- не помещается рядом со старыми залами — берётся коридор
	if not special then
		for _, kind in { d.kind, "corridor", "shorthall" } do
			local t = Plan.TEMPLATES[kind]
			if not overlaps(state, footprint(state, t.w, t.l)) then
				d.kind = kind
				break
			end
		end
	end
	if d.kind == "figures" then
		state.lastFig = door
	elseif d.kind == "voidhall" then
		state.lastVoid = door
	end
	local quiet = special or d.kind == "figures" or d.kind == "voidhall"
	local t = Plan.TEMPLATES[d.kind]
	d.w, d.l, d.h, d.dy = t.w, t.l, t.h, t.dy or 0
	d.stairW = t.stairW
	-- настоящий выход: из разрешённых, с местом для следующего большого зала
	local mine = footprint(state, d.w, d.l)
	local options = {}
	for _, name in t.exits do
		local x, z, turn = Plan.exitPos(t, name, if state.heading == 0 then state.side else -state.heading)
		if turnAllowed(state, turn) and not (calm and name ~= "front") then
			table.insert(options, { name = name, x = x, z = z, turn = turn })
		end
	end
	for i = #options, 2, -1 do
		local j = math.floor(rand() * i) + 1
		options[i], options[j] = options[j], options[i]
	end
	local chosen = nil
	for _, o in options do
		local nx = after(state, o.x, o.z, o.turn)
		nx.rects = table.clone(state.rects)
		table.insert(nx.rects, mine)
		local big = Plan.TEMPLATES.rotunda
		if not overlaps(nx, footprint(nx, big.w, big.l)) then
			chosen = o
			break
		end
	end
	if not chosen then
		local x, z = Plan.exitPos(t, "front", 0)
		chosen = { name = "front", x = x, z = z, turn = 0 }
	end
	d.exit = { name = chosen.name, x = chosen.x, z = chosen.z, turn = chosen.turn, y = d.dy }
	-- ложные двери в развилках
	if t.branch and not calm then
		local want = t.branch - 1
		for _, name in t.exits do
			if want &gt; 0 and name ~= chosen.name then
				local side = if state.heading == 0 then state.side else -state.heading
				local x, z, turn = Plan.exitPos(t, name, side)
				if name == "side" and rand() &lt; 0.5 then
					x, z, turn = Plan.exitPos(t, name, -side)
				end
				table.insert(d.decoys, { name = name, x = x, z = z, turn = turn, y = 0 })
				want -= 1
			end
		end
	end
	-- шкафчики: не в каждом зале, но двух залов подряд без укрытия не бывает
	local hides = math.floor(rand() * (t.hides + 1))
	if hides == 0 and state.lastHides == 0 and t.hides &gt; 0 then
		hides = 1
	end
	if special then
		hides = t.hides
	end
	d.hides = hides
	if not quiet and door &gt; 1 then
		local nextSpecial = SPECIAL[door + 1] ~= nil
		if not nextSpecial then
			if rand() &lt; Rules.lockedChance(door) then
				d.locked = true
			elseif rand() &lt; Rules.coinChance(door) then
				d.coin = true
			end
		end
		-- Тьма: первый раз между 11-й и 17-й дверью, потом шанс растёт с каждой дверью
		if not straightZone(door) and (hides &gt; 0 or state.lastHides &gt; 0) then
			local since = door - state.lastDark
			if (state.lastDark &lt; 0 and door &gt;= state.firstDark) or (state.lastDark &gt; 0 and rand() &lt; Rules.darkChance(since)) then
				d.dark = true
				state.lastDark = door
			end
		end
		d.windows = door &lt; 60 and rand() &lt; 0.4
		d.mono = door &gt; 10 and rand() &lt; 0.04
	end
	state.lastHides = hides
	-- пристройка-туалет с той стороны, куда путь не поворачивает (если там свободно)
	local az = Plan.ANNEX[d.kind]
	if az and not special and door &gt;= 3 and rand() &lt; 0.45 then
		local s = if state.heading == 0 then -state.side else state.heading
		local A = Plan.ANNEX_SIZE
		local fx, fz, rx, rz = frame(state.heading)
		local xs, zs = {}, {}
		for _, c in { { d.w / 2, -az - A.w / 2 }, { d.w / 2 + A.l + 1, -az - A.w / 2 }, { d.w / 2, -az + A.w / 2 }, { d.w / 2 + A.l + 1, -az + A.w / 2 } } do
			table.insert(xs, state.ox + rx * s * c[1] + fx * c[2])
			table.insert(zs, state.oz + rz * s * c[1] + fz * c[2])
		end
		local r = { math.min(table.unpack(xs)), math.min(table.unpack(zs)), math.max(table.unpack(xs)), math.max(table.unpack(zs)) }
		local free = true
		for _, o in state.rects do
			if math.min(r[3], o[3]) - math.max(r[1], o[1]) &gt; -Plan.GAP and math.min(r[4], o[4]) - math.max(r[2], o[2]) &gt; -Plan.GAP then
				free = false
			end
		end
		if free then
			d.annex = { side = s, z = az, rect = r }
			table.insert(state.rects, r)
		end
	end
	d.light = Rules.light(door)
	-- размер дверей: вход — как выход прошлого зала; выход — по вкусу этого и следующего
	d.entrySize = state.lastExit or "grand"
	state.nextKind = if door &lt; Rules.FINAL_ROOM then pickKind(state, door + 1) else nil
	local nextT = state.nextKind and Plan.TEMPLATES[state.nextKind]
	local a, b = t.door, if nextT then nextT.door else t.door
	d.exitSize = if RANK[a] &lt;= RANK[b] then a else b
	if door == Rules.CODE_ROOM then
		d.exitSize = "grand"
	end
	state.lastExit = d.exitSize
	-- запомнить место и перейти к выходу
	table.insert(state.rects, mine)
	while #state.rects &gt; 9 do
		table.remove(state.rects, 1)
	end
	local nx = after(state, d.exit.x, d.exit.z, d.exit.turn)
	state.ox, state.oz, state.heading = nx.ox, nx.oz, nx.heading
	state.oy += d.dy
	d.heading = state.heading
	return d
end

return Plan
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX0000000C">
          <Properties>
            <string name="Name">Rules</string>
            <ProtectedString name="Source">--!nonstrict
-- Правила «The Museum» без Roblox API: первая локация из 100 дверей, свет, предметы,
-- Монетчик, Тьма, тебЯ, Колосс с зеркалами, кодовый замок. Проверяются тестами

local Rules = {}

-- локация --------------------------------------------------------------------

Rules.CHAPTER = 100
Rules.CODE_ROOM = 48 -- зал трёх замков (дверь 049 заперта)
Rules.PASS_ROOM = 49 -- переход к залу Колосса
Rules.BOSS_ROOM = 50 -- зал Колосса
Rules.LIFT_ROOM = 99 -- лифт, загадка и лестница обслуживания
Rules.FINAL_ROOM = 100 -- заброшенный зал

function Rules.isSpecial(door: number): boolean
	return door == 0 or door == Rules.CODE_ROOM or door == Rules.PASS_ROOM or door == Rules.BOSS_ROOM or door == Rules.LIFT_ROOM or door == Rules.FINAL_ROOM
end

function Rules.plate(door: number): string
	return string.format("%03d", door)
end

-- оформление: парадные залы → старое крыло → заброшенная часть
function Rules.zone(door: number): string
	if door &lt;= 50 then
		return "classic"
	elseif door &lt; 100 then
		return "old"
	end
	return "ruin"
end

-- яркость ламп: в старом крыле свет слабее
function Rules.light(door: number): number
	if door &lt;= 30 then
		return 1
	end
	return math.max(0.45, 1 - (door - 30) / 70 * 0.55)
end

-- Монетчик -------------------------------------------------------------------

Rules.SELF_SHARE = 0.7 -- «расплатиться собой»: 70 % текущего здоровья
Rules.COIN_FROM = 30
Rules.COINS_PER_DOOR = 2

-- ставка: в первой локации от 20 до 100, в каждой следующей на 100 больше, максимум 500
function Rules.coinPrice(door: number): number
	local loc = math.floor((math.max(1, door) - 1) / 100)
	local t = ((math.max(1, door) - 1) % 100) / 99
	local lo = if loc == 0 then 20 else loc * 100
	local hi = (loc + 1) * 100
	return math.min(500, math.floor(lo + (hi - lo) * t + 0.5))
end

-- здоровье после платы собой; с 1 здоровья Монетчик забирает всё
function Rules.afterSelfToll(health: number): number
	if health &lt;= 1.5 then
		return 0
	end
	return math.max(1, health * (1 - Rules.SELF_SHARE))
end

function Rules.coinChance(door: number): number
	if door &lt; Rules.COIN_FROM then
		return 0
	end
	return 0.1
end

-- Тьма -----------------------------------------------------------------------

Rules.DARK_FIRST = { 11, 17 } -- первый пролёт где-то между этими дверями
Rules.DARK_GAP = 4

-- шанс после очередной открытой двери растёт с каждой дверью без Тьмы
function Rules.darkChance(since: number): number
	if since &lt; Rules.DARK_GAP then
		return 0
	end
	return math.min(0.4, (since - Rules.DARK_GAP + 1) * 0.06)
end

-- тебЯ ----------------------------------------------------------------------

-- delay — на сколько секунд статуя отстаёт от игрока: повторяет его путь с этой задержкой
-- (стоял пять секунд — и она постоит пять секунд на том же месте)
Rules.MIMIC = { speed = 17, wait = 1, damage = 35, from = 20, gap = 8, chance = 0.07, delay = 2.5 }

-- где статуя должна быть сейчас: последняя запись, сделанная не позже now - delay
function Rules.replayAt(log: { { t: number, x: number, z: number } }, now: number): number?
	local cut = now - Rules.MIMIC.delay
	local found = nil
	for i, e in log do
		if e.t &lt;= cut then
			found = i
		else
			break
		end
	end
	return found
end

-- фонарик --------------------------------------------------------------------

Rules.FLASH_MAX = 100
Rules.FLASH_DRAIN = 0.8
Rules.BATTERY = 50

function Rules.drain(charge: number, dt: number, on: boolean): number
	if not on then
		return charge
	end
	return math.max(0, charge - Rules.FLASH_DRAIN * dt)
end

function Rules.recharge(charge: number): number
	return math.min(Rules.FLASH_MAX, charge + Rules.BATTERY)
end

-- предметы -------------------------------------------------------------------

Rules.CAP = { battery = 5, plant = 2, lockpick = 3, key = 9, hammer = 1, meat = 3, pole = 1, lens = 1, coldkey = 1, clockkey = 1 }
Rules.PLANT_HEAL = 40
Rules.SPEED = { walk = 15, sneak = 7 }

function Rules.canAdd(inv: { [string]: number }, item: string): boolean
	local cap = Rules.CAP[item]
	return cap ~= nil and (inv[item] or 0) &lt; cap
end

function Rules.add(inv: { [string]: number }, item: string): boolean
	if not Rules.canAdd(inv, item) then
		return false
	end
	inv[item] = (inv[item] or 0) + 1
	return true
end

function Rules.take(inv: { [string]: number }, item: string): boolean
	if (inv[item] or 0) &lt;= 0 then
		return false
	end
	inv[item] -= 1
	if inv[item] == 0 then
		inv[item] = nil
	end
	return true
end

-- что лежит в ящике: r в [0, 1)
function Rules.loot(r: number, door: number): (string, number)
	-- у каждого ящика своя находка, поэтому пустых больше
	if r &lt; 0.25 then
		return "coins", 3 + math.floor(r * 40) + math.floor(door / 10)
	elseif r &lt; 0.33 then
		return "battery", 1
	elseif r &lt; 0.355 then
		return "lockpick", 1
	elseif r &lt; 0.365 then
		return "plant", 1
	elseif r &lt; 0.372 then
		return "hammer", 1
	end
	return "nothing", 0
end

function Rules.lockedChance(door: number): number
	if door &lt; 3 then
		return 0
	end
	return math.min(0.25, 0.1 + door / 500)
end

-- шум и Колосс ---------------------------------------------------------------

function Rules.noise(speed: number, sneaking: boolean): number
	if sneaking or speed &lt;= Rules.SPEED.sneak + 1 then
		return 0
	end
	return 34
end

Rules.COLOSSUS = { wander = 8, hunt = 16, sniffEvery = 11, sniffTime = 2.6, sniffRange = 30, meat = 18 }

-- кодовый замок: четыре цифры 1–6 (сколько предметов на витрине каждого цвета)
Rules.COLORS = { "red", "blue", "green", "yellow" }
Rules.ROMAN = { "I", "II", "III", "IV", "V", "VI", "VII", "VIII" }

function Rules.code(rand: () -&gt; number)
	local digits, order = {}, { 1, 2, 3, 4 }
	for i = 1, 4 do
		digits[i] = 1 + math.floor(rand() * 6)
	end
	for i = 4, 2, -1 do
		local j = 1 + math.floor(rand() * i)
		order[i], order[j] = order[j], order[i]
	end
	local text = ""
	for _, c in order do
		text ..= digits[c]
	end
	-- третий замок: восемь экспонатов с римскими номерами I–VIII в случайном порядке
	local roman = { 1, 2, 3, 4, 5, 6, 7, 8 }
	for i = 8, 2, -1 do
		local j = 1 + math.floor(rand() * i)
		roman[i], roman[j] = roman[j], roman[i]
	end
	local sequence = {}
	for item, num in roman do
		sequence[num] = item
	end
	-- digits[i] — число для цвета i; order — порядок цветов на замке; text — код;
	-- roman[k] — номер экспоната k; sequence — в каком порядке нажимать экспонаты
	return { digits = digits, order = order, text = text, roman = roman, sequence = sequence }
end

-- достижения: порядок в списке лобби; названия и описания — в Lang (a_id, a_id_t)
Rules.ACHIEVEMENTS = { "darkness", "darkness_hid", "coinkeeper", "coin_paid", "mimic_solved", "door50", "colossus_down", "door100", "finale" }

-- Арена Колосса (зал 050). Координаты — в осях зала: x поперёк, z вглубь (отрицательный)
-- Галереи второго этажа на высоте 0 (пол зала на -10), луч идёт над ними на высоте y.
-- Солнечный луч из круглого окна в дальней стене → четыре зеркала на галереях →
-- зеркальце в люстре → вниз, в круг света на полу
Rules.ARENA = {
	y = 6.6, -- высота луча над входом
	source = { x = -34, z = -103.2, dx = 0, dz = 1 },
	mirrors = { { x = -34, z = -92 }, { x = 34, z = -92 }, { x = 34, z = -40 }, { x = -34, z = -40 } },
	lens = { x = 0, z = -66 },
	tol = math.rad(6), -- допуск направления луча (зеркалу — вдвое меньше)
	turn = 24, -- градусов в секунду, пока держат кнопку
	zone = 7.5, -- радиус круга света на полу
	bounds = { x = 39.3, zFar = -103.3, zNear = -12 },
	stun = 14, -- сколько стоит, ослеплённый светом
	coldOpen = 5, -- сколько секунд открыта дверь холодильной камеры
	drop = 10, -- люстра задевает всё ближе этого
}

local function norm(x: number, z: number): (number, number)
	local l = math.sqrt(x * x + z * z)
	if l &lt; 1e-9 then
		return 0, 0
	end
	return x / l, z / l
end

-- Путь луча. angles[k] — угол нормали зеркала k в радианах (нормаль = (cos a, sin a)).
-- Луч цепляется за следующее зеркало, если смотрит на него с ошибкой меньше допуска.
-- Люстра ловит луч только после всех четырёх зеркал. Возвращает точки пути
-- { x, z, k? }, цепочку зеркал и попал ли луч в люстру
function Rules.beam(angles: { number })
	local A = Rules.ARENA
	local x, z, dx, dz = A.source.x, A.source.z, A.source.dx, A.source.dz
	local path = { { x = x, z = z } }
	local chain, used = {}, {}
	for _ = 1, 6 do
		local best, bestD, bestK = nil, math.huge, nil
		local function try(t, k)
			local vx, vz = t.x - x, t.z - z
			local d = math.sqrt(vx * vx + vz * vz)
			if d &lt; 0.5 then
				return
			end
			local c = (vx * dx + vz * dz) / d
			if c &gt; math.cos(A.tol) and d &lt; bestD then
				best, bestD, bestK = t, d, k
			end
		end
		for k, mr in A.mirrors do
			if not used[k] then
				try(mr, k)
			end
		end
		if #chain == #A.mirrors then
			try(A.lens, 0)
		end
		if not best then
			-- в стену зала
			local t = math.huge
			local B = A.bounds
			if dx &gt; 1e-6 then
				t = math.min(t, (B.x - x) / dx)
			elseif dx &lt; -1e-6 then
				t = math.min(t, (-B.x - x) / dx)
			end
			if dz &gt; 1e-6 then
				t = math.min(t, (B.zNear - z) / dz)
			elseif dz &lt; -1e-6 then
				t = math.min(t, (B.zFar - z) / dz)
			end
			table.insert(path, { x = x + dx * t, z = z + dz * t })
			return path, chain, false
		end
		-- луч точно в центр того, за что зацепился
		dx, dz = norm(best.x - x, best.z - z)
		x, z = best.x, best.z
		table.insert(path, { x = x, z = z, k = bestK })
		if bestK == 0 then
			return path, chain, true
		end
		used[bestK] = true
		table.insert(chain, bestK)
		local a = angles[bestK] or 0
		local nx, nz = math.cos(a), math.sin(a)
		local dot = dx * nx + dz * nz
		if math.abs(dot) &lt; 0.12 then
			-- зеркало стоит ребром к лучу: свет гаснет на раме
			return path, chain, false
		end
		dx, dz = dx - 2 * dot * nx, dz - 2 * dot * nz
	end
	return path, chain, false
end

-- углы нормалей, при которых луч проходит зеркала по порядку 1→2→3→4→люстра
function Rules.beamSolution(): { number }
	local A = Rules.ARENA
	local pts = { A.source }
	for _, mr in A.mirrors do
		table.insert(pts, mr)
	end
	table.insert(pts, A.lens)
	local out = {}
	for k = 2, #pts - 1 do
		local ix, iz = norm(pts[k].x - pts[k - 1].x, pts[k].z - pts[k - 1].z)
		local ox, oz = norm(pts[k + 1].x - pts[k].x, pts[k + 1].z - pts[k].z)
		local nx, nz = norm(ox - ix, oz - iz)
		out[k - 1] = math.atan2(nz, nx)
	end
	return out
end

-- остановленные часы в зале: час 1–12 и минуты кратно 15; стрелки механизма
-- двери переводятся по одному шагу
function Rules.clockTime(rand: () -&gt; number): (number, number)
	return 1 + math.floor(rand() * 12), math.floor(rand() * 4) * 15
end

function Rules.clockStep(h: number, m: number, hand: string): (number, number)
	if hand == "hour" then
		return h % 12 + 1, m
	end
	return h, (m + 15) % 60
end

return Rules
</ProtectedString>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="RBX0000000D">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="RBX0000000E">
      <Properties>
        <string name="Name">Workshop</string>
      </Properties>
      <Item class="ModuleScript" referent="RBX0000000F">
        <Properties>
          <string name="Name">Access</string>
          <ProtectedString name="Source">--!nonstrict
-- Кто считается создателем: владелец игры, пользователи из Config и (в Studio) все
-- Права проверяются только на сервере; клиент лишь прячет кнопки

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Config = require(script.Parent.Config)

local Access = {}

local resolvedIds: { [number]: boolean } = {}
local cache: { [number]: boolean } = {}

-- Имена из Config переводятся в постоянные ID аккаунтов, чтобы смена ника не давала
-- доступ чужому человеку с таким же именем
task.spawn(function()
	for _, name in Config.CREATOR_USERNAMES do
		for _ = 1, 3 do
			local ok, id = pcall(function()
				return Players:GetUserIdFromNameAsync(name)
			end)
			if ok and type(id) == "number" then
				resolvedIds[id] = true
				table.clear(cache)
				break
			end
			task.wait(2)
		end
	end
end)

local function ownerOf(player: Player): boolean
	if game.CreatorType == Enum.CreatorType.User then
		return game.CreatorId == player.UserId
	end
	local ok, rank = pcall(function()
		return player:GetRankInGroup(game.CreatorId)
	end)
	return ok and rank &gt;= 254
end

function Access.isCreator(player: Player): boolean
	local c = cache[player.UserId]
	if c ~= nil then
		return c
	end
	local result = RunService:IsStudio()
		or ownerOf(player)
		or resolvedIds[player.UserId] == true
		or table.find(Config.CREATOR_USER_IDS, player.UserId) ~= nil
	-- кэшируем только положительный ответ: ID имени может прийти чуть позже
	if result then
		cache[player.UserId] = true
	end
	return result
end

-- Создатель по ID (для карт: валюту выдают только карты создателей)
function Access.isCreatorUserId(userId: number): boolean
	if RunService:IsStudio() then
		return true
	end
	if game.CreatorType == Enum.CreatorType.User and game.CreatorId == userId then
		return true
	end
	if resolvedIds[userId] or table.find(Config.CREATOR_USER_IDS, userId) then
		return true
	end
	local p = Players:GetPlayerByUserId(userId)
	return p ~= nil and Access.isCreator(p)
end

function Access.forget(player: Player)
	cache[player.UserId] = nil
end

return Access
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000010">
        <Properties>
          <string name="Name">Config</string>
          <ProtectedString name="Source">--!nonstrict
-- Настройки сервера «The Museum»

local Config = {}

-- Создатели (админ-панель): владелец игры всегда, плюс эти имена (проверяются по ID)
Config.CREATOR_USERNAMES = { "Saren45hil", "Nataliaavira13" } :: { string }
Config.CREATOR_USER_IDS = {} :: { number }

-- Хранилище рекордов и журнала
Config.DATASTORE_NAME = "Museum_Records_v1"

-- Значки (бейджи). Создай значок в Creator Dashboard, скопируй его ID и впиши сюда
-- вместо нуля — игра начнёт выдавать его сама. Ноль значит «значка пока нет»
Config.BADGES = {
	darkness = 0, -- первая встреча с Тьмой
	mimic = 0, -- первая встреча с тебЯ
	coinkeeper = 0, -- первая встреча с Монетчиком
	colossus = 0, -- первая встреча с Колоссом
	void = 0, -- коридор с проломами
	colossus_down = 0, -- Колосс побеждён
	finale = 0, -- первая локация пройдена (достижение «Продолжение следует»)
	darkness_hid = 0, -- пережил пролёт Тьмы
	coin_paid = 0, -- расплатился с Монетчиком
	mimic_solved = 0, -- разгадал фигурки тебЯ
	door50 = 0, -- открыл дверь 050
	door100 = 0, -- прошёл дверь 100
}

return Config
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000011">
        <Properties>
          <string name="Name">DataStoreAdapter</string>
          <ProtectedString name="Source">--!nonstrict
-- Адаптер DataStore для рекордов
-- В Studio без доступа к API используется память сервера с предупреждением в выводе

local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")

local Config = require(script.Parent.Config)

local Adapter = {}

local function waitBudget(kind: Enum.DataStoreRequestType)
	local deadline = os.clock() + 15
	while DataStoreService:GetRequestBudgetForRequestType(kind) &lt; 1 and os.clock() &lt; deadline do
		task.wait(0.5)
	end
end

local function deepCopy(v: any): any
	if type(v) ~= "table" then
		return v
	end
	local o = {}
	for k, x in v do
		o[k] = deepCopy(x)
	end
	return o
end

function Adapter.memory()
	local data = {}
	return {
		kind = "memory",
		get = function(key: string)
			return deepCopy(data[key])
		end,
		update = function(key: string, fn)
			local nv = fn(deepCopy(data[key]))
			if nv ~= nil then
				data[key] = deepCopy(nv)
			end
			return deepCopy(nv)
		end,
	}
end

function Adapter.create()
	local ok, store = pcall(function()
		return DataStoreService:GetDataStore(Config.DATASTORE_NAME)
	end)
	if ok and RunService:IsStudio() then
		-- проверяем доступ к API в Studio
		local probe = pcall(function()
			return store:GetAsync("probe")
		end)
		if not probe then
			ok = false
		end
	end
	if not ok then
		warn("[Labyrinth] DataStore недоступен, поэтому данные хранятся только в памяти этого сервера (включите Studio Access to API Services)")
		return Adapter.memory()
	end
	local ds = store :: DataStore
	return {
		kind = "datastore",
		get = function(key: string)
			waitBudget(Enum.DataStoreRequestType.GetAsync)
			return ds:GetAsync(key)
		end,
		update = function(key: string, fn)
			waitBudget(Enum.DataStoreRequestType.UpdateAsync)
			return ds:UpdateAsync(key, function(old)
				return fn(old)
			end)
		end,
	}
end

return Adapter
</ProtectedString>
        </Properties>
      </Item>
      <Item class="Folder" referent="RBX00000012">
        <Properties>
          <string name="Name">Game</string>
        </Properties>
        <Item class="ModuleScript" referent="RBX00000013">
          <Properties>
            <string name="Name">Admin</string>
            <ProtectedString name="Source">--!nonstrict
-- Админ-панель: быстрые проверки игры одному. Доступ только создателям, проверка на сервере

local Shared = game:GetService("ReplicatedStorage").Workshop.Shared
local Commands = require(Shared.AdminCommands)
local Rules = require(Shared.Rules)
local Remotes = require(Shared.Roblox.Remotes)

local Access = require(script.Parent.Parent.Access)
local Entities = require(script.Parent.Entities)
local G = require(script.Parent.Game)

local Admin = {}

-- открыть несколько дверей подряд и перенести живых игроков к последней
local function skip(count: number)
	local run = G.run
	if G.mode ~= "run" then
		return
	end
	for _ = 1, count do
		local n = run.front + 1
		local info = run.rooms[n - 1]
		if not info or not info.door or n &gt;= Rules.FINAL_ROOM then
			break
		end
		info.sealed = false
		if info.toll then
			info.toll.paid = true
			info.toll.model:Destroy()
			info.toll.block:Destroy()
		end
		G.openDoor(n, true)
	end
	local info = run.rooms[run.front]
	if info then
		for _, p in G.alivePlayers() do
			G.unhide(p)
			G.teleport(p, info.origin * CFrame.new(0, 3, -4))
		end
	end
end

local RUN = {
	start_here = function()
		G.startHere()
	end,
	coins = function(p)
		G.give(p, "coins", 100)
	end,
	items = function(p)
		for _, it in { "battery", "plant", "lockpick", "hammer" } do
			G.give(p, it)
		end
	end,
	heal = function(p)
		local hum = G.humOf(p)
		if hum then
			hum.Health = hum.MaxHealth
		end
	end,
	god = function(p)
		local s = G.players[p]
		if s then
			s.god = not s.god
			G.toast(p, if s.god then "GodOn" else "GodOff")
		end
	end,
	skip = function()
		skip(5)
	end,
	skip20 = function()
		skip(20)
	end,
	to_code = function()
		skip(math.max(0, Rules.CODE_ROOM - G.run.front))
	end,
	to_boss = function()
		skip(math.max(0, Rules.BOSS_ROOM - G.run.front))
	end,
	arena_kit = function(p)
		for _, it in { "pole", "lens", "coldkey", "meat", "meat", "meat", "clockkey" } do
			G.give(p, it)
		end
	end,
	to_lift = function()
		skip(math.max(0, Rules.LIFT_ROOM - G.run.front))
	end,
	darkness = function()
		task.spawn(Entities.darkness)
	end,
	unseal = function()
		local info = G.run.rooms[G.run.front]
		if info then
			info.sealed = false
			if info.door then
				info.door.locked = false
			end
			if info.locks then
				info.locks.code, info.locks.order = true, true
			end
			if info.gate and not info.gate.opened then
				for _, l in info.levers do
					l.need = l.on
				end
			end
		end
	end,
	restart = function()
		task.spawn(G.endRun)
	end,
}

function Admin.init()
	Remotes.fn("AdminRequest").OnServerInvoke = function(p: Player, action: any, id: any)
		if action == "Status" then
			return { ok = true, admin = Access.isCreator(p) }
		end
		if action ~= "Run" or not Access.isCreator(p) then
			return { ok = false }
		end
		if type(id) ~= "string" or not Commands.BY_ID[id] or not RUN[id] then
			return { ok = false }
		end
		local ok, err = pcall(RUN[id], p)
		if not ok then
			warn("[Museum] admin " .. id .. ": " .. tostring(err))
		end
		return { ok = ok }
	end
end

return Admin
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000014">
          <Properties>
            <string name="Name">Entities</string>
            <ProtectedString name="Source">--!nonstrict
-- Существа музея:
--   Тьма — плоская тень; летит через открытые залы до последней двери, открывает её,
--          гасит свет и возвращается обратно быстрее. Спасает шкафчик
--   тебЯ — мраморная копия игрока; повторяет его путь по залу, пока фигурки не на местах
--   Колосс — огромная слепая статуя в зале зеркал; слышит шаги, принюхивается, идёт на мясо

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local PathfindingService = game:GetService("PathfindingService")
local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Shared = game:GetService("ReplicatedStorage").Workshop.Shared
local M = require(Shared.Materials)
local Rules = require(Shared.Rules)

local E = {}
local G

local SOUND = {
	rumble = "rbxasset://sounds/swoosh.wav",
	scream = "rbxasset://sounds/uuhhh.mp3",
	hit = "rbxasset://sounds/swordslash.wav",
	ping = "rbxasset://sounds/electronicpingshort.wav",
	stone = "rbxasset://sounds/collide.wav",
	glass = "rbxasset://sounds/flashbulb.wav",
}
E.SOUND = SOUND
local WALK_ANIM = "rbxassetid://507777826"
local IDLE_ANIM = "rbxassetid://507766388"

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local function sound(parent: Instance, id: string, vol: number, speed: number?, looped: boolean?)
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = vol
	s.PlaybackSpeed = speed or 1
	s.Looped = looped == true
	s.RollOffMaxDistance = 180
	s.Parent = parent
	s:Play()
	if not looped then
		Debris:AddItem(s, 8)
	end
	return s
end
E.sound = sound

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

-- лампа лопается: свет гаснет насовсем
local function burst(bulb: Instance)
	if bulb:GetAttribute("Broken") then
		return
	end
	bulb:SetAttribute("Broken", true)
	local l = bulb:FindFirstChildOfClass("PointLight")
	if l then
		l.Enabled = false
	end
	if bulb:IsA("BasePart") then
		bulb.Material = M.Glass
		bulb.Color = rgb(40, 38, 36)
		local e = Instance.new("ParticleEmitter")
		e.Rate = 0
		e.Speed = NumberRange.new(6, 14)
		e.Lifetime = NumberRange.new(0.3, 0.7)
		e.Size = NumberSequence.new(0.15, 0)
		e.Color = ColorSequence.new(rgb(255, 230, 180))
		e.SpreadAngle = Vector2.new(180, 180)
		e.Acceleration = Vector3.new(0, -40, 0)
		e.Parent = bulb
		e:Emit(14)
		Debris:AddItem(e, 2)
	end
end

local function darkenRoom(info)
	for _, b in info.lights do
		if b.Parent then
			burst(b)
		end
	end
	for _, d in info.model:GetDescendants() do
		if d:IsA("PointLight") and d.Parent and CollectionService:HasTag(d.Parent, "LabLight") then
			burst(d.Parent)
		end
	end
	sound(info.model, SOUND.glass, 0.9, 1.6)
end

-- ---------------------------------------------------------------------------
-- Тьма

E.darkActive = false

-- плоское лицо: чёрный круг с пустыми глазами; клиент заставляет его дрожать
local function darkModel(at: Vector3)
	local p = Instance.new("Part")
	p.Name = "Darkness"
	p.Size = Vector3.new(2, 2, 2)
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.Transparency = 1
	p.CFrame = CFrame.new(at)
	local bb = Instance.new("BillboardGui")
	bb.Name = "Face"
	bb.Size = UDim2.new(17, 0, 17, 0)
	bb.LightInfluence = 0
	bb.MaxDistance = 400
	bb.Parent = p
	local function frame(name, size, pos, color, round)
		local f = Instance.new("Frame")
		f.Name = name
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Size = UDim2.fromScale(size.X, size.Y)
		f.Position = UDim2.fromScale(pos.X, pos.Y)
		f.BackgroundColor3 = color
		f.BorderSizePixel = 0
		if round then
			local c = Instance.new("UICorner")
			c.CornerRadius = UDim.new(0.5, 0)
			c.Parent = f
		end
		f.Parent = bb
		return f
	end
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		local t = frame("Tendril", Vector2.new(0.16, 0.5), Vector2.new(0.5 + math.cos(a) * 0.3, 0.5 + math.sin(a) * 0.3), Color3.new(0, 0, 0), true)
		t.Rotation = math.deg(a) + 90
	end
	frame("Body", Vector2.new(0.66, 0.66), Vector2.new(0.5, 0.5), Color3.new(0, 0, 0), true)
	frame("EyeL", Vector2.new(0.13, 0.17), Vector2.new(0.38, 0.42), Color3.new(1, 1, 1), true)
	frame("EyeR", Vector2.new(0.13, 0.17), Vector2.new(0.62, 0.42), Color3.new(1, 1, 1), true)
	frame("Mouth", Vector2.new(0.3, 0.1), Vector2.new(0.5, 0.66), Color3.new(1, 1, 1), true)
	local smoke = Instance.new("ParticleEmitter")
	smoke.Color = ColorSequence.new(Color3.new(0, 0, 0))
	smoke.Size = NumberSequence.new(7, 2)
	smoke.Transparency = NumberSequence.new(0.2, 1)
	smoke.Lifetime = NumberRange.new(0.8, 1.4)
	smoke.Rate = 60
	smoke.Speed = NumberRange.new(1, 4)
	smoke.LightEmission = 0
	smoke.Parent = p
	CollectionService:AddTag(p, "Darkness")
	return p
end

function E.darkness()
	if E.darkActive then
		return
	end
	local rooms = G.loadedRooms()
	if #rooms == 0 then
		return
	end
	E.darkActive = true
	local lights = {}
	for _, info in rooms do
		for _, b in info.lights do
			table.insert(lights, b)
		end
	end
	G.sendAll({ type = "dark", phase = "warn" })
	for _, p in G.alivePlayers() do
		G.discover(p, "darkness")
	end
	G.fleeKeepers()
	-- свет мигает, пока она приближается
	local warnTime = 5
	local t0 = os.clock()
	task.spawn(function()
		while os.clock() - t0 &lt; warnTime do
			for _, bulb in lights do
				local l = bulb.Parent and bulb:FindFirstChildOfClass("PointLight")
				if l and not bulb:GetAttribute("Broken") and l.Brightness &gt; 0 then
					l.Enabled = math.random() &lt; 0.5
				end
			end
			task.wait(0.07 + math.random() * 0.12)
		end
		for _, bulb in lights do
			local l = bulb.Parent and bulb:FindFirstChildOfClass("PointLight")
			if l and not bulb:GetAttribute("Broken") then
				l.Enabled = true
			end
		end
	end)
	-- путь: издалека сзади (как будто за десять дверей), через все залы до последней двери
	local legs = {}
	for _, info in rooms do
		for _, pt in info.path do
			table.insert(legs, { pos = pt, info = info })
		end
	end
	local first = legs[1].pos
	local back = (first - legs[2].pos)
	local startPos = first + (if back.Magnitude &gt; 0.1 then back.Unit else Vector3.zAxis) * 260
	local body = darkModel(startPos)
	body.Parent = workspace
	local rumble = sound(body, SOUND.rumble, 3, 0.2, true)
	task.wait(warnTime)
	G.sendAll({ type = "dark", phase = "rush" })
	local pos = startPos
	local function fly(target: Vector3, speed: number, info)
		while (target - pos).Magnitude &gt; 1 do
			local dt = RunService.Heartbeat:Wait()
			pos += (target - pos).Unit * math.min(speed * dt, (target - pos).Magnitude)
			body.CFrame = CFrame.new(pos)
			for _, p in G.alivePlayers() do
				local r = G.rootOf(p)
				if r and not G.isHidden(p) then
					local off = r.Position - pos
					local near = flat(off).Magnitude &lt; 14 and math.abs(off.Y) &lt; 14
					local same = info and G.inRoom(info, r.Position) and flat(off).Magnitude &lt; 60
					if near or same then
						G.kill(p, "darkness")
					end
				end
			end
		end
	end
	local done = {}
	for _, leg in legs do
		fly(leg.pos, 78, leg.info)
		if not done[leg.info] then
			done[leg.info] = true
			darkenRoom(leg.info)
		end
	end
	-- открывает следующую дверь и делает зал за ней тёмным
	local opened = G.darkOpen()
	if opened then
		darkenRoom(opened)
		for _, pt in opened.path do
			fly(pt, 78, opened)
		end
		for i = #opened.path, 1, -1 do
			fly(opened.path[i], 100, opened)
		end
	end
	-- возвращается обратно чуть быстрее
	for i = #legs, 1, -1 do
		fly(legs[i].pos, 100, legs[i].info)
	end
	fly(startPos, 130, nil)
	rumble:Stop()
	body:Destroy()
	G.sendAll({ type = "dark", phase = "gone" })
	E.darkActive = false
	-- кто пережил пролёт, тот спрятался
	for _, p in G.alivePlayers() do
		G.achieve(p, "darkness_hid")
	end
end

-- ---------------------------------------------------------------------------
-- общее для ходячих статуй

local function marble(model: Model, color: Color3)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Color = color
			d.Material = M.Marble
			if d:IsA("MeshPart") then
				pcall(function()
					d.TextureID = ""
				end)
			end
		elseif d:IsA("SpecialMesh") then
			d.TextureId = ""
		elseif d:IsA("Decal") or d:IsA("Shirt") or d:IsA("Pants") or d:IsA("ShirtGraphic") or d:IsA("Script") or d:IsA("LocalScript") then
			d:Destroy()
		end
	end
end

local function rig(desc: HumanoidDescription?, name: string, scale: number): (Model?, Humanoid?)
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(desc or Instance.new("HumanoidDescription"), Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		return nil, nil
	end
	model.Name = name
	local hum = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	hum.MaxHealth = math.huge
	hum.Health = math.huge
	hum.BreakJointsOnDeath = false
	if scale ~= 1 then
		pcall(function()
			model:ScaleTo(scale)
		end)
	end
	return model, hum
end

local function animate(hum: Humanoid, walkSpeed: number)
	local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum)
	local function load(id)
		local a = Instance.new("Animation")
		a.AnimationId = id
		local ok, track = pcall(function()
			return animator:LoadAnimation(a)
		end)
		return if ok then track else nil
	end
	local walk, idle = load(WALK_ANIM), load(IDLE_ANIM)
	if idle then
		idle.Looped = true
		idle:Play()
	end
	if walk then
		walk.Looped = true
		hum.Running:Connect(function(speed)
			if speed &gt; 0.5 then
				if not walk.IsPlaying then
					walk:Play(0.15)
				end
				walk:AdjustSpeed(speed / walkSpeed)
			elseif walk.IsPlaying then
				walk:Stop(0.2)
			end
		end)
	end
end

-- ---------------------------------------------------------------------------
-- тебЯ: статуя игрока в зале с фигурками

local mimics = {} -- info -&gt; состояние

function E.spawnMimic(info)
	local puzzle = info.puzzle
	-- статуя того, кто сейчас в забеге (случайного живого игрока)
	local alive = G.alivePlayers()
	local who = alive[math.random(1, math.max(1, #alive))]
	local desc = nil
	if who then
		pcall(function()
			desc = Players:GetHumanoidDescriptionFromUserId(who.UserId)
		end)
	end
	local model, hum = rig(desc, "Mimic", 1)
	if not model then
		return
	end
	marble(model, rgb(206, 202, 192))
	model:PivotTo(puzzle.mimicCF * CFrame.new(0, 3, 0))
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	root.Anchored = true
	model.Parent = info.model
	hum.WalkSpeed = Rules.MIMIC.speed
	CollectionService:AddTag(model, "Mimic")
	mimics[info] = { model = model, hum = hum, root = root, info = info, awake = false, log = {}, waitUntil = 0, hitAt = 0, caught = false }
end

function E.removeMimic(info)
	local mm = mimics[info]
	if mm then
		if mm.model.Parent then
			mm.model:Destroy()
		end
		mimics[info] = nil
	end
end

-- статуя рассыпается
function E.crumbleMimic(info)
	local mm = mimics[info]
	if not mm then
		return
	end
	mimics[info] = nil
	sound(mm.root, SOUND.stone, 1.6, 0.5)
	for _, d in mm.model:GetDescendants() do
		if d:IsA("Motor6D") or d:IsA("Weld") or d:IsA("WeldConstraint") then
			d:Destroy()
		end
	end
	for _, d in mm.model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = false
			d.CanCollide = true
			d.AssemblyLinearVelocity = Vector3.new(math.random(-6, 6), 8, math.random(-6, 6))
		end
	end
	Debris:AddItem(mm.model, 6)
end

function E.mimicNear(info, pos: Vector3): boolean
	local mm = mimics[info]
	return mm ~= nil and mm.root.Parent ~= nil and (mm.root.Position - pos).Magnitude &lt; 9
end

local function stepMimics()
	local now = os.clock()
	for info, mm in mimics do
		if not mm.model.Parent then
			mimics[info] = nil
			continue
		end
		-- за кем повторяет: первый вошедший, потом любой живой в зале
		local track = mm.track
		if track and (not G.isAlive(track) or not G.rootOf(track) or not G.inRoom(info, (G.rootOf(track) :: BasePart).Position)) then
			track = nil
		end
		if not track then
			for _, p in G.alivePlayers() do
				local r = G.rootOf(p)
				if r and G.inRoom(info, r.Position) then
					local lp = info.origin:PointToObjectSpace(r.Position)
					if mm.awake or lp.Z &lt; -5 then
						track = p
						break
					end
				end
			end
			mm.track = track
		end
		if not track then
			continue
		end
		local r = G.rootOf(track) :: BasePart
		if not mm.awake then
			mm.awake = true
			mm.root.Anchored = false
			pcall(function()
				mm.root:SetNetworkOwner(nil)
			end)
			animate(mm.hum, Rules.MIMIC.speed)
			mm.waitUntil = now + 2
			sound(mm.root, SOUND.stone, 1.2, 0.7)
			for _, p in G.alivePlayers() do
				G.discover(p, "mimic")
			end
		end
		-- запись пути игрока со временем; статуя идёт туда, где игрок был delay секунд назад
		local last = mm.log[#mm.log]
		if not last or now - last.t &gt; 0.12 then
			table.insert(mm.log, { t = now, x = r.Position.X, z = r.Position.Z, y = r.Position.Y })
		end
		while #mm.log &gt; 2 and mm.log[2].t &lt; now - Rules.MIMIC.delay - 1 do
			table.remove(mm.log, 1)
		end
		local idx = Rules.replayAt(mm.log, now)
		local e = idx and mm.log[idx]
		if e and now &gt;= mm.waitUntil then
			local goal = Vector3.new(e.x, e.y, e.z)
			if (r.Position - mm.root.Position).Magnitude &lt; 4.2 then
				-- догнала: секунду ждёт
				if not mm.caught then
					mm.caught = true
					mm.waitUntil = now + Rules.MIMIC.wait
					mm.hum:MoveTo(mm.root.Position)
				end
			else
				mm.caught = false
				if flat(goal - mm.root.Position).Magnitude &gt; 0.8 then
					mm.hum:MoveTo(goal)
				else
					-- игрок тогда стоял: стоит и она
					mm.hum:MoveTo(mm.root.Position)
				end
			end
		end
		-- касание
		if now - mm.hitAt &gt; 1.5 then
			for _, p in G.alivePlayers() do
				local pr = G.rootOf(p)
				if pr and not G.isHidden(p) and (pr.Position - mm.root.Position).Magnitude &lt; 3.8 then
					mm.hitAt = now
					G.damage(p, Rules.MIMIC.damage, "mimic")
					G.send(p, { type = "fx", kind = "scare" })
					sound(mm.root, SOUND.hit, 1, 0.7)
					break
				end
			end
		end
	end
end

-- ---------------------------------------------------------------------------
-- Колосс

local boss = nil

function E.spawnColossus(info)
	E.removeColossus()
	local model, hum = rig(nil, "Colossus", 3.1)
	if not model then
		return nil
	end
	-- человеческий каркас только двигает существо и остаётся невидимым; видно каменного
	-- зверя из мраморных блоков: длинное тело, четыре ноги, шея, голова без глаз, хвост
	for _, dsc in model:GetDescendants() do
		if dsc:IsA("BasePart") then
			dsc.Transparency = 1
			dsc.CanQuery = false
		elseif dsc:IsA("Decal") then
			dsc:Destroy()
		end
	end
	local hrp = model:FindFirstChild("HumanoidRootPart") :: BasePart
	local stone, dark = rgb(206, 202, 194), rgb(120, 116, 110)
	local motors = { legs = {} }
	local function piece(name, size, offset: CFrame, color, jointAt: CFrame?)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.Color = color or stone
		p.Material = M.Marble
		p.CanCollide = false
		p.CanQuery = false
		p.Massless = true
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.CFrame = hrp.CFrame * offset
		local mt = Instance.new("Motor6D")
		mt.Part0 = hrp
		mt.Part1 = p
		-- сустав: точка вращения в координатах корня и та же точка в координатах детали
		local joint = jointAt or offset
		mt.C0 = joint
		mt.C1 = offset:Inverse() * joint
		mt.Parent = p
		p.Parent = model
		return p, mt
	end
	piece("Body", Vector3.new(7, 6, 15), CFrame.new(0, 1, 1))
	piece("Chest", Vector3.new(8, 7, 5), CFrame.new(0, 1.4, -5.5))
	for k = 0, 3 do
		piece("Spine", Vector3.new(2.2 - k * 0.2, 2.6 - k * 0.3, 2.4), CFrame.new(0, 4.8 - k * 0.2, -5 + k * 3.6) * CFrame.Angles(0.3, 0, 0), dark)
	end
	piece("Crack", Vector3.new(0.25, 4.5, 6), CFrame.new(3.52, 1.4, 0) * CFrame.Angles(0.5, 0, 0), rgb(60, 58, 56))
	piece("Crack", Vector3.new(0.25, 3.5, 5), CFrame.new(-3.52, 0.8, 3) * CFrame.Angles(-0.4, 0, 0), rgb(60, 58, 56))
	-- шея и голова двигаются вместе, когда он принюхивается
	local neckJoint = CFrame.new(0, 3, -7.5)
	local _, neckM = piece("Neck", Vector3.new(3.6, 3.6, 6.5), CFrame.new(0, 4.6, -10) * CFrame.Angles(0.45, 0, 0), stone, neckJoint)
	local _, headM = piece("Head", Vector3.new(4.6, 3.8, 6.8), CFrame.new(0, 6.6, -14.4), stone, neckJoint)
	local _, jawM = piece("Jaw", Vector3.new(4, 1.1, 5.6), CFrame.new(0, 4.3, -14.6), dark, neckJoint)
	local _, crestM = piece("Crest", Vector3.new(1, 2.4, 4.4), CFrame.new(0, 9, -13.2) * CFrame.Angles(-0.3, 0, 0), dark, neckJoint)
	local _, n1 = piece("Nostril", Vector3.new(0.5, 0.9, 0.2), CFrame.new(-0.9, 6.3, -17.82), rgb(30, 28, 26), neckJoint)
	local _, n2 = piece("Nostril", Vector3.new(0.5, 0.9, 0.2), CFrame.new(0.9, 6.3, -17.82), rgb(30, 28, 26), neckJoint)
	local _, brow = piece("BlindBrow", Vector3.new(4.8, 1, 3), CFrame.new(0, 7.6, -15.6), dark, neckJoint)
	motors.head = { neckM, headM, jawM, crestM, n1, n2, brow }
	for _, mt in motors.head do
		mt:SetAttribute("Rest", mt.C0)
	end
	-- ноги: бедро качается при ходьбе
	for _, sx in { -1, 1 } do
		for _, z in { -5, 6.5 } do
			local hip = CFrame.new(sx * 3.6, 0, z)
			local _, lm = piece("Leg", Vector3.new(2.6, 9.2, 3), CFrame.new(sx * 3.6, -4.6, z), stone, hip)
			local _, fm = piece("Foot", Vector3.new(3.4, 1, 4.2), CFrame.new(sx * 3.6, -8.8, z - 0.5), dark, hip)
			table.insert(motors.legs, { lm, fm, phase = if (sx &lt; 0) == (z &lt; 0) then 0 else math.pi, rest = hip })
		end
	end
	for k = 0, 4 do
		piece("Tail", Vector3.new(3 - k * 0.5, 2.6 - k * 0.4, 3.4), CFrame.new(0, 1 - k * 1.1, 9.5 + k * 3) * CFrame.Angles(-0.35, 0, 0), if k % 2 == 0 then stone else dark)
	end
	model:PivotTo(info.arena.spawn * CFrame.new(0, 3 * 3.1, 0))
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	root.Anchored = true
	model.Parent = info.model
	CollectionService:AddTag(model, "Colossus")
	boss = { model = model, hum = hum, root = root, info = info, motors = motors, state = "statue", target = nil, sniffAt = 0, until_ = 0, wanderAt = 0, path = nil, pathAt = 0, wp = 1 }
	return model
end

function E.removeColossus()
	if boss then
		if boss.model.Parent then
			boss.model:Destroy()
		end
		boss = nil
	end
end

function E.wakeColossus()
	local b = boss
	if not b or b.state ~= "statue" then
		return
	end
	b.root.Anchored = false
	pcall(function()
		b.root:SetNetworkOwner(nil)
	end)
	animate(b.hum, 16)
	b.hum.WalkSpeed = Rules.COLOSSUS.wander
	b.state = "wander"
	b.sniffAt = os.clock() + Rules.COLOSSUS.sniffEvery
	sound(b.root, SOUND.stone, 2, 0.4)
end

-- поза головы на время: listen — прислушивается, roar — учуял и рычит, lost — потерял
-- след и мотает головой, eat — ест, stun — ослеплён светом
local function pose(b, kind: string, dur: number)
	b.pose = { kind = kind, t0 = os.clock(), dur = dur }
end

-- шум в точке
function E.noise(pos: Vector3, radius: number)
	local b = boss
	if not b or b.state == "statue" or b.state == "defeat" or b.state == "bait" or b.state == "eat" or b.state == "stun" then
		return
	end
	if (b.root.Position - pos).Magnitude &gt; radius then
		return
	end
	if b.state == "hunt" or b.state == "listen" then
		b.target = pos
		return
	end
	-- сначала замирает и прислушивается, потом идёт на звук
	b.state = "listen"
	b.target = pos
	b.until_ = os.clock() + 1.1
	b.hum:MoveTo(b.root.Position)
	pose(b, "listen", 1.1)
end

-- на полу лежит мясо: идёт к нему
function E.bait(pos: Vector3)
	local b = boss
	if b and b.state ~= "statue" and b.state ~= "defeat" and b.state ~= "stun" then
		b.state = "bait"
		b.target = pos
		b.path = nil
	end
end

local function bossGo(goal: Vector3)
	local b = boss
	local now = os.clock()
	if not b.path or now - b.pathAt &gt; 1.5 or (b.goal and (b.goal - goal).Magnitude &gt; 8) then
		b.pathAt = now
		b.goal = goal
		local path = PathfindingService:CreatePath({ AgentRadius = 5, AgentHeight = 16, AgentCanJump = false })
		local ok = pcall(function()
			path:ComputeAsync(b.root.Position, goal)
		end)
		if ok and path.Status == Enum.PathStatus.Success then
			b.path = path:GetWaypoints()
			b.wp = 2
		else
			b.path = nil
			b.hum:MoveTo(goal)
			return
		end
	end
	local w = b.path and b.path[b.wp]
	if w then
		if flat(w.Position - b.root.Position).Magnitude &lt; 5 then
			b.wp += 1
			w = b.path[b.wp] or w
		end
		b.hum:MoveTo(w.Position)
	end
end

-- принюхивается: шея и голова медленно водят из стороны в сторону
local function sniffAnim(b)
	b.sniffFrom = os.clock()
	sound(b.root, SOUND.rumble, 1.4, 0.5)
end

-- ноги шагают, пока он идёт; голова живёт своей позой
local function animateBeast()
	local b = boss
	if not b or not b.motors or not b.root.Parent or b.state == "defeat" then
		return
	end
	local t = os.clock()
	local v = b.root.AssemblyLinearVelocity
	local speed = Vector3.new(v.X, 0, v.Z).Magnitude
	local amp = math.clamp(speed / 12, 0, 1) * 0.45
	local tremble = if b.state == "stun" then math.sin(t * 23) * 0.05 else 0
	for _, leg in b.motors.legs do
		local a = math.sin(t * (3 + speed * 0.25) + leg.phase) * amp + tremble
		local c0 = leg.rest * CFrame.Angles(a, 0, 0)
		leg[1].C0 = c0
		leg[2].C0 = c0
	end
	local yaw, pitch, roll = 0, 0, 0
	local ps = b.pose
	if ps and t - ps.t0 &lt; ps.dur then
		local k = (t - ps.t0) / ps.dur
		if ps.kind == "listen" then
			-- замер, голова чуть набок и вверх
			roll = math.sin(math.min(1, k * 3) * math.pi / 2) * 0.35
			pitch = -0.12
		elseif ps.kind == "roar" then
			pitch = -0.5 * math.sin(k * math.pi)
			yaw = math.sin(t * 30) * 0.04
		elseif ps.kind == "lost" then
			yaw = math.sin(k * math.pi * 4) * 0.55
			pitch = 0.1
		elseif ps.kind == "eat" then
			pitch = 0.5 + math.sin(t * 7) * 0.08
		elseif ps.kind == "stun" then
			pitch = -0.55 + math.sin(t * 17) * 0.1
			yaw = math.sin(t * 5) * 0.3
		end
	elseif b.sniffFrom and t - b.sniffFrom &lt; Rules.COLOSSUS.sniffTime then
		local k = (t - b.sniffFrom) / Rules.COLOSSUS.sniffTime
		yaw = math.sin(k * math.pi * 3) * 0.6
		pitch = -0.25 * math.sin(k * math.pi)
	elseif b.state == "hunt" or b.state == "bait" then
		pitch = 0.12
	end
	for _, mt in b.motors.head do
		local rest = mt:GetAttribute("Rest")
		if typeof(rest) == "CFrame" then
			mt.C0 = rest * CFrame.Angles(pitch, yaw, roll)
		end
	end
end

-- поражение: люстра падает на ослеплённого зверя. Ноги подгибаются, голова
-- падает, по камню бегут светящиеся трещины, и он разваливается на куски
local function defeat(b)
	b.state = "defeat"
	b.hum.WalkSpeed = 0
	b.hum:MoveTo(b.root.Position)
	b.root.Anchored = true
	G.sendAll({ type = "fx", kind = "melt" })
	sound(b.root, SOUND.scream, 2, 0.3)
	local info = b.info
	local model = b.model
	local base = b.root.CFrame
	task.spawn(function()
		local t0 = os.clock()
		while os.clock() - t0 &lt; 1.8 and model.Parent do
			local k = math.min(1, (os.clock() - t0) / 1.8)
			for _, leg in b.motors.legs do
				local side = if leg.rest.Position.X &lt; 0 then -1 else 1
				local c0 = leg.rest * CFrame.Angles(0.2 * k, 0, side * 0.9 * k)
				leg[1].C0 = c0
				leg[2].C0 = c0
			end
			for _, mt in b.motors.head do
				local rest = mt:GetAttribute("Rest")
				if typeof(rest) == "CFrame" then
					mt.C0 = rest * CFrame.Angles(0.75 * k, math.sin(k * 9) * 0.1 * (1 - k), 0)
				end
			end
			b.root.CFrame = base * CFrame.new(0, -3.4 * k, 0) * CFrame.Angles(0, 0, 0.12 * k)
			task.wait()
		end
		if not model.Parent then
			return
		end
		-- трещины светятся изнутри
		local body = model:FindFirstChild("Body") :: BasePart
		for i = 1, 12 do
			local host = if i % 2 == 0 then body else (model:FindFirstChild("Chest") or body)
			if host then
				local c = Instance.new("Part")
				c.Name = "GlowCrack"
				c.Size = Vector3.new(0.3, 1.5 + math.random() * 3, 0.3)
				c.Material = Enum.Material.Neon
				c.Color = rgb(255, 214, 140)
				c.CanCollide = false
				c.Massless = true
				local hs = host.Size
				c.CFrame = host.CFrame * CFrame.new((math.random() - 0.5) * hs.X, (math.random() - 0.5) * hs.Y, (math.random() - 0.5) * hs.Z) * CFrame.Angles(math.random() * 3, math.random() * 3, math.random() * 3)
				local w = Instance.new("WeldConstraint")
				w.Part0 = host
				w.Part1 = c
				w.Parent = c
				c.Parent = model
				sound(c, SOUND.stone, 0.6, 0.6 + math.random() * 0.6)
				task.wait(0.12)
			end
		end
		local dust = Instance.new("ParticleEmitter")
		dust.Color = ColorSequence.new(rgb(210, 204, 194))
		dust.Size = NumberSequence.new(4, 8)
		dust.Transparency = NumberSequence.new(0.3, 1)
		dust.Lifetime = NumberRange.new(1.5, 2.5)
		dust.Rate = 60
		dust.Speed = NumberRange.new(2, 6)
		dust.Parent = b.root
		task.wait(0.8)
		-- разваливается: суставы рвутся, куски падают на пол
		sound(b.root, SOUND.stone, 2.4, 0.35)
		for _, dsc in model:GetDescendants() do
			if dsc:IsA("Motor6D") then
				dsc:Destroy()
			end
		end
		for _, dsc in model:GetDescendants() do
			if dsc:IsA("BasePart") and dsc ~= b.root then
				dsc.Anchored = false
				if dsc.Transparency &lt; 1 then
					dsc.CanCollide = true
					dsc.AssemblyLinearVelocity = Vector3.new(math.random(-10, 10), math.random(4, 12), math.random(-10, 10))
				else
					dsc.CanCollide = false
				end
			end
		end
		local hum = model:FindFirstChildOfClass("Humanoid")
		if hum then
			hum:Destroy()
		end
		task.wait(1.5)
		dust.Rate = 0
		local pos = b.root.Position
		boss = nil
		Debris:AddItem(model, 40)
		G.bossDead(info, pos)
	end)
end

-- люстра упала: ослеплённый зверь под ней — побеждён
function E.chandelierHit(pos: Vector3, radius: number): boolean
	local b = boss
	if not b or not b.root.Parent then
		return false
	end
	local near = flat(b.root.Position - pos).Magnitude &lt; radius
	if near and b.state == "stun" then
		defeat(b)
		return true
	end
	return false
end

local function stepColossus()
	local b = boss
	if not b or not b.root.Parent or b.state == "statue" or b.state == "defeat" then
		return
	end
	local now = os.clock()
	local C = Rules.COLOSSUS
	local arena = b.info.arena
	-- слышит шаги и ловит тех, кто рядом на полу зала (на галереях не достаёт)
	for _, p in G.alivePlayers() do
		local r = G.rootOf(p)
		if r and G.inRoom(b.info, r.Position) then
			local v = r.AssemblyLinearVelocity
			local radius = Rules.noise(Vector3.new(v.X, 0, v.Z).Magnitude, G.isSneaking(p))
			if radius &gt; 0 then
				E.noise(r.Position, radius)
			end
			local low = r.Position.Y &lt; arena.floorY + 7
			if low and flat(r.Position - b.root.Position).Magnitude &lt; 8.5 and b.state ~= "eat" and b.state ~= "stun" then
				G.kill(p, "colossus")
				sound(b.root, SOUND.stone, 1.6, 0.5)
				if b.state == "hunt" then
					b.state = "wander"
					b.target = nil
				end
			end
		end
	end
	if b.state == "bait" then
		b.hum.WalkSpeed = C.hunt
		bossGo(b.target)
		if flat(b.target - b.root.Position).Magnitude &lt; 7 then
			b.hum:MoveTo(b.root.Position)
			G.eatBait(b.info)
			local inLight = arena.lit and flat(b.target - arena.zone.Position).Magnitude &lt; Rules.ARENA.zone
			if inLight then
				-- свет ударил в камень: зверь ослеплён и бьётся на месте
				b.state = "stun"
				b.until_ = now + Rules.ARENA.stun
				pose(b, "stun", Rules.ARENA.stun)
				sound(b.root, SOUND.scream, 2, 0.5)
				G.sendAll({ type = "fx", kind = "shake" })
			else
				-- мясо не там: съедает и уходит
				b.state = "eat"
				b.until_ = now + 2.5
				pose(b, "eat", 2.5)
				sound(b.root, SOUND.hit, 1.4, 0.4)
			end
		end
	elseif b.state == "eat" or b.state == "stun" then
		b.hum:MoveTo(b.root.Position)
		if now &gt; b.until_ then
			b.state = "wander"
			b.target = nil
			b.pose = nil
		end
	elseif b.state == "listen" then
		b.hum:MoveTo(b.root.Position)
		if now &gt; b.until_ then
			b.state = "hunt"
			b.hunting = true
			pose(b, "roar", 0.9)
			sound(b.root, SOUND.scream, 1.2, 0.6)
		end
	elseif b.state == "sniff" then
		b.hum:MoveTo(b.root.Position)
		if now &gt; b.until_ then
			-- учуял того, кто рядом на полу
			local best, bestD = nil, C.sniffRange
			for _, p in G.alivePlayers() do
				local r = G.rootOf(p)
				if r and r.Position.Y &lt; arena.floorY + 7 and not G.isHidden(p) then
					local dd = (r.Position - b.root.Position).Magnitude
					if dd &lt; bestD then
						best, bestD = r, dd
					end
				end
			end
			if best then
				b.state = "hunt"
				b.target = best.Position
				pose(b, "roar", 0.9)
				sound(b.root, SOUND.scream, 1.2, 0.6)
			else
				if b.hunting then
					-- потерял след: мотает головой и возвращается к обходу
					pose(b, "lost", 1.6)
					b.hunting = false
				end
				b.state = "wander"
				b.target = nil
			end
			b.sniffAt = now + C.sniffEvery
		end
	elseif b.state == "hunt" and b.target then
		b.hum.WalkSpeed = C.hunt
		bossGo(b.target)
		if flat(b.target - b.root.Position).Magnitude &lt; 6 then
			b.state = "sniff"
			b.until_ = now + C.sniffTime
			sniffAnim(b)
		end
	else
		b.hum.WalkSpeed = C.wander
		if b.pose and b.pose.kind == "lost" and now - b.pose.t0 &lt; b.pose.dur then
			b.hum:MoveTo(b.root.Position)
			return
		end
		if now &gt; b.sniffAt then
			b.state = "sniff"
			b.until_ = now + C.sniffTime
			sniffAnim(b)
			return
		end
		if not b.target or now &gt; b.wanderAt or flat(b.target - b.root.Position).Magnitude &lt; 6 then
			b.wanderAt = now + 9
			b.target = arena.wander[math.random(1, #arena.wander)]
		end
		bossGo(b.target)
	end
end

-- ---------------------------------------------------------------------------

function E.removeRoom(info)
	E.removeMimic(info)
	if boss and boss.info == info then
		E.removeColossus()
	end
end

function E.clear()
	for info in mimics do
		E.removeMimic(info)
	end
	E.removeColossus()
	for _, h in workspace:GetChildren() do
		if h.Name == "Darkness" then
			h:Destroy()
		end
	end
	E.darkActive = false
end

function E.init(game_)
	G = game_
	RunService.Heartbeat:Connect(function()
		pcall(animateBeast)
	end)
	task.spawn(function()
		while true do
			task.wait(0.15)
			local ok, err = pcall(stepMimics)
			if not ok then
				warn("[Museum] mimic: " .. tostring(err))
			end
			ok, err = pcall(stepColossus)
			if not ok then
				warn("[Museum] colossus: " .. tostring(err))
			end
		end
	end)
end

return E
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000015">
          <Properties>
            <string name="Name">Game</string>
            <ProtectedString name="Source">--!nonstrict
-- «The Museum»: лобби и забег.
-- Лобби (обычный сервер): ночная улица перед музеем. Кто зашёл в тёмные двери,
-- переносится в отдельный сервер этого же места — там идёт забег.
-- Забег: залы строятся впереди и убираются позади; двери открываются сами (кроме
-- запертых и загадок); Тьма, тебЯ, Монетчик, Колосс; журнал существ; на двери 050 —
-- кодовый замок и зал зеркал, на 099 — лифт, рычаги и длинная лестница к двери 100

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local TeleportService = game:GetService("TeleportService")
local RunService = game:GetService("RunService")
local BadgeService = game:GetService("BadgeService")
local Debris = game:GetService("Debris")

local Shared = game:GetService("ReplicatedStorage").Workshop.Shared
local Rules = require(Shared.Rules)
local Plan = require(Shared.RoomPlan)
local Remotes = require(Shared.Roblox.Remotes)
local Lang = require(Shared.Lang)
local M = require(Shared.Materials)

local Config = require(script.Parent.Parent.Config)
local Props = require(script.Parent.Parent.World.Props)
local Builder = require(script.Parent.Parent.World.RoomBuilder)
local Special = require(script.Parent.Parent.World.Special)
local Entities = require(script.Parent.Entities)
local Records = require(script.Parent.Records)

local G = {}

local event: RemoteEvent
local world: Folder

G.mode = if game.PrivateServerId ~= "" and game.PrivateServerOwnerId == 0 then "run" else "lobby"

local KEEP_BEHIND = 4

local run = { active = false, seed = 0, plan = nil, descs = {}, rooms = {}, front = 0, ending = false, done = false, keepers = {} }
G.run = run

local players: { [Player]: any } = {}
G.players = players
local occupied: { [BasePart]: Player } = {}
local lobby = nil

-- ---------------------------------------------------------------------------
-- общее

function G.rootOf(p: Player): BasePart?
	return p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
end
local rootOf = G.rootOf

local function humOf(p: Player): Humanoid?
	return p.Character and p.Character:FindFirstChildOfClass("Humanoid")
end
G.humOf = humOf

function G.send(p: Player, msg)
	if p.Parent then
		event:FireClient(p, msg)
	end
end
local send = G.send

function G.sendAll(msg)
	event:FireAllClients(msg)
end

local function toast(p: Player, key: string, ...)
	send(p, { type = "toast", key = key, args = { ... } })
end
G.toast = toast

function G.isAlive(p: Player): boolean
	local s = players[p]
	return s ~= nil and s.alive
end

function G.isHidden(p: Player): boolean
	local s = players[p]
	return s ~= nil and s.hidden ~= nil
end

function G.isSneaking(p: Player): boolean
	local s = players[p]
	return s ~= nil and s.sneaking == true
end

function G.alivePlayers(): { Player }
	local list = {}
	for p, s in players do
		if s.alive and p.Parent then
			table.insert(list, p)
		end
	end
	return list
end

function G.inRoom(info, pos: Vector3): boolean
	return Builder.contains(info, pos) or Special.onStairs(info, pos)
end

-- залы, через которые летит Тьма: от самого старого до последнего открытого
function G.loadedRooms()
	local list = {}
	for n = math.max(0, run.front - KEEP_BEHIND), run.front do
		local info = run.rooms[n]
		if info and not Rules.isSpecial(n) or (info and n == 0) then
			table.insert(list, info)
		end
	end
	return list
end

local function roomOf(pos: Vector3)
	for _, info in run.rooms do
		if G.inRoom(info, pos) then
			return info
		end
	end
	return nil
end

local function teleport(p: Player, cf: CFrame)
	local char = p.Character
	if not char then
		return
	end
	local r = rootOf(p)
	if r then
		r.Anchored = false
		r.AssemblyLinearVelocity = Vector3.zero
	end
	pcall(function()
		p:RequestStreamAroundAsync(cf.Position, 3)
	end)
	char:PivotTo(cf)
end
G.teleport = teleport

local function sound(at: Instance?, id: string, vol: number, speed: number?)
	if at then
		Entities.sound(at, id, vol, speed)
	end
end

local SOUND = {
	door = "rbxasset://sounds/swoosh.wav",
	locked = "rbxasset://sounds/clickfast.wav",
	pick = "rbxasset://sounds/electronicpingshort.wav",
	switch = "rbxasset://sounds/switch.wav",
	slam = "rbxasset://sounds/collide.wav",
}

-- журнал: новая запись, значок
local function badge(p: Player, id: string)
	local badgeId = Config.BADGES[id]
	if type(badgeId) == "number" and badgeId &gt; 0 then
		task.spawn(function()
			pcall(function()
				BadgeService:AwardBadge(p.UserId, badgeId)
			end)
		end)
	end
end

-- достижение: значок (если его ID вписан в Config) и надпись у игрока
function G.achieve(p: Player, id: string)
	if players[p] and Records.achieve(p, id) then
		send(p, { type = "achieve", id = id })
		badge(p, id)
	end
end

function G.achieveAll(id: string)
	for _, p in G.alivePlayers() do
		G.achieve(p, id)
	end
end

function G.discover(p: Player, id: string)
	if players[p] and Records.discover(p, id) then
		send(p, { type = "journal", id = id, new = true })
		badge(p, id)
	end
	if id == "darkness" or id == "coinkeeper" then
		G.achieve(p, id)
	end
end

-- ---------------------------------------------------------------------------
-- инвентарь: обычные инструменты Roblox

local ITEM_LOOK = {
	flashlight = { size = Vector3.new(0.45, 0.45, 1.5), color = Color3.fromRGB(46, 46, 50), mat = M.Metal },
	battery = { size = Vector3.new(0.4, 0.8, 0.4), color = Color3.fromRGB(40, 130, 60), mat = M.Metal },
	plant = { size = Vector3.new(0.7, 0.6, 0.7), color = Color3.fromRGB(140, 76, 54), mat = M.Brick },
	lockpick = { size = Vector3.new(0.1, 0.1, 1.1), color = Color3.fromRGB(170, 170, 176), mat = M.Metal },
	key = { size = Vector3.new(0.15, 0.15, 1), color = Color3.fromRGB(190, 156, 88), mat = M.Metal },
	hammer = { size = Vector3.new(0.2, 0.2, 1.6), color = Color3.fromRGB(112, 78, 52), mat = M.Wood },
	meat = { size = Vector3.new(0.9, 0.5, 1.2), color = Color3.fromRGB(150, 40, 40), mat = M.SmoothPlastic },
	pole = { size = Vector3.new(0.25, 0.25, 4.5), color = Color3.fromRGB(150, 110, 70), mat = M.Wood },
	lens = { size = Vector3.new(1.2, 1.2, 0.12), color = Color3.fromRGB(200, 220, 230), mat = M.Glass },
	coldkey = { size = Vector3.new(0.15, 0.15, 1), color = Color3.fromRGB(120, 170, 200), mat = M.Metal },
	clockkey = { size = Vector3.new(1, 1, 0.3), color = Color3.fromRGB(24, 22, 22), mat = M.Metal },
}

local setFlash

local function makeTool(p: Player, item: string)
	local look = ITEM_LOOK[item]
	local tool = Instance.new("Tool")
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool:SetAttribute("Item", item)
	local h = Instance.new("Part")
	h.Name = "Handle"
	h.Size = look.size
	h.Color = look.color
	h.Material = look.mat
	h.CanCollide = false
	h.Massless = true
	h.Parent = tool
	local function extra(name, size, offset, color, mat, shape)
		local e = Instance.new("Part")
		e.Name = name
		e.Size = size
		e.Color = color
		e.Material = mat
		e.CanCollide = false
		e.Massless = true
		if shape then
			e.Shape = shape
		end
		e.CFrame = h.CFrame * offset
		local w = Instance.new("WeldConstraint")
		w.Part0 = h
		w.Part1 = e
		w.Parent = e
		e.Parent = tool
	end
	if item == "flashlight" then
		extra("Head", Vector3.new(0.65, 0.65, 0.4), CFrame.new(0, 0, -0.9), Color3.fromRGB(60, 60, 64), M.Metal)
		extra("Lens", Vector3.new(0.5, 0.5, 0.05), CFrame.new(0, 0, -1.12), Color3.fromRGB(255, 240, 200), M.Neon)
		local l = Instance.new("SpotLight")
		l.Name = "Beam"
		l.Face = Enum.NormalId.Front
		l.Range = 50
		l.Angle = 48
		l.Brightness = 3
		l.Color = Color3.fromRGB(255, 244, 220)
		l.Shadows = true
		l.Enabled = false
		l.Parent = h
	elseif item == "plant" then
		extra("Leaves", Vector3.new(0.9, 0.9, 0.9), CFrame.new(0, 0.6, 0), Color3.fromRGB(80, 170, 90), M.Grass, Enum.PartType.Ball)
	elseif item == "key" then
		extra("Bow", Vector3.new(0.15, 0.5, 0.5), CFrame.new(0, 0, 0.6), Color3.fromRGB(190, 156, 88), M.Metal)
	elseif item == "hammer" then
		extra("Head", Vector3.new(0.9, 0.4, 0.4), CFrame.new(0, 0, -0.8), Color3.fromRGB(90, 92, 96), M.Metal)
	elseif item == "pole" then
		extra("Hook", Vector3.new(0.15, 0.6, 0.15), CFrame.new(0, 0.25, -2.2), Color3.fromRGB(70, 70, 74), M.Metal)
	elseif item == "clockkey" then
		extra("Rim", Vector3.new(1.1, 1.1, 0.2), CFrame.new(0, 0, 0.05), Color3.fromRGB(214, 170, 70), M.Metal)
		extra("Dial", Vector3.new(0.8, 0.8, 0.05), CFrame.new(0, 0, -0.17), Color3.fromRGB(244, 236, 214), M.SmoothPlastic)
	elseif item == "meat" then
		extra("Bone", Vector3.new(0.2, 0.2, 1.9), CFrame.new(0, 0, 0), Color3.fromRGB(230, 224, 204), M.SmoothPlastic)
	end
	tool.Activated:Connect(function()
		G.use(p, item)
	end)
	if item == "flashlight" then
		tool.Equipped:Connect(function()
			setFlash(p, true)
		end)
		tool.Unequipped:Connect(function()
			setFlash(p, false)
		end)
	end
	tool.Parent = p:FindFirstChildOfClass("Backpack")
	return tool
end

local function syncTools(p: Player)
	local s = players[p]
	if not s or not s.alive then
		return
	end
	local n = 0
	for _ in s.keys do
		n += 1
	end
	s.inv.key = if n &gt; 0 then n else nil
	local want = { flashlight = 1 }
	for item, count in s.inv do
		if ITEM_LOOK[item] then
			want[item] = count
		end
	end
	for item, tool in s.tools do
		if not want[item] or not tool.Parent then
			if tool.Parent then
				tool:Destroy()
			end
			s.tools[item] = nil
		end
	end
	for item, count in want do
		local tool = s.tools[item]
		if not tool then
			tool = makeTool(p, item)
			s.tools[item] = tool
		end
		local name = Lang.t(s.lang or "en", "item_" .. item)
		tool.Name = if count &gt; 1 then name .. " ×" .. count else name
	end
	p:SetAttribute("Coins", s.coins)
	p:SetAttribute("Lockpicks", s.inv.lockpick or 0)
end
G.syncTools = syncTools

local function equipped(p: Player, item: string): boolean
	local char = p.Character
	local tool = char and char:FindFirstChildOfClass("Tool")
	return tool ~= nil and tool:GetAttribute("Item") == item
end

-- ---------------------------------------------------------------------------
-- урон и смерть

function G.damage(p: Player, amount: number, cause: string?)
	local s = players[p]
	local hum = humOf(p)
	if not s or not s.alive or not hum or s.god then
		return
	end
	s.cause = cause
	hum:TakeDamage(amount)
end

function G.kill(p: Player, cause: string?)
	local s = players[p]
	local hum = humOf(p)
	if not s or not s.alive or not hum or s.god then
		return
	end
	s.cause = cause
	hum.Health = 0
end

local endRun
local dropFigure

local function onDied(p: Player)
	local s = players[p]
	if not s or not s.alive then
		return
	end
	s.alive = false
	p:SetAttribute("Alive", false)
	local part = s.hidden
	if part then
		occupied[part] = nil
		s.hidden = nil
	end
	dropFigure(p)
	send(p, { type = "dead", cause = s.cause or "unknown", door = run.front })
	if #G.alivePlayers() == 0 and run.active and not run.done then
		task.spawn(endRun)
	end
end

-- ---------------------------------------------------------------------------
-- фонарик

function setFlash(p: Player, on: boolean)
	local s = players[p]
	if not s then
		return
	end
	s.flashOn = on and s.flash &gt; 0 and s.alive and equipped(p, "flashlight")
	local tool = s.tools.flashlight
	local beam = tool and tool:FindFirstChild("Handle") and tool.Handle:FindFirstChild("Beam")
	if beam then
		beam.Enabled = s.flashOn
	end
	p:SetAttribute("FlashOn", s.flashOn)
	p:SetAttribute("Flash", math.ceil(s.flash))
end

-- ---------------------------------------------------------------------------
-- шкафчики

local function unhide(p: Player)
	local s = players[p]
	local part = s and s.hidden
	if not part then
		return
	end
	s.hidden = nil
	occupied[part] = nil
	p:SetAttribute("HiddenEye", nil)
	local r = rootOf(p)
	if r then
		r.Anchored = false
		local out = part.CFrame * CFrame.new(0, -part.Size.Y / 2 + 3, -(part.Size.Z / 2 + 2.4))
		p.Character:PivotTo(CFrame.lookAt(out.Position, out.Position + part.CFrame.LookVector))
	end
end
G.unhide = unhide

local function hide(p: Player, part: BasePart)
	local s = players[p]
	if not s or not s.alive then
		return
	end
	if s.hidden == part then
		unhide(p)
		return
	end
	if s.hidden or occupied[part] then
		return
	end
	dropFigure(p)
	s.hidden = part
	occupied[part] = p
	local r = rootOf(p)
	if r then
		p.Character:PivotTo(part.CFrame * CFrame.new(0, -part.Size.Y / 2 + 3, 0.2))
		r.Anchored = true
	end
	-- глаза у самых прорезей дверцы: зал виден сквозь щели (их рисует клиент)
	p:SetAttribute("HiddenEye", part.CFrame * CFrame.new(0, math.min(1.9, part.Size.Y / 2 - 0.5), -part.Size.Z / 2 - 0.55))
end

-- ---------------------------------------------------------------------------
-- предметы

local function give(p: Player, item: string, amount: number?): boolean
	local s = players[p]
	if not s then
		return false
	end
	if item == "coins" then
		s.coins += amount or 1
		sound(rootOf(p), SOUND.pick, 0.5, 1.6)
		syncTools(p)
		return true
	end
	if not Rules.add(s.inv, item) then
		toast(p, "BagFull")
		return false
	end
	sound(rootOf(p), SOUND.pick, 0.6)
	syncTools(p)
	return true
end
G.give = give

local solveFigures

function G.use(p: Player, item: string)
	local s = players[p]
	if not s or not s.alive then
		return
	end
	if item == "flashlight" then
		setFlash(p, not s.flashOn)
	elseif item == "plant" then
		local hum = humOf(p)
		if hum and hum.Health &lt; hum.MaxHealth - 1 and Rules.take(s.inv, "plant") then
			hum.Health = math.min(hum.MaxHealth, hum.Health + Rules.PLANT_HEAL)
		end
	elseif item == "battery" then
		if s.flash &lt; Rules.FLASH_MAX - 1 and Rules.take(s.inv, "battery") then
			s.flash = Rules.recharge(s.flash)
			setFlash(p, s.flashOn)
		end
	elseif item == "hammer" then
		-- молотком можно разбить статую тебЯ, если подойти вплотную
		local r = rootOf(p)
		local info = r and roomOf(r.Position)
		if info and info.puzzle and not info.puzzle.solved and Entities.mimicNear(info, r.Position) and Rules.take(s.inv, "hammer") then
			solveFigures(info)
		end
	elseif item == "meat" then
		-- на арене мясо кладут на пол как приманку
		local r = rootOf(p)
		local info = r and roomOf(r.Position)
		if not (info and info.arena and G.dropBait(p, info)) then
			return
		end
	else
		return
	end
	syncTools(p)
end

-- ---------------------------------------------------------------------------
-- двери

local function descOf(n: number)
	while run.descs[0] == nil or #run.descs &lt; n do
		local k = if run.descs[0] == nil then 0 else #run.descs + 1
		run.descs[k] = Plan.room(run.plan, k)
	end
	return run.descs[n]
end

local openDoor

local function makeDoor(info, n: number, cf: CFrame, opts)
	local m, leaves = Props.door(info.model, cf, opts.plate, opts.locked, opts.size, opts.style)
	local door = { model = m, leaves = leaves, number = n, locked = opts.locked, cf = cf, opened = false, decoy = opts.decoy, size = opts.size or "normal" }
	if opts.locked and not opts.noPick then
		local trig = Props.P(m, "LockTrigger", Vector3.new(1, 1, 1), cf * CFrame.new(1.2, 4.5, 0.6), Color3.new(0, 0, 0), M.SmoothPlastic, Props.nc({ Transparency = 1 }))
		local pr = Props.prompt(trig, "lockpick", 2.5, 7)
		door.lockPrompt = pr
		pr.Triggered:Connect(function(p)
			G.pick(p, n)
		end)
	end
	return door
end

-- створки поворачиваются на петлях (open = 1 — открыть, 0 — закрыть)
local function swing(door, open: boolean, time: number?)
	for _, leaf in door.leaves do
		local base = leaf:GetAttribute("Base")
		if typeof(base) ~= "CFrame" then
			base = leaf:GetPivot()
			leaf:SetAttribute("Base", base)
		end
		local dir = leaf:GetAttribute("Dir") or 1
		local v = Instance.new("NumberValue")
		v.Value = if open then 0 else 1
		v.Changed:Connect(function(a)
			leaf:PivotTo(base * CFrame.Angles(0, math.rad(-100) * a * dir, 0))
		end)
		local t = TweenService:Create(v, TweenInfo.new(time or 0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Value = if open then 1 else 0 })
		t:Play()
		t.Completed:Connect(function()
			v:Destroy()
		end)
		for _, d in leaf:GetDescendants() do
			if d:IsA("BasePart") and d.Name == "Slab" then
				d.CanCollide = not open
			end
		end
	end
	sound(door.model:FindFirstChildWhichIsA("BasePart"), if open then SOUND.door else SOUND.slam, if open then 0.8 else 1.6, 0.6)
end

-- ---------------------------------------------------------------------------
-- ящики и находки

local wirePickups

-- один ящик: выдвинуть или задвинуть. Находка лежит внутри и ездит вместе с ящиком
local function toggleDrawer(info, sr, dr)
	if dr.busy then
		return
	end
	dr.busy = true
	if not dr.rolled then
		dr.rolled = true
		local slot = Props.model(dr.model, "Loot")
		if sr.key and sr.keyDrawer == dr then
			local _, part = Props.pickup(slot, dr.inside * CFrame.new(-0.5, 0, 0), "key")
			part:SetAttribute("KeyFor", sr.key)
		end
		local item, amount = Rules.loot(math.random(), run.front)
		if item ~= "nothing" then
			local _, part = Props.pickup(slot, dr.inside * CFrame.new(if sr.keyDrawer == dr then 0.6 else 0, 0, 0), item)
			if item == "coins" then
				part:SetAttribute("Amount", amount)
			end
		end
		wirePickups(info)
	end
	dr.open = not dr.open
	local base = dr.base or dr.model:GetPivot()
	dr.base = base
	local from, to = if dr.open then 0 else 1, if dr.open then 1 else 0
	local v = Instance.new("NumberValue")
	v.Value = from
	v.Changed:Connect(function(a)
		if dr.model.Parent then
			dr.model:PivotTo(base * CFrame.new(0, 0, -1.3 * a))
		end
	end)
	local t = TweenService:Create(v, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Value = to })
	t:Play()
	t.Completed:Connect(function()
		v:Destroy()
		dr.busy = false
	end)
	sound(dr.hit, SOUND.door, 0.5, if dr.open then 1.5 else 1.2)
end

function wirePickups(info)
	for _, d in info.model:GetDescendants() do
		if d:IsA("ProximityPrompt") and not d:GetAttribute("Wired") and d:GetAttribute("Kind") == "pick" then
			d:SetAttribute("Wired", true)
			local part = d.Parent
			d.Triggered:Connect(function(p)
				local s = players[p]
				if not s or not s.alive or not part.Parent then
					return
				end
				local item = part:GetAttribute("Item")
				if item == "key" then
					s.keys[part:GetAttribute("KeyFor")] = true
					sound(part, SOUND.pick, 0.8)
					syncTools(p)
				elseif item == "coins" then
					give(p, "coins", part:GetAttribute("Amount") or 3)
				elseif not give(p, item) then
					return
				end
				part.Parent:Destroy()
			end)
		end
	end
end

local function wireRoom(info)
	for _, cavity in info.hideSpots do
		local pr = cavity:FindFirstChildOfClass("ProximityPrompt")
		if pr and not pr:GetAttribute("Wired") then
			pr:SetAttribute("Wired", true)
			pr.Triggered:Connect(function(p)
				hide(p, cavity)
			end)
		end
	end
	for _, sr in info.searchables do
		for _, dr in sr.drawers do
			local pr = dr.hit:FindFirstChildOfClass("ProximityPrompt")
			if pr and not pr:GetAttribute("Wired") then
				pr:SetAttribute("Wired", true)
				pr.Triggered:Connect(function(p)
					if G.isAlive(p) then
						toggleDrawer(info, sr, dr)
					end
				end)
			end
		end
	end
	wirePickups(info)
end

-- ---------------------------------------------------------------------------
-- зал с фигурками и тебЯ

function dropFigure(p: Player)
	local s = players[p]
	local fig = s and s.carry
	if not fig then
		return
	end
	s.carry = nil
	local w = fig.part:FindFirstChild("CarryWeld")
	if w then
		w:Destroy()
	end
	if fig.model.Parent and not fig.placed then
		fig.part.Anchored = true
		fig.model:PivotTo(fig.home)
		fig.held = false
	end
end

function solveFigures(info)
	local puzzle = info.puzzle
	if puzzle.solved then
		return
	end
	puzzle.solved = true
	Entities.crumbleMimic(info)
	info.sealed = false
	sound(info.model, SOUND.pick, 1.2, 0.7)
end

local function wireFigures(info)
	local puzzle = info.puzzle
	for _, fig in puzzle.figs do
		local pr = fig.part:FindFirstChildOfClass("ProximityPrompt")
		pr.Triggered:Connect(function(p)
			local s = players[p]
			if not s or not s.alive or s.carry or fig.held or fig.placed then
				return
			end
			local r = rootOf(p)
			if not r then
				return
			end
			-- фигурка в руках: держится перед игроком
			fig.held = true
			s.carry = fig
			fig.part.Anchored = false
			for _, d in fig.model:GetDescendants() do
				if d:IsA("BasePart") then
					d.Anchored = false
					d.Massless = true
					if d ~= fig.part then
						local wd = d:FindFirstChild("W") or Instance.new("WeldConstraint")
						wd.Name = "W"
						wd.Part0 = fig.part
						wd.Part1 = d
						wd.Parent = d
					end
				end
			end
			fig.model:PivotTo(r.CFrame * CFrame.new(0.9, 0.2, -1.6))
			local w = Instance.new("WeldConstraint")
			w.Name = "CarryWeld"
			w.Part0 = r
			w.Part1 = fig.part
			w.Parent = fig.part
			pr.Enabled = false
			sound(r, SOUND.pick, 0.6, 1.2)
		end)
	end
	for _, socket in puzzle.sockets do
		local pr = socket.part:FindFirstChildOfClass("ProximityPrompt")
		pr.Triggered:Connect(function(p)
			local s = players[p]
			local fig = s and s.carry
			if not fig or socket.filled or puzzle.solved then
				return
			end
			if fig.color == socket.color then
				s.carry = nil
				local w = fig.part:FindFirstChild("CarryWeld")
				if w then
					w:Destroy()
				end
				for _, d in fig.model:GetDescendants() do
					if d:IsA("BasePart") then
						d.Anchored = true
					end
				end
				fig.model:PivotTo(socket.top * CFrame.new(0, 0.15, 0))
				fig.placed = true
				socket.filled = true
				pr.Enabled = false
				puzzle.placed += 1
				sound(socket.part, SOUND.pick, 0.9, 1 + puzzle.placed * 0.08)
				if puzzle.placed &gt;= puzzle.n then
					G.achieveAll("mimic_solved")
					solveFigures(info)
				end
			else
				-- не тот постамент: фигурка возвращается туда, где лежала
				sound(socket.part, SOUND.locked, 0.9, 0.7)
				dropFigure(p)
				for _, d in fig.model:GetDescendants() do
					if d:IsA("BasePart") then
						d.Anchored = true
					end
				end
				fig.model:PivotTo(fig.home)
				local fp = fig.part:FindFirstChildOfClass("ProximityPrompt")
				if fp then
					fp.Enabled = true
				end
			end
		end)
	end
end

-- ---------------------------------------------------------------------------
-- Монетчик

local function removeKeeper(t)
	t.paid = true
	local i = table.find(run.keepers, t)
	if i then
		table.remove(run.keepers, i)
	end
	if t.block.Parent then
		t.block:Destroy()
	end
end

-- убегает в норку (когда летит Тьма или когда получил своё)
local function keeperLeaves(t, fast: boolean)
	if t.gone then
		return
	end
	t.gone = true
	removeKeeper(t)
	local m = t.model
	for _, d in m:GetDescendants() do
		if d:IsA("ProximityPrompt") then
			d.Enabled = false
		end
	end
	local from = m:GetPivot()
	local to = t.hole * CFrame.new(0, 0, 1.6) * CFrame.Angles(0, math.pi, 0)
	task.spawn(function()
		if fast then
			-- заметил Тьму: вздрагивает и отступает на шаг, потом торопливо уходит
			for i = 1, 6 do
				if not m.Parent then
					return
				end
				m:PivotTo(from * CFrame.new(math.sin(i * 2.4) * 0.12, 0, 0.1 * i) * CFrame.Angles(0, 0, math.sin(i * 2.4) * 0.06))
				task.wait(0.05)
			end
			from = m:GetPivot()
		end
		-- идёт ровно, без прыжков: лишь слегка покачивается с ноги на ногу
		local dur = if fast then 1.1 else 2.2
		local look = CFrame.lookAt(from.Position, Vector3.new(to.Position.X, from.Position.Y, to.Position.Z))
		local t0 = os.clock()
		while m.Parent do
			local a = math.min(1, (os.clock() - t0) / dur)
			local pos = from.Position:Lerp(to.Position, a)
			local rot = if a &lt; 0.9 then look.Rotation else look.Rotation:Lerp(to.Rotation, (a - 0.9) / 0.1)
			m:PivotTo(CFrame.new(pos) * rot * CFrame.Angles(0, 0, math.sin(a * math.pi * (if fast then 8 else 6)) * 0.05))
			if a &gt;= 1 then
				break
			end
			task.wait()
		end
		if m.Parent then
			m:Destroy()
		end
	end)
	sound(t.holePart, SOUND.pick, 0.7, 1.8)
end

function G.fleeKeepers()
	for _, t in table.clone(run.keepers) do
		keeperLeaves(t, true)
	end
end

function G.pay(p: Player, how: string)
	local s = players[p]
	local r = rootOf(p)
	if not s or not s.alive or not r then
		return { ok = false }
	end
	local t = nil
	for _, k in run.keepers do
		if not k.paid and (k.model:GetPivot().Position - r.Position).Magnitude &lt; 16 then
			t = k
		end
	end
	if not t then
		return { ok = false }
	end
	if how == "gold" then
		if s.coins &lt; t.price then
			return { ok = false, error = "coins" }
		end
		s.coins -= t.price
	else
		local hum = humOf(p)
		if not hum then
			return { ok = false }
		end
		local left = Rules.afterSelfToll(hum.Health)
		send(p, { type = "fx", kind = "blood" })
		if left &lt;= 0 then
			s.cause = "coinkeeper"
			hum.Health = 0
		else
			hum.Health = left
		end
	end
	syncTools(p)
	keeperLeaves(t, false)
	G.achieve(p, "coin_paid")
	return { ok = true }
end

-- место для норки: рядом с дверью, с той стороны, где до угла дальше
local function holeFor(info, size: string): CFrame
	local dw = Props.DOORS[size].w
	local best, bestRoom = nil, -math.huge
	for _, sgn in { -1, 1 } do
		local cf = info.doorCF * CFrame.new(sgn * (dw / 2 + 4.13), 0, 0)
		local lp = info.origin:PointToObjectSpace(cf.Position)
		local d = info.desc
		local room = math.min(d.w / 2 - math.abs(lp.X), -lp.Z, lp.Z + d.l)
		if info.desc.exit.turn == 0 then
			room = d.w / 2 - math.abs(lp.X)
		else
			room = math.min(-lp.Z, lp.Z + d.l)
		end
		if room &gt; bestRoom then
			best, bestRoom = cf, room
		end
	end
	return best
end

-- ---------------------------------------------------------------------------
-- кодовый замок, арена, лифт

local function panelDone(panel: BasePart)
	panel.Color = Color3.fromRGB(60, 200, 90)
	panel.Material = M.Neon
	local pr = panel:FindFirstChildOfClass("ProximityPrompt")
	if pr then
		pr.Enabled = false
	end
	sound(panel, SOUND.pick, 1.2, 0.8)
end

local function wireCode(info)
	info.codePanel:FindFirstChildOfClass("ProximityPrompt").Triggered:Connect(function(p)
		if G.isAlive(p) and not info.locks.code then
			send(p, { type = "keypad", order = info.code.order })
		end
	end)
	info.orderPanel:FindFirstChildOfClass("ProximityPrompt").Triggered:Connect(function(p)
		if G.isAlive(p) and not info.locks.order then
			send(p, { type = "order", items = info.exhibits })
		end
	end)
end

local function nearPanel(p: Player, panel: BasePart): boolean
	local r = rootOf(p)
	return r ~= nil and G.isAlive(p) and (panel.Position - r.Position).Magnitude &lt; 18
end

-- замок с цифрами
function G.code(p: Player, text: string)
	local info = run.rooms[Rules.CODE_ROOM]
	if not info or info.locks.code or not nearPanel(p, info.codePanel) then
		return { ok = false }
	end
	if text ~= info.code.text then
		sound(info.codePanel, SOUND.locked, 1, 0.6)
		return { ok = false }
	end
	info.locks.code = true
	info.sealed = not (info.locks.code and info.locks.order)
	panelDone(info.codePanel)
	return { ok = true }
end

-- замок с порядком экспонатов: list — номера экспонатов в том порядке, как их нажали
function G.order(p: Player, list)
	local info = run.rooms[Rules.CODE_ROOM]
	if not info or info.locks.order or not nearPanel(p, info.orderPanel) or type(list) ~= "table" then
		return { ok = false }
	end
	for i = 1, 8 do
		if list[i] ~= info.code.sequence[i] then
			sound(info.orderPanel, SOUND.locked, 1, 0.6)
			return { ok = false }
		end
	end
	info.locks.order = true
	info.sealed = not (info.locks.code and info.locks.order)
	panelDone(info.orderPanel)
	return { ok = true }
end

function G.eatBait(info)
	local a = info.arena
	if a.meat then
		a.meat:Destroy()
		a.meat = nil
	end
end

-- Колосс повержен: из обломков выкатывается ключ-часы
function G.bossDead(info, pos: Vector3?)
	local a = info.arena
	for _, p in G.alivePlayers() do
		G.achieve(p, "colossus_down")
		give(p, "coins", 40)
	end
	G.sendAll({ type = "fx", kind = "calm" })
	local at = pos or a.zone.Position
	local cf = CFrame.new(Vector3.new(at.X, a.floorY + 0.1, at.Z))
	local pm = Props.pickup(info.model, cf, "clockkey")
	local _ = pm
	wirePickups(info)
end

-- мясо можно положить где угодно на полу арены
local function dropBait(p: Player, info): boolean
	local a = info.arena
	local r = rootOf(p)
	local s = players[p]
	if not r or not s then
		return false
	end
	if r.Position.Y &gt; a.floorY + 6 then
		-- с галереи мясо не бросить
		toast(p, "BaitFloor")
		return false
	end
	if not Rules.take(s.inv, "meat") then
		return false
	end
	G.eatBait(info)
	local pos = r.Position + r.CFrame.LookVector * 2.5
	local cf = CFrame.new(Vector3.new(pos.X, a.floorY, pos.Z)) * CFrame.Angles(0, math.random() * 6, 0)
	local mm = Props.model(info.model, "Bait")
	Props.P(mm, "Meat", Vector3.new(1.6, 0.7, 1.1), cf * CFrame.new(0, 0.35, 0), Color3.fromRGB(150, 40, 40), M.SmoothPlastic, Props.nc())
	Props.P(mm, "Bone", Vector3.new(2.3, 0.22, 0.22), cf * CFrame.new(0, 0.4, 0), Color3.fromRGB(230, 224, 204), M.SmoothPlastic, Props.nc())
	a.meat = mm
	sound(r, SOUND.slam, 0.4, 1.4)
	Entities.bait(cf.Position + Vector3.new(0, 3, 0))
	return true
end
G.dropBait = dropBait

local function arenaHas(p: Player, item: string): boolean
	local s = players[p]
	return s ~= nil and s.alive and (s.inv[item] or 0) &gt; 0
end

-- люстра едет вверх или вниз (down: 0 — наверху, 1 — внизу)
local function moveChandelier(info, toDown: number, time: number, style)
	local ch = info.arena.chand
	ch.busy = true
	Special.drawBeam(info)
	local v = Instance.new("NumberValue")
	v.Value = ch.down or 0
	v.Changed:Connect(function(x)
		Special.placeChandelier(info, x)
	end)
	local t = TweenService:Create(v, TweenInfo.new(time, style or Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Value = toDown })
	t:Play()
	t.Completed:Wait()
	v:Destroy()
	ch.down = toDown
	ch.up = toDown == 0
	ch.busy = false
	ch.slotPrompt.Enabled = toDown == 1 and ch.lens == nil
	Special.drawBeam(info)
end

local function wireArena(info)
	local a = info.arena
	local A = Rules.ARENA
	-- зеркала: держишь кнопку — зеркало плавно поворачивается; когда луч ловит
	-- следующее зеркало или люстру, оно щёлкает и встаёт точно
	for k, mr in a.mirrors do
		for _, pr in mr.glass:GetChildren() do
			if pr:IsA("ProximityPrompt") then
				local dir = if pr.Name == "turnl" then 1 else -1
				pr.PromptButtonHoldBegan:Connect(function(p)
					if G.isAlive(p) and not mr.turning then
						mr.turning = dir
						mr.by = p
						mr.noiseAt = 0
					end
				end)
				pr.PromptButtonHoldEnded:Connect(function(p)
					if mr.by == p then
						mr.turning = nil
						mr.by = nil
					end
				end)
			end
		end
		mr.k = k
	end
	local drawAt = 0
	a.conn = RunService.Heartbeat:Connect(function(dt)
		if not info.model.Parent then
			a.conn:Disconnect()
			return
		end
		local now = os.clock()
		for k, mr in a.mirrors do
			if mr.turning then
				if not G.isAlive(mr.by) then
					mr.turning = nil
					continue
				end
				local before = #(a.chain or {})
				mr.angle += mr.turning * math.rad(A.turn) * dt
				Special.turnMirror(info, k)
				if now - mr.noiseAt &gt; 1 then
					mr.noiseAt = now
					sound(mr.glass, SOUND.switch, 0.25, 0.5)
					Entities.noise(mr.cf.Position, 22)
				end
				if now - drawAt &gt; 0.06 then
					drawAt = now
					local chain, hit = Special.drawBeam(info)
					-- луч поймал что-то новое за этим зеркалом: щелчок и точная установка
					local idx = table.find(chain, k)
					if idx and (#chain &gt; before or hit) and (idx &lt; #chain or hit) then
						local cur = {}
						for j, m2 in a.mirrors do
							cur[j] = m2.angle
						end
						local path = Rules.beam(cur)
						-- нормаль = направление «наружу» минус направление «внутрь»
						local pi_, po = path[idx], path[idx + 2]
						local pm = path[idx + 1]
						if pi_ and po and pm then
							local ix, iz = pm.x - pi_.x, pm.z - pi_.z
							local il = math.sqrt(ix * ix + iz * iz)
							local ox, oz = po.x - pm.x, po.z - pm.z
							local ol = math.sqrt(ox * ox + oz * oz)
							mr.angle = math.atan2(oz / ol - iz / il, ox / ol - ix / il)
							Special.turnMirror(info, k)
							Special.drawBeam(info)
						end
						mr.turning = nil
						sound(mr.glass, SOUND.locked, 1, 1.2)
					end
				end
			end
		end
	end)
	-- лебёдка: опустить/поднять люстру
	a.drum:FindFirstChildOfClass("ProximityPrompt").Triggered:Connect(function(p)
		local ch = a.chand
		if not G.isAlive(p) or ch.busy or ch.fallen then
			return
		end
		sound(a.drum, SOUND.switch, 1, 0.6)
		Entities.noise(a.drum.Position, 30)
		task.spawn(moveChandelier, info, if ch.up then 1 else 0, 5)
	end)
	-- зеркальце в люстру
	a.chand.slotPrompt.Triggered:Connect(function(p)
		local ch = a.chand
		local s = players[p]
		if not s or not s.alive or ch.lens or not ch.down or ch.down &lt; 1 then
			return
		end
		if not Rules.take(s.inv, "lens") then
			toast(p, "NeedLens")
			return
		end
		syncTools(p)
		ch.lens = Props.C(ch.model, "Lens", 0.12, 2, ch.slot.CFrame, Color3.fromRGB(200, 220, 230), M.Glass, { Reflectance = 0.7, CanCollide = false })
		ch.slot.Transparency = 0
		ch.slotPrompt.Enabled = false
		sound(ch.slot, SOUND.pick, 1)
	end)
	-- тормозной штырь высоко на стене: выбить длинным шестом
	local pinPrompt = a.pin:FindFirstChildOfClass("ProximityPrompt")
	pinPrompt.Triggered:Connect(function(p)
		if not G.isAlive(p) or a.pinOut then
			return
		end
		if not arenaHas(p, "pole") then
			toast(p, "NeedPole")
			return
		end
		local r = rootOf(p)
		a.pinOut = true
		pinPrompt.Enabled = false
		-- шест поднимается от рук к штырю и выбивает его
		local from = r.Position + Vector3.new(0, 1.5, 0)
		local pole = Props.rod(info.model, "PoleSwing", from, from + (a.pin.Position - from).Unit * 2, 0.3, Props.WOOD, M.Wood, Props.nc())
		local target = (a.pin.Position - from)
		local steps = 12
		for i = 1, steps do
			local tip = from + target * (i / steps)
			local len = (tip - from).Magnitude
			pole.Size = Vector3.new(0.3, 0.3, len)
			pole.CFrame = CFrame.lookAt((from + tip) / 2, tip)
			task.wait(0.04)
		end
		sound(a.pin, SOUND.slam, 1.2, 1.3)
		a.pin.Anchored = false
		a.pin.CanCollide = true
		a.pin.AssemblyLinearVelocity = Vector3.new(0, 6, 0) + (a.pin.Position - from).Unit * 8
		Debris:AddItem(a.pin, 8)
		task.wait(0.3)
		pole:Destroy()
		Entities.noise(a.pin.Position, 30)
	end)
	-- рычаг: сбросить люстру
	a.lever:FindFirstChildOfClass("ProximityPrompt").Triggered:Connect(function(p)
		local ch = a.chand
		if not G.isAlive(p) or ch.busy or ch.fallen then
			return
		end
		if not a.pinOut then
			sound(a.lever, SOUND.locked, 1, 0.6)
			toast(p, "BrakeHolds")
			return
		end
		if not ch.up then
			sound(a.lever, SOUND.locked, 1, 0.6)
			return
		end
		a.lever.CFrame = a.lever.CFrame * CFrame.Angles(0, 0, math.rad(-50))
		sound(a.drum, SOUND.slam, 1.4, 0.5)
		task.spawn(function()
			moveChandelier(info, 1.6, 0.7, Enum.EasingStyle.Quad)
			ch.fallen = true
			local pos = ch.pos
			sound(a.spot, SOUND.slam, 2.2, 0.35)
			G.sendAll({ type = "fx", kind = "shake" })
			local hit = Entities.chandelierHit(Vector3.new(pos.X, a.floorY, pos.Z), A.drop)
			if not hit then
				-- мимо: грохот слышно во всём зале, люстру поднимает лебёдка
				Entities.noise(pos, 200)
				task.wait(7)
				if info.model.Parent then
					ch.fallen = false
					moveChandelier(info, 0, 6)
					a.lever.CFrame = a.lever.CFrame * CFrame.Angles(0, 0, math.rad(50))
				end
			end
		end)
	end)
	-- холодильная камера: открывается ключом на 5 секунд и сама захлопывается
	local cold = a.cold
	cold.trigger:FindFirstChildOfClass("ProximityPrompt").Triggered:Connect(function(p)
		if not G.isAlive(p) or cold.open then
			return
		end
		if not arenaHas(p, "coldkey") then
			sound(cold.trigger, SOUND.locked, 1, 0.8)
			toast(p, "Locked")
			return
		end
		cold.open = true
		swing(cold, true, 0.8)
		task.delay(A.coldOpen, function()
			if info.model.Parent then
				swing(cold, false, 0.5)
				cold.open = false
			end
		end)
	end)
	-- механизм выхода: вставить ключ-часы и перевести стрелки как на остановленных часах
	local mech = a.mech
	local hourPr = mech.hourKnob:FindFirstChildOfClass("ProximityPrompt")
	local minPr = mech.minuteKnob:FindFirstChildOfClass("ProximityPrompt")
	mech.keyhole:FindFirstChildOfClass("ProximityPrompt").Triggered:Connect(function(p)
		local s = players[p]
		if not s or not s.alive or mech.inserted then
			return
		end
		if not Rules.take(s.inv, "clockkey") then
			sound(mech.keyhole, SOUND.locked, 1, 0.8)
			toast(p, "NeedClockKey")
			return
		end
		syncTools(p)
		mech.inserted = true
		Props.clockKey(info.model, mech.keyhole.CFrame * CFrame.new(0, 0, -0.5) * CFrame.Angles(math.pi / 2, 0, 0))
		mech.keyhole:FindFirstChildOfClass("ProximityPrompt").Enabled = false
		hourPr.Enabled = true
		minPr.Enabled = true
		sound(mech.keyhole, SOUND.switch, 1)
	end)
	local function step(hand: string)
		if not mech.inserted or mech.done then
			return
		end
		mech.h, mech.m = Rules.clockStep(mech.h, mech.m, hand)
		Special.setMechHands(info)
		sound(mech.keyhole, SOUND.switch, 0.6, 1.4)
		if mech.h == a.clock.h and mech.m == a.clock.m then
			mech.done = true
			hourPr.Enabled = false
			minPr.Enabled = false
			sound(mech.keyhole, SOUND.pick, 1.2, 0.8)
			info.sealed = false
			G.sendAll({ type = "toast", key = "ClockOpen" })
		end
	end
	hourPr.Triggered:Connect(function(p)
		if G.isAlive(p) then
			step("hour")
		end
	end)
	minPr.Triggered:Connect(function(p)
		if G.isAlive(p) then
			step("minute")
		end
	end)
end

local function wireLift(info)
	info.model:FindFirstChild("CallButton"):FindFirstChildOfClass("ProximityPrompt").Triggered:Connect(function(p)
		sound(info.model:FindFirstChild("CallButton"), SOUND.locked, 1, 0.5)
		send(p, { type = "voice", key = "LiftLocked" })
	end)
	for _, lv in info.levers do
		lv.handle:FindFirstChildOfClass("ProximityPrompt").Triggered:Connect(function(p)
			if not G.isAlive(p) or info.gate.opened then
				return
			end
			lv.on = not lv.on
			lv.model:PivotTo(lv.base * CFrame.Angles(math.rad(if lv.on then 35 else -35), 0, 0))
			sound(lv.handle, SOUND.switch, 1)
			for _, l in info.levers do
				if l.on ~= l.need then
					return
				end
			end
			info.gate.opened = true
			swing(info.gate, true, 1.2)
		end)
	end
end

-- ---------------------------------------------------------------------------
-- комнаты

local function buildRoom(n: number)
	if run.rooms[n] or n &gt; Rules.CHAPTER then
		return run.rooms[n]
	end
	local d = descOf(n)
	local prev = if n &gt; 0 then (run.rooms[n - 1] or buildRoom(n - 1)) else nil
	local origin = if prev then prev.doorCF else CFrame.new(0, 0, 0)
	local rand = Plan.rng(run.seed + n * 7919)
	local info
	if d.kind == "codehall" then
		info = Special.codeHall(world, d, origin, rand, prev)
	elseif d.kind == "arena" then
		info = Special.arena(world, d, origin, rand, prev)
	elseif d.kind == "lifthall" then
		info = Special.liftHall(world, d, origin, rand, prev)
	elseif d.kind == "final" then
		info = Special.final(world, d, origin, rand, prev)
	else
		info = Builder.build(world, d, origin, prev, rand)
	end
	info.n = n
	info.doorCF = info.exitCF
	run.rooms[n] = info
	if d.kind == "figures" then
		Special.figures(info, rand)
		info.sealed = true
		wireFigures(info)
		task.spawn(Entities.spawnMimic, info)
	end
	if d.kind ~= "final" then
		local special = d.kind == "codehall"
		local size = if d.kind == "lifthall" then "normal" else d.exitSize
		-- вид двери: служебные и технические — маленькие, стальные — в служебных и старых залах
		local style = nil
		if special then
			style = "code"
		elseif d.kind == "figures" then
			style = "puzzle"
		elseif size == "small" then
			style = if n % 2 == 0 then "tech" else "service"
		elseif size ~= "grand" and (d.kind == "storage" or d.kind == "tech" or d.kind == "mechanisms" or n % 5 == 0) then
			style = "metal"
		end
		info.door = makeDoor(info, n + 1, info.doorCF, { plate = Rules.plate(n + 1), locked = d.locked == true or special, size = size, noPick = special, style = style })
		info.decoys = {}
		for _, cf in info.decoyCFs do
			table.insert(info.decoys, makeDoor(info, n + 1, cf, { plate = Rules.plate(n + 1), decoy = true }))
		end
		if d.kind == "lifthall" then
			-- последнюю дверь открывают сами: удержанием кнопки
			local trig = Props.P(info.door.model, "HoldTrigger", Vector3.new(1, 1, 1), info.doorCF * CFrame.new(0, 4, 0.8), Color3.new(0, 0, 0), M.SmoothPlastic, Props.nc({ Transparency = 1 }))
			local pr = Props.prompt(trig, "open", 2.5, 8)
			info.door.hold = pr
			pr.Triggered:Connect(function(p)
				G.finale(p)
			end)
		end
	end
	if d.locked then
		if #info.searchables &gt; 0 then
			-- ключ лежит в одном случайном ящике этого зала
			local sr = info.searchables[math.floor(rand() * #info.searchables) + 1]
			sr.key = n + 1
			sr.keyDrawer = sr.drawers[math.floor(rand() * #sr.drawers) + 1]
		else
			-- ящиков нет: ключ лежит на полу у дальней стены
			local side = if n % 2 == 0 then 1 else -1
			local cf = origin * CFrame.new(side * (d.w / 2 - 3.2), Builder.floorAt(d, -d.l + 3), -d.l + 3.4)
			local _, part = Props.pickup(info.model, cf, "key")
			part:SetAttribute("KeyFor", n + 1)
		end
	end
	if d.coin then
		local price = Rules.coinPrice(n + 1)
		local hole = holeFor(info, d.exitSize)
		local keeper, pr, block, holeModel = Special.coinKeeper(info.model, info.doorCF * CFrame.new(0, 0, 3) * CFrame.Angles(0, math.pi, 0), price, hole)
		info.toll = { model = keeper, price = price, paid = false, base = keeper:GetPivot(), block = block, hole = hole, holePart = holeModel:FindFirstChildWhichIsA("BasePart") }
		table.insert(run.keepers, info.toll)
		pr.Triggered:Connect(function(p)
			if G.isAlive(p) and not info.toll.paid then
				G.discover(p, "coinkeeper")
				send(p, { type = "coin", price = price })
			end
		end)
	end
	wireRoom(info)
	if d.kind == "codehall" then
		wireCode(info)
	elseif d.kind == "arena" then
		wireArena(info)
		task.spawn(Entities.spawnColossus, info)
	elseif d.kind == "lifthall" then
		wireLift(info)
	end
	return info
end
G.buildRoom = buildRoom

local function destroyRoom(n: number)
	local info = run.rooms[n]
	if not info then
		return
	end
	Entities.removeRoom(info)
	for part, p in occupied do
		if part:IsDescendantOf(info.model) then
			unhide(p)
		end
	end
	for p, s in players do
		if s.carry and s.carry.model:IsDescendantOf(info.model) then
			dropFigure(p)
		end
	end
	if info.toll and not info.toll.paid then
		removeKeeper(info.toll)
	end
	info.model:Destroy()
	run.rooms[n] = nil
end

local function frontSpawn(): CFrame
	local info = run.rooms[run.front] or run.rooms[0]
	return info.origin * CFrame.new(0, 3, -4)
end
G.frontSpawn = frontSpawn

local function cleanup()
	local keepFrom = run.front - KEEP_BEHIND
	for n, info in run.rooms do
		if n &lt; keepFrom then
			local target = run.rooms[keepFrom]
			if target then
				for _, p in G.alivePlayers() do
					local r = rootOf(p)
					if r and G.inRoom(info, r.Position) then
						unhide(p)
						teleport(p, target.origin * CFrame.new(0, 3, -4))
					end
				end
			end
			destroyRoom(n)
		end
	end
end

function openDoor(n: number, force: boolean?)
	local info = run.rooms[n - 1]
	if not info or not info.door or info.door.opened then
		return false
	end
	local door = info.door
	door.opened = true
	local lock = door.model:FindFirstChild("Padlock")
	if lock then
		lock:Destroy()
	end
	if door.lockPrompt then
		door.lockPrompt.Enabled = false
	end
	if door.hold then
		door.hold.Enabled = false
	end
	swing(door, true)
	run.front = math.max(run.front, n)
	workspace:SetAttribute("Door", run.front)
	for _, s in players do
		s.keys[n] = nil
	end
	for p, s in players do
		if s.alive then
			if Records.offer(p, n) then
				local ls = p:FindFirstChild("leaderstats")
				local b = ls and ls:FindFirstChild("Best")
				if b then
					(b :: IntValue).Value = n
				end
			end
			s.coins += Rules.COINS_PER_DOOR
			syncTools(p)
		end
	end
	local entered = buildRoom(n)
	buildRoom(n + 1)
	cleanup()
	workspace:SetAttribute("Light", entered.desc.light or 1)
	Entities.noise(door.model:GetPivot().Position, 50)
	if entered.desc.kind == "arena" then
		-- сцена: огромная статуя сходит с постамента
		local model = entered.model:FindFirstChild("Colossus")
		G.sendAll({ type = "cutscene", kind = "boss", focus = entered.arena.spawn, model = model })
		for _, p in G.alivePlayers() do
			G.discover(p, "colossus")
			G.achieve(p, "door50")
		end
		task.delay(5.5, Entities.wakeColossus)
	elseif entered.desc.kind == "voidhall" then
		for _, p in G.alivePlayers() do
			G.discover(p, "void")
		end
	end
	if entered.desc.dark and not force then
		task.delay(2 + math.random() * 4, function()
			if run.active and not run.done then
				Entities.darkness()
			end
		end)
	end
	return true
end
G.openDoor = openDoor

-- Тьма долетела до последней двери: открывает её, если это обычная дверь
function G.darkOpen()
	local n = run.front + 1
	local info = run.rooms[run.front]
	if not info or not info.door or info.door.opened or info.door.hold or info.sealed or info.door.locked or Rules.isSpecial(n) or Rules.isSpecial(run.front) then
		return nil
	end
	if not run.active or run.done then
		return nil
	end
	openDoor(n, true)
	return run.rooms[n]
end

local lockedToastAt: { [Player]: number } = {}

function G.tryOpen(p: Player, n: number)
	local s = players[p]
	if not s or not s.alive or s.hidden then
		return
	end
	local info = run.rooms[n - 1]
	if not info or not info.door or info.door.opened or info.door.hold or info.sealed then
		return
	end
	if info.toll and not info.toll.paid then
		return
	end
	if info.door.locked then
		if s.keys[n] then
			s.keys[n] = nil
			syncTools(p)
		else
			local now = os.clock()
			if now - (lockedToastAt[p] or 0) &gt; 4 then
				lockedToastAt[p] = now
				sound(info.door.model:FindFirstChildWhichIsA("BasePart"), SOUND.locked, 0.8)
				toast(p, "Locked")
			end
			return
		end
	end
	openDoor(n)
end

function G.pick(p: Player, n: number)
	local s = players[p]
	local info = run.rooms[n - 1]
	if not s or not s.alive or not info or not info.door or info.door.opened or info.sealed then
		return
	end
	if Rules.take(s.inv, "lockpick") then
		syncTools(p)
		openDoor(n)
	end
end

-- ложная дверь: глюк, и игрок оказывается у настоящей (или в середине зала)
function G.decoy(p: Player, info)
	local s = players[p]
	if not s or not s.alive then
		return
	end
	local now = os.clock()
	if now - (s.glitchAt or 0) &lt; 2 then
		return
	end
	s.glitchAt = now
	send(p, { type = "glitch" })
	task.wait(0.35)
	local n = info.n + 1
	local blocked = info.sealed or (info.door.locked and not s.keys[n]) or (info.toll and not info.toll.paid)
	if blocked or not G.isAlive(p) then
		teleport(p, info.center * CFrame.new(0, -info.size.Y / 2 + 3, 0))
		return
	end
	if info.door.locked then
		s.keys[n] = nil
		syncTools(p)
	end
	openDoor(n)
	local nextRoom = run.rooms[n]
	if nextRoom then
		teleport(p, nextRoom.origin * CFrame.new(0, 3, -4))
	end
end

-- дверь 100: открывается, все входят, дверь захлопывается; дальше — заброшенный зал
function G.finale(p: Player)
	local info = run.rooms[Rules.LIFT_ROOM]
	if not G.isAlive(p) or not info or info.door.opened then
		return
	end
	openDoor(Rules.FINAL_ROOM, true)
	G.achieveAll("door100")
	local final = run.rooms[Rules.FINAL_ROOM]
	G.sendAll({ type = "cutscene", kind = "final", door = info.doorCF })
	task.wait(2.4)
	local k = 0
	for _, q in G.alivePlayers() do
		k += 1
		unhide(q)
		teleport(q, final.origin * CFrame.new(((k - 1) % 3 - 1) * 3, 3, -8 - math.floor((k - 1) / 3) * 3))
	end
	swing(info.door, false, 0.25)
	run.done = true
	task.wait(9)
	for _, q in G.alivePlayers() do
		Records.complete(q)
		G.achieve(q, "finale")
		send(q, { type = "tbc" })
	end
end

-- ---------------------------------------------------------------------------
-- начало и конец забега

local function resetPlayer(p: Player)
	local s = players[p]
	s.alive = true
	s.cause = nil
	s.coins = 0
	s.inv = {}
	s.keys = {}
	s.flash = Rules.FLASH_MAX
	s.flashOn = false
	s.sneaking = false
	s.hidden = nil
	s.carry = nil
	for _, t in s.tools do
		if t.Parent then
			t:Destroy()
		end
	end
	s.tools = {}
	p:SetAttribute("Alive", true)
	p:SetAttribute("HiddenEye", nil)
	p:SetAttribute("Sneaking", false)
end

local function loadCharacter(p: Player, cf: CFrame, inRun: boolean)
	resetPlayer(p)
	p:LoadCharacter()
	local char = p.Character or p.CharacterAdded:Wait()
	char:WaitForChild("HumanoidRootPart", 5)
	-- персонаж чуть крупнее обычного: двери, витрины и шкафчики ему по росту
	pcall(function()
		char:ScaleTo(1.2)
	end)
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.WalkSpeed = Rules.SPEED.walk
		hum.UseJumpPower = true
		hum.JumpPower = 0
		hum.Died:Connect(function()
			onDied(p)
		end)
	end
	teleport(p, cf)
	if inRun then
		syncTools(p)
		setFlash(p, false)
	else
		players[p].alive = false
		p:SetAttribute("Alive", nil)
	end
end

local function startRun()
	run.active = true
	run.ending = false
	run.done = false
	run.seed = math.random(1, 2 ^ 30)
	run.plan = Plan.new(run.seed)
	run.descs = {}
	run.rooms = {}
	run.keepers = {}
	run.front = 0
	world:ClearAllChildren()
	workspace:SetAttribute("Door", 0)
	workspace:SetAttribute("Light", 1)
	workspace:SetAttribute("Mode", "run")
	buildRoom(0)
	buildRoom(1)
end

-- у закрывшихся входных дверей, лицом в музей
local function startPoint(): CFrame
	local start = run.rooms[0]
	return start.origin * CFrame.new(math.random(-3, 3), 3, -5 - math.random(0, 2))
end

local function toLobby(p: Player)
	if RunService:IsStudio() then
		return
	end
	pcall(function()
		TeleportService:TeleportAsync(game.PlaceId, { p })
	end)
end

function endRun()
	if run.ending then
		return
	end
	run.ending = true
	G.sendAll({ type = "results", door = run.front })
	task.wait(10)
	if RunService:IsStudio() then
		Entities.clear()
		table.clear(occupied)
		startRun()
		for p in players do
			if p.Parent then
				task.spawn(loadCharacter, p, startPoint(), true)
			end
		end
		return
	end
	local list = {}
	for p in players do
		if p.Parent then
			table.insert(list, p)
		end
	end
	if #list &gt; 0 then
		pcall(function()
			TeleportService:TeleportAsync(game.PlaceId, list)
		end)
	end
end
G.endRun = endRun

-- лобби превращается в забег прямо в этом сервере (Studio и кнопка админа)
function G.startHere()
	if G.mode == "run" then
		return
	end
	G.mode = "run"
	if lobby then
		lobby.model:Destroy()
		lobby = nil
	end
	startRun()
	for p in players do
		if p.Parent then
			task.spawn(loadCharacter, p, startPoint(), true)
		end
	end
end

-- уйти группой в отдельный сервер забега
local function goIn(group: { Player })
	if RunService:IsStudio() then
		G.startHere()
		return
	end
	task.spawn(function()
		local ok, err = pcall(function()
			local code = TeleportService:ReserveServer(game.PlaceId)
			local opts = Instance.new("TeleportOptions")
			opts.ReservedServerAccessCode = code
			TeleportService:TeleportAsync(game.PlaceId, group, opts)
		end)
		if not ok then
			warn("[Museum] teleport: " .. tostring(err))
			for _, p in group do
				send(p, { type = "enterFailed" })
				teleport(p, lobby.spawn)
			end
		end
	end)
end

-- вход в музей из лобби: кто стоит во тьме за дверями три секунды, уходит в забег
local enterAt = nil
local function lobbyStep()
	if G.mode ~= "lobby" or not lobby then
		return
	end
	local zone = lobby.zone
	local inside = {}
	for p in players do
		local r = rootOf(p)
		if r then
			local lp = zone.CFrame:PointToObjectSpace(r.Position)
			if math.abs(lp.X) &lt; zone.Size.X / 2 and math.abs(lp.Z) &lt; zone.Size.Z / 2 and math.abs(lp.Y) &lt; zone.Size.Y / 2 then
				table.insert(inside, p)
			end
		end
	end
	if #inside == 0 then
		enterAt = nil
		return
	end
	local now = os.clock()
	if not enterAt then
		enterAt = now + 3
		for _, p in inside do
			send(p, { type = "enter" })
		end
	end
	if now &lt; enterAt then
		return
	end
	enterAt = nil
	local group = {}
	for i = 1, math.min(4, #inside) do
		table.insert(group, inside[i])
	end
	goIn(group)
end

-- ---------------------------------------------------------------------------

function G.init()
	Players.CharacterAutoLoads = false
	event = Remotes.event("Game")
	world = Instance.new("Folder")
	world.Name = "Museum"
	world.Parent = workspace
	Records.init()
	Entities.init(G)
	workspace:SetAttribute("Mode", G.mode)
	if G.mode == "run" then
		startRun()
	else
		lobby = Special.lobby(world)
		-- кнопка у приоткрытых дверей: войти сразу (вместе с теми, кто стоит рядом)
		local going = false
		lobby.enter.Triggered:Connect(function(p)
			if going or not rootOf(p) then
				return
			end
			going = true
			local group = { p }
			local door = lobby.enter.Parent.Position
			for q in players do
				local r = rootOf(q)
				if q ~= p and r and #group &lt; 4 and (r.Position - door).Magnitude &lt; 16 then
					table.insert(group, q)
				end
			end
			for _, q in group do
				send(q, { type = "enter" })
			end
			task.delay(1.2, function()
				goIn(group)
				going = false
			end)
		end)
		lobby.ach.Triggered:Connect(function(p)
			send(p, { type = "openAch" })
		end)
	end

	local function added(p: Player)
		local ls = Instance.new("Folder")
		ls.Name = "leaderstats"
		local best = Instance.new("IntValue")
		best.Name = "Best"
		best.Parent = ls
		ls.Parent = p
		players[p] = { alive = false, coins = 0, inv = {}, keys = {}, flash = Rules.FLASH_MAX, tools = {}, lang = "en" }
		best.Value = Records.load(p)
		if G.mode == "run" then
			local cf = if run.front &gt;= 2 then frontSpawn() else startPoint()
			loadCharacter(p, cf, true)
		else
			loadCharacter(p, lobby.spawn * CFrame.new(math.random(-4, 4), 0, math.random(-3, 3)), false)
		end
	end
	Players.PlayerAdded:Connect(added)
	for _, p in Players:GetPlayers() do
		task.spawn(added, p)
	end
	Players.PlayerRemoving:Connect(function(p)
		unhide(p)
		dropFigure(p)
		players[p] = nil
		lockedToastAt[p] = nil
		Records.forget(p)
		if G.mode == "run" and run.active and not run.done and #G.alivePlayers() == 0 and #Players:GetPlayers() &gt; 1 then
			task.spawn(endRun)
		end
	end)

	Remotes.fn("Request").OnServerInvoke = function(p: Player, action: any, arg: any)
		local s = players[p]
		if not s then
			return { ok = false }
		end
		if action == "Lang" and (arg == "en" or arg == "ru") then
			s.lang = arg
			syncTools(p)
			return { ok = true }
		elseif action == "Sneak" then
			s.sneaking = arg == true
			p:SetAttribute("Sneaking", s.sneaking)
			local hum = humOf(p)
			if hum and s.alive then
				hum.WalkSpeed = if s.sneaking then Rules.SPEED.sneak else Rules.SPEED.walk
			end
			return { ok = true }
		elseif action == "Unhide" then
			unhide(p)
			return { ok = true }
		elseif action == "Pay" and (arg == "gold" or arg == "self") then
			return G.pay(p, arg)
		elseif action == "Code" and type(arg) == "string" and #arg &lt;= 8 then
			return G.code(p, arg)
		elseif action == "Order" then
			return G.order(p, arg)
		elseif action == "Journal" then
			return { ok = true, journal = Records.journal(p), ach = Records.achievements(p) }
		elseif action == "Lobby" then
			-- вернуться на улицу можно только после смерти или в конце локации
			if not s.alive or run.done or G.mode == "lobby" then
				toLobby(p)
			end
			return { ok = true }
		elseif action == "Status" then
			syncTools(p)
			return { ok = true, best = Records.get(p), mode = G.mode }
		end
		return { ok = false }
	end

	task.spawn(function()
		local t = 0
		while true do
			local dt = task.wait(0.15)
			t += dt
			pcall(lobbyStep)
			if G.mode == "run" and run.active then
				local info = run.rooms[run.front]
				for _, p in G.alivePlayers() do
					local s = players[p]
					local r = rootOf(p)
					if r and not s.hidden then
						if info and info.door and not info.door.opened and not run.done then
							local hw = Props.DOORS[info.door.size].w / 2 + 1.5
							local lp = info.door.cf:PointToObjectSpace(r.Position)
							if lp.Z &gt; -0.5 and lp.Z &lt; 7 and math.abs(lp.X) &lt; hw and lp.Y &gt; -1 and lp.Y &lt; 10 then
								G.tryOpen(p, info.n + 1)
							end
							for _, dc in info.decoys or {} do
								local dp = dc.cf:PointToObjectSpace(r.Position)
								if dp.Z &gt; -0.5 and dp.Z &lt; 3.5 and math.abs(dp.X) &lt; 3 and dp.Y &gt; -1 and dp.Y &lt; 8 then
									task.spawn(G.decoy, p, info)
								end
							end
						end
						if s.flashOn then
							s.flash = Rules.drain(s.flash, dt, true)
							if s.flash &lt;= 0 then
								setFlash(p, false)
							else
								p:SetAttribute("Flash", math.ceil(s.flash))
							end
						end
						-- упал: из пролома в пустоту — гибель, иначе возврат к последней двери
						local here = roomOf(r.Position)
						if here then
							s.lastKind = here.desc.kind
							s.lastY = here.origin.Y + math.min(0, here.desc.dy)
						end
						local floorY = if s.lastKind == "lifthall" then r.Position.Y - 1 else (s.lastY or r.Position.Y)
						if not here and r.Position.Y &lt; floorY - 30 then
							if s.lastKind == "voidhall" then
								G.kill(p, "void")
							else
								teleport(p, frontSpawn())
							end
						end
					end
				end
				for _, k in run.keepers do
					if not k.paid and k.model.Parent then
						-- стоит строго: едва заметно переносит вес и постукивает тростью
						k.model:PivotTo(k.base * CFrame.Angles(0, 0, math.sin(t * 0.9) * 0.025))
					end
				end
			end
		end
	end)
end

return G
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000016">
          <Properties>
            <string name="Name">Records</string>
            <ProtectedString name="Source">--!nonstrict
-- Что сохраняется: лучший номер двери, сколько раз локация пройдена и журнал
-- (кого из существ игрок уже встречал). Ход забега не сохраняется

local Adapter = require(script.Parent.Parent.DataStoreAdapter)

local Records = {}

local store = nil
local best: { [number]: number } = {}
local journal: { [number]: { [string]: boolean } } = {}
local ach: { [number]: { [string]: boolean } } = {}

local function key(userId: number): string
	return "u_" .. userId
end

local function update(p: Player, fn)
	if p.UserId &lt;= 0 then
		return
	end
	task.spawn(function()
		pcall(function()
			store.update(key(p.UserId), function(old)
				local o = if type(old) == "table" then old else {}
				fn(o)
				return o
			end)
		end)
	end)
end

function Records.init()
	store = Adapter.create()
end

function Records.load(p: Player): number
	local ok, data = pcall(function()
		return store.get(key(p.UserId))
	end)
	local d = if ok and type(data) == "table" then data else {}
	best[p.UserId] = if type(d.best) == "number" then d.best else 0
	journal[p.UserId] = if type(d.journal) == "table" then d.journal else {}
	ach[p.UserId] = if type(d.ach) == "table" then d.ach else {}
	return best[p.UserId]
end

function Records.get(p: Player): number
	return best[p.UserId] or 0
end

function Records.journal(p: Player): { [string]: boolean }
	return journal[p.UserId] or {}
end

function Records.offer(p: Player, door: number): boolean
	if door &lt;= (best[p.UserId] or 0) then
		return false
	end
	best[p.UserId] = door
	update(p, function(o)
		o.best = math.max(tonumber(o.best) or 0, door)
	end)
	return true
end

-- новая запись в журнале; true, если раньше её не было
function Records.discover(p: Player, id: string): boolean
	local j = journal[p.UserId]
	if not j then
		j = {}
		journal[p.UserId] = j
	end
	if j[id] then
		return false
	end
	j[id] = true
	update(p, function(o)
		o.journal = if type(o.journal) == "table" then o.journal else {}
		o.journal[id] = true
	end)
	return true
end

function Records.achievements(p: Player): { [string]: boolean }
	return ach[p.UserId] or {}
end

-- новое достижение; true, если раньше его не было
function Records.achieve(p: Player, id: string): boolean
	local a = ach[p.UserId]
	if not a then
		a = {}
		ach[p.UserId] = a
	end
	if a[id] then
		return false
	end
	a[id] = true
	update(p, function(o)
		o.ach = if type(o.ach) == "table" then o.ach else {}
		o.ach[id] = true
	end)
	return true
end

function Records.complete(p: Player)
	update(p, function(o)
		o.done = (tonumber(o.done) or 0) + 1
	end)
end

function Records.forget(p: Player)
	best[p.UserId] = nil
	journal[p.UserId] = nil
	ach[p.UserId] = nil
end

return Records
</ProtectedString>
          </Properties>
        </Item>
      </Item>
      <Item class="Script" referent="RBX00000017">
        <Properties>
          <string name="Name">Main</string>
          <ProtectedString name="Source">--!nonstrict
-- Точка входа сервера «The Labyrinth»

local Players = game:GetService("Players")
local Remotes = require(game:GetService("ReplicatedStorage").Workshop.Shared.Roblox.Remotes)
local Access = require(script.Parent.Access)
local G = require(script.Parent.Game.Game)
local Admin = require(script.Parent.Game.Admin)

-- сеть создаётся до всего остального, чтобы клиенты могли подключиться сразу
Remotes.event("Game")
G.init()
Admin.init()

Players.PlayerRemoving:Connect(function(p)
	Access.forget(p)
end)
</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="Folder" referent="RBX00000018">
        <Properties>
          <string name="Name">World</string>
        </Properties>
        <Item class="ModuleScript" referent="RBX00000019">
          <Properties>
            <string name="Name">Props</string>
            <ProtectedString name="Source">--!nonstrict
-- Модели лабиринта. Правила сборки: ни одна деталь не входит в другую с совпадающей
-- гранью (иначе мерцает), всё, что стоит у стены, отстоит от неё на 0.05.
-- cf предмета у стены — точка на полу у стены, LookVector смотрит в комнату

local CollectionService = game:GetService("CollectionService")
local M = require(game:GetService("ReplicatedStorage").Workshop.Shared.Materials)

local Props = {}

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end
Props.rgb = rgb

Props.WOOD = rgb(112, 78, 52)
Props.WOOD_DARK = rgb(64, 42, 30)
Props.WOOD_LIGHT = rgb(150, 112, 76)
Props.BRASS = rgb(190, 156, 88)
Props.IRON = rgb(58, 58, 62)
Props.STEEL = rgb(118, 124, 128)
Props.CLOTH = rgb(222, 216, 204)

-- множитель яркости ламп для комнаты, которая сейчас строится
Props.LIGHT = 1

local CYL = Enum.PartType.Cylinder
local BALL = Enum.PartType.Ball

local function P(parent, name, size: Vector3, cf: CFrame, color, mat, extra)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = mat or M.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if extra then
		for k, v in extra do
			(p :: any)[k] = v
		end
	end
	p.Parent = parent
	return p
end
Props.P = P

local function nc(extra)
	local t = { CanCollide = false, CanQuery = false, CastShadow = false }
	if extra then
		for k, v in extra do
			t[k] = v
		end
	end
	return t
end
Props.nc = nc

-- цилиндр вдоль локальной оси Y: длина len, диаметр d
local function C(parent, name, len: number, d: number, cf: CFrame, color, mat, extra)
	local p = P(parent, name, Vector3.new(len, d, d), cf * CFrame.Angles(0, 0, math.pi / 2), color, mat, extra)
	p.Shape = CYL
	return p
end
Props.C = C

local function S(parent, name, d: number, cf: CFrame, color, mat, extra)
	local p = P(parent, name, Vector3.new(d, d, d), cf, color, mat, extra)
	p.Shape = BALL
	return p
end
Props.S = S

-- стержень между двумя точками
local function rod(parent, name, a: Vector3, b: Vector3, thick: number, color, mat, extra)
	local len = (b - a).Magnitude
	return P(parent, name, Vector3.new(thick, thick, len), CFrame.lookAt((a + b) / 2, b), color, mat, extra)
end
Props.rod = rod

local function model(parent, name)
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end
Props.model = model

local function light(part, range, brightness, color, shadows)
	local f = Props.LIGHT
	local l = Instance.new("PointLight")
	l.Range = range
	l.Brightness = brightness * math.max(f, 0)
	l.Color = color or rgb(255, 212, 158)
	l.Shadows = shadows ~= false
	l.Enabled = f &gt; 0.01
	l:SetAttribute("Base", brightness)
	l.Parent = part
	return l
end
Props.light = light

function Props.prompt(part: Instance, kind: string, hold: number?, dist: number?)
	local pr = Instance.new("ProximityPrompt")
	pr.Name = kind
	pr.ActionText = ""
	pr.ObjectText = ""
	pr.HoldDuration = hold or 0
	pr.MaxActivationDistance = dist or 8
	pr.RequiresLineOfSight = false
	pr:SetAttribute("Kind", kind)
	pr.Parent = part
	return pr
end

-- ---------------------------------------------------------------------------
-- стены

-- Стена вдоль локальной оси X кадра cf (середина стены на полу), от y0 высотой height,
-- с проёмами holes = { { x, w, y = низ проёма, h = верх проёма } }
function Props.wall(parent, cf: CFrame, length: number, y0: number, height: number, thick: number, holes, color, mat, name: string?)
	local list = table.clone(holes or {})
	table.sort(list, function(a, b)
		return a.x &lt; b.x
	end)
	local x = -length / 2
	local y1 = y0 + height
	local function seg(x0, x1, ya, yb)
		if x1 - x0 &gt; 0.05 and yb - ya &gt; 0.05 then
			P(parent, name or "Wall", Vector3.new(x1 - x0, yb - ya, thick), cf * CFrame.new((x0 + x1) / 2, (ya + yb) / 2, 0), color, mat)
		end
	end
	for _, h in list do
		local hx0, hx1 = math.max(x, h.x - h.w / 2), math.min(length / 2, h.x + h.w / 2)
		if hx1 &gt; hx0 then
			seg(x, hx0, y0, y1)
			seg(hx0, hx1, y0, math.max(y0, h.y or y0))
			seg(hx0, hx1, math.min(y1, h.h), y1)
			x = hx1
		end
	end
	seg(x, length / 2, y0, y1)
end

-- ---------------------------------------------------------------------------
-- двери

-- Двери трёх размеров: служебная железная, обычная филёнчатая, парадная двустворчатая.
-- cf — середина проёма на полу, LookVector — в следующий зал. Возвращает модель и створки
Props.DOORS = { small = { w = 4, h = 7.5 }, normal = { w = 5, h = 8 }, grand = { w = 8, h = 11 } }
-- style: wood — деревянная с филёнками, metal — стальная с заклёпками, service — служебная,
-- tech — техническая с полосами и решёткой, code — стальная с кодовой панелью,
-- puzzle — с четырьмя цветными гнёздами (зал с фигурками)
function Props.door(parent, cf: CFrame, plate: string?, locked: boolean?, size: string?, style: string?)
	local m = model(parent, "Door")
	local kind = size or "normal"
	local w, h = Props.DOORS[kind].w, Props.DOORS[kind].h
	style = style or (if kind == "small" then "service" else "wood")
	local metal = kind == "small" or style == "metal" or style == "tech" or style == "service" or style == "code"
	local trim = if metal then rgb(70, 74, 76) else Props.WOOD_DARK
	local tmat = if metal then M.Metal else M.Wood
	-- наличник заходит в проём на 0.1, чтобы его грани не совпадали с краями проёма
	for _, s in { -1, 1 } do
		P(m, "Casing", Vector3.new(0.7, h - 0.1, 1.5), cf * CFrame.new(s * (w / 2 + 0.25), (h - 0.1) / 2, 0), trim, tmat)
	end
	P(m, "Head", Vector3.new(w + 1.2, 0.7, 1.5), cf * CFrame.new(0, h + 0.25, 0), trim, tmat)
	P(m, "Cornice", Vector3.new(w + 1.8, 0.3, 1.7), cf * CFrame.new(0, h + 0.75, 0), trim, tmat)
	local wood = if style == "tech" then rgb(120, 116, 96) elseif style == "metal" or style == "code" then rgb(78, 86, 92) elseif metal then rgb(96, 104, 106) elseif kind == "grand" then rgb(84, 52, 34) elseif style == "puzzle" then rgb(70, 44, 32) else Props.WOOD
	local leaves = {}
	local specs = if kind == "grand" then { { -1, (w - 0.3) / 2 - 0.04 }, { 1, (w - 0.3) / 2 - 0.04 } } else { { -1, w - 0.3 } }
	for _, sp in specs do
		local side, lw = sp[1], sp[2]
		local leaf = model(m, "Leaf")
		local hinge = side * (w / 2 - 0.15)
		local cx = hinge - side * lw / 2
		P(leaf, "Slab", Vector3.new(lw, h - 0.25, 0.3), cf * CFrame.new(cx, (h - 0.25) / 2 + 0.02, 0), wood, if metal then M.Metal else M.WoodPlanks)
		for _, face in { -1, 1 } do
			if style == "tech" then
				-- полосатый низ, окошко с решёткой, ручка-скоба
				for k = 0, 3 do
					P(leaf, "Stripe", Vector3.new(0.5, 1.2, 0.05), cf * CFrame.new(cx - lw / 2 + 0.6 + k * (lw - 1.2) / 3, 0.9, face * 0.175) * CFrame.Angles(0, 0, 0.6), if k % 2 == 0 then rgb(220, 180, 40) else rgb(30, 30, 30), M.SmoothPlastic, nc())
				end
				P(leaf, "Grate", Vector3.new(lw * 0.45, 1, 0.05), cf * CFrame.new(cx, h - 2, face * 0.175), rgb(20, 22, 24), M.DiamondPlate, nc())
				P(leaf, "Grip", Vector3.new(0.2, 1.2, 0.2), cf * CFrame.new(cx - side * (lw / 2 - 0.45), 3.8, face * 0.3), rgb(40, 40, 42), M.Metal, nc())
			elseif style == "metal" or style == "code" then
				-- стальной лист: два пояса и ряды заклёпок, ручка-штанга
				for _, y in { h * 0.3, h * 0.72 } do
					P(leaf, "Band", Vector3.new(lw - 0.3, 0.35, 0.06), cf * CFrame.new(cx, y, face * 0.18), rgb(56, 62, 66), M.Metal, nc())
					for k = 0, 4 do
						S(leaf, "Rivet", 0.16, cf * CFrame.new(cx - lw / 2 + 0.4 + k * (lw - 0.8) / 4, y, face * 0.22), rgb(150, 150, 156), M.Metal, nc())
					end
				end
				P(leaf, "Bar", Vector3.new(lw - 1.2, 0.2, 0.2), cf * CFrame.new(cx, 3.9, face * 0.32), rgb(170, 170, 176), M.Metal, nc())
			elseif metal then
				P(leaf, "Plate", Vector3.new(lw - 0.8, 1.4, 0.06), cf * CFrame.new(cx, h - 2, face * 0.18), rgb(60, 64, 66), M.DiamondPlate, nc())
				P(leaf, "Bar", Vector3.new(lw - 1, 0.25, 0.25), cf * CFrame.new(cx, 4, face * 0.3), rgb(150, 150, 156), M.Metal, nc())
			elseif style == "puzzle" then
				-- четыре цветных гнезда по кругу: дверь откроется, когда фигурки встанут на места
				local colors = { rgb(190, 50, 50), rgb(50, 90, 190), rgb(60, 160, 70), rgb(220, 190, 50) }
				C(leaf, "Ring", 0.06, 2.2, cf * CFrame.new(cx, h * 0.55, face * 0.18) * CFrame.Angles(math.pi / 2, 0, 0), Props.BRASS, M.Metal, nc())
				for k = 1, 4 do
					local a = k / 4 * math.pi * 2
					C(leaf, "Socket", 0.08, 0.5, cf * CFrame.new(cx + math.cos(a) * 0.75, h * 0.55 + math.sin(a) * 0.75, face * 0.2) * CFrame.Angles(math.pi / 2, 0, 0), colors[k], M.SmoothPlastic, nc())
				end
				S(leaf, "Knob", 0.45, cf * CFrame.new(cx - side * (lw / 2 - 0.5), 4.2, face * 0.44), Props.BRASS, M.Metal, nc())
			else
				for _, y in { h * 0.27, h * 0.7 } do
					P(leaf, "Panel", Vector3.new(lw - 1.2, h * 0.3, 0.06), cf * CFrame.new(cx, y, face * 0.18), wood:Lerp(rgb(0, 0, 0), 0.2), M.Wood, nc())
				end
				S(leaf, "Knob", 0.45, cf * CFrame.new(cx - side * (lw / 2 - 0.5), 4.2, face * 0.44), Props.BRASS, M.Metal, nc())
				P(leaf, "Rose", Vector3.new(0.5, 0.9, 0.06), cf * CFrame.new(cx - side * (lw / 2 - 0.5), 4.1, face * 0.2), Props.BRASS, M.Metal, nc())
			end
		end
		leaf:SetAttribute("KnobX", cx - side * (lw / 2 - 0.5))
		leaf.WorldPivot = cf * CFrame.new(hinge, 0, 0)
		leaf:SetAttribute("Dir", -side)
		table.insert(leaves, leaf)
	end
	if plate then
		-- латунная табличка над дверью со стороны входа
		local p = P(m, "Plate", Vector3.new(1.8, 0.5, 0.08), cf * CFrame.new(0, h + 0.25, 0.8), Props.BRASS, M.Metal, nc())
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Back
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 90
		gui.LightInfluence = 1
		gui.Parent = p
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Size = UDim2.fromScale(1, 1)
		t.Font = Enum.Font.Antique
		t.TextScaled = true
		t.TextColor3 = rgb(36, 26, 14)
		t.Text = plate
		t.Parent = gui
	end
	if style == "code" then
		-- кодовая панель на наличнике
		local pad = model(m, "CodeBox")
		P(pad, "Box", Vector3.new(0.9, 1.4, 0.3), cf * CFrame.new(w / 2 + 0.25, 4.6, 0.9), rgb(40, 44, 46), M.Metal, nc())
		for r = 0, 2 do
			for q = 0, 2 do
				P(pad, "Key", Vector3.new(0.18, 0.18, 0.06), cf * CFrame.new(w / 2 + 0.05 + q * 0.2, 4.95 - r * 0.24, 1.07), rgb(200, 200, 190), M.SmoothPlastic, nc())
			end
		end
		P(pad, "Led", Vector3.new(0.5, 0.12, 0.06), cf * CFrame.new(w / 2 + 0.25, 5.15, 1.07), rgb(200, 40, 30), M.Neon, nc())
	end
	if locked then
		-- латунная накладка с большой скважиной: сюда подходит ключ
		local leaf = leaves[#leaves]
		local kx = leaf:GetAttribute("KnobX") or 0
		for _, face in { -1, 1 } do
			P(leaf, "Escutcheon", Vector3.new(0.4, 0.8, 0.06), cf * CFrame.new(kx, 3.2, face * 0.2), Props.BRASS, M.Metal, nc())
			P(leaf, "Keyhole", Vector3.new(0.14, 0.34, 0.06), cf * CFrame.new(kx, 3.15, face * 0.22), rgb(10, 10, 10), M.SmoothPlastic, nc())
		end
		local lock = model(m, "Padlock")
		local lx = w / 2 - 0.9
		P(lock, "Hasp", Vector3.new(0.9, 0.3, 0.1), cf * CFrame.new(lx, 5.3, 0.25), Props.IRON, M.Metal, nc())
		P(lock, "Body", Vector3.new(0.8, 0.9, 0.35), cf * CFrame.new(lx, 4.75, 0.42), rgb(150, 136, 100), M.Metal, nc())
		P(lock, "Shackle", Vector3.new(0.5, 0.45, 0.12), cf * CFrame.new(lx, 5.42, 0.42), rgb(130, 130, 136), M.Metal, nc())
	end
	CollectionService:AddTag(m, "LabDoor")
	return m, leaves
end

-- ---------------------------------------------------------------------------
-- укрытия

-- Железный шкафчик: стальной корпус с прорезями, ручка, ножки. Внутри пусто — туда
-- помещается игрок. Возвращает модель и невидимую «полость» с кнопкой
function Props.locker(parent, cf: CFrame, color: Color3?)
	local m = model(parent, "Locker")
	local steel = color or rgb(84, 96, 92)
	local w, d, h = 3.6, 2.8, 7.4
	local base = cf * CFrame.new(0, 0, -0.05 - d / 2)
	-- полость (невидимая, без столкновений) — для кнопки и укрытия
	local cavity = P(m, "Cavity", Vector3.new(w - 0.4, h - 1, d - 0.4), base * CFrame.new(0, 0.6 + (h - 1) / 2, 0), rgb(0, 0, 0), M.SmoothPlastic, { Transparency = 1, CanCollide = false, CanQuery = true, CastShadow = false })
	P(m, "Back", Vector3.new(w, h, 0.15), base * CFrame.new(0, h / 2 + 0.4, d / 2 - 0.075), steel, M.Metal)
	for _, s in { -1, 1 } do
		P(m, "Side", Vector3.new(0.15, h, d - 0.15), base * CFrame.new(s * (w / 2 - 0.075), h / 2 + 0.4, -0.075), steel, M.Metal)
	end
	P(m, "Top", Vector3.new(w, 0.15, d - 0.15), base * CFrame.new(0, h + 0.475, -0.075), steel, M.Metal)
	P(m, "Floor", Vector3.new(w - 0.3, 0.15, d - 0.3), base * CFrame.new(0, 0.475, 0), steel, M.Metal)
	-- дверца: лист, три ряда прорезей, ручка, табличка
	local door = P(m, "DoorPlate", Vector3.new(w - 0.3, h - 0.25, 0.1), base * CFrame.new(0, h / 2 + 0.4, -d / 2 + 0.05), steel:Lerp(rgb(255, 255, 255), 0.06), M.Metal)
	local _ = door
	for k = 0, 4 do
		P(m, "Vent", Vector3.new(w - 1.4, 0.12, 0.05), base * CFrame.new(0, h - 0.6 - k * 0.35, -d / 2 - 0.03), rgb(18, 18, 18), M.SmoothPlastic, nc())
		P(m, "Vent", Vector3.new(w - 1.4, 0.12, 0.05), base * CFrame.new(0, 1.6 + k * 0.35, -d / 2 - 0.03), rgb(18, 18, 18), M.SmoothPlastic, nc())
	end
	P(m, "Handle", Vector3.new(0.18, 1.2, 0.25), base * CFrame.new(w / 2 - 0.55, h / 2 + 0.2, -d / 2 - 0.12), rgb(170, 170, 176), M.Metal, nc())
	P(m, "Tag", Vector3.new(0.8, 0.4, 0.04), base * CFrame.new(0, h - 2.6, -d / 2 - 0.02), rgb(210, 200, 170), M.SmoothPlastic, nc())
	for _, s in { -1, 1 } do
		for _, e in { -1, 1 } do
			P(m, "Leg", Vector3.new(0.25, 0.4, 0.25), base * CFrame.new(s * (w / 2 - 0.3), 0.2, e * (d / 2 - 0.3)), rgb(30, 30, 30), M.Metal)
		end
	end
	Props.prompt(cavity, "hide", 0.25, 6)
	CollectionService:AddTag(cavity, "HideSpot")
	return m, cavity
end

-- Ниша за решёткой у пола (в тесных комнатах): игрок заползает внутрь
function Props.vent(parent, cf: CFrame)
	local m = model(parent, "VentHide")
	local w, h, d = 4, 4.2, 3
	local base = cf * CFrame.new(0, 0, -0.05 - d / 2)
	local cavity = P(m, "Cavity", Vector3.new(w - 0.4, h - 0.4, d - 0.4), base * CFrame.new(0, h / 2, 0), rgb(0, 0, 0), M.SmoothPlastic, { Transparency = 1, CanCollide = false, CanQuery = true, CastShadow = false })
	local duct = rgb(96, 98, 100)
	P(m, "Back", Vector3.new(w, h, 0.15), base * CFrame.new(0, h / 2, d / 2 - 0.075), duct, M.Metal)
	for _, s in { -1, 1 } do
		P(m, "Side", Vector3.new(0.15, h, d - 0.15), base * CFrame.new(s * (w / 2 - 0.075), h / 2, -0.075), duct, M.Metal)
	end
	P(m, "Top", Vector3.new(w, 0.15, d - 0.15), base * CFrame.new(0, h + 0.075, -0.075), duct, M.Metal)
	for k = -3, 3 do
		P(m, "Grate", Vector3.new(0.12, h - 0.4, 0.12), base * CFrame.new(k * 0.55, h / 2, -d / 2 + 0.06), rgb(40, 40, 42), M.Metal, nc())
	end
	for _, y in { 0.4, h - 0.4 } do
		P(m, "GrateBar", Vector3.new(w - 0.3, 0.15, 0.15), base * CFrame.new(0, y, -d / 2 + 0.06), rgb(40, 40, 42), M.Metal, nc())
	end
	Props.prompt(cavity, "hide", 0.4, 6)
	CollectionService:AddTag(cavity, "HideSpot")
	return m, cavity
end

-- ---------------------------------------------------------------------------
-- мебель с ящиками: ящики выезжают, внутри может лежать находка

-- корпус без передней стенки и ящики внутри. rows — число ящиков сверху вниз
local function drawerCase(m, cf: CFrame, w: number, d: number, h: number, rows: number, wood: Color3, legs: number, noTop: boolean?)
	local base = cf * CFrame.new(0, 0, -0.05 - d / 2)
	local t = 0.15
	P(m, "Back", Vector3.new(w, h, t), base * CFrame.new(0, legs + h / 2, d / 2 - t / 2), wood, M.Wood)
	for _, s in { -1, 1 } do
		P(m, "Side", Vector3.new(t, h, d - t), base * CFrame.new(s * (w / 2 - t / 2), legs + h / 2, -t / 2), wood, M.Wood)
	end
	if not noTop then
		P(m, "Top", Vector3.new(w + 0.2, 0.2, d + 0.05), base * CFrame.new(0, legs + h + 0.1, -0.025), wood:Lerp(rgb(0, 0, 0), 0.15), M.Wood)
	end
	P(m, "Bottom", Vector3.new(w - 2 * t, t, d - t), base * CFrame.new(0, legs + t / 2, -t / 2), wood, M.Wood)
	if legs &gt; 0 then
		for _, s in { -1, 1 } do
			for _, e in { -1, 1 } do
				P(m, "Leg", Vector3.new(0.3, legs, 0.3), base * CFrame.new(s * (w / 2 - 0.25), legs / 2, e * (d / 2 - 0.25)), wood:Lerp(rgb(0, 0, 0), 0.25), M.Wood)
			end
		end
	end
	local drawers = {}
	local innerW, innerD = w - 2 * t - 0.1, d - t - 0.15
	local rowH = (h - t) / rows
	for r = 1, rows do
		local dm = model(m, "Drawer")
		local y = legs + h - (r - 0.5) * rowH
		local front = base * CFrame.new(0, y, -d / 2 + 0.06)
		P(dm, "Front", Vector3.new(w - 2 * t - 0.06, rowH - 0.12, 0.12), front, wood:Lerp(rgb(255, 255, 255), 0.08), M.Wood)
		P(dm, "Pull", Vector3.new(0.9, 0.16, 0.16), front * CFrame.new(0, 0, -0.14), Props.BRASS, M.Metal, nc())
		local boxY = y - rowH / 2 + 0.12
		P(dm, "BoxBottom", Vector3.new(innerW - 0.1, 0.08, innerD - 0.2), base * CFrame.new(0, boxY, 0.05), Props.WOOD_LIGHT, M.Wood, nc())
		for _, s in { -1, 1 } do
			P(dm, "BoxSide", Vector3.new(0.08, rowH * 0.45, innerD - 0.3), base * CFrame.new(s * (innerW / 2 - 0.1), boxY + 0.04 + rowH * 0.225, 0.05), Props.WOOD_LIGHT, M.Wood, nc())
		end
		dm.WorldPivot = front
		-- у каждого ящика своя кнопка: его можно выдвинуть и задвинуть отдельно
		local hit = P(dm, "DrawerHit", Vector3.new(w - 2 * t - 0.2, rowH - 0.2, 0.3), front * CFrame.new(0, 0, -0.25), rgb(0, 0, 0), M.SmoothPlastic, { Transparency = 1, CanCollide = false, CanQuery = true, CastShadow = false })
		Props.prompt(hit, "drawer", 0, 6)
		-- inside — место находки в задвинутом ящике (предмет лежит внутри и едет вместе с ним)
		table.insert(drawers, { model = dm, hit = hit, inside = base * CFrame.new(0, boxY + 0.05, 0.05), depth = innerD })
	end
	return drawers
end

-- кнопка «Обыскать» на передней части; drawers нужны игре для анимации
local function searchable(m, cf, w, d, h, legs)
	CollectionService:AddTag(m, "Searchable")
	local _ = { cf, w, d, h, legs }
	return nil
end

function Props.dresser(parent, cf: CFrame, wood: Color3?)
	local m = model(parent, "Dresser")
	local w, d, h = 4.8, 2, 3.4
	local drawers = drawerCase(m, cf, w, d, h, 3, wood or Props.WOOD, 0.35)
	local hit = searchable(m, cf, w, d, h, 0.35)
	return m, hit, drawers, cf * CFrame.new(1.4, 0.35 + h + 0.2, -1.05)
end

function Props.nightstand(parent, cf: CFrame, wood: Color3?)
	local m = model(parent, "Nightstand")
	local w, d, h = 2.2, 1.8, 2.2
	local drawers = drawerCase(m, cf, w, d, h, 1, wood or Props.WOOD, 0.4)
	local hit = searchable(m, cf, w, d, h, 0.4)
	return m, hit, drawers, cf * CFrame.new(0, 0.4 + h + 0.2, -0.95)
end

function Props.cabinet(parent, cf: CFrame)
	local m = model(parent, "FilingCabinet")
	local w, d, h = 2.4, 2.4, 4.6
	local drawers = drawerCase(m, cf, w, d, h, 3, rgb(110, 116, 112), 0)
	for _, p in m:GetDescendants() do
		if p:IsA("BasePart") and p.Material == M.Wood then
			p.Material = M.Metal
		end
	end
	local hit = searchable(m, cf, w, d, h, 0)
	return m, hit, drawers
end

-- письменный стол с двумя ящиками справа
function Props.desk(parent, cf: CFrame)
	local m = model(parent, "Desk")
	local w, d = 5.4, 2.6
	local base = cf * CFrame.new(0, 0, -0.05 - d / 2)
	P(m, "Top", Vector3.new(w, 0.25, d), base * CFrame.new(0, 3.08, 0), Props.WOOD, M.Wood)
	for _, e in { -1, 1 } do
		P(m, "LegL", Vector3.new(0.3, 2.95, 0.3), base * CFrame.new(-w / 2 + 0.3, 1.48, e * (d / 2 - 0.3)), Props.WOOD_DARK, M.Wood)
	end
	P(m, "Modesty", Vector3.new(w - 2.3, 1.4, 0.12), base * CFrame.new(-0.85, 2.2, d / 2 - 0.2), Props.WOOD_DARK, M.Wood)
	local case = model(m, "Pedestal")
	local drawers = drawerCase(case, cf * CFrame.new(w / 2 - 1.05, 0, 0), 2, d, 2.95, 2, Props.WOOD, 0, true)
	local hit = searchable(m, cf * CFrame.new(w / 2 - 1.05, 0, 0), 2, d, 2.95, 0)
	P(m, "Papers", Vector3.new(1.2, 0.04, 1.6), base * CFrame.new(-1.2, 3.23, 0) * CFrame.Angles(0, 0.25, 0), rgb(226, 220, 204), M.SmoothPlastic, nc())
	return m, hit, drawers, base * CFrame.new(0.2, 3.3, 0.1)
end

-- ---------------------------------------------------------------------------
-- прочая мебель

function Props.bed(parent, cf: CFrame, blanket: Color3, wood: Color3?)
	local m = model(parent, "Bed")
	local w, len = 5, 8.4
	local base = cf * CFrame.new(0, 0, -0.05 - len / 2)
	local frame = wood or Props.WOOD_DARK
	P(m, "Frame", Vector3.new(w - 0.1, 1, len - 0.6), base * CFrame.new(0, 0.9, -0.1), frame, M.Wood)
	for _, s in { -1, 1 } do
		P(m, "PostHead", Vector3.new(0.4, 4.2, 0.4), base * CFrame.new(s * (w / 2 - 0.2), 2.1, len / 2 - 0.2), frame, M.Wood)
		P(m, "PostFoot", Vector3.new(0.4, 2.4, 0.4), base * CFrame.new(s * (w / 2 - 0.2), 1.2, -len / 2 + 0.2), frame, M.Wood)
	end
	P(m, "Headboard", Vector3.new(w - 0.4, 2.8, 0.25), base * CFrame.new(0, 2.6, len / 2 - 0.2), frame, M.Wood)
	P(m, "Footboard", Vector3.new(w - 0.4, 1.2, 0.2), base * CFrame.new(0, 1.7, -len / 2 + 0.2), frame, M.Wood)
	P(m, "Mattress", Vector3.new(w - 0.5, 0.7, len - 1), base * CFrame.new(0, 1.75, 0), Props.CLOTH, M.SmoothPlastic)
	P(m, "Blanket", Vector3.new(w - 0.3, 0.22, len * 0.6), base * CFrame.new(0, 2.21, -len * 0.18), blanket, M.Fabric)
	P(m, "Fold", Vector3.new(w - 0.36, 0.26, 0.8), base * CFrame.new(0, 2.25, len * 0.13), Props.CLOTH, M.SmoothPlastic, nc())
	for _, x in { -1.1, 1.1 } do
		P(m, "Pillow", Vector3.new(1.8, 0.5, 1.2), base * CFrame.new(x, 2.35, len / 2 - 1.2), rgb(240, 236, 228), M.SmoothPlastic, nc())
	end
	return m
end

function Props.chair(parent, cf: CFrame, color: Color3?)
	-- cf — центр стула на полу, LookVector — куда смотрит сидящий
	local m = model(parent, "Chair")
	local wood = color or Props.WOOD
	P(m, "Seat", Vector3.new(1.8, 0.2, 1.8), cf * CFrame.new(0, 1.8, 0), wood, M.Wood)
	P(m, "Cushion", Vector3.new(1.6, 0.15, 1.6), cf * CFrame.new(0, 1.98, 0), rgb(120, 40, 40), M.Fabric, nc())
	for _, x in { -0.75, 0.75 } do
		for _, z in { -0.75, 0.75 } do
			P(m, "Leg", Vector3.new(0.18, 1.7, 0.18), cf * CFrame.new(x, 0.85, z), Props.WOOD_DARK, M.Wood, nc())
		end
		P(m, "BackPost", Vector3.new(0.18, 2.2, 0.18), cf * CFrame.new(x, 3, 0.81), Props.WOOD_DARK, M.Wood, nc())
	end
	P(m, "BackRail", Vector3.new(1.5, 0.5, 0.12), cf * CFrame.new(0, 3.6, 0.81), wood, M.Wood, nc())
	return m
end

function Props.armchair(parent, cf: CFrame, color: Color3)
	local m = model(parent, "Armchair")
	P(m, "Base", Vector3.new(3, 1.4, 2.8), cf * CFrame.new(0, 0.9, 0), color, M.Fabric)
	P(m, "Back", Vector3.new(3, 2.2, 0.6), cf * CFrame.new(0, 2.7, 1.1), color, M.Fabric)
	for _, s in { -1, 1 } do
		P(m, "Arm", Vector3.new(0.5, 0.9, 2.1), cf * CFrame.new(s * 1.25, 2.05, -0.25), color:Lerp(rgb(0, 0, 0), 0.1), M.Fabric)
	end
	for _, x in { -1.2, 1.2 } do
		for _, z in { -1.1, 1.1 } do
			P(m, "Foot", Vector3.new(0.25, 0.2, 0.25), cf * CFrame.new(x, 0.1, z), Props.WOOD_DARK, M.Wood, nc())
		end
	end
	return m
end

function Props.sofa(parent, cf: CFrame, color: Color3)
	-- cf у стены, сидящие смотрят в комнату
	local m = model(parent, "Sofa")
	local w, d = 7, 2.8
	local base = cf * CFrame.new(0, 0, -0.05 - d / 2)
	P(m, "Base", Vector3.new(w, 1.4, d), base * CFrame.new(0, 0.9, 0), color, M.Fabric)
	P(m, "Back", Vector3.new(w, 2.2, 0.6), base * CFrame.new(0, 2.7, d / 2 - 0.3), color, M.Fabric)
	for _, s in { -1, 1 } do
		P(m, "Arm", Vector3.new(0.5, 0.9, d - 0.6), base * CFrame.new(s * (w / 2 - 0.25), 2.05, -0.3), color:Lerp(rgb(0, 0, 0), 0.1), M.Fabric)
	end
	for k = -1, 1 do
		P(m, "Cushion", Vector3.new(w / 3 - 0.7, 0.3, d - 0.9), base * CFrame.new(k * (w / 3 - 0.15), 1.76, -0.3), color:Lerp(rgb(255, 255, 255), 0.06), M.Fabric, nc())
	end
	return m
end

function Props.table(parent, cf: CFrame, w: number, d: number, cloth: Color3?)
	local m = model(parent, "Table")
	P(m, "Top", Vector3.new(w, 0.25, d), cf * CFrame.new(0, 3.08, 0), Props.WOOD, M.Wood)
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			P(m, "Leg", Vector3.new(0.3, 2.95, 0.3), cf * CFrame.new(sx * (w / 2 - 0.4), 1.48, sz * (d / 2 - 0.4)), Props.WOOD_DARK, M.Wood)
		end
	end
	if cloth then
		P(m, "Cloth", Vector3.new(w - 0.6, 0.04, d + 0.3), cf * CFrame.new(0, 3.23, 0), cloth, M.Fabric, nc())
	end
	return m, cf * CFrame.new(0, 3.25, 0)
end

function Props.coffeeTable(parent, cf: CFrame)
	local m = model(parent, "CoffeeTable")
	P(m, "Top", Vector3.new(4, 0.2, 2.4), cf * CFrame.new(0, 1.6, 0), Props.WOOD_DARK, M.Wood)
	P(m, "Shelf", Vector3.new(3.4, 0.12, 1.8), cf * CFrame.new(0, 0.5, 0), Props.WOOD_DARK, M.Wood, nc())
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			P(m, "Leg", Vector3.new(0.22, 1.5, 0.22), cf * CFrame.new(sx * 1.75, 0.75, sz * 0.95), Props.WOOD_DARK, M.Wood)
		end
	end
	return m, cf * CFrame.new(0, 1.72, 0)
end

-- книжный шкаф: полки с книгами блоками по несколько корешков
function Props.bookshelf(parent, cf: CFrame, w: number, h: number, seed: number)
	local m = model(parent, "Bookshelf")
	local d = 1.8
	local base = cf * CFrame.new(0, 0, -0.05 - d / 2)
	local wood = Props.WOOD_DARK
	P(m, "Back", Vector3.new(w, h, 0.15), base * CFrame.new(0, h / 2, d / 2 - 0.075), wood, M.Wood)
	for _, s in { -1, 1 } do
		P(m, "Side", Vector3.new(0.25, h, d - 0.15), base * CFrame.new(s * (w / 2 - 0.125), h / 2, -0.075), wood, M.Wood)
	end
	P(m, "Crown", Vector3.new(w + 0.3, 0.35, d + 0.1), base * CFrame.new(0, h + 0.175, -0.05), wood, M.Wood)
	local rows = math.floor(h / 2.2)
	for r = 0, rows - 1 do
		local y = 0.3 + r * 2.2
		P(m, "Board", Vector3.new(w - 0.5, 0.16, d - 0.25), base * CFrame.new(0, y, -0.05), Props.WOOD, M.Wood)
		local x = -w / 2 + 0.35
		local k = 0
		while x &lt; w / 2 - 1 do
			k += 1
			local bw = 0.6 + ((seed * 13 + r * 7 + k * 5) % 7) * 0.12
			local bh = 1.2 + ((seed * 3 + r * 11 + k * 7) % 5) * 0.12
			if (seed + r + k) % 6 ~= 0 then
				local hue = ({ 0.0, 0.03, 0.08, 0.33, 0.58, 0.7 })[((seed + r * 2 + k) % 6) + 1]
				P(m, "Books", Vector3.new(bw, bh, d - 0.5), base * CFrame.new(x + bw / 2, y + 0.08 + bh / 2, 0.05), Color3.fromHSV(hue, 0.5, 0.32), M.SmoothPlastic, nc())
			end
			x += bw + 0.04
		end
	end
	P(m, "Board", Vector3.new(w - 0.5, 0.16, d - 0.25), base * CFrame.new(0, 0.3 + rows * 2.2, -0.05), Props.WOOD, M.Wood)
	return m
end

-- кухня
function Props.counter(parent, cf: CFrame, w: number)
	local m = model(parent, "Counter")
	local d = 2.4
	local base = cf * CFrame.new(0, 0, -0.05 - d / 2)
	P(m, "Body", Vector3.new(w, 3, d - 0.1), base * CFrame.new(0, 1.5, 0.05), rgb(200, 196, 186), M.Wood)
	P(m, "Top", Vector3.new(w + 0.1, 0.2, d + 0.1), base * CFrame.new(0, 3.1, 0), rgb(70, 70, 74), M.Granite)
	local n = math.max(1, math.floor(w / 2.4))
	for k = 0, n - 1 do
		local x = -w / 2 + (k + 0.5) * w / n
		P(m, "Door", Vector3.new(w / n - 0.2, 2.4, 0.06), base * CFrame.new(x, 1.5, -d / 2 + 0.02), rgb(180, 176, 166), M.Wood, nc())
		P(m, "Knob", Vector3.new(0.5, 0.12, 0.12), base * CFrame.new(x, 2.4, -d / 2 - 0.06), Props.STEEL, M.Metal, nc())
	end
	return m, base * CFrame.new(0, 3.3, 0)
end

function Props.stove(parent, cf: CFrame)
	local m = model(parent, "Stove")
	local base = cf * CFrame.new(0, 0, -0.05 - 1.2)
	P(m, "Body", Vector3.new(3, 3, 2.4), base * CFrame.new(0, 1.5, 0), rgb(220, 220, 214), M.Metal)
	P(m, "OvenDoor", Vector3.new(2.4, 1.6, 0.08), base * CFrame.new(0, 1.3, -1.22), rgb(40, 40, 40), M.Glass, nc())
	P(m, "Handle", Vector3.new(2, 0.12, 0.12), base * CFrame.new(0, 2.25, -1.32), Props.STEEL, M.Metal, nc())
	for _, x in { -0.7, 0.7 } do
		for _, z in { -0.5, 0.5 } do
			C(m, "Burner", 0.06, 0.8, base * CFrame.new(x, 3.03, z), rgb(30, 30, 30), M.Metal, nc())
		end
	end
	P(m, "Backsplash", Vector3.new(3, 0.8, 0.2), base * CFrame.new(0, 3.4, 1.1), rgb(220, 220, 214), M.Metal)
	return m
end

function Props.fridge(parent, cf: CFrame)
	local m = model(parent, "Fridge")
	local base = cf * CFrame.new(0, 0, -0.05 - 1.3)
	P(m, "Body", Vector3.new(3, 7, 2.6), base * CFrame.new(0, 3.5, 0), rgb(214, 212, 204), M.Metal)
	P(m, "Seam", Vector3.new(2.9, 0.08, 0.05), base * CFrame.new(0, 4.8, -1.32), rgb(120, 120, 120), M.SmoothPlastic, nc())
	for _, y in { 3, 6 } do
		P(m, "Handle", Vector3.new(0.15, 1.2, 0.15), base * CFrame.new(1.15, y, -1.4), Props.STEEL, M.Metal, nc())
	end
	return m
end

function Props.washer(parent, cf: CFrame)
	local m = model(parent, "Washer")
	local base = cf * CFrame.new(0, 0, -0.05 - 1.3)
	P(m, "Body", Vector3.new(2.8, 3.2, 2.6), base * CFrame.new(0, 1.6, 0), rgb(226, 226, 222), M.Metal)
	C(m, "Porthole", 0.1, 1.8, base * CFrame.new(0, 1.5, -1.32) * CFrame.Angles(math.pi / 2, 0, 0), rgb(60, 70, 80), M.Glass, nc())
	C(m, "Ring", 0.08, 2.1, base * CFrame.new(0, 1.5, -1.31) * CFrame.Angles(math.pi / 2, 0, 0), Props.STEEL, M.Metal, nc())
	P(m, "Panel", Vector3.new(2.6, 0.5, 0.06), base * CFrame.new(0, 2.9, -1.32), rgb(60, 60, 64), M.SmoothPlastic, nc())
	return m
end

function Props.crate(parent, cf: CFrame, s: number?)
	local size = s or 3
	local m = model(parent, "Crate")
	P(m, "Box", Vector3.new(size, size, size), cf * CFrame.new(0, size / 2, 0), rgb(128, 96, 60), M.WoodPlanks)
	for _, y in { 0.2, size - 0.2 } do
		P(m, "Band", Vector3.new(size + 0.06, 0.25, size + 0.06), cf * CFrame.new(0, y, 0), rgb(84, 62, 40), M.Wood, nc())
	end
	return m
end

-- стеллаж с коробками
function Props.rack(parent, cf: CFrame, w: number, seed: number)
	local m = model(parent, "Rack")
	local d, h = 2.2, 8
	local base = cf * CFrame.new(0, 0, -0.05 - d / 2)
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			P(m, "Post", Vector3.new(0.25, h, 0.25), base * CFrame.new(sx * (w / 2 - 0.125), h / 2, sz * (d / 2 - 0.125)), rgb(150, 90, 40), M.Metal)
		end
	end
	for k = 0, 3 do
		local y = 0.4 + k * 2.4
		P(m, "Shelf", Vector3.new(w - 0.5, 0.12, d - 0.1), base * CFrame.new(0, y, 0), rgb(110, 110, 112), M.DiamondPlate)
		if k &lt; 3 then
			for b = 0, 1 do
				if (seed + k + b) % 3 ~= 0 then
					local bs = 1.3 + ((seed + k * 2 + b) % 3) * 0.2
					P(m, "Box", Vector3.new(bs, bs * 0.8, bs), base * CFrame.new((b - 0.5) * (w / 2), y + 0.06 + bs * 0.4, 0), rgb(160, 126, 84), M.Cardboard, nc())
				end
			end
		end
	end
	return m
end

-- скамья у стены (cf у стены, сидящие смотрят в комнату)
function Props.bench(parent, cf: CFrame, w: number)
	local m = model(parent, "Bench")
	local base = cf * CFrame.new(0, 0, -0.05 - 0.9)
	P(m, "Seat", Vector3.new(w, 0.3, 1.8), base * CFrame.new(0, 1.75, 0), Props.WOOD, M.Wood)
	P(m, "Back", Vector3.new(w, 1.6, 0.25), base * CFrame.new(0, 2.8, 0.76), Props.WOOD, M.Wood)
	for _, s in { -1, 1 } do
		P(m, "Leg", Vector3.new(0.3, 1.6, 1.5), base * CFrame.new(s * (w / 2 - 0.4), 0.8, 0), Props.IRON, M.Metal)
	end
	return m
end

function Props.pillar(parent, cf: CFrame, h: number, color: Color3?)
	local m = model(parent, "Pillar")
	local c = color or rgb(150, 140, 126)
	P(m, "Shaft", Vector3.new(2.2, h - 1.6, 2.2), cf * CFrame.new(0, h / 2, 0), c, M.Limestone)
	P(m, "Base", Vector3.new(3, 0.8, 3), cf * CFrame.new(0, 0.4, 0), c:Lerp(rgb(0, 0, 0), 0.2), M.Limestone)
	P(m, "Cap", Vector3.new(3, 0.8, 3), cf * CFrame.new(0, h - 0.4, 0), c:Lerp(rgb(0, 0, 0), 0.2), M.Limestone)
	return m
end

function Props.plantPot(parent, cf: CFrame)
	local m = model(parent, "PlantPot")
	C(m, "Pot", 1.6, 1.6, cf * CFrame.new(0, 0.8, 0), rgb(140, 76, 54), M.Brick)
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2
		P(m, "Leaf", Vector3.new(0.45, 2.4, 0.1), cf * CFrame.new(math.cos(a) * 0.45, 2.7, math.sin(a) * 0.45) * CFrame.Angles(math.sin(a) * 0.45, 0, math.cos(a) * 0.45), rgb(52, 92, 50), M.Grass, nc())
	end
	return m
end

function Props.piano(parent, cf: CFrame)
	local m = model(parent, "Piano")
	local base = cf * CFrame.new(0, 0, -0.05 - 1.1)
	P(m, "Body", Vector3.new(5.4, 4.4, 2.2), base * CFrame.new(0, 2.2, 0), rgb(20, 18, 18), M.Wood)
	P(m, "KeyBed", Vector3.new(5, 0.3, 1), base * CFrame.new(0, 2.6, -1.6), rgb(20, 18, 18), M.Wood)
	P(m, "Keys", Vector3.new(4.6, 0.08, 0.8), base * CFrame.new(0, 2.79, -1.6), rgb(240, 236, 226), M.SmoothPlastic, nc())
	for _, x in { -2.2, 2.2 } do
		P(m, "Cheek", Vector3.new(0.3, 2.45, 1), base * CFrame.new(x, 1.225, -1.6), rgb(20, 18, 18), M.Wood)
	end
	return m
end

function Props.rug(parent, cf: CFrame, w: number, d: number, color: Color3)
	local m = model(parent, "Rug")
	P(m, "Rug", Vector3.new(w, 0.05, d), cf * CFrame.new(0, 0.03, 0), color, M.Carpet, nc())
	P(m, "Border", Vector3.new(w - 1, 0.06, d - 1), cf * CFrame.new(0, 0.035, 0), color:Lerp(rgb(0, 0, 0), 0.25), M.Carpet, nc())
	P(m, "Field", Vector3.new(w - 1.6, 0.07, d - 1.6), cf * CFrame.new(0, 0.04, 0), color, M.Carpet, nc())
	return m
end

-- картина на стене: cf на стене, LookVector в комнату. Сюжет — простые пятна
function Props.painting(parent, cf: CFrame, w: number, h: number, seed: number)
	local m = model(parent, "Painting")
	local base = cf * CFrame.new(0, 0, -0.12)
	P(m, "Frame", Vector3.new(w + 0.5, h + 0.5, 0.15), base, Props.BRASS:Lerp(rgb(0, 0, 0), 0.35), M.Wood, nc())
	local hue = (seed * 0.137) % 1
	P(m, "Canvas", Vector3.new(w, h, 0.04), base * CFrame.new(0, 0, -0.09), Color3.fromHSV(hue, 0.3, 0.28), M.SmoothPlastic, nc())
	if seed % 3 == 0 then
		-- портрет: тёмный силуэт с бледным лицом
		P(m, "Figure", Vector3.new(w * 0.4, h * 0.5, 0.03), base * CFrame.new(0, -h * 0.2, -0.12), rgb(20, 18, 20), M.SmoothPlastic, nc())
		S(m, "Face", math.min(w, h) * 0.22, base * CFrame.new(0, h * 0.15, -0.13), rgb(200, 190, 170), M.SmoothPlastic, nc())
	else
		P(m, "Hill", Vector3.new(w, h * 0.35, 0.03), base * CFrame.new(0, -h * 0.32, -0.12), Color3.fromHSV((hue + 0.3) % 1, 0.35, 0.22), M.SmoothPlastic, nc())
		S(m, "Moon", math.min(w, h) * 0.18, base * CFrame.new(w * 0.25, h * 0.25, -0.13), rgb(210, 200, 170), M.SmoothPlastic, nc({ Shape = BALL }))
	end
	return m
end

-- окно в пустоту: рама с переплётом и тёмное стекло ровно в проёме стены.
-- cf — центр проёма на середине стены, LookVector в комнату
Props.WINDOW = { w = 4, h = 5, y = 4.5 }
function Props.window(parent, cf: CFrame, thick: number)
	local m = model(parent, "Window")
	local w, h = Props.WINDOW.w, Props.WINDOW.h
	local frame = Props.WOOD_DARK
	local glass = P(m, "Glass", Vector3.new(w - 0.12, h - 0.12, 0.1), cf, rgb(6, 8, 12), M.Glass, { Transparency = 0.1, Reflectance = 0.15 })
	CollectionService:AddTag(glass, "VoidWindow")
	for _, s in { -1, 1 } do
		-- рама заходит в проём на 0.05, чтобы её грани не совпадали с краями проёма
		P(m, "Jamb", Vector3.new(0.3, h, thick + 0.3), cf * CFrame.new(s * (w / 2 + 0.1), 0, 0), frame, M.Wood)
	end
	P(m, "Lintel", Vector3.new(w + 0.6, 0.3, thick + 0.2), cf * CFrame.new(0, h / 2 + 0.12, 0), frame, M.Wood)
	P(m, "Sill", Vector3.new(w + 1, 0.3, thick + 0.7), cf * CFrame.new(0, -h / 2 - 0.12, -0.3), frame, M.Wood)
	P(m, "Mullion", Vector3.new(0.15, h, 0.2), cf * CFrame.new(0, 0, -0.16), frame, M.Wood, nc())
	P(m, "Transom", Vector3.new(w, 0.15, 0.16), cf * CFrame.new(0, h / 6, -0.16), frame, M.Wood, nc())
	return m
end

-- свет -----------------------------------------------------------------------

-- бра на стене: cf на стене, LookVector в комнату
function Props.sconce(parent, cf: CFrame)
	local m = model(parent, "Sconce")
	P(m, "Plate", Vector3.new(0.6, 1, 0.1), cf * CFrame.new(0, 0, -0.06), Props.BRASS, M.Metal, nc())
	P(m, "Arm", Vector3.new(0.15, 0.15, 0.7), cf * CFrame.new(0, -0.1, -0.45), Props.BRASS, M.Metal, nc())
	local shade = C(m, "Shade", 0.8, 0.9, cf * CFrame.new(0, 0.3, -0.85), rgb(250, 214, 160), M.Neon, nc({ Transparency = 0.3 }))
	light(shade, 14, 0.7, nil, false)
	CollectionService:AddTag(shade, "LabLight")
	return m, shade
end

-- плафон под потолком. pos — точка на потолке
function Props.ceilingLamp(parent, pos: Vector3)
	local m = model(parent, "CeilingLamp")
	C(m, "Rod", 1.2, 0.12, CFrame.new(pos - Vector3.new(0, 0.6, 0)), Props.IRON, M.Metal, nc())
	C(m, "Cap", 0.25, 0.9, CFrame.new(pos - Vector3.new(0, 1.3, 0)), Props.BRASS, M.Metal, nc())
	local bulb = C(m, "Globe", 1, 1.5, CFrame.new(pos - Vector3.new(0, 1.92, 0)), rgb(255, 230, 186), M.Neon, nc({ Transparency = 0.15 }))
	light(bulb, 24, 1.1)
	CollectionService:AddTag(bulb, "LabLight")
	return m, bulb
end

-- люстра с рожками. pos — точка на потолке
function Props.chandelier(parent, pos: Vector3, drop: number)
	local m = model(parent, "Chandelier")
	C(m, "Chain", drop, 0.15, CFrame.new(pos - Vector3.new(0, drop / 2, 0)), Props.IRON, M.Metal, nc())
	local hub = pos - Vector3.new(0, drop + 0.4, 0)
	C(m, "Hub", 0.8, 0.9, CFrame.new(hub), Props.BRASS, M.Metal, nc())
	local glow
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2
		local tip = hub + Vector3.new(math.cos(a) * 1.8, 0.3, math.sin(a) * 1.8)
		rod(m, "Arm", hub, tip, 0.12, Props.BRASS, M.Metal, nc())
		C(m, "Candle", 0.6, 0.25, CFrame.new(tip + Vector3.new(0, 0.3, 0)), rgb(240, 232, 210), M.SmoothPlastic, nc())
		local fl = S(m, "Flame", 0.22, CFrame.new(tip + Vector3.new(0, 0.7, 0)), rgb(255, 190, 100), M.Neon, nc())
		glow = glow or fl
	end
	local core = S(m, "Glow", 0.3, CFrame.new(hub), rgb(255, 210, 150), M.Neon, nc({ Transparency = 1 }))
	light(core, 32, 1.3)
	CollectionService:AddTag(core, "LabLight")
	return m, core
end

-- настольная лампа (на тумбе или столе). cf — точка на поверхности
function Props.tableLamp(parent, cf: CFrame)
	local m = model(parent, "TableLamp")
	C(m, "Base", 0.15, 0.7, cf * CFrame.new(0, 0.08, 0), Props.BRASS, M.Metal, nc())
	C(m, "Stem", 1, 0.12, cf * CFrame.new(0, 0.65, 0), Props.BRASS, M.Metal, nc())
	local shade = C(m, "Shade", 0.8, 1.1, cf * CFrame.new(0, 1.45, 0), rgb(240, 214, 168), M.Neon, nc({ Transparency = 0.3 }))
	light(shade, 10, 0.6, nil, false)
	CollectionService:AddTag(shade, "LabLight")
	return m, shade
end

-- аварийная красная лампа
function Props.emergencyLamp(parent, pos: Vector3)
	local m = model(parent, "EmergencyLamp")
	P(m, "Base", Vector3.new(1, 0.2, 0.6), CFrame.new(pos), Props.IRON, M.Metal, nc())
	local glow = P(m, "Glow", Vector3.new(0.8, 0.4, 0.4), CFrame.new(pos - Vector3.new(0, 0.3, 0)), rgb(200, 30, 24), M.Neon, nc())
	local l = Instance.new("PointLight")
	l.Range = 18
	l.Brightness = 0.6
	l.Color = rgb(255, 40, 30)
	l.Shadows = false
	l.Parent = glow
	return m
end

-- трубы под потолком
function Props.pipes(parent, a: Vector3, b: Vector3, count: number)
	local m = model(parent, "Pipes")
	for k = 0, count - 1 do
		local off = Vector3.new(0, -k * 0.7, 0)
		local p = rod(m, "Pipe", a + off, b + off, 0.5, if k % 2 == 0 then rgb(96, 88, 76) else rgb(120, 70, 50), M.Metal, nc())
		p.Shape = Enum.PartType.Block
	end
	return m
end

-- ---------------------------------------------------------------------------
-- предмет на виду (ключ, деталь); всё остальное лежит в ящиках

function Props.pickup(parent, cf: CFrame, item: string)
	local m = model(parent, "Pickup")
	local root
	if item == "key" then
		root = P(m, "Key", Vector3.new(1.3, 0.12, 0.35), cf * CFrame.new(0, 0.07, 0), Props.BRASS, M.Metal)
		C(m, "Bow", 0.12, 0.7, cf * CFrame.new(-0.85, 0.07, 0), Props.BRASS, M.Metal, nc())
		P(m, "Bit", Vector3.new(0.25, 0.1, 0.35), cf * CFrame.new(0.55, 0.07, 0.25), Props.BRASS, M.Metal, nc())
		local l = Instance.new("PointLight")
		l.Range = 5
		l.Brightness = 0.5
		l.Color = rgb(255, 220, 140)
		l.Parent = root
	elseif item == "fuse" then
		root = C(m, "Fuse", 1.4, 0.7, cf * CFrame.new(0, 0.75, 0), rgb(60, 110, 170), M.Glass)
		for _, y in { 0.1, 1.4 } do
			C(m, "Cap", 0.2, 0.8, cf * CFrame.new(0, y, 0), Props.BRASS, M.Metal, nc())
		end
		local l = Instance.new("PointLight")
		l.Range = 7
		l.Brightness = 0.7
		l.Color = rgb(120, 180, 255)
		l.Parent = root
	elseif item == "battery" then
		root = C(m, "Battery", 1, 0.5, cf * CFrame.new(0, 0.5, 0), rgb(40, 130, 60), M.Metal)
		C(m, "Tip", 0.12, 0.25, cf * CFrame.new(0, 1.06, 0), rgb(200, 200, 200), M.Metal, nc())
	elseif item == "plant" then
		root = C(m, "Sprout", 0.6, 0.8, cf * CFrame.new(0, 0.3, 0), rgb(140, 76, 54), M.Brick)
		S(m, "Leaves", 0.9, cf * CFrame.new(0, 0.95, 0), rgb(80, 170, 90), M.Grass, nc())
	elseif item == "meat" then
		root = P(m, "Meat", Vector3.new(1.3, 0.6, 0.9), cf * CFrame.new(0, 0.3, 0), rgb(150, 40, 40), M.SmoothPlastic)
		C(m, "Bone", 1.9, 0.2, cf * CFrame.new(0, 0.3, 0) * CFrame.Angles(0, 0, math.pi / 2), rgb(230, 224, 204), M.SmoothPlastic, nc())
		P(m, "Fat", Vector3.new(1.34, 0.12, 0.94), cf * CFrame.new(0, 0.5, 0), rgb(220, 190, 170), M.SmoothPlastic, nc())
	elseif item == "hammer" then
		root = P(m, "Handle", Vector3.new(0.2, 0.2, 1.6), cf * CFrame.new(0, 0.12, 0), Props.WOOD, M.Wood)
		P(m, "Head", Vector3.new(0.9, 0.4, 0.4), cf * CFrame.new(0, 0.22, -0.8), rgb(90, 92, 96), M.Metal, nc())
	elseif item == "lockpick" then
		root = P(m, "Pick", Vector3.new(1.2, 0.08, 0.15), cf * CFrame.new(0, 0.05, 0), rgb(170, 170, 176), M.Metal)
		P(m, "Grip", Vector3.new(0.4, 0.12, 0.3), cf * CFrame.new(-0.6, 0.07, 0), rgb(40, 40, 40), M.SmoothPlastic, nc())
	elseif item == "pole" then
		-- длинный шест с крюком: лежит на полу или прислонён
		root = C(m, "Pole", 9, 0.3, cf * CFrame.new(0, 0.15, 0) * CFrame.Angles(0, 0, math.pi / 2), Props.WOOD, M.Wood)
		P(m, "Hook", Vector3.new(0.2, 0.9, 0.2), cf * CFrame.new(4.6, 0.55, 0), Props.IRON, M.Metal, nc())
		P(m, "HookTip", Vector3.new(0.6, 0.2, 0.26), cf * CFrame.new(4.35, 0.95, 0), Props.IRON, M.Metal, nc())
	elseif item == "lens" then
		root = C(m, "Lens", 0.2, 1.8, cf * CFrame.new(0, 0.12, 0), rgb(200, 220, 230), M.Glass, { Reflectance = 0.6 })
		C(m, "Rim", 0.14, 2.06, cf * CFrame.new(0, 0.07, 0), Props.BRASS, M.Metal, nc())
		local l = Instance.new("PointLight")
		l.Range = 6
		l.Brightness = 0.5
		l.Color = rgb(200, 230, 255)
		l.Parent = root
	elseif item == "coldkey" then
		root = P(m, "Key", Vector3.new(1.4, 0.14, 0.4), cf * CFrame.new(0, 0.08, 0), rgb(120, 170, 200), M.Metal)
		C(m, "Tag", 0.08, 0.8, cf * CFrame.new(-0.95, 0.06, 0), rgb(200, 230, 255), M.SmoothPlastic, nc())
		P(m, "Bit", Vector3.new(0.3, 0.12, 0.4), cf * CFrame.new(0.5, 0.08, 0.3), rgb(120, 170, 200), M.Metal, nc())
		local l = Instance.new("PointLight")
		l.Range = 6
		l.Brightness = 0.7
		l.Color = rgb(150, 210, 255)
		l.Parent = root
	elseif item == "clockkey" then
		root = Props.clockKey(m, cf * CFrame.new(0, 0.3, 0))
	else
		-- стопка монет
		root = C(m, "Coins", 0.3, 0.9, cf * CFrame.new(0, 0.15, 0), rgb(226, 186, 70), M.Metal)
		C(m, "Coin", 0.12, 0.9, cf * CFrame.new(0.3, 0.36, 0.1), rgb(226, 186, 70), M.Metal, nc())
	end
	root:SetAttribute("Item", item)
	Props.prompt(root, "pick", 0, 7)
	return m, root
end

-- ключ-часы: круглый чёрный корпус с золотым ободом, светлый циферблат, чёрные
-- стрелки и деления; снизу бородка ключа. cf — центр, циферблат смотрит вверх
function Props.clockKey(parent, cf: CFrame)
	local body = C(parent, "ClockBody", 0.5, 1.6, cf, rgb(24, 22, 22), M.Metal)
	C(parent, "Rim", 0.4, 1.8, cf * CFrame.new(0, -0.02, 0), rgb(214, 170, 70), M.Metal, nc())
	C(parent, "Dial", 0.06, 1.3, cf * CFrame.new(0, 0.27, 0), rgb(244, 236, 214), M.SmoothPlastic, nc())
	for k = 0, 11 do
		local a = k / 12 * math.pi * 2
		P(parent, "Mark", Vector3.new(0.05, 0.04, if k % 3 == 0 then 0.2 else 0.1), cf * CFrame.new(math.sin(a) * 0.52, 0.31, -math.cos(a) * 0.52) * CFrame.Angles(0, -a, 0), rgb(20, 20, 20), M.SmoothPlastic, nc())
	end
	P(parent, "HandH", Vector3.new(0.06, 0.04, 0.34), cf * CFrame.new(0.08, 0.33, -0.12) * CFrame.Angles(0, -0.6, 0), rgb(16, 16, 16), M.Metal, nc())
	P(parent, "HandM", Vector3.new(0.04, 0.04, 0.5), cf * CFrame.new(-0.1, 0.34, -0.2) * CFrame.Angles(0, 0.5, 0), rgb(16, 16, 16), M.Metal, nc())
	P(parent, "Stem", Vector3.new(0.2, 0.2, 1.1), cf * CFrame.new(0, 0, 1.3), rgb(214, 170, 70), M.Metal, nc())
	P(parent, "Bit", Vector3.new(0.5, 0.16, 0.24), cf * CFrame.new(0.2, 0, 1.75), rgb(214, 170, 70), M.Metal, nc())
	local l = Instance.new("PointLight")
	l.Range = 8
	l.Brightness = 0.8
	l.Color = rgb(255, 220, 150)
	l.Parent = body
	return body
end

-- генератор для зала Слепого
function Props.generator(parent, cf: CFrame)
	local m = model(parent, "Generator")
	local body = P(m, "Body", Vector3.new(5, 4, 3.4), cf * CFrame.new(0, 2.2, 0), rgb(82, 90, 86), M.DiamondPlate)
	P(m, "Skid", Vector3.new(5.6, 0.4, 3.8), cf * CFrame.new(0, 0.2, 0), rgb(40, 40, 40), M.Metal)
	P(m, "Panel", Vector3.new(2.6, 1.8, 0.1), cf * CFrame.new(-0.8, 2.6, -1.76), rgb(30, 32, 30), M.Metal, nc())
	for k = 0, 2 do
		C(m, "Gauge", 0.1, 0.5, cf * CFrame.new(-1.6 + k * 0.8, 3, -1.82) * CFrame.Angles(math.pi / 2, 0, 0), rgb(230, 226, 210), M.SmoothPlastic, nc())
	end
	local lamp = S(m, "StatusLamp", 0.6, cf * CFrame.new(1.7, 4.5, -1.2), rgb(220, 40, 30), M.Neon, nc())
	local l = Instance.new("PointLight")
	l.Range = 10
	l.Brightness = 1
	l.Color = rgb(255, 60, 40)
	l.Parent = lamp
	C(m, "Exhaust", 2.6, 0.6, cf * CFrame.new(1.8, 5.4, 0.9), rgb(60, 60, 64), M.Metal)
	P(m, "Socket", Vector3.new(0.9, 0.9, 0.2), cf * CFrame.new(1.4, 2.4, -1.78), rgb(20, 20, 20), M.Metal, nc())
	local sparks = Instance.new("ParticleEmitter")
	sparks.Name = "Sparks"
	sparks.Rate = 0
	sparks.Speed = NumberRange.new(6, 12)
	sparks.Lifetime = NumberRange.new(0.2, 0.5)
	sparks.Size = NumberSequence.new(0.2, 0)
	sparks.Color = ColorSequence.new(rgb(255, 210, 120))
	sparks.LightEmission = 1
	sparks.Parent = body
	Props.prompt(body, "repair", 3, 8)
	return m, body, lamp
end
-- ---------------------------------------------------------------------------
-- музей: постаменты, статуи, витрины, странные экспонаты

local MARBLE = rgb(214, 210, 200)
Props.MARBLE = MARBLE

-- постамент; возвращает кадр верхней грани
function Props.plinth(parent, cf: CFrame, w: number, h: number, color: Color3?)
	local m = model(parent, "Plinth")
	local c = color or rgb(150, 146, 138)
	P(m, "Foot", Vector3.new(w + 0.4, 0.4, w + 0.4), cf * CFrame.new(0, 0.2, 0), c:Lerp(rgb(0, 0, 0), 0.2), M.Marble)
	P(m, "Shaft", Vector3.new(w, h - 0.8, w), cf * CFrame.new(0, h / 2, 0), c, M.Marble)
	P(m, "Cap", Vector3.new(w + 0.3, 0.4, w + 0.3), cf * CFrame.new(0, h - 0.2, 0), c:Lerp(rgb(0, 0, 0), 0.2), M.Marble)
	return m, cf * CFrame.new(0, h, 0)
end

-- странный экспонат размером около s (все детали без столкновений). top — где стоит
local ODD = { "wrench", "gear", "teapot", "skull", "crown", "mask", "clock", "boot", "bottle", "gem", "bulb", "bigkey" }
Props.ODD = ODD
function Props.oddity(parent, top: CFrame, item: string, s: number?)
	local k = s or 1
	local m = model(parent, "Exhibit_" .. item)
	local steel = rgb(150, 154, 158)
	local function b(name, sx, sy, sz, ocf, color, mat)
		return P(m, name, Vector3.new(sx * k, sy * k, sz * k), top * CFrame.new(ocf.Position * k) * ocf.Rotation, color, mat, nc())
	end
	local function c(name, len, d, ocf, color, mat)
		return C(m, name, len * k, d * k, top * CFrame.new(ocf.Position * k) * ocf.Rotation, color, mat, nc())
	end
	local function ball(name, d, ocf, color, mat)
		return S(m, name, d * k, top * CFrame.new(ocf.Position * k), color, mat, nc())
	end
	if item == "wrench" then
		b("Handle", 0.3, 0.14, 1.5, CFrame.new(0, 0.12, 0), steel, M.Metal)
		for _, e in { -1, 1 } do
			b("Jaw", 0.2, 0.2, 0.45, CFrame.new(0.22, 0.12, e * 0.9), steel, M.Metal)
			b("Jaw", 0.2, 0.2, 0.45, CFrame.new(-0.22, 0.12, e * 0.9), steel, M.Metal)
		end
	elseif item == "gear" then
		c("Wheel", 0.2, 1.1, CFrame.new(0, 0.75, 0) * CFrame.Angles(math.pi / 2, 0, 0), rgb(150, 110, 60), M.Metal)
		for t = 0, 7 do
			b("Tooth", 0.22, 0.26, 0.2, CFrame.new(0, 0.75, 0) * CFrame.Angles(0, 0, t * math.pi / 4) * CFrame.new(0, 0.62, 0), rgb(150, 110, 60), M.Metal)
		end
		c("Stand", 0.2, 0.2, CFrame.new(0, 0.1, 0), Props.IRON, M.Metal)
	elseif item == "teapot" then
		ball("Body", 0.9, CFrame.new(0, 0.5, 0), rgb(200, 210, 220), M.SmoothPlastic)
		c("Lid", 0.12, 0.4, CFrame.new(0, 0.95, 0), rgb(60, 90, 150), M.SmoothPlastic)
		b("Spout", 0.14, 0.14, 0.5, CFrame.new(0, 0.6, -0.6) * CFrame.Angles(0.5, 0, 0), rgb(200, 210, 220), M.SmoothPlastic)
		b("Handle", 0.1, 0.5, 0.1, CFrame.new(0, 0.5, 0.55), rgb(200, 210, 220), M.SmoothPlastic)
	elseif item == "skull" then
		ball("Cranium", 0.9, CFrame.new(0, 0.6, 0), rgb(222, 214, 190), M.SmoothPlastic)
		b("Jaw", 0.55, 0.3, 0.5, CFrame.new(0, 0.2, -0.15), rgb(222, 214, 190), M.SmoothPlastic)
		for _, x in { -0.2, 0.2 } do
			ball("Socket", 0.24, CFrame.new(x, 0.62, -0.38), rgb(20, 16, 14), M.SmoothPlastic)
		end
	elseif item == "crown" then
		c("Band", 0.3, 0.9, CFrame.new(0, 0.25, 0), Props.BRASS, M.Metal)
		for t = 0, 4 do
			local a = t / 5 * math.pi * 2
			b("Point", 0.14, 0.45, 0.14, CFrame.new(math.cos(a) * 0.38, 0.6, math.sin(a) * 0.38), Props.BRASS, M.Metal)
			ball("Jewel", 0.14, CFrame.new(math.cos(a) * 0.38, 0.88, math.sin(a) * 0.38), rgb(190, 30, 50), M.Neon)
		end
	elseif item == "mask" then
		c("Face", 0.1, 1, CFrame.new(0, 0.75, 0) * CFrame.Angles(math.pi / 2, 0, 0), rgb(226, 220, 204), M.SmoothPlastic)
		for _, x in { -0.2, 0.2 } do
			b("Eye", 0.2, 0.1, 0.05, CFrame.new(x, 0.85, -0.07), rgb(0, 0, 0), M.SmoothPlastic)
		end
		b("Mouth", 0.36, 0.06, 0.05, CFrame.new(0, 0.5, -0.07), rgb(0, 0, 0), M.SmoothPlastic)
		c("Stand", 0.25, 0.14, CFrame.new(0, 0.12, 0), Props.IRON, M.Metal)
	elseif item == "clock" then
		c("Case", 0.25, 1, CFrame.new(0, 0.6, 0) * CFrame.Angles(math.pi / 2, 0, 0), Props.WOOD_DARK, M.Wood)
		c("Dial", 0.05, 0.8, CFrame.new(0, 0.6, -0.14) * CFrame.Angles(math.pi / 2, 0, 0), rgb(236, 230, 210), M.SmoothPlastic)
		b("Hand", 0.05, 0.34, 0.03, CFrame.new(0, 0.74, -0.18), rgb(20, 20, 20), M.SmoothPlastic)
		b("Hand", 0.24, 0.05, 0.03, CFrame.new(0.13, 0.6, -0.2), rgb(20, 20, 20), M.SmoothPlastic)
	elseif item == "boot" then
		b("Shaft", 0.4, 0.8, 0.45, CFrame.new(0, 0.55, 0.15), rgb(70, 46, 30), M.Leather)
		b("Foot", 0.45, 0.3, 0.9, CFrame.new(0, 0.23, -0.1), rgb(70, 46, 30), M.Leather)
		b("Sole", 0.5, 0.08, 1, CFrame.new(0, 0.04, -0.1), rgb(20, 18, 16), M.SmoothPlastic)
	elseif item == "bottle" then
		c("Body", 0.8, 0.45, CFrame.new(0, 0.4, 0), rgb(40, 90, 60), M.Glass)
		c("Neck", 0.4, 0.18, CFrame.new(0, 1, 0), rgb(40, 90, 60), M.Glass)
		c("Cork", 0.12, 0.2, CFrame.new(0, 1.25, 0), rgb(150, 110, 70), M.Wood)
	elseif item == "gem" then
		b("Gem", 0.6, 0.6, 0.6, CFrame.new(0, 0.6, 0) * CFrame.Angles(0.6, 0.8, 0.3), rgb(70, 150, 220), M.Glass)
		b("Pad", 0.9, 0.1, 0.9, CFrame.new(0, 0.05, 0), rgb(90, 20, 30), M.Fabric)
	elseif item == "bulb" then
		ball("Glass", 0.7, CFrame.new(0, 0.75, 0), rgb(240, 236, 210), M.Glass)
		c("Base", 0.35, 0.34, CFrame.new(0, 0.28, 0), steel, M.Metal)
	else
		b("Shank", 0.14, 0.14, 1.2, CFrame.new(0, 0.1, 0), Props.BRASS, M.Metal)
		c("Bow", 0.14, 0.6, CFrame.new(0, 0.1, 0.8), Props.BRASS, M.Metal)
		b("Bit", 0.4, 0.1, 0.2, CFrame.new(0.2, 0.1, -0.45), Props.BRASS, M.Metal)
	end
	return m
end

-- витрина на тумбе: стеклянный колпак, латунные рёбра, внутри экспонат
function Props.displayCase(parent, cf: CFrame, item: string)
	local m = model(parent, "DisplayCase")
	P(m, "Base", Vector3.new(2.6, 2.4, 2.6), cf * CFrame.new(0, 1.2, 0), Props.WOOD_DARK, M.Wood)
	P(m, "Lip", Vector3.new(2.9, 0.2, 2.9), cf * CFrame.new(0, 2.5, 0), Props.BRASS, M.Metal)
	P(m, "Glass", Vector3.new(2.4, 2.6, 2.4), cf * CFrame.new(0, 3.9, 0), rgb(200, 220, 226), M.Glass, { Transparency = 0.8 })
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			P(m, "Edge", Vector3.new(0.12, 2.5, 0.12), cf * CFrame.new(sx * 1.2, 3.9, sz * 1.2), Props.BRASS, M.Metal, nc())
		end
	end
	P(m, "Roof", Vector3.new(2.6, 0.12, 2.6), cf * CFrame.new(0, 5.26, 0), Props.BRASS, M.Metal, nc())
	P(m, "Pad", Vector3.new(1.6, 0.1, 1.6), cf * CFrame.new(0, 2.67, 0), rgb(90, 20, 30), M.Fabric, nc())
	Props.oddity(m, cf * CFrame.new(0, 2.72, 0), item, 1)
	return m
end

-- настенная витрина с полками мелочей (cf у стены)
function Props.wallCase(parent, cf: CFrame, w: number, seed: number)
	local m = model(parent, "WallCase")
	local d = 1.3
	local base = cf * CFrame.new(0, 0, -0.05 - d / 2)
	P(m, "Cabinet", Vector3.new(w, 2.2, d), base * CFrame.new(0, 1.1, 0), Props.WOOD_DARK, M.Wood)
	P(m, "Back", Vector3.new(w, 4.6, 0.15), base * CFrame.new(0, 4.5, d / 2 - 0.075), Props.WOOD_DARK, M.Wood)
	for _, s in { -1, 1 } do
		P(m, "Side", Vector3.new(0.15, 4.6, d - 0.15), base * CFrame.new(s * (w / 2 - 0.075), 4.5, -0.075), Props.WOOD_DARK, M.Wood)
	end
	P(m, "Top", Vector3.new(w + 0.2, 0.2, d + 0.1), base * CFrame.new(0, 6.9, -0.05), Props.WOOD_DARK, M.Wood)
	P(m, "Glass", Vector3.new(w - 0.3, 4.6, 0.06), base * CFrame.new(0, 4.5, -d / 2 + 0.03), rgb(200, 220, 226), M.Glass, { Transparency = 0.8 })
	P(m, "Shelf", Vector3.new(w - 0.3, 0.1, d - 0.3), base * CFrame.new(0, 4.4, -0.03), Props.WOOD, M.Wood, nc())
	local n = math.max(2, math.floor(w / 2))
	for k = 0, n - 1 do
		local x = -w / 2 + (k + 0.5) * w / n
		Props.oddity(m, base * CFrame.new(x, 2.2, 0), ODD[(seed + k * 5) % #ODD + 1], 0.7)
		Props.oddity(m, base * CFrame.new(x, 4.45, 0), ODD[(seed + k * 7 + 3) % #ODD + 1], 0.7)
	end
	return m
end

-- статуя на постаменте: bust, figure, abstract, obelisk, broken
function Props.statue(parent, cf: CFrame, kind: string, seed: number?)
	local m = model(parent, "Statue")
	local _, top = Props.plinth(m, cf, 2.6, 2.6)
	local c = MARBLE
	local function b(name, sx, sy, sz, ocf)
		return P(m, name, Vector3.new(sx, sy, sz), top * ocf, c, M.Marble, nc())
	end
	if kind == "bust" then
		b("Chest", 1.8, 1.1, 1, CFrame.new(0, 0.55, 0))
		C(m, "Neck", 0.5, 0.5, top * CFrame.new(0, 1.3, 0), c, M.Marble, nc())
		S(m, "Head", 1.2, top * CFrame.new(0, 2, 0), c, M.Marble, nc())
		b("Nose", 0.16, 0.3, 0.2, CFrame.new(0, 1.95, -0.62))
	elseif kind == "abstract" then
		b("Cube", 1.6, 1.6, 1.6, CFrame.new(0, 0.8, 0) * CFrame.Angles(0, 0.5, 0))
		b("Cube", 1.1, 1.1, 1.1, CFrame.new(0.1, 2.1, 0) * CFrame.Angles(0.4, 1, 0.3))
		S(m, "Orb", 0.9, top * CFrame.new(-0.1, 3.2, 0.1), c, M.Marble, nc())
	elseif kind == "obelisk" then
		b("Tier", 1.6, 1.6, 1.6, CFrame.new(0, 0.8, 0))
		b("Tier", 1.2, 2, 1.2, CFrame.new(0, 2.6, 0))
		b("Tier", 0.8, 1.6, 0.8, CFrame.new(0, 4.4, 0))
		b("Tip", 0.4, 0.5, 0.4, CFrame.new(0, 5.45, 0) * CFrame.Angles(0, math.pi / 4, 0))
	else
		for _, x in { -0.35, 0.35 } do
			b("Leg", 0.5, 2.2, 0.5, CFrame.new(x, 1.1, 0))
		end
		b("Torso", 1.4, 1.8, 0.8, CFrame.new(0, 3.1, 0))
		Props.rod(m, "Arm", (top * CFrame.new(-0.85, 3.8, 0)).Position, (top * CFrame.new(-1.1, 2.3, -0.3)).Position, 0.34, c, M.Marble, nc())
		if kind ~= "broken" then
			Props.rod(m, "Arm", (top * CFrame.new(0.85, 3.8, 0)).Position, (top * CFrame.new(1.3, 4.9, -0.4)).Position, 0.34, c, M.Marble, nc())
			S(m, "Head", 0.9, top * CFrame.new(0, 4.5, 0), c, M.Marble, nc())
		else
			C(m, "NeckStump", 0.2, 0.4, top * CFrame.new(0, 4.1, 0), c:Lerp(rgb(0, 0, 0), 0.3), M.Marble, nc())
		end
	end
	local _ = seed
	return m
end

-- ваза на тумбе

-- доспех на стойке у стены
function Props.armor(parent, cf: CFrame)
	local m = model(parent, "Armor")
	local base = cf * CFrame.new(0, 0, -0.05 - 1.2)
	local steel = rgb(140, 146, 152)
	C(m, "Base", 0.3, 2.2, base * CFrame.new(0, 0.15, 0), Props.WOOD_DARK, M.Wood)
	P(m, "Torso", Vector3.new(1.8, 2, 1), base * CFrame.new(0, 4, 0), steel, M.Metal)
	for _, x in { -0.45, 0.45 } do
		P(m, "Leg", Vector3.new(0.6, 2.7, 0.6), base * CFrame.new(x, 1.65, 0), steel, M.Metal, nc())
		S(m, "Pauldron", 0.9, base * CFrame.new(x * 2.6, 4.8, 0), steel, M.Metal, nc())
		P(m, "Arm", Vector3.new(0.45, 1.9, 0.45), base * CFrame.new(x * 2.6, 3.6, 0), steel, M.Metal, nc())
	end
	S(m, "Helmet", 1.1, base * CFrame.new(0, 5.7, 0), steel, M.Metal, nc())
	P(m, "Visor", Vector3.new(0.7, 0.14, 0.1), base * CFrame.new(0, 5.75, -0.52), rgb(10, 10, 10), M.SmoothPlastic, nc())
	C(m, "Plume", 0.9, 0.2, base * CFrame.new(0, 6.5, 0.1), rgb(150, 30, 34), M.Fabric, nc())
	C(m, "Spear", 7.5, 0.14, base * CFrame.new(1.5, 3.75, -0.2), Props.WOOD, M.Wood, nc())
	P(m, "SpearTip", Vector3.new(0.3, 0.8, 0.1), base * CFrame.new(1.5, 7.9, -0.2), steel, M.Metal, nc())
	return m
end

-- ограждение: две стойки и бархатный канат
function Props.rope(parent, a: Vector3, b: Vector3)
	local m = model(parent, "Rope")
	for _, p in { a, b } do
		C(m, "Post", 3, 0.22, CFrame.new(p + Vector3.new(0, 1.5, 0)), Props.BRASS, M.Metal, nc())
		C(m, "Foot", 0.12, 1, CFrame.new(p + Vector3.new(0, 0.06, 0)), Props.BRASS, M.Metal, nc())
		S(m, "Knob", 0.4, CFrame.new(p + Vector3.new(0, 3.1, 0)), Props.BRASS, M.Metal, nc())
	end
	local mid = (a + b) / 2 + Vector3.new(0, 2.3, 0)
	Props.rod(m, "Velvet", a + Vector3.new(0, 2.8, 0), mid, 0.16, rgb(120, 20, 30), M.Fabric, nc())
	Props.rod(m, "Velvet", mid, b + Vector3.new(0, 2.8, 0), 0.16, rgb(120, 20, 30), M.Fabric, nc())
	return m
end

-- скелет ископаемого на подиуме. cf — центр, длина вдоль LookVector
function Props.fossil(parent, cf: CFrame, len: number)
	local m = model(parent, "Fossil")
	local bone = rgb(206, 196, 170)
	P(m, "Podium", Vector3.new(8, 0.8, len + 2), cf * CFrame.new(0, 0.4, 0), Props.WOOD_DARK, M.Wood)
	local function pt(x, y, z)
		return (cf * CFrame.new(x, y, z)).Position
	end
	local function bn(a, b, t)
		Props.rod(m, "Bone", a, b, t, bone, M.SmoothPlastic, nc())
	end
	local h = 6.5
	bn(pt(0, h, -len * 0.3), pt(0, h + 0.4, len * 0.15), 0.5)
	bn(pt(0, h + 0.4, len * 0.15), pt(0, h - 2.5, len * 0.5), 0.35)
	bn(pt(0, h, -len * 0.3), pt(0, h + 2.2, -len * 0.42), 0.45)
	P(m, "Skull", Vector3.new(1.4, 1.5, 2.6), cf * CFrame.new(0, h + 2.4, -len * 0.42 - 1.2), bone, M.SmoothPlastic, nc())
	P(m, "Jaw", Vector3.new(1.1, 0.4, 2.2), cf * CFrame.new(0, h + 1.5, -len * 0.42 - 1.3) * CFrame.Angles(0.2, 0, 0), bone, M.SmoothPlastic, nc())
	for k = 0, 6 do
		local z = -len * 0.25 + k * len * 0.055
		for _, s in { -1, 1 } do
			bn(pt(0, h + 0.2, z), pt(s * 1.5, h - 1.2, z), 0.18)
			bn(pt(s * 1.5, h - 1.2, z), pt(s * 0.9, h - 2.8, z), 0.16)
		end
	end
	for _, z in { -len * 0.24, len * 0.1 } do
		for _, s in { -1, 1 } do
			bn(pt(s * 0.9, h - 0.2, z), pt(s * 1.6, h - 3.4, z - 0.6), 0.4)
			bn(pt(s * 1.6, h - 3.4, z - 0.6), pt(s * 1.5, 0.9, z + 0.3), 0.34)
		end
	end
	for _, z in { -len * 0.2, len * 0.1 } do
		C(m, "Support", h - 1, 0.18, cf * CFrame.new(0, 0.8 + (h - 1) / 2, z), Props.BRASS, M.Metal, nc())
	end
	return m
end

-- столик кафе с двумя стульями
function Props.cafeTable(parent, cf: CFrame)
	local m = model(parent, "CafeTable")
	C(m, "Top", 0.2, 3.2, cf * CFrame.new(0, 3, 0), rgb(220, 214, 200), M.Marble)
	C(m, "Stem", 2.8, 0.3, cf * CFrame.new(0, 1.5, 0), Props.IRON, M.Metal)
	C(m, "Foot", 0.15, 1.6, cf * CFrame.new(0, 0.08, 0), Props.IRON, M.Metal, nc())
	Props.chair(m, cf * CFrame.new(-2.7, 0, 0) * CFrame.Angles(0, -math.pi / 2, 0))
	Props.chair(m, cf * CFrame.new(2.7, 0, 0) * CFrame.Angles(0, math.pi / 2, 0))
	C(m, "Cup", 0.3, 0.35, cf * CFrame.new(0.5, 3.25, 0.3), rgb(240, 240, 236), M.SmoothPlastic, nc())
	return m, cf * CFrame.new(-0.4, 3.12, -0.2)
end

-- туалеты: ряд кабинок с унитазами. cf — середина ряда у стены
function Props.toilet(parent, cf: CFrame)
	local white = rgb(236, 236, 232)
	P(parent, "Tank", Vector3.new(1.5, 1.4, 0.6), cf * CFrame.new(0, 2.5, -0.4), white, M.SmoothPlastic)
	P(parent, "TankLid", Vector3.new(1.6, 0.14, 0.7), cf * CFrame.new(0, 3.27, -0.4), white, M.SmoothPlastic, nc())
	C(parent, "Flush", 0.1, 0.25, cf * CFrame.new(0, 3.38, -0.4), Props.STEEL, M.Metal, nc())
	C(parent, "Pedestal", 1, 1, cf * CFrame.new(0, 0.5, -1.2), white, M.SmoothPlastic)
	C(parent, "Bowl", 0.7, 1.5, cf * CFrame.new(0, 1.25, -1.35), white, M.SmoothPlastic)
	C(parent, "BowlFront", 0.66, 1.3, cf * CFrame.new(0, 1.23, -1.75), white, M.SmoothPlastic, nc())
	C(parent, "Seat", 0.1, 1.7, cf * CFrame.new(0, 1.66, -1.5), rgb(250, 250, 248), M.SmoothPlastic, nc())
	C(parent, "Water", 0.04, 1, cf * CFrame.new(0, 1.74, -1.5), rgb(90, 130, 150), M.Glass, nc())
	C(parent, "Pipe", 0.6, 0.18, cf * CFrame.new(0, 1.8, -0.75) * CFrame.Angles(math.pi / 2, 0, 0), white, M.SmoothPlastic, nc())
end

function Props.stallRow(parent, cf: CFrame, n: number)
	local m = model(parent, "Stalls")
	local sw, d, h = 4.6, 5.4, 7.2
	local panel = rgb(120, 136, 128)
	local total = n * sw
	local base = cf * CFrame.new(0, 0, -0.05)
	for k = 0, n do
		local x = -total / 2 + k * sw
		P(m, "Partition", Vector3.new(0.15, h - 0.9, d), base * CFrame.new(x, 0.9 + (h - 0.9) / 2, -d / 2), panel, M.Metal)
		P(m, "Post", Vector3.new(0.25, h + 0.3, 0.25), base * CFrame.new(x, (h + 0.3) / 2, -d - 0.13), rgb(170, 170, 176), M.Metal)
	end
	P(m, "TopRail", Vector3.new(total + 0.2, 0.2, 0.2), base * CFrame.new(0, h + 0.4, -d - 0.13), rgb(170, 170, 176), M.Metal, nc())
	for k = 0, n - 1 do
		local x = -total / 2 + (k + 0.5) * sw
		Props.toilet(m, base * CFrame.new(x, 0, 0))
		-- дверца распахнута внутрь и прижата к перегородке: в кабинку можно зайти
		P(m, "StallDoor", Vector3.new(0.12, h - 1.3, sw - 1), base * CFrame.new(x + sw / 2 - 0.32, 0.9 + (h - 1.3) / 2, -d + (sw - 1) / 2 + 0.1), panel:Lerp(rgb(255, 255, 255), 0.08), M.Metal)
		C(m, "Latch", 0.3, 0.14, base * CFrame.new(x + sw / 2 - 0.45, 3.6, -d + 0.5) * CFrame.Angles(0, 0, math.pi / 2), rgb(170, 170, 176), M.Metal, nc())
		C(m, "PaperRoll", 0.5, 0.5, base * CFrame.new(x - sw / 2 + 0.4, 2.4, -2.6) * CFrame.Angles(0, 0, math.pi / 2), rgb(240, 240, 236), M.SmoothPlastic, nc())
	end
	return m
end

-- столешница с круглыми раковинами и длинным зеркалом
function Props.sinkRow(parent, cf: CFrame, n: number)
	local m = model(parent, "Sinks")
	local w, d = n * 3.2, 2
	local base = cf * CFrame.new(0, 0, -0.05 - d / 2)
	P(m, "Counter", Vector3.new(w, 0.3, d), base * CFrame.new(0, 3, 0), rgb(60, 62, 66), M.Granite)
	P(m, "Apron", Vector3.new(w - 0.4, 2.8, 0.2), base * CFrame.new(0, 1.45, -0.5), rgb(200, 200, 194), M.SmoothPlastic)
	for k = 0, n - 1 do
		local x = -w / 2 + (k + 0.5) * 3.2
		C(m, "Basin", 0.22, 1.7, base * CFrame.new(x, 3.26, -0.1), rgb(240, 240, 236), M.SmoothPlastic, nc())
		C(m, "Drain", 0.04, 1.2, base * CFrame.new(x, 3.38, -0.1), rgb(150, 170, 180), M.Glass, nc())
		C(m, "Tap", 0.7, 0.14, base * CFrame.new(x, 3.5, 0.7), Props.STEEL, M.Metal, nc())
		P(m, "Spout", Vector3.new(0.12, 0.12, 0.6), base * CFrame.new(x, 3.8, 0.45), Props.STEEL, M.Metal, nc())
	end
	P(m, "Mirror", Vector3.new(w - 0.4, 3, 0.1), cf * CFrame.new(0, 6, 0.2), rgb(170, 186, 196), M.Glass, { Reflectance = 0.3 })
	P(m, "MirrorFrame", Vector3.new(w, 3.4, 0.06), cf * CFrame.new(0, 6, 0.27), Props.STEEL, M.Metal, nc())
	-- зеркало разбито: трещины расходятся от места удара, одного осколка нет
	local hitX = w * 0.18
	for k = 0, 6 do
		local a = k * 0.9 + 0.3
		local len = 0.9 + (k % 3) * 0.5
		local from = (cf * CFrame.new(hitX, 6.2, 0.14)).Position
		local to = (cf * CFrame.new(math.clamp(hitX + math.cos(a) * len, -w / 2 + 0.3, w / 2 - 0.3), math.clamp(6.2 + math.sin(a) * len, 4.6, 7.4), 0.14)).Position
		Props.rod(m, "Crack", from, to, 0.04, rgb(30, 34, 38), M.SmoothPlastic, nc())
	end
	P(m, "MissingShard", Vector3.new(0.7, 0.6, 0.03), cf * CFrame.new(hitX - 0.2, 6.1, 0.135) * CFrame.Angles(0, 0, 0.5), rgb(40, 40, 44), M.SmoothPlastic, nc())
	return m
end

-- зеркало на стойке (зал Колосса): поворачивается вокруг стойки
function Props.mirrorStand(parent, cf: CFrame)
	local m = model(parent, "MirrorStand")
	C(m, "Foot", 0.4, 3, cf * CFrame.new(0, 0.2, 0), Props.IRON, M.Metal)
	C(m, "Pole", 3.4, 0.4, cf * CFrame.new(0, 2.1, 0), Props.BRASS, M.Metal)
	local head = model(m, "Head")
	local glass = P(head, "Mirror", Vector3.new(3.6, 4.4, 0.16), cf * CFrame.new(0, 5.6, 0), rgb(190, 206, 214), M.Glass, { Reflectance = 0.55 })
	P(head, "Frame", Vector3.new(4, 4.8, 0.1), cf * CFrame.new(0, 5.6, 0), Props.BRASS, M.Metal, nc())
	C(head, "Yoke", 0.5, 0.5, cf * CFrame.new(0, 3.55, 0), Props.BRASS, M.Metal, nc())
	head.WorldPivot = cf
	return m, head, glass
end

-- улица: дерево и фонарь
function Props.tree(parent, cf: CFrame, h: number, seed: number)
	local m = model(parent, "Tree")
	C(m, "Trunk", h, 1.4 + (seed % 3) * 0.3, cf * CFrame.new(0, h / 2, 0), rgb(54, 40, 30), M.Wood)
	local leaf = rgb(22, 44, 30):Lerp(rgb(34, 60, 36), (seed % 4) / 4)
	S(m, "Crown", 11 + seed % 4, cf * CFrame.new(0, h + 2, 0), leaf, M.Grass, nc())
	S(m, "Crown", 8, cf * CFrame.new(3, h - 1, 2), leaf, M.Grass, nc())
	S(m, "Crown", 7, cf * CFrame.new(-3, h, -2), leaf, M.Grass, nc())
	return m
end

function Props.lampPost(parent, cf: CFrame)
	local m = model(parent, "LampPost")
	C(m, "Pole", 11, 0.4, cf * CFrame.new(0, 5.5, 0), Props.IRON, M.Metal)
	C(m, "Foot", 0.8, 1, cf * CFrame.new(0, 0.4, 0), Props.IRON, M.Metal, nc())
	local glow = P(m, "Lantern", Vector3.new(1, 1.4, 1), cf * CFrame.new(0, 11.7, 0), rgb(255, 214, 150), M.Neon, nc())
	P(m, "Cap", Vector3.new(1.4, 0.2, 1.4), cf * CFrame.new(0, 12.5, 0), Props.IRON, M.Metal, nc())
	local l = Instance.new("PointLight")
	l.Range = 34
	l.Brightness = 1.4
	l.Color = rgb(255, 206, 150)
	l.Parent = glow
	return m
end


-- ---------------------------------------------------------------------------
-- новые залы: часы, музыка, археология, механизмы

local DARKWOOD = rgb(58, 36, 24)

-- циферблат: cf смотрит лицом вперёд (LookVector), r — радиус, h:m — время
local function dialFace(m, cf: CFrame, r: number, h: number, mi: number, face: Color3?)
	local flat = CFrame.Angles(math.pi / 2, 0, 0)
	C(m, "DialRim", 0.12, r * 2 + 0.2, cf * CFrame.new(0, 0, -0.06) * flat, Props.BRASS, M.Metal, nc())
	C(m, "Dial", 0.1, r * 2, cf * CFrame.new(0, 0, -0.1) * flat, face or rgb(240, 232, 210), M.SmoothPlastic, nc())
	for k = 0, 11 do
		local a = k / 12 * math.pi * 2
		P(m, "Mark", Vector3.new(0.06, if k % 3 == 0 then r * 0.22 else r * 0.12, 0.04), cf * CFrame.Angles(0, 0, a) * CFrame.new(0, r * 0.8, -0.17), rgb(20, 20, 20), M.SmoothPlastic, nc())
	end
	local ha = ((h % 12) + mi / 60) / 12 * math.pi * 2
	P(m, "HourHand", Vector3.new(r * 0.1, r * 0.5, 0.04), cf * CFrame.Angles(0, 0, ha) * CFrame.new(0, r * 0.25 - 0.05, -0.2), rgb(16, 16, 16), M.Metal, nc())
	P(m, "MinuteHand", Vector3.new(r * 0.06, r * 0.78, 0.04), cf * CFrame.Angles(0, 0, mi / 60 * math.pi * 2) * CFrame.new(0, r * 0.39 - 0.05, -0.23), rgb(16, 16, 16), M.Metal, nc())
end

-- напольные часы у стены
function Props.grandfatherClock(parent, cf: CFrame, seed: number)
	local m = model(parent, "GrandfatherClock")
	local wood = DARKWOOD:Lerp(rgb(110, 70, 40), (seed % 3) / 3)
	local b = cf * CFrame.new(0, 0, -0.05 - 0.6)
	P(m, "Plinth", Vector3.new(2.3, 0.6, 1.3), b * CFrame.new(0, 0.3, 0.05), wood, M.Wood)
	P(m, "Trunk", Vector3.new(1.8, 4.6, 1.2), b * CFrame.new(0, 2.9, 0), wood, M.Wood)
	P(m, "Hood", Vector3.new(2.2, 2.4, 1.24), b * CFrame.new(0, 6.4, 0.02), wood, M.Wood)
	P(m, "Crown", Vector3.new(2.5, 0.4, 1.36), b * CFrame.new(0, 7.8, 0.06), wood:Lerp(rgb(0, 0, 0), 0.3), M.Wood, nc())
	P(m, "Window", Vector3.new(1, 3, 0.05), b * CFrame.new(0, 3.1, -0.62), rgb(30, 26, 22), M.Glass, nc({ Transparency = 0.2 }))
	P(m, "PendulumRod", Vector3.new(0.06, 2, 0.04), b * CFrame.new(0.1 * ((seed % 3) - 1), 3.6, -0.67), Props.BRASS, M.Metal, nc())
	C(m, "Bob", 0.04, 0.6, b * CFrame.new(0.1 * ((seed % 3) - 1), 2.6, -0.67) * CFrame.Angles(math.pi / 2, 0, 0), Props.BRASS, M.Metal, nc())
	dialFace(m, b * CFrame.new(0, 6.4, -0.6), 0.8, seed % 12, (seed * 7) % 60)
	return m
end

-- часы на стене (cf — точка на стене, лицо в зал)
function Props.wallClock(parent, cf: CFrame, r: number, seed: number)
	local m = model(parent, "WallClock")
	C(m, "Case", 0.24, r * 2 + 0.5, cf * CFrame.new(0, 0, -0.12) * CFrame.Angles(math.pi / 2, 0, 0), DARKWOOD, M.Wood, nc())
	dialFace(m, cf * CFrame.new(0, 0, -0.2), r, seed % 12, (seed * 11) % 60)
	return m
end

-- астрономические часы на тумбе посреди зала
function Props.astroClock(parent, cf: CFrame, seed: number)
	local m = model(parent, "AstroClock")
	P(m, "Base", Vector3.new(3.4, 1, 3.4), cf * CFrame.new(0, 0.5, 0), rgb(80, 60, 40), M.Wood)
	P(m, "Column", Vector3.new(2.2, 4, 2.2), cf * CFrame.new(0, 3, 0), rgb(96, 70, 46), M.Wood)
	P(m, "Head", Vector3.new(3, 3, 3), cf * CFrame.new(0, 6.5, 0), rgb(70, 50, 34), M.Wood)
	for k = 0, 3 do
		local face = cf * CFrame.new(0, 6.5, 0) * CFrame.Angles(0, k * math.pi / 2, 0) * CFrame.new(0, 0, -1.5)
		dialFace(m, face, 1.15, (seed + k * 3) % 12, (seed * 13 + k * 15) % 60, if k % 2 == 0 then rgb(30, 40, 80) else rgb(240, 232, 210))
	end
	S(m, "Dome", 2.6, cf * CFrame.new(0, 8.2, 0), Props.BRASS, M.Metal, nc())
	S(m, "Star", 0.5, cf * CFrame.new(0, 9.7, 0), rgb(255, 214, 120), M.Neon, nc())
	return m
end

-- виолончель или скрипка на подставке
function Props.stringInstrument(parent, cf: CFrame, big: boolean)
	local m = model(parent, "Instrument")
	local k = if big then 1 else 0.55
	local wood = rgb(140, 70, 30)
	local body = cf * CFrame.new(0, 2.4 * k + 0.2, 0) * CFrame.Angles(-0.18, 0, 0)
	local flat = CFrame.Angles(math.pi / 2, 0, 0)
	C(m, "Lower", 0.6 * k, 2.2 * k, body * CFrame.new(0, -0.6 * k, 0) * flat, wood, M.Wood)
	C(m, "Upper", 0.58 * k, 1.7 * k, body * CFrame.new(0, 0.9 * k, 0) * flat, wood, M.Wood)
	P(m, "Waist", Vector3.new(1.3 * k, 0.8 * k, 0.56 * k), body * CFrame.new(0, 0.15 * k, 0), wood, M.Wood)
	P(m, "Neck", Vector3.new(0.24 * k, 2.6 * k, 0.2 * k), body * CFrame.new(0, 2.8 * k, -0.18 * k), rgb(30, 22, 18), M.Wood, nc())
	S(m, "Scroll", 0.4 * k, body * CFrame.new(0, 4.2 * k, -0.18 * k), wood, M.Wood, nc())
	for s = -1, 1, 2 do
		P(m, "Sound", Vector3.new(0.08, 0.6 * k, 0.04), body * CFrame.new(s * 0.4 * k, -0.2 * k, -0.33 * k), rgb(20, 14, 10), M.SmoothPlastic, nc())
	end
	P(m, "Strings", Vector3.new(0.16 * k, 4.2 * k, 0.03), body * CFrame.new(0, 1.2 * k, -0.34 * k), rgb(220, 220, 210), M.Metal, nc())
	-- подставка-тренога
	for a = 0, 2 do
		local ang = a / 3 * math.pi * 2
		rod(m, "Stand", (cf * CFrame.new(0, 1.2 * k, 0.2)).Position, (cf * CFrame.new(math.cos(ang) * 0.9, 0.02, math.sin(ang) * 0.9 + 0.2)).Position, 0.1, Props.IRON, M.Metal, nc())
	end
	return m
end

-- ударная установка
function Props.drumKit(parent, cf: CFrame)
	local m = model(parent, "Drums")
	local red = rgb(150, 30, 34)
	local side = CFrame.Angles(math.pi / 2, 0, 0)
	C(m, "BassDrum", 1.4, 2.4, cf * CFrame.new(0, 1.2, 0) * side, red, M.SmoothPlastic)
	C(m, "BassSkin", 1.44, 2.1, cf * CFrame.new(0, 1.2, 0) * side, rgb(236, 230, 214), M.Fabric, nc())
	for i, p in { { -1.3, 2.9, -0.6, 1.2 }, { 1.3, 2.9, -0.6, 1.3 }, { 2.1, 1.4, 0.6, 1.6 } } do
		C(m, "Tom", 0.9, p[4], cf * CFrame.new(p[1], p[2], p[3]), red, M.SmoothPlastic, nc())
		C(m, "Skin", 0.94, p[4] - 0.12, cf * CFrame.new(p[1], p[2], p[3]), rgb(236, 230, 214), M.Fabric, nc())
		rod(m, "Leg", (cf * CFrame.new(p[1], p[2] - 0.45, p[3])).Position, (cf * CFrame.new(p[1] * 1.1, 0, p[3] + 0.3)).Position, 0.08, Props.IRON, M.Metal, nc())
		local _ = i
	end
	for _, x in { -2.4, 2.6 } do
		rod(m, "CymbalStand", (cf * CFrame.new(x, 0, 0.4)).Position, (cf * CFrame.new(x, 4, 0.4)).Position, 0.08, Props.IRON, M.Metal, nc())
		C(m, "Cymbal", 0.05, 1.8, cf * CFrame.new(x, 4.02, 0.4) * CFrame.Angles(0.15, 0, 0), Props.BRASS, M.Metal, nc())
	end
	C(m, "Stool", 0.4, 1.2, cf * CFrame.new(0, 1.8, 2.2), rgb(30, 30, 30), M.Fabric)
	C(m, "StoolLeg", 1.6, 0.2, cf * CFrame.new(0, 0.8, 2.2), Props.IRON, M.Metal, nc())
	return m
end

-- арфа
function Props.harp(parent, cf: CFrame)
	local m = model(parent, "Harp")
	local gold = rgb(196, 156, 70)
	P(m, "Base", Vector3.new(1.4, 0.4, 1), cf * CFrame.new(0, 0.2, 0), gold, M.Metal)
	local p0 = (cf * CFrame.new(-1.6, 0.4, 0)).Position
	local p1 = (cf * CFrame.new(-1.6, 6.4, 0)).Position
	local p2 = (cf * CFrame.new(0.4, 5.6, 0)).Position
	local p3 = (cf * CFrame.new(1.4, 5.0, 0)).Position
	local p4 = (cf * CFrame.new(0.4, 0.4, 0)).Position
	rod(m, "Pillar", p0, p1, 0.36, gold, M.Metal)
	rod(m, "Neck", p1, p2, 0.3, gold, M.Metal, nc())
	rod(m, "Neck", p2, p3, 0.3, gold, M.Metal, nc())
	rod(m, "Soundboard", p4, p3, 0.6, rgb(150, 96, 50), M.Wood)
	for k = 1, 9 do
		local t = k / 10
		local top = (cf * CFrame.new(-1.6 + t * 3, 6.3 - t * 1.3, 0)).Position
		local bottom = p4:Lerp(p3, t * 0.92 + 0.04)
		if top.Y &gt; bottom.Y + 0.4 then
			rod(m, "String", bottom, top, 0.04, rgb(230, 226, 214), M.Metal, nc())
		end
	end
	return m
end

-- граммофон на столике
function Props.gramophone(parent, cf: CFrame)
	local m = model(parent, "Gramophone")
	for _, x in { -0.8, 0.8 } do
		for _, z in { -0.8, 0.8 } do
			P(m, "Leg", Vector3.new(0.2, 2.6, 0.2), cf * CFrame.new(x, 1.3, z), DARKWOOD, M.Wood, nc())
		end
	end
	P(m, "Top", Vector3.new(2.2, 0.2, 2.2), cf * CFrame.new(0, 2.7, 0), DARKWOOD, M.Wood)
	P(m, "Box", Vector3.new(1.6, 0.8, 1.6), cf * CFrame.new(0, 3.2, 0), rgb(90, 50, 30), M.Wood)
	C(m, "Record", 0.06, 1.4, cf * CFrame.new(0, 3.63, 0), rgb(16, 16, 16), M.SmoothPlastic, nc())
	C(m, "Label", 0.08, 0.4, cf * CFrame.new(0, 3.64, 0), rgb(170, 40, 40), M.SmoothPlastic, nc())
	rod(m, "Arm", (cf * CFrame.new(0.7, 3.7, 0.6)).Position, (cf * CFrame.new(0.5, 4.6, 0.7)).Position, 0.12, Props.BRASS, M.Metal, nc())
	-- раструб: всё шире к краю
	local start = cf * CFrame.new(0.5, 4.7, 0.7)
	for k = 0, 5 do
		local d = 0.3 + k * k * 0.12
		C(m, "Horn", 0.34, d, start * CFrame.Angles(math.rad(-50), 0, 0) * CFrame.new(0, k * 0.32, 0), Props.BRASS, M.Metal, nc())
	end
	return m
end

-- раскоп: дощатая рамка, песок, кости, черепки, сетка из бечёвки, инструменты
function Props.digPit(parent, cf: CFrame, w: number, l: number, seed: number)
	local m = model(parent, "DigPit")
	P(m, "Sand", Vector3.new(w - 0.4, 0.3, l - 0.4), cf * CFrame.new(0, 0.15, 0), rgb(196, 170, 120), M.Sand)
	for _, s in { -1, 1 } do
		P(m, "Board", Vector3.new(0.4, 0.6, l), cf * CFrame.new(s * (w / 2 - 0.2), 0.3, 0), rgb(110, 80, 50), M.WoodPlanks)
		P(m, "Board", Vector3.new(w - 0.8, 0.56, 0.4), cf * CFrame.new(0, 0.28, s * (l / 2 - 0.2)), rgb(110, 80, 50), M.WoodPlanks)
	end
	for k = 1, 3 do
		rod(m, "Grid", (cf * CFrame.new(-w / 2 + 0.2, 0.62, -l / 2 + k * l / 4)).Position, (cf * CFrame.new(w / 2 - 0.2, 0.62, -l / 2 + k * l / 4)).Position, 0.04, rgb(220, 210, 180), M.Fabric, nc())
		rod(m, "Grid", (cf * CFrame.new(-w / 2 + k * w / 4, 0.64, -l / 2 + 0.2)).Position, (cf * CFrame.new(-w / 2 + k * w / 4, 0.64, l / 2 - 0.2)).Position, 0.04, rgb(220, 210, 180), M.Fabric, nc())
	end
	local bone = rgb(226, 216, 190)
	local r = Random.new(seed)
	S(m, "Skull", 0.9, cf * CFrame.new(-w * 0.2, 0.45, -l * 0.15), bone, M.SmoothPlastic, nc())
	for _ = 1, 6 do
		local a = cf * CFrame.new(r:NextNumber(-w * 0.35, w * 0.35), 0.36, r:NextNumber(-l * 0.35, l * 0.35)) * CFrame.Angles(0, r:NextNumber(0, 3), 0)
		P(m, "Bone", Vector3.new(0.22, 0.2, r:NextNumber(0.8, 1.8)), a, bone, M.SmoothPlastic, nc())
	end
	for _ = 1, 5 do
		local a = cf * CFrame.new(r:NextNumber(-w * 0.35, w * 0.35), 0.33, r:NextNumber(-l * 0.35, l * 0.35)) * CFrame.Angles(r:NextNumber(-0.4, 0.4), r:NextNumber(0, 3), 0)
		P(m, "Shard", Vector3.new(r:NextNumber(0.4, 0.8), 0.08, r:NextNumber(0.3, 0.6)), a, rgb(170, 90, 50), M.SmoothPlastic, nc())
	end
	-- совок и ведро у края
	P(m, "Trowel", Vector3.new(0.5, 0.05, 0.8), cf * CFrame.new(w * 0.3, 0.33, l * 0.3) * CFrame.Angles(0, 0.6, 0), rgb(160, 160, 166), M.Metal, nc())
	C(m, "Bucket", 0.9, 0.9, cf * CFrame.new(w / 2 + 0.9, 0.45, l * 0.3), rgb(120, 120, 126), M.Metal)
	return m
end

-- каменная табличка с письменами
function Props.tablet(parent, cf: CFrame, seed: number)
	local m = model(parent, "Tablet")
	P(m, "Stand", Vector3.new(2.6, 0.6, 1.2), cf * CFrame.new(0, 0.3, 0), rgb(70, 60, 50), M.Wood)
	local slab = cf * CFrame.new(0, 2.3, 0) * CFrame.Angles(-0.08, 0, 0)
	P(m, "Slab", Vector3.new(2.2, 3.4, 0.4), slab, rgb(150, 140, 120), M.Slate)
	local r = Random.new(seed)
	for k = 0, 6 do
		P(m, "Glyphs", Vector3.new(r:NextNumber(0.8, 1.8), 0.12, 0.04), slab * CFrame.new(r:NextNumber(-0.2, 0.2), 1.3 - k * 0.42, -0.21), rgb(70, 64, 56), M.SmoothPlastic, nc())
	end
	P(m, "Crack", Vector3.new(0.06, 1.6, 0.06), slab * CFrame.new(0.7, -0.4, -0.2) * CFrame.Angles(0, 0, 0.5), rgb(40, 36, 30), M.SmoothPlastic, nc())
	return m
end

-- большая шестерня на стене (cf — точка на стене, лицо в зал)
function Props.bigGear(parent, cf: CFrame, r: number, seed: number)
	local m = model(parent, "BigGear")
	local col = Props.BRASS:Lerp(Props.IRON, (seed % 3) / 3)
	local c = cf * CFrame.new(0, 0, -0.3) * CFrame.Angles(0, 0, (seed % 7) * 0.2)
	local flat = CFrame.Angles(math.pi / 2, 0, 0)
	C(m, "Disc", 0.4, r * 2, c * flat, col, M.Metal, nc())
	local n = math.floor(r * 5)
	for k = 0, n - 1 do
		local a = k / n * math.pi * 2
		P(m, "Tooth", Vector3.new(r * 0.28, 0.6, 0.36), c * CFrame.Angles(0, 0, a) * CFrame.new(0, r + 0.25, 0), col, M.Metal, nc())
	end
	C(m, "Hub", 0.6, r * 0.5, c * CFrame.new(0, 0, -0.1) * flat, col:Lerp(rgb(0, 0, 0), 0.3), M.Metal, nc())
	for k = 0, 3 do
		P(m, "Spoke", Vector3.new(0.3, r * 1.5, 0.46), c * CFrame.Angles(0, 0, k * math.pi / 4) * CFrame.new(0, 0, -0.02 - k * 0.012), col:Lerp(rgb(0, 0, 0), 0.15), M.Metal, nc())
	end
	return m
end

-- планетарий: солнце посередине и планеты на латунных кронштейнах
function Props.orrery(parent, cf: CFrame, seed: number)
	local m = model(parent, "Orrery")
	C(m, "Base", 0.6, 3.4, cf * CFrame.new(0, 0.3, 0), rgb(70, 50, 34), M.Wood)
	C(m, "Pole", 3.6, 0.3, cf * CFrame.new(0, 2.4, 0), Props.BRASS, M.Metal)
	S(m, "Sun", 1.3, cf * CFrame.new(0, 4.6, 0), rgb(255, 196, 90), M.Neon, nc())
	local colors = { rgb(150, 150, 160), rgb(210, 170, 110), rgb(60, 110, 190), rgb(190, 80, 50), rgb(200, 170, 130) }
	for k = 1, 5 do
		local a = (seed * 0.7 + k * 1.3) % (math.pi * 2)
		local rr = 0.9 + k * 0.6
		local y = 4.6 + (k % 2) * 0.3 - 0.15
		local tip = (cf * CFrame.new(math.cos(a) * rr, y, math.sin(a) * rr)).Position
		rod(m, "Arm", (cf * CFrame.new(0, y, 0)).Position, tip, 0.08, Props.BRASS, M.Metal, nc())
		S(m, "Planet", 0.3 + k * 0.08, CFrame.new(tip + Vector3.new(0, 0.3, 0)), colors[k], M.SmoothPlastic, nc())
	end
	return m
end

-- маятник под потолком над розой ветров
function Props.pendulum(parent, cf: CFrame, top: number)
	local m = model(parent, "Pendulum")
	rod(m, "Wire", (cf * CFrame.new(0, top - 0.1, 0)).Position, (cf * CFrame.new(0.6, 2.2, 0)).Position, 0.08, Props.IRON, M.Metal, nc())
	S(m, "Bob", 1.4, cf * CFrame.new(0.62, 1.6, 0), Props.BRASS, M.Metal, nc())
	C(m, "Rose", 0.08, 7, cf * CFrame.new(0, 0.04, 0), rgb(120, 100, 70), M.Marble, nc())
	for k = 0, 7 do
		P(m, "RoseRay", Vector3.new(0.2, 0.02, if k % 2 == 0 then 3.2 else 2), cf * CFrame.Angles(0, k * math.pi / 4, 0) * CFrame.new(0, 0.09 + k * 0.004, -(if k % 2 == 0 then 1.6 else 1)), rgb(60, 50, 40), M.SmoothPlastic, nc())
	end
	return m
end

-- ваза «с гончарного круга»: тонкие кольца по профилю, а не шар и не коробка
local VASE_PROFILES = {
	{ 0.62, 0.9, 1.3, 1.62, 1.75, 1.68, 1.42, 1.06, 0.72, 0.56, 0.52, 0.66, 0.8 }, -- амфора с ручками
	{ 0.8, 1.15, 1.5, 1.74, 1.84, 1.8, 1.66, 1.42, 1.16, 0.98, 0.94, 1.04 }, -- пузатый кувшин
	{ 0.56, 0.64, 0.78, 0.92, 1.02, 1.08, 1.06, 0.96, 0.8, 0.66, 0.58, 0.56, 0.62, 0.78 }, -- высокая узкая
	{ 0.9, 1.3, 1.6, 1.76, 1.78, 1.7, 1.5, 1.2, 0.96 }, -- низкая чаша
}
function Props.vase(parent, cf: CFrame, seed: number)
	local m = model(parent, "Vase")
	local _, top = Props.plinth(m, cf, 1.8, 2.2)
	local kind = seed % #VASE_PROFILES + 1
	local prof = VASE_PROFILES[kind]
	local col = Color3.fromHSV(({ 0.58, 0.02, 0.07, 0.45, 0.75, 0.1 })[seed % 6 + 1], 0.5, 0.62)
	local band = if seed % 2 == 0 then rgb(236, 226, 200) else rgb(30, 26, 24)
	local h = 0.22
	for i, d in prof do
		local isBand = i == math.floor(#prof * 0.4) or i == math.floor(#prof * 0.4) + 1
		C(m, "Ring", h, d, top * CFrame.new(0, (i - 0.5) * h, 0), if isBand then band else col, M.SmoothPlastic, nc())
	end
	-- горлышко тёмное изнутри
	local last = prof[#prof]
	C(m, "Mouth", 0.03, last * 0.8, top * CFrame.new(0, #prof * h + 0.005, 0), rgb(24, 20, 18), M.SmoothPlastic, nc())
	if kind == 1 then
		for _, s in { -1, 1 } do
			local a = (top * CFrame.new(s * 0.32, (#prof - 2.5) * h, 0)).Position
			local b = (top * CFrame.new(s * 0.95, (#prof - 3.5) * h, 0)).Position
			local c2 = (top * CFrame.new(s * 0.8, (#prof - 6.5) * h, 0)).Position
			rod(m, "Handle", a, b, 0.12, col, M.SmoothPlastic, nc())
			rod(m, "Handle", b, c2, 0.12, col, M.SmoothPlastic, nc())
		end
	end
	return m
end


return Props
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX0000001A">
          <Properties>
            <string name="Name">RoomBuilder</string>
            <ProtectedString name="Source">--!nonstrict
-- Сборка комнаты по описанию из RoomPlan. Кадр комнаты: вход в origin, комната уходит
-- вперёд (-Z). Стены: каркас толщиной 1 по границе, поверх — обои (0.1) и панели
-- (0.12) со стороны комнаты, поэтому соседние комнаты не мерцают на общей стене.
-- Мебель расставлена по планировкам; проходы ко всем возможным дверям свободны

local Shared = game:GetService("ReplicatedStorage").Workshop.Shared
local M = require(Shared.Materials)
local Plan = require(Shared.RoomPlan)
local Props = require(script.Parent.Props)

local P, C, nc, rgb = Props.P, Props.C, Props.nc, Props.rgb

local Builder = {}

local F = 0.9 -- от середины стены до места мебели (панели и поручень заканчиваются на 0.84)
local SKIN = 0.1
local PANEL = 0.12
local DOOR_HOLE = { w = 5, h = 8 }

-- ---------------------------------------------------------------------------
-- оформление по глубине

local PAPER = {
	classic = { rgb(112, 38, 42), rgb(42, 68, 56), rgb(38, 50, 82), rgb(188, 176, 150), rgb(76, 46, 74), rgb(150, 120, 70) },
	old = { rgb(74, 40, 40), rgb(44, 56, 50), rgb(40, 44, 60), rgb(110, 104, 92), rgb(60, 46, 58) },
	ruin = { rgb(62, 70, 58), rgb(70, 68, 60) },
}
local FLOOR = {
	classic = { { rgb(206, 200, 190), M.Marble }, { rgb(124, 86, 54), M.WoodPlanks }, { rgb(170, 160, 146), M.Marble }, { rgb(96, 64, 44), M.WoodPlanks } },
	old = { { rgb(128, 124, 116), M.Marble }, { rgb(78, 56, 40), M.WoodPlanks }, { rgb(100, 96, 90), M.Slate } },
	ruin = { { rgb(84, 88, 76), M.Slate } },
}

function Builder.style(d, rand)
	local zone = d.zone or "classic"
	local papers, floors = PAPER[zone] or PAPER.classic, FLOOR[zone] or FLOOR.classic
	local fl = floors[math.floor(rand() * #floors) + 1]
	local st = {
		paper = papers[math.floor(rand() * #papers) + 1],
		paperMat = M.Plaster,
		panel = if zone == "classic" then (if rand() &lt; 0.5 then Props.WOOD_DARK else rgb(170, 164, 152)) else rgb(72, 66, 58),
		panelMat = M.Wood,
		floor = fl[1],
		floorMat = fl[2],
		ceil = if zone == "classic" then rgb(214, 208, 194) elseif zone == "old" then rgb(140, 134, 124) else rgb(84, 86, 78),
		ceilMat = M.SmoothPlastic,
		struct = rgb(110, 104, 96),
		wainscot = true,
	}
	if st.panel ~= Props.WOOD_DARK and zone == "classic" then
		st.panelMat = M.Marble
	end
	local k = d.kind
	if k == "restroom" then
		st.paper = if zone == "classic" then rgb(206, 210, 204) else rgb(140, 148, 142)
		st.paperMat = M.CeramicTiles
		st.floor = if zone == "classic" then rgb(186, 188, 184) else rgb(110, 114, 110)
		st.floorMat = M.CeramicTiles
		st.wainscot = false
	elseif k == "archive" then
		st.paper = Props.WOOD:Lerp(rgb(0, 0, 0), if zone == "classic" then 0.25 else 0.5)
		st.paperMat = M.WoodPlanks
		st.floor = rgb(84, 58, 40)
		st.floorMat = M.WoodPlanks
	elseif k == "storage" or k == "tech" or k == "lifthall" then
		st.paper = rgb(98, 98, 94)
		st.paperMat = M.Concrete
		st.floor = rgb(80, 80, 78)
		st.floorMat = M.Concrete
		st.ceil = rgb(90, 90, 88)
		st.wainscot = false
	elseif k == "arena" then
		st.paper = rgb(72, 70, 68)
		st.paperMat = M.Slate
		st.floor = rgb(92, 90, 86)
		st.floorMat = M.Marble
		st.ceil = rgb(50, 50, 50)
		st.wainscot = false
	elseif k == "voidhall" then
		st.paper = rgb(86, 82, 76)
		st.floor = rgb(70, 66, 60)
		st.floorMat = M.Slate
	elseif k == "fossil" then
		st.floor = rgb(176, 160, 130)
		st.floorMat = M.Sand
	elseif k == "final" then
		st.paperMat = M.Slate
		st.wainscot = false
	end
	if k == "tech" then
		st.paper = rgb(96, 100, 102)
		st.paperMat = M.DiamondPlate
		st.ceilMat = M.Metal
	end
	return st
end

-- ---------------------------------------------------------------------------
-- каркас, обои, полы, потолок

local function at(origin: CFrame, x: number, y: number, z: number)
	return origin * CFrame.new(x, y, z)
end
Builder.at = at

-- высота пола в точке z (для лестниц)
local function floorAt(d, z: number): number
	if d.dy == 0 then
		return 0
	end
	if z &gt; -12 then
		return 0
	elseif z &lt; -28 then
		return d.dy
	end
	return d.dy * (-12 - z) / 16
end
Builder.floorAt = floorAt

-- обои и панели на внутренней стороне стены. cf — середина стены (каркаса),
-- LookVector — в комнату
-- lens = { обои, панели, поручень }: у дальней и входной стены слои короче на толщину
-- слоёв боковых стен, поэтому в углах ничего не налезает
local function dress(m, cf: CFrame, lens, y0: number, height: number, holes, st)
	local skinCF = cf * CFrame.new(0, 0, -(0.5 + SKIN / 2))
	Props.wall(m, skinCF, lens[1], y0, height, SKIN, holes, st.paper, st.paperMat, "Paper")
	if st.wainscot then
		local pcf = cf * CFrame.new(0, 0, -(0.5 + SKIN + PANEL / 2))
		Props.wall(m, pcf, lens[2], y0, 3.4, PANEL, holes, st.panel, st.panelMat, "Panel")
		local rcf = cf * CFrame.new(0, 0, -(0.5 + SKIN + PANEL + 0.06))
		Props.wall(m, rcf, lens[3], y0 + 3.4, 0.25, 0.12, holes, st.panel:Lerp(rgb(0, 0, 0), 0.2), M.Wood, "Rail")
	else
		local bcf = cf * CFrame.new(0, 0, -(0.5 + SKIN + 0.06))
		Props.wall(m, bcf, lens[2], y0, 0.5, 0.12, holes, rgb(60, 56, 52), M.Wood, "Baseboard")
	end
end

-- Каркас, обои и пол/потолок. Возвращает кадр выхода и данные для соседей
local function shell(m, d, origin: CFrame, st, prevWall)
	local w, l, h = d.w, d.l, d.h
	local ybase = math.min(0, d.dy)
	local top = math.max(0, d.dy) + h
	local H = top - ybase
	-- пол (у лестниц — нижняя площадка, пандус и верхняя площадка)
	if d.dy == 0 then
		P(m, "Floor", Vector3.new(w, 1, l), at(origin, 0, -0.5, -l / 2), st.floor, st.floorMat)
	else
		-- площадки не заходят под стены с проёмами (там верх стены служит порогом)
		local z0 = if d.dy &lt; 0 then -0.5 else 0
		P(m, "Floor", Vector3.new(w, 1, 12 + z0), at(origin, 0, -0.5, (z0 - 12) / 2), st.floor, st.floorMat)
		local z1 = if d.dy &gt; 0 then -l + 0.5 else -l
		P(m, "Floor", Vector3.new(w, 1, -28 - z1), at(origin, 0, d.dy - 0.5, (-28 + z1) / 2), st.floor, st.floorMat)
		-- невидимый пандус (по нему идут без прыжков) и видимые ступени
		local rise = d.dy
		local len = math.sqrt(16 * 16 + rise * rise)
		local ang = math.atan2(rise, 16)
		local sw = d.stairW or w
		local ramp = P(m, "Ramp", Vector3.new(sw - 2, 0.6, len), at(origin, 0, rise / 2 - 0.3, -20) * CFrame.Angles(ang, 0, 0), rgb(0, 0, 0), M.SmoothPlastic, { Transparency = 1, CastShadow = false })
		local _ = ramp
		local steps = 16
		local bottom = math.min(0, rise)
		for k = 0, steps - 1 do
			local z0 = -12 - k
			local topY = rise * (k + 1) / steps
			local sh = topY - bottom
			if rise &lt; 0 then
				-- вниз: ступень k стоит на уровне следующей ступени
				topY = rise * k / steps
				sh = topY - bottom
			end
			if sh &gt; 0.05 then
				P(m, "Step", Vector3.new(sw - 1.6, sh, 1), at(origin, 0, bottom + sh / 2 - 0.001, z0 - 0.5), st.floor:Lerp(rgb(0, 0, 0), 0.15), st.floorMat, nc())
			end
		end
		-- перила вдоль ступеней
		for _, sx in { -1, 1 } do
			local hx = if d.stairW then sw / 2 - 1.2 else w / 2 - F - 0.4
			local a = at(origin, sx * hx, 3.2, -12).Position
			local b = at(origin, sx * hx, d.dy + 3.2, -28).Position
			Props.rod(m, "Handrail", a, b, 0.25, Props.WOOD_DARK, M.Wood, nc())
		end
	end
	if not d.noCeiling then
		P(m, "Ceiling", Vector3.new(w, 1, l), at(origin, 0, top + 0.5, -l / 2), st.ceil, st.ceilMat)
	end
	-- проёмы: настоящий выход, ложные двери, окна
	local exits = if d.noExit then {} else { d.exit }
	for _, e in d.decoys do
		table.insert(exits, e)
	end
	local front, sides = {}, { [-1] = {}, [1] = {} }
	for _, e in exits do
		local hw, hh = DOOR_HOLE.w, DOOR_HOLE.h
		if e == d.exit and d.exitHole then
			hw, hh = d.exitHole.w, d.exitHole.h
		end
		local hole = { w = hw, y = e.y or 0, h = (e.y or 0) + hh }
		if e.turn == 0 then
			hole.x = e.x
			table.insert(front, hole)
		else
			-- вдоль боковой стены: x стены = -z комнаты (левая) или z (правая)
			hole.zRoom = e.z
			table.insert(sides[e.turn], hole)
		end
	end
	-- дверь в пристройку (туалет при зале)
	if d.annex then
		table.insert(sides[d.annex.side], { zRoom = d.annex.z, w = Props.DOORS.small.w, y = 0, h = Props.DOORS.small.h })
	end
	-- проломы во всю высоту стены (аномальный коридор)
	for _, g in d.gaps or {} do
		table.insert(sides[g.side], { zRoom = g.z, w = g.w, y = ybase, h = top })
	end
	-- окна: в свободных местах боковых стен, которые задаёт планировка
	local windows = {}
	if d.windows and d.windowZ then
		for _, wz in d.windowZ do
			for _, side in { -1, 1 } do
				local free = true
				for _, h in sides[side] do
					if math.abs(h.zRoom - wz) &lt; 6 then
						free = false
					end
				end
				if free then
					local y = floorAt(d, wz)
					table.insert(sides[side], { zRoom = wz, w = Props.WINDOW.w, y = y + Props.WINDOW.y, h = y + Props.WINDOW.y + Props.WINDOW.h, window = true })
					table.insert(windows, { side = side, z = wz, y = y + Props.WINDOW.y + Props.WINDOW.h / 2 })
				end
			end
		end
	end
	-- дальняя стена (углы перекрывает она)
	local fcf = at(origin, 0, 0, -l) * CFrame.Angles(0, math.pi, 0)
	local fh = {}
	for _, h in front do
		table.insert(fh, { x = -h.x, w = h.w, y = h.y, h = h.h })
	end
	Props.wall(m, fcf, w + 1, ybase, H, 1, fh, st.struct, M.Concrete, "Struct")
	-- обои дальней стены начинаются от её пола (у лестниц он выше или ниже входа)
	dress(m, fcf, { w - 1.2, w - 1.44, w - 1.68 }, d.dy, top - d.dy, fh, st)
	-- боковые стены
	for _, side in { -1, 1 } do
		local cf = at(origin, side * w / 2, 0, -l / 2) * CFrame.Angles(0, if side &lt; 0 then -math.pi / 2 else math.pi / 2, 0)
		local hs = {}
		for _, h in sides[side] do
			-- ось стены: у левой (смотрит в +X) локальный x = z комнаты + l/2 со знаком
			local x = if side &lt; 0 then (h.zRoom + l / 2) else -(h.zRoom + l / 2)
			table.insert(hs, { x = x, w = h.w, y = h.y, h = h.h })
		end
		Props.wall(m, cf, l - 1, ybase, H, 1, hs, st.struct, M.Concrete, "Struct")
		dress(m, cf, { l - 1, l - 1.2, l - 1.44 }, ybase, H, hs, st)
	end
	-- стена входа: только там, где нет стены прошлой комнаты, и выше неё
	local bcf = at(origin, 0, 0, 0)
	local eh = d.entry or DOOR_HOLE
	local entrance = if d.kind == "start" then {} else { { x = 0, w = eh.w, y = 0, h = eh.h } }
	if prevWall then
		local c0, c1, ctop, cbot = prevWall.x0, prevWall.x1, prevWall.top, prevWall.bottom
		local half = w / 2 + 0.5
		-- слева и справа от общей части
		if c0 &gt; -half then
			local len = c0 + half
			Props.wall(m, bcf * CFrame.new(-half + len / 2, 0, 0), len, ybase, H, 1, {}, st.struct, M.Concrete, "Struct")
		end
		if c1 &lt; half then
			local len = half - c1
			Props.wall(m, bcf * CFrame.new(c1 + len / 2, 0, 0), len, ybase, H, 1, {}, st.struct, M.Concrete, "Struct")
		end
		local mid0, mid1 = math.max(c0, -half), math.min(c1, half)
		if mid1 &gt; mid0 then
			if top &gt; ctop + 0.05 then
				Props.wall(m, bcf * CFrame.new((mid0 + mid1) / 2, 0, 0), mid1 - mid0, ctop, top - ctop, 1, {}, st.struct, M.Concrete, "Struct")
			end
			if ybase &lt; cbot - 0.05 then
				Props.wall(m, bcf * CFrame.new((mid0 + mid1) / 2, 0, 0), mid1 - mid0, ybase, cbot - ybase, 1, {}, st.struct, M.Concrete, "Struct")
			end
		end
	else
		Props.wall(m, bcf, w + 1, ybase, H, 1, entrance, st.struct, M.Concrete, "Struct")
	end
	dress(m, bcf, { w - 1.2, w - 1.44, w - 1.68 }, 0, top, entrance, st)
	-- карниз под потолком по периметру
	for _, side in (if d.noCeiling then {} else { -1, 1 }) do
		P(m, "Crown", Vector3.new(0.3, 0.4, l - 1.8), at(origin, side * (w / 2 - 0.75), top - 0.2, -l / 2), st.ceil:Lerp(rgb(0, 0, 0), 0.15), M.SmoothPlastic, nc())
	end
	for _, z in (if d.noCeiling then {} else { -0.75, -l + 0.75 }) do
		P(m, "Crown", Vector3.new(w - 1.2, 0.4, 0.3), at(origin, 0, top - 0.2, z), st.ceil:Lerp(rgb(0, 0, 0), 0.15), M.SmoothPlastic, nc())
	end
	-- кадры дверей и окон
	local function exitCF(e)
		return origin * CFrame.new(e.x, e.y or 0, e.z) * CFrame.Angles(0, -e.turn * math.pi / 2, 0)
	end
	local info = {
		exitCF = exitCF(d.exit),
		decoyCFs = {},
		windows = windows,
		ybase = ybase,
		top = top,
	}
	for _, e in d.decoys do
		table.insert(info.decoyCFs, exitCF(e))
	end
	-- стена с настоящим выходом — для стены входа следующей комнаты
	local e = d.exit
	local a, b
	if e.turn == 0 then
		a, b = at(origin, -w / 2 - 0.5, 0, -l), at(origin, w / 2 + 0.5, 0, -l)
	else
		a, b = at(origin, e.turn * w / 2, 0, 0.5), at(origin, e.turn * w / 2, 0, -l - 0.5)
	end
	info.exitWall = { a = a.Position, b = b.Position, top = origin.Y + top, bottom = origin.Y + ybase }
	return info
end

-- общая стена прошлой комнаты в координатах новой
function Builder.prevWallFor(prevInfo, origin: CFrame)
	if not prevInfo or not prevInfo.exitWall then
		return nil
	end
	local ew = prevInfo.exitWall
	local xa = origin:PointToObjectSpace(ew.a).X
	local xb = origin:PointToObjectSpace(ew.b).X
	return { x0 = math.min(xa, xb), x1 = math.max(xa, xb), top = ew.top - origin.Y, bottom = ew.bottom - origin.Y }
end

-- ---------------------------------------------------------------------------
-- места у стен

local function slotL(d, origin, z)
	return origin * CFrame.new(-d.w / 2 + F, floorAt(d, z), z) * CFrame.Angles(0, -math.pi / 2, 0)
end
local function slotR(d, origin, z)
	return origin * CFrame.new(d.w / 2 - F, floorAt(d, z), z) * CFrame.Angles(0, math.pi / 2, 0)
end
local function slotFront(d, origin, x)
	return origin * CFrame.new(x, floorAt(d, -d.l), -d.l + F) * CFrame.Angles(0, math.pi, 0)
end
local function slotBack(d, origin, x)
	return origin * CFrame.new(x, 0, -F)
end
local function spot(d, origin, x, z, yaw)
	return origin * CFrame.new(x, floorAt(d, z), z) * CFrame.Angles(0, yaw or 0, 0)
end
Builder.slotL, Builder.slotR, Builder.slotFront, Builder.slotBack, Builder.spot = slotL, slotR, slotFront, slotBack, spot

-- ---------------------------------------------------------------------------
-- помощники планировок

local function hide(ctx, cf)
	-- шкафчики стоят не в каждом зале: сколько их, решает план
	if ctx.hides &lt;= 0 then
		return
	end
	ctx.hides -= 1
	local _, cavity = Props.locker(ctx.m, cf)
	table.insert(ctx.info.hideSpots, cavity)
end
local function vent(ctx, cf)
	if ctx.hides &lt;= 0 then
		return
	end
	ctx.hides -= 1
	local _, cavity = Props.vent(ctx.m, cf)
	table.insert(ctx.info.hideSpots, cavity)
end
local function search(ctx, kind: string, cf)
	local m, hit, drawers, top
	if kind == "nightstand" then
		m, hit, drawers, top = Props.nightstand(ctx.m, cf)
	elseif kind == "cabinet" then
		m, hit, drawers = Props.cabinet(ctx.m, cf)
	elseif kind == "desk" then
		m, hit, drawers, top = Props.desk(ctx.m, cf)
	else
		m, hit, drawers, top = Props.dresser(ctx.m, cf)
	end
	local _ = hit
	table.insert(ctx.info.searchables, { model = m, drawers = drawers })
	if top then
		table.insert(ctx.info.tops, top)
	end
	return top
end
local function lamp(ctx, pos: Vector3)
	local _, bulb = Props.ceilingLamp(ctx.m, pos)
	table.insert(ctx.info.lights, bulb)
end
local function ceil(ctx, x, z)
	lamp(ctx, at(ctx.origin, x, ctx.info.top, z).Position)
end
local function chandelier(ctx, x, z, drop)
	local _, core = Props.chandelier(ctx.m, at(ctx.origin, x, ctx.info.top, z).Position, drop or 2)
	table.insert(ctx.info.lights, core)
end
local function tableLamp(ctx, cf)
	local _, shade = Props.tableLamp(ctx.m, cf)
	table.insert(ctx.info.lights, shade)
end
local function painting(ctx, side, z, y, w, h)
	local cf = if side &lt; 0 then slotL(ctx.d, ctx.origin, z) elseif side &gt; 0 then slotR(ctx.d, ctx.origin, z) else slotFront(ctx.d, ctx.origin, z)
	-- картина висит на обоях (их лицевая сторона в 0.6 от середины стены)
	Props.painting(ctx.m, cf * CFrame.new(0, y, F - 0.6), w, h, ctx.d.door + math.floor(z))
end

-- ---------------------------------------------------------------------------
-- планировки залов музея

local L = {}

local STATUES = { "figure", "bust", "obelisk", "abstract", "broken" }
local function statue(c, x, z, k: number, yaw: number?)
	Props.statue(c.m, spot(c.d, c.origin, x, z, yaw), STATUES[(c.d.door + k) % #STATUES + 1], c.d.door)
end
local function case(c, x, z, k: number, item: string?)
	Props.displayCase(c.m, spot(c.d, c.origin, x, z), item or Props.ODD[(c.d.door * 3 + k * 5) % #Props.ODD + 1])
end
local function wallCase(c, side: number, z: number, w: number?)
	Props.wallCase(c.m, (if side &lt; 0 then slotL else slotR)(c.d, c.origin, z), w or 6, c.d.door + math.floor(z))
end
local function bench(c, side: number, z: number, w: number)
	Props.bench(c.m, (if side &lt; 0 then slotL else slotR)(c.d, c.origin, z), w)
end
local function ropeAround(c, x0, x1, z0, z1)
	local function p(x, z)
		return at(c.origin, x, 0, z).Position
	end
	Props.rope(c.m, p(x0, z0), p(x1, z0))
	Props.rope(c.m, p(x0, z1), p(x1, z1))
	Props.rope(c.m, p(x0, z0), p(x0, z1))
	Props.rope(c.m, p(x1, z0), p(x1, z1))
end

L.start = function(c)
	local d, o = c.d, c.origin
	-- закрывшиеся входные двери за спиной
	local back = slotBack(d, o, 0)
	local dm = Props.model(c.m, "EntranceDoors")
	for _, s in { -1, 1 } do
		P(dm, "Leaf", Vector3.new(4.3, 12.4, 0.3), back * CFrame.new(s * 2.2, 6.2, -0.2), rgb(52, 34, 24), M.WoodPlanks, nc())
		P(dm, "Panel", Vector3.new(3, 4.4, 0.06), back * CFrame.new(s * 2.2, 3.4, -0.38), rgb(40, 26, 18), M.Wood, nc())
		P(dm, "Panel", Vector3.new(3, 4.4, 0.06), back * CFrame.new(s * 2.2, 8.8, -0.38), rgb(40, 26, 18), M.Wood, nc())
		C(dm, "Ring", 0.1, 0.8, back * CFrame.new(s * 0.6, 5.6, -0.42) * CFrame.Angles(math.pi / 2, 0, 0), Props.BRASS, M.Metal, nc())
		P(dm, "Post", Vector3.new(0.8, 13.2, 0.5), back * CFrame.new(s * 4.8, 6.6, -0.3), rgb(150, 144, 134), M.Marble, nc())
	end
	P(dm, "Lintel", Vector3.new(10.8, 0.9, 0.7), back * CFrame.new(0, 13.1, -0.42), rgb(150, 144, 134), M.Marble, nc())
	Props.counter(c.m, slotL(d, o, -14), 10)
	bench(c, 1, -12, 8)
	Props.statue(c.m, spot(d, o, -9, -22), "bust", 1)
	Props.statue(c.m, spot(d, o, 9, -22), "bust", 2)
	Props.plantPot(c.m, spot(d, o, -12, -27.5))
	Props.plantPot(c.m, spot(d, o, 12, -27.5))
	Props.rug(c.m, spot(d, o, 0, -16), 10, 22, rgb(110, 28, 34))
	chandelier(c, 0, -15, 3)
end

L.corridor = function(c)
	hide(c, slotL(c.d, c.origin, -12))
	bench(c, 1, -11, 6)
	wallCase(c, -1, -20)
	painting(c, 1, -11, 8, 3, 2.4)
	painting(c, 1, -22, 7, 3.6, 3)
	ceil(c, 0, -10)
	ceil(c, 0, -28)
end

L.longhall = function(c)
	local d, o = c.d, c.origin
	hide(c, slotL(d, o, -14))
	hide(c, slotR(d, o, -44))
	wallCase(c, 1, -14)
	wallCase(c, -1, -28)
	wallCase(c, 1, -34)
	bench(c, -1, -46, 6)
	painting(c, -1, -20.5, 7, 3, 2.6)
	painting(c, 1, -24, 7, 3, 2.6)
	painting(c, -1, -54, 7, 3.6, 3)
	for _, z in { -8, -24, -40, -56 } do
		ceil(c, 0, z)
	end
end

L.shorthall = function(c)
	hide(c, slotL(c.d, c.origin, -11))
	Props.vase(c.m, spot(c.d, c.origin, 3.8, -11), c.d.door)
	painting(c, 1, -11, 8.5, 3, 2.4)
	ceil(c, 0, -11)
end

L.gallery = function(c)
	local d, o = c.d, c.origin
	for _, s in { -1, 1 } do
		for k, z in { -8, -16, -24 } do
			painting(c, s, z, 7.5, 5, 4)
			local _ = k
		end
		statue(c, s * 11, -30, if s &lt; 0 then 0 else 2)
		hide(c, slotBack(d, o, s * 9))
	end
	for _, z in { -14, -26 } do
		Props.bench(c.m, spot(d, o, 0.05, z, -math.pi / 2), 6)
		Props.bench(c.m, spot(d, o, -0.05, z, math.pi / 2), 6)
	end
	chandelier(c, 0, -12, 3)
	chandelier(c, 0, -30, 3)
end

L.sculpture = function(c)
	local d, o = c.d, c.origin
	statue(c, -9, -11, 0)
	statue(c, 9, -11, 1)
	statue(c, 0, -18, 2)
	statue(c, -9, -26, 3)
	statue(c, 9, -26, 4)
	bench(c, -1, -18, 6)
	bench(c, 1, -18, 6)
	hide(c, slotBack(d, o, -13))
	hide(c, slotBack(d, o, 13))
	chandelier(c, 0, -18, 4)
	ceil(c, -10, -33)
	ceil(c, 10, -33)
end

L.cases = function(c)
	local d, o = c.d, c.origin
	case(c, -8, -9, 1)
	case(c, 8, -9, 2)
	case(c, 0, -16, 3)
	case(c, -8, -23, 4)
	case(c, 8, -23, 5)
	wallCase(c, -1, -14)
	wallCase(c, 1, -14)
	hide(c, slotBack(d, o, -10))
	hide(c, slotBack(d, o, 10))
	ceil(c, 0, -9)
	ceil(c, 0, -24)
end

L.fossil = function(c)
	local d, o = c.d, c.origin
	Props.fossil(c.m, spot(d, o, 0, -28), 24)
	ropeAround(c, -5.5, 5.5, -13.5, -42.5)
	for _, s in { -1, 1 } do
		bench(c, s, -22, 7)
		bench(c, s, -36, 7)
		case(c, s * 14, -9, if s &lt; 0 then 1 else 2, if s &lt; 0 then "skull" else "gem")
		case(c, s * 14, -46, if s &lt; 0 then 3 else 4)
		hide(c, slotBack(d, o, s * 15))
		ceil(c, s * 14, -28)
	end
	hide(c, slotL(d, o, -29))
	chandelier(c, 0, -9, 5)
	chandelier(c, 0, -47, 5)
end

L.armory = function(c)
	local d, o = c.d, c.origin
	for _, z in { -8, -14, -20 } do
		Props.armor(c.m, slotL(d, o, z))
		Props.armor(c.m, slotR(d, o, z))
	end
	local _, top = Props.table(c.m, spot(d, o, 0, -16), 4, 10, rgb(90, 20, 26))
	for k = -1, 1 do
		P(c.m, "Blade", Vector3.new(0.25, 0.06, 3.2), top * CFrame.new(k * 1.1, 0.06, k * 1.4) * CFrame.Angles(0, 0.3 * k, 0), rgb(170, 174, 180), M.Metal, nc())
		P(c.m, "Hilt", Vector3.new(0.9, 0.1, 0.2), top * CFrame.new(k * 1.1, 0.07, k * 1.4) * CFrame.Angles(0, 0.3 * k, 0) * CFrame.new(0, 0, 1.3), Props.BRASS, M.Metal, nc())
	end
	Props.wallCase(c.m, slotFront(d, o, -9), 6, d.door)
	Props.wallCase(c.m, slotFront(d, o, 9), 6, d.door + 4)
	hide(c, slotBack(d, o, -9))
	hide(c, slotBack(d, o, 9))
	ceil(c, 0, -9)
	ceil(c, 0, -25)
end

L.ceramics = function(c)
	local d, o = c.d, c.origin
	for k, p in { { -7, -9 }, { 7, -9 }, { 0, -15 }, { -7, -21 }, { 7, -21 } } do
		Props.vase(c.m, spot(d, o, p[1], p[2]), d.door + k)
	end
	wallCase(c, -1, -15)
	wallCase(c, 1, -15)
	hide(c, slotBack(d, o, -9))
	hide(c, slotBack(d, o, 9))
	Props.rug(c.m, spot(d, o, 0, -15), 8, 16, rgb(40, 60, 90))
	ceil(c, 0, -15)
end

L.archive = function(c)
	local d, o = c.d, c.origin
	for _, s in { -1, 1 } do
		local slot = if s &lt; 0 then slotL else slotR
		for k, z in { -7, -13.4, -19.8 } do
			Props.bookshelf(c.m, slot(d, o, z), 6, 12, d.door + k * 3 + s)
		end
		search(c, "cabinet", slotBack(d, o, s * 7))
		hide(c, slotBack(d, o, s * 13))
		ceil(c, s * 8, -14)
		ceil(c, s * 8, -30)
	end
	for k, z in { -12, -18.4, -24.8 } do
		Props.bookshelf(c.m, spot(d, o, 0, z, -math.pi / 2) * CFrame.new(0, 0, 0.05), 6, 10, d.door + k)
		Props.bookshelf(c.m, spot(d, o, 0, z, math.pi / 2) * CFrame.new(0, 0, 0.05), 6, 10, d.door + k + 5)
	end
	local top = search(c, "desk", slotL(d, o, -27.6))
	if top then
		tableLamp(c, top * CFrame.new(-1.6, 0, 0))
	end
end

L.storage = function(c)
	local d, o = c.d, c.origin
	for _, s in { -1, 1 } do
		local slot = if s &lt; 0 then slotL else slotR
		Props.rack(c.m, slot(d, o, -7), 6, d.door + s)
		Props.rack(c.m, slot(d, o, -14), 6, d.door + s * 2)
		search(c, "cabinet", slot(d, o, -20))
		hide(c, slotBack(d, o, s * 10))
	end
	-- экспонат, который так и не выставили
	Props.statue(c.m, spot(d, o, 0, -11), "broken", 1)
	Props.crate(c.m, spot(d, o, -5.5, -18, 0.3), 3)
	Props.crate(c.m, spot(d, o, -5.5, -18, 0.3) * CFrame.new(0, 3, 0), 2.4)
	Props.crate(c.m, spot(d, o, 5.5, -18, -0.2), 3)
	Props.crate(c.m, spot(d, o, 0, -25, 0.5), 3)
	ceil(c, 0, -9)
	ceil(c, 0, -24)
end

L.tech = function(c)
	local d, o = c.d, c.origin
	vent(c, slotL(d, o, -10))
	vent(c, slotR(d, o, -22))
	search(c, "cabinet", slotR(d, o, -10))
	P(c.m, "FuseBox", Vector3.new(2.2, 3, 0.5), slotL(d, o, -21) * CFrame.new(0, 5, -0.3), rgb(110, 114, 116), M.Metal)
	C(c.m, "Valve", 0.2, 1.2, slotR(d, o, -29) * CFrame.new(0, 4.5, -0.4) * CFrame.Angles(math.pi / 2, 0, 0), rgb(150, 40, 34), M.Metal, nc())
	for _, s in { -1, 1 } do
		Props.pipes(c.m, at(o, s * 4.6, d.h - 0.6, -1).Position, at(o, s * 4.6, d.h - 0.6, -d.l + 1).Position, 2)
	end
	ceil(c, 0, -8)
	ceil(c, 0, -24)
end

local function stairsLayout(c)
	local d, o = c.d, c.origin
	hide(c, slotL(d, o, -6))
	bench(c, 1, -6, 5)
	painting(c, -1, -34, 7, 3, 2.4)
	painting(c, 1, -34, 7, 3, 2.4)
	ceil(c, 0, -6)
	ceil(c, 0, -20)
	ceil(c, 0, -34)
end
L.stairsup = stairsLayout
L.stairsdown = stairsLayout

L.restroom = function(c)
	local d, o = c.d, c.origin
	Props.stallRow(c.m, slotL(d, o, -11), 3)
	Props.sinkRow(c.m, slotR(d, o, -11), 3)
	hide(c, slotFront(d, o, 8))
	search(c, "cabinet", slotFront(d, o, -8))
	C(c.m, "Bin", 2, 1.4, spot(d, o, 9.6, -20.5) * CFrame.new(0, 1, 0), rgb(120, 124, 126), M.Metal)
	ceil(c, 0, -8)
	ceil(c, 0, -19)
end

L.cafe = function(c)
	local d, o = c.d, c.origin
	local _, top = Props.counter(c.m, slotL(d, o, -10), 10)
	table.insert(c.info.tops, top)
	Props.fridge(c.m, slotL(d, o, -18.5))
	for _, p in { { 5, -8 }, { 10, -16 }, { 4, -23 }, { -5, -23 } } do
		local _, t = Props.cafeTable(c.m, spot(d, o, p[1], p[2]))
		table.insert(c.info.tops, t)
	end
	hide(c, slotBack(d, o, 11))
	ceil(c, 0, -9)
	ceil(c, 0, -23)
end

L.rotunda = function(c)
	local d, o = c.d, c.origin
	for k = 0, 7 do
		local a = math.rad(22.5 + k * 45)
		Props.pillar(c.m, spot(d, o, math.cos(a) * 14, -23 + math.sin(a) * 14), d.h)
	end
	Props.statue(c.m, spot(d, o, 0, -23), "obelisk", d.door)
	for _, s in { -1, 1 } do
		bench(c, s, -14, 7)
		bench(c, s, -27, 7)
		case(c, s * 16, -36, if s &lt; 0 then 1 else 2)
		hide(c, slotBack(d, o, s * 16))
	end
	hide(c, slotL(d, o, -20.5))
	chandelier(c, 0, -23, 6)
end

-- вещи, которым в музее не место
L.oddities = function(c)
	local d, o = c.d, c.origin
	case(c, -8, -9, 1, "wrench")
	case(c, 8, -9, 2, "boot")
	case(c, 0, -15, 3, "teapot")
	case(c, -8, -21, 4, "bulb")
	case(c, 8, -21, 5, "gear")
	wallCase(c, -1, -15)
	wallCase(c, 1, -15)
	hide(c, slotBack(d, o, -10))
	hide(c, slotBack(d, o, 10))
	ceil(c, 0, -15)
end

-- пустой зал: один постамент, на котором ничего нет
L.blank = function(c)
	Props.plinth(c.m, spot(c.d, c.origin, 0, -15), 3, 3)
	hide(c, slotBack(c.d, c.origin, 10))
	ceil(c, 0, -15)
end

-- зал часов: напольные часы вдоль одной стены, настенные на другой,
-- астрономические часы не по центру
L.clocks = function(c)
	local d, o = c.d, c.origin
	for k, z in { -7, -11, -15, -19 } do
		Props.grandfatherClock(c.m, slotL(d, o, z), d.door + k)
	end
	Props.wallClock(c.m, slotR(d, o, -8) * CFrame.new(0, 8, F - 0.6), 1.4, d.door)
	Props.wallClock(c.m, slotR(d, o, -14) * CFrame.new(0, 6.5, F - 0.6), 0.9, d.door + 3)
	Props.wallClock(c.m, slotR(d, o, -13) * CFrame.new(0, 10, F - 0.6), 0.7, d.door + 5)
	wallCase(c, 1, -21)
	Props.astroClock(c.m, spot(d, o, 5, -19, 0.3), d.door)
	case(c, -6, -26, 1, "clock")
	hide(c, slotBack(d, o, -10))
	hide(c, slotBack(d, o, 10))
	ceil(c, -4, -10)
	ceil(c, 4, -26)
end

-- музыкальный зал: рояль у стены, арфа, ударные, виолончель и скрипки, граммофон
L.music = function(c)
	local d, o = c.d, c.origin
	Props.piano(c.m, slotL(d, o, -12))
	Props.harp(c.m, spot(d, o, -8, -22, 0.4))
	Props.rug(c.m, spot(d, o, 7, -12), 7, 6, rgb(70, 30, 40))
	Props.drumKit(c.m, spot(d, o, 7, -12, math.pi))
	Props.stringInstrument(c.m, spot(d, o, 9, -21, -0.3), true)
	Props.stringInstrument(c.m, spot(d, o, 5, -23, 0.2), false)
	Props.stringInstrument(c.m, spot(d, o, 12, -18, -0.5), false)
	Props.gramophone(c.m, spot(d, o, -3, -27, 0.5))
	wallCase(c, 1, -8)
	painting(c, -1, -22, 8, 3, 2.4)
	hide(c, slotBack(d, o, -10))
	hide(c, slotBack(d, o, 10))
	ceil(c, -6, -10)
	ceil(c, 6, -24)
	chandelier(c, 0, -17, 3)
end

-- археология: раскоп с костями, таблички с письменами, амфоры, стеллаж с находками
L.archaeology = function(c)
	local d, o = c.d, c.origin
	Props.digPit(c.m, spot(d, o, -6, -22), 10, 12, d.door)
	for k, z in { -10, -18, -26 } do
		Props.tablet(c.m, spot(d, o, 12, z, math.pi / 2), d.door + k)
	end
	Props.vase(c.m, spot(d, o, -14, -9), d.door * 4)
	Props.vase(c.m, spot(d, o, -12, -33), d.door * 4 + 1)
	Props.rack(c.m, slotL(d, o, -9), 6, d.door)
	case(c, 4, -34, 1, "skull")
	case(c, 13, -33, 2, "mask")
	hide(c, slotBack(d, o, -14))
	hide(c, slotBack(d, o, 14))
	ceil(c, -6, -22)
	ceil(c, 10, -12)
	ceil(c, 10, -32)
end

-- древние механизмы: шестерни на стенах, планетарий, маятник, верстак с ящиками
L.mechanisms = function(c)
	local d, o = c.d, c.origin
	Props.bigGear(c.m, slotL(d, o, -10) * CFrame.new(0, 7, F - 0.6), 3, d.door)
	Props.bigGear(c.m, slotL(d, o, -19) * CFrame.new(0, 4.5, F - 0.6), 2, d.door + 1)
	Props.bigGear(c.m, slotR(d, o, -14) * CFrame.new(0, 8, F - 0.6), 3.6, d.door + 2)
	Props.orrery(c.m, spot(d, o, -6, -24), d.door)
	Props.pendulum(c.m, spot(d, o, 7, -20), c.info.top)
	search(c, "desk", slotR(d, o, -24))
	Props.crate(c.m, spot(d, o, 12, -6))
	hide(c, slotBack(d, o, -12))
	hide(c, slotBack(d, o, 12))
	ceil(c, -5, -12)
	ceil(c, 5, -28)
end

-- переход к залу Колосса: парадный коридор со статуями
L.passage = function(c)
	local d, o = c.d, c.origin
	for k, z in { -10, -22, -34 } do
		statue(c, -5.6, z, k)
		statue(c, 5.6, z, k + 2)
	end
	hide(c, slotL(d, o, -28))
	Props.rug(c.m, spot(d, o, 0, -22), 5, 38, rgb(100, 26, 32))
	chandelier(c, 0, -12, 3)
	chandelier(c, 0, -32, 3)
end

L.figures = function(c)
	bench(c, -1, -12, 7)
	bench(c, 1, -12, 7)
	chandelier(c, 0, -20, 3)
	ceil(c, -10, -32)
	ceil(c, 10, -32)
end

-- очень длинный коридор без потолка: в стенах проломы, за ними только тьма
L.voidhall = function(c)
	local d, o = c.d, c.origin
	d.noCeiling = true
	d.gaps = { { side = -1, z = -40, w = 16 }, { side = 1, z = -80, w = 16 }, { side = -1, z = -118, w = 16 }, { side = 1, z = -152, w = 16 } }
	hide(c, slotL(d, o, -66))
	hide(c, slotR(d, o, -102))
	for k, g in d.gaps do
		local gp = P(c.m, "VoidGap", Vector3.new(1, d.h, g.w), at(o, g.side * (d.w / 2 + 1.5), d.h / 2, g.z), rgb(0, 0, 0), M.SmoothPlastic, nc({ Transparency = 1 }))
		gp:SetAttribute("Dir", o.RightVector * g.side)
		gp:SetAttribute("Width", g.w)
		game:GetService("CollectionService"):AddTag(gp, "VoidGap")
		-- обломки стены у пролома
		for j = -1, 1, 2 do
			P(c.m, "Rubble", Vector3.new(1.6, 1, 1.2), at(o, g.side * (d.w / 2 - 1.6), 0.5, g.z + j * (g.w / 2 + 0.2 + k * 0.1)) * CFrame.Angles(0, k + j, 0), rgb(96, 90, 84), M.Slate, nc())
		end
	end
	for k, z in { -18, -52, -96, -134, -168 } do
		local slot = if k % 2 == 1 then slotL else slotR
		local _, shade = Props.sconce(c.m, slot(d, o, z) * CFrame.new(0, 8, F - 0.6))
		table.insert(c.info.lights, shade)
	end
	-- арки поперёк коридора: пилястры у стен и балка над головой, под открытой тьмой
	local stone = rgb(150, 142, 128)
	for z = -10, -(d.l - 8), -13 do
		local ok = true
		for _, g in d.gaps do
			if math.abs(z - g.z) &lt; g.w / 2 + 2.5 then
				ok = false
			end
		end
		for _, bad in { -18, -52, -96, -134, -168, -66, -102 } do
			if math.abs(z - bad) &lt; 3 then
				ok = false
			end
		end
		if ok then
			for _, sx in { -1, 1 } do
				P(c.m, "Pilaster", Vector3.new(0.9, d.h - 0.1, 1.6), at(o, sx * (d.w / 2 - 1.2), (d.h - 0.1) / 2, z), stone, M.Limestone)
				P(c.m, "PilasterCap", Vector3.new(1.3, 0.5, 2), at(o, sx * (d.w / 2 - 1.3), d.h - 2.6, z), stone:Lerp(rgb(0, 0, 0), 0.15), M.Limestone, nc())
			end
			P(c.m, "ArchBeam", Vector3.new(d.w - 2.6, 1.2, 1.4), at(o, 0, d.h - 1.3, z), stone, M.Limestone, nc())
			P(c.m, "Keystone", Vector3.new(1.2, 1.6, 1.6), at(o, 0, d.h - 1.25, z), stone:Lerp(rgb(255, 255, 255), 0.1), M.Limestone, nc())
			for _, sx in { -1, 1 } do
				P(c.m, "Haunch", Vector3.new(1.4, 1, 1.3), at(o, sx * (d.w / 2 - 2.3), d.h - 2.1, z) * CFrame.Angles(0, 0, sx * 0.7), stone, M.Limestone, nc())
			end
		end
	end
	-- чёрная оболочка далеко вокруг: в проломах и над головой только тьма
	local shell = Props.model(c.m, "VoidShell")
	local black = rgb(0, 0, 0)
	for _, s in { -1, 1 } do
		P(shell, "Dark", Vector3.new(2, 240, d.l + 80), at(o, s * 80, 0, -d.l / 2), black, M.SmoothPlastic, nc())
	end
	P(shell, "Dark", Vector3.new(164, 2, d.l + 80), at(o, 0, 110, -d.l / 2), black, M.SmoothPlastic, nc())
end

-- Пристройка к залу: небольшой туалет за служебной дверью в боковой стене
function Builder.annex(m, d, origin: CFrame, rand)
	local A = Plan.ANNEX_SIZE
	local s = d.annex.side
	local o2 = origin * CFrame.new(s * d.w / 2, 0, d.annex.z) * CFrame.Angles(0, -s * math.pi / 2, 0)
	local d2 = { kind = "restroom", door = d.door, zone = d.zone, w = A.w, l = A.l, h = A.h, dy = 0, decoys = {}, noExit = true, entry = Props.DOORS.small, exit = { x = 0, z = -A.l, turn = 0, y = 0 } }
	local am = Props.model(m, "Annex")
	local keep = Props.LIGHT
	Props.LIGHT = d.light or 1
	-- общую стену строит сам зал: пристройке она не нужна
	shell(am, d2, o2, Builder.style(d2, rand), { x0 = -1e4, x1 = 1e4, top = 1e4, bottom = -1e4 })
	Props.stallRow(am, slotL(d2, o2, -8.6), 2)
	Props.sinkRow(am, slotR(d2, o2, -8.6), 2)
	C(am, "Bin", 2, 1.2, at(o2, 6.6, 1, -14.2), rgb(120, 124, 126), M.Metal)
	Props.ceilingLamp(am, at(o2, 0, A.h, -8).Position)
	-- служебная дверь стоит открытой
	local _, leaves = Props.door(m, o2, nil, false, "small")
	for _, leaf in leaves do
		leaf:PivotTo(leaf:GetPivot() * CFrame.Angles(0, math.rad(-100) * (leaf:GetAttribute("Dir") or 1), 0))
	end
	Props.LIGHT = keep
	return am
end

-- ---------------------------------------------------------------------------

function Builder.build(parent: Instance, d, origin: CFrame, prevInfo, rand)
	rand = rand or Plan.rng(d.door * 31 + 7)
	local st = Builder.style(d, rand)
	local m = Props.model(parent, string.format("Room_%03d", d.door))
	local info = { desc = d, model = m, origin = origin, hideSpots = {}, searchables = {}, tops = {}, lights = {} }
	Props.LIGHT = d.light or 1
	d.exitHole = d.exitHole or Props.DOORS[d.exitSize or "normal"]
	d.entry = d.entry or Props.DOORS[d.entrySize or "normal"]
	info.top = math.max(0, d.dy) + d.h
	local ctx = { d = d, origin = origin, m = m, info = info, hides = d.hides or 0 }
	local layout = L[d.kind]
	if layout then
		layout(ctx)
	end
	local sh = shell(m, d, origin, st, Builder.prevWallFor(prevInfo, origin))
	for k, v in sh do
		info[k] = v
	end
	info.style = st
	if d.annex then
		Builder.annex(m, d, origin, rand)
	end
	-- путь для Тьмы и точки для существ
	info.path = {
		at(origin, 0, 5, -2).Position,
		at(origin, 0, floorAt(d, -d.l / 2) + 5, -d.l / 2).Position,
		(info.exitCF * CFrame.new(0, 5, 2.5)).Position,
	}
	info.center = at(origin, 0, info.top / 2, -d.l / 2)
	info.size = Vector3.new(d.w, info.top - info.ybase, d.l)
	-- аномалия: весь зал одного цвета (кроме стекла и ламп)
	if d.mono then
		local col = Color3.fromHSV(rand(), 0.25, 0.3 + rand() * 0.4)
		for _, p in m:GetDescendants() do
			if p:IsA("BasePart") and (p.Transparency or 0) &lt; 0.5 and p.Material ~= M.Glass and p.Material ~= M.Neon then
				p.Color = col
				p.Material = M.SmoothPlastic
			end
		end
	end
	Props.LIGHT = 1
	return info
end

-- Игрок внутри комнаты
function Builder.contains(info, pos: Vector3): boolean
	local lp = info.origin:PointToObjectSpace(pos)
	local d = info.desc
	return math.abs(lp.X) &lt;= d.w / 2 + 0.5 and lp.Z &lt;= 0.5 and lp.Z &gt;= -d.l - 0.5 and lp.Y &gt; (info.ybase or 0) - 3 and lp.Y &lt; (info.top or d.h) + 2
end

Builder.shell = shell
Builder.dress = dress
Builder.F = F

return Builder
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX0000001B">
          <Properties>
            <string name="Name">Special</string>
            <ProtectedString name="Source">--!nonstrict
-- Особые места музея: улица перед входом (лобби), Монетчик, зал с фигурками и тебЯ,
-- зал кодового замка, арена Колосса с зеркалами, лифт и лестница обслуживания,
-- заброшенный зал в конце локации

local CollectionService = game:GetService("CollectionService")
local Shared = game:GetService("ReplicatedStorage").Workshop.Shared
local M = require(Shared.Materials)
local Rules = require(Shared.Rules)
local Props = require(script.Parent.Props)
local Builder = require(script.Parent.RoomBuilder)

local P, C, S, nc, rgb = Props.P, Props.C, Props.S, Props.nc, Props.rgb
local at = Builder.at

local Special = {}

local function ghost(extra)
	local t = { Transparency = 1, CanCollide = false, CanQuery = false, CastShadow = false }
	for k, v in extra or {} do
		t[k] = v
	end
	return t
end

-- каркас особого зала: стены, пол, потолок, общие поля
local function begin(parent, d, origin: CFrame, rand, prev, tweak)
	local m = Props.model(parent, string.format("Room_%03d", d.door))
	local info = { desc = d, model = m, origin = origin, hideSpots = {}, searchables = {}, tops = {}, lights = {} }
	d.decoys = d.decoys or {}
	d.exitHole = d.exitHole or Props.DOORS[d.exitSize or "normal"]
	d.entry = d.entry or Props.DOORS[d.entrySize or "normal"]
	info.top = math.max(0, d.dy) + d.h
	Props.LIGHT = d.light or 1
	local st = Builder.style(d, rand)
	if tweak then
		tweak(st)
	end
	local sh = Builder.shell(m, d, origin, st, Builder.prevWallFor(prev, origin))
	for k, v in sh do
		info[k] = v
	end
	info.style = st
	info.center = at(origin, 0, info.top / 2, -d.l / 2)
	info.size = Vector3.new(d.w, info.top - info.ybase, d.l)
	info.path = { at(origin, 0, 5, -2).Position, at(origin, 0, d.dy + 5, -d.l / 2).Position, (info.exitCF * CFrame.new(0, 5, 2.5)).Position }
	return m, info, st
end

local function lamp(info, m, pos: Vector3)
	local _, bulb = Props.ceilingLamp(m, pos)
	table.insert(info.lights, bulb)
end

local function chandelier(info, m, pos: Vector3, drop: number)
	local _, core = Props.chandelier(m, pos, drop)
	table.insert(info.lights, core)
end

local function surfaceText(part: BasePart, face: Enum.NormalId, text: string, key: string?, color: Color3?, pps: number?)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pps or 30
	gui.Parent = part
	local t = Instance.new("TextLabel")
	t.Name = "Text"
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(1, 1)
	t.Font = Enum.Font.Antique
	t.TextScaled = true
	t.TextColor3 = color or rgb(226, 210, 170)
	t.Text = text
	if key then
		t:SetAttribute("LangKey", key)
	end
	t.Parent = gui
	return t
end

-- ---------------------------------------------------------------------------
-- Лобби: ночная улица перед большим музеем. Вход — приоткрытые двери во тьму

function Special.lobby(parent)
	local m = Props.model(parent, "Lobby")
	local stone = rgb(150, 146, 138)
	local cobble = rgb(110, 106, 100)
	local rnd = Random.new(7)
	P(m, "Ground", Vector3.new(420, 1, 640), CFrame.new(20, -0.5, -170), rgb(34, 52, 36), M.Grass)
	P(m, "Path", Vector3.new(14, 0.2, 86), CFrame.new(0, 0.1, -11), cobble, M.Cobblestone)
	-- крыльцо с пологими ступенями (по ним идут без прыжка)
	P(m, "Porch", Vector3.new(46, 1.6, 22), CFrame.new(0, 0.8, -71), stone, M.Marble)
	for k = 0, 3 do
		P(m, "Stair", Vector3.new(40, 0.4 * (k + 1), 1.5), CFrame.new(0, 0.2 * (k + 1), -54.75 - k * 1.5), stone:Lerp(rgb(0, 0, 0), 0.1), M.Marble, nc())
	end
	local rampLen = math.sqrt(6 * 6 + 1.6 * 1.6)
	P(m, "StairRamp", Vector3.new(40, 0.4, rampLen), CFrame.new(0, 0.6, -57) * CFrame.Angles(math.atan2(1.6, 6), 0, 0), stone, M.Marble, { Transparency = 1, CastShadow = false })
	-- большой фасад с проёмом, колоннами и фронтоном, за ним — корпус музея
	Props.wall(m, CFrame.new(0, 1.6, -76), 130, 0, 44, 4, { { x = 0, w = 10, y = 0, h = 14 } }, rgb(128, 124, 116), M.Limestone, "Facade")
	P(m, "FacadeBase", Vector3.new(130, 1.6, 4), CFrame.new(0, 0.8, -76.01), rgb(100, 96, 90), M.Limestone)
	P(m, "MuseumBody", Vector3.new(126, 42, 60), CFrame.new(0, 22.6, -120), rgb(112, 108, 100), M.Limestone)
	P(m, "MuseumRoof", Vector3.new(132, 2, 76), CFrame.new(0, 44.6, -114), rgb(70, 66, 62), M.Slate)
	for _, sx in { -1, 1 } do
		P(m, "MuseumSide", Vector3.new(2, 42, 12), CFrame.new(sx * 62, 22.6, -84), rgb(112, 108, 100), M.Limestone)
		-- боковые крылья
		P(m, "Wing", Vector3.new(30, 28, 50), CFrame.new(sx * 80, 14, -112), rgb(120, 116, 108), M.Limestone)
		P(m, "WingRoof", Vector3.new(32, 1.6, 52), CFrame.new(sx * 80, 28.8, -112), rgb(70, 66, 62), M.Slate)
		for k = 0, 2 do
			P(m, "WingWindow", Vector3.new(5, 9, 0.2), CFrame.new(sx * (70 + k * 10), 13, -86.9), rgb(8, 10, 14), M.Glass, nc({ Reflectance = 0.2 }))
		end
	end
	P(m, "Dome", Vector3.new(30, 30, 30), CFrame.new(0, 46, -122), rgb(96, 110, 104), M.Slate, { Shape = Enum.PartType.Ball })
	for _, x in { -20, -13, -6, 6, 13, 20 } do
		C(m, "Column", 26, 3, CFrame.new(x, 14.6, -63), rgb(200, 196, 186), M.Marble)
		P(m, "ColumnBase", Vector3.new(3.8, 0.8, 3.8), CFrame.new(x, 2, -63), stone, M.Marble)
		P(m, "ColumnCap", Vector3.new(3.8, 0.8, 3.8), CFrame.new(x, 27.2, -63), stone, M.Marble)
	end
	P(m, "Entablature", Vector3.new(48, 3.4, 16), CFrame.new(0, 29.3, -68), stone, M.Marble)
	for k = 0, 4 do
		P(m, "Pediment", Vector3.new(46 - k * 9, 1.6, 15), CFrame.new(0, 31.8 + k * 1.6, -68), rgb(170, 166, 158), M.Marble, nc())
	end
	local sign = P(m, "Sign", Vector3.new(22, 2.4, 0.3), CFrame.new(0, 29.3, -59.84), rgb(60, 56, 52), M.Slate, nc())
	surfaceText(sign, Enum.NormalId.Back, "MUSEUM", "MuseumSign", rgb(214, 190, 130), 20)
	-- приоткрытые двери, за ними тьма; войти — кнопкой у порога
	local floorIn = P(m, "Threshold", Vector3.new(12, 1.6, 8), CFrame.new(0, 0.8, -86), rgb(20, 20, 20), M.Slate)
	local _ = floorIn
	for _, s in { -1, 1 } do
		P(m, "DoorLeaf", Vector3.new(5, 13.8, 0.4), CFrame.new(s * 5, 8.5, -74) * CFrame.Angles(0, s * math.rad(62), 0) * CFrame.new(-s * 2.5, 0, 0), rgb(52, 34, 24), M.WoodPlanks)
		P(m, "DarkSide", Vector3.new(1, 16, 9), CFrame.new(s * 6.5, 9.6, -82.5), rgb(0, 0, 0), M.SmoothPlastic)
	end
	P(m, "Dark", Vector3.new(14, 16, 1), CFrame.new(0, 9.6, -87.5), rgb(0, 0, 0), M.SmoothPlastic)
	P(m, "DarkTop", Vector3.new(14, 1, 10), CFrame.new(0, 17.5, -83), rgb(0, 0, 0), M.SmoothPlastic, nc())
	local zone = P(m, "EnterZone", Vector3.new(9, 12, 6), CFrame.new(0, 7.6, -82), rgb(0, 0, 0), M.SmoothPlastic, ghost())
	local enter = P(m, "EnterDoor", Vector3.new(8, 8, 1), CFrame.new(0, 6, -76.5), rgb(0, 0, 0), M.SmoothPlastic, ghost())
	local enterPrompt = Props.prompt(enter, "enter", 0.6, 10)
	-- тёмные окна фасада
	for _, x in { -52, -38, 38, 52 } do
		P(m, "Window", Vector3.new(6, 12, 0.2), CFrame.new(x, 16, -73.88), rgb(8, 10, 14), M.Glass, nc({ Reflectance = 0.2 }))
		P(m, "WindowSill", Vector3.new(7.4, 0.6, 1), CFrame.new(x, 9.7, -73.6), stone, M.Marble, nc())
		P(m, "WindowHead", Vector3.new(7.4, 0.8, 0.8), CFrame.new(x, 22.4, -73.7), stone, M.Marble, nc())
	end
	-- клумбы у крыльца
	for _, sx in { -1, 1 } do
		P(m, "FlowerBed", Vector3.new(12, 0.8, 5), CFrame.new(sx * 16, 0.4, -50), stone, M.Marble)
		P(m, "Soil", Vector3.new(11, 0.2, 4), CFrame.new(sx * 16, 0.85, -50), rgb(60, 40, 28), M.Ground, nc())
		for k = 0, 6 do
			S(m, "Flower", 0.7, CFrame.new(sx * 16 - 4.5 + k * 1.5, 1.3, -50 + (k % 2) - 0.5), ({ rgb(190, 60, 70), rgb(220, 200, 90), rgb(200, 120, 180) })[k % 3 + 1], M.SmoothPlastic, nc())
		end
	end

	-- длинная извилистая тропа через деревья ко второму входу ----------------------
	local trail = { { 7, 8 }, { 22, 14 }, { 36, 6 }, { 44, -10 }, { 60, -18 }, { 76, -8 }, { 92, -16 }, { 100, -34 }, { 112, -46 }, { 129, -50 } }
	local function nearTrail(x: number, z: number, r: number): boolean
		for i = 1, #trail - 1 do
			local a, b = trail[i], trail[i + 1]
			local dx, dz = b[1] - a[1], b[2] - a[2]
			local t = math.clamp(((x - a[1]) * dx + (z - a[2]) * dz) / (dx * dx + dz * dz), 0, 1)
			local px, pz = a[1] + dx * t - x, a[2] + dz * t - z
			if px * px + pz * pz &lt; r * r then
				return true
			end
		end
		return false
	end
	for i = 1, #trail - 1 do
		local a = Vector3.new(trail[i][1], 0.1, trail[i][2])
		local b = Vector3.new(trail[i + 1][1], 0.1, trail[i + 1][2])
		local len = (b - a).Magnitude
		P(m, "Trail", Vector3.new(6, 0.2 + (i % 2) * 0.02, len), CFrame.lookAt((a + b) / 2, b), cobble:Lerp(rgb(80, 70, 56), 0.3), M.Cobblestone, nc())
		if i &gt; 1 then
			C(m, "TrailBend", 0.2 + ((i + 1) % 2) * 0.02 + 0.01, 6, CFrame.new(a), cobble:Lerp(rgb(80, 70, 56), 0.3), M.Cobblestone, nc())
		end
		if i % 2 == 0 then
			local dir = (b - a).Unit
			local side = Vector3.new(-dir.Z, 0, dir.X) * 4.6
			Props.lampPost(m, CFrame.new(a + side + Vector3.new(0, -0.1, 0)))
		end
	end

	-- бесконечный фасад: одно и то же крыло повторяется и уходит вдаль --------------
	local FX = 134
	local endless = Props.model(m, "EndlessWing")
	local wallC, trim = rgb(118, 114, 108), rgb(150, 146, 138)
	local MOD = 12
	for k = 0, 40 do
		local z = 60 - k * MOD
		local cz = z - MOD / 2
		local isDoor = math.abs(cz - (-50)) &lt; MOD / 2
		local front = FX - 2
		if isDoor then
			Props.wall(endless, CFrame.new(FX, 0, cz) * CFrame.Angles(0, math.pi / 2, 0), MOD, 0, 30, 4, { { x = 0, w = 6, y = 0, h = 9 } }, wallC, M.Limestone, "EndlessWall")
		else
			P(endless, "EndlessWall", Vector3.new(4, 30, MOD), CFrame.new(FX, 15, cz), wallC, M.Limestone)
			P(endless, "EndlessWindow", Vector3.new(0.2, 10, 5), CFrame.new(front - 0.08, 13, cz), rgb(10, 12, 16), M.Glass, nc({ Reflectance = 0.15 }))
			P(endless, "EndlessSill", Vector3.new(1, 0.5, 6), CFrame.new(front - 0.4, 7.8, cz), trim, M.Marble, nc())
		end
		C(endless, "EndlessColumn", 28, 2.4, CFrame.new(front - 1.4, 14, z), rgb(196, 192, 182), M.Marble)
		P(endless, "EndlessCornice", Vector3.new(3, 1.4, MOD), CFrame.new(front - 0.5, 30.4, cz), trim, M.Marble, nc())
		P(endless, "EndlessRoof", Vector3.new(16, 1.4, MOD), CFrame.new(FX + 6, 31.2, cz), rgb(70, 66, 62), M.Slate, nc())
	end
	-- заколоченная дверь и вывеска «скоро»
	P(endless, "EndlessDoor", Vector3.new(0.4, 9, 6), CFrame.new(FX + 1.5, 4.5, -50), rgb(30, 22, 18), M.WoodPlanks, nc())
	for k = -1, 1 do
		P(endless, "Board", Vector3.new(0.3, 0.9, 8), CFrame.new(FX - 2.3, 4.6 + k * 2.4, -50) * CFrame.Angles(k * 0.25, 0, 0), rgb(96, 70, 44), M.WoodPlanks, nc())
	end
	local soon = P(endless, "SoonSign", Vector3.new(0.3, 4, 16), CFrame.new(FX - 2.3, 13, -50), rgb(40, 30, 24), M.Wood, nc())
	surfaceText(soon, Enum.NormalId.Left, "", "EndlessSoon", rgb(226, 200, 140), 20)

	-- доска достижений у дорожки
	local board = P(m, "AchBoard", Vector3.new(0.4, 5, 7), CFrame.new(-11.5, 3.6, 16), rgb(56, 40, 28), M.Wood)
	for _, dz in { -3, 3 } do
		P(m, "AchPost", Vector3.new(0.5, 6.2, 0.5), CFrame.new(-11.5, 3.1, 16 + dz), rgb(46, 32, 22), M.Wood, nc())
	end
	surfaceText(board, Enum.NormalId.Right, "", "Achievements", rgb(230, 196, 120), 30)
	local achPrompt = Props.prompt(board, "ach", 0, 9)

	-- фонари вдоль главной дорожки, скамейки
	for _, z in { 24, 4, -16, -40 } do
		Props.lampPost(m, CFrame.new(-9.5, 0, z))
		Props.lampPost(m, CFrame.new(9.5, 0, z))
	end
	Props.bench(m, CFrame.new(-8.5, 0, -6) * CFrame.Angles(0, -math.pi / 2, 0), 7)
	Props.bench(m, CFrame.new(8.5, 0, -26) * CFrame.Angles(0, math.pi / 2, 0), 7)

	-- деревья разных размеров, кусты и трава — вразброс, но не на дорожках -------------
	local function free(x: number, z: number, r: number): boolean
		if math.abs(x) &lt; 12 + r and z &gt; -60 and z &lt; 40 then
			return false -- главная дорожка
		end
		if z &lt; -44 - r and math.abs(x) &lt; 98 then
			return false -- крыльцо и корпус
		end
		if x &gt; FX - 8 - r then
			return false -- бесконечное крыло
		end
		if nearTrail(x, z, 5 + r) then
			return false
		end
		if math.abs(x + 11.5) &lt; 3 + r and math.abs(z - 16) &lt; 6 + r then
			return false -- доска
		end
		return true
	end
	local k = 0
	local tries = 0
	while k &lt; 120 and tries &lt; 2000 do
		tries += 1
		local x, z = rnd:NextNumber(-104, 128), rnd:NextNumber(-126, 58)
		if free(x, z, 3) then
			k += 1
			Props.tree(m, CFrame.new(x, 0, z) * CFrame.Angles(0, rnd:NextNumber(0, 6.28), 0), rnd:NextInteger(8, 24), k)
		end
	end
	local bushes = 0
	tries = 0
	while bushes &lt; 70 and tries &lt; 2000 do
		tries += 1
		local x, z = rnd:NextNumber(-100, 126), rnd:NextNumber(-120, 56)
		if free(x, z, 1) then
			bushes += 1
			local g = rgb(30, 64, 34):Lerp(rgb(48, 84, 40), rnd:NextNumber())
			local s1 = rnd:NextNumber(2.4, 4.2)
			S(m, "Bush", s1, CFrame.new(x, s1 * 0.3, z), g, M.Grass, nc())
			S(m, "Bush", s1 * 0.7, CFrame.new(x + s1 * 0.4, s1 * 0.22, z - s1 * 0.2), g, M.Grass, nc())
		end
	end
	-- пучки высокой травы у дорожек
	for i = 1, 90 do
		local x, z = rnd:NextNumber(-60, 120), rnd:NextNumber(-70, 50)
		if free(x, z, 0.5) or (math.abs(x) &gt; 8 and math.abs(x) &lt; 14 and z &gt; -50 and z &lt; 30) then
			local h = rnd:NextNumber(0.8, 1.8)
			P(m, "Grass", Vector3.new(0.6, h, 0.1), CFrame.new(x, h / 2, z) * CFrame.Angles(rnd:NextNumber(-0.3, 0.3), rnd:NextNumber(0, 3), 0), rgb(50, 90, 44), M.Grass, nc({ CastShadow = false }))
			local _ = i
		end
	end

	-- округа за оградой: тёмные дома, деревья, всё уходит дальше ----------------------
	for i, h in { { -150, 40, 26 }, { -160, -10, 34 }, { -146, -70, 22 }, { -40, 110, 30 }, { 30, 118, 24 }, { 90, 106, 36 } } do
		P(m, "FarHouse", Vector3.new(24, h[3], 20), CFrame.new(h[1], h[3] / 2, h[2]), rgb(52, 50, 54), M.Concrete, nc())
		P(m, "FarRoof", Vector3.new(26, 2, 22), CFrame.new(h[1], h[3] + 1, h[2]), rgb(36, 34, 38), M.Slate, nc())
		P(m, "FarWindow", Vector3.new(3, 4, 0.2), CFrame.new(h[1] + 4, h[3] * 0.6, h[2] + (if h[2] &gt; 0 then -10.05 else 10.05)), rgb(255, 196, 120), M.Neon, nc({ Transparency = if i % 2 == 0 then 0.2 else 0.7 }))
	end
	for i = 1, 30 do
		local a = rnd:NextNumber(0, math.pi * 2)
		local r = rnd:NextNumber(130, 175)
		local x, z = math.cos(a) * r + 10, math.sin(a) * r - 30
		if x &lt; FX - 10 then
			Props.tree(m, CFrame.new(x, 0, z), rnd:NextInteger(14, 26), 200 + i)
		end
	end
	-- невидимая ограда вокруг улицы
	for _, w in { { 10, 62, 244, 2 }, { -110, -20, 2, 166 }, { -86, -102, 50, 2 }, { 96, -130, 72, 2 }, { 131, 60, 2, 6 } } do
		P(m, "Fence", Vector3.new(w[3], 60, w[4]), CFrame.new(w[1], 30, w[2]), rgb(0, 0, 0), M.SmoothPlastic, { Transparency = 1, CastShadow = false })
	end
	return { model = m, zone = zone, enter = enterPrompt, ach = achPrompt, spawn = CFrame.new(0, 3.2, 28) }
end

-- ---------------------------------------------------------------------------
-- Монетчик: золотая монета с усами. Стоит перед дверью; рядом в стене его норка

function Special.coinKeeper(parent, cf: CFrame, price: number, holeCF: CFrame)
	-- небольшая золотая монета на тонких ножках: без глаз, с пышными усами и тростью,
	-- которую он никогда не выпускает; держится строго и почти не двигается
	local m = Props.model(parent, "CoinKeeper")
	local gold, dark = rgb(222, 180, 66), rgb(160, 120, 36)
	local face = cf * CFrame.new(0, 2.75, 0)
	local flatR = CFrame.Angles(math.pi / 2, 0, 0)
	C(m, "Rim", 0.4, 2.9, face * flatR, dark, M.Metal)
	C(m, "Face", 0.56, 2.5, face * flatR, gold, M.Metal, nc())
	for k = 0, 15 do
		P(m, "Mill", Vector3.new(0.2, 0.24, 0.34), face * CFrame.Angles(0, 0, k * math.pi / 8) * CFrame.new(0, 1.46, 0), dark, M.Metal, nc())
	end
	-- выпуклый профиль носа и усы — единственное «лицо»
	P(m, "Nose", Vector3.new(0.3, 0.6, 0.2), face * CFrame.new(0, 0.2, -0.36), dark, M.Metal, nc())
	for _, x in { -1, 1 } do
		local a = (face * CFrame.new(x * 0.12, -0.2, -0.36)).Position
		local b = (face * CFrame.new(x * 0.8, -0.38, -0.38)).Position
		local c = (face * CFrame.new(x * 1.2, -0.05, -0.38)).Position
		Props.rod(m, "Moustache", a, b, 0.26, rgb(36, 24, 14), M.SmoothPlastic, nc())
		Props.rod(m, "Moustache", b, c, 0.18, rgb(36, 24, 14), M.SmoothPlastic, nc())
		S(m, "Curl", 0.24, CFrame.new(c), rgb(36, 24, 14), M.SmoothPlastic, nc())
		local hip = (face * CFrame.new(x * 0.55, -1.3, 0)).Position
		local foot = (face * CFrame.new(x * 0.6, -2.45, 0)).Position
		Props.rod(m, "Leg", hip, foot, 0.16, dark, M.Metal, nc())
		P(m, "Shoe", Vector3.new(0.42, 0.24, 0.7), CFrame.new(foot) * cf.Rotation * CFrame.new(0, -0.05, -0.15), rgb(28, 20, 14), M.SmoothPlastic, nc())
	end
	-- левая рука упёрта в бок, правая держит трость
	local shL = (face * CFrame.new(-1.45, -0.1, 0)).Position
	local elL = (face * CFrame.new(-1.95, -0.55, -0.1)).Position
	local hdL = (face * CFrame.new(-1.45, -0.95, -0.1)).Position
	Props.rod(m, "Arm", shL, elL, 0.15, dark, M.Metal, nc())
	Props.rod(m, "Arm", elL, hdL, 0.15, dark, M.Metal, nc())
	S(m, "Hand", 0.3, CFrame.new(hdL), gold, M.Metal, nc())
	local shR = (face * CFrame.new(1.45, -0.1, 0)).Position
	local hdR = (face * CFrame.new(1.95, -0.7, -0.5)).Position
	Props.rod(m, "Arm", shR, hdR, 0.15, dark, M.Metal, nc())
	S(m, "Hand", 0.3, CFrame.new(hdR), gold, M.Metal, nc())
	local caneTop = hdR + Vector3.new(0, 0.12, 0)
	local caneFoot = (cf * CFrame.new(2.15, 0.02, -0.65)).Position
	Props.rod(m, "Cane", caneTop, caneFoot, 0.12, rgb(20, 16, 14), M.Wood, nc())
	S(m, "CaneKnob", 0.26, CFrame.new(caneTop + Vector3.new(0, 0.12, 0)), gold, M.Metal, nc())
	C(m, "CaneTip", 0.12, 0.16, CFrame.new(caneFoot + Vector3.new(0, 0.03, 0)), rgb(200, 200, 200), M.Metal, nc())
	local glow = Instance.new("PointLight")
	glow.Range = 12
	glow.Brightness = 0.7
	glow.Color = rgb(255, 200, 90)
	glow.Parent = m:FindFirstChild("Face")
	local talk = P(m, "Talk", Vector3.new(2, 2, 2), face * CFrame.new(0, 0, -1), rgb(0, 0, 0), M.SmoothPlastic, ghost())
	local pr = Props.prompt(talk, "talk", 0, 10)
	pr:SetAttribute("Price", price)
	m.WorldPivot = cf
	CollectionService:AddTag(m, "CoinKeeper")
	-- невидимая стенка: мимо него не пройти (не часть самой монеты, чтобы не ездила)
	local block = P(parent, "CoinBlock", Vector3.new(9, 12, 1.2), cf * CFrame.new(0, 6, 0.9), rgb(0, 0, 0), M.SmoothPlastic, { Transparency = 1, CastShadow = false })
	-- норка в стене по его размеру
	local hole = Props.model(parent, "CoinHole")
	-- норка по его росту: человеку туда не пролезть
	P(hole, "Dark", Vector3.new(3.6, 4.4, 0.3), holeCF * CFrame.new(0, 2.2, 0.75), rgb(0, 0, 0), M.SmoothPlastic, nc())
	for _, s in { -1, 1 } do
		P(hole, "Jamb", Vector3.new(0.5, 4.6, 0.5), holeCF * CFrame.new(s * 2.05, 2.3, 0.9), rgb(120, 114, 104), M.Limestone, nc())
	end
	P(hole, "Arch", Vector3.new(5, 0.6, 0.6), holeCF * CFrame.new(0, 4.9, 0.9), rgb(120, 114, 104), M.Limestone, nc())
	P(hole, "Step", Vector3.new(3.8, 0.2, 0.5), holeCF * CFrame.new(0, 0.11, 0.95), rgb(100, 94, 86), M.Limestone, nc())
	return m, pr, block, hole
end

-- ---------------------------------------------------------------------------
-- Зал с фигурками: постаменты по цветам и фигурки, раскиданные по залу

local FIG_COLORS = { rgb(190, 40, 40), rgb(50, 90, 200), rgb(50, 150, 70), rgb(226, 190, 60), rgb(130, 60, 170), rgb(226, 120, 40), rgb(230, 230, 224), rgb(30, 30, 34) }

function Special.figures(info, rand)
	local d, o, m = info.desc, info.origin, info.model
	local n = 4 + math.floor(rand() * 5)
	local puzzle = { sockets = {}, figs = {}, n = n, placed = 0 }
	for k = 1, n do
		local x = (k - (n + 1) / 2) * 4.4
		local pm, top = Props.plinth(m, at(o, x, 0, -30), 1.6, 2.6)
		P(pm, "Mark", Vector3.new(1.3, 0.08, 1.3), top * CFrame.new(0, 0.04, 0), FIG_COLORS[k], M.SmoothPlastic, nc())
		local socket = P(pm, "Socket", Vector3.new(1.6, 1.6, 1.6), top * CFrame.new(0, 0.9, 0), rgb(0, 0, 0), M.SmoothPlastic, ghost({ CanQuery = true }))
		Props.prompt(socket, "place", 0, 7)
		puzzle.sockets[k] = { part = socket, color = k, top = top * CFrame.new(0, 0.08, 0), filled = false }
	end
	local spots = { { -16, -6 }, { 16, -6 }, { -16, -22 }, { 16, -22 }, { -12, -36 }, { 12, -36 }, { -7, -8 }, { 7, -8 } }
	for i = #spots, 2, -1 do
		local j = math.floor(rand() * i) + 1
		spots[i], spots[j] = spots[j], spots[i]
	end
	for k = 1, n do
		local cf = at(o, spots[k][1], 0, spots[k][2])
		local fm = Props.model(m, "Figurine")
		local col = FIG_COLORS[k]
		local root = C(fm, "Fig", 0.3, 1, cf * CFrame.new(0, 0.15, 0), col, M.SmoothPlastic, { CanCollide = false })
		C(fm, "Body", 0.9, 0.6, cf * CFrame.new(0, 0.75, 0), col, M.SmoothPlastic, nc())
		S(fm, "Head", 0.6, cf * CFrame.new(0, 1.45, 0), col, M.SmoothPlastic, nc())
		if k % 2 == 0 then
			P(fm, "Hat", Vector3.new(0.8, 0.12, 0.8), cf * CFrame.new(0, 1.8, 0), col:Lerp(rgb(0, 0, 0), 0.3), M.SmoothPlastic, nc())
		end
		fm.PrimaryPart = root
		Props.prompt(root, "take", 0, 7)
		puzzle.figs[k] = { model = fm, part = root, color = k, home = cf * CFrame.new(0, 0.15, 0) }
	end
	-- круглое основание, на котором стоит статуя
	C(m, "MimicBase", 0.4, 4.4, at(o, 0, 0.2, -20), rgb(150, 146, 138), M.Marble, nc())
	puzzle.mimicCF = at(o, 0, 0.4, -20) * CFrame.Angles(0, math.pi, 0)
	local _ = d
	info.puzzle = puzzle
	return puzzle
end

-- ---------------------------------------------------------------------------
-- Зал кодового замка: вход, два больших крыла налево и направо, запертая дверь по центру

local CODE_RGB = { red = rgb(190, 40, 40), blue = rgb(50, 90, 200), green = rgb(50, 150, 70), yellow = rgb(226, 190, 60) }

local function countShelf(m, cf: CFrame, color: Color3, count: number)
	local sm = Props.model(m, "CountShelf")
	local base = cf * CFrame.new(0, 0, -0.05)
	P(sm, "Shelf", Vector3.new(7, 0.3, 1.3), base * CFrame.new(0, 3.6, -0.65), Props.WOOD_DARK, M.Wood)
	for _, s in { -1, 1 } do
		P(sm, "Bracket", Vector3.new(0.3, 1.2, 1), base * CFrame.new(s * 2.8, 2.85, -0.5), Props.BRASS, M.Metal, nc())
	end
	P(sm, "Banner", Vector3.new(4.6, 3, 0.1), base * CFrame.new(0, 9, -0.05 + 0.3), color, M.Fabric, nc())
	P(sm, "BannerRod", Vector3.new(5.2, 0.2, 0.2), base * CFrame.new(0, 10.6, 0.15), Props.BRASS, M.Metal, nc())
	for k = 1, count do
		local x = (k - (count + 1) / 2) * 1.05
		local top = base * CFrame.new(x, 3.75, -0.65)
		C(sm, "Jar", 0.7, 0.6, top * CFrame.new(0, 0.35, 0), color:Lerp(rgb(255, 255, 255), 0.25), M.SmoothPlastic, nc())
		C(sm, "JarNeck", 0.25, 0.34, top * CFrame.new(0, 0.82, 0), color, M.SmoothPlastic, nc())
	end
	return sm
end

function Special.codeHall(parent, d, origin: CFrame, rand, prev)
	local m, info = begin(parent, d, origin, rand, prev, function(st)
		st.paper = rgb(52, 44, 66)
		st.floor = rgb(196, 190, 180)
		st.floorMat = M.Marble
	end)
	for _, s in { -1, 1 } do
		P(m, "Partition", Vector3.new(1.2, d.h, 27.33), at(origin, s * 14, d.h / 2, -29.665), info.style.paper:Lerp(rgb(0, 0, 0), 0.15), M.Plaster)
		chandelier(info, m, at(origin, s * 26, d.h, -22).Position, 3)
		local _, cavity = Props.locker(m, Builder.slotBack(d, origin, s * 30))
		table.insert(info.hideSpots, cavity)
		Props.statue(m, at(origin, s * 20, 0, -8), if s &lt; 0 then "figure" else "bust", 1)
		Props.bench(m, Builder.spot(d, origin, s * 14.65, -30, if s &lt; 0 then math.pi / 2 else -math.pi / 2), 7)
	end
	chandelier(info, m, at(origin, 0, d.h, -22).Position, 4)
	Props.rug(m, at(origin, 0, 0, -22), 9, 34, rgb(100, 26, 32))
	local code = Rules.code(rand)
	local slots = { Builder.slotL(d, origin, -12), Builder.slotL(d, origin, -32), Builder.slotR(d, origin, -12), Builder.slotR(d, origin, -32) }
	for i, name in Rules.COLORS do
		countShelf(m, slots[i], CODE_RGB[name], code.digits[i])
	end
	-- замок справа от двери: четыре цветных окошка по порядку
	local pcf = Builder.slotFront(d, origin, -8) * CFrame.new(0, 5, 0.1)
	local panel = P(m, "CodePanel", Vector3.new(3.2, 3.6, 0.3), pcf, rgb(36, 36, 40), M.Metal)
	for i, c in code.order do
		P(m, "CodeSlot", Vector3.new(0.5, 0.7, 0.08), pcf * CFrame.new(0.9 - (i - 1) * 0.6, 0.9, -0.17), CODE_RGB[Rules.COLORS[c]], M.Neon, nc())
	end
	for r = 0, 2 do
		for col = 0, 2 do
			P(m, "KeyCap", Vector3.new(0.4, 0.4, 0.08), pcf * CFrame.new(0.5 - col * 0.5, 0 - r * 0.5, -0.17), rgb(90, 90, 96), M.SmoothPlastic, nc())
		end
	end
	Props.prompt(panel, "code", 0, 8)
	-- второй щиток слева от двери: порядок экспонатов
	local ocf = Builder.slotFront(d, origin, 8) * CFrame.new(0, 5, 0.1)
	local orderPanel = P(m, "OrderPanel", Vector3.new(3.2, 3.6, 0.3), ocf, rgb(36, 36, 40), M.Metal)
	for r = 0, 1 do
		for col = 0, 3 do
			P(m, "OrderCap", Vector3.new(0.5, 0.9, 0.08), ocf * CFrame.new(1.05 - col * 0.7, 0.7 - r * 1.3, -0.17), Props.BRASS, M.Metal, nc())
		end
	end
	Props.prompt(orderPanel, "order", 0, 8)
	-- восемь экспонатов с римскими номерами: по четыре в каждом крыле
	local items = table.clone(Props.ODD)
	for i = #items, 2, -1 do
		local j = math.floor(rand() * i) + 1
		items[i], items[j] = items[j], items[i]
	end
	local spots = { { -22, -16 }, { -31, -18 }, { -22, -37 }, { -31, -38 }, { 22, -16 }, { 31, -18 }, { 22, -37 }, { 31, -38 } }
	local exhibits = {}
	for k = 1, 8 do
		local cf = at(origin, spots[k][1], 0, spots[k][2])
		local cm = Props.displayCase(m, cf, items[k])
		for _, face in { -1, 1 } do
			local plate = P(cm, "RomanPlate", Vector3.new(1.3, 0.7, 0.08), cf * CFrame.new(0, 1.5, face * 1.34), Props.BRASS, M.Metal, nc())
			surfaceText(plate, if face &lt; 0 then Enum.NormalId.Front else Enum.NormalId.Back, Rules.ROMAN[code.roman[k]], nil, rgb(36, 26, 14), 60)
		end
		exhibits[k] = items[k]
	end
	-- ключ: одно из четырёх мест, каждый раз другое
	local keySpots = {}
	for _, sx in { -1, 1 } do
		local _, top = Props.plinth(m, at(origin, sx * 26, 0, -26), 2, 3)
		P(m, "Cushion", Vector3.new(1.5, 0.2, 1.5), top * CFrame.new(0, 0.1, 0), rgb(100, 20, 30), M.Fabric, nc())
		table.insert(keySpots, top * CFrame.new(0, 0.2, 0))
		table.insert(keySpots, at(origin, sx * 35.5, 0, -4))
	end
	local _, key = Props.pickup(m, keySpots[math.floor(rand() * #keySpots) + 1], "key")
	key:SetAttribute("KeyFor", d.door + 1)
	info.exhibits = exhibits
	info.orderPanel = orderPanel
	info.locks = { code = false, order = false }
	info.code = code
	info.codePanel = panel
	info.sealed = true
	Props.LIGHT = 1
	return info
end

-- ---------------------------------------------------------------------------
-- Арена Колосса по чертежу: внизу — пол зала, по бокам — галереи второго этажа
-- (вход ведёт прямо на них), в дальнем конце две лестницы вниз. На галереях четыре
-- зеркала, луч приходит из круглого окна в дальней стене. Посередине — большая люстра
-- на лебёдке, в неё нужно поставить зеркальце, тогда луч падает вниз, в круг света.
-- Под левой галереей — холодильная камера с мясом. Выход — дверь с часовым механизмом

local ARENA_GALLERY = 27.2 -- внутренний край галерей

function Special.arena(parent, d, origin: CFrame, rand, prev)
	local m, info = begin(parent, d, origin, rand, prev)
	local A = Rules.ARENA
	local fy = d.dy
	local function L(x: number, y: number, z: number): CFrame
		return at(origin, x, y, z)
	end
	Props.LIGHT = 1.5
	local stone, stoneDark = rgb(150, 144, 136), rgb(104, 100, 94)
	local arena = { mirrors = {}, origin = origin, y = A.y, fy = fy, solved = false, lit = false, meat = nil }
	arena.floorY = L(0, fy, 0).Position.Y
	arena.zone = L(A.lens.x, fy, A.lens.z)

	-- галереи второго этажа (на уровне входа) --------------------------------
	local G0, G1 = ARENA_GALLERY, A.bounds.x
	local gw = G1 - G0
	for _, sx in { -1, 1 } do
		local cx = sx * (G0 + G1) / 2
		P(m, "Gallery", Vector3.new(gw, 1, 103.2 - 12), L(cx, -0.5, -(12 + 103.2) / 2), stone, M.Marble)
		-- под галереей у лестницы входа — сплошная кладка
		P(m, "GalleryBase", Vector3.new(gw, -fy - 1, 16), L(cx, (fy - 1) / 2, -20), stoneDark, M.Slate)
		-- карниз по краю
		P(m, "GalleryEdge", Vector3.new(0.5, 1.4, 103 - 28.4), L(sx * (G0 + 0.24), -0.9, -(28.4 + 103) / 2), stoneDark, M.Marble, nc())
	end
	-- колонны под галереями
	local columns = { [-1] = { -36, -48, -92 }, [1] = { -36, -50, -64, -78, -92 } }
	for sx, zs in columns do
		for _, z in zs do
			Props.pillar(m, L(sx * (G0 + 1.6), fy, z), -fy - 1, rgb(170, 160, 146))
		end
	end
	-- лестницы с галерей вниз в дальнем конце (под ними — невидимый пандус)
	local SZ0, SZ1 = -80, -100
	for _, sx in { -1, 1 } do
		local x0, x1 = sx * (G0 - 6.2), sx * G0
		local cx = (x0 + x1) / 2
		local len = math.abs(SZ1 - SZ0)
		local n = 14
		for k = 0, n - 1 do
			local zTop = SZ0 - k * len / n
			local hgt = -fy * (n - k) / n
			P(m, "Step", Vector3.new(6.1, hgt, len / n), L(cx, fy + hgt / 2, zTop - len / n / 2), stoneDark, M.Marble, nc())
		end
		local slope = math.sqrt(len * len + fy * fy)
		P(m, "Ramp", Vector3.new(6, 0.6, slope), L(cx, fy / 2 - 0.3, (SZ0 + SZ1) / 2) * CFrame.Angles(math.atan2(-fy, len), 0, 0), rgb(0, 0, 0), M.SmoothPlastic, { Transparency = 1, CastShadow = false })
		Props.rod(m, "Handrail", L(sx * (G0 - 6.3), 3.2, SZ0).Position, L(sx * (G0 - 6.3), fy + 3.2, SZ1).Position, 0.25, Props.WOOD_DARK, M.Wood, nc())
	end
	-- перила галерей с проходом к лестнице
	for _, sx in { -1, 1 } do
		local x = sx * (G0 + 0.25)
		local runs = { { -12.5, SZ0 + 0.4 }, { SZ1 - 0.4, -103 } }
		for _, r in runs do
			local a, b = r[1], r[2]
			Props.rod(m, "Rail", L(x, 3.4, a).Position, L(x, 3.4, b).Position, 0.3, Props.WOOD_DARK, M.Wood, nc())
			local cnt = math.max(1, math.floor(math.abs(b - a) / 3))
			for k = 0, cnt do
				local z = a + (b - a) * k / cnt
				P(m, "Baluster", Vector3.new(0.3, 3.2, 0.3), L(x, 1.6, z), stone, M.Marble, nc())
			end
		end
	end

	-- свет: зал хорошо освещён, зверя видно издалека --------------------------
	for _, x in { -14, 14 } do
		for _, z in { -38, -94 } do
			chandelier(info, m, L(x, d.h, z).Position, 8)
		end
	end
	for _, z in { -30, -56, -84 } do
		for _, sx in { -1, 1 } do
			local slot = if sx &lt; 0 then Builder.slotL else Builder.slotR
			local _, shade = Props.sconce(m, slot(d, origin, z) * CFrame.new(0, 6, Builder.F - 0.6))
			table.insert(info.lights, shade)
		end
	end

	-- окно-источник: круглое окно в дальней стене над левой галереей ------------
	local src = L(A.source.x, A.y, -103.3)
	C(m, "SunWindow", 0.2, 6, src * CFrame.Angles(math.pi / 2, 0, 0), rgb(255, 244, 200), M.Neon, nc())
	C(m, "SunFrame", 0.16, 6.8, L(A.source.x, A.y, -103.38) * CFrame.Angles(math.pi / 2, 0, 0), Props.BRASS, M.Metal, nc())
	local sl = Instance.new("PointLight")
	sl.Range = 24
	sl.Brightness = 1.2
	sl.Color = rgb(255, 236, 190)
	sl.Parent = m:FindFirstChild("SunWindow")

	-- зеркала на галереях: поворачиваются плавно, держи кнопку -------------------
	local sol = Rules.beamSolution()
	for k, mp in A.mirrors do
		local base = L(mp.x, 0, mp.z)
		P(m, "MirrorBase", Vector3.new(3.2, 1, 3.2), base * CFrame.new(0, 0.5, 0), stoneDark, M.Marble)
		local cf = base * CFrame.new(0, 1, 0)
		local sm, head, glass = Props.mirrorStand(m, cf)
		-- случайный угол, заведомо далеко от нужного
		local angle = sol[k] + math.rad(40 + rand() * 280)
		arena.mirrors[k] = { model = sm, head = head, glass = glass, cf = cf, angle = angle }
		local l = Props.prompt(glass, "turnl", 30, 9)
		local r = Props.prompt(glass, "turnr", 30, 9)
		l.UIOffset = Vector2.new(0, 40)
		r.UIOffset = Vector2.new(0, -40)
		l.KeyboardKeyCode = Enum.KeyCode.Q
		r.KeyboardKeyCode = Enum.KeyCode.E
	end

	-- большая люстра на лебёдке -------------------------------------------------
	local ch = Props.model(m, "BigChandelier")
	local hub = L(A.lens.x, A.y + 3.2, A.lens.z)
	C(ch, "Hub", 2.2, 1.4, hub, Props.BRASS, M.Metal)
	C(ch, "Crown", 0.6, 3, hub * CFrame.new(0, 1.3, 0), Props.BRASS, M.Metal, nc())
	for ring = 1, 2 do
		local rad, y = if ring == 1 then 4.6 else 2.8, if ring == 1 then -0.6 else 0.7
		local cnt = if ring == 1 then 14 else 9
		for k = 0, cnt - 1 do
			local a0, a1 = k / cnt * math.pi * 2, (k + 1) / cnt * math.pi * 2
			local p0 = (hub * CFrame.new(math.cos(a0) * rad, y, math.sin(a0) * rad)).Position
			local p1 = (hub * CFrame.new(math.cos(a1) * rad, y, math.sin(a1) * rad)).Position
			Props.rod(ch, "Ring", p0, p1, 0.22, Props.BRASS, M.Metal, nc())
			C(ch, "Candle", 0.8, 0.3, CFrame.new(p0 + Vector3.new(0, 0.5, 0)), rgb(240, 232, 210), M.SmoothPlastic, nc())
			S(ch, "Flame", 0.26, CFrame.new(p0 + Vector3.new(0, 1.05, 0)), rgb(255, 196, 110), M.Neon, nc())
			if ring == 1 and k % 2 == 0 then
				S(ch, "Drop", 0.45, CFrame.new(p0 - Vector3.new(0, 0.9, 0)), rgb(220, 236, 244), M.Glass, nc({ Transparency = 0.3 }))
			end
		end
		for k = 0, 3 do
			local a = k / 4 * math.pi * 2 + 0.4
			Props.rod(ch, "Arm", hub.Position, (hub * CFrame.new(math.cos(a) * rad, y, math.sin(a) * rad)).Position, 0.2, Props.BRASS, M.Metal, nc())
		end
	end
	local glow = S(ch, "Glow", 0.4, hub * CFrame.new(0, -0.6, 0), rgb(255, 214, 150), M.Neon, nc({ Transparency = 1 }))
	local gl = Instance.new("PointLight")
	gl.Range = 40
	gl.Brightness = 1.6
	gl.Color = rgb(255, 214, 160)
	gl.Parent = glow
	-- держатель для зеркальца под люстрой
	P(ch, "LensFork", Vector3.new(0.3, 2.2, 0.3), hub * CFrame.new(0, -2.2, 0), Props.BRASS, M.Metal, nc())
	local slot = C(ch, "LensSlot", 0.14, 2.2, hub * CFrame.new(0, -3.2, 0) * CFrame.Angles(0, 0, math.rad(45)), Props.BRASS, M.Metal, nc({ Transparency = 0.5 }))
	local slotPrompt = Props.prompt(slot, "place", 0.5, 9)
	slotPrompt.Enabled = false
	ch.WorldPivot = hub
	-- цепь до потолка и трос через блок к лебёдке на левой галерее
	local chain = C(m, "ChandelierChain", d.h - A.y - 4.6, 0.3, CFrame.new(), Props.IRON, M.Metal, nc())
	local winch = L(-(G1 - 1.6), 0, A.lens.z)
	C(m, "Pulley", 0.6, 1.6, L(A.lens.x, d.h - 0.8, A.lens.z) * CFrame.Angles(0, 0, math.pi / 2), Props.IRON, M.Metal, nc())
	C(m, "WallPulley", 0.6, 1.6, L(-(G1 - 0.8), d.h - 0.8, A.lens.z) * CFrame.Angles(0, 0, math.pi / 2), Props.IRON, M.Metal, nc())
	Props.rod(m, "Cable", L(A.lens.x, d.h - 0.4, A.lens.z).Position, L(-(G1 - 0.8), d.h - 0.4, A.lens.z).Position, 0.16, Props.IRON, M.Metal, nc())
	Props.rod(m, "Cable", L(-(G1 - 1.6), d.h - 0.8, A.lens.z).Position, L(-(G1 - 1.6), 2.6, A.lens.z).Position, 0.16, Props.IRON, M.Metal, nc())
	-- лебёдка: барабан с ручкой, тормозной штырь высоко на стене, рычаг сброса
	local drum = C(m, "WinchDrum", 2.4, 1.8, winch * CFrame.new(0, 2.2, 0) * CFrame.Angles(math.pi / 2, 0, 0), stoneDark:Lerp(Props.IRON, 0.6), M.Metal)
	for _, z in { -1.4, 1.4 } do
		P(m, "WinchFrame", Vector3.new(1.4, 2.6, 0.3), winch * CFrame.new(0, 1.3, z), Props.IRON, M.Metal, nc())
	end
	P(m, "Crank", Vector3.new(0.25, 1.4, 0.25), winch * CFrame.new(0.6, 2.5, 1.7), Props.IRON, M.Metal, nc())
	Props.prompt(drum, "crank", 1, 8)
	P(m, "BrakePlate", Vector3.new(0.3, 2.2, 2.2), L(-(G1 - 0.15), 10.5, A.lens.z), Props.IRON, M.Metal)
	local pin = P(m, "BrakePin", Vector3.new(1.6, 0.4, 0.4), L(-(G1 - 1), 10.5, A.lens.z), rgb(170, 60, 40), M.Metal)
	Props.prompt(pin, "knock", 0.6, 16)
	local lever = P(m, "ReleaseLever", Vector3.new(0.3, 2.4, 0.3), winch * CFrame.new(0.4, 1.4, -2.6) * CFrame.Angles(0, 0, math.rad(25)), rgb(170, 40, 30), M.Metal)
	P(m, "LeverBase", Vector3.new(1, 0.4, 1), winch * CFrame.new(0, 0.2, -2.6), Props.IRON, M.Metal, nc())
	Props.prompt(lever, "release", 0.4, 8)
	arena.chand = { model = ch, hubUp = hub, chain = chain, slot = slot, slotPrompt = slotPrompt, up = true, busy = false, lens = nil }
	arena.drum, arena.pin, arena.lever = drum, pin, lever
	arena.ceilingY = L(0, d.h, 0).Position.Y

	-- холодильная камера под левой галереей --------------------------------------
	local CX0, CX1, CZ0, CZ1 = -(G1 - 0.05), -(G0 + 0.6), -62, -76
	local ch2 = (CZ0 + CZ1) / 2
	local cold = Props.model(m, "ColdRoom")
	local ice = rgb(196, 214, 224)
	local hole = { { x = 0, w = Props.DOORS.small.w, y = 0, h = Props.DOORS.small.h } }
	Props.wall(cold, L(CX1, fy, ch2) * CFrame.Angles(0, math.pi / 2, 0), math.abs(CZ1 - CZ0), 0, -fy - 1, 0.6, hole, rgb(170, 180, 186), M.DiamondPlate, "ColdWall")
	for _, z in { CZ0, CZ1 } do
		P(cold, "ColdWall", Vector3.new(math.abs(CX1 - CX0) - 0.3, -fy - 1, 0.6), L((CX0 + CX1) / 2 - 0.15, fy / 2 - 0.5, z), rgb(170, 180, 186), M.DiamondPlate)
	end
	P(cold, "Frost", Vector3.new(math.abs(CX1 - CX0) - 0.9, 0.1, math.abs(CZ1 - CZ0) - 0.6), L((CX0 + CX1) / 2 - 0.3, fy + 0.05, ch2), ice, M.Ice, nc())
	local coldLamp = P(cold, "ColdLamp", Vector3.new(3, 0.3, 0.8), L((CX0 + CX1) / 2, -1.65, ch2), rgb(200, 230, 255), M.Neon, nc())
	local cl = Instance.new("PointLight")
	cl.Range = 16
	cl.Brightness = 1
	cl.Color = rgb(150, 200, 255)
	cl.Parent = coldLamp
	-- полки и крюки: 18 кусков мяса
	local meatSpots = {}
	for _, z in { CZ0 - 1.2, CZ1 + 1.2 } do
		for _, y in { 0.8, 3.2, 5.6 } do
			P(cold, "Shelf", Vector3.new(8.6, 0.2, 1.6), L((CX0 + CX1) / 2 - 0.4, fy + y, z), rgb(150, 156, 160), M.Metal, nc())
			for k = -1, 1 do
				table.insert(meatSpots, L((CX0 + CX1) / 2 - 0.4 + k * 2.8, fy + y + 0.1, z))
			end
		end
	end
	for k = -1, 1 do
		local hx = (CX0 + CX1) / 2 - 1 + k * 2.6
		Props.rod(cold, "HookBar", L(hx, -1.3, CZ0 - 3).Position, L(hx, -1.3, CZ1 + 3).Position, 0.14, Props.IRON, M.Metal, nc())
		local hm = P(cold, "HangingMeat", Vector3.new(1, 2.2, 0.8), L(hx, -3.2, ch2 + k), rgb(140, 36, 40), M.SmoothPlastic, nc())
		hm.CanCollide = false
	end
	for i, cf in meatSpots do
		if i &lt;= Rules.COLOSSUS.meat then
			Props.pickup(cold, cf * CFrame.Angles(0, i * 0.7, 0), "meat")
		end
	end
	local doorCF = L(CX1, fy, ch2) * CFrame.Angles(0, -math.pi / 2, 0)
	local coldDoor, leaves = Props.door(cold, doorCF, nil, true, "small")
	local trig = P(cold, "ColdLock", Vector3.new(1, 1, 1), doorCF * CFrame.new(1.4, 3.6, 0.8), rgb(0, 0, 0), M.SmoothPlastic, nc({ Transparency = 1 }))
	Props.prompt(trig, "open", 0, 7)
	P(cold, "ColdSign", Vector3.new(2.6, 0.8, 0.1), L(CX1 + 0.36, fy + 8.1, ch2), rgb(80, 130, 170), M.SmoothPlastic, nc())
	arena.cold = { model = coldDoor, leaves = leaves, trigger = trig, open = false }

	-- статуи и витрины на полу: за ними можно стоять ------------------------------
	for i, sp in { { -14, -46 }, { 14, -46 }, { -14, -88 }, { 14, -88 } } do
		Props.statue(m, L(sp[1], fy, sp[2]) * CFrame.Angles(0, if sp[1] &lt; 0 then math.pi / 2 else -math.pi / 2, 0), ({ "figure", "bust", "obelisk", "broken" })[i], d.door + i)
	end
	for i, sp in { { -20, -66 }, { 20, -60 } } do
		Props.displayCase(m, L(sp[1], fy, sp[2]), Props.ODD[(d.door + i * 3) % #Props.ODD + 1])
	end

	-- остановленные часы над выходом и механизм у двери ----------------------------
	local ex = d.exit.x or 0
	local hh, mm = Rules.clockTime(rand)
	arena.clock = { h = hh, m = mm }
	local clockCF = L(ex, fy + 16, -103.25) * CFrame.Angles(0, math.pi, 0)
	local function dial(parent2, cf: CFrame, r: number, h: number, mi: number)
		C(parent2, "ClockRim", 0.3, r * 2 + 0.5, cf * CFrame.Angles(math.pi / 2, 0, 0), rgb(26, 24, 24), M.Metal)
		C(parent2, "ClockGold", 0.34, r * 2 + 0.1, cf * CFrame.new(0, 0, -0.02) * CFrame.Angles(math.pi / 2, 0, 0), rgb(210, 168, 70), M.Metal, nc())
		C(parent2, "ClockFace", 0.36, r * 2 - 0.3, cf * CFrame.new(0, 0, -0.05) * CFrame.Angles(math.pi / 2, 0, 0), rgb(240, 232, 210), M.SmoothPlastic, nc())
		for k = 0, 11 do
			local a = k / 12 * math.pi * 2
			P(parent2, "Mark", Vector3.new(if k % 3 == 0 then 0.24 else 0.14, if k % 3 == 0 then r * 0.22 else r * 0.12, 0.06), cf * CFrame.Angles(0, 0, a) * CFrame.new(0, r * 0.8, -0.24), rgb(20, 20, 20), M.SmoothPlastic, nc())
		end
		local hand = function(name, len, w, a, dz)
			return P(parent2, name, Vector3.new(w, len, 0.06), cf * CFrame.Angles(0, 0, a) * CFrame.new(0, len / 2 - 0.1, dz), rgb(16, 16, 16), M.Metal, nc())
		end
		local ha = ((h % 12) + mi / 60) / 12 * math.pi * 2
		local hp = hand("HourHand", r * 0.5, 0.22, ha, -0.3)
		local mp = hand("MinuteHand", r * 0.78, 0.14, mi / 60 * math.pi * 2, -0.34)
		return hp, mp
	end
	local stopped = Props.model(m, "StoppedClock")
	dial(stopped, clockCF, 3, hh, mm)
	-- механизм: циферблат со стрелками и скважиной, две ручки
	local mech = Props.model(m, "ClockLock")
	local mcf = L(ex + 7.5, fy + 5, -103.25) * CFrame.Angles(0, math.pi, 0)
	P(mech, "MechPlate", Vector3.new(4, 5.4, 0.3), mcf, rgb(36, 32, 30), M.Metal)
	local mh, mmh = dial(mech, mcf * CFrame.new(0, 0.6, -0.1), 1.5, 12, 0)
	local keyhole = P(mech, "Keyhole", Vector3.new(0.5, 0.8, 0.1), mcf * CFrame.new(0, -1.6, -0.12), rgb(10, 10, 10), M.Metal, nc())
	Props.prompt(keyhole, "insert", 0.5, 7)
	local kh = P(mech, "HourKnob", Vector3.new(0.6, 0.6, 0.4), mcf * CFrame.new(-1.3, -1.9, -0.3), rgb(210, 168, 70), M.Metal, nc())
	local km = P(mech, "MinuteKnob", Vector3.new(0.6, 0.6, 0.4), mcf * CFrame.new(1.3, -1.9, -0.3), rgb(210, 168, 70), M.Metal, nc())
	Props.prompt(kh, "hour", 0, 7).Enabled = false
	Props.prompt(km, "minute", 0, 7).Enabled = false
	arena.mech = { cf = mcf * CFrame.new(0, 0.6, -0.1), h = 12, m = 0, hourHand = mh, minuteHand = mmh, keyhole = keyhole, hourKnob = kh, minuteKnob = km, inserted = false }

	-- шест, зеркальце и ключ от камеры лежат в случайных местах ----------------------
	local spots = {
		L(-33, 0, -24) * CFrame.Angles(0, math.pi / 2, 0), L(33, 0, -100) * CFrame.Angles(0, math.pi / 2, 0), L(36, 0, -70) * CFrame.Angles(0, math.pi / 2, 0), L(-36, 0, -84) * CFrame.Angles(0, math.pi / 2, 0),
		L(-16, fy, -101), L(24, fy, -34), L(-6, fy, -100), L(6, fy, -74) * CFrame.Angles(0, 0.8, 0), L(-22, fy, -36),
	}
	for i = #spots, 2, -1 do
		local j = 1 + math.floor(rand() * i)
		spots[i], spots[j] = spots[j], spots[i]
	end
	Props.pickup(m, spots[1], "pole")
	Props.pickup(m, spots[2], "lens")
	Props.pickup(m, spots[3], "coldkey")

	-- круг света под люстрой (виден, когда луч доходит) ------------------------------
	arena.spot = C(m, "LightSpot", 0.08, A.zone * 2, arena.zone * CFrame.new(0, 0.05, 0), rgb(255, 236, 170), M.Neon, nc({ Transparency = 1 }))
	-- постамент, с которого сойдёт Колосс
	P(m, "ColossusBase", Vector3.new(10, 0.6, 10), L(16, fy + 0.3, -78), rgb(120, 116, 110), M.Marble, nc())
	arena.spawn = L(16, fy + 0.6, -78) * CFrame.Angles(0, math.pi, 0)
	arena.wander = {}
	for _, p in { { -18, -36 }, { 18, -36 }, { -20, -56 }, { 20, -52 }, { 0, -66 }, { -18, -80 }, { 18, -84 }, { -8, -98 }, { 8, -98 }, { 0, -44 } } do
		table.insert(arena.wander, L(p[1], fy + 3, p[2]).Position)
	end
	arena.beam = Props.model(m, "Beam")
	info.arena = arena
	info.sealed = true
	info.boss = true
	Props.LIGHT = 1
	Special.placeChandelier(info, 0)
	Special.drawBeam(info)
	return info
end

-- люстра: down от 0 (вверху) до 1 (опущена к полу, можно поставить зеркальце)
-- или &gt;1 — упала на пол
function Special.placeChandelier(info, down: number)
	local a = info.arena
	local ch = a.chand
	local lowY = a.floorY + 7.4
	local upY = ch.hubUp.Position.Y
	local y = upY + (lowY - upY) * math.min(down, 1)
	if down &gt; 1 then
		y = a.floorY + 2.6
	end
	local cf = ch.hubUp + Vector3.new(0, y - upY, 0)
	ch.model:PivotTo(cf)
	local top = a.ceilingY - 0.4
	local len = math.max(0.2, top - (y + 2))
	ch.chain.Size = Vector3.new(len, 0.3, 0.3)
	ch.chain.CFrame = CFrame.new(cf.Position.X, y + 2 + len / 2, cf.Position.Z) * CFrame.Angles(0, 0, math.pi / 2)
	ch.chain.Transparency = if down &gt; 1 then 1 else 0
	ch.pos = cf.Position
end

-- стрелки механизма у выхода
function Special.setMechHands(info)
	local mech = info.arena.mech
	local r = 1.5
	local ha = ((mech.h % 12) + mech.m / 60) / 12 * math.pi * 2
	local ma = mech.m / 60 * math.pi * 2
	mech.hourHand.CFrame = mech.cf * CFrame.Angles(0, 0, ha) * CFrame.new(0, r * 0.5 / 2 - 0.1, -0.3)
	mech.minuteHand.CFrame = mech.cf * CFrame.Angles(0, 0, ma) * CFrame.new(0, r * 0.78 / 2 - 0.1, -0.34)
end

-- угол нормали зеркала (в осях зала) → поворот головы стойки
local function mirrorYaw(a: number): number
	return math.atan2(-math.cos(a), -math.sin(a))
end

function Special.turnMirror(info, k: number)
	local mr = info.arena.mirrors[k]
	mr.head:PivotTo(mr.cf * CFrame.Angles(0, mirrorYaw(mr.angle), 0))
end

-- перерисовать луч по углам зеркал; возвращает цепочку и дошёл ли до люстры
function Special.drawBeam(info)
	local a = info.arena
	local A = Rules.ARENA
	local angles = {}
	for k, mr in a.mirrors do
		angles[k] = mr.angle
		if not mr.posed then
			mr.posed = true
			Special.turnMirror(info, k)
		end
	end
	local path, chain, hit = Rules.beam(angles)
	local up = a.chand.up and not a.chand.busy
	if hit and not up then
		-- люстры на месте нет: луч уходит дальше в стену
		hit = false
		table.remove(path)
	end
	a.beam:ClearAllChildren()
	local function pt(q)
		return (a.origin * CFrame.new(q.x, A.y, q.z)).Position
	end
	for i = 1, #path - 1 do
		local p = Props.rod(a.beam, "Ray", pt(path[i]), pt(path[i + 1]), 0.38 + (i % 2) * 0.05, rgb(255, 236, 170), M.Neon, nc({ Transparency = 0.25 }))
		local l = Instance.new("PointLight")
		l.Range = 12
		l.Brightness = 0.7
		l.Color = rgb(255, 230, 170)
		l.Parent = p
	end
	local lit = hit and a.chand.lens ~= nil
	if lit then
		local from = pt(path[#path])
		local to = a.zone.Position + Vector3.new(0, 0.1, 0)
		local p = Props.rod(a.beam, "DownRay", from, to, 1.2, rgb(255, 240, 190), M.Neon, nc({ Transparency = 0.35 }))
		local l = Instance.new("SpotLight")
		l.Face = Enum.NormalId.Front
		l.Range = 30
		l.Angle = 50
		l.Brightness = 4
		l.Color = rgb(255, 236, 180)
		l.Parent = p
	end
	a.spot.Transparency = if lit then 0.35 else 1
	a.chain = chain
	a.lit = lit
	a.solved = lit
	return chain, hit
end

-- ---------------------------------------------------------------------------
-- Лифт, рычаги и лестница обслуживания (спуск около минуты), внизу дверь 100

function Special.liftHall(parent, d, origin: CFrame, rand, prev)
	local m, info = begin(parent, d, origin, rand, prev)
	-- лифт на левой стене: рамка, закрытые створки, кнопка, три лампы-подсказки
	local lcf = Builder.slotL(d, origin, -15) * CFrame.new(0, 0, 0.3)
	P(m, "LiftFrame", Vector3.new(8, 10.4, 0.4), lcf * CFrame.new(0, 5.2, -0.25), rgb(70, 72, 76), M.Metal, nc())
	for _, s in { -1, 1 } do
		P(m, "LiftLeaf", Vector3.new(3.2, 9.4, 0.2), lcf * CFrame.new(s * 1.62, 4.7, -0.5), rgb(150, 154, 158), M.Metal, nc())
	end
	local call = P(m, "CallButton", Vector3.new(0.7, 1.1, 0.3), lcf * CFrame.new(-4.9, 4.4, -0.2), rgb(40, 40, 44), M.Metal, nc({ CanQuery = true }))
	P(m, "CallLight", Vector3.new(0.3, 0.3, 0.08), lcf * CFrame.new(-4.9, 4.6, -0.38), rgb(200, 40, 30), M.Neon, nc())
	Props.prompt(call, "call", 0, 8)
	local bits = {}
	repeat
		bits = { rand() &lt; 0.5, rand() &lt; 0.5, rand() &lt; 0.5 }
	until bits[1] or bits[2] or bits[3]
	for i = 1, 3 do
		P(m, "HintLamp", Vector3.new(0.8, 0.8, 0.2), lcf * CFrame.new(-(i - 2) * 1.6, 11.4, -0.2), if bits[i] then rgb(255, 200, 80) else rgb(40, 36, 30), if bits[i] then M.Neon else M.SmoothPlastic, nc())
	end
	-- щиток с тремя рычагами справа от служебной двери
	local pcf = Builder.slotFront(d, origin, -7) * CFrame.new(0, 4.6, 0.1)
	P(m, "LeverPanel", Vector3.new(5, 3.2, 0.3), pcf, rgb(60, 62, 66), M.Metal)
	info.levers = {}
	for i = 1, 3 do
		local base = pcf * CFrame.new((i - 2) * 1.6, 0, -0.2)
		P(m, "LeverSlot", Vector3.new(0.3, 1.8, 0.08), base, rgb(20, 20, 20), M.SmoothPlastic, nc())
		local lm = Props.model(m, "Lever")
		local handle = P(lm, "Handle", Vector3.new(0.25, 0.25, 1.1), base * CFrame.new(0, 0, -0.5), rgb(170, 170, 176), M.Metal, nc({ CanQuery = true }))
		S(lm, "Grip", 0.5, base * CFrame.new(0, 0, -1.1), rgb(170, 40, 34), M.SmoothPlastic, nc())
		lm.WorldPivot = base
		lm:PivotTo(base * CFrame.Angles(math.rad(-35), 0, 0))
		Props.prompt(handle, "lever", 0, 7)
		info.levers[i] = { model = lm, base = base, handle = handle, on = false, need = bits[i] }
	end
	Props.bench(m, Builder.slotR(d, origin, -12), 7)
	Props.plantPot(m, at(origin, 12.5, 0, -27))
	lamp(info, m, at(origin, 0, d.h, -15).Position)
	-- служебная дверь (без номера), за ней лестница
	local start = info.exitCF
	local gm, leaves = Props.door(m, start, nil, false, "small")
	info.gate = { model = gm, leaves = leaves, opened = false }
	local wallC, stepC = rgb(72, 72, 70), rgb(90, 88, 84)
	local W = 12
	P(m, "Landing", Vector3.new(W, 1, 7.5), start * CFrame.new(0, -0.5, -4.25), stepC, M.Concrete)
	P(m, "LandingCeil", Vector3.new(W + 2, 1, 7.5), start * CFrame.new(0, 12.5, -4.25), wallC, M.Concrete)
	for _, s in { -1, 1 } do
		P(m, "LandingWall", Vector3.new(1, 13, 7.5), start * CFrame.new(s * (W / 2 + 0.5), 6, -4.25), wallC, M.Concrete)
	end
	local sections, run, drop = 14, 60, 30
	local slope = math.sqrt(run * run + drop * drop)
	for k = 0, sections - 1 do
		local top = start * CFrame.new(0, -k * drop, -(8 + k * run))
		local a, b = top.Position, (top * CFrame.new(0, -drop, -run)).Position
		local mid = CFrame.lookAt((a + b) / 2, b, start.UpVector)
		-- невидимый пандус через середины ступеней и видимые ступени
		P(m, "StairRamp", Vector3.new(W, 1, slope), mid * CFrame.new(0, 0, 0), rgb(0, 0, 0), M.SmoothPlastic, { Transparency = 1, CastShadow = false })
		for i = 0, 29 do
			P(m, "Tread", Vector3.new(W, 1, 2), top * CFrame.new(0, -i - 0.5, -(i * 2 + 1)), if i % 2 == 0 then stepC else stepC:Lerp(rgb(0, 0, 0), 0.12), M.Concrete, nc())
		end
		for _, s in { -1, 1 } do
			P(m, "StairWall", Vector3.new(1, 15, slope), mid * CFrame.new(s * (W / 2 + 0.5), 6, 0), wallC, M.Concrete)
			P(m, "Handrail", Vector3.new(0.25, 0.25, slope), mid * CFrame.new(s * (W / 2 - 0.5), 3.6, 0), rgb(120, 60, 40), M.Metal, nc())
		end
		P(m, "StairCeil", Vector3.new(W + 2, 1, slope), mid * CFrame.new(0, 13, 0), wallC, M.Concrete)
		local bulb = P(m, "StairLamp", Vector3.new(1.2, 0.4, 0.6), mid * CFrame.new(0, 12.2, 0), rgb(255, 200, 120), M.Neon, nc())
		local l = Instance.new("PointLight")
		l.Range = 30
		l.Brightness = if k % 3 == 2 then 0.25 else 0.8
		l.Color = rgb(255, 196, 130)
		l.Shadows = false
		l.Parent = bulb
	end
	-- внизу короткий коридор и дверь 100
	local bottom = start * CFrame.new(0, -sections * drop, -(8 + sections * run))
	local cl = 30
	P(m, "BottomFloor", Vector3.new(W, 1, cl + 0.5), bottom * CFrame.new(0, -0.5, -cl / 2 + 0.25), stepC, M.Concrete)
	P(m, "BottomCeil", Vector3.new(W + 2, 1, cl + 0.5), bottom * CFrame.new(0, 12.5, -cl / 2 + 0.25), wallC, M.Concrete)
	for _, s in { -1, 1 } do
		P(m, "BottomWall", Vector3.new(1, 13, cl + 0.5), bottom * CFrame.new(s * (W / 2 + 0.5), 6, -cl / 2 + 0.25), wallC, M.Concrete)
	end
	local endCF = bottom * CFrame.new(0, 0, -cl)
	Props.wall(m, endCF * CFrame.Angles(0, math.pi, 0), W + 2, 0, 12, 1, { { x = 0, w = 5, y = 0, h = 9 } }, wallC, M.Concrete, "Struct")
	local bl = P(m, "BottomLamp", Vector3.new(1.2, 0.4, 0.6), bottom * CFrame.new(0, 11.8, -cl / 2), rgb(255, 200, 120), M.Neon, nc())
	local l2 = Instance.new("PointLight")
	l2.Range = 30
	l2.Brightness = 0.6
	l2.Color = rgb(255, 196, 130)
	l2.Parent = bl
	info.exitCF = endCF
	info.exitWall = { a = (endCF * CFrame.new(-W / 2 - 1, 0, 0)).Position, b = (endCF * CFrame.new(W / 2 + 1, 0, 0)).Position, top = endCF.Y + 12, bottom = endCF.Y }
	info.stairs = { top = start, bottom = bottom }
	info.sealed = true
	Props.LIGHT = 1
	return info
end

-- игрок на лестнице или в нижнем коридоре (для проверки «в зале»)
function Special.onStairs(info, pos: Vector3): boolean
	local st = info.stairs
	if not st then
		return false
	end
	local lp = st.top:PointToObjectSpace(pos)
	return math.abs(lp.X) &lt; 8 and lp.Z &lt; 1 and lp.Z &gt; -900 and lp.Y &lt; 14 and lp.Y &gt; -440
end

-- ---------------------------------------------------------------------------
-- Заброшенный зал за дверью 100: мох, корни, упавшие колонны

function Special.final(parent, d, origin: CFrame, rand, prev)
	d.entry = Props.DOORS.normal
	d.exitSize = "grand"
	d.light = 0.5
	local m, info = begin(parent, d, origin, rand, prev, function(st)
		st.paper = rgb(64, 72, 60)
		st.floor = rgb(72, 78, 66)
		st.floorMat = M.Slate
		st.ceil = rgb(60, 64, 56)
	end)
	local moss, vine = rgb(52, 84, 46), rgb(40, 70, 40)
	for k = 1, 22 do
		local x, z = (rand() - 0.5) * (d.w - 6), -3 - rand() * (d.l - 6)
		P(m, "Moss", Vector3.new(3 + rand() * 5, 0.06 + (k % 3) * 0.01, 3 + rand() * 5), at(origin, x, 0.03 + k * 0.002, z) * CFrame.Angles(0, rand() * 3, 0), moss:Lerp(rgb(70, 96, 50), rand()), M.Grass, nc())
	end
	for k = 1, 18 do
		local x, z = (rand() - 0.5) * (d.w - 4), -2 - rand() * (d.l - 4)
		local len = 4 + rand() * 9
		C(m, "Vine", len, 0.2, at(origin, x, d.h - len / 2, z), vine, M.Grass, nc())
		S(m, "Leaf", 0.9, at(origin, x, d.h - len, z), moss, M.Grass, nc())
	end
	for _, p in { { -16, -14, 20 }, { 16, -14, 11 }, { -16, -34, 7 }, { 16, -34, 20 }, { -16, -52, 14 }, { 16, -52, 5 } } do
		Props.pillar(m, at(origin, p[1], 0, p[2]), math.min(p[3], d.h), rgb(120, 122, 110))
	end
	-- упавшая колонна и разбитая статуя
	C(m, "FallenColumn", 14, 2.2, at(origin, 7, 1.1, -42) * CFrame.Angles(0, 0.5, math.pi / 2), rgb(120, 122, 110), M.Limestone)
	Props.statue(m, at(origin, -6, 0, -26), "broken", 1)
	S(m, "StatueHead", 0.9, at(origin, -3.2, 0.45, -24.4), Props.MARBLE, M.Marble, nc())
	for k = 0, 5 do
		Props.rod(m, "Root", at(origin, -4 + k * 1.6, 0.2, -d.l + 1).Position, at(origin, -6 + k * 2.4, 5 + (k % 3) * 2.5, -d.l + 0.95).Position, 0.4, rgb(60, 46, 34), M.Wood, nc())
	end
	P(m, "Puddle", Vector3.new(7, 0.05, 5), at(origin, 8, 0.05, -18), rgb(40, 60, 60), M.Glass, nc({ Transparency = 0.3, Reflectance = 0.3 }))
	for _, p in { { -10, -20 }, { 10, -40 } } do
		local shaft = C(m, "MoonShaft", d.h, 2.4, at(origin, p[1], d.h / 2, p[2]), rgb(150, 190, 170), M.Neon, nc({ Transparency = 0.85 }))
		local l = Instance.new("PointLight")
		l.Range = 30
		l.Brightness = 0.7
		l.Color = rgb(150, 200, 170)
		l.Parent = shaft
	end
	-- дальше пути пока нет: заросшие двери и тьма за ними
	Props.door(m, info.exitCF, nil, true, "grand")
	P(m, "Dark", Vector3.new(11, 14, 0.4), info.exitCF * CFrame.new(0, 7, -1.3), rgb(0, 0, 0), M.SmoothPlastic)
	info.final = true
	Props.LIGHT = 1
	return info
end

return Special
</ProtectedString>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBX0000001C">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CharacterWalkSpeed">15</float>
      <bool name="CharacterUseJumpPower">true</bool>
      <float name="CharacterJumpPower">0</float>
      <float name="CharacterJumpHeight">0</float>
      <float name="CameraMaxZoomDistance">40</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBX0000001D">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="RBX0000001E">
        <Properties>
          <string name="Name">Workshop</string>
        </Properties>
        <Item class="LocalScript" referent="RBX0000001F">
          <Properties>
            <string name="Name">Main</string>
            <ProtectedString name="Source">--!nonstrict
-- Клиент «The Museum». Меню нет: на улице — свой персонаж, в музее — вид от первого
-- лица и минимум кнопок: здоровье, монеты, «тихо», журнал, выход из шкафчика.
-- Предметы — в инвентаре Roblox. Диалоги, кодовый замок, журнал существ, сцены,
-- Тьма, проломы в пустоту, звук шагов по разным полам

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")
local StarterGui = game:GetService("StarterGui")
local Lighting = game:GetService("Lighting")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Workshop"):WaitForChild("Shared")
local Remotes = require(Shared.Roblox.Remotes)
local Lang = require(Shared.Lang)
local Rules = require(Shared.Rules)
local AdminCommands = require(Shared.AdminCommands)
local Ui = require(script.Parent.Ui)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local camera = workspace.CurrentCamera

local app = {
	lang = if string.sub(player.LocaleId or "", 1, 2) == "ru" then "ru" else "en",
	sneaking = false,
	dead = false,
	scene = false, -- идёт сцена: камерой управляет она
	tbc = false,
	spectating = nil :: Player?,
	shake = 0,
	lastHp = 100,
	steps = true,
	ambience = true,
	journal = {} :: { [string]: boolean },
	ach = {} :: { [string]: boolean },
	arrived = false,
}

local function T(key: string, ...)
	return Lang.t(app.lang, key, ...)
end

local function request(...)
	local ok, res = pcall(function(...)
		return Remotes.fn("Request"):InvokeServer(...)
	end, ...)
	return if ok then res else nil
end

local function inRun(): boolean
	return workspace:GetAttribute("Mode") == "run"
end

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, true)
end)
task.spawn(request, "Lang", app.lang)
task.spawn(function()
	local r = request("Journal")
	if r and r.journal then
		for id in r.journal do
			app.journal[id] = true
		end
	end
	if r and type(r.ach) == "table" then
		for id in r.ach do
			app.ach[id] = true
		end
	end
end)

-- ---------------------------------------------------------------------------
-- свет: на улице ночь с луной, в музее темно; за проломами и окнами только чернота

local tint = Instance.new("ColorCorrectionEffect")
tint.Parent = Lighting
local sky = Instance.new("Sky")
sky.Name = "VoidSky"
sky.StarCount = 0
sky.CelestialBodiesShown = false
for _, face in { "SkyboxBk", "SkyboxDn", "SkyboxFt", "SkyboxLf", "SkyboxRt", "SkyboxUp" } do
	(sky :: any)[face] = "rbxasset://textures/blackBkg_square.png"
end
local function applyLighting()
	local light = workspace:GetAttribute("Light") or 1
	Lighting.ClockTime = 0
	Lighting.FogColor = Color3.fromRGB(3, 3, 4)
	pcall(function()
		Lighting.EnvironmentDiffuseScale = 0
		Lighting.EnvironmentSpecularScale = 0
	end)
	if inRun() then
		Lighting.Ambient = Color3.fromRGB(10, 9, 9)
		Lighting.OutdoorAmbient = Color3.fromRGB(0, 0, 0)
		Lighting.Brightness = 0
		Lighting.FogStart = 20
		Lighting.FogEnd = 80 + 100 * light
		tint.Saturation = -0.2 - (1 - light) * 0.3
		tint.Contrast = 0.12
		sky.Parent = Lighting
	else
		Lighting.Ambient = Color3.fromRGB(34, 38, 54)
		Lighting.OutdoorAmbient = Color3.fromRGB(44, 50, 72)
		Lighting.Brightness = 1.2
		Lighting.FogStart = 60
		Lighting.FogEnd = 320
		tint.Saturation = -0.1
		tint.Contrast = 0.05
		sky.Parent = nil
	end
end
workspace:GetAttributeChangedSignal("Light"):Connect(applyLighting)

-- ---------------------------------------------------------------------------
-- экран

local gui = Instance.new("ScreenGui")
gui.Name = "Museum"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = playerGui

local black = Ui.frame(gui, { BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 40 })
local red = Ui.frame(gui, { BackgroundColor3 = Color3.fromRGB(140, 0, 0), BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 41 })

local function flashRed(strength: number)
	red.BackgroundTransparency = 1 - strength
	TweenService:Create(red, TweenInfo.new(0.9), { BackgroundTransparency = 1 }):Play()
end

local toastBox = Ui.frame(gui, { BackgroundTransparency = 1, Size = UDim2.new(0.9, 0, 0, 120), Position = UDim2.new(0.05, 0, 0.62, 0), ZIndex = 50 })
Ui.list(toastBox, 4)
local function toast(text: string, color: Color3?, seconds: number?)
	local l = Ui.label(toastBox, text, { Size = UDim2.new(0, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.XY, TextSize = 16, TextColor3 = color or Ui.C.text, ZIndex = 51 })
	l.TextStrokeTransparency = 0.5
	task.delay(seconds or 2.4, function()
		TweenService:Create(l, TweenInfo.new(0.5), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		task.delay(0.6, function()
			l:Destroy()
		end)
	end)
end

-- реплика внизу экрана: буквы появляются по одной
local lineBox = Ui.frame(gui, { BackgroundTransparency = 0.25, Size = UDim2.new(0.7, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Position = UDim2.new(0.15, 0, 0.78, 0), Visible = false, ZIndex = 55 })
Ui.corner(lineBox, 8)
Ui.pad(lineBox, 12)
local lineText = Ui.label(lineBox, "", { TextSize = 18, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, ZIndex = 56 })
local lineId = 0
local function say(text: string, robotic: boolean?)
	lineId += 1
	local id = lineId
	lineBox.Visible = true
	lineText.Font = if robotic then Enum.Font.Code else Ui.FONT
	lineText.Text = text
	lineText.MaxVisibleGraphemes = 0
	local beep = Instance.new("Sound")
	beep.SoundId = "rbxasset://sounds/electronicpingshort.wav"
	beep.Volume = if robotic then 0.5 else 0
	beep.Parent = gui
	task.spawn(function()
		local n = utf8.len(text) or #text
		for i = 1, n do
			if lineId ~= id then
				break
			end
			lineText.MaxVisibleGraphemes = i
			if robotic and i % 3 == 0 then
				beep.PlaybackSpeed = 0.5 + (i % 5) * 0.06
				beep:Play()
			end
			task.wait(if robotic then 0.05 else 0.035)
		end
		task.wait(3.5)
		beep:Destroy()
		if lineId == id then
			lineBox.Visible = false
		end
	end)
end

-- ---------------------------------------------------------------------------
-- интерфейс забега

local hud = Ui.frame(gui, { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, ZIndex = 10 })
local hpBack = Ui.frame(hud, { BackgroundColor3 = Color3.fromRGB(30, 26, 24), BackgroundTransparency = 0.4, Size = UDim2.fromOffset(150, 6), Position = UDim2.new(0, 16, 0, 52), ZIndex = 11 })
Ui.corner(hpBack, 3)
local hpFill = Ui.frame(hpBack, { BackgroundColor3 = Color3.fromRGB(170, 40, 40), Size = UDim2.fromScale(1, 1), ZIndex = 12 })
Ui.corner(hpFill, 3)
local coinText = Ui.label(hud, "", { Font = Ui.BOLD, TextSize = 15, TextColor3 = Ui.C.gold, Size = UDim2.fromOffset(150, 20), Position = UDim2.new(0, 16, 0, 62), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 11 })
coinText.TextStrokeTransparency = 0.6
local flBack = Ui.frame(hud, { BackgroundColor3 = Color3.fromRGB(30, 26, 24), BackgroundTransparency = 0.4, Size = UDim2.fromOffset(150, 4), Position = UDim2.new(0, 16, 0, 86), Visible = false, ZIndex = 11 })
Ui.corner(flBack, 2)
local flFill = Ui.frame(flBack, { BackgroundColor3 = Color3.fromRGB(230, 210, 120), Size = UDim2.fromScale(1, 1), ZIndex = 12 })
Ui.corner(flFill, 2)

local sneakBtn = Ui.button(hud, "🧍", nil, { Size = UDim2.fromOffset(64, 64), Position = UDim2.new(1, -84, 1, -210), TextSize = 34, BackgroundTransparency = 0.45, ZIndex = 11 })
local function setSneak(on: boolean)
	app.sneaking = on
	sneakBtn.Text = if on then "🧎" else "🧍"
	sneakBtn.BackgroundColor3 = if on then Ui.C.line else Ui.C.panel
	task.spawn(request, "Sneak", on)
end
sneakBtn.Activated:Connect(function()
	setSneak(not app.sneaking)
end)

local leaveBtn = Ui.button(gui, "", function()
	task.spawn(request, "Unhide")
end, { Size = UDim2.fromOffset(160, 48), Position = UDim2.new(0.5, -80, 1, -150), Visible = false, ZIndex = 30 })

-- вид из шкафчика: тёмная дверца с узкими прорезями, сквозь которые видно зал
local slits = Ui.frame(gui, { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, ZIndex = 28 })
do
	local gap, bar = 0.035, 0.085
	local y = 0.2
	Ui.frame(slits, { BackgroundColor3 = Color3.fromRGB(8, 9, 9), Size = UDim2.fromScale(1, y), ZIndex = 28 })
	for _ = 1, 5 do
		y += gap
		Ui.frame(slits, { BackgroundColor3 = Color3.fromRGB(8, 9, 9), Size = UDim2.fromScale(1, bar), Position = UDim2.fromScale(0, y), ZIndex = 28 })
		y += bar
	end
	Ui.frame(slits, { BackgroundColor3 = Color3.fromRGB(8, 9, 9), Size = UDim2.fromScale(1, 1 - y), Position = UDim2.fromScale(0, y), ZIndex = 28 })
	for _, x in { 0, 0.88 } do
		Ui.frame(slits, { BackgroundColor3 = Color3.fromRGB(8, 9, 9), Size = UDim2.fromScale(0.12, 1), Position = UDim2.fromScale(x, 0), ZIndex = 28 })
	end
end

local function refreshHud()
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hp = if hum then math.clamp(hum.Health / math.max(1, hum.MaxHealth), 0, 1) else 0
	hpFill.Size = UDim2.fromScale(hp, 1)
	coinText.Text = "● " .. (player:GetAttribute("Coins") or 0)
	local fl = (player:GetAttribute("Flash") or Rules.FLASH_MAX) / Rules.FLASH_MAX
	flFill.Size = UDim2.fromScale(math.clamp(fl, 0, 1), 1)
	local tool = char and char:FindFirstChildOfClass("Tool")
	flBack.Visible = tool ~= nil and tool:GetAttribute("Item") == "flashlight"
	leaveBtn.Text = T("Leave")
end
player:GetAttributeChangedSignal("Coins"):Connect(refreshHud)
player:GetAttributeChangedSignal("Flash"):Connect(refreshHud)

-- ---------------------------------------------------------------------------
-- подписи кнопок и вывесок на языке игрока

local function localize(d: Instance)
	if d:IsA("ProximityPrompt") then
		local kind = d:GetAttribute("Kind")
		if kind then
			d.ActionText = T("p_" .. kind)
			if kind == "lockpick" then
				d.Enabled = (player:GetAttribute("Lockpicks") or 0) &gt; 0
			end
		end
	elseif d:IsA("TextLabel") and d:GetAttribute("LangKey") then
		d.Text = T(d:GetAttribute("LangKey"))
	end
end
local function localizeAll()
	for _, d in workspace:GetDescendants() do
		localize(d)
	end
end
workspace.DescendantAdded:Connect(localize)
player:GetAttributeChangedSignal("Lockpicks"):Connect(function()
	for _, d in workspace:GetDescendants() do
		if d:IsA("ProximityPrompt") and d:GetAttribute("Kind") == "lockpick" then
			localize(d)
		end
	end
end)

-- ---------------------------------------------------------------------------
-- камера

local function setCamera()
	if app.scene or app.tbc then
		return
	end
	if inRun() and not app.dead then
		player.CameraMode = Enum.CameraMode.LockFirstPerson
	else
		player.CameraMode = Enum.CameraMode.Classic
	end
	camera.CameraType = Enum.CameraType.Custom
	camera.FieldOfView = 75
end

local hiddenEye = nil
player:GetAttributeChangedSignal("HiddenEye"):Connect(function()
	local eye = player:GetAttribute("HiddenEye")
	hiddenEye = if typeof(eye) == "CFrame" then eye else nil
	leaveBtn.Visible = hiddenEye ~= nil
	slits.Visible = hiddenEye ~= nil
	if not hiddenEye then
		setCamera()
	end
end)

player:GetAttributeChangedSignal("Sneaking"):Connect(function()
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if hum then
		TweenService:Create(hum, TweenInfo.new(0.25), { CameraOffset = if player:GetAttribute("Sneaking") then Vector3.new(0, -2, 0) else Vector3.zero }):Play()
	end
end)

-- свет своего фонарика идёт от камеры
local camLight = Instance.new("Part")
camLight.Name = "CamLight"
camLight.Anchored = true
camLight.CanCollide = false
camLight.CanQuery = false
camLight.Transparency = 1
camLight.Size = Vector3.new(0.2, 0.2, 0.2)
camLight.Parent = workspace
local beam = Instance.new("SpotLight")
beam.Face = Enum.NormalId.Front
beam.Range = 52
beam.Angle = 50
beam.Brightness = 3
beam.Color = Color3.fromRGB(255, 244, 220)
beam.Shadows = true
beam.Enabled = false
beam.Parent = camLight

-- ---------------------------------------------------------------------------
-- звуки: гул музея, дыхание пустоты у проломов, шаги по разным полам

local drone = Instance.new("Sound")
drone.SoundId = "rbxasset://sounds/swoosh.wav"
drone.Looped = true
drone.PlaybackSpeed = 0.05
drone.Volume = 0
drone.Parent = gui
drone:Play()
local voidSound = Instance.new("Sound")
voidSound.SoundId = "rbxasset://sounds/swoosh.wav"
voidSound.Looped = true
voidSound.PlaybackSpeed = 0.09
voidSound.Volume = 0
voidSound.Parent = gui
voidSound:Play()

-- высота и громкость шагов для материала пола
local STEP = {
	[Enum.Material.Marble] = { 1.2, 0.8 },
	[Enum.Material.Slate] = { 1.05, 0.7 },
	[Enum.Material.WoodPlanks] = { 0.9, 0.65 },
	[Enum.Material.Wood] = { 0.9, 0.65 },
	[Enum.Material.Carpet] = { 0.7, 0.2 },
	[Enum.Material.Fabric] = { 0.7, 0.2 },
	[Enum.Material.Concrete] = { 0.95, 0.6 },
	[Enum.Material.CeramicTiles] = { 1.3, 0.75 },
	[Enum.Material.DiamondPlate] = { 1.5, 0.9 },
	[Enum.Material.Metal] = { 1.5, 0.9 },
	[Enum.Material.Sand] = { 0.6, 0.3 },
	[Enum.Material.Grass] = { 0.65, 0.3 },
	[Enum.Material.Cobblestone] = { 1, 0.6 },
}
local function stepSound()
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local snd = root and root:FindFirstChild("Running")
	if not snd or not hum or not snd:IsA("Sound") then
		return
	end
	local prof = STEP[hum.FloorMaterial] or { 1, 0.6 }
	local v = root.AssemblyLinearVelocity
	local speed = Vector3.new(v.X, 0, v.Z).Magnitude
	-- медленный шаг — редкие и тихие шаги
	snd.PlaybackSpeed = 1.85 * prof[1] * math.clamp(speed / 15, 0.45, 1.1)
	snd.Volume = if app.steps then prof[2] * (if app.sneaking then 0.3 else 1) else 0
end

local function voidStep(t: number, dt: number)
	local pos = camera.CFrame.Position
	local near = 0
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	for _, g in CollectionService:GetTagged("VoidGap") do
		if g:IsA("BasePart") then
			local lp = g.CFrame:PointToObjectSpace(pos)
			local half = (g:GetAttribute("Width") or 16) / 2
			local along = math.max(0, math.abs(lp.Z) - half)
			local dist = math.sqrt(lp.X * lp.X + along * along)
			near = math.max(near, math.clamp(1 - dist / 40, 0, 1))
			-- пустота тянет к пролому: сильнее всего прямо напротив дыры
			if root and not hiddenEye and not app.dead and along &lt; 5 and math.abs(lp.X) &lt; 16 then
				local dir = g:GetAttribute("Dir")
				if typeof(dir) == "Vector3" then
					local strength = (5 + 7 * math.clamp(1 - math.abs(lp.X) / 13, 0, 1)) * (1 - along / 5)
					root.CFrame += dir * strength * dt
				end
			end
		end
	end
	local breath = 0.6 + 0.4 * math.sin(t * 1.3) * math.sin(t * 0.37 + 1)
	voidSound.Volume = if app.ambience then near * 1.1 * breath else 0
	voidSound.PlaybackSpeed = 0.08 + 0.02 * math.sin(t * 0.9)
	drone.Volume = if not app.ambience then 0 elseif inRun() then 0.1 + (1 - (workspace:GetAttribute("Light") or 1)) * 0.25 else 0.04
end

-- Тьма: плоское лицо дрожит, глаза и рот дёргаются
local function darkStep(t: number)
	for _, d in CollectionService:GetTagged("Darkness") do
		local face = d:FindFirstChild("Face")
		if face then
			for _, f in face:GetChildren() do
				if f.Name == "Tendril" then
					f.Rotation += 6 + math.random() * 8
					f.Size = UDim2.fromScale(0.12 + math.random() * 0.1, 0.4 + math.random() * 0.25)
				elseif f.Name == "EyeL" or f.Name == "EyeR" then
					f.Size = UDim2.fromScale(0.13, 0.12 + math.abs(math.sin(t * 9)) * 0.1)
				elseif f.Name == "Mouth" then
					f.Size = UDim2.fromScale(0.26 + math.sin(t * 13) * 0.06, 0.08 + math.abs(math.sin(t * 7)) * 0.16)
				elseif f.Name == "Body" then
					f.Size = UDim2.fromScale(0.64 + math.sin(t * 17) * 0.03, 0.64 + math.cos(t * 15) * 0.03)
				end
			end
		end
	end
end

