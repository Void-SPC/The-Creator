        <Item class="ModuleScript" referent="RBX00000008">
          <Properties>
            <string name="Name">Materials</string>
            <ProtectedString name="Source">--!nonstrict
-- Материалы с защитой: если какого-то материала нет в версии Roblox, берётся SmoothPlastic
return setmetatable({}, {
	__index = function(t, k)
		local ok, v = pcall(function()
			return (Enum.Material :: any)[k]
		end)
		local m = if ok and v then v else Enum.Material.SmoothPlastic
		rawset(t, k, m)
		return m
	end,
})
</ProtectedString>
          </Properties>
        </Item>
        <Item class="Folder" referent="RBX00000009">
          <Properties>
            <string name="Name">Roblox</string>
          </Properties>
          <Item class="ModuleScript" referent="RBX0000000A">
            <Properties>
              <string name="Name">Remotes</string>
              <ProtectedString name="Source">--!nonstrict
-- Сетевые каналы игры. Сервер создаёт их, клиент ждёт появления

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Remotes = {}

local FUNCTIONS = { "Request", "AdminRequest" }
local EVENTS = { "Game" }

local folder: Folder

local function root(): Folder
	if folder then
		return folder
	end
	local ws = ReplicatedStorage:WaitForChild("Workshop")
	if RunService:IsServer() then
		local f = ws:FindFirstChild("Remotes") :: Folder?
		if not f then
			local nf = Instance.new("Folder")
			nf.Name = "Remotes"
			for _, name in FUNCTIONS do
				local rf = Instance.new("RemoteFunction")
				rf.Name = name
				rf.Parent = nf
			end
			for _, name in EVENTS do
				local re = Instance.new("RemoteEvent")
				re.Name = name
				re.Parent = nf
			end
			nf.Parent = ws
			f = nf
		end
		folder = f :: Folder
	else
		folder = ws:WaitForChild("Remotes") :: Folder
	end
	return folder
end

function Remotes.fn(name: string): RemoteFunction
	return root():WaitForChild(name) :: RemoteFunction
end

function Remotes.event(name: string): RemoteEvent
	return root():WaitForChild(name) :: RemoteEvent
end

return Remotes
</ProtectedString>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="RBX0000000B">
          <Properties>
            <string name="Name">RoomPlan</string>
            <ProtectedString name="Source">--!nonstrict
-- План забега без Roblox API: какая комната за каждой дверью (19 видов), где у неё
-- настоящий выход и ложные двери, лестницы вверх и вниз, замки, Монетчик,
-- Смотритель, Гул, свет. Путь идёт «лесенкой» и никогда не налезает на старые комнаты

local Rules = require(script.Parent.Rules)

local Plan = {}

-- Виды комнат. w — ширина, l — длина, h — высота, dy — подъём пола к выходу (лестницы),
-- exits — какие выходы бывают: front (по центру), frontL/frontR (у углов дальней стены),
-- side (в боковой стене у дальнего конца), branch — сколько дверей (лишние ведут
-- в никуда и переносят игрока к настоящей), min — с какой двери встречается
Plan.TEMPLATES = {
	corridor = { w = 10, l = 40, h = 12, weight = 13, exits = { "front", "side" } },
	longhall = { w = 10, l = 64, h = 12, weight = 6, min = 5, exits = { "front", "side" } },
	shorthall = { w = 10, l = 20, h = 12, weight = 5, exits = { "front" } },
	bedroom = { w = 26, l = 28, h = 13, weight = 10, exits = { "front", "frontL", "frontR", "side" } },
	suite = { w = 36, l = 40, h = 14, weight = 6, min = 8, exits = { "front", "frontL", "frontR", "side" }, branch = 3 },
	office = { w = 26, l = 26, h = 12, weight = 7, exits = { "front", "frontL", "frontR" } },
	library = { w = 34, l = 40, h = 16, weight = 5, min = 10, exits = { "frontL", "frontR", "side" }, branch = 2 },
	lounge = { w = 32, l = 30, h = 14, weight = 6, exits = { "front", "side" } },
	dining = { w = 30, l = 38, h = 14, weight = 5, exits = { "front", "side" } },
	kitchen = { w = 26, l = 30, h = 12, weight = 5, exits = { "front", "side" } },
	storage = { w = 30, l = 34, h = 14, weight = 5, min = 6, exits = { "frontL", "frontR", "side" }, branch = 2 },
	pillarhall = { w = 42, l = 46, h = 20, weight = 4, min = 12, exits = { "front", "frontL", "frontR", "side" }, branch = 3 },
	stairsup = { w = 14, l = 40, h = 12, weight = 4, min = 4, dy = 10, exits = { "front" } },
	stairsdown = { w = 14, l = 40, h = 12, weight = 4, min = 4, dy = -10, exits = { "front" } },
	bathroom = { w = 22, l = 24, h = 12, weight = 4, exits = { "front" } },
	laundry = { w = 26, l = 26, h = 12, weight = 4, exits = { "front", "side" } },
	empty = { w = 30, l = 30, h = 14, weight = 3, min = 15, exits = { "front", "frontL", "frontR" } },
	gallery = { w = 30, l = 40, h = 14, weight = 4, exits = { "front", "side" }, branch = 2 },
	crawl = { w = 12, l = 30, h = 9, weight = 3, min = 20, exits = { "front" } },
	-- особые
	start = { w = 30, l = 30, h = 14, exits = { "front" } },
	boss = { w = 76, l = 88, h = 26, exits = { "front" } },
}

Plan.ORDER = { "corridor", "longhall", "shorthall", "bedroom", "suite", "office", "library", "lounge", "dining", "kitchen", "storage", "pillarhall", "stairsup", "stairsdown", "bathroom", "laundry", "empty", "gallery", "crawl" }

-- выход по названию: x, z в кадре комнаты и поворот (-1 влево, 1 вправо, 0 прямо)
function Plan.exitPos(t, name: string, side: number): (number, number, number)
	if name == "front" then
		return 0, -t.l, 0
	elseif name == "frontL" then
		return -t.w / 4, -t.l, 0
	elseif name == "frontR" then
		return t.w / 4, -t.l, 0
	end
	return side * t.w / 2, -(t.l - 6), side
end

function Plan.rng(seed: number)
	local s = math.floor(seed) % 2147483647
	if s &lt;= 0 then
		s += 2147483646
	end
	return function(): number
		s = (s * 48271) % 2147483647
		return s / 2147483647
	end
end

function Plan.new(seed: number)
	local rand = Plan.rng(seed)
	-- путь идёт вперёд и в одну сторону (за забег сторона одна)
	local side = if rand() &lt; 0.5 then -1 else 1
	return { seed = seed, heading = 0, side = side, lastHum = -99, rand = rand, ox = 0, oy = 0, oz = 0, rects = {} }
end

-- «вперёд» и «вправо» на полу для курса h (0 — -Z, -1 — -X, 1 — +X)
local function frame(h: number): (number, number, number, number)
	if h == 0 then
		return 0, -1, 1, 0
	elseif h &lt; 0 then
		return -1, 0, 0, -1
	end
	return 1, 0, 0, 1
end
Plan.frame = frame

-- прямоугольник комнаты на полу { x0, z0, x1, z1 }
local function footprint(state, w: number, l: number)
	local fx, fz, rx, rz = frame(state.heading)
	local xs, zs = {}, {}
	for _, c in { { -w / 2, 0 }, { w / 2, 0 }, { -w / 2, l }, { w / 2, l } } do
		table.insert(xs, state.ox + rx * c[1] + fx * c[2])
		table.insert(zs, state.oz + rz * c[1] + fz * c[2])
	end
	return { math.min(table.unpack(xs)), math.min(table.unpack(zs)), math.max(table.unpack(xs)), math.max(table.unpack(zs)) }
end
Plan.footprint = footprint

-- налезает ли (или стоит вплотную стена к стене) на недавние комнаты, кроме предыдущей
Plan.GAP = 2.4
local function overlaps(state, r): boolean
	for i, o in state.rects do
		if i &lt; #state.rects then
			local ox = math.min(r[3], o[3]) - math.max(r[1], o[1])
			local oz = math.min(r[4], o[4]) - math.max(r[2], o[2])
			if ox &gt; -Plan.GAP and oz &gt; -Plan.GAP then
				return true
			end
		end
	end
	return false
end
Plan.overlaps = overlaps

local function pickKind(rand, door: number): string
	local total = 0
	for _, id in Plan.ORDER do
		local t = Plan.TEMPLATES[id]
		if door &gt;= (t.min or 0) then
			total += t.weight
		end
	end
	local r = rand() * total
	for _, id in Plan.ORDER do
		local t = Plan.TEMPLATES[id]
		if door &gt;= (t.min or 0) then
			r -= t.weight
			if r &lt;= 0 then
				return id
			end
		end
	end
	return "corridor"
end

-- куда ведёт выход: позиция следующей комнаты и её курс
local function after(state, x: number, z: number, turn: number)
	local fx, fz, rx, rz = frame(state.heading)
	return { ox = state.ox + rx * x + fx * -z, oz = state.oz + rz * x + fz * -z, heading = state.heading + turn }
end

-- поворот разрешён: вперёд или в сторону «лесенки», назад нельзя
local function turnAllowed(state, turn: number): boolean
	if turn == 0 then
		return true
	end
	local h = state.heading + turn
	if h &lt; -1 or h &gt; 1 then
		return false
	end
	if state.heading == 0 then
		return turn == state.side
	end
	return h == 0
end

-- Комната за дверью door. Вызывать по порядку с 0
function Plan.room(state, door: number)
	local rand = state.rand
	local d = { door = door, zone = Rules.zone(math.max(1, door)), decoys = {} }
	if door == 0 then
		d.kind = "start"
	elseif Rules.isBoss(door) then
		d.kind = "boss"
	else
		d.kind = pickKind(rand, door)
	end
	-- перед залом Слепого и в начале путь прямой и спокойный
	local calm = door &lt;= 1 or d.kind == "boss" or d.kind == "start"
	local beforeBoss = door &gt;= Rules.BOSS_DOOR - 3
	-- не помещается рядом со старыми — берётся комната поуже
	if not calm then
		for _, kind in { d.kind, "corridor", "shorthall" } do
			local t = Plan.TEMPLATES[kind]
			if not overlaps(state, footprint(state, t.w, t.l)) then
				d.kind = kind
				break
			end
		end
		if beforeBoss and (d.kind == "stairsup" or d.kind == "stairsdown") then
			d.kind = "corridor"
		end
	end
	local t = Plan.TEMPLATES[d.kind]
	d.w, d.l, d.h, d.dy = t.w, t.l, t.h, t.dy or 0
	-- выбор настоящего выхода: из разрешённых, с местом для следующей большой комнаты
	local mine = footprint(state, d.w, d.l)
	local options = {}
	for _, name in t.exits do
		local x, z, turn = Plan.exitPos(t, name, if state.heading == 0 then state.side else -state.heading)
		if turnAllowed(state, turn) and not (beforeBoss and turn ~= 0) and not (calm and name ~= "front") then
			table.insert(options, { name = name, x = x, z = z, turn = turn })
		end
	end
	-- перемешать варианты
	for i = #options, 2, -1 do
		local j = math.floor(rand() * i) + 1
		options[i], options[j] = options[j], options[i]
	end
	local chosen = nil
	for _, o in options do
		local nx = after(state, o.x, o.z, o.turn)
		nx.rects = table.clone(state.rects)
		-- для следующей комнаты эта будет «предыдущей» (стоит вплотную у двери)
		table.insert(nx.rects, mine)
		local big = Plan.TEMPLATES.suite
		if not overlaps(nx, footprint(nx, big.w, big.l)) then
			chosen = o
			break
		end
	end
	if not chosen then
		local x, z = Plan.exitPos(t, "front", 0)
		chosen = { name = "front", x = x, z = z, turn = 0 }
	end
	d.exit = { name = chosen.name, x = chosen.x, z = chosen.z, turn = chosen.turn, y = d.dy }
	-- ложные двери в развилистых комнатах: на других местах выхода
	if t.branch and not calm and not beforeBoss then
		local want = t.branch - 1
		for _, name in t.exits do
			if want &gt; 0 and name ~= chosen.name then
				local side = if state.heading == 0 then state.side else -state.heading
				local x, z, turn = Plan.exitPos(t, name, side)
				-- боковая ложная дверь может быть и на другой стене: она никуда не ведёт
				if name == "side" and rand() &lt; 0.5 then
					x, z, turn = Plan.exitPos(t, name, -side)
				end
				table.insert(d.decoys, { name = name, x = x, z = z, turn = turn, y = 0 })
				want -= 1
			end
		end
	end
	if not calm then
		local nextDoor = door + 1
		if not Rules.isBoss(nextDoor) then
			if rand() &lt; Rules.lockedChance(door) then
				d.locked = true
			elseif rand() &lt; Rules.coinChance(door) then
				d.coin = true
			end
		end
		d.watcher = d.kind ~= "corridor" and d.kind ~= "shorthall" and d.kind ~= "longhall" and d.kind ~= "crawl" and d.kind ~= "stairsup" and d.kind ~= "stairsdown" and rand() &lt; Rules.watcherChance(door)
		if door - state.lastHum &gt;= Rules.HUM_GAP and rand() &lt; Rules.humChance(door) then
			d.hum = true
			state.lastHum = door
		end
		d.windows = d.kind ~= "crawl" and rand() &lt; Rules.windowChance(door)
	end
	d.light = Rules.light(door)
	d.blackout = Rules.blackout(door)
	-- запомнить место и перейти к выходу
	table.insert(state.rects, mine)
	if #state.rects &gt; 7 then
		table.remove(state.rects, 1)
	end
	local nx = after(state, d.exit.x, d.exit.z, d.exit.turn)
	state.ox, state.oz, state.heading = nx.ox, nx.oz, nx.heading
	state.oy += d.dy
	d.heading = state.heading
	d.oy = state.oy
	return d
end

return Plan
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX0000000C">
          <Properties>
            <string name="Name">Rules</string>
            <ProtectedString name="Source">--!nonstrict
-- Правила «The Labyrinth» без Roblox API: глава из 100 дверей, свет и тьма по
-- глубине, предметы, Монетчик, фонарик, шум, Слепой. Проверяются тестами

local Rules = {}

-- глава ---------------------------------------------------------------------

Rules.CHAPTER = 100 -- за дверью 100 зал Слепого, потом погоня и пустота
Rules.BOSS_DOOR = 100

function Rules.isBoss(door: number): boolean
	return door == Rules.BOSS_DOOR
end

-- три цифры на табличке: 001 … 100
function Rules.plate(door: number): string
	return string.format("%03d", door)
end

-- оформление по глубине: отель → выцветший → гниль → глубина
function Rules.zone(door: number): string
	if door &lt;= 30 then
		return "hotel"
	elseif door &lt;= 60 then
		return "faded"
	elseif door &lt;= 85 then
		return "decay"
	end
	return "deep"
end

-- яркость ламп: с 20-й двери свет слабеет, 61–75 — электричества нет совсем
function Rules.light(door: number): number
	if door &lt; 20 then
		return 1
	elseif door &lt;= 60 then
		return 1 - (door - 20) / 40 * 0.6
	elseif door &lt;= 75 then
		return 0
	end
	return 0.3
end

function Rules.blackout(door: number): boolean
	return door &gt; 60 and door &lt;= 75
end

-- окна в пустоту: чем глубже, тем реже, после 45-й их нет
function Rules.windowChance(door: number): number
	if door &gt;= 45 then
		return 0
	end
	return 0.65 * (1 - door / 45)
end

-- здоровье и Монетчик --------------------------------------------------------

Rules.MAX_HEALTH = 100
Rules.TOLL_SHARE = 0.7 -- плата кровью: 70 % текущего здоровья

-- цена растёт с глубиной: в начале мало, у последних дверей около 500
function Rules.coinPrice(door: number): number
	local t = math.clamp(door / Rules.CHAPTER, 0, 1)
	return math.floor(5 + t ^ 1.6 * 495 + 0.5)
end

function Rules.afterBloodToll(health: number): number
	return math.max(1, health - health * Rules.TOLL_SHARE)
end

Rules.COINS_PER_DOOR = 3

-- фонарик --------------------------------------------------------------------

Rules.FLASH_MAX = 100
Rules.FLASH_DRAIN = 0.8 -- в секунду, пока горит
Rules.BATTERY = 50

function Rules.drain(charge: number, dt: number, on: boolean): number
	if not on then
		return charge
	end
	return math.max(0, charge - Rules.FLASH_DRAIN * dt)
end

function Rules.recharge(charge: number): number
	return math.min(Rules.FLASH_MAX, charge + Rules.BATTERY)
end

-- предметы -------------------------------------------------------------------

Rules.ITEMS = { "battery", "plant", "lockpick", "whistle", "key", "fuse" }
Rules.CAP = { battery = 5, plant = 2, lockpick = 3, whistle = 1, key = 9, fuse = 2 }
Rules.PLANT_HEAL = 40
Rules.SPEED = { walk = 15, sneak = 7 }

function Rules.canAdd(inv: { [string]: number }, item: string): boolean
	local cap = Rules.CAP[item]
	return cap ~= nil and (inv[item] or 0) &lt; cap
end

function Rules.add(inv: { [string]: number }, item: string): boolean
	if not Rules.canAdd(inv, item) then
		return false
	end
	inv[item] = (inv[item] or 0) + 1
	return true
end

function Rules.take(inv: { [string]: number }, item: string): boolean
	if (inv[item] or 0) &lt;= 0 then
		return false
	end
	inv[item] -= 1
	if inv[item] == 0 then
		inv[item] = nil
	end
	return true
end

-- что лежит в ящике: r в [0, 1). Лечебное растение — большая редкость
function Rules.loot(r: number, door: number): (string, number)
	if r &lt; 0.4 then
		return "coins", 2 + math.floor(r * 25) + math.floor(door / 10)
	elseif r &lt; 0.52 then
		return "battery", 1
	elseif r &lt; 0.56 then
		return "lockpick", 1
	elseif r &lt; 0.575 then
		return "plant", 1
	end
	return "nothing", 0
end

-- шум и Слепой ---------------------------------------------------------------

function Rules.noise(speed: number, sneaking: boolean): number
	if sneaking or speed &lt;= Rules.SPEED.sneak + 1 then
		return 0
	end
	return 30
end

Rules.NOISE = { repair = 45, gate = 120, whistle = 200, door = 60 }
Rules.BLIND_SPEED = { wander = 9, hunt = 17, chase = 14.5 }
Rules.BLIND_CONFUSED = 6
Rules.GENERATORS = 3
Rules.FUSES = 5
Rules.REPAIR_STEP = 34

function Rules.repair(progress: number): number
	return math.min(100, progress + Rules.REPAIR_STEP)
end

-- Смотритель -----------------------------------------------------------------

Rules.WATCHER_SPEED = 28
Rules.WATCHER_DAMAGE = 45
Rules.WATCHER_SEEN_TIME = 0.35
Rules.WHISTLE_FREEZE = 6

function Rules.watcherMoves(lastSeen: number?, now: number, frozenUntil: number?): boolean
	if frozenUntil and now &lt; frozenUntil then
		return false
	end
	return not lastSeen or now - lastSeen &gt; Rules.WATCHER_SEEN_TIME
end

-- шансы у двери (r в [0, 1)) -------------------------------------------------

function Rules.humChance(door: number): number
	if door &lt; 10 then
		return 0
	end
	return math.min(0.24, 0.08 + door / 500)
end

function Rules.watcherChance(door: number): number
	if door &lt; 15 then
		return 0
	end
	return math.min(0.22, 0.07 + door / 500)
end

function Rules.coinChance(door: number): number
	if door &lt; 6 then
		return 0
	end
	return 0.08
end

function Rules.lockedChance(door: number): number
	if door &lt; 3 then
		return 0
	end
	return math.min(0.3, 0.14 + door / 500)
end

Rules.HUM_GAP = 5

return Rules
</ProtectedString>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="RBX0000000D">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="RBX0000000E">
      <Properties>
        <string name="Name">Workshop</string>
      </Properties>
      <Item class="ModuleScript" referent="RBX0000000F">
        <Properties>
          <string name="Name">Access</string>
          <ProtectedString name="Source">--!nonstrict
-- Кто считается создателем: владелец игры, пользователи из Config и (в Studio) все
-- Права проверяются только на сервере; клиент лишь прячет кнопки

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Config = require(script.Parent.Config)

local Access = {}

local resolvedIds: { [number]: boolean } = {}
local cache: { [number]: boolean } = {}

-- Имена из Config переводятся в постоянные ID аккаунтов, чтобы смена ника не давала
-- доступ чужому человеку с таким же именем
task.spawn(function()
	for _, name in Config.CREATOR_USERNAMES do
		for _ = 1, 3 do
			local ok, id = pcall(function()
				return Players:GetUserIdFromNameAsync(name)
			end)
			if ok and type(id) == "number" then
				resolvedIds[id] = true
				table.clear(cache)
				break
			end
			task.wait(2)
		end
	end
end)

local function ownerOf(player: Player): boolean
	if game.CreatorType == Enum.CreatorType.User then
		return game.CreatorId == player.UserId
	end
	local ok, rank = pcall(function()
		return player:GetRankInGroup(game.CreatorId)
	end)
	return ok and rank &gt;= 254
end

function Access.isCreator(player: Player): boolean
	local c = cache[player.UserId]
	if c ~= nil then
		return c
	end
	local result = RunService:IsStudio()
		or ownerOf(player)
		or resolvedIds[player.UserId] == true
		or table.find(Config.CREATOR_USER_IDS, player.UserId) ~= nil
	-- кэшируем только положительный ответ: ID имени может прийти чуть позже
	if result then
		cache[player.UserId] = true
	end
	return result
end

-- Создатель по ID (для карт: валюту выдают только карты создателей)
function Access.isCreatorUserId(userId: number): boolean
	if RunService:IsStudio() then
		return true
	end
	if game.CreatorType == Enum.CreatorType.User and game.CreatorId == userId then
		return true
	end
	if resolvedIds[userId] or table.find(Config.CREATOR_USER_IDS, userId) then
		return true
	end
	local p = Players:GetPlayerByUserId(userId)
	return p ~= nil and Access.isCreator(p)
end

function Access.forget(player: Player)
	cache[player.UserId] = nil
end

return Access
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000010">
        <Properties>
          <string name="Name">Config</string>
          <ProtectedString name="Source">--!nonstrict
-- Настройки сервера «The Labyrinth»

local Config = {}

-- Создатели (админ-панель): владелец игры всегда, плюс эти имена (проверяются по ID)
Config.CREATOR_USERNAMES = { "Saren45hil", "Nataliaavira13" } :: { string }
Config.CREATOR_USER_IDS = {} :: { number }

-- Хранилище рекордов (только лучший номер двери, прогресс забега не сохраняется)
Config.DATASTORE_NAME = "Labyrinth_Records_v1"

return Config
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000011">
        <Properties>
          <string name="Name">DataStoreAdapter</string>
          <ProtectedString name="Source">--!nonstrict
-- Адаптер DataStore для рекордов
-- В Studio без доступа к API используется память сервера с предупреждением в выводе

local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")

local Config = require(script.Parent.Config)

local Adapter = {}

local function waitBudget(kind: Enum.DataStoreRequestType)
	local deadline = os.clock() + 15
	while DataStoreService:GetRequestBudgetForRequestType(kind) &lt; 1 and os.clock() &lt; deadline do
		task.wait(0.5)
	end
end

local function deepCopy(v: any): any
	if type(v) ~= "table" then
		return v
	end
	local o = {}
	for k, x in v do
		o[k] = deepCopy(x)
	end
	return o
end

function Adapter.memory()
	local data = {}
	return {
		kind = "memory",
		get = function(key: string)
			return deepCopy(data[key])
		end,
		update = function(key: string, fn)
			local nv = fn(deepCopy(data[key]))
			if nv ~= nil then
				data[key] = deepCopy(nv)
			end
			return deepCopy(nv)
		end,
	}
end

function Adapter.create()
	local ok, store = pcall(function()
		return DataStoreService:GetDataStore(Config.DATASTORE_NAME)
	end)
	if ok and RunService:IsStudio() then
		-- проверяем доступ к API в Studio
		local probe = pcall(function()
			return store:GetAsync("probe")
		end)
		if not probe then
			ok = false
		end
	end
	if not ok then
		warn("[Labyrinth] DataStore недоступен, поэтому данные хранятся только в памяти этого сервера (включите Studio Access to API Services)")
		return Adapter.memory()
	end
	local ds = store :: DataStore
	return {
		kind = "datastore",
		get = function(key: string)
			waitBudget(Enum.DataStoreRequestType.GetAsync)
			return ds:GetAsync(key)
		end,
		update = function(key: string, fn)
			waitBudget(Enum.DataStoreRequestType.UpdateAsync)
			return ds:UpdateAsync(key, function(old)
				return fn(old)
			end)
		end,
	}
end

return Adapter
</ProtectedString>
        </Properties>
      </Item>
      <Item class="Folder" referent="RBX00000012">
        <Properties>
          <string name="Name">Game</string>
        </Properties>
        <Item class="ModuleScript" referent="RBX00000013">
          <Properties>
            <string name="Name">Admin</string>
            <ProtectedString name="Source">--!nonstrict
-- Админ-панель: быстрые проверки игры одному (монеты, предметы, пропуск дверей,
-- вызов существ). Доступ только создателям, проверка на сервере

local Shared = game:GetService("ReplicatedStorage").Workshop.Shared
local Commands = require(Shared.AdminCommands)
local Rules = require(Shared.Rules)
local Remotes = require(Shared.Roblox.Remotes)

local Access = require(script.Parent.Parent.Access)
local Builder = require(script.Parent.Parent.World.RoomBuilder)
local Entities = require(script.Parent.Entities)
local G = require(script.Parent.Game)

local Admin = {}

-- открыть несколько дверей подряд и перенести живых игроков к последней
local function skip(count: number)
	local run = G.run
	if G.mode ~= "run" then
		return
	end
	for _ = 1, count do
		local n = run.front + 1
		local info = run.rooms[n - 1]
		if not info or not info.door or n &gt; Rules.CHAPTER then
			break
		end
		if info.toll then
			info.toll.paid = true
			info.toll.model:Destroy()
		end
		G.openDoor(n, true)
	end
	local info = run.rooms[run.front]
	if info then
		for _, p in G.alivePlayers() do
			G.unhide(p)
			G.teleport(p, info.origin * CFrame.new(0, 3, -4))
		end
	end
end

local RUN = {
	start_here = function()
		G.startHere()
	end,
	coins = function(p)
		G.give(p, "coins", 100)
	end,
	items = function(p)
		for _, it in { "battery", "plant", "lockpick" } do
			G.give(p, it)
		end
	end,
	fuses = function(p)
		G.give(p, "fuse")
		G.give(p, "fuse")
	end,
	heal = function(p)
		local hum = G.humOf(p)
		if hum then
			hum.Health = hum.MaxHealth
		end
	end,
	god = function(p)
		local s = G.players[p]
		if s then
			s.god = not s.god
			G.toast(p, if s.god then "GodOn" else "GodOff")
		end
	end,
	skip = function()
		skip(5)
	end,
	skip20 = function()
		skip(20)
	end,
	to_boss = function()
		skip(math.max(0, Rules.BOSS_DOOR - 1 - G.run.front))
	end,
	hum = function()
		task.spawn(Entities.hum)
	end,
	watcher = function(p)
		local r = G.rootOf(p)
		for _, info in G.run.rooms do
			if r and not info.boss and Builder.contains(info, r.Position) then
				Entities.spawnWatcher(info)
				return
			end
		end
	end,
	fix_gens = function()
		for _, info in G.run.rooms do
			if info.generators then
				for _, g in info.generators do
					g.fused = true
					g.progress = 99
				end
			end
		end
	end,
	restart = function()
		task.spawn(G.endRun)
	end,
}

function Admin.init()
	Remotes.fn("AdminRequest").OnServerInvoke = function(p: Player, action: any, id: any)
		if action == "Status" then
			return { ok = true, admin = Access.isCreator(p) }
		end
		if action ~= "Run" or not Access.isCreator(p) then
			return { ok = false }
		end
		if type(id) ~= "string" or not Commands.BY_ID[id] or not RUN[id] then
			return { ok = false }
		end
		local ok, err = pcall(RUN[id], p)
		if not ok then
			warn("[Labyrinth] admin " .. id .. ": " .. tostring(err))
		end
		return { ok = ok }
	end
end

return Admin
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000014">
          <Properties>
            <string name="Name">Entities</string>
            <ProtectedString name="Source">--!nonstrict
-- Существа лабиринта:
--   Гул — мигает свет, нарастает гул, вихрь с пастью проносится по комнатам; спасает
--   шкафчик или ниша
--   Смотритель — пока на него никто не смотрит, быстро идёт к ближайшему игроку
--   Слепой — в зале генераторов слышит шаги; после ворот гонится по техническому сектору

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local PathfindingService = game:GetService("PathfindingService")
local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")

local Shared = game:GetService("ReplicatedStorage").Workshop.Shared
local M = require(Shared.Materials)
local Rules = require(Shared.Rules)

local E = {}
local G

local SOUND = {
	rumble = "rbxasset://sounds/swoosh.wav",
	scream = "rbxasset://sounds/uuhhh.mp3",
	hit = "rbxasset://sounds/swordslash.wav",
	ping = "rbxasset://sounds/electronicpingshort.wav",
}
E.SOUND = SOUND

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local function sound(parent: Instance, id: string, vol: number, speed: number?, looped: boolean?)
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = vol
	s.PlaybackSpeed = speed or 1
	s.Looped = looped == true
	s.RollOffMaxDistance = 160
	s.Parent = parent
	s:Play()
	if not looped then
		Debris:AddItem(s, 8)
	end
	return s
end
E.sound = sound

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function part(m, name, size, cf, color, mat, extra)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = mat or M.SmoothPlastic
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in extra or {} do
		(p :: any)[k] = v
	end
	p.Parent = m
	return p
end

local function ball(m, name, d, cf, color, mat, extra)
	local p = part(m, name, Vector3.new(d, d, d), cf, color, mat, extra)
	p.Shape = Enum.PartType.Ball
	return p
end

-- сустав-стержень между точками
local function limb(m, name, a: Vector3, b: Vector3, thick: number, color, mat)
	local len = (b - a).Magnitude
	return part(m, name, Vector3.new(thick, thick, len), CFrame.lookAt((a + b) / 2, b), color, mat)
end

-- ---------------------------------------------------------------------------
-- Гул

E.humActive = false

local function flicker(lights, seconds: number)
	local t0 = os.clock()
	task.spawn(function()
		while os.clock() - t0 &lt; seconds do
			for _, bulb in lights do
				local l = bulb.Parent and bulb:FindFirstChildOfClass("PointLight")
				if l and not bulb:GetAttribute("Broken") and l:GetAttribute("Base") and l.Brightness &gt; 0 then
					l.Enabled = math.random() &lt; 0.45
				end
			end
			task.wait(0.08 + math.random() * 0.12)
		end
		for _, bulb in lights do
			local l = bulb.Parent and bulb:FindFirstChildOfClass("PointLight")
			if l and not bulb:GetAttribute("Broken") and l.Brightness &gt; 0 then
				l.Enabled = true
			end
		end
	end)
end

-- вихрь: тёмное ядро, рваная оболочка, кольцо зубов вокруг пасти, осколки по орбите
local function humModel(at: Vector3)
	local m = Instance.new("Model")
	m.Name = "Hum"
	local core = ball(m, "Core", 5, CFrame.new(at), rgb(14, 8, 16), M.SmoothPlastic)
	ball(m, "Shell", 7.5, CFrame.new(at), rgb(40, 10, 30), M.Glass, { Transparency = 0.55 })
	ball(m, "Maw", 2.6, CFrame.new(at) * CFrame.new(0, 0, -2.2), rgb(150, 10, 20), M.Neon)
	for k = 0, 11 do
		local a = k / 12 * math.pi * 2
		part(m, "Tooth", Vector3.new(0.35, 0.9, 0.35), CFrame.new(at) * CFrame.new(math.cos(a) * 1.6, math.sin(a) * 1.6, -2.6) * CFrame.Angles(0, 0, a + math.pi / 2), rgb(220, 210, 190), M.SmoothPlastic)
	end
	for k = 0, 9 do
		part(m, "Shard", Vector3.new(0.6, 1.6, 0.3), CFrame.new(at) * CFrame.Angles(k, k * 2, 0) * CFrame.new(0, 0, 5), rgb(30, 18, 26), M.Slate)
	end
	local aura = Instance.new("ParticleEmitter")
	aura.Color = ColorSequence.new(rgb(40, 8, 24))
	aura.Size = NumberSequence.new(4, 0)
	aura.Lifetime = NumberRange.new(0.5, 1)
	aura.Rate = 90
	aura.Speed = NumberRange.new(3, 8)
	aura.Parent = core
	local glow = Instance.new("PointLight")
	glow.Color = rgb(255, 40, 60)
	glow.Range = 32
	glow.Brightness = 2.2
	glow.Parent = core
	m.PrimaryPart = core
	return m, core
end

function E.hum()
	if E.humActive then
		return
	end
	local rooms = G.loadedRooms()
	if #rooms == 0 then
		return
	end
	E.humActive = true
	local lights = {}
	for _, info in rooms do
		for _, b in info.lights do
			table.insert(lights, b)
		end
	end
	G.sendAll({ type = "hum", phase = "warn" })
	flicker(lights, 3.8)
	local pts = {}
	for _, info in rooms do
		for _, p in info.path do
			table.insert(pts, p)
		end
	end
	local startPos = pts[1] - (pts[2] - pts[1]).Unit * 40
	local m, core = humModel(startPos)
	m.Parent = workspace
	local rumble = sound(core, SOUND.rumble, 3, 0.22, true)
	task.wait(3.8)
	G.sendAll({ type = "hum", phase = "rush" })
	local speed = 85
	local pos = startPos
	local spin = 0
	for i = 1, #pts do
		local target = pts[i]
		while (target - pos).Magnitude &gt; 1 do
			local dt = RunService.Heartbeat:Wait()
			local step = math.min(speed * dt, (target - pos).Magnitude)
			local dir = (target - pos).Unit
			pos += dir * step
			spin += dt * 9
			m:PivotTo(CFrame.lookAt(pos, pos + dir) * CFrame.Angles(0, 0, spin))
			for _, p in G.alivePlayers() do
				local r = G.rootOf(p)
				if r and not G.isHidden(p) then
					local off = r.Position - pos
					if flat(off).Magnitude &lt; 9 and math.abs(off.Y) &lt; 10 then
						G.kill(p, "hum")
					end
				end
			end
		end
	end
	-- часть ламп после него перегорает
	for _, b in lights do
		if b.Parent and math.random() &lt; 0.3 then
			b:SetAttribute("Broken", true)
			local l = b:FindFirstChildOfClass("PointLight")
			if l then
				l.Enabled = false
			end
			b.Material = M.Glass
		end
	end
	rumble:Stop()
	m:Destroy()
	G.sendAll({ type = "hum", phase = "gone" })
	E.humActive = false
end

-- ---------------------------------------------------------------------------
-- Смотритель: высокая тощая фигура, длинные руки с суставами и пальцами, маска

local watchers = {}
local nextId = 0

local function watcherModel(base: CFrame)
	local m = Instance.new("Model")
	m.Name = "Watcher"
	local skin = rgb(16, 14, 18)
	local pale = rgb(214, 208, 196)
	local function pt(x, y, z)
		return (base * CFrame.new(x, y, z)).Position
	end
	-- ноги
	for _, s in { -1, 1 } do
		local hip, knee, foot = pt(s * 0.5, 5.2, 0), pt(s * 0.6, 2.7, -0.3), pt(s * 0.65, 0.2, 0)
		limb(m, "Thigh", hip, knee, 0.42, skin)
		limb(m, "Shin", knee, foot, 0.34, skin)
		ball(m, "Knee", 0.5, CFrame.new(knee), skin)
		part(m, "Foot", Vector3.new(0.5, 0.25, 1.3), CFrame.new(foot) * base.Rotation * CFrame.new(0, 0, -0.35), skin)
	end
	-- туловище сужается кверху, рёбра проступают
	local body = part(m, "Body", Vector3.new(1.4, 2.2, 0.8), base * CFrame.new(0, 6.3, 0), skin, M.SmoothPlastic, { CanQuery = true })
	part(m, "Chest", Vector3.new(1.8, 2, 0.9), base * CFrame.new(0, 8.3, 0), skin, M.SmoothPlastic, { CanQuery = true })
	for k = 0, 2 do
		part(m, "Rib", Vector3.new(1.6, 0.12, 0.1), base * CFrame.new(0, 7.8 + k * 0.45, -0.47), rgb(40, 36, 42))
	end
	limb(m, "Neck", pt(0, 9.3, 0), pt(0, 10.6, -0.2), 0.35, skin)
	-- голова с маской: прорези глаз и рта, трещина
	local head = ball(m, "Head", 1.9, base * CFrame.new(0, 11.3, -0.2), skin, M.SmoothPlastic, { CanQuery = true })
	local mask = base * CFrame.new(0, 11.3, -1.05)
	part(m, "Mask", Vector3.new(1.5, 1.9, 0.18), mask, pale)
	for _, x in { -0.35, 0.35 } do
		part(m, "EyeHole", Vector3.new(0.32, 0.5, 0.06), mask * CFrame.new(x, 0.3, -0.1), rgb(0, 0, 0))
	end
	part(m, "Mouth", Vector3.new(0.8, 0.14, 0.06), mask * CFrame.new(0, -0.5, -0.1), rgb(0, 0, 0))
	part(m, "Crack", Vector3.new(0.06, 0.9, 0.04), mask * CFrame.new(0.15, 0.4, -0.1) * CFrame.Angles(0, 0, 0.3), rgb(60, 54, 50))
	-- руки ниже колен с суставами и пальцами
	for _, s in { -1, 1 } do
		local sh, el, wr = pt(s * 1.1, 9, 0), pt(s * 1.5, 6, -0.2), pt(s * 1.45, 2.6, -0.5)
		limb(m, "UpperArm", sh, el, 0.32, skin)
		limb(m, "Forearm", el, wr, 0.28, skin)
		ball(m, "Elbow", 0.4, CFrame.new(el), skin)
		ball(m, "Shoulder", 0.55, CFrame.new(sh), skin)
		for f = -1, 1 do
			limb(m, "Finger", wr, wr + (base.Rotation * Vector3.new(f * 0.25, -1.4, -0.2)), 0.1, skin)
		end
	end
	-- точка опоры — на полу между ступнями
	m.WorldPivot = base
	local _ = body
	return m, head
end

function E.spawnWatcher(info)
	nextId += 1
	local id = nextId
	local cf = info.watcherSpawn
	local look = info.center.Position
	local base = CFrame.lookAt(cf.Position, Vector3.new(look.X, cf.Y, look.Z))
	local m = watcherModel(base)
	m:SetAttribute("WatcherId", id)
	m.Parent = info.model
	CollectionService:AddTag(m, "Watcher")
	watchers[id] = { model = m, info = info, spawn = base, lastSeen = nil, frozenUntil = nil, pos = base.Position, cooldown = 0 }
	return id
end

function E.seen(p: Player, id: number)
	local w = watchers[id]
	if not w or not G.isAlive(p) then
		return
	end
	local r = G.rootOf(p)
	if r and (r.Position - w.pos).Magnitude &lt; 90 then
		w.lastSeen = os.clock()
	end
end

function E.removeRoom(info)
	for id, w in watchers do
		if w.info == info then
			w.model:Destroy()
			watchers[id] = nil
		end
	end
end

local function stepWatchers(dt: number)
	local now = os.clock()
	for id, w in watchers do
		if not w.model.Parent then
			watchers[id] = nil
			continue
		end
		local best, bestD = nil, math.huge
		for _, p in G.alivePlayers() do
			local r = G.rootOf(p)
			if r and not G.isHidden(p) and G.inRoom(w.info, r.Position) then
				local dd = flat(r.Position - w.pos).Magnitude
				if dd &lt; bestD then
					best, bestD = p, dd
				end
			end
		end
		if best and now &gt; w.cooldown and Rules.watcherMoves(w.lastSeen, now, w.frozenUntil) then
			local r = G.rootOf(best) :: BasePart
			local to = flat(r.Position - w.pos)
			if to.Magnitude &gt; 0.1 then
				w.pos += to.Unit * math.min(Rules.WATCHER_SPEED * dt, to.Magnitude)
			end
			if bestD &lt; 3.6 then
				G.damage(best, Rules.WATCHER_DAMAGE, "watcher")
				sound(w.model:FindFirstChild("Head") or w.model, SOUND.scream, 1.2, 1.3)
				G.send(best, { type = "fx", kind = "scare" })
				w.pos = w.spawn.Position
				w.cooldown = now + 3
			end
			local face = Vector3.new(r.Position.X, w.pos.Y, r.Position.Z)
			local cf = if (face - w.pos).Magnitude &gt; 0.1 then CFrame.lookAt(w.pos, face) else CFrame.new(w.pos)
			w.model:PivotTo(cf)
		end
	end
end

local function freezeWatchers(pos: Vector3)
	for _, w in watchers do
		if (w.pos - pos).Magnitude &lt; 70 then
			w.frozenUntil = os.clock() + Rules.WHISTLE_FREEZE
		end
	end
end

-- ---------------------------------------------------------------------------
-- Слепой

local blind = nil

local function blindModel(cf: CFrame)
	local desc = Instance.new("HumanoidDescription")
	local skin = rgb(196, 188, 176)
	local cloth = rgb(40, 38, 42)
	desc.HeadColor = skin
	desc.LeftArmColor, desc.RightArmColor = skin, skin
	desc.TorsoColor = cloth
	desc.LeftLegColor, desc.RightLegColor = cloth, cloth
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		return nil
	end
	model.Name = "Blind"
	for _, d in model:GetDescendants() do
		if d:IsA("Script") or d:IsA("LocalScript") then
			d:Destroy()
		elseif d:IsA("Decal") and d.Name == "face" then
			d:Destroy()
		end
	end
	local hum = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	hum.MaxHealth = math.huge
	hum.Health = math.huge
	pcall(function()
		model:ScaleTo(1.55)
	end)
	local function weldTo(to: BasePart?, name, size, offset: CFrame, color, mat, shape)
		if not to then
			return
		end
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.Color = color
		p.Material = mat or M.SmoothPlastic
		p.CanCollide = false
		p.CanQuery = false
		p.Massless = true
		if shape then
			p.Shape = shape
		end
		p.CFrame = to.CFrame * offset
		local w = Instance.new("WeldConstraint")
		w.Part0 = to
		w.Part1 = p
		w.Parent = p
		p.Parent = model
	end
	local head = model:FindFirstChild("Head") :: BasePart?
	if head then
		local s = head.Size
		-- повязка на глазах, зашитый рот, впалые щёки
		weldTo(head, "Blindfold", Vector3.new(s.X * 1.06, s.Y * 0.3, s.Z * 1.06), CFrame.new(0, s.Y * 0.12, 0), rgb(120, 104, 84), M.Fabric)
		weldTo(head, "Knot", Vector3.new(s.X * 0.3, s.Y * 0.25, s.Z * 0.2), CFrame.new(0, s.Y * 0.12, s.Z * 0.6), rgb(110, 94, 76), M.Fabric)
		weldTo(head, "Mouth", Vector3.new(s.X * 0.55, s.Y * 0.06, 0.05), CFrame.new(0, -s.Y * 0.24, -s.Z / 2 - 0.02), rgb(60, 10, 10))
		for k = -2, 2 do
			weldTo(head, "Stitch", Vector3.new(0.05, s.Y * 0.16, 0.05), CFrame.new(k * s.X * 0.1, -s.Y * 0.24, -s.Z / 2 - 0.04), rgb(30, 20, 18))
		end
		-- большие уши: он слушает
		for _, x in { -1, 1 } do
			weldTo(head, "Ear", Vector3.new(0.15, s.Y * 0.55, s.Z * 0.4), CFrame.new(x * s.X * 0.55, 0, 0) * CFrame.Angles(0, x * 0.4, 0), skin)
		end
	end
	for _, hn in { "LeftHand", "RightHand" } do
		local hand = model:FindFirstChild(hn) :: BasePart?
		if hand then
			for f = -1, 1 do
				weldTo(hand, "Finger", Vector3.new(0.1, hand.Size.Y * 2.2, 0.1), CFrame.new(f * hand.Size.X * 0.3, -hand.Size.Y * 1.3, -0.1), skin)
			end
		end
	end
	model:PivotTo(cf)
	return model, hum
end

function E.startBlind(info)
	E.stopBlind()
	local model, hum = blindModel(info.blindSpawn)
	if not model then
		return
	end
	model.Parent = info.model
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	hum.WalkSpeed = Rules.BLIND_SPEED.wander
	CollectionService:AddTag(model, "Blind")
	blind = { model = model, hum = hum, root = root, info = info, state = "wander", target = nil, confusedUntil = 0, wanderAt = 0, path = nil, pathAt = 0, wp = 1, growlAt = 0 }
end

function E.stopBlind()
	if blind then
		if blind.model then
			blind.model:Destroy()
		end
		blind = nil
	end
end

-- погоня: Слепой больше не прислушивается, бежит по тоннелю за ближайшим игроком
function E.chase(info)
	if not blind then
		E.startBlind(info)
	end
	if not blind then
		return
	end
	blind.state = "chase"
	blind.path = nil
	blind.chasePath = info.chase.path
	blind.chaseIdx = 1
	blind.hum.WalkSpeed = Rules.BLIND_SPEED.chase
	sound(blind.root, SOUND.scream, 2, 0.5)
end

function E.noise(pos: Vector3, radius: number, kind: string?)
	if not blind or not blind.root.Parent or blind.state == "chase" then
		return
	end
	if (blind.root.Position - pos).Magnitude &gt; radius then
		return
	end
	if kind == "whistle" then
		blind.state = "lure"
		blind.target = pos
		blind.confusedUntil = 0
		return
	end
	if blind.state == "confused" and os.clock() &lt; blind.confusedUntil then
		return
	end
	blind.state = "hunt"
	blind.target = pos
end

local function blindGo(goal: Vector3)
	local b = blind
	local now = os.clock()
	if not b.path or now - b.pathAt &gt; 1.2 or (b.goal and (b.goal - goal).Magnitude &gt; 6) then
		b.pathAt = now
		b.goal = goal
		local path = PathfindingService:CreatePath({ AgentRadius = 2.5, AgentHeight = 8, AgentCanJump = false })
		local ok = pcall(function()
			path:ComputeAsync(b.root.Position, goal)
		end)
		if ok and path.Status == Enum.PathStatus.Success then
			b.path = path:GetWaypoints()
			b.wp = 2
		else
			b.path = nil
			b.hum:MoveTo(goal)
			return
		end
	end
	local w = b.path and b.path[b.wp]
	if w then
		if flat(w.Position - b.root.Position).Magnitude &lt; 3 then
			b.wp += 1
			w = b.path[b.wp] or w
		end
		b.hum:MoveTo(w.Position)
	end
end

local function catch(b)
	for _, p in G.alivePlayers() do
		local r = G.rootOf(p)
		if r and not G.isHidden(p) and flat(r.Position - b.root.Position).Magnitude &lt; 5 and math.abs(r.Position.Y - b.root.Position.Y) &lt; 8 then
			G.kill(p, "blind")
			sound(b.root, SOUND.scream, 1.5, 0.6)
			return true
		end
	end
	return false
end

local function stepBlind()
	local b = blind
	if not b or not b.root.Parent then
		return
	end
	local now = os.clock()
	if b.state == "chase" then
		catch(b)
		-- ближайший живой игрок; бежит по точкам тоннеля к нему
		local best, bestD = nil, math.huge
		for _, p in G.alivePlayers() do
			local r = G.rootOf(p)
			if r then
				local dd = (r.Position - b.root.Position).Magnitude
				if dd &lt; bestD then
					best, bestD = r, dd
				end
			end
		end
		if best then
			local path = b.chasePath
			local i = b.chaseIdx
			if path[i] and flat(path[i] - b.root.Position).Magnitude &lt; 4 then
				b.chaseIdx = math.min(#path, i + 1)
			end
			-- если игрок рядом и в прямой видимости — прямо к нему
			if bestD &lt; 14 then
				b.hum:MoveTo(best.Position)
			else
				b.hum:MoveTo(path[b.chaseIdx] or best.Position)
			end
		end
		return
	end
	for _, p in G.alivePlayers() do
		local r = G.rootOf(p)
		if r and not G.isHidden(p) and G.inRoom(b.info, r.Position) then
			local v = r.AssemblyLinearVelocity
			local radius = Rules.noise(Vector3.new(v.X, 0, v.Z).Magnitude, G.isSneaking(p))
			if radius &gt; 0 and (r.Position - b.root.Position).Magnitude &lt; radius then
				E.noise(r.Position, radius, "step")
			end
		end
	end
	if catch(b) then
		b.state = "wander"
		b.target = nil
	end
	if b.state == "hunt" and b.target then
		b.hum.WalkSpeed = Rules.BLIND_SPEED.hunt
		blindGo(b.target)
		if flat(b.target - b.root.Position).Magnitude &lt; 4 then
			b.state = "confused"
			b.confusedUntil = now + 2.5
		end
		if now &gt; b.growlAt then
			b.growlAt = now + 3
			sound(b.root, SOUND.scream, 0.7, 0.35)
		end
	elseif b.state == "lure" and b.target then
		b.hum.WalkSpeed = Rules.BLIND_SPEED.hunt
		blindGo(b.target)
		if flat(b.target - b.root.Position).Magnitude &lt; 4 then
			b.state = "confused"
			b.confusedUntil = now + Rules.BLIND_CONFUSED
		end
	elseif b.state == "confused" then
		b.hum:MoveTo(b.root.Position)
		if now &gt; b.confusedUntil then
			b.state = "wander"
		end
	else
		b.hum.WalkSpeed = Rules.BLIND_SPEED.wander
		if not b.target or now &gt; b.wanderAt or flat(b.target - b.root.Position).Magnitude &lt; 4 then
			b.wanderAt = now + 8
			local list = b.info.wander
			b.target = list[math.random(1, #list)]
		end
		blindGo(b.target)
	end
end

-- ---------------------------------------------------------------------------

function E.whistle(p: Player)
	local r = G.rootOf(p)
	if not r then
		return
	end
	sound(r, SOUND.ping, 2, 2.2)
	freezeWatchers(r.Position)
	E.noise(r.Position, Rules.NOISE.whistle, "whistle")
end

function E.clear()
	for id, w in watchers do
		w.model:Destroy()
		watchers[id] = nil
	end
	E.stopBlind()
	for _, h in workspace:GetChildren() do
		if h.Name == "Hum" then
			h:Destroy()
		end
	end
	E.humActive = false
end

function E.init(game_)
	G = game_
	RunService.Heartbeat:Connect(function(dt)
		local ok, err = pcall(stepWatchers, dt)
		if not ok then
			warn("[Labyrinth] watcher: " .. tostring(err))
		end
	end)
	task.spawn(function()
		while true do
			task.wait(0.15)
			local ok, err = pcall(stepBlind)
			if not ok then
				warn("[Labyrinth] blind: " .. tostring(err))
			end
		end
	end)
end

return E
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000015">
          <Properties>
            <string name="Name">Game</string>
            <ProtectedString name="Source">--!nonstrict
-- «The Labyrinth»: лобби и забег.
-- Лобби (обычный сервер): холл с рабочим лифтом. Кто зашёл в кабину, через 12 секунд
-- переносится в отдельный сервер этого же места — там идёт забег (как в DOORS).
-- Забег: 100 дверей 001–100, комнаты строятся впереди и убираются позади, двери
-- открываются сами, когда подходишь (если не заперты и не стоит Монетчик), ложные
-- двери в развилках переносят к настоящей, ящики выдвигаются с находками, предметы
-- лежат в обычном инвентаре Roblox. За дверью 100 — зал Слепого, погоня и пустота

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local TeleportService = game:GetService("TeleportService")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage").Workshop.Shared
local Rules = require(Shared.Rules)
local Plan = require(Shared.RoomPlan)
local Remotes = require(Shared.Roblox.Remotes)
local Lang = require(Shared.Lang)
local M = require(Shared.Materials)

local Props = require(script.Parent.Parent.World.Props)
local Builder = require(script.Parent.Parent.World.RoomBuilder)
local Special = require(script.Parent.Parent.World.Special)
local Entities = require(script.Parent.Entities)
local Records = require(script.Parent.Records)

local G = {}

local event: RemoteEvent
local world: Folder

-- забег идёт в зарезервированном сервере; в Studio лифт превращает этот сервер в забег
G.mode = if game.PrivateServerId ~= "" and game.PrivateServerOwnerId == 0 then "run" else "lobby"

local KEEP_BEHIND = 3

local run = {
	active = false,
	seed = 0,
	plan = nil,
	descs = {},
	rooms = {},
	front = 0,
	ending = false,
	chasing = false,
	keepers = {},
}
G.run = run

local players: { [Player]: any } = {}
G.players = players
local occupied: { [BasePart]: Player } = {}
local lobby = nil

-- ---------------------------------------------------------------------------
-- общее

function G.rootOf(p: Player): BasePart?
	return p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
end
local rootOf = G.rootOf

local function humOf(p: Player): Humanoid?
	return p.Character and p.Character:FindFirstChildOfClass("Humanoid")
end
G.humOf = humOf

function G.send(p: Player, msg)
	if p.Parent then
		event:FireClient(p, msg)
	end
end
local send = G.send

function G.sendAll(msg)
	event:FireAllClients(msg)
end

local function toast(p: Player, key: string, ...)
	send(p, { type = "toast", key = key, args = { ... } })
end
G.toast = toast

local function announce(key: string, ...)
	G.sendAll({ type = "announce", key = key, args = { ... } })
end
G.announce = announce

function G.isAlive(p: Player): boolean
	local s = players[p]
	return s ~= nil and s.alive and not s.finished
end

function G.isHidden(p: Player): boolean
	local s = players[p]
	return s ~= nil and s.hidden ~= nil
end

function G.isSneaking(p: Player): boolean
	local s = players[p]
	return s ~= nil and s.sneaking == true
end

function G.alivePlayers(): { Player }
	local list = {}
	for p, s in players do
		if s.alive and not s.finished and p.Parent then
			table.insert(list, p)
		end
	end
	return list
end

function G.inRoom(info, pos: Vector3): boolean
	return Builder.contains(info, pos)
end

function G.loadedRooms()
	local list = {}
	for n = math.max(1, run.front - KEEP_BEHIND), run.front do
		local info = run.rooms[n]
		if info and not info.boss then
			table.insert(list, info)
		end
	end
	return list
end

local function teleport(p: Player, cf: CFrame)
	local char = p.Character
	if not char then
		return
	end
	local r = rootOf(p)
	if r then
		r.Anchored = false
		r.AssemblyLinearVelocity = Vector3.zero
	end
	pcall(function()
		p:RequestStreamAroundAsync(cf.Position, 3)
	end)
	char:PivotTo(cf)
end
G.teleport = teleport

local function sound(at: Instance?, id: string, vol: number, speed: number?)
	if at then
		Entities.sound(at, id, vol, speed)
	end
end

local SOUND = {
	door = "rbxasset://sounds/swoosh.wav",
	locked = "rbxasset://sounds/clickfast.wav",
	pick = "rbxasset://sounds/electronicpingshort.wav",
	drawer = "rbxasset://sounds/swoosh.wav",
	hit = "rbxasset://sounds/collide.wav",
}

-- ---------------------------------------------------------------------------
-- инвентарь: обычные инструменты Roblox в нижней панели

local ITEM_LOOK = {
	flashlight = { size = Vector3.new(0.45, 0.45, 1.5), color = Color3.fromRGB(46, 46, 50), mat = M.Metal },
	battery = { size = Vector3.new(0.4, 0.8, 0.4), color = Color3.fromRGB(40, 130, 60), mat = M.Metal },
	plant = { size = Vector3.new(0.7, 0.6, 0.7), color = Color3.fromRGB(140, 76, 54), mat = M.Brick },
	whistle = { size = Vector3.new(0.3, 0.3, 0.8), color = Color3.fromRGB(190, 190, 196), mat = M.Metal },
	lockpick = { size = Vector3.new(0.1, 0.1, 1.1), color = Color3.fromRGB(170, 170, 176), mat = M.Metal },
	key = { size = Vector3.new(0.15, 0.15, 1), color = Color3.fromRGB(190, 156, 88), mat = M.Metal },
	fuse = { size = Vector3.new(0.5, 0.5, 1), color = Color3.fromRGB(60, 110, 170), mat = M.Glass },
}

local function itemName(s, item: string, count: number): string
	local name = Lang.t(s.lang or "en", "item_" .. item)
	if count &gt; 1 then
		name ..= " ×" .. count
	end
	return name
end

local setFlash -- ниже

local function makeTool(p: Player, item: string)
	local look = ITEM_LOOK[item]
	local tool = Instance.new("Tool")
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool:SetAttribute("Item", item)
	local h = Instance.new("Part")
	h.Name = "Handle"
	h.Size = look.size
	h.Color = look.color
	h.Material = look.mat
	h.CanCollide = false
	h.Massless = true
	h.Parent = tool
	local function extra(name, size, offset, color, mat, shape)
		local e = Instance.new("Part")
		e.Name = name
		e.Size = size
		e.Color = color
		e.Material = mat
		e.CanCollide = false
		e.Massless = true
		if shape then
			e.Shape = shape
		end
		e.CFrame = h.CFrame * offset
		local w = Instance.new("WeldConstraint")
		w.Part0 = h
		w.Part1 = e
		w.Parent = e
		e.Parent = tool
	end
	if item == "flashlight" then
		extra("Head", Vector3.new(0.65, 0.65, 0.4), CFrame.new(0, 0, -0.9), Color3.fromRGB(60, 60, 64), M.Metal)
		extra("Lens", Vector3.new(0.5, 0.5, 0.05), CFrame.new(0, 0, -1.12), Color3.fromRGB(255, 240, 200), M.Neon)
		local l = Instance.new("SpotLight")
		l.Name = "Beam"
		l.Face = Enum.NormalId.Front
		l.Range = 50
		l.Angle = 48
		l.Brightness = 3
		l.Color = Color3.fromRGB(255, 244, 220)
		l.Shadows = true
		l.Enabled = false
		l.Parent = h
	elseif item == "plant" then
		extra("Leaves", Vector3.new(0.9, 0.9, 0.9), CFrame.new(0, 0.6, 0), Color3.fromRGB(80, 170, 90), M.Grass, Enum.PartType.Ball)
	elseif item == "fuse" then
		extra("Cap", Vector3.new(0.6, 0.6, 0.15), CFrame.new(0, 0, -0.55), Color3.fromRGB(190, 156, 88), M.Metal)
	elseif item == "key" then
		extra("Bow", Vector3.new(0.15, 0.5, 0.5), CFrame.new(0, 0, 0.6), Color3.fromRGB(190, 156, 88), M.Metal)
	end
	tool.Activated:Connect(function()
		G.use(p, item)
	end)
	if item == "flashlight" then
		tool.Equipped:Connect(function()
			setFlash(p, true)
		end)
		tool.Unequipped:Connect(function()
			setFlash(p, false)
		end)
	end
	tool.Parent = p:FindFirstChildOfClass("Backpack")
	return tool
end

-- инструменты по содержимому инвентаря: появляются, исчезают, подписаны числом
local function syncTools(p: Player)
	local s = players[p]
	if not s or not s.alive then
		return
	end
	local n = 0
	for _ in s.keys do
		n += 1
	end
	s.inv.key = if n &gt; 0 then n else nil
	local want = { flashlight = 1 }
	for item, count in s.inv do
		if ITEM_LOOK[item] then
			want[item] = count
		end
	end
	for item, tool in s.tools do
		if not want[item] or not tool.Parent then
			if tool.Parent then
				tool:Destroy()
			end
			s.tools[item] = nil
		end
	end
	for item, count in want do
		local tool = s.tools[item]
		if not tool then
			tool = makeTool(p, item)
			s.tools[item] = tool
		end
		tool.Name = itemName(s, item, count)
		tool.ToolTip = Lang.t(s.lang or "en", "tip_" .. item)
	end
	p:SetAttribute("Coins", s.coins)
	p:SetAttribute("Lockpicks", s.inv.lockpick or 0)
end
G.syncTools = syncTools

local function equipped(p: Player, item: string): boolean
	local char = p.Character
	local tool = char and char:FindFirstChildOfClass("Tool")
	return tool ~= nil and tool:GetAttribute("Item") == item
end

-- ---------------------------------------------------------------------------
-- урон и смерть

function G.damage(p: Player, amount: number, cause: string?)
	local s = players[p]
	local hum = humOf(p)
	if not s or not G.isAlive(p) or not hum or s.god then
		return
	end
	s.cause = cause
	hum:TakeDamage(amount)
end

function G.kill(p: Player, cause: string?)
	local s = players[p]
	local hum = humOf(p)
	if not s or not G.isAlive(p) or not hum or s.god then
		return
	end
	s.cause = cause
	hum.Health = 0
end

local endRun

local function anyoneLeft(): boolean
	return #G.alivePlayers() &gt; 0
end

local function onDied(p: Player)
	local s = players[p]
	if not s or not s.alive then
		return
	end
	s.alive = false
	p:SetAttribute("Alive", false)
	local part = s.hidden
	if part then
		occupied[part] = nil
		s.hidden = nil
	end
	send(p, { type = "dead", cause = s.cause or "unknown", door = run.front })
	announce("PlayerDied", p.DisplayName, Rules.plate(run.front))
	if not anyoneLeft() and run.active then
		task.spawn(endRun)
	end
end

-- ---------------------------------------------------------------------------
-- фонарик в руке

function setFlash(p: Player, on: boolean)
	local s = players[p]
	if not s then
		return
	end
	s.flashOn = on and s.flash &gt; 0 and s.alive and equipped(p, "flashlight")
	local tool = s.tools.flashlight
	local beam = tool and tool:FindFirstChild("Handle") and tool.Handle:FindFirstChild("Beam")
	if beam then
		beam.Enabled = s.flashOn
	end
	p:SetAttribute("FlashOn", s.flashOn)
	p:SetAttribute("Flash", math.ceil(s.flash))
end
G.setFlash = setFlash

-- ---------------------------------------------------------------------------
-- укрытия: шкафчики и ниши

local function unhide(p: Player)
	local s = players[p]
	local part = s and s.hidden
	if not part then
		return
	end
	s.hidden = nil
	occupied[part] = nil
	p:SetAttribute("HiddenEye", nil)
	local r = rootOf(p)
	if r then
		r.Anchored = false
		local out = part.CFrame * CFrame.new(0, -part.Size.Y / 2 + 3, -(part.Size.Z / 2 + 2.4))
		p.Character:PivotTo(CFrame.lookAt(out.Position, out.Position + part.CFrame.LookVector))
	end
end
G.unhide = unhide

local function hide(p: Player, part: BasePart)
	local s = players[p]
	if not s or not G.isAlive(p) then
		return
	end
	if s.hidden == part then
		unhide(p)
		return
	end
	if s.hidden or occupied[part] then
		toast(p, "ClosetTaken")
		return
	end
	s.hidden = part
	occupied[part] = p
	local r = rootOf(p)
	if r then
		p.Character:PivotTo(part.CFrame * CFrame.new(0, -part.Size.Y / 2 + 3, 0.2))
		r.Anchored = true
	end
	p:SetAttribute("HiddenEye", part.CFrame * CFrame.new(0, math.min(1.6, part.Size.Y / 2 - 0.6), -part.Size.Z / 2 + 0.2))
end

-- ---------------------------------------------------------------------------
-- предметы

local function give(p: Player, item: string, amount: number?): boolean
	local s = players[p]
	if not s then
		return false
	end
	if item == "coins" then
		s.coins += amount or 1
		sound(rootOf(p), SOUND.pick, 0.5, 1.6)
		syncTools(p)
		return true
	end
	if not Rules.add(s.inv, item) then
		toast(p, "BagFull")
		return false
	end
	sound(rootOf(p), SOUND.pick, 0.6)
	syncTools(p)
	return true
end
G.give = give

function G.use(p: Player, item: string)
	local s = players[p]
	if not s or not G.isAlive(p) then
		return
	end
	if item == "flashlight" then
		if s.flash &lt;= 0 then
			toast(p, "FlashEmpty")
		end
		setFlash(p, not s.flashOn)
	elseif item == "plant" then
		local hum = humOf(p)
		if not hum or hum.Health &gt;= hum.MaxHealth - 1 then
			toast(p, "HealthFull")
			return
		end
		if Rules.take(s.inv, "plant") then
			hum.Health = math.min(hum.MaxHealth, hum.Health + Rules.PLANT_HEAL)
			toast(p, "Healed")
		end
	elseif item == "battery" then
		if s.flash &gt;= Rules.FLASH_MAX - 1 then
			toast(p, "FlashFull")
			return
		end
		if Rules.take(s.inv, "battery") then
			s.flash = Rules.recharge(s.flash)
			setFlash(p, s.flashOn)
			toast(p, "Recharged")
		end
	elseif item == "whistle" then
		local now = os.clock()
		if now - (s.whistleAt or 0) &lt; 8 then
			toast(p, "WhistleWait")
			return
		end
		s.whistleAt = now
		Entities.whistle(p)
	else
		return
	end
	syncTools(p)
end

-- ---------------------------------------------------------------------------
-- комнаты

local function descOf(n: number)
	while run.descs[0] == nil or #run.descs &lt; n do
		local k = if run.descs[0] == nil then 0 else #run.descs + 1
		run.descs[k] = Plan.room(run.plan, k)
	end
	return run.descs[n]
end

local openDoor -- ниже

-- создать дверь с номером n в комнате info (у ложных дверей — тот же номер)
local function makeDoor(info, n: number, cf: CFrame, locked: boolean, decoy: boolean)
	local m, leaf = Props.door(info.model, cf, Rules.plate(n), locked)
	local door = { model = m, leaf = leaf, number = n, locked = locked, cf = cf, opened = false, decoy = decoy }
	if locked then
		-- отмычка: кнопка видна только тем, у кого она есть (это решает клиент)
		local trig = Props.P(m, "LockTrigger", Vector3.new(1, 1, 1), cf * CFrame.new(1.6, 4.5, 0.6), Color3.new(0, 0, 0), M.SmoothPlastic, Props.nc({ Transparency = 1 }))
		local pr = Props.prompt(trig, "lockpick", 2.5, 7)
		door.lockPrompt = pr
		pr.Triggered:Connect(function(p)
			G.pick(p, n)
		end)
	end
	return door
end

-- выдвинуть ящики и положить находки
local function openDrawers(p: Player, info, sr)
	if sr.opened then
		return
	end
	sr.opened = true
	local pr = sr.hit:FindFirstChildOfClass("ProximityPrompt")
	if pr then
		pr.Enabled = false
	end
	sound(sr.hit, SOUND.drawer, 0.6, 1.4)
	for _, dr in sr.drawers do
		local base = dr.model.WorldPivot
		local v = Instance.new("NumberValue")
		v.Changed:Connect(function(a)
			dr.model:PivotTo(base * CFrame.new(0, 0, -1.4 * a))
		end)
		local t = TweenService:Create(v, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Value = 1 })
		t:Play()
		t.Completed:Connect(function()
			v:Destroy()
		end)
	end
	task.delay(0.5, function()
		if not sr.hit.Parent then
			return
		end
		-- ключ от двери этой комнаты
		if sr.key then
			local dr = sr.drawers[1]
			local _, part = Props.pickup(info.model, dr.open, "key")
			part:SetAttribute("KeyFor", sr.key)
		end
		-- одна находка на предмет мебели, в случайном ящике
		local item, amount = Rules.loot(math.random(), run.front)
		if item ~= "nothing" then
			local dr = sr.drawers[math.random(1, #sr.drawers)]
			local cf = dr.open * CFrame.new(if sr.key and dr == sr.drawers[1] then 0.8 else 0, 0, 0)
			local _, part = Props.pickup(info.model, cf, item)
			if item == "coins" then
				part:SetAttribute("Amount", amount)
			end
		elseif not sr.key then
			toast(p, "Empty")
		end
		G.wirePickups(info)
	end)
end

function G.wirePickups(info)
	for _, d in info.model:GetDescendants() do
		if d:IsA("ProximityPrompt") and not d:GetAttribute("Wired") and d:GetAttribute("Kind") == "pick" then
			d:SetAttribute("Wired", true)
			local part = d.Parent
			d.Triggered:Connect(function(p)
				local s = players[p]
				if not s or not G.isAlive(p) or not part.Parent then
					return
				end
				local item = part:GetAttribute("Item")
				if item == "key" then
					s.keys[part:GetAttribute("KeyFor")] = true
					toast(p, "KeyTaken")
					sound(part, SOUND.pick, 0.8)
					syncTools(p)
				elseif item == "coins" then
					local a = part:GetAttribute("Amount") or 3
					give(p, "coins", a)
					toast(p, "Found_coins", a)
				elseif give(p, item) then
					toast(p, "Found_" .. item)
				else
					return
				end
				part.Parent:Destroy()
			end)
		end
	end
end

local function wireRoom(info)
	for _, cavity in info.hideSpots do
		local pr = cavity:FindFirstChildOfClass("ProximityPrompt")
		if pr and not pr:GetAttribute("Wired") then
			pr:SetAttribute("Wired", true)
			pr.Triggered:Connect(function(p)
				hide(p, cavity)
			end)
		end
	end
	for _, sr in info.searchables do
		local pr = sr.hit:FindFirstChildOfClass("ProximityPrompt")
		if pr and not pr:GetAttribute("Wired") then
			pr:SetAttribute("Wired", true)
			pr.Triggered:Connect(function(p)
				if G.isAlive(p) then
					openDrawers(p, info, sr)
				end
			end)
		end
	end
	G.wirePickups(info)
end

local function buildRoom(n: number)
	if run.rooms[n] or n &gt; Rules.CHAPTER then
		return run.rooms[n]
	end
	local d = descOf(n)
	local prev = if n &gt; 0 then (run.rooms[n - 1] or buildRoom(n - 1)) else nil
	local origin = if prev then prev.doorCF else CFrame.new(0, 0, 0)
	local rand = Plan.rng(run.seed + n * 7919)
	local info
	if d.kind == "boss" then
		info = Special.boss(world, d, origin, rand, prev)
	else
		info = Builder.build(world, d, origin, prev, rand)
	end
	info.n = n
	info.doorCF = info.exitCF
	run.rooms[n] = info
	if d.kind ~= "boss" then
		info.door = makeDoor(info, n + 1, info.doorCF, d.locked == true, false)
		info.decoys = {}
		for _, cf in info.decoyCFs do
			table.insert(info.decoys, makeDoor(info, n + 1, cf, false, true))
		end
	end
	-- ключ в одном из ящиков этой комнаты (или на виду, если ящиков нет)
	if d.locked then
		if #info.searchables &gt; 0 then
			info.searchables[math.floor(rand() * #info.searchables) + 1].key = n + 1
		else
			local _, part = Props.pickup(info.model, info.watcherSpawn * CFrame.new(0, 0, 2), "key")
			part:SetAttribute("KeyFor", n + 1)
		end
	end
	if d.coin then
		local price = Rules.coinPrice(n + 1)
		local keeper, pc, pb = Special.coinKeeper(info.model, info.doorCF * CFrame.new(0, 0, 2.6) * CFrame.Angles(0, math.pi, 0), price)
		info.toll = { model = keeper, price = price, paid = false, base = keeper:GetPivot() }
		table.insert(run.keepers, info.toll)
		pc.Triggered:Connect(function(p)
			G.payToll(p, info, "coins")
		end)
		pb.Triggered:Connect(function(p)
			G.payToll(p, info, "blood")
		end)
	end
	if d.watcher then
		Entities.spawnWatcher(info)
	end
	wireRoom(info)
	if info.boss then
		G.wireBoss(info)
	end
	return info
end
G.buildRoom = buildRoom

local function destroyRoom(n: number)
	local info = run.rooms[n]
	if not info then
		return
	end
	Entities.removeRoom(info)
	for part, p in occupied do
		if part:IsDescendantOf(info.model) then
			unhide(p)
		end
	end
	if info.toll then
		local i = table.find(run.keepers, info.toll)
		if i then
			table.remove(run.keepers, i)
		end
	end
	info.model:Destroy()
	run.rooms[n] = nil
end

local function frontSpawn(): CFrame
	local info = run.rooms[run.front] or run.rooms[0]
	return info.origin * CFrame.new(0, 3, -4)
end
G.frontSpawn = frontSpawn

local function cleanup()
	local keepFrom = run.front - KEEP_BEHIND
	for n, info in run.rooms do
		if n &lt; keepFrom then
			local target = run.rooms[keepFrom]
			if target then
				for _, p in G.alivePlayers() do
					local r = rootOf(p)
					if r and Builder.contains(info, r.Position) then
						teleport(p, target.origin * CFrame.new(0, 3, -4))
					end
				end
			end
			destroyRoom(n)
		end
	end
end

local function swing(door)
	local leaf = door.leaf
	local base = leaf:GetPivot()
	local v = Instance.new("NumberValue")
	v.Changed:Connect(function(a)
		leaf:PivotTo(base * CFrame.Angles(0, math.rad(-100) * a, 0))
	end)
	local t = TweenService:Create(v, TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Value = 1 })
	t:Play()
	t.Completed:Connect(function()
		v:Destroy()
	end)
	for _, d in leaf:GetDescendants() do
		if d:IsA("BasePart") then
			d.CanCollide = false
		end
	end
	sound(leaf:FindFirstChild("Slab"), SOUND.door, 0.8, 0.6)
end

function openDoor(n: number, force: boolean?)
	local info = run.rooms[n - 1]
	if not info or not info.door or info.door.opened then
		return false
	end
	local door = info.door
	door.opened = true
	local lock = door.model:FindFirstChild("Padlock")
	if lock then
		lock:Destroy()
	end
	if door.lockPrompt then
		door.lockPrompt.Enabled = false
	end
	swing(door)
	run.front = math.max(run.front, n)
	workspace:SetAttribute("Door", run.front)
	for _, s in players do
		s.keys[n] = nil
	end
	for p, s in players do
		if G.isAlive(p) then
			if Records.offer(p, n) then
				local ls = p:FindFirstChild("leaderstats")
				local b = ls and ls:FindFirstChild("Best")
				if b then
					(b :: IntValue).Value = n
				end
			end
			s.coins += Rules.COINS_PER_DOOR
			syncTools(p)
		end
	end
	local entered = buildRoom(n)
	buildRoom(n + 1)
	cleanup()
	workspace:SetAttribute("Light", entered.desc.light or 1)
	Entities.noise(door.model:GetPivot().Position, Rules.NOISE.door)
	if entered.boss then
		Entities.startBlind(entered)
		announce("BossHall")
	elseif entered.desc.blackout and not (run.descs[n - 1] and run.descs[n - 1].blackout) then
		announce("Blackout")
	end
	if entered.desc.hum and not force then
		task.delay(1.5 + math.random() * 3, function()
			if run.active and run.front &gt;= n then
				Entities.hum()
			end
		end)
	end
	return true
end
G.openDoor = openDoor

local lockedToastAt: { [Player]: number } = {}

-- игрок подошёл к двери n
function G.tryOpen(p: Player, n: number)
	local s = players[p]
	if not s or not G.isAlive(p) or s.hidden then
		return
	end
	local info = run.rooms[n - 1]
	if not info or not info.door or info.door.opened then
		return
	end
	local now = os.clock()
	if info.toll and not info.toll.paid then
		return
	end
	if info.door.locked then
		if s.keys[n] then
			s.keys[n] = nil
			toast(p, "Unlocked")
			syncTools(p)
		else
			if now - (lockedToastAt[p] or 0) &gt; 4 then
				lockedToastAt[p] = now
				sound(info.door.model:FindFirstChildWhichIsA("BasePart"), SOUND.locked, 0.8)
				toast(p, if (s.inv.lockpick or 0) &gt; 0 then "LockedPick" else "Locked")
			end
			return
		end
	end
	openDoor(n)
end

-- отмычка у запертой двери
function G.pick(p: Player, n: number)
	local s = players[p]
	local info = run.rooms[n - 1]
	if not s or not G.isAlive(p) or not info or not info.door or info.door.opened then
		return
	end
	if Rules.take(s.inv, "lockpick") then
		toast(p, "Picked")
		syncTools(p)
		openDoor(n)
	else
		toast(p, "NoLockpick")
	end
end

-- ложная дверь в развилке: глюк, и игрока переносит к настоящей двери (или назад)
function G.decoy(p: Player, info)
	local s = players[p]
	if not s or not G.isAlive(p) then
		return
	end
	local now = os.clock()
	if now - (s.glitchAt or 0) &lt; 2 then
		return
	end
	s.glitchAt = now
	send(p, { type = "glitch" })
	task.wait(0.35)
	local n = info.n + 1
	local blocked = info.door.locked and not s.keys[n] or (info.toll and not info.toll.paid)
	if blocked or not G.isAlive(p) then
		-- настоящая дверь закрыта: лабиринт возвращает в середину комнаты
		teleport(p, info.center * CFrame.new(0, -info.size.Y / 2 + 3, 0))
		return
	end
	if info.door.locked then
		s.keys[n] = nil
		syncTools(p)
	end
	openDoor(n)
	local nextRoom = run.rooms[n]
	if nextRoom then
		teleport(p, nextRoom.origin * CFrame.new(0, 3, -4))
	end
end

-- ---------------------------------------------------------------------------
-- Монетчик

function G.payToll(p: Player, info, how: string)
	local s = players[p]
	local t = info.toll
	if not s or not G.isAlive(p) or not t or t.paid then
		return
	end
	if how == "coins" then
		if s.coins &lt; t.price then
			toast(p, "NotEnoughCoins", t.price)
			return
		end
		s.coins -= t.price
		toast(p, "PaidCoins", t.price)
	else
		local hum = humOf(p)
		if not hum then
			return
		end
		hum.Health = Rules.afterBloodToll(hum.Health)
		send(p, { type = "fx", kind = "blood" })
		toast(p, "PaidBlood")
	end
	t.paid = true
	syncTools(p)
	for _, d in t.model:GetDescendants() do
		if d:IsA("BasePart") then
			d.CanCollide = false
			TweenService:Create(d, TweenInfo.new(1.2), { Transparency = 1 }):Play()
		elseif d:IsA("ProximityPrompt") then
			d.Enabled = false
		elseif d:IsA("PointLight") or d:IsA("BillboardGui") then
			d.Enabled = false
		end
	end
	task.delay(1.4, function()
		t.model:Destroy()
	end)
end

-- ---------------------------------------------------------------------------
-- зал Слепого и погоня

local function openBigGate(info)
	if info.gateOpen then
		return
	end
	info.gateOpen = true
	announce("GateOpen")
	local gate = info.bigGate
	local base = info.bigGateHome
	local v = Instance.new("NumberValue")
	v.Changed:Connect(function(a)
		gate:PivotTo(base * CFrame.new(0, 12 * a, 0))
	end)
	local t = TweenService:Create(v, TweenInfo.new(3.5, Enum.EasingStyle.Sine), { Value = 1 })
	t:Play()
	t.Completed:Connect(function()
		v:Destroy()
		for _, d in gate:GetDescendants() do
			if d:IsA("BasePart") then
				d.CanCollide = false
			end
		end
		-- Слепой больше не слушает — он бежит
		run.chasing = true
		Entities.chase(info)
		announce("Run")
		G.sendAll({ type = "chase" })
	end)
	sound(gate:FindFirstChildWhichIsA("BasePart"), SOUND.hit, 2, 0.4)
end

local function repair(p: Player, info, g)
	local s = players[p]
	if not s or not G.isAlive(p) or g.done then
		return
	end
	if not g.fused then
		if Rules.take(s.inv, "fuse") then
			g.fused = true
			toast(p, "FuseIn")
			sound(g.body, SOUND.pick, 1)
			syncTools(p)
		else
			toast(p, "NeedFuse")
		end
		return
	end
	g.progress = Rules.repair(g.progress)
	local sp = g.body:FindFirstChild("Sparks")
	if sp then
		(sp :: ParticleEmitter):Emit(25)
	end
	sound(g.body, SOUND.hit, 1.2, 0.8)
	Entities.noise(g.body.Position, Rules.NOISE.repair, "repair")
	if g.progress &gt;= 100 then
		g.done = true
		g.lamp.Color = Color3.fromRGB(60, 230, 90)
		local l = g.lamp:FindFirstChildOfClass("PointLight")
		if l then
			l.Color = Color3.fromRGB(90, 255, 120)
		end
		local done = 0
		for _, gg in info.generators do
			if gg.done then
				done += 1
			end
		end
		announce("GeneratorFixed", done, #info.generators)
		if done &gt;= #info.generators then
			openBigGate(info)
		end
	else
		toast(p, "Repairing", g.progress)
	end
end

function G.wireBoss(info)
	for _, g in info.generators do
		local pr = g.body:FindFirstChildOfClass("ProximityPrompt")
		if pr then
			pr.Triggered:Connect(function(p)
				repair(p, info, g)
			end)
		end
	end
end

-- добежал до края: финальная сцена у игрока, дальше «Продолжение следует»
local function finish(p: Player)
	local s = players[p]
	if not s or s.finished or not s.alive then
		return
	end
	s.finished = true
	p:SetAttribute("Finished", true)
	unhide(p)
	Records.offer(p, Rules.CHAPTER)
	Records.complete(p)
	local boss = run.rooms[Rules.BOSS_DOOR]
	local edge = boss and boss.chase and boss.chase.edge
	local r = rootOf(p)
	if r and edge then
		r.Anchored = true
		p.Character:PivotTo(edge * CFrame.new(0, 3, 2))
	end
	send(p, { type = "ending", edge = edge })
	if not anyoneLeft() then
		task.spawn(endRun)
	end
end
G.finish = finish

-- ---------------------------------------------------------------------------
-- начало и конец забега

local function resetPlayer(p: Player)
	local s = players[p]
	s.alive = true
	s.finished = false
	s.cause = nil
	s.coins = 0
	s.inv = { whistle = 1 }
	s.keys = {}
	s.flash = Rules.FLASH_MAX
	s.flashOn = false
	s.sneaking = false
	s.hidden = nil
	for _, t in s.tools do
		if t.Parent then
			t:Destroy()
		end
	end
	s.tools = {}
	p:SetAttribute("Alive", true)
	p:SetAttribute("Finished", nil)
	p:SetAttribute("HiddenEye", nil)
	p:SetAttribute("Sneaking", false)
end

local function loadCharacter(p: Player, cf: CFrame, inRun: boolean)
	resetPlayer(p)
	p:LoadCharacter()
	local char = p.Character or p.CharacterAdded:Wait()
	char:WaitForChild("HumanoidRootPart", 5)
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.WalkSpeed = Rules.SPEED.walk
		-- прыжков нет: проходы в лабиринте всегда без прыжка
		hum.UseJumpPower = true
		hum.JumpPower = 0
		hum.Died:Connect(function()
			onDied(p)
		end)
	end
	teleport(p, cf)
	if inRun then
		syncTools(p)
		setFlash(p, false)
	else
		players[p].alive = false
		p:SetAttribute("Alive", nil)
	end
end

local function startRun()
	run.active = true
	run.ending = false
	run.chasing = false
	run.seed = math.random(1, 2 ^ 30)
	run.plan = Plan.new(run.seed)
	run.descs = {}
	run.rooms = {}
	run.keepers = {}
	run.front = 0
	world:ClearAllChildren()
	workspace:SetAttribute("Door", 0)
	workspace:SetAttribute("Light", 1)
	workspace:SetAttribute("Mode", "run")
	buildRoom(0)
	buildRoom(1)
end

local function startPoint(): CFrame
	local start = run.rooms[0]
	return start.origin * CFrame.new(math.random(-6, 6), 3, -20 + math.random(-3, 3))
end

-- в лобби (или заново в Studio)
local function toLobby(p: Player)
	if RunService:IsStudio() then
		return
	end
	pcall(function()
		TeleportService:TeleportAsync(game.PlaceId, { p })
	end)
end
G.toLobby = toLobby

function endRun()
	if run.ending then
		return
	end
	run.ending = true
	G.sendAll({ type = "results", door = run.front })
	task.wait(10)
	if RunService:IsStudio() or G.mode == "lobby" then
		-- в Studio забег просто начинается заново
		Entities.clear()
		table.clear(occupied)
		startRun()
		for p in players do
			if p.Parent then
				task.spawn(loadCharacter, p, startPoint(), true)
			end
		end
		return
	end
	local list = {}
	for p in players do
		if p.Parent then
			table.insert(list, p)
		end
	end
	if #list &gt; 0 then
		pcall(function()
			TeleportService:TeleportAsync(game.PlaceId, list)
		end)
	end
end
G.endRun = endRun

-- лобби превращается в забег прямо в этом сервере (Studio и кнопка админа)
function G.startHere(list: { Player }?)
	if G.mode == "run" then
		return
	end
	G.mode = "run"
	if lobby then
		lobby.model:Destroy()
		lobby = nil
	end
	startRun()
	for p in players do
		if p.Parent then
			task.spawn(loadCharacter, p, startPoint(), true)
		end
	end
	local _ = list
end

-- ---------------------------------------------------------------------------
-- лифт в лобби: кто в кабине, через 12 секунд уезжает в отдельный сервер

local LIFT_TIME = 12
local liftAt = nil
local function lobbyStep()
	if G.mode ~= "lobby" or not lobby then
		return
	end
	local zone = lobby.zone
	local inside = {}
	for p in players do
		local r = rootOf(p)
		if r then
			local lp = zone.CFrame:PointToObjectSpace(r.Position)
			if math.abs(lp.X) &lt; zone.Size.X / 2 and math.abs(lp.Z) &lt; zone.Size.Z / 2 and math.abs(lp.Y) &lt; zone.Size.Y / 2 then
				table.insert(inside, p)
			end
		end
	end
	if #inside == 0 then
		liftAt = nil
		lobby.board.Text = "001"
		return
	end
	local now = os.clock()
	liftAt = liftAt or now + LIFT_TIME
	local left = math.max(0, math.ceil(liftAt - now))
	lobby.board.Text = string.format("00:%02d  %d/4", left, math.min(#inside, 4))
	if left &gt; 0 then
		return
	end
	liftAt = nil
	local group = {}
	for i = 1, math.min(4, #inside) do
		table.insert(group, inside[i])
		send(inside[i], { type = "lift" })
	end
	if RunService:IsStudio() then
		G.startHere(group)
		return
	end
	task.spawn(function()
		local ok, err = pcall(function()
			local code = TeleportService:ReserveServer(game.PlaceId)
			local opts = Instance.new("TeleportOptions")
			opts.ReservedServerAccessCode = code
			TeleportService:TeleportAsync(game.PlaceId, group, opts)
		end)
		if not ok then
			warn("[Labyrinth] teleport: " .. tostring(err))
			for _, p in group do
				toast(p, "LiftFailed")
			end
		end
	end)
end

-- ---------------------------------------------------------------------------

function G.init()
	Players.CharacterAutoLoads = false
	event = Remotes.event("Game")
	world = Instance.new("Folder")
	world.Name = "Labyrinth"
	world.Parent = workspace
	Records.init()
	Entities.init(G)
	workspace:SetAttribute("Mode", G.mode)
	if G.mode == "run" then
		startRun()
	else
		lobby = Special.lobby(world)
	end

	local function added(p: Player)
		local ls = Instance.new("Folder")
		ls.Name = "leaderstats"
		local best = Instance.new("IntValue")
		best.Name = "Best"
		best.Parent = ls
		ls.Parent = p
		players[p] = { alive = false, coins = 0, inv = {}, keys = {}, flash = Rules.FLASH_MAX, tools = {}, lang = "en" }
		best.Value = Records.load(p)
		if G.mode == "run" then
			-- опоздавший попадает к остальным
			local cf = if run.front &gt;= 2 then frontSpawn() else startPoint()
			loadCharacter(p, cf, true)
		else
			loadCharacter(p, lobby.spawn * CFrame.new(math.random(-4, 4), 0, math.random(-3, 3)), false)
		end
	end
	Players.PlayerAdded:Connect(added)
	for _, p in Players:GetPlayers() do
		task.spawn(added, p)
	end
	Players.PlayerRemoving:Connect(function(p)
		unhide(p)
		players[p] = nil
		lockedToastAt[p] = nil
		Records.forget(p)
		if G.mode == "run" and run.active and not anyoneLeft() and #Players:GetPlayers() &gt; 1 then
			task.spawn(endRun)
		end
	end)

	Remotes.fn("Request").OnServerInvoke = function(p: Player, action: any, arg: any)
		local s = players[p]
		if not s then
			return { ok = false }
		end
		if action == "Lang" and (arg == "en" or arg == "ru") then
			s.lang = arg
			syncTools(p)
			return { ok = true }
		elseif action == "Sneak" then
			s.sneaking = arg == true
			p:SetAttribute("Sneaking", s.sneaking)
			local hum = humOf(p)
			if hum and s.alive then
				hum.WalkSpeed = if s.sneaking then Rules.SPEED.sneak else Rules.SPEED.walk
			end
			return { ok = true }
		elseif action == "Unhide" then
			unhide(p)
			return { ok = true }
		elseif action == "Seen" and type(arg) == "number" then
			Entities.seen(p, arg)
			return nil
		elseif action == "Lobby" then
			toLobby(p)
			return { ok = true }
		elseif action == "Status" then
			syncTools(p)
			return { ok = true, best = Records.get(p), mode = G.mode }
		end
		return { ok = false }
	end

	-- двери у подошедших, ложные двери, фонарик, Монетчики, край пустоты, упавшие
	task.spawn(function()
		local t = 0
		while true do
			local dt = task.wait(0.15)
			t += dt
			pcall(lobbyStep)
			if G.mode == "run" and run.active then
				local info = run.rooms[run.front]
				local boss = run.rooms[Rules.BOSS_DOOR]
				for _, p in G.alivePlayers() do
					local s = players[p]
					local r = rootOf(p)
					if r and not s.hidden then
						if info and info.door and not info.door.opened then
							local lp = info.door.cf:PointToObjectSpace(r.Position)
							if lp.Z &gt; -0.5 and lp.Z &lt; 7 and math.abs(lp.X) &lt; 4 and lp.Y &gt; -1 and lp.Y &lt; 8 then
								G.tryOpen(p, info.n + 1)
							end
							for _, dc in info.decoys or {} do
								local dp = dc.cf:PointToObjectSpace(r.Position)
								if dp.Z &gt; -0.5 and dp.Z &lt; 3.5 and math.abs(dp.X) &lt; 3 and dp.Y &gt; -1 and dp.Y &lt; 8 then
									task.spawn(G.decoy, p, info)
								end
							end
						end
						-- край пустоты
						if boss and boss.chase and run.chasing then
							local ep = boss.chase.edge:PointToObjectSpace(r.Position)
							if ep.Z &lt; 1.5 and math.abs(ep.X) &lt; 6 then
								finish(p)
							end
						end
						if s.flashOn then
							s.flash = Rules.drain(s.flash, dt, true)
							if s.flash &lt;= 0 then
								setFlash(p, false)
								toast(p, "FlashEmpty")
							else
								p:SetAttribute("Flash", math.ceil(s.flash))
							end
						end
						local base = (run.rooms[run.front] or run.rooms[0]).origin.Y
						if r.Position.Y &lt; base - 60 then
							if run.chasing then
								finish(p)
							else
								teleport(p, frontSpawn())
							end
						end
					end
				end
				-- Монетчики покачиваются в воздухе
				for _, k in run.keepers do
					if not k.paid and k.model.Parent then
						k.model:PivotTo(k.base * CFrame.new(0, math.sin(t * 2) * 0.35, 0))
					end
				end
			end
		end
	end)
end

return G
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000016">
          <Properties>
            <string name="Name">Records</string>
            <ProtectedString name="Source">--!nonstrict
-- Рекорды: лучший номер двери и сколько раз глава пройдена (больше ничего не сохраняется)

local Config = require(script.Parent.Parent.Config)
local Adapter = require(script.Parent.Parent.DataStoreAdapter)

local Records = {}

local store = nil
local best: { [number]: number } = {}

local function key(userId: number): string
	return "u_" .. userId
end

function Records.init()
	local _ = Config
	store = Adapter.create()
end

function Records.load(p: Player): number
	local ok, data = pcall(function()
		return store.get(key(p.UserId))
	end)
	local b = if ok and type(data) == "table" and type(data.best) == "number" then data.best else 0
	best[p.UserId] = b
	return b
end

function Records.get(p: Player): number
	return best[p.UserId] or 0
end

-- новый рекорд сохраняется сразу (в фоне)
function Records.offer(p: Player, door: number): boolean
	if p.UserId &lt;= 0 or door &lt;= (best[p.UserId] or 0) then
		return false
	end
	best[p.UserId] = door
	task.spawn(function()
		pcall(function()
			store.update(key(p.UserId), function(old)
				local o = if type(old) == "table" then old else {}
				o.best = math.max(tonumber(o.best) or 0, door)
				return o
			end)
		end)
	end)
	return true
end

-- глава пройдена до конца (добежал до пустоты)
function Records.complete(p: Player)
	if p.UserId &lt;= 0 then
		return
	end
	task.spawn(function()
		pcall(function()
			store.update(key(p.UserId), function(old)
				local o = if type(old) == "table" then old else {}
				o.done = (tonumber(o.done) or 0) + 1
				return o
			end)
		end)
	end)
end

function Records.forget(p: Player)
	best[p.UserId] = nil
end

return Records
</ProtectedString>
          </Properties>
        </Item>
      </Item>
      <Item class="Script" referent="RBX00000017">
        <Properties>
          <string name="Name">Main</string>
          <ProtectedString name="Source">--!nonstrict
-- Точка входа сервера «The Labyrinth»

local Players = game:GetService("Players")
local Remotes = require(game:GetService("ReplicatedStorage").Workshop.Shared.Roblox.Remotes)
local Access = require(script.Parent.Access)
local G = require(script.Parent.Game.Game)
local Admin = require(script.Parent.Game.Admin)

-- сеть создаётся до всего остального, чтобы клиенты могли подключиться сразу
Remotes.event("Game")
G.init()
Admin.init()

Players.PlayerRemoving:Connect(function(p)
	Access.forget(p)
end)
</ProtectedString>
          <bool name="Disabled">false</bool>
