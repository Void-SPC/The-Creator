            <string name="Name">Lang</string>
            <ProtectedString name="Source">--!nonstrict
-- Тексты «The Labyrinth» на английском и русском. Правило: без точек в конце и между
-- частями (короткие подписи); формат string.format

local Lang = {}

Lang.en = {
