-- Проверка правила точек. Возвращает список нарушений
function UiText.lint()
	local problems = {}
	for key, text in UiText.L do
		-- маскируем десятичные числа и версии
		local masked = string.gsub(text, "%d+%.%d+", "0")
		if string.find(masked, "%.$") or string.find(masked, "%.%s*\n") then
			table.insert(problems, "L." .. key .. ": конечная точка в короткой подписи")
		end
		if string.find(masked, "%.%s+%S") then
			table.insert(problems, "L." .. key .. ": точка-разделитель внутри подписи")
		end
	end
	for key, text in UiText.H do
		local masked = string.gsub(text, "%d+%.%d+", "0")
		-- каждое предложение начинается с заглавной буквы и содержит хотя бы два слова (подлежащее и сказуемое)
		for sentence in string.gmatch(masked .. " ", "(.-[%.!?])%s") do
			local words = 0
			for _ in string.gmatch(sentence, "%S+") do
				words += 1
			end
			if words &lt; 2 then
				table.insert(problems, "H." .. key .. ": обрывок вместо предложения «" .. sentence .. "»")
			end
		end
		local cp = utf8.codepoint(masked, 1)
		local isLower = (cp &gt;= 0x61 and cp &lt;= 0x7A) or (cp &gt;= 0x430 and cp &lt;= 0x44F) or cp == 0x451
		if isLower then
			table.insert(problems, "H." .. key .. ": предложение со строчной буквы")
		end
		if not string.find(masked, "[%.!?]$") then
			table.insert(problems, "H." .. key .. ": подсказка не завершена")
		end
	end
	table.sort(problems)
	return problems
end

function UiText.f(key: string, ...: any): string
	local s = UiText.L[key] or UiText.H[key]
	if not s then
		return key
	end
	if select("#", ...) &gt; 0 then
		return string.format(s, ...)
	end
	return s
end

return UiText
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000028">
          <Properties>
            <string name="Name">Util</string>
            <ProtectedString name="Source">--!nonstrict
-- Мелкие помощники для работы с таблицами данных проекта

local Util = {}

function Util.deepCopy&lt;T&gt;(v: T): T
	if type(v) ~= "table" then
		return v
	end
	local out = {}
	for k, x in v :: any do
		out[k] = Util.deepCopy(x)
	end
	return (out :: any) :: T
end

function Util.deepEqual(a: any, b: any): boolean
	if type(a) ~= type(b) then
		return false
	end
	if type(a) ~= "table" then
		return a == b
	end
	for k, v in a do
		if not Util.deepEqual(v, b[k]) then
			return false
		end
	end
	for k in b do
		if a[k] == nil then
			return false
		end
	end
	return true
end

function Util.keys(t: { [any]: any }): { any }
	local out = {}
	for k in t do
		table.insert(out, k)
	end
	table.sort(out, function(a, b)
		return tostring(a) &lt; tostring(b)
	end)
	return out
end

function Util.count(t: { [any]: any }): number
	local n = 0
	for _ in t do
		n += 1
	end
	return n
end

function Util.clamp(v: number, lo: number, hi: number): number
	if v ~= v then
		return lo
	end
	if v &lt; lo then
		return lo
	elseif v &gt; hi then
		return hi
	end
	return v
end

-- Нижний регистр с учётом кириллицы (string.lower меняет только латиницу)
function Util.lower(s: string): string
	if utf8.len(s) == nil then
		return string.lower(s)
	end
	local out = {}
	for _, cp in utf8.codes(s) do
		if cp &gt;= 0x41 and cp &lt;= 0x5A then
			cp += 0x20
		elseif cp &gt;= 0x410 and cp &lt;= 0x42F then
			cp += 0x20
		elseif cp == 0x401 then
			cp = 0x451
		end
		table.insert(out, utf8.char(cp))
	end
	return table.concat(out)
end

function Util.trim(s: string): string
	return (string.gsub(s, "^%s*(.-)%s*$", "%1"))
end

-- Грубая оценка размера данных в байтах (для лимита DataStore)
function Util.approxSize(v: any): number
	local t = type(v)
	if t == "string" then
		return #v + 2
	elseif t == "number" then
		return 8
	elseif t == "boolean" then
		return 5
	elseif t == "table" then
		local n = 2
		for k, x in v do
			n += Util.approxSize(k) + Util.approxSize(x) + 1
		end
		return n
	end
	return 4
end

return Util
</ProtectedString>
          </Properties>
        </Item>
      </Item>
