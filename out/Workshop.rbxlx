	DiedAt = "Дверь %d",
	Spectating = "Наблюдаешь: %s",
	SpectateNext = "Следующий игрок",
	Results = "Забег окончен: дверь %d",
	NewRun = "Скоро новый забег",

	Shop = "Лавка в лифте",
	Buy = "Купить",
	Price = "%d монет",
	Admin = "Админ",
