local BUILDERS = {
	room = Prefabs.room,
	baseplate = Prefabs.baseplate,
	statue = Prefabs.statue,
	railing = Prefabs.railing,
	desk = Prefabs.desk,
	corridor = Prefabs.corridor,
	floorAbove = Prefabs.floorAbove,
	wall = Prefabs.wall,
	stairs = Prefabs.stairs,
	door = Prefabs.door,
	lamp = Prefabs.lamp,
	closet = Prefabs.closet,
	bookshelf = Prefabs.bookshelf,
	table = Prefabs.table,
	chair = Prefabs.chair,
	bed = Prefabs.bed,
	sign = Prefabs.sign,
	spawn = Prefabs.spawn,
	zone = Prefabs.zone,
	waypoint = Prefabs.waypoint,
	npcNew = Prefabs.npcNew,
	npcRetro = Prefabs.npcRetro,
	fox = Prefabs.fox,
	officeInspector = Prefabs.officeInspector,
	officeCoin = Prefabs.officeCoin,
	officeCoinMoustache = Prefabs.officeCoinMoustache,
}

-- Строит объекты готовой модели в точке origin. Объекты ещё не добавлены в проект
function Prefabs.build(project, prefabId: string, origin)
	local b = BUILDERS[prefabId]
	if not b then
		return nil
	end
	return offsetAll(b(project), origin or { 0, 0, 0 })
end

function Prefabs.shape(project, shape: string, origin)
	local p = Format.newPart(Ids.alloc(project, "o"), shape)
	p.name = "Деталь"
	p.pos = MathX.add({ 0, 2, 0 }, origin or { 0, 0, 0 })
	p.latin = Ids.suggestLatin(project, "Part")
	return p
end

return Prefabs
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000021">
          <Properties>
            <string name="Name">Rig</string>
            <ProtectedString name="Source">--!nonstrict
-- Иерархия деталей модели (суставы) и прямая кинематика
-- У каждой детали модели есть поза покоя (pos/rot относительно начала модели),
-- необязательный родитель и точка вращения pivot в координатах самой детали
-- Поворот родителя переносит всех потомков: голова поворачивается вместе с ушами

local MathX = require(script.Parent.MathX)

local Rig = {}

-- Порядок обхода: родители раньше детей
function Rig.order(model): { string }
	local parts = model.parts
	local out, state = {}, {}
	local function visit(id: string)
		if state[id] == 2 then
			return
		end
		if state[id] == 1 then
			return -- цикл; Format.validateObject не пропускает такие данные
		end
		state[id] = 1
		local p = parts[id]
		if p.parent and parts[p.parent] then
			visit(p.parent)
		end
		state[id] = 2
		table.insert(out, id)
	end
	local ids = {}
	for id in parts do
		table.insert(ids, id)
	end
	table.sort(ids)
	for _, id in ids do
		visit(id)
	end
	return out
end

function Rig.rest(part)
	return MathX.tf(part.pos, part.rot)
end

-- Смещение из ключа: D = T(dp) * T(c) * R * T(-c)
function Rig.deltaTf(pivot, dpos, drot)
	local m = MathX.matFromEuler(drot or { 0, 0, 0 })
	local c = pivot or { 0, 0, 0 }
	local p = MathX.add(MathX.add(dpos or { 0, 0, 0 }, c), MathX.scale(MathX.matApply(m, c), -1))
	return { p = p, m = m }
end

-- Обратное к deltaTf: из матрицы смещения получаем dp и углы
function Rig.deltaFromTf(pivot, d)
	local c = pivot or { 0, 0, 0 }
	local dp = MathX.add(MathX.sub(d.p, c), MathX.matApply(d.m, c))
	return dp, MathX.eulerFromMat(d.m)
end

-- Мировые трансформы всех деталей для позы sample = {[partId] = {pos, rot}}
function Rig.pose(model, sample, modelTf)
	local parts = model.parts
	local world = {}
	sample = sample or {}
	for _, id in Rig.order(model) do
		local part = parts[id]
		local s = sample[id]
		local d = if s then Rig.deltaTf(part.pivot, s.pos, s.rot) else MathX.tfIdentity()
		local base
		if part.parent and world[part.parent] then
			local parentRest = Rig.rest(parts[part.parent])
			local localRest = MathX.toLocal(parentRest, Rig.rest(part))
			base = MathX.mul(world[part.parent], localRest)
		else
			base = MathX.mul(modelTf, Rig.rest(part))
		end
		world[id] = MathX.mul(base, d)
	end
	return world
end

-- Какое смещение ключа даст детали мировой трансформ desired при текущей позе родителей
function Rig.solveDelta(model, world, modelTf, partId: string, desired)
	local part = model.parts[partId]
	local base
	if part.parent and world[part.parent] then
		local parentRest = Rig.rest(model.parts[part.parent])
		local localRest = MathX.toLocal(parentRest, Rig.rest(part))
		base = MathX.mul(world[part.parent], localRest)
	else
		base = MathX.mul(modelTf, Rig.rest(part))
	end
	local d = MathX.toLocal(base, desired)
	return Rig.deltaFromTf(part.pivot, d)
end

-- Установка родителя с защитой от циклов
function Rig.setParent(model, partId: string, parentId: string?): boolean
	if parentId == nil then
		model.parts[partId].parent = nil
		return true
	end
	if parentId == partId or model.parts[parentId] == nil then
		return false
	end
	local cur: string? = parentId
	while cur do
		if cur == partId then
			return false
		end
		cur = model.parts[cur].parent
	end
	model.parts[partId].parent = parentId
	return true
end

-- Удаление детали: дети переходят к её родителю, клипы не трогаем
function Rig.removePart(model, partId: string)
	local removed = model.parts[partId]
	if not removed then
		return
	end
	for _, p in model.parts do
		if p.parent == partId then
			p.parent = removed.parent
		end
	end
	model.parts[partId] = nil
end

return Rig
</ProtectedString>
          </Properties>
        </Item>
        <Item class="Folder" referent="RBX00000022">
          <Properties>
            <string name="Name">Roblox</string>
          </Properties>
          <Item class="ModuleScript" referent="RBX00000023">
            <Properties>
              <string name="Name">Animator</string>
              <ProtectedString name="Source">--!nonstrict
-- Проигрывание клипов модели. Движение по карте (корень модели) и движение частей
-- тела (клип) независимы: маршрут меняет root, клип двигает лапы относительно root

local Shared = script.Parent.Parent
local Anim = require(Shared.Anim)
local WorldBuilder = require(script.Parent.WorldBuilder)

local Animator = {}
Animator.__index = Animator

function Animator.new(handle, rootCF: CFrame)
	local self = setmetatable({}, Animator)
	self.handle = handle
	self.root = rootCF
	self.clip = nil
	self.elapsed = 0
	self.loopOverride = nil
	self.dirty = true
	return self
end

function Animator:findClip(name: string)
	local obj = self.handle.obj
	if obj.kind ~= "model" then
		return nil
	end
	for _, c in obj.model.clips do
		if c.name == name then
			return c
		end
	end
	return nil
end

function Animator:play(name: string, loop: boolean?)
	local clip = self:findClip(name)
	if not clip then
		return false
	end
	self.clip = clip
	self.elapsed = 0
	self.loopOverride = loop
	self.dirty = true
	return true
end

function Animator:stop()
	self.clip = nil
	self.dirty = true
end

function Animator:setRoot(cf: CFrame)
	self.root = cf
	self.dirty = true
end

function Animator:isLooping(): boolean
	if not self.clip then
		return false
	end
	if self.loopOverride ~= nil then
		return self.loopOverride
	end
	return self.clip.loop
end

-- Возвращает пройденные метки и завершённый клип (для событий логики)
function Animator:update(dt: number)
	local markers, finished = nil, nil
	local sample = nil
	if self.clip then
		local clip = self.clip
		local e0 = self.elapsed
		self.elapsed += dt
		local looping = self:isLooping()
		local view = if looping ~= clip.loop then table.clone(clip) else clip
		if view ~= clip then
			view.loop = looping
		end
		markers = Anim.markersCrossed(view, e0, self.elapsed)
		local t, done = Anim.wrapTime(view, self.elapsed)
		sample = Anim.sample(clip, t)
		if done then
			finished = clip
			self.clip = nil
		end
		self.dirty = true
	end
	if self.dirty then
		WorldBuilder.poseModel(self.handle, sample, self.root)
		self.dirty = self.clip ~= nil
	end
	return markers, finished
end

return Animator
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00000024">
            <Properties>
              <string name="Name">Convert</string>
              <ProtectedString name="Source">--!nonstrict
-- Перевод данных проекта в типы Roblox и обратно

local MathX = require(script.Parent.Parent.MathX)

local Convert = {}

local function r3(x: number): number
	local v = math.floor(x * 1000 + 0.5) / 1000
	if v == 0 then
		return 0
	end
	return v
end

function Convert.v3(v): Vector3
	return Vector3.new(v[1], v[2], v[3])
end

function Convert.fromV3(v: Vector3)
	return { r3(v.X), r3(v.Y), r3(v.Z) }
end

function Convert.cf(tf): CFrame
	local m = tf.m
	return CFrame.new(tf.p[1], tf.p[2], tf.p[3], m[1], m[2], m[3], m[4], m[5], m[6], m[7], m[8], m[9])
end

function Convert.tf(cf: CFrame)
	local x, y, z, a, b, c, d, e, f, g, h, i = cf:GetComponents()
	return { p = { x, y, z }, m = { a, b, c, d, e, f, g, h, i } }
end

function Convert.cfFrom(pos, rot): CFrame
	return Convert.cf(MathX.tf(pos, rot))
end

-- CFrame -&gt; pos, rot (градусы YXZ) для хранения в проекте
function Convert.posRot(cf: CFrame)
	local tf = Convert.tf(cf)
	local pos, rot = MathX.decompose(tf)
	return { r3(pos[1]), r3(pos[2]), r3(pos[3]) }, rot
end

function Convert.color(c): Color3
	return Color3.fromRGB(c[1], c[2], c[3])
end

function Convert.fromColor(c: Color3)
	return { math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5) }
end

return Convert
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00000025">
            <Properties>
              <string name="Name">Remotes</string>
              <ProtectedString name="Source">--!nonstrict
-- Сетевые каналы мастерской. Сервер создаёт их, клиент ждёт появления

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Remotes = {}

local FUNCTIONS = { "Request", "MafiaRequest", "CastleRequest", "AdminRequest" }
local EVENTS = { "Mafia", "Castle" }

local folder: Folder

local function root(): Folder
	if folder then
		return folder
	end
	local ws = ReplicatedStorage:WaitForChild("Workshop")
	if RunService:IsServer() then
		local f = ws:FindFirstChild("Remotes") :: Folder?
		if not f then
			local nf = Instance.new("Folder")
			nf.Name = "Remotes"
			for _, name in FUNCTIONS do
				local rf = Instance.new("RemoteFunction")
				rf.Name = name
				rf.Parent = nf
			end
			for _, name in EVENTS do
				local re = Instance.new("RemoteEvent")
				re.Name = name
				re.Parent = nf
			end
			nf.Parent = ws
			f = nf
		end
		folder = f :: Folder
	else
		folder = ws:WaitForChild("Remotes") :: Folder
	end
	return folder
end

function Remotes.fn(name: string): RemoteFunction
	return root():WaitForChild(name) :: RemoteFunction
end

function Remotes.event(name: string): RemoteEvent
	return root():WaitForChild(name) :: RemoteEvent
end

return Remotes
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00000026">
            <Properties>
              <string name="Name">WorldBuilder</string>
              <ProtectedString name="Source">--!nonstrict
-- Построение экземпляров Roblox по данным проекта
-- Используется клиентом редактора (локальный предпросмотр) и сервером игры

local Shared = script.Parent.Parent
local Convert = require(script.Parent.Convert)
local MathX = require(Shared.MathX)
local Rig = require(Shared.Rig)
local Catalog = require(Shared.Catalog)

local WorldBuilder = {}

local MARKER_ROLES = { spawn = true, zone = true, waypoint = true }
local FACES = { "Front", "Back", "Left", "Right", "Top", "Bottom" }

local function newBasePart(shape: string): BasePart
	if shape == "Wedge" then
		return Instance.new("WedgePart")
	elseif shape == "CornerWedge" then
		return Instance.new("CornerWedgePart")
	end
	local p = Instance.new("Part")
	if shape == "Ellipsoid" then
		-- как в Office: блок со сферическим мешем, вписанным в размер детали
		p.Shape = Enum.PartType.Block
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
	elseif shape == "Ball" then
		p.Shape = Enum.PartType.Ball
	elseif shape == "Cylinder" then
		p.Shape = Enum.PartType.Cylinder
	else
		p.Shape = Enum.PartType.Block
	end
	return p
end

function WorldBuilder.applyLook(inst: BasePart, data)
	inst.Size = Convert.v3(data.size)
	inst.Color = Convert.color(data.color)
	-- старые клиенты могут не знать новых материалов: тогда гладкий пластик
	local okM, mat = pcall(function()
		return (Enum.Material :: any)[data.material]
	end)
	inst.Material = if okM and mat then mat else Enum.Material.SmoothPlastic
	inst.Transparency = data.transparency or 0
	inst.TopSurface = Enum.SurfaceType.Smooth
	inst.BottomSurface = Enum.SurfaceType.Smooth
	for _, c in inst:GetChildren() do
		if c:IsA("Texture") or c:IsA("Decal") then
			c:Destroy()
		end
	end
	local tex = data.texture and Catalog.TEXTURE_SET[data.texture]
	if not tex and type(data.texture) == "string" and string.match(data.texture, "^rbxassetid://%d+$") then
		-- своё изображение автора, плиткой на всех гранях
		tex = { image = data.texture, tile = data.textureTile or 4 }
	elseif tex and data.textureTile and tex.tile and tex.tile &gt; 0 then
		tex = { image = tex.image, tile = data.textureTile }
	end
	if tex then
		if tex.tile and tex.tile &gt; 0 then
			for _, face in FACES do
				local t = Instance.new("Texture")
				t.Texture = tex.image
				t.Face = (Enum.NormalId :: any)[face]
				t.StudsPerTileU = tex.tile
				t.StudsPerTileV = tex.tile
				t.Parent = inst
			end
		else
			local d = Instance.new("Decal")
			d.Texture = tex.image
			d.Face = Enum.NormalId.Front
			d.Parent = inst
		end
	end
end

local function configurePart(inst: BasePart, obj, mode: string)
	inst.Anchored = true
	inst.CanCollide = obj.physics.canCollide
	if mode == "edit" then
		inst.CanCollide = false
		inst.CanTouch = false
	end
	inst:SetAttribute("WsId", obj.id)
end

-- Мировая трансформа объекта (с учётом смещения сессии)
function WorldBuilder.objectCFrame(obj, origin: Vector3): CFrame
	return CFrame.new(origin) * Convert.cfFrom(obj.pos, obj.rot)
end

-- handle = { obj, root: Instance, part: BasePart?, parts: { [pid]: BasePart }, primary: BasePart }
function WorldBuilder.build(obj, parent: Instance, origin: Vector3, mode: string)
	local handle: any = { obj = obj, parts = {}, origin = origin, mode = mode }
	local isMarker = obj.role and MARKER_ROLES[obj.role.type]
	if obj.kind == "part" then
		local p = newBasePart(obj.shape)
		p.Name = obj.latin or obj.id
		WorldBuilder.applyLook(p, obj)
		configurePart(p, obj, mode)
		p.CFrame = WorldBuilder.objectCFrame(obj, origin)
		if mode == "play" and isMarker then
			p.Transparency = 1
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
		end
		if mode == "play" and not obj.physics.anchored and not obj.role then
			p.Anchored = false
		end
		p.Parent = parent
		handle.root = p
		handle.part = p
		handle.primary = p
	else
		local m = Instance.new("Model")
		m.Name = obj.latin or obj.id
		m:SetAttribute("WsId", obj.id)
		local base = WorldBuilder.objectCFrame(obj, origin)
		local first: BasePart? = nil
		local ids = {}
		for pid in obj.model.parts do
			table.insert(ids, pid)
		end
		table.sort(ids)
		for _, pid in ids do
			local data = obj.model.parts[pid]
			local p = newBasePart(data.shape)
			p.Name = pid
			WorldBuilder.applyLook(p, data)
			configurePart(p, obj, mode)
			p:SetAttribute("WsPart", pid)
			p.CFrame = base * Convert.cfFrom(data.pos, data.rot)
			p.Parent = m
			handle.parts[pid] = p
			if not first then
				first = p
			end
		end
		-- незакреплённая модель без клипов держится сваркой
		local hasClips = next(obj.model.clips) ~= nil
		if mode == "play" and not obj.physics.anchored and not hasClips and not obj.role and first then
			for _, p in handle.parts do
				if p ~= first then
					local w = Instance.new("WeldConstraint")
					w.Part0 = first
					w.Part1 = p
					w.Parent = first
				end
				p.Anchored = false
			end
		end
		if first then
			m.PrimaryPart = first
		end
		m.Parent = parent
		handle.root = m
		handle.primary = first
	end
	if mode == "play" and obj.hidden then
		WorldBuilder.setVisible(handle, false)
	end
	if obj.role and obj.role.type == "light" then
		WorldBuilder.applyLight(handle, obj.role)
	end
	return handle
end

function WorldBuilder.allParts(handle): { BasePart }
	if handle.part then
		return { handle.part }
	end
	local out = {}
	for _, p in handle.parts do
		table.insert(out, p)
	end
	return out
end

-- Видимость в игре: запоминаем исходную прозрачность и твёрдость
function WorldBuilder.setVisible(handle, visible: boolean)
	handle.visible = visible
	for _, p in WorldBuilder.allParts(handle) do
		if p:GetAttribute("BaseT") == nil then
			p:SetAttribute("BaseT", p.Transparency)
			p:SetAttribute("BaseC", p.CanCollide)
		end
		p.Transparency = if visible then p:GetAttribute("BaseT") :: number else 1
		p.CanCollide = if visible then p:GetAttribute("BaseC") :: boolean else false
		for _, d in p:GetChildren() do
			if d:IsA("Decal") or d:IsA("Texture") then
				d.Transparency = if visible then 0 else 1
			elseif d:IsA("SurfaceGui") or d:IsA("BillboardGui") then
				d.Enabled = visible
			end
		end
	end
end

function WorldBuilder.applyLight(handle, role)
	local p = handle.primary
	if not p then
		return
	end
	local light = p:FindFirstChildOfClass("PointLight")
	if not light then
		light = Instance.new("PointLight")
		light.Shadows = true
		light.Parent = p
	end
	light.Enabled = role.on
	light.Brightness = role.brightness
	light.Range = role.range
	light.Color = Convert.color(role.color)
	if p.Material == Enum.Material.Neon or p:GetAttribute("GlowMaterial") then
		if not p:GetAttribute("GlowMaterial") then
			p:SetAttribute("GlowMaterial", p.Material.Name)
		end
		p.Material = if role.on then (Enum.Material :: any)[p:GetAttribute("GlowMaterial")] else Enum.Material.SmoothPlastic
	end
end

-- Надпись автора: на поверхности или над объектом. text — уже проверенный текст
function WorldBuilder.applyLabel(handle, label, text: string)
	local p = handle.primary
	if not p then
		return nil
	end
	for _, c in p:GetChildren() do
		if c.Name == "WsLabel" then
			c:Destroy()
		end
	end
	if not label then
		return nil
	end
	local tl = Instance.new("TextLabel")
	tl.BackgroundTransparency = 1
	tl.Size = UDim2.fromScale(1, 1)
	tl.Text = text
	tl.TextWrapped = label.wrap
	tl.TextColor3 = Convert.color(label.color)
	tl.Font = Enum.Font.GothamMedium
	tl.RichText = false
	local gui: Instance
	if label.mode == "surface" then
		local sg = Instance.new("SurfaceGui")
		sg.Face = (Enum.NormalId :: any)[label.face or "Front"] or Enum.NormalId.Front
		sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		sg.PixelsPerStud = 50
		sg.LightInfluence = 0.3
		tl.TextSize = label.size * 2
		tl.Parent = sg
		gui = sg
	else
		local bb = Instance.new("BillboardGui")
		bb.Size = UDim2.fromOffset(240, 90)
		local extents = if handle.root:IsA("Model") then (handle.root :: Model):GetExtentsSize() else (handle.root :: BasePart).Size
		bb.StudsOffsetWorldSpace = Vector3.new(0, extents.Y / 2 + 1.5, 0)
		bb.MaxDistance = 80
		bb.LightInfluence = 0
		bb.AlwaysOnTop = false
		tl.TextSize = label.size
		tl.TextStrokeTransparency = 0.6
		tl.Parent = bb
		gui = bb
	end
	gui.Name = "WsLabel"
	if label.visible == false then
		(gui :: any).Enabled = false
	end
	gui.Parent = p
	return gui
end

-- Поза модели по сэмплу клипа. modelCF — текущий корень модели в мире
function WorldBuilder.poseModel(handle, sample, modelCF: CFrame)
	local obj = handle.obj
	if obj.kind ~= "model" then
		if handle.part then
			handle.part.CFrame = modelCF
		end
		return
	end
	local world = Rig.pose(obj.model, sample, Convert.tf(modelCF))
	local parts, cfs = {}, {}
	for pid, tf in world do
		local p = handle.parts[pid]
		if p then
			table.insert(parts, p)
			table.insert(cfs, Convert.cf(tf))
		end
	end
	workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
end

function WorldBuilder.restWorld(handle, modelCF: CFrame)
	WorldBuilder.poseModel(handle, nil, modelCF)
end

-- Точка над объектом для реплик
function WorldBuilder.headPoint(handle): BasePart?
	if handle.part then
		return handle.part
	end
	local best, bestY = nil, -math.huge
	for _, p in handle.parts do
		local y = p.Position.Y + p.Size.Y / 2
		if y &gt; bestY then
			best, bestY = p, y
		end
	end
	return best
end

WorldBuilder.MathX = MathX

return WorldBuilder
</ProtectedString>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="RBX00000027">
          <Properties>
            <string name="Name">UiText</string>
            <ProtectedString name="Source">--!nonstrict
-- Все встроенные строки интерфейса мастерской
--
-- Правило оформления:
--  * L — короткие подписи: кнопки, вкладки, заголовки, статусы. Без конечной точки
--    и без точки-разделителя внутри. Заголовок и уточнение разделяются переносом строки
--  * H — подсказки из полных предложений. Точка завершает предложение, но не отделяет
--    заголовок от уточнения
--  * Числа с дробной частью, версии и синтаксис кода сохраняют свои точки
-- Авторские названия и реплики сюда не входят: они хранятся как ввёл автор и проходят
-- фильтрацию Roblox

local UiText = {}

UiText.L = {
