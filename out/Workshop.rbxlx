		{ id = "SkirtRing3", shape = "Cylinder", size = {0.75,3.1,3.1}, pos = {0,2.95,0}, rot = {0,0,90}, color = {38,41,54}, material = "Plastic", transparency = 0, pivot = {0,0,0}, parent = "Skirt" },
