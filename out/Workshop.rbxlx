        <Item class="ModuleScript" referent="RBX00000008">
          <Properties>
            <string name="Name">Materials</string>
            <ProtectedString name="Source">--!nonstrict
-- Материалы с защитой: если какого-то материала нет в версии Roblox, берётся SmoothPlastic
return setmetatable({}, {
	__index = function(t, k)
		local ok, v = pcall(function()
			return (Enum.Material :: any)[k]
		end)
		local m = if ok and v then v else Enum.Material.SmoothPlastic
		rawset(t, k, m)
		return m
	end,
})
</ProtectedString>
          </Properties>
        </Item>
        <Item class="Folder" referent="RBX00000009">
          <Properties>
            <string name="Name">Roblox</string>
          </Properties>
          <Item class="ModuleScript" referent="RBX0000000A">
            <Properties>
              <string name="Name">Remotes</string>
              <ProtectedString name="Source">--!nonstrict
-- Сетевые каналы игры. Сервер создаёт их, клиент ждёт появления

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Remotes = {}

local FUNCTIONS = { "Request", "AdminRequest" }
local EVENTS = { "Game" }

local folder: Folder

local function root(): Folder
	if folder then
		return folder
	end
	local ws = ReplicatedStorage:WaitForChild("Workshop")
	if RunService:IsServer() then
		local f = ws:FindFirstChild("Remotes") :: Folder?
		if not f then
			local nf = Instance.new("Folder")
			nf.Name = "Remotes"
			for _, name in FUNCTIONS do
				local rf = Instance.new("RemoteFunction")
				rf.Name = name
				rf.Parent = nf
			end
			for _, name in EVENTS do
				local re = Instance.new("RemoteEvent")
				re.Name = name
				re.Parent = nf
			end
			nf.Parent = ws
			f = nf
		end
		folder = f :: Folder
	else
		folder = ws:WaitForChild("Remotes") :: Folder
	end
	return folder
end

function Remotes.fn(name: string): RemoteFunction
	return root():WaitForChild(name) :: RemoteFunction
end

function Remotes.event(name: string): RemoteEvent
	return root():WaitForChild(name) :: RemoteEvent
end

return Remotes
</ProtectedString>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="RBX0000000B">
          <Properties>
            <string name="Name">RoomPlan</string>
            <ProtectedString name="Source">--!nonstrict
-- План забега без Roblox API: какая комната за каждой дверью, куда она поворачивает,
-- заперта ли дверь, есть ли сборщик платы, Смотритель, темнота и Гул.
-- Путь никогда не разворачивается назад, поэтому комнаты не налезают друг на друга

local Rules = require(script.Parent.Rules)

local Plan = {}

-- размеры комнат: w — ширина, l — длина (от входа до дальней стены)
Plan.SIZES = {
	start = { w = 30, l = 30 },
	corridor = { w = 10, l = 32 },
	room = { w = 24, l = 26 },
	office = { w = 22, l = 22 },
	hall = { w = 34, l = 34 },
	elevator = { w = 22, l = 28 },
	boss = { w = 76, l = 88 },
}
Plan.HEIGHT = { start = 16, corridor = 12, room = 13, office = 12, hall = 18, elevator = 14, boss = 26 }

-- простой генератор случайных чисел (одинаковый в тестах и в игре)
function Plan.rng(seed: number)
	local s = math.floor(seed) % 2147483647
	if s &lt;= 0 then
		s += 2147483646
	end
	return function(): number
		s = (s * 48271) % 2147483647
		return s / 2147483647
	end
end

function Plan.new(seed: number)
	local rand = Plan.rng(seed)
	-- путь идёт «лесенкой»: вперёд и в одну сторону (за забег сторона одна),
	-- поэтому он никогда не возвращается к старым комнатам
	local side = if rand() &lt; 0.5 then -1 else 1
	return { seed = seed, heading = 0, side = side, lastHum = -99, rand = rand, ox = 0, oz = 0, rects = {} }
end

-- направление «вперёд» и «вправо» на полу для курса h (0 — -Z, -1 — -X, 1 — +X)
local function frame(h: number): (number, number, number, number)
	if h == 0 then
		return 0, -1, 1, 0
	elseif h &lt; 0 then
		return -1, 0, 0, -1
	end
	return 1, 0, 0, 1
end

-- прямоугольник комнаты на полу { x0, z0, x1, z1 }
local function footprint(state, w: number, l: number)
	local fx, fz, rx, rz = frame(state.heading)
	local xs, zs = {}, {}
	for _, c in { { -w / 2, 0 }, { w / 2, 0 }, { -w / 2, l }, { w / 2, l } } do
		table.insert(xs, state.ox + rx * c[1] + fx * c[2])
		table.insert(zs, state.oz + rz * c[1] + fz * c[2])
	end
	return { math.min(table.unpack(xs)), math.min(table.unpack(zs)), math.max(table.unpack(xs)), math.max(table.unpack(zs)) }
end
Plan.footprint = footprint

-- налезает ли комната на недавние (одновременно загруженные) комнаты
local function overlaps(state, r): boolean
	for _, o in state.rects do
		local ox = math.min(r[3], o[3]) - math.max(r[1], o[1])
		local oz = math.min(r[4], o[4]) - math.max(r[2], o[2])
		if ox &gt; 1.2 and oz &gt; 1.2 then
			return true
		end
	end
	return false
end
Plan.overlaps = overlaps

local function pickKind(r: number): string
	if r &lt; 0.34 then
		return "corridor"
	elseif r &lt; 0.64 then
		return "room"
	elseif r &lt; 0.8 then
		return "office"
	end
	return "hall"
end

-- Следующая комната: та, в которую ведёт дверь с номером door. Вызывать по порядку
function Plan.room(state, door: number)
	local rand = state.rand
	local sector = Rules.sectorOf(math.max(1, door))
	local d = { door = door, sector = sector, turn = 0 }
	if door == 0 then
		d.kind = "start"
	elseif Rules.isSectorEnd(door) then
		d.kind = if Rules.hasBoss(sector) then "boss" else "elevator"
	else
		d.kind = pickKind(rand())
	end
	local size = Plan.SIZES[d.kind]
	d.w, d.l, d.h = size.w, size.l, Plan.HEIGHT[d.kind]
	-- комната не помещается рядом со старыми: берётся поуже (коридор или кабинет)
	if d.kind == "corridor" or d.kind == "room" or d.kind == "office" or d.kind == "hall" then
		for _, kind in { d.kind, "corridor", "office" } do
			local sz = Plan.SIZES[kind]
			if not overlaps(state, footprint(state, sz.w, sz.l)) then
				d.kind = kind
				d.w, d.l, d.h = sz.w, sz.l, Plan.HEIGHT[kind]
				break
			end
		end
	end
	-- первая комната сектора и особые комнаты всегда прямые и спокойные
	local calm = d.kind == "start" or d.kind == "boss" or d.kind == "elevator" or (door - 1) % Rules.SECTOR_LEN == 0
	-- перед большим залом конца сектора выход прямой, иначе зал налезет на старые комнаты
	local beforeEnd = Rules.isSectorEnd(door + 1) or Rules.isSectorEnd(door + 2) or Rules.isSectorEnd(door + 3)
	if not calm then
		-- поворот: назад развернуться нельзя
		local r = rand()
		-- кабинет короткий, поэтому выход у него всегда прямо
		local wantTurn = if d.kind == "corridor" then r &lt; 0.6 elseif d.kind == "office" then false else r &lt; 0.3
		local _ = rand()
		if wantTurn and not beforeEnd then
			d.turn = if state.heading == 0 then state.side else -state.heading
		end
		-- поворот только туда, где хватит места следующей большой комнате
		local options = { d.turn, 0 }
		local mine = footprint(state, d.w, d.l)
		for _, turn in options do
			if state.heading + turn &gt;= -1 and state.heading + turn &lt;= 1 then
				d.turn = turn
				local ex, ez = Plan.exitOf(d)
				local fx, fz, rx, rz = frame(state.heading)
				local probe = {
					ox = state.ox + rx * ex + fx * -ez,
					oz = state.oz + rz * ex + fz * -ez,
					heading = state.heading + turn,
					rects = table.clone(state.rects),
				}
				table.insert(probe.rects, mine)
				local big = Plan.SIZES.hall
				if not overlaps(probe, footprint(probe, big.w, big.l)) then
					break
				end
			end
			d.turn = 0
		end
		-- запертая дверь или сборщик платы на выходе (не вместе)
		local nextDoor = door + 1
		if not Rules.isSectorEnd(nextDoor) then
			if rand() &lt; Rules.lockedChance(door) then
				d.locked = true
			elseif rand() &lt; Rules.tollChance(door) then
				d.toll = true
			end
		end
		d.dark = rand() &lt; Rules.darkChance(door)
		d.watcher = d.kind ~= "corridor" and rand() &lt; Rules.watcherChance(door)
		if door - state.lastHum &gt;= Rules.HUM_GAP and rand() &lt; Rules.humChance(door) then
			d.hum = true
			state.lastHum = door
		end
	end
	-- шкафы для пряток: в каждой комнате хотя бы один
	d.closets = if d.kind == "hall" then 4 elseif d.kind == "corridor" then 1 elseif d.kind == "boss" then 6 else 2
	-- запомнить место комнаты и перейти к её выходу
	table.insert(state.rects, footprint(state, d.w, d.l))
	if #state.rects &gt; 7 then
		table.remove(state.rects, 1)
	end
	local ex, ez = Plan.exitOf(d)
	if d.kind == "boss" then
		-- сразу за залом Слепого стоит лифт
		local el = Plan.SIZES.elevator
		local fx0, fz0 = frame(state.heading)
		local save = { state.ox, state.oz }
		state.ox += fx0 * d.l
		state.oz += fz0 * d.l
		table.insert(state.rects, footprint(state, el.w, el.l))
		state.ox, state.oz = save[1], save[2]
		ez -= el.l
	end
	local fx, fz, rx, rz = frame(state.heading)
	state.ox += rx * ex + fx * -ez
	state.oz += rz * ex + fz * -ez
	state.heading += d.turn
	d.heading = state.heading
	return d
end

-- Где выход относительно входа комнаты (вход в 0,0, комната уходит в -Z).
-- Возвращает смещение x, z и поворот (в долях пол-оборота: 0, 1 = влево, -1 = вправо)
function Plan.exitOf(d): (number, number, number)
	if d.turn == 0 then
		return 0, -d.l, 0
	end
	local z = -(d.l - 5.5)
	if d.turn &lt; 0 then
		return -d.w / 2, z, 1
	end
	return d.w / 2, z, -1
end

return Plan
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX0000000C">
          <Properties>
            <string name="Name">Rules</string>
            <ProtectedString name="Source">--!nonstrict
-- Правила «The Labyrinth» без Roblox API: сектора, двери, предметы, цены,
-- фонарик, шум, сборщик платы, шансы существ. Проверяются тестами

local Rules = {}

-- двери и сектора ------------------------------------------------------------

Rules.SECTOR_LEN = 25 -- дверей в секторе; за последней — лифт (с сектора 2 — зал Слепого)

function Rules.sectorOf(door: number): number
	return math.floor((math.max(1, door) - 1) / Rules.SECTOR_LEN) + 1
end

-- дверь, за которой конец сектора
function Rules.isSectorEnd(door: number): boolean
	return door &gt; 0 and door % Rules.SECTOR_LEN == 0
end

-- в конце сектора 2 и дальше — зал Слепого перед лифтом
function Rules.hasBoss(sector: number): boolean
	return sector &gt;= 2
end

-- лифт едет только вертикально и только на один сектор вперёд
function Rules.canRide(fromSector: number, toSector: number): boolean
	return toSector == fromSector + 1
end

-- здоровье и сборщик платы -------------------------------------------------

Rules.MAX_HEALTH = 100
Rules.TOLL_SHARE = 0.7 -- плата кровью: 70 % текущего здоровья

function Rules.tollPrice(door: number): number
	return 5 + math.floor(door / 10)
end

-- сколько здоровья останется после платы кровью (никогда не убивает)
function Rules.afterBloodToll(health: number): number
	return math.max(1, health - health * Rules.TOLL_SHARE)
end

-- фонарик --------------------------------------------------------------------

Rules.FLASH_MAX = 100
Rules.FLASH_DRAIN = 1 -- в секунду, пока включён
Rules.BATTERY = 50

function Rules.drain(charge: number, dt: number, on: boolean): number
	if not on then
		return charge
	end
	return math.max(0, charge - Rules.FLASH_DRAIN * dt)
end

function Rules.recharge(charge: number): number
	return math.min(Rules.FLASH_MAX, charge + Rules.BATTERY)
end

-- предметы -------------------------------------------------------------------

Rules.ITEMS = { "battery", "plant", "lockpick", "whistle", "key", "fuse" }
-- сколько штук можно нести
Rules.CAP = { battery = 3, plant = 3, lockpick = 3, whistle = 1, key = 9, fuse = 2 }
Rules.PLANT_HEAL = 35
Rules.SPEED = { walk = 15, sneak = 7 }

function Rules.canAdd(inv: { [string]: number }, item: string): boolean
	local cap = Rules.CAP[item]
	return cap ~= nil and (inv[item] or 0) &lt; cap
end

function Rules.add(inv: { [string]: number }, item: string): boolean
	if not Rules.canAdd(inv, item) then
		return false
	end
	inv[item] = (inv[item] or 0) + 1
	return true
end

function Rules.take(inv: { [string]: number }, item: string): boolean
	if (inv[item] or 0) &lt;= 0 then
		return false
	end
	inv[item] -= 1
	if inv[item] == 0 then
		inv[item] = nil
	end
	return true
end

-- лавка в лифте
Rules.PRICES = { battery = 8, plant = 12, lockpick = 15, whistle = 20 }
Rules.SHOP = { "battery", "plant", "lockpick", "whistle" }

function Rules.buy(inv, coins: number, item: string): (boolean, number, string?)
	local price = Rules.PRICES[item]
	if not price then
		return false, coins, "unknown"
	end
	if coins &lt; price then
		return false, coins, "coins"
	end
	if not Rules.canAdd(inv, item) then
		return false, coins, "full"
	end
	Rules.add(inv, item)
	return true, coins - price, nil
end

-- находки в ящиках: r в [0, 1)
function Rules.loot(r: number, door: number): (string, number)
	if r &lt; 0.45 then
		return "coins", 1 + math.floor(r * 10) + math.floor(door / 25)
	elseif r &lt; 0.62 then
		return "battery", 1
	elseif r &lt; 0.74 then
		return "plant", 1
	elseif r &lt; 0.82 then
		return "lockpick", 1
	end
	return "nothing", 0
end

-- шум и Слепой ---------------------------------------------------------------

-- радиус, в котором Слепой слышит игрока
function Rules.noise(speed: number, sneaking: boolean): number
	if sneaking or speed &lt; 1 then
		return 0
	end
	if speed &lt;= Rules.SPEED.sneak + 1 then
		return 0
	end
	return 30
end

Rules.NOISE = { repair = 45, gate = 120, whistle = 200, door = 60 }
Rules.BLIND_SPEED = { wander = 9, hunt = 17 }
Rules.BLIND_CONFUSED = 6 -- секунд стоит на месте после свистка
Rules.GENERATORS = 3
Rules.FUSES = 5 -- деталей разбросано по залу (нужно 3)
Rules.REPAIR_STEP = 34 -- один ремонт (удержание) даёт 34 %

function Rules.repair(progress: number): number
	return math.min(100, progress + Rules.REPAIR_STEP)
end

-- Смотритель -----------------------------------------------------------------

Rules.WATCHER_SPEED = 28
Rules.WATCHER_DAMAGE = 45
Rules.WATCHER_SEEN_TIME = 0.35 -- сколько секунд действует отметка «на него смотрят»
Rules.WHISTLE_FREEZE = 6

function Rules.watcherMoves(lastSeen: number?, now: number, frozenUntil: number?): boolean
	if frozenUntil and now &lt; frozenUntil then
		return false
	end
	return not lastSeen or now - lastSeen &gt; Rules.WATCHER_SEEN_TIME
end

-- шансы событий у двери (r в [0, 1)) -----------------------------------------

function Rules.humChance(door: number): number
	if door &lt; 8 then
		return 0
	end
	return math.min(0.22, 0.08 + door / 600)
end

function Rules.watcherChance(door: number): number
	if door &lt; 12 then
		return 0
	end
	return math.min(0.25, 0.08 + door / 500)
end

function Rules.tollChance(door: number): number
	if door &lt; 6 then
		return 0
	end
	return 0.09
end

function Rules.lockedChance(door: number): number
	if door &lt; 3 then
		return 0
	end
	return math.min(0.35, 0.15 + door / 400)
end

function Rules.darkChance(door: number): number
	if door &lt; 5 then
		return 0
	end
	return math.min(0.45, 0.1 + door / 300)
end

-- Гул не приходит два раза подряд слишком быстро
Rules.HUM_GAP = 5

return Rules
</ProtectedString>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="RBX0000000D">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="RBX0000000E">
      <Properties>
        <string name="Name">Workshop</string>
      </Properties>
      <Item class="ModuleScript" referent="RBX0000000F">
        <Properties>
          <string name="Name">Access</string>
          <ProtectedString name="Source">--!nonstrict
-- Кто считается создателем: владелец игры, пользователи из Config и (в Studio) все
-- Права проверяются только на сервере; клиент лишь прячет кнопки

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Config = require(script.Parent.Config)

local Access = {}

local resolvedIds: { [number]: boolean } = {}
local cache: { [number]: boolean } = {}

-- Имена из Config переводятся в постоянные ID аккаунтов, чтобы смена ника не давала
-- доступ чужому человеку с таким же именем
task.spawn(function()
	for _, name in Config.CREATOR_USERNAMES do
		for _ = 1, 3 do
			local ok, id = pcall(function()
				return Players:GetUserIdFromNameAsync(name)
			end)
			if ok and type(id) == "number" then
				resolvedIds[id] = true
				table.clear(cache)
				break
			end
			task.wait(2)
		end
	end
end)

local function ownerOf(player: Player): boolean
	if game.CreatorType == Enum.CreatorType.User then
		return game.CreatorId == player.UserId
	end
	local ok, rank = pcall(function()
		return player:GetRankInGroup(game.CreatorId)
	end)
	return ok and rank &gt;= 254
end

function Access.isCreator(player: Player): boolean
	local c = cache[player.UserId]
	if c ~= nil then
		return c
	end
	local result = RunService:IsStudio()
		or ownerOf(player)
		or resolvedIds[player.UserId] == true
		or table.find(Config.CREATOR_USER_IDS, player.UserId) ~= nil
	-- кэшируем только положительный ответ: ID имени может прийти чуть позже
	if result then
		cache[player.UserId] = true
	end
	return result
end

-- Создатель по ID (для карт: валюту выдают только карты создателей)
function Access.isCreatorUserId(userId: number): boolean
	if RunService:IsStudio() then
		return true
	end
	if game.CreatorType == Enum.CreatorType.User and game.CreatorId == userId then
		return true
	end
	if resolvedIds[userId] or table.find(Config.CREATOR_USER_IDS, userId) then
		return true
	end
	local p = Players:GetPlayerByUserId(userId)
	return p ~= nil and Access.isCreator(p)
end

function Access.forget(player: Player)
	cache[player.UserId] = nil
end

return Access
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000010">
        <Properties>
          <string name="Name">Config</string>
          <ProtectedString name="Source">--!nonstrict
-- Настройки сервера «The Labyrinth»

local Config = {}

-- Создатели (админ-панель): владелец игры всегда, плюс эти имена (проверяются по ID)
Config.CREATOR_USERNAMES = { "Saren45hil", "Nataliaavira13" } :: { string }
Config.CREATOR_USER_IDS = {} :: { number }

-- Хранилище рекордов (только лучший номер двери, прогресс забега не сохраняется)
Config.DATASTORE_NAME = "Labyrinth_Records_v1"

return Config
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000011">
        <Properties>
          <string name="Name">DataStoreAdapter</string>
          <ProtectedString name="Source">--!nonstrict
-- Адаптер DataStore для рекордов
-- В Studio без доступа к API используется память сервера с предупреждением в выводе

local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")

local Config = require(script.Parent.Config)

local Adapter = {}

local function waitBudget(kind: Enum.DataStoreRequestType)
	local deadline = os.clock() + 15
	while DataStoreService:GetRequestBudgetForRequestType(kind) &lt; 1 and os.clock() &lt; deadline do
		task.wait(0.5)
	end
end

local function deepCopy(v: any): any
	if type(v) ~= "table" then
		return v
	end
	local o = {}
	for k, x in v do
		o[k] = deepCopy(x)
	end
	return o
end

function Adapter.memory()
	local data = {}
	return {
		kind = "memory",
		get = function(key: string)
			return deepCopy(data[key])
		end,
		update = function(key: string, fn)
			local nv = fn(deepCopy(data[key]))
			if nv ~= nil then
				data[key] = deepCopy(nv)
			end
			return deepCopy(nv)
		end,
	}
end

function Adapter.create()
	local ok, store = pcall(function()
		return DataStoreService:GetDataStore(Config.DATASTORE_NAME)
	end)
	if ok and RunService:IsStudio() then
		-- проверяем доступ к API в Studio
		local probe = pcall(function()
			return store:GetAsync("probe")
		end)
		if not probe then
			ok = false
		end
	end
	if not ok then
		warn("[Labyrinth] DataStore недоступен, поэтому данные хранятся только в памяти этого сервера (включите Studio Access to API Services)")
		return Adapter.memory()
	end
	local ds = store :: DataStore
	return {
		kind = "datastore",
		get = function(key: string)
			waitBudget(Enum.DataStoreRequestType.GetAsync)
			return ds:GetAsync(key)
		end,
		update = function(key: string, fn)
			waitBudget(Enum.DataStoreRequestType.UpdateAsync)
			return ds:UpdateAsync(key, function(old)
				return fn(old)
			end)
		end,
	}
end

return Adapter
</ProtectedString>
        </Properties>
      </Item>
      <Item class="Folder" referent="RBX00000012">
        <Properties>
          <string name="Name">Game</string>
        </Properties>
        <Item class="ModuleScript" referent="RBX00000013">
          <Properties>
            <string name="Name">Admin</string>
            <ProtectedString name="Source">--!nonstrict
-- Админ-панель: быстрые проверки игры одному (монеты, предметы, пропуск дверей,
-- вызов существ). Доступ только создателям, проверка на сервере

local Shared = game:GetService("ReplicatedStorage").Workshop.Shared
local Commands = require(Shared.AdminCommands)
local Rules = require(Shared.Rules)
local Remotes = require(Shared.Roblox.Remotes)

local Access = require(script.Parent.Parent.Access)
local Builder = require(script.Parent.Parent.World.RoomBuilder)
local Entities = require(script.Parent.Entities)
local G = require(script.Parent.Game)

local Admin = {}

-- открыть несколько дверей подряд и перенести живых игроков к последней
local function skip(count: number)
	local run = G.run
	for _ = 1, count do
		local n = run.front + 1
		local info = run.rooms[n - 1]
		if not info or (info.elevatorInfo and not info.elevatorInfo.rideDone) then
			break
		end
		if info.toll then
			info.toll.paid = true
			info.toll.model:Destroy()
		end
		G.openDoor(n, true)
	end
	local info = run.rooms[run.front]
	if info then
		for _, p in G.alivePlayers() do
			G.unhide(p)
			G.teleport(p, info.origin * CFrame.new(0, 3, -4))
		end
	end
end

local RUN = {
	coins = function(p)
		G.give(p, "coins", 50)
	end,
	items = function(p)
		for _, it in { "battery", "plant", "lockpick", "whistle" } do
			G.give(p, it)
		end
	end,
	fuses = function(p)
		G.give(p, "fuse")
		G.give(p, "fuse")
	end,
	heal = function(p)
		local hum = G.humOf(p)
		if hum then
			hum.Health = hum.MaxHealth
		end
	end,
	god = function(p)
		local s = G.players[p]
		if s then
			s.god = not s.god
			G.toast(p, if s.god then "GodOn" else "GodOff")
		end
	end,
	skip = function()
		skip(5)
	end,
	sector_end = function()
		local run = G.run
		local target = math.ceil((run.front + 1) / Rules.SECTOR_LEN) * Rules.SECTOR_LEN
		skip(math.max(0, target - run.front))
	end,
	hum = function()
		task.spawn(Entities.hum)
	end,
	watcher = function(p)
		local r = G.rootOf(p)
		for _, info in G.run.rooms do
			if r and Builder.contains(info, r.Position) then
				Entities.spawnWatcher(info)
				return
			end
		end
	end,
	fix_gens = function()
		for _, info in G.run.rooms do
			if info.generators then
				for _, g in info.generators do
					g.fused = true
					g.progress = 99
				end
			end
		end
	end,
	restart = function()
		task.spawn(G.endRun)
	end,
}

function Admin.init()
	Remotes.fn("AdminRequest").OnServerInvoke = function(p: Player, action: any, id: any)
		if action == "Status" then
			return { ok = true, admin = Access.isCreator(p) }
		end
		if action ~= "Run" or not Access.isCreator(p) then
			return { ok = false }
		end
		if type(id) ~= "string" or not Commands.BY_ID[id] or not RUN[id] then
			return { ok = false }
		end
		local ok, err = pcall(RUN[id], p)
		if not ok then
			warn("[Labyrinth] admin " .. id .. ": " .. tostring(err))
		end
		return { ok = ok }
	end
end

return Admin
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000014">
          <Properties>
            <string name="Name">Entities</string>
            <ProtectedString name="Source">--!nonstrict
-- Существа лабиринта:
--   Гул — мигает свет, нарастает гул, потом он проносится по всем комнатам; спасает шкаф
--   Смотритель — пока на него никто не смотрит, быстро идёт к ближайшему игроку
--   Слепой — в зале генераторов; не видит, но слышит шаги, ремонт, ворота и свисток

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local PathfindingService = game:GetService("PathfindingService")
local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Shared = game:GetService("ReplicatedStorage").Workshop.Shared
local M = require(Shared.Materials)
local Rules = require(Shared.Rules)

local E = {}
local G -- игра (задаётся в init)

local SOUND = {
	rumble = "rbxasset://sounds/swoosh.wav",
	scream = "rbxasset://sounds/uuhhh.mp3",
	hit = "rbxasset://sounds/swordslash.wav",
	ping = "rbxasset://sounds/electronicpingshort.wav",
}
E.SOUND = SOUND

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local function sound(parent: Instance, id: string, vol: number, speed: number?, looped: boolean?)
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = vol
	s.PlaybackSpeed = speed or 1
	s.Looped = looped == true
	s.RollOffMaxDistance = 160
	s.Parent = parent
	s:Play()
	if not looped then
		Debris:AddItem(s, 8)
	end
	return s
end
E.sound = sound

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

-- ---------------------------------------------------------------------------
-- Гул

E.humActive = false

local function flicker(lights, seconds: number)
	local t0 = os.clock()
	task.spawn(function()
		while os.clock() - t0 &lt; seconds do
			for _, bulb in lights do
				local l = bulb.Parent and bulb:FindFirstChildOfClass("PointLight")
				if l and not bulb:GetAttribute("Broken") and not bulb:GetAttribute("Dark") then
					l.Enabled = math.random() &lt; 0.45
				end
			end
			task.wait(0.08 + math.random() * 0.12)
		end
		for _, bulb in lights do
			local l = bulb.Parent and bulb:FindFirstChildOfClass("PointLight")
			if l and not bulb:GetAttribute("Broken") and not bulb:GetAttribute("Dark") then
				l.Enabled = true
			end
		end
	end)
end

function E.hum()
	if E.humActive then
		return
	end
	local rooms = G.loadedRooms()
	if #rooms == 0 then
		return
	end
	E.humActive = true
	local lights = {}
	for _, info in rooms do
		for _, b in info.lights do
			table.insert(lights, b)
		end
	end
	G.sendAll({ type = "hum", phase = "warn" })
	flicker(lights, 3.6)
	-- путь: от самой старой загруженной комнаты до последней открытой
	local pts = {}
	for _, info in rooms do
		for _, p in info.path do
			table.insert(pts, p)
		end
	end
	local body = Instance.new("Part")
	body.Name = "Hum"
	body.Shape = Enum.PartType.Ball
	body.Size = Vector3.new(7, 7, 7)
	body.Anchored = true
	body.CanCollide = false
	body.CanQuery = false
	body.Material = M.Neon
	body.Color = rgb(20, 16, 24)
	body.Transparency = 0.15
	body.CFrame = CFrame.new(pts[1] - (pts[2] - pts[1]).Unit * 40)
	local aura = Instance.new("ParticleEmitter")
	aura.Color = ColorSequence.new(rgb(40, 10, 30))
	aura.Size = NumberSequence.new(5, 0)
	aura.Lifetime = NumberRange.new(0.6, 1)
	aura.Rate = 80
	aura.Speed = NumberRange.new(2, 6)
	aura.Parent = body
	local glow = Instance.new("PointLight")
	glow.Color = rgb(255, 40, 60)
	glow.Range = 30
	glow.Brightness = 2
	glow.Parent = body
	body.Parent = workspace
	local rumble = sound(body, SOUND.rumble, 3, 0.25, true)
	task.wait(3.6)
	G.sendAll({ type = "hum", phase = "rush" })
	local speed = 80
	local pos = body.Position
	for i = 1, #pts do
		local target = pts[i]
		while (target - pos).Magnitude &gt; 1 do
			local dt = RunService.Heartbeat:Wait()
			local step = math.min(speed * dt, (target - pos).Magnitude)
			pos += (target - pos).Unit * step
			body.CFrame = CFrame.new(pos)
			for _, p in G.alivePlayers() do
				local r = G.rootOf(p)
				if r and not G.isHidden(p) then
					local off = r.Position - pos
					if flat(off).Magnitude &lt; 9 and math.abs(off.Y) &lt; 9 then
						G.kill(p, "hum")
					end
				end
			end
		end
	end
	-- часть ламп после него перегорает
	for _, b in lights do
		if b.Parent and math.random() &lt; 0.3 then
			b:SetAttribute("Broken", true)
			local l = b:FindFirstChildOfClass("PointLight")
			if l then
				l.Enabled = false
			end
			b.Material = M.Glass
		end
	end
	rumble:Stop()
	body:Destroy()
	G.sendAll({ type = "hum", phase = "gone" })
	E.humActive = false
end

-- ---------------------------------------------------------------------------
-- Смотритель

local watchers = {} -- id -&gt; { model, root, info, spawn, lastSeen, frozenUntil }
local nextId = 0

local function watcherModel(cf: CFrame)
	local m = Instance.new("Model")
	m.Name = "Watcher"
	local skin = rgb(14, 12, 16)
	local function part(name, size, ocf, color, mat)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = cf * ocf
		p.Color = color
		p.Material = mat or M.SmoothPlastic
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = true
		p.Parent = m
		return p
	end
	local root = part("Body", Vector3.new(2, 9, 1.4), CFrame.new(0, 4.5, 0), skin)
	part("Head", Vector3.new(1.8, 2.2, 1.8), CFrame.new(0, 10.1, 0), skin)
	part("Mask", Vector3.new(1.4, 1.7, 0.1), CFrame.new(0, 10.1, -0.92), rgb(222, 216, 204))
	for _, x in { -0.35, 0.35 } do
		part("EyeHole", Vector3.new(0.3, 0.45, 0.05), CFrame.new(x, 10.4, -0.98), rgb(0, 0, 0))
	end
	part("Mouth", Vector3.new(0.7, 0.12, 0.05), CFrame.new(0, 9.6, -0.98), rgb(0, 0, 0))
	for _, x in { -1.4, 1.4 } do
		part("Arm", Vector3.new(0.5, 8, 0.5), CFrame.new(x, 4.6, 0) * CFrame.Angles(0, 0, x * 0.03), skin)
	end
	m.PrimaryPart = root
	return m, root
end

function E.spawnWatcher(info)
	nextId += 1
	local id = nextId
	local cf = info.watcherSpawn
	local look = info.center.Position
	local base = CFrame.lookAt(cf.Position, Vector3.new(look.X, cf.Y, look.Z))
	local m, root = watcherModel(base)
	m:SetAttribute("WatcherId", id)
	m.Parent = info.model
	CollectionService:AddTag(m, "Watcher")
	watchers[id] = { model = m, root = root, info = info, spawn = base, lastSeen = nil, frozenUntil = nil, pos = base.Position, cooldown = 0 }
	return id
end

-- клиент сообщает, что видит Смотрителя
function E.seen(p: Player, id: number)
	local w = watchers[id]
	if not w or not G.isAlive(p) then
		return
	end
	local r = G.rootOf(p)
	if r and (r.Position - w.pos).Magnitude &lt; 90 then
		w.lastSeen = os.clock()
	end
end

function E.removeRoom(info)
	for id, w in watchers do
		if w.info == info then
			w.model:Destroy()
			watchers[id] = nil
		end
	end
end

local function stepWatchers(dt: number)
	local now = os.clock()
	for id, w in watchers do
		if not w.model.Parent then
			watchers[id] = nil
			continue
		end
		-- цель: ближайший видимый (не спрятанный) игрок в этой комнате
		local best, bestD = nil, math.huge
		for _, p in G.alivePlayers() do
			local r = G.rootOf(p)
			if r and not G.isHidden(p) and G.inRoom(w.info, r.Position) then
				local dd = (flat(r.Position - w.pos)).Magnitude
				if dd &lt; bestD then
					best, bestD = p, dd
				end
			end
		end
		if best and now &gt; w.cooldown and Rules.watcherMoves(w.lastSeen, now, w.frozenUntil) then
			local r = G.rootOf(best) :: BasePart
			local to = flat(r.Position - w.pos)
			if to.Magnitude &gt; 0.1 then
				local step = math.min(Rules.WATCHER_SPEED * dt, to.Magnitude)
				w.pos += to.Unit * step
			end
			if bestD &lt; 3.6 then
				G.damage(best, Rules.WATCHER_DAMAGE, "watcher")
				sound(w.root, SOUND.scream, 1.2, 1.3)
				G.send(best, { type = "fx", kind = "scare" })
				-- возвращается в свой угол и ждёт
				w.pos = w.spawn.Position
				w.cooldown = now + 3
			end
			local face = Vector3.new(r.Position.X, w.pos.Y, r.Position.Z)
			local cf = if (face - w.pos).Magnitude &gt; 0.1 then CFrame.lookAt(w.pos, face) else CFrame.new(w.pos)
			w.model:PivotTo(cf)
		end
	end
end

-- свисток: все Смотрители рядом замирают
local function freezeWatchers(pos: Vector3)
	for _, w in watchers do
		if (w.pos - pos).Magnitude &lt; 70 then
			w.frozenUntil = os.clock() + Rules.WHISTLE_FREEZE
		end
	end
end

-- ---------------------------------------------------------------------------
-- Слепой

local blind = nil -- { model, hum, root, info, state, target, confusedUntil, path, wp, pathAt }

local function blindModel(cf: CFrame)
	local desc = Instance.new("HumanoidDescription")
	local c = rgb(46, 44, 50)
	desc.HeadColor, desc.TorsoColor = c, c
	desc.LeftArmColor, desc.RightArmColor, desc.LeftLegColor, desc.RightLegColor = c, c, c, c
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		return nil
	end
	model.Name = "Blind"
	for _, d in model:GetDescendants() do
		if d:IsA("Script") or d:IsA("LocalScript") then
			d:Destroy()
		elseif d:IsA("Decal") and d.Name == "face" then
			d:Destroy()
		end
	end
	local hum = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	hum.MaxHealth = math.huge
	hum.Health = math.huge
	pcall(function()
		model:ScaleTo(1.5)
	end)
	-- повязка на глазах и длинные пальцы
	local head = model:FindFirstChild("Head")
	if head then
		local band = Instance.new("Part")
		band.Name = "Blindfold"
		band.Size = Vector3.new(head.Size.X * 1.05, head.Size.Y * 0.28, head.Size.Z * 1.05)
		band.Color = rgb(150, 140, 120)
		band.Material = M.Fabric
		band.CanCollide = false
		band.Massless = true
		band.CFrame = head.CFrame * CFrame.new(0, head.Size.Y * 0.1, 0)
		local wd = Instance.new("WeldConstraint")
		wd.Part0 = head
		wd.Part1 = band
		wd.Parent = band
		band.Parent = model
		local mouth = Instance.new("Part")
		mouth.Name = "Mouth"
		mouth.Size = Vector3.new(head.Size.X * 0.6, head.Size.Y * 0.18, 0.1)
		mouth.Color = rgb(80, 10, 10)
		mouth.CanCollide = false
		mouth.Massless = true
		mouth.CFrame = head.CFrame * CFrame.new(0, -head.Size.Y * 0.25, -head.Size.Z / 2 - 0.02)
		local w2 = Instance.new("WeldConstraint")
		w2.Part0 = head
		w2.Part1 = mouth
		w2.Parent = mouth
		mouth.Parent = model
	end
	model:PivotTo(cf)
	return model, hum
end

function E.startBlind(info)
	E.stopBlind()
	local model, hum = blindModel(info.blindSpawn)
	if not model then
		return
	end
	model.Parent = info.model
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	hum.WalkSpeed = Rules.BLIND_SPEED.wander
	CollectionService:AddTag(model, "Blind")
	blind = { model = model, hum = hum, root = root, info = info, state = "wander", target = nil, confusedUntil = 0, wanderAt = 0, path = nil, pathAt = 0, wp = 1, growlAt = 0 }
end

function E.stopBlind()
	if blind then
		if blind.model then
			blind.model:Destroy()
		end
		blind = nil
	end
end

-- шум в точке: Слепой идёт туда, если услышал
function E.noise(pos: Vector3, radius: number, kind: string?)
	if not blind or not blind.root.Parent then
		return
	end
	if (blind.root.Position - pos).Magnitude &gt; radius then
		return
	end
	if kind == "whistle" then
		blind.state = "lure"
		blind.target = pos
		blind.confusedUntil = 0
		return
	end
	if blind.state == "confused" and os.clock() &lt; blind.confusedUntil then
		return
	end
	blind.state = "hunt"
	blind.target = pos
end

local function blindGo(goal: Vector3)
	local b = blind
	local now = os.clock()
	if not b.path or now - b.pathAt &gt; 1.2 or (b.goal and (b.goal - goal).Magnitude &gt; 6) then
		b.pathAt = now
		b.goal = goal
		local path = PathfindingService:CreatePath({ AgentRadius = 2.5, AgentHeight = 8, AgentCanJump = false })
		local ok = pcall(function()
			path:ComputeAsync(b.root.Position, goal)
		end)
		if ok and path.Status == Enum.PathStatus.Success then
			b.path = path:GetWaypoints()
			b.wp = 2
		else
			b.path = nil
			b.hum:MoveTo(goal)
			return
		end
	end
	local w = b.path and b.path[b.wp]
	if w then
		if (flat(w.Position - b.root.Position)).Magnitude &lt; 3 then
			b.wp += 1
			w = b.path[b.wp] or w
		end
		b.hum:MoveTo(w.Position)
	end
end

local function stepBlind()
	local b = blind
	if not b or not b.root.Parent then
		return
	end
	local now = os.clock()
	-- слушает шаги игроков в зале
	for _, p in G.alivePlayers() do
		local r = G.rootOf(p)
		if r and not G.isHidden(p) and G.inRoom(b.info, r.Position) then
			local v = r.AssemblyLinearVelocity
			local radius = Rules.noise(Vector3.new(v.X, 0, v.Z).Magnitude, G.isSneaking(p))
			if radius &gt; 0 and (r.Position - b.root.Position).Magnitude &lt; radius then
				E.noise(r.Position, radius, "step")
			end
			-- поймал
			if (flat(r.Position - b.root.Position)).Magnitude &lt; 5 and math.abs(r.Position.Y - b.root.Position.Y) &lt; 8 then
				G.kill(p, "blind")
				sound(b.root, SOUND.scream, 1.5, 0.6)
				b.state = "wander"
				b.target = nil
			end
		end
	end
	if b.state == "hunt" and b.target then
		b.hum.WalkSpeed = Rules.BLIND_SPEED.hunt
		blindGo(b.target)
		if (flat(b.target - b.root.Position)).Magnitude &lt; 4 then
			-- пришёл на звук и никого: прислушивается
			b.state = "confused"
			b.confusedUntil = now + 2.5
		end
		if now &gt; b.growlAt then
			b.growlAt = now + 3
			sound(b.root, SOUND.scream, 0.7, 0.35)
		end
	elseif b.state == "lure" and b.target then
		b.hum.WalkSpeed = Rules.BLIND_SPEED.hunt
		blindGo(b.target)
		if (flat(b.target - b.root.Position)).Magnitude &lt; 4 then
			b.state = "confused"
			b.confusedUntil = now + Rules.BLIND_CONFUSED
		end
	elseif b.state == "confused" then
		b.hum:MoveTo(b.root.Position)
		if now &gt; b.confusedUntil then
			b.state = "wander"
		end
	else
		b.hum.WalkSpeed = Rules.BLIND_SPEED.wander
		if not b.target or now &gt; b.wanderAt or (flat(b.target - b.root.Position)).Magnitude &lt; 4 then
			b.wanderAt = now + 8
			local list = b.info.wander
			b.target = list[math.random(1, #list)]
		end
		blindGo(b.target)
	end
end

-- ---------------------------------------------------------------------------
-- свисток

function E.whistle(p: Player)
	local r = G.rootOf(p)
	if not r then
		return
	end
	sound(r, SOUND.ping, 2, 2.2)
	freezeWatchers(r.Position)
	-- Слепой бежит на свисток и стоит там, прислушиваясь: самому надо отойти тихо
	E.noise(r.Position, Rules.NOISE.whistle, "whistle")
end

function E.clear()
	for id, w in watchers do
		w.model:Destroy()
		watchers[id] = nil
	end
	E.stopBlind()
	for _, h in workspace:GetChildren() do
		if h.Name == "Hum" then
			h:Destroy()
		end
	end
end

function E.init(game_)
	G = game_
	RunService.Heartbeat:Connect(function(dt)
		local ok, err = pcall(stepWatchers, dt)
		if not ok then
			warn("[Labyrinth] watcher: " .. tostring(err))
		end
	end)
	task.spawn(function()
		while true do
			task.wait(0.2)
			local ok, err = pcall(stepBlind)
			if not ok then
				warn("[Labyrinth] blind: " .. tostring(err))
			end
		end
	end)
	local _ = TweenService
end

return E
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000015">
          <Properties>
            <string name="Name">Game</string>
            <ProtectedString name="Source">--!nonstrict
-- Забег по лабиринту: комнаты строятся впереди и убираются позади, двери с номерами,
-- ключи (только для своей двери), отмычки, Сборщик платы, предметы, фонарик, шкафы,
-- рабочий лифт между секторами, зал Слепого, смерть и наблюдение, рекорды

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage").Workshop.Shared
local Rules = require(Shared.Rules)
local Plan = require(Shared.RoomPlan)
local Remotes = require(Shared.Roblox.Remotes)
local M = require(Shared.Materials)

local Props = require(script.Parent.Parent.World.Props)
local Builder = require(script.Parent.Parent.World.RoomBuilder)
local Special = require(script.Parent.Parent.World.Special)
local Entities = require(script.Parent.Entities)
local Records = require(script.Parent.Records)

local G = {}

local event: RemoteEvent
local world: Folder

local KEEP_BEHIND = 3 -- сколько открытых комнат остаётся позади

local run = {
	active = false,
	seed = 0,
	plan = nil,
	descs = {} :: { [number]: any },
	rooms = {} :: { [number]: any },
	front = 0, -- номер последней открытой двери
	sector = 1,
	ending = false,
}
G.run = run

-- состояние игроков: alive, coins, inv, keys, flash, flashOn, sneaking, hidden, god
local players: { [Player]: any } = {}
G.players = players
local occupied: { [BasePart]: Player } = {}

-- ---------------------------------------------------------------------------
-- общее

function G.rootOf(p: Player): BasePart?
	return p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
end
local rootOf = G.rootOf

local function humOf(p: Player): Humanoid?
	return p.Character and p.Character:FindFirstChildOfClass("Humanoid")
end
G.humOf = humOf

function G.send(p: Player, msg)
	if p.Parent then
		event:FireClient(p, msg)
	end
end
local send = G.send

function G.sendAll(msg)
	event:FireAllClients(msg)
end

local function toast(p: Player, key: string, ...)
	send(p, { type = "toast", key = key, args = { ... } })
end
G.toast = toast

local function announce(key: string, ...)
	G.sendAll({ type = "announce", key = key, args = { ... } })
end
G.announce = announce

function G.isAlive(p: Player): boolean
	local s = players[p]
	return s ~= nil and s.alive
end

function G.isHidden(p: Player): boolean
	local s = players[p]
	return s ~= nil and s.hidden ~= nil
end

function G.isSneaking(p: Player): boolean
	local s = players[p]
	return s ~= nil and s.sneaking == true
end

function G.alivePlayers(): { Player }
	local list = {}
	for p, s in players do
		if s.alive and p.Parent then
			table.insert(list, p)
		end
	end
	return list
end

function G.inRoom(info, pos: Vector3): boolean
	return Builder.contains(info, pos)
end

-- загруженные комнаты от старой к новой (без стартовой), до последней открытой
function G.loadedRooms()
	local list = {}
	for n = math.max(1, run.front - KEEP_BEHIND), run.front do
		local info = run.rooms[n]
		if info and not info.boss and not info.elevator then
			table.insert(list, info)
		end
	end
	return list
end

local function teleport(p: Player, cf: CFrame)
	local char = p.Character
	if not char then
		return
	end
	local r = rootOf(p)
	if r then
		r.Anchored = false
		r.AssemblyLinearVelocity = Vector3.zero
	end
	pcall(function()
		p:RequestStreamAroundAsync(cf.Position, 3)
	end)
	char:PivotTo(cf)
end
G.teleport = teleport

local function syncInv(p: Player)
	local s = players[p]
	if not s then
		return
	end
	local n = 0
	for _ in s.keys do
		n += 1
	end
	s.inv.key = if n &gt; 0 then n else nil
	p:SetAttribute("Coins", s.coins)
	send(p, { type = "inv", coins = s.coins, inv = s.inv })
end
G.syncInv = syncInv

local function sound(at: Instance?, id: string, vol: number, speed: number?)
	if at then
		Entities.sound(at, id, vol, speed)
	end
end

local SOUND = {
	door = "rbxasset://sounds/swoosh.wav",
	locked = "rbxasset://sounds/clickfast.wav",
	pick = "rbxasset://sounds/electronicpingshort.wav",
	coin = "rbxasset://sounds/electronicpingshort.wav",
	hit = "rbxasset://sounds/collide.wav",
	gate = "rbxasset://sounds/collide.wav",
}

-- ---------------------------------------------------------------------------
-- урон и смерть

function G.damage(p: Player, amount: number, cause: string?)
	local s = players[p]
	local hum = humOf(p)
	if not s or not s.alive or not hum or s.god then
		return
	end
	s.cause = cause
	hum:TakeDamage(amount)
end

function G.kill(p: Player, cause: string?)
	local s = players[p]
	local hum = humOf(p)
	if not s or not s.alive or not hum or s.god then
		return
	end
	s.cause = cause
	hum.Health = 0
end

local endRun -- объявлено ниже

local function onDied(p: Player)
	local s = players[p]
	if not s or not s.alive then
		return
	end
	s.alive = false
	p:SetAttribute("Alive", false)
	local part = s.hidden
	if part then
		occupied[part] = nil
		s.hidden = nil
	end
	send(p, { type = "dead", cause = s.cause or "unknown", door = run.front })
	announce("PlayerDied", p.DisplayName, run.front)
	if #G.alivePlayers() == 0 and run.active then
		task.spawn(endRun)
	end
end

-- ---------------------------------------------------------------------------
-- фонарик

local function flashlight(p: Player)
	local char = p.Character
	local head = char and char:FindFirstChild("Head")
	if not head then
		return nil
	end
	local l = head:FindFirstChild("Flashlight") :: SpotLight?
	if not l then
		local nl = Instance.new("SpotLight")
		nl.Name = "Flashlight"
		nl.Range = 48
		nl.Angle = 55
		nl.Brightness = 3.2
		nl.Color = Color3.fromRGB(255, 244, 220)
		nl.Shadows = true
		nl.Face = Enum.NormalId.Front
		nl.Enabled = false
		nl.Parent = head
		l = nl
	end
	return l
end

local function setFlash(p: Player, on: boolean)
	local s = players[p]
	if not s then
		return
	end
	s.flashOn = on and s.flash &gt; 0 and s.alive
	local l = flashlight(p)
	if l then
		l.Enabled = s.flashOn
	end
	p:SetAttribute("FlashOn", s.flashOn)
	p:SetAttribute("Flash", math.ceil(s.flash))
end
G.setFlash = setFlash

-- ---------------------------------------------------------------------------
-- шкафы

local function unhide(p: Player)
	local s = players[p]
	local part = s and s.hidden
	if not part then
		return
	end
	s.hidden = nil
	occupied[part] = nil
	p:SetAttribute("HiddenEye", nil)
	local r = rootOf(p)
	if r then
		r.Anchored = false
		local out = part.CFrame * CFrame.new(0, -part.Size.Y / 2 + 3, -(part.Size.Z / 2 + 2.5))
		p.Character:PivotTo(CFrame.lookAt(out.Position, out.Position + part.CFrame.LookVector))
	end
end
G.unhide = unhide

local function hide(p: Player, part: BasePart)
	local s = players[p]
	if not s or not s.alive then
		return
	end
	if s.hidden == part then
		unhide(p)
		return
	end
	if s.hidden or occupied[part] then
		toast(p, "ClosetTaken")
		return
	end
	s.hidden = part
	occupied[part] = p
	local r = rootOf(p)
	if r then
		p.Character:PivotTo(part.CFrame * CFrame.new(0, -part.Size.Y / 2 + 3, 0))
		r.Anchored = true
	end
	-- камера смотрит сквозь щель между дверцами
	p:SetAttribute("HiddenEye", part.CFrame * CFrame.new(0, 1.6, -part.Size.Z / 2 + 0.25))
end

-- ---------------------------------------------------------------------------
-- предметы

local ITEM_SOUND = SOUND.pick

local function give(p: Player, item: string, amount: number?): boolean
	local s = players[p]
	if not s then
		return false
	end
	if item == "coins" then
		s.coins += amount or 1
		sound(rootOf(p), SOUND.coin, 0.6, 1.5)
		syncInv(p)
		return true
	end
	if not Rules.add(s.inv, item) then
		toast(p, "BagFull")
		return false
	end
	sound(rootOf(p), ITEM_SOUND, 0.6)
	syncInv(p)
	return true
end
G.give = give

function G.use(p: Player, item: string)
	local s = players[p]
	if not s or not s.alive then
		return { ok = false }
	end
	if item == "plant" then
		local hum = humOf(p)
		if not hum or hum.Health &gt;= hum.MaxHealth then
			toast(p, "HealthFull")
			return { ok = false }
		end
		if Rules.take(s.inv, "plant") then
			hum.Health = math.min(hum.MaxHealth, hum.Health + Rules.PLANT_HEAL)
			toast(p, "Healed")
		end
	elseif item == "battery" then
		if s.flash &gt;= Rules.FLASH_MAX - 1 then
			toast(p, "FlashFull")
			return { ok = false }
		end
		if Rules.take(s.inv, "battery") then
			s.flash = Rules.recharge(s.flash)
			setFlash(p, s.flashOn)
			toast(p, "Recharged")
		end
	elseif item == "whistle" then
		if (s.inv.whistle or 0) &lt;= 0 then
			return { ok = false }
		end
		local now = os.clock()
		if now - (s.whistleAt or 0) &lt; 8 then
			toast(p, "WhistleWait")
			return { ok = false }
		end
		s.whistleAt = now
		Entities.whistle(p)
	else
		return { ok = false }
	end
	syncInv(p)
	return { ok = true }
end

-- ---------------------------------------------------------------------------
-- комнаты

local function descOf(n: number)
	while #run.descs &lt; n or run.descs[0] == nil do
		local k = if run.descs[0] == nil then 0 else #run.descs + 1
		run.descs[k] = Plan.room(run.plan, k)
	end
	return run.descs[n]
end

local openDoor -- объявлено ниже

local function wireDoor(info, n: number, cf: CFrame, locked: boolean)
	-- у зала Слепого дверь стоит в кабине лифта (зал убирается во время поездки)
	local holder = info.next or info
	local m, leaf, pr = Props.door(holder.model, cf, n, locked)
	info.door = { model = m, leaf = leaf, prompt = pr, number = n, locked = locked, opened = false }
	pr.Triggered:Connect(function(p)
		G.tryOpen(p, n)
	end)
end

-- ключ кладётся на стол или комод этой же комнаты
local function placeKey(info, n: number, rand)
	local spots = info.tops
	local cf
	if #spots &gt; 0 then
		cf = spots[math.floor(rand() * #spots) + 1]
	else
		cf = info.center * CFrame.new(0, -info.size.Y / 2, 0)
	end
	local _, part = Props.pickup(info.model, cf, "key")
	part:SetAttribute("KeyFor", n)
end

-- монеты и батарейки на виду (немного)
local function placeLoot(info, rand)
	for _, cf in info.tops do
		if rand() &lt; 0.35 then
			local r = rand()
			local item = if r &lt; 0.6 then "coins" elseif r &lt; 0.85 then "battery" else "plant"
			local _, part = Props.pickup(info.model, cf, item)
			if item == "coins" then
				part:SetAttribute("Amount", 1 + math.floor(rand() * 4))
			end
		end
	end
end

local function buildRoom(n: number)
	if run.rooms[n] then
		return run.rooms[n]
	end
	local d = descOf(n)
	local origin
	if n == 0 then
		origin = CFrame.new(0, 0, 0)
	else
		local prev = run.rooms[n - 1] or buildRoom(n - 1)
		origin = prev.doorCF
	end
	local info
	local rand = Plan.rng(run.seed + n * 7919)
	if d.kind == "boss" then
		info = Special.boss(world, d, origin, rand)
		local ed = table.clone(d)
		ed.kind = "elevator"
		ed.w, ed.l, ed.h = Plan.SIZES.elevator.w, Plan.SIZES.elevator.l, Plan.HEIGHT.elevator
		ed.turn = 0
		info.next = Special.elevator(world, ed, info.exitCF)
		info.doorCF = info.next.exitCF
		info.elevatorInfo = info.next
	elseif d.kind == "elevator" then
		info = Special.elevator(world, d, origin)
		info.doorCF = info.exitCF
		info.elevatorInfo = info
	else
		info = Builder.build(world, d, origin)
		info.doorCF = info.exitCF
	end
	info.n = n
	run.rooms[n] = info
	-- выходная дверь с номером
	wireDoor(info, n + 1, info.doorCF, d.locked == true)
	if d.locked then
		placeKey(info, n + 1, rand)
	end
	if not info.boss and not info.elevator and n &gt; 0 then
		placeLoot(info, rand)
	end
	if d.toll then
		local price = Rules.tollPrice(n + 1)
		local keeper, pc, pb = Special.tollKeeper(info.model, info.doorCF * CFrame.new(0, 0, 2.8) * CFrame.Angles(0, math.pi, 0), price)
		info.toll = { model = keeper, price = price, paid = false }
		pc.Triggered:Connect(function(p)
			G.payToll(p, info, "coins")
		end)
		pb.Triggered:Connect(function(p)
			G.payToll(p, info, "blood")
		end)
	end
	if d.watcher then
		Entities.spawnWatcher(info)
	end
	-- кнопки мебели и предметов этой комнаты
	G.wireRoom(info)
	if info.next then
		G.wireRoom(info.next)
	end
	return info
end
G.buildRoom = buildRoom

local function destroyRoom(n: number)
	local info = run.rooms[n]
	if not info then
		return
	end
	Entities.removeRoom(info)
	for part, p in occupied do
		if part:IsDescendantOf(info.model) then
			unhide(p)
		end
	end
	info.model:Destroy()
	if info.next then
		info.next.model:Destroy()
	end
	run.rooms[n] = nil
end

-- игроки, отставшие в убираемой комнате, переносятся вперёд
local function cleanup()
	local keepFrom = run.front - KEEP_BEHIND
	for n, info in run.rooms do
		if n &gt; 0 and n &lt; keepFrom then
			local target = run.rooms[keepFrom]
			if target then
				for _, p in G.alivePlayers() do
					local r = rootOf(p)
					if r and Builder.contains(info, r.Position) then
						teleport(p, target.origin * CFrame.new(0, 3, -3))
					end
				end
			end
			destroyRoom(n)
		end
	end
end

-- створка поворачивается на петлях
local function swing(door)
	local leaf = door.leaf
	local base = leaf:GetPivot()
	local v = Instance.new("NumberValue")
	v.Changed:Connect(function(a)
		leaf:PivotTo(base * CFrame.Angles(0, math.rad(-95) * a, 0))
	end)
	local t = TweenService:Create(v, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Value = 1 })
	t:Play()
	t.Completed:Connect(function()
		v:Destroy()
	end)
	for _, d in leaf:GetDescendants() do
		if d:IsA("BasePart") then
			d.CanCollide = false
		end
	end
	sound(door.leaf:FindFirstChild("Slab"), SOUND.door, 0.8, 0.6)
end

-- открыть дверь n (force — без проверок, для админа и лифта)
function openDoor(n: number, force: boolean?)
	local info = run.rooms[n - 1]
	if not info or not info.door or info.door.opened then
		return false
	end
	local door = info.door
	door.opened = true
	door.prompt.Enabled = false
	local lock = door.model:FindFirstChild("Padlock")
	if lock then
		lock:Destroy()
	end
	swing(door)
	run.front = math.max(run.front, n)
	run.sector = Rules.sectorOf(n)
	workspace:SetAttribute("Door", run.front)
	workspace:SetAttribute("Sector", run.sector)
	-- ключи от этой двери больше не нужны и не уносятся дальше
	for _, s in players do
		s.keys[n] = nil
	end
	for p, s in players do
		if s.alive then
			if Records.offer(p, n) then
				local ls = p:FindFirstChild("leaderstats")
				local b = ls and ls:FindFirstChild("Best")
				if b then
					(b :: IntValue).Value = n
				end
			end
			-- немного монет за каждую дверь
			s.coins += 1
			syncInv(p)
		end
	end
	local entered = buildRoom(n)
	buildRoom(n + 1)
	cleanup()
	Entities.noise(door.model:GetPivot().Position, Rules.NOISE.door)
	if entered.boss then
		Entities.startBlind(entered)
		announce("BossHall")
	end
	if entered.desc.hum and not force then
		task.delay(1.5 + math.random() * 3, function()
			if run.active and run.front &gt;= n then
				Entities.hum()
			end
		end)
	end
	if Rules.isSectorEnd(n) then
		announce("SectorEnd", run.sector)
	end
	return true
end
G.openDoor = openDoor

function G.tryOpen(p: Player, n: number)
	local s = players[p]
	if not s or not s.alive or s.hidden then
		return
	end
	local info = run.rooms[n - 1]
	if not info or not info.door then
		return
	end
	if info.toll and not info.toll.paid then
		toast(p, "TollBlocks", info.toll.price)
		return
	end
	if info.elevatorInfo and not info.elevatorInfo.rideDone then
		toast(p, "RideFirst")
		return
	end
	if info.door.locked then
		if s.keys[n] then
			s.keys[n] = nil
			toast(p, "Unlocked")
		elseif Rules.take(s.inv, "lockpick") then
			toast(p, "Picked")
		else
			sound(info.door.model:FindFirstChild("Trigger"), SOUND.locked, 0.8)
			toast(p, "Locked")
			return
		end
		syncInv(p)
	end
	openDoor(n)
end

-- ---------------------------------------------------------------------------
-- Сборщик платы

function G.payToll(p: Player, info, how: string)
	local s = players[p]
	local t = info.toll
	if not s or not s.alive or not t or t.paid then
		return
	end
	if how == "coins" then
		if s.coins &lt; t.price then
			toast(p, "NotEnoughCoins", t.price)
			return
		end
		s.coins -= t.price
		toast(p, "PaidCoins", t.price)
	else
		local hum = humOf(p)
		if not hum then
			return
		end
		hum.Health = Rules.afterBloodToll(hum.Health)
		send(p, { type = "fx", kind = "blood" })
		toast(p, "PaidBlood")
	end
	t.paid = true
	syncInv(p)
	-- сборщик растворяется
	for _, d in t.model:GetDescendants() do
		if d:IsA("BasePart") then
			d.CanCollide = false
			TweenService:Create(d, TweenInfo.new(1.2), { Transparency = 1 }):Play()
		elseif d:IsA("ProximityPrompt") then
			d.Enabled = false
		elseif d:IsA("PointLight") then
			d.Enabled = false
		end
	end
	task.delay(1.4, function()
		t.model:Destroy()
	end)
end

-- ---------------------------------------------------------------------------
-- кнопки мебели и предметов в комнате

local function bossOf(part: Instance)
	for _, info in run.rooms do
		if info.boss and part:IsDescendantOf(info.model) then
			return info
		end
	end
	return nil
end

local function openBigGate(info)
	if info.gateOpen then
		return
	end
	info.gateOpen = true
	announce("GateOpen")
	local gate = info.bigGate
	local base = info.bigGateHome
	local v = Instance.new("NumberValue")
	v.Changed:Connect(function(a)
		gate:PivotTo(base * CFrame.new(0, 15 * a, 0))
	end)
	local t = TweenService:Create(v, TweenInfo.new(4, Enum.EasingStyle.Sine), { Value = 1 })
	t:Play()
	t.Completed:Connect(function()
		v:Destroy()
		for _, d in gate:GetDescendants() do
			if d:IsA("BasePart") then
				d.CanCollide = false
			end
		end
	end)
	sound(gate:FindFirstChildWhichIsA("BasePart"), SOUND.gate, 2, 0.4)
	Entities.noise(base.Position, Rules.NOISE.gate, "gate")
	for _, lamp in info.lights do
		local l = lamp:FindFirstChildOfClass("PointLight")
		if l then
			l.Color = Color3.fromRGB(255, 230, 190)
			l.Brightness = 1.3
		end
		lamp.Color = Color3.fromRGB(255, 230, 190)
	end
end

local function repair(p: Player, info, g)
	local s = players[p]
	if not s or not s.alive or g.done then
		return
	end
	if not g.fused then
		if Rules.take(s.inv, "fuse") then
			g.fused = true
			toast(p, "FuseIn")
			sound(g.body, SOUND.pick, 1)
			syncInv(p)
		else
			toast(p, "NeedFuse")
		end
		return
	end
	g.progress = Rules.repair(g.progress)
	local sp = g.body:FindFirstChild("Sparks")
	if sp then
		(sp :: ParticleEmitter):Emit(25)
	end
	sound(g.body, SOUND.hit, 1.2, 0.8)
	Entities.noise(g.body.Position, Rules.NOISE.repair, "repair")
	if g.progress &gt;= 100 then
		g.done = true
		g.lamp.Color = Color3.fromRGB(60, 230, 90)
		local l = g.lamp:FindFirstChildOfClass("PointLight")
		if l then
			l.Color = Color3.fromRGB(90, 255, 120)
		end
		local done = 0
		for _, gg in info.generators do
			if gg.done then
				done += 1
			end
		end
		announce("GeneratorFixed", done, #info.generators)
		if done &gt;= #info.generators then
			openBigGate(info)
		end
	else
		toast(p, "Repairing", g.progress)
	end
end

local ride -- объявлено ниже

function G.wireRoom(info)
	for _, d in info.model:GetDescendants() do
		if d:IsA("ProximityPrompt") and not d:GetAttribute("Wired") then
			local kind = d:GetAttribute("Kind")
			local part = d.Parent
			if kind == "hide" then
				d:SetAttribute("Wired", true)
				d.Triggered:Connect(function(p)
					hide(p, part)
				end)
			elseif kind == "search" then
				d:SetAttribute("Wired", true)
				d.Triggered:Connect(function(p)
					if not G.isAlive(p) or part:GetAttribute("Searched") then
						return
					end
					part:SetAttribute("Searched", true)
					d.Enabled = false
					local item, amount = Rules.loot(math.random(), run.front)
					if item == "nothing" then
						toast(p, "Empty")
					elseif give(p, item, amount) then
						toast(p, "Found_" .. item, amount)
					end
				end)
			elseif kind == "pick" then
				d:SetAttribute("Wired", true)
				d.Triggered:Connect(function(p)
					local s = players[p]
					if not s or not s.alive or not part.Parent then
						return
					end
					local item = part:GetAttribute("Item")
					if item == "key" then
						local n = part:GetAttribute("KeyFor")
						s.keys[n] = true
						toast(p, "KeyTaken")
						sound(part, SOUND.pick, 0.8)
						syncInv(p)
					elseif item == "coins" then
						give(p, "coins", part:GetAttribute("Amount") or 2)
						toast(p, "Found_coins", part:GetAttribute("Amount") or 2)
					elseif not give(p, item) then
						return
					else
						toast(p, "Found_" .. item, 1)
					end
					part.Parent:Destroy()
				end)
			elseif kind == "repair" then
				d:SetAttribute("Wired", true)
				local boss = bossOf(part)
				if boss then
					for _, g in boss.generators do
						if g.body == part then
							d.Triggered:Connect(function(p)
								repair(p, boss, g)
							end)
						end
					end
				end
			elseif kind == "ride" then
				d:SetAttribute("Wired", true)
				d.Triggered:Connect(function(p)
					ride(p, info)
				end)
			elseif kind == "shop" then
				d:SetAttribute("Wired", true)
				d.Triggered:Connect(function(p)
					if G.isAlive(p) then
						send(p, { type = "shop" })
					end
				end)
			end
		end
	end
end

function G.buy(p: Player, item: string)
	local s = players[p]
	if not s or not s.alive then
		return { ok = false }
	end
	-- покупать можно только у автомата в лифте
	local r = rootOf(p)
	local near = false
	for _, info in run.rooms do
		local e = info.elevatorInfo
		if e and r and Builder.contains(e, r.Position) then
			near = true
		end
	end
	if not near then
		return { ok = false, error = "far" }
	end
	local ok, coins, why = Rules.buy(s.inv, s.coins, item)
	if not ok then
		toast(p, if why == "coins" then "NotEnoughCoins" else "BagFull", Rules.PRICES[item] or 0)
		return { ok = false, error = why }
	end
	s.coins = coins
	syncInv(p)
	return { ok = true }
end

-- ---------------------------------------------------------------------------
-- лифт: только вертикально и только на один сектор вперёд

function ride(p: Player, info)
	if not G.isAlive(p) or info.riding or info.rideDone then
		return
	end
	local owner = nil
	for n, r in run.rooms do
		if r.elevatorInfo == info then
			owner = n
		end
	end
	if not owner then
		return
	end
	info.riding = true
	local from = info.desc.sector
	announce("ElevatorLeaving", 8)
	task.wait(8)
	if not run.active then
		return
	end
	-- кто не успел — заходит в кабину
	local k = 0
	for _, q in G.alivePlayers() do
		local r = rootOf(q)
		if r and not Special.inCabin(info, r.Position) then
			unhide(q)
			k += 1
			teleport(q, info.cabinCenter * CFrame.new(((k % 3) - 1) * 3, 0, (math.floor(k / 3) % 3 - 1) * 2.5))
		end
	end
	info.gate:PivotTo(info.gate:GetPivot() - Vector3.new(0, 10.5, 0))
	info.gateBlock.CanCollide = true
	G.sendAll({ type = "ride", from = from, to = from + 1 })
	local rumble = Entities.sound(info.model, Entities.SOUND.rumble, 1.5, 0.3, true)
	-- старый сектор исчезает, кабина «едет»
	for n in run.rooms do
		if n &gt; 0 and n &lt; owner then
			destroyRoom(n)
		end
	end
	local holder = run.rooms[owner]
	if holder and holder.boss then
		Entities.stopBlind()
		holder.model:Destroy()
	end
	-- детали из зала дальше не нужны
	for q, s in players do
		if s.inv.fuse then
			s.inv.fuse = nil
			syncInv(q)
		end
	end
	task.wait(7)
	rumble:Stop()
	info.rideDone = true
	run.sector = from + 1
	workspace:SetAttribute("Sector", run.sector)
	announce("SectorWelcome", run.sector)
	openDoor(owner + 1, true)
end

-- ---------------------------------------------------------------------------
-- начало и конец забега

local function spawnPoint(): CFrame
	local start = run.rooms[0]
	return start.origin * CFrame.new(math.random(-6, 6), 3, -20 + math.random(-3, 3))
end

local function frontSpawn(): CFrame
	local info = run.rooms[run.front] or run.rooms[0]
	if info.boss and info.elevatorInfo then
		info = info.elevatorInfo
	end
	return info.origin * CFrame.new(0, 3, -4)
end

local function resetPlayer(p: Player)
	local s = players[p]
	s.alive = true
	s.cause = nil
	s.coins = 0
	s.inv = {}
	s.keys = {}
	s.flash = Rules.FLASH_MAX
	s.flashOn = false
	s.sneaking = false
	s.hidden = nil
	p:SetAttribute("Alive", true)
	p:SetAttribute("HiddenEye", nil)
end

local function loadCharacter(p: Player, cf: CFrame)
	resetPlayer(p)
	p:LoadCharacter()
	local char = p.Character or p.CharacterAdded:Wait()
	char:WaitForChild("HumanoidRootPart", 5)
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.WalkSpeed = Rules.SPEED.walk
		hum.Died:Connect(function()
			onDied(p)
		end)
	end
	teleport(p, cf)
	setFlash(p, false)
	syncInv(p)
end

local function startRun()
	run.active = true
	run.ending = false
	run.seed = math.random(1, 2 ^ 30)
	run.plan = Plan.new(run.seed)
	run.descs = {}
	run.rooms = {}
	run.front = 0
	run.sector = 1
	world:ClearAllChildren()
	workspace:SetAttribute("Door", 0)
	workspace:SetAttribute("Sector", 1)
	buildRoom(0)
	buildRoom(1)
end

function endRun()
	if run.ending then
		return
	end
	run.ending = true
	G.sendAll({ type = "results", door = run.front, sector = run.sector })
	task.wait(7)
	Entities.clear()
	table.clear(occupied)
	startRun()
	for p in players do
		if p.Parent then
			task.spawn(loadCharacter, p, spawnPoint())
		end
	end
end
G.endRun = endRun

-- игрок нажал «Играть»: если забег уже далеко, переносится к остальным
function G.play(p: Player)
	local s = players[p]
	if not s then
		return { ok = false }
	end
	if s.alive and run.front &gt;= 2 then
		local r = rootOf(p)
		local start = run.rooms[0]
		if r and start and Builder.contains(start, r.Position) then
			teleport(p, frontSpawn())
		end
	end
	return { ok = true, best = Records.get(p), door = run.front, alive = s.alive }
end

-- ---------------------------------------------------------------------------

function G.init()
	Players.CharacterAutoLoads = false
	event = Remotes.event("Game")
	world = Instance.new("Folder")
	world.Name = "Labyrinth"
	world.Parent = workspace
	Records.init()
	Entities.init(G)
	startRun()

	local function added(p: Player)
		local ls = Instance.new("Folder")
		ls.Name = "leaderstats"
		local best = Instance.new("IntValue")
		best.Name = "Best"
		best.Parent = ls
		ls.Parent = p
		players[p] = { alive = false, coins = 0, inv = {}, keys = {}, flash = Rules.FLASH_MAX }
		best.Value = Records.load(p)
		loadCharacter(p, spawnPoint())
	end
	Players.PlayerAdded:Connect(added)
	for _, p in Players:GetPlayers() do
		task.spawn(added, p)
	end
	Players.PlayerRemoving:Connect(function(p)
		unhide(p)
		players[p] = nil
		Records.forget(p)
		if run.active and #G.alivePlayers() == 0 and #Players:GetPlayers() &gt; 1 then
			task.spawn(endRun)
		end
	end)

	Remotes.fn("Request").OnServerInvoke = function(p: Player, action: any, arg: any)
		local s = players[p]
		if not s then
			return { ok = false }
		end
		if action == "Play" then
			return G.play(p)
		elseif action == "Flash" then
			setFlash(p, not s.flashOn)
			if s.flash &lt;= 0 then
				toast(p, "FlashEmpty")
			end
			return { ok = true }
		elseif action == "Sneak" then
			s.sneaking = arg == true
			local hum = humOf(p)
			if hum and s.alive then
				hum.WalkSpeed = if s.sneaking then Rules.SPEED.sneak else Rules.SPEED.walk
			end
			return { ok = true }
		elseif action == "Use" and type(arg) == "string" then
			return G.use(p, arg)
		elseif action == "Buy" and type(arg) == "string" then
			return G.buy(p, arg)
		elseif action == "Seen" and type(arg) == "number" then
			Entities.seen(p, arg)
			return nil
		elseif action == "Status" then
			syncInv(p)
			return { ok = true, best = Records.get(p), door = run.front, alive = s.alive }
		end
		return { ok = false }
	end

	-- фонарик садится, упавшие возвращаются, отставшие в убранных комнатах переносятся
	task.spawn(function()
		while true do
			local dt = task.wait(0.25)
			for p, s in players do
				if s.alive and s.flashOn then
					s.flash = Rules.drain(s.flash, dt, true)
					if s.flash &lt;= 0 then
						setFlash(p, false)
						toast(p, "FlashEmpty")
					else
						p:SetAttribute("Flash", math.ceil(s.flash))
					end
				end
				local r = rootOf(p)
				if s.alive and r and r.Position.Y &lt; -60 then
					teleport(p, frontSpawn())
				end
			end
		end
	end)
	local _ = M
end

return G
</ProtectedString>
