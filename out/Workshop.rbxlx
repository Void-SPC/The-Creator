		{ id = "EyeSpiral1", shape = "Cylinder", size = {0.06,0.72,0.72}, pos = {0.03,10.02,-0.55}, rot = {0,90,0}, color = {176,184,190}, material = "Plastic", transparency = 0, pivot = {0,0,0}, parent = "Head" },
		{ id = "EyeSpiral2", shape = "Cylinder", size = {0.06,0.48,0.48}, pos = {0.06,10.04,-0.58}, rot = {0,90,0}, color = {27,31,39}, material = "Plastic", transparency = 0, pivot = {0,0,0}, parent = "Head" },
		{ id = "EyePupil", shape = "Cylinder", size = {0.06,0.2,0.2}, pos = {0.09,10.06,-0.61}, rot = {0,90,0}, color = {120,235,215}, material = "Neon", transparency = 0, pivot = {0,0,0}, parent = "Head" },
