	Props.fridge(c.m, slotR(d, o, -6))
	local _, t2 = Props.counter(c.m, slotR(d, o, -13), 8)
	table.insert(c.info.tops, t2)
	local _, t3 = Props.table(c.m, spot(d, o, 0, -16), 6, 3)
