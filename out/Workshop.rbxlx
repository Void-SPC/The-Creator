function Lang.t(lang: string, key: string, ...): string
	local pack = Lang[lang] or Lang.en
	local s = pack.L[key] or pack.H[key] or Lang.en.L[key] or Lang.en.H[key] or key
	if select("#", ...) &gt; 0 then
		return string.format(s, ...)
	end
	return s
end

-- Проверка правила точек для обоих языков
function Lang.lint()
	local problems = {}
	for _, lang in { "en", "ru" } do
		for key, text in Lang[lang].L do
			local masked = string.gsub(text, "%d+%.%d+", "0")
			if string.find(masked, "%.$") or string.find(masked, "%.%s+%S") then
				table.insert(problems, lang .. ".L." .. key)
			end
		end
		for key, text in Lang[lang].H do
			if not string.find(text, "[%.!?]$") then
				table.insert(problems, lang .. ".H." .. key)
			end
		end
		for key in Lang.en.L do
			if Lang[lang].L[key] == nil then
				table.insert(problems, lang .. " missing " .. key)
			end
		end
	end
	return problems
end

return Lang
