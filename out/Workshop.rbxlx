      <Item class="ModuleScript" referent="RBX0000002B">
        <Properties>
          <string name="Name">Access</string>
          <ProtectedString name="Source">--!nonstrict
-- Кто считается создателем: владелец игры, пользователи из Config и (в Studio) все
-- Права проверяются только на сервере; клиент лишь прячет кнопки

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Config = require(script.Parent.Config)

local Access = {}

local resolvedIds: { [number]: boolean } = {}
local cache: { [number]: boolean } = {}

-- Имена из Config переводятся в постоянные ID аккаунтов, чтобы смена ника не давала
-- доступ чужому человеку с таким же именем
task.spawn(function()
	for _, name in Config.CREATOR_USERNAMES do
		for _ = 1, 3 do
			local ok, id = pcall(function()
				return Players:GetUserIdFromNameAsync(name)
			end)
			if ok and type(id) == "number" then
				resolvedIds[id] = true
				table.clear(cache)
				break
			end
			task.wait(2)
		end
	end
end)

local function ownerOf(player: Player): boolean
	if game.CreatorType == Enum.CreatorType.User then
		return game.CreatorId == player.UserId
	end
	local ok, rank = pcall(function()
		return player:GetRankInGroup(game.CreatorId)
	end)
	return ok and rank &gt;= 254
end

function Access.isCreator(player: Player): boolean
	local c = cache[player.UserId]
	if c ~= nil then
		return c
	end
	local result = RunService:IsStudio()
		or ownerOf(player)
		or resolvedIds[player.UserId] == true
		or table.find(Config.CREATOR_USER_IDS, player.UserId) ~= nil
	-- кэшируем только положительный ответ: ID имени может прийти чуть позже
	if result then
		cache[player.UserId] = true
	end
	return result
end

-- Создатель по ID (для карт: валюту выдают только карты создателей)
function Access.isCreatorUserId(userId: number): boolean
	if RunService:IsStudio() then
		return true
	end
	if game.CreatorType == Enum.CreatorType.User and game.CreatorId == userId then
		return true
	end
	if resolvedIds[userId] or table.find(Config.CREATOR_USER_IDS, userId) then
		return true
	end
	local p = Players:GetPlayerByUserId(userId)
	return p ~= nil and Access.isCreator(p)
end

function Access.forget(player: Player)
	cache[player.UserId] = nil
end

return Access
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0000002C">
        <Properties>
          <string name="Name">AdminService</string>
          <ProtectedString name="Source">--!nonstrict
-- Права администратора проверяются только на сервере

local RunService = game:GetService("RunService")
local Config = require(script.Parent.Config)
local Access = require(script.Parent.Access)

local AdminService = {}

local cache: { [number]: boolean } = {}

function AdminService.isAdmin(player: Player): boolean
	local cached = cache[player.UserId]
	if cached ~= nil then
		return cached
	end
	local result = false
	if RunService:IsStudio() or Access.isCreator(player) then
		result = true
	elseif game.CreatorType == Enum.CreatorType.User and game.CreatorId == player.UserId then
		result = true
	elseif table.find(Config.ADMIN_USER_IDS, player.UserId) then
		result = true
	elseif Config.ADMIN_GROUP then
		local g = Config.ADMIN_GROUP
		local ok, rank = pcall(function()
			return player:GetRankInGroup(g.id)
		end)
		result = ok and rank &gt;= g.minRank
	elseif game.CreatorType == Enum.CreatorType.Group then
		local ok, rank = pcall(function()
			return player:GetRankInGroup(game.CreatorId)
		end)
		result = ok and rank &gt;= 254
	end
	if result then
		cache[player.UserId] = result
	end
	return result
end

function AdminService.forget(player: Player)
	cache[player.UserId] = nil
end

return AdminService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="Folder" referent="RBX0000002D">
        <Properties>
          <string name="Name">Castle</string>
        </Properties>
        <Item class="ModuleScript" referent="RBX0000002E">
          <Properties>
            <string name="Name">Admin</string>
            <ProtectedString name="Source">--!nonstrict
-- Админ-панель замка: выполнение команд из AdminCommands. Доступ только создателям
-- (владелец игры, Saren45hil и Nataliaavira13), проверка здесь, на сервере

local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")
local Debris = game:GetService("Debris")

local Shared = game:GetService("ReplicatedStorage").Workshop.Shared
local Commands = require(Shared.AdminCommands)
local Rules = require(Shared.CastleRules)
local Remotes = require(Shared.Roblox.Remotes)

local Access = require(script.Parent.Parent.Access)
local CurrencyService = require(script.Parent.Parent.CurrencyService)
local Builder = require(script.Parent.CastleBuilder)
local Npc = require(script.Parent.Npc)
local Seasons = require(script.Parent.Seasons)
local G = require(script.Parent.CastleGame)

local Admin = {}

local hidden: { [Player]: { [Instance]: number } } = {}

local function hum(p: Player): Humanoid?
	return G.humOf(p)
end

local function root(p: Player): BasePart?
	return G.rootOf(p)
end

local function effect(p: Player, class: string, props)
	local r = p.Character and (p.Character:FindFirstChild("UpperTorso") or p.Character:FindFirstChild("Torso") or root(p))
	if not r then
		return
	end
	local e = Instance.new(class)
	e.Name = "AdminEffect"
	for k, v in props or {} do
		(e :: any)[k] = v
	end
	e.Parent = if class == "ForceField" or class == "Highlight" then p.Character else r
end

local function clearEffects(p: Player)
	if not p.Character then
		return
	end
	for _, d in p.Character:GetDescendants() do
		if d.Name == "AdminEffect" then
			d:Destroy()
		end
	end
end

local function setVisible(p: Player, visible: boolean)
	local char = p.Character
	if not char then
		return
	end
	if visible then
		for inst, t in hidden[p] or {} do
			if inst.Parent then
				(inst :: any).Transparency = t
			end
		end
		hidden[p] = nil
		local h = hum(p)
		if h then
			h.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
		end
		return
	end
	local saved = hidden[p] or {}
	for _, d in char:GetDescendants() do
		if (d:IsA("BasePart") or d:IsA("Decal")) and saved[d] == nil then
			saved[d] = (d :: any).Transparency
			;(d :: any).Transparency = 1
		end
	end
	hidden[p] = saved
	local h = hum(p)
	if h then
		h.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
end

local function chatSource(p: Player): TextSource?
	local tc = TextChatService:FindFirstChild("TextChannels")
	local general = tc and tc:FindFirstChild("RBXGeneral")
	for _, s in (if general then general:GetChildren() else {}) do
		if s:IsA("TextSource") and s.UserId == p.UserId then
			return s
		end
	end
	return nil
end

local function num(arg, lo, hi, default)
	local n = tonumber(arg)
	if not n then
		return default
	end
	return math.clamp(n, lo, hi)
end

local function fxAll(kind: string)
	for p in G.state.players do
		Remotes.event("Castle"):FireClient(p, { type = "fx", kind = kind })
	end
end

-- команды для всего замка
local WORLD = {
	season = function(_, arg)
		if table.find(Seasons.LIST, arg) then
			G.setSeason(arg)
			return true
		end
	end,
	day = function()
		G.setClock(12)
		return true
	end,
	dusk = function()
		G.setClock(18.2)
		return true
	end,
	night = function()
		G.setClock(23)
		return true
	end,
	weather = function(_, arg)
		if arg == "Clear" or arg == "Rain" or arg == "Snow" or arg == "Fog" or arg == "Storm" then
			G.setWeather(arg)
			return true
		end
	end,
	lightning = function()
		G.state.fxCount = (G.state.fxCount or 0) + 1
		for p in G.state.players do
			Remotes.event("Castle"):FireClient(p, { type = "fx", kind = "lightning" })
		end
		return true
	end,
	announce = function(admin, arg)
		if type(arg) ~= "string" or #arg == 0 or #arg &gt; 200 then
			return false
		end
		local ok, filtered = pcall(function()
			local r = game:GetService("TextService"):FilterStringAsync(arg, admin.UserId)
			return r:GetNonChatStringForBroadcastAsync()
		end)
		if not ok then
			return false
		end
		G.announce(nil, filtered)
		return true
	end,
	fireworks = function()
		for p in G.state.players do
			Remotes.event("Castle"):FireClient(p, { type = "fx", kind = "fireworks" })
		end
		return true
	end,
	confetti = function()
		for p in G.state.players do
			Remotes.event("Castle"):FireClient(p, { type = "fx", kind = "confetti" })
		end
		return true
	end,
	passage_open = function()
		task.spawn(G.setPassage, true)
		return true
	end,
	passage_close = function()
		task.spawn(G.setPassage, false)
		return true
	end,
	gates_open = function()
		G.setGates(true)
		return true
	end,
	gates_close = function()
		G.setGates(false)
		return true
	end,
	free_all = function()
		for _, p in table.clone(G.state.cells) do
			G.free(p, true)
		end
		return true
	end,
	spawn_guards = function(admin, arg)
		G.summon(admin, num(arg, 1, Rules.MINION_MAX, 2))
		return true
	end,
	clear_npcs = function()
		Npc.clearMinions()
		G.state.minionTarget = nil
		G.syncWorld()
		return true
	end,
	pvp_on = function()
		G.setPvp(true)
		return true
	end,
	pvp_off = function()
		G.setPvp(false)
		return true
	end,
	needs_on = function()
		G.setNeeds(true)
		return true
	end,
	needs_off = function()
		G.setNeeds(false)
		return true
	end,
	music = function(_, arg)
		local id = tonumber(arg)
		if not id then
			return false
		end
		workspace:SetAttribute("CastleMusic", "rbxassetid://" .. math.floor(id))
		return true
	end,
	music_stop = function()
		workspace:SetAttribute("CastleMusic", "")
		return true
	end,
	reset_roles = function()
		for p in G.state.players do
			G.setRole(p, "peasant")
		end
		return true
	end,
	heal_all = function()
		for p in G.state.players do
			local h = hum(p)
			if h then
				h.Health = h.MaxHealth
			end
		end
		return true
	end,
	feed_all = function()
		for p, info in G.state.players do
			info.food, info.drink = Rules.MAX, Rules.MAX
			G.sync(p)
		end
		return true
	end,
	-- силы Бога для всего замка
	divine_voice = function(admin, arg)
		if type(arg) ~= "string" or #arg == 0 or #arg &gt; 200 then
			return false
		end
		local ok, filtered = pcall(function()
			local r = game:GetService("TextService"):FilterStringAsync(arg, admin.UserId)
			return r:GetNonChatStringForBroadcastAsync()
		end)
		if not ok then
			return false
		end
		fxAll("voice")
		G.announce(nil, filtered)
		return true
	end,
	earthquake = function()
		fxAll("quake")
		return true
	end,
	meteors = function()
		task.spawn(function()
			for _ = 1, 24 do
				local p = Instance.new("Part")
				p.Shape = Enum.PartType.Ball
				p.Size = Vector3.new(3, 3, 3)
				p.Material = Enum.Material.Neon
				p.Color = Color3.fromRGB(255, 140, 60)
				p.CanCollide = false
				p.CanQuery = false
				p.Position = Vector3.new(math.random(-150, 150), 220, math.random(-170, 170))
				p.AssemblyLinearVelocity = Vector3.new(math.random(-30, 30), -160, math.random(-30, 30))
				local f = Instance.new("Fire")
				f.Size = 6
				f.Parent = p
				p.Parent = workspace
				Debris:AddItem(p, 4)
				task.wait(0.25)
			end
		end)
		return true
	end,
	gold_rain = function()
		task.spawn(function()
			for _ = 1, 40 do
				local c = Instance.new("Part")
				c.Shape = Enum.PartType.Cylinder
				c.Size = Vector3.new(0.3, 1.6, 1.6)
				c.Material = Enum.Material.Neon
				c.Color = Color3.fromRGB(255, 210, 90)
				c.Position = Vector3.new(math.random(-60, 60), 60, math.random(-170, -125))
				local taken = false
				c.Touched:Connect(function(hit)
					local who = Players:GetPlayerFromCharacter(hit.Parent)
					if who and not taken and G.state.players[who] then
						taken = true
						CurrencyService.add(who, 5)
						c:Destroy()
					end
				end)
				c.Parent = workspace
				Debris:AddItem(c, 40)
				task.wait(0.15)
			end
		end)
		return true
	end,
	gravity_low = function()
		workspace.Gravity = 60
		return true
	end,
	gravity_normal = function()
		workspace.Gravity = 196.2
		return true
	end,
	darkness = function()
		G.setClock(0)
		G.setWeather("Fog")
		return true
	end,
	dawn = function()
		G.setClock(6.6)
		G.setWeather("Clear")
		fxAll("dawn")
		return true
	end,
	freeze_all = function(admin)
		for p in G.state.players do
			local r = root(p)
			if r and p ~= admin then
				r.Anchored = true
			end
		end
		return true
	end,
	thaw_all = function()
		for p in G.state.players do
			local r = root(p)
			if r then
				r.Anchored = false
			end
		end
		return true
	end,
	bring_all = function(admin)
		local r = root(admin)
		if not r then
			return false
		end
		local k = 0
		for p in G.state.players do
			if p ~= admin then
				k += 1
				local a = k * 0.7
				G.teleport(p, r.CFrame * CFrame.new(math.cos(a) * 6, 0, math.sin(a) * 6))
			end
		end
		return true
	end,
	shield_all = function()
		for p in G.state.players do
			if p.Character then
				local ff = Instance.new("ForceField")
				ff.Name = "AdminEffect"
				ff.Parent = p.Character
				Debris:AddItem(ff, 30)
			end
		end
		return true
	end,
	rainbow = function()
		fxAll("rainbow")
		return true
	end,
}

-- команды для одного игрока
local PLAYER = {
	kill = function(_, p)
		local h = hum(p)
		if h then
			h.Health = 0
		end
	end,
	heal = function(_, p)
		local h = hum(p)
		if h then
			h.Health = h.MaxHealth
		end
	end,
	refill = function(_, p)
		local info = G.state.players[p]
		if info then
			info.food, info.drink = Rules.MAX, Rules.MAX
			G.sync(p)
		end
	end,
	starve = function(_, p)
		local info = G.state.players[p]
		if info then
			info.food, info.drink = 10, 10
			G.sync(p)
		end
	end,
	god = function(_, p)
		if p.Character and not p.Character:FindFirstChild("GodShield") then
			local ff = Instance.new("ForceField")
			ff.Name = "GodShield"
			ff.Visible = false
			ff.Parent = p.Character
		end
	end,
	ungod = function(_, p)
		local ff = p.Character and p.Character:FindFirstChild("GodShield")
		if ff then
			ff:Destroy()
		end
	end,
	speed = function(_, p, arg)
		local h = hum(p)
		if h then
			h.WalkSpeed = num(arg, 0, 150, 16)
		end
	end,
	jump = function(_, p, arg)
		local h = hum(p)
		if h then
			h.UseJumpPower = true
			h.JumpPower = num(arg, 0, 250, 50)
		end
	end,
	fly = function(_, p)
		p:SetAttribute("Fly", true)
	end,
	unfly = function(_, p)
		p:SetAttribute("Fly", false)
	end,
	invisible = function(_, p)
		setVisible(p, false)
	end,
	visible = function(_, p)
		setVisible(p, true)
	end,
	hidename = function(_, p)
		local h = hum(p)
		if h then
			h.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		end
	end,
	showname = function(_, p)
		local h = hum(p)
		if h then
			h.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
		end
	end,
	freeze = function(_, p)
		local r = root(p)
		if r then
			r.Anchored = true
		end
	end,
	thaw = function(_, p)
		local r = root(p)
		if r then
			r.Anchored = false
		end
	end,
	bring = function(admin, p)
		local r = root(admin)
		if r then
			G.teleport(p, r.CFrame * CFrame.new(0, 0, -4))
		end
	end,
	["goto"] = function(admin, p)
		local r = root(p)
		if r then
			G.teleport(admin, r.CFrame * CFrame.new(0, 0, 4))
		end
	end,
	tp_throne = function(_, p)
		G.teleport(p, Builder.points.throneRoom)
	end,
	tp_yard = function(_, p)
		G.teleport(p, Builder.points.yard)
	end,
	jail = function(_, p)
		G.jail(p)
	end,
	free = function(_, p)
		G.free(p, true)
	end,
	kick = function(admin, p)
		if p ~= admin and not Access.isCreator(p) then
			p:Kick()
		end
	end,
	give_gold = function(_, p, arg)
		CurrencyService.add(p, num(arg, 1, 100000, 100))
	end,
	take_gold = function(_, p, arg)
		local cur = CurrencyService.get(p) or 0
		CurrencyService.add(p, -math.min(cur, num(arg, 1, 100000, 100)))
	end,
	give_item = function(_, p, arg)
		if type(arg) == "string" and Rules.ITEMS[arg] then
			local info = G.state.players[p]
			-- админ может выдать предмет любой роли: проверка роли обходится только здесь
			if info and not Rules.canHold(arg, info.role) then
				local def = Rules.ITEMS[arg]
				local saved = def.roles
				def.roles = nil
				G.giveItem(p, arg)
				def.roles = saved
			else
				G.giveItem(p, arg)
			end
		end
	end,
	clear_items = function(_, p)
		G.clearItems(p)
	end,
	set_role = function(_, p, arg)
		if type(arg) == "string" and Rules.ROLES[arg] then
			G.setRole(p, arg)
		end
	end,
	dethrone = function(_, p)
		if G.state.king == p then
			G.setRole(p, "peasant")
		end
	end,
	size_big = function(_, p)
		pcall(function()
			p.Character:ScaleTo(2)
		end)
	end,
	size_small = function(_, p)
		pcall(function()
			p.Character:ScaleTo(0.5)
		end)
	end,
	size_normal = function(_, p)
		pcall(function()
			p.Character:ScaleTo(1)
		end)
	end,
	sparkles = function(_, p)
		effect(p, "Sparkles", { SparkleColor = Color3.fromRGB(255, 220, 120) })
	end,
	fire = function(_, p)
		effect(p, "Fire", { Size = 4, Heat = 0 })
	end,
	smoke = function(_, p)
		effect(p, "Smoke", { Opacity = 0.3, RiseVelocity = 4 })
	end,
	forcefield = function(_, p)
		effect(p, "ForceField", { Visible = true })
	end,
	clear_effects = function(_, p)
		clearEffects(p)
	end,
	fling = function(_, p)
		local r = root(p)
		if r then
			r.AssemblyLinearVelocity = Vector3.new(math.random(-40, 40), 110, math.random(-40, 40))
		end
	end,
	sit = function(_, p)
		local h = hum(p)
		if h then
			h.Sit = true
		end
	end,
	respawn = function(_, p)
		p:LoadCharacter()
		if G.state.players[p] then
			task.wait(0.5)
			G.teleport(p, Builder.points.yard)
		end
	end,
	glow = function(_, p)
		effect(p, "Highlight", { FillColor = Color3.fromRGB(255, 220, 120), FillTransparency = 0.6, OutlineColor = Color3.fromRGB(255, 240, 200) })
	end,
	mute = function(_, p)
		local info = G.state.players[p]
		if info then
			info.muted = true
		end
		local s = chatSource(p)
		if s then
			s.CanSend = false
		end
	end,
	unmute = function(_, p)
		local info = G.state.players[p]
		if info then
			info.muted = false
		end
		local s = chatSource(p)
		if s then
			s.CanSend = true
		end
	end,
	explode = function(_, p)
		local r = root(p)
		if r then
			local e = Instance.new("Explosion")
			e.Position = r.Position
			e.BlastPressure = 0
			e.DestroyJointRadiusPercent = 0
			e.BlastRadius = 6
			e.Parent = workspace
			r.AssemblyLinearVelocity = Vector3.new(0, 60, 0)
		end
	end,
	-- силы Бога для одного игрока
	smite = function(_, p)
		local r = root(p)
		if not r then
			return
		end
		local bolt = Instance.new("Part")
		bolt.Anchored = true
		bolt.CanCollide = false
		bolt.Material = Enum.Material.Neon
		bolt.Color = Color3.fromRGB(220, 230, 255)
		bolt.Size = Vector3.new(1.2, 300, 1.2)
		bolt.CFrame = CFrame.new(r.Position + Vector3.new(0, 150, 0))
		bolt.Parent = workspace
		Debris:AddItem(bolt, 0.4)
		fxAll("lightning")
		local h = hum(p)
		if h and not Access.isCreator(p) then
			h.Health = 0
		end
	end,
	bless = function(_, p)
		local h = hum(p)
		if h then
			h.Health = h.MaxHealth
			h.WalkSpeed = 26
			task.delay(20, function()
				if h.Parent then
					h.WalkSpeed = 16
				end
			end)
		end
		local info = G.state.players[p]
		if info then
			info.food, info.drink = Rules.MAX, Rules.MAX
			G.sync(p)
		end
		effect(p, "Sparkles", { SparkleColor = Color3.fromRGB(255, 240, 160) })
	end,
	levitate = function(_, p)
		local r = root(p)
		if not r then
			return
		end
		local att = Instance.new("Attachment")
		att.Parent = r
		local lv = Instance.new("LinearVelocity")
		lv.Attachment0 = att
		lv.MaxForce = 1e6
		lv.VectorVelocity = Vector3.new(0, 8, 0)
		lv.Parent = r
		Debris:AddItem(lv, 4)
		Debris:AddItem(att, 4)
	end,
	holy_light = function(_, p)
		local r = root(p)
		if not r then
			return
		end
		local beam = Instance.new("Part")
		beam.Shape = Enum.PartType.Cylinder
		beam.Anchored = true
		beam.CanCollide = false
		beam.CanQuery = false
		beam.Material = Enum.Material.Neon
		beam.Color = Color3.fromRGB(255, 244, 200)
		beam.Transparency = 0.45
		beam.Size = Vector3.new(400, 8, 8)
		beam.CFrame = CFrame.new(r.Position + Vector3.new(0, 196, 0)) * CFrame.Angles(0, 0, math.pi / 2)
		local l = Instance.new("PointLight")
		l.Range = 30
		l.Brightness = 3
		l.Color = Color3.fromRGB(255, 240, 200)
		l.Parent = beam
		beam.Parent = workspace
		Debris:AddItem(beam, 8)
		local h = hum(p)
		if h then
			h.Health = h.MaxHealth
		end
	end,
	resurrect = function(_, p)
		local r = root(p)
		local where = if r then r.CFrame else nil
		p:LoadCharacter()
		if where then
			task.wait(0.3)
			G.teleport(p, where + Vector3.new(0, 3, 0))
		end
		effect(p, "Sparkles", { SparkleColor = Color3.fromRGB(255, 240, 160) })
	end,
}

function Admin.isAdmin(p: Player): boolean
	return Access.isCreator(p)
end

function Admin.run(admin: Player, id: any, targetUserId: any, arg: any)
	if not Admin.isAdmin(admin) then
		return { ok = false, error = "forbidden" }
	end
	local cmd = type(id) == "string" and Commands.BY_ID[id]
	if not cmd then
		return { ok = false, error = "unknown" }
	end
	if type(arg) == "string" and #arg &gt; 200 then
		return { ok = false, error = "arg" }
	end
	if type(cmd.arg) == "table" and not table.find(cmd.arg, arg) then
		return { ok = false, error = "arg" }
	end
	if cmd.target == "none" then
		local ok = WORLD[id](admin, arg)
		return { ok = ok ~= false }
	end
	local target = if type(targetUserId) == "number" then Players:GetPlayerByUserId(targetUserId) else nil
	if not target then
		return { ok = false, error = "player" }
	end
	local fn = PLAYER[id]
	if not fn then
		return { ok = false, error = "unknown" }
	end
	fn(admin, target, arg)
	return { ok = true }
end

function Admin.init()
	-- каждая команда списка должна иметь исполнителя
	for _, c in Commands.LIST do
		local fn = if c.target == "none" then WORLD[c.id] else PLAYER[c.id]
		if not fn then
			warn("[Castle] admin command without handler: " .. c.id)
		end
	end
	Remotes.fn("AdminRequest").OnServerInvoke = function(p: Player, action: any, ...)
		if action == "Status" then
			return { ok = true, admin = Admin.isAdmin(p) }
		elseif action == "Run" then
			local ok, res = pcall(Admin.run, p, ...)
			if not ok then
				warn("[Castle] admin: " .. tostring(res))
				return { ok = false, error = "server_error" }
			end
			return res
		end
		return { ok = false, error = "unknown" }
	end
	Players.PlayerRemoving:Connect(function(p)
		hidden[p] = nil
	end)
end

return Admin
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX0000002F">
          <Properties>
            <string name="Name">CastleBuilder</string>
            <ProtectedString name="Source">--!nonstrict
-- Постройка «The Castle». Замок стоит на парящем каменном острове посреди пустоты.
-- Главное здание 224 × 224 studs: подземный ярус и три этажа, на каждом сетка 7 × 7
-- клеток по 32 studs (план — CastleLayout). Стены, двери, окна, полы и потолки строятся
-- по плану, комнаты обставляются модулем Rooms. Отдельно строятся тронный зал с тайным
-- ходом, огромная подземная библиотека, тюрьма с работами, двор и крепостная стена

local Lighting = game:GetService("Lighting")

local Shared = game:GetService("ReplicatedStorage").Workshop.Shared
local Layout = require(Shared.CastleLayout)
local Props = require(script.Parent.Props)
local Rooms = require(script.Parent.Rooms)

local B = {}

local rgb = Props.rgb
local P, C, S = Props.P, Props.C, Props.S
local M = Enum.Material

local CELL, N, H = Layout.C, Layout.N, Layout.H
local HALF = Layout.HALF -- 112
local ISLAND = 176
local LV = Layout.LEVELS
local ROOF = LV.F2 + H -- 54

local FACADE = rgb(150, 144, 134)
local FACADE_DARK = rgb(108, 103, 97)
local CEIL = rgb(214, 204, 188)
local ROCK = rgb(92, 84, 76)

local root: Folder
local prompts = {}
B.prompts = prompts
B.points = {}

-- Кнопка взаимодействия; kind — смысл (CastleGame вешает действие по kind)
local function prompt(at: Instance?, kind: string, holdTime: number?, dist: number?)
	if not at then
		return nil
	end
	local p = Instance.new("ProximityPrompt")
	p.Name = kind
	p.ActionText = ""
	p.ObjectText = ""
	p.HoldDuration = holdTime or 0
	p.MaxActivationDistance = dist or 9
	p.RequiresLineOfSight = false
	p:SetAttribute("Kind", kind)
	p.Parent = at
	prompts[kind] = prompts[kind] or {}
	table.insert(prompts[kind], p)
	return p
end
B.prompt = prompt

local function box(parent, name, x0, y0, z0, x1, y1, z1, color, mat, extra)
	if math.abs(x1 - x0) &lt; 0.01 or math.abs(y1 - y0) &lt; 0.01 or math.abs(z1 - z0) &lt; 0.01 then
		return nil
	end
	return P(parent, name, Vector3.new(math.abs(x1 - x0), math.abs(y1 - y0), math.abs(z1 - z0)), CFrame.new((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2), color, mat or M.Slate, extra)
end
B.box = box

-- плита с прямоугольными дырами { x0, x1, z0, z1 } (не пересекающимися)
local function slab(parent, name, x0, x1, z0, z1, y0, y1, holes, color, mat, extra)
	if not holes or #holes == 0 then
		return box(parent, name, x0, y0, z0, x1, y1, z1, color, mat, extra)
	end
	local xs = { x0, x1 }
	for _, h in holes do
		table.insert(xs, math.clamp(h[1], x0, x1))
		table.insert(xs, math.clamp(h[2], x0, x1))
	end
	table.sort(xs)
	for k = 1, #xs - 1 do
		local a, b = xs[k], xs[k + 1]
		if b - a &gt; 0.01 then
			local mid = (a + b) / 2
			local zs = { { z0, z1 } }
			for _, h in holes do
				if mid &gt; h[1] and mid &lt; h[2] then
					local nz = {}
					for _, seg in zs do
						if h[4] &lt;= seg[1] or h[3] &gt;= seg[2] then
							table.insert(nz, seg)
						else
							if h[3] &gt; seg[1] then
								table.insert(nz, { seg[1], h[3] })
							end
							if h[4] &lt; seg[2] then
								table.insert(nz, { h[4], seg[2] })
							end
						end
					end
					zs = nz
				end
			end
			for _, seg in zs do
				box(parent, name, a, y0, seg[1], b, y1, seg[2], color, mat, extra)
			end
		end
	end
	return nil
end
B.slab = slab

-- Стена в плоскости: axis "x" — плоскость X = plane (стена тянется вдоль Z), "z" — наоборот.
-- holes: { c, w, bottom, top } — проёмы вдоль стены
local function rect(parent, name, axis, plane, thick, a0, a1, y0, y1, holes, color, mat, extra)
	local function piece(a, b, ya, yb)
		if b - a &lt; 0.01 or yb - ya &lt; 0.01 then
			return
		end
		if axis == "x" then
			box(parent, name, plane - thick / 2, ya, a, plane + thick / 2, yb, b, color, mat, extra)
		else
			box(parent, name, a, ya, plane - thick / 2, b, yb, plane + thick / 2, color, mat, extra)
		end
	end
	local hs = {}
	for _, h in holes or {} do
		table.insert(hs, h)
	end
	table.sort(hs, function(p, q)
		return p[1] &lt; q[1]
	end)
	local a = a0
	for _, h in hs do
		local h0, h1 = math.max(a0, h[1] - h[2] / 2), math.min(a1, h[1] + h[2] / 2)
		piece(a, h0, y0, y1)
		piece(h0, h1, y0, math.min(y1, h[3]))
		piece(h0, h1, math.max(y0, h[4]), y1)
		a = h1
	end
	piece(a, a1, y0, y1)
end
B.rect = rect

-- Факел на стене. cf — точка на стене, LookVector от стены
local function torch(parent, cf: CFrame)
	local m = Props.model(parent, "Torch")
	P(m, "Bracket", Vector3.new(0.5, 0.5, 1.2), cf * CFrame.new(0, 0, -0.6), Props.IRON, M.Metal, { CanCollide = false })
	local stick = P(m, "Stick", Vector3.new(0.35, 2, 0.35), cf * CFrame.new(0, 0.5, -1.2) * CFrame.Angles(math.rad(-20), 0, 0), Props.WOOD_DARK, M.Wood, { CanCollide = false })
	local head = P(m, "Flame", Vector3.new(0.5, 0.5, 0.5), stick.CFrame * CFrame.new(0, 1.1, 0), rgb(255, 150, 60), M.Neon, { CanCollide = false })
	local fire = Instance.new("Fire")
	fire.Size = 2.5
	fire.Heat = 6
	fire.Color = rgb(255, 140, 50)
	fire.SecondaryColor = rgb(255, 60, 20)
	fire.Parent = head
	Props.light(head, 20, 1.5, rgb(255, 160, 80))
	return m
end
B.torch = torch

-- ---------------------------------------------------------------------------
-- клетки и план

local function cellCenter(i, j)
	return (i - 3) * CELL, (j - 3) * CELL
end

local plans = {}
local function roomAt(level, i, j)
	if i &lt; 0 or i &gt; 6 or j &lt; 0 or j &gt; 6 then
		return "out", false
	end
	local id = plans[level].grid[i][j]
	if id == "void" then
		-- пустая клетка над залом двойной высоты принадлежит залу снизу
		local gid = plans.G.grid[i][j]
		return plans.G.rooms[gid], true
	end
	return plans[level].rooms[id], false
end

-- полоса лестницы внутри клетки: на первом этаже вдоль западной стены (подъём на север),
-- на втором — вдоль восточной (подъём на юг); спуски — у наружной стены
local function stairStrip(level, cx, cz, kind)
	local west = (level == "G" and kind == "stairs") or (kind == "stairs_down" and cx &lt; 0)
	-- у наружной стены (толщина 2) полоса отодвинута, чтобы ступени не входили в стену
	local inset = if math.abs(cx) &gt; 90 then 1.5 else 0
	if west then
		return cx - 15.5 + inset, cx - 9.5 + inset, true
	end
	return cx + 9.5 - inset, cx + 15.5 - inset, false
end

local function buildFlight(parent, x0, x1, zTop, zDir, yTop, yBottom, steps, color)
	-- ступени от верхнего края (zTop, yTop) по направлению zDir, каждая 1.5 в длину
	local rise = (yTop - yBottom) / steps
	for k = 0, steps - 1 do
		local za = zTop + zDir * k * 1.5
		local zb = za + zDir * 1.5
		local top = yTop - k * rise
		box(parent, "Step", x0, yBottom, math.min(za, zb), x1, top, math.max(za, zb), color, M.Marble)
		box(parent, "StepCarpet", x0 + 0.8, top, math.min(za, zb) + 0.05, x1 - 0.8, top + 0.08, math.max(za, zb) - 0.05, rgb(120, 22, 30), M.Fabric, { CanCollide = false })
	end
end

-- ---------------------------------------------------------------------------
-- остров в пустоте

local function island(parent)
	local m = Props.model(parent, "Island")
	local ground = rgb(120, 116, 110)
	local grotto = { 147, 157, 93, 99 }
	slab(m, "Ground", -ISLAND, ISLAND, -ISLAND, -HALF, -2, 0, nil, ground, M.Cobblestone)
	slab(m, "Ground", -ISLAND, ISLAND, HALF, ISLAND, -2, 0, nil, ground, M.Cobblestone)
	slab(m, "Ground", -ISLAND, -HALF, -HALF, HALF, -2, 0, nil, ground, M.Cobblestone)
	slab(m, "Ground", HALF, ISLAND, -HALF, HALF, -2, 0, { grotto }, ground, M.Cobblestone)
	-- скальная «юбка» по краю и толща под двором
	for _, s in { { -ISLAND, ISLAND, -ISLAND, -ISLAND + 6 }, { -ISLAND, ISLAND, ISLAND - 6, ISLAND }, { -ISLAND, -ISLAND + 6, -ISLAND, ISLAND }, { ISLAND - 6, ISLAND, -ISLAND, ISLAND } } do
		box(m, "Cliff", s[1], -26, s[3], s[2], -2, s[4], ROCK, M.Rock)
	end
	slab(m, "Bedrock", -ISLAND, ISLAND, -ISLAND, ISLAND, -60, -26, { { -HALF, HALF, -HALF, HALF } }, ROCK, M.Rock)
	box(m, "Bedrock", -HALF, -60, -HALF, HALF, -56, HALF, ROCK, M.Rock)
	-- низ острова: сужающиеся каменные пласты, как парящая скала
	local layers = { { 330, -60, -74 }, { 280, -74, -90 }, { 220, -90, -108 }, { 160, -108, -126 }, { 104, -126, -144 }, { 56, -144, -160 }, { 20, -160, -172 } }
	for k, l in ipairs(layers) do
		local w = l[1]
		P(m, "Underside", Vector3.new(w, l[2] - l[3], w * 0.92), CFrame.new(math.sin(k) * 6, (l[2] + l[3]) / 2, math.cos(k) * 6) * CFrame.Angles(0, k * 0.4, 0), ROCK:Lerp(rgb(60, 54, 50), k / 8), M.Rock)
		for q = 0, 5 do
			local a = q / 6 * math.pi * 2 + k
			local r = w * 0.42
			P(m, "Crag", Vector3.new(w * 0.22, (l[2] - l[3]) * 1.4, w * 0.18), CFrame.new(math.cos(a) * r, l[3] + 2, math.sin(a) * r) * CFrame.Angles(0.3, a, 0.2), ROCK:Lerp(rgb(70, 64, 58), (q % 3) / 3), M.Rock)
		end
	end
	-- корни и мох по краям
	for q = 0, 23 do
		local a = q / 24 * math.pi * 2
		local r = ISLAND - 2
		local x, z = math.clamp(math.cos(a) * r * 1.4, -r, r), math.clamp(math.sin(a) * r * 1.4, -r, r)
		P(m, "Root", Vector3.new(0.8, 10 + (q % 4) * 4, 0.8), CFrame.new(x, -31 - (q % 4) * 2, z) * CFrame.Angles(0.1 * (q % 3), 0, 0.1), rgb(70, 52, 36), M.Wood, { CanCollide = false })
	end
	return m
end

-- ---------------------------------------------------------------------------
-- стены, двери, окна, отделка

local function faceDecor(parent, axis, plane, normal, a0, a1, y0, y1, style, holes, opts)
	-- plane — поверхность стены, normal (+1/-1) — куда смотрит комната
	if style.bare then
		return
	end
	local function layer(thick, ya, yb, color, mat, name)
		if yb &lt;= ya then
			return
		end
		rect(parent, name, axis, plane + normal * thick / 2, thick, a0, a1, ya, yb, holes, color, mat, { CanCollide = false, CanQuery = false })
	end
	local paperFrom = y0
	if opts.wainscot then
		layer(0.25, y0, y0 + 4.4, Props.WOOD_DARK, M.Wood, "Wainscot")
		layer(0.42, y0 + 4.4, y0 + 4.8, Props.WOOD, M.Wood, "ChairRail")
		layer(0.32, y0, y0 + 0.6, rgb(36, 24, 18), M.Wood, "Baseboard")
		paperFrom = y0 + 4.8
	end
	layer(0.1, paperFrom, y1, style.paper, M.Fabric, "Wallpaper")
	if opts.cornice then
		layer(0.6, y1 - 1.2, y1, CEIL:Lerp(rgb(0, 0, 0), 0.12), M.SmoothPlastic, "Cornice")
	end
end

local function styleOf(room)
	if not room or room == "out" then
		return { bare = true }
	end
	local st = Rooms.style(room.kind)
	if room.level == "U" then
		return { bare = true, floor = st.floor, mat = st.mat }
	end
	return st
end

local doorsAt = {}
local extraOpenings = {}

local function edgeKey(level, i, j, axis)
	return level .. ":" .. i .. "," .. j .. axis
end

-- Все стены одного яруса
local function buildWalls(parent, level, decor)
	local y = LV[level]
	local y0, y1 = y - 1, y + H - 1
	local function interior(i, j, axis)
		local a, voidA = roomAt(level, i, j)
		local ni, nj = if axis == "x" then i + 1 else i, if axis == "z" then j + 1 else j
		local b, voidB = roomAt(level, ni, nj)
		if a == b then
			return
		end
		local cx, cz = cellCenter(i, j)
		local plane = if axis == "x" then cx + CELL / 2 else cz + CELL / 2
		local along = if axis == "x" then cz else cx
		local holes = {}
		local door = doorsAt[edgeKey(level, i, j, axis)]
		local extra = extraOpenings[edgeKey(level, i, j, axis)]
		local dw, dh = 0, 0
		if door then
			dw, dh = if door.wide then 10 else 6, if door.wide then 14 else 10
			table.insert(holes, { along, dw, y - 2, y + dh })
		elseif extra then
			dw, dh = extra.w, extra.h
			table.insert(holes, { along, dw, y - 2, y + dh })
		end
		rect(parent, "Wall", axis, plane, 1, along - CELL / 2, along + CELL / 2, y0, y1, holes, rgb(160, 152, 140), if level == "U" then M.Cobblestone else M.Slate)
		local dHoles = {}
		if door or extra then
			table.insert(dHoles, { along, dw + 1.8, y - 2, y + dh + 1.2 })
		end
		local tallA = type(a) == "table" and a.tall and not voidA
		local tallB = type(b) == "table" and b.tall and not voidB
		faceDecor(decor, axis, plane - 0.5, -1, along - CELL / 2, along + CELL / 2, if voidA then y0 else y, y1, styleOf(a), dHoles, { wainscot = not voidA, cornice = not tallA })
		faceDecor(decor, axis, plane + 0.5, 1, along - CELL / 2, along + CELL / 2, if voidB then y0 else y, y1, styleOf(b), dHoles, { wainscot = not voidB, cornice = not tallB })
		if door then
			local pos = if axis == "x" then Vector3.new(plane, y, along) else Vector3.new(along, y, plane)
			local n = if axis == "x" then Vector3.xAxis else Vector3.zAxis
			Props.door(decor, CFrame.lookAt(pos, pos + n), dw, dh, nil, door.wide)
		end
	end
	local function exterior(i, j, dir: Vector3)
		local a, voidA = roomAt(level, i, j)
		local cx, cz = cellCenter(i, j)
		local axis = if dir.X ~= 0 then "x" else "z"
		local sign = if axis == "x" then dir.X else dir.Z
		local edge = if axis == "x" then cx + sign * CELL / 2 else cz + sign * CELL / 2
		local plane = edge - sign * 1
		local along = if axis == "x" then cz else cx
		local holes = {}
		local windowAt = nil
		local extra = extraOpenings[edgeKey(level, i, j, axis .. (if sign &gt; 0 then "+" else "-"))]
		if extra then
			table.insert(holes, { along, extra.w, y - 2, y + extra.h })
		elseif level ~= "U" and type(a) == "table" and a.kind ~= "stairs" and a.kind ~= "stairs_down" then
			windowAt = y + 8
			table.insert(holes, { along, 5, y + 4, y + 12 })
		end
		rect(parent, "OuterWall", axis, plane, 2, along - CELL / 2, along + CELL / 2, y0, y1, holes, FACADE, M.Slate)
		local dHoles = {}
		if windowAt then
			table.insert(dHoles, { along, 7, y + 3.4, y + 12.8 })
		elseif extra then
			table.insert(dHoles, { along, extra.w + 1.8, y - 2, y + extra.h + 1.2 })
		end
		local st = styleOf(a)
		local tallA = type(a) == "table" and a.tall and not voidA
		faceDecor(decor, axis, plane - sign * 1, -sign, along - CELL / 2, along + CELL / 2, if voidA then y0 else y, y1, st, dHoles, { wainscot = not voidA, cornice = not tallA })
		local out = if axis == "x" then Vector3.new(sign, 0, 0) else Vector3.new(0, 0, sign)
		if windowAt then
			local pos = if axis == "x" then Vector3.new(plane, windowAt, along) else Vector3.new(along, windowAt, plane)
			Props.window(decor, CFrame.lookAt(pos, pos + out), 5, 8, 2)
			if not st.bare then
				Props.curtains(decor, CFrame.lookAt(pos - out * 1.1, pos - out * 2), 5, 8, st.rug or rgb(120, 22, 30))
			end
		end
		if extra and extra.door then
			local pos = if axis == "x" then Vector3.new(plane, y, along) else Vector3.new(along, y, plane)
			Props.door(decor, CFrame.lookAt(pos, pos + out), extra.w, extra.h, Props.WOOD_DARK, true)
		end
	end
	for i = 0, 6 do
		for j = 0, 6 do
			if i &lt; 6 then
				interior(i, j, "x")
			end
			if j &lt; 6 then
				interior(i, j, "z")
			end
			if i == 0 then
				exterior(i, j, Vector3.new(-1, 0, 0))
			end
			if i == 6 then
				exterior(i, j, Vector3.new(1, 0, 0))
			end
			if j == 0 then
				exterior(i, j, Vector3.new(0, 0, -1))
			end
			if j == 6 then
				exterior(i, j, Vector3.new(0, 0, 1))
			end
		end
	end
end

-- Описание комнаты для обстановки: границы, клетки и участки стен со слотами
local function roomInfo(level, room)
	local y = LV[level]
	local info = { kind = room.kind, id = room.id, level = level, y = y, h = if room.tall then 2 * H - 1 else H - 1, cells = {}, segs = {} }
	local cells = room.cells or {}
	if #cells == 0 then
		for i = room.i0, room.i1 do
			for j = room.j0, room.j1 do
				table.insert(cells, { i, j })
			end
		end
	end
	local x0, x1, z0, z1 = math.huge, -math.huge, math.huge, -math.huge
	for _, c in cells do
		local cx, cz = cellCenter(c[1], c[2])
		table.insert(info.cells, { x = cx, z = cz, i = c[1], j = c[2] })
		x0, x1 = math.min(x0, cx - CELL / 2 + 0.5), math.max(x1, cx + CELL / 2 - 0.5)
		z0, z1 = math.min(z0, cz - CELL / 2 + 0.5), math.max(z1, cz + CELL / 2 - 0.5)
		for _, d in { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
			local ni, nj = c[1] + d[1], c[2] + d[2]
			local other = roomAt(level, ni, nj)
			if other ~= room then
				local outside = other == "out"
				local inset = if outside then 2 else 0.5
				local n = Vector3.new(-d[1], 0, -d[2])
				local pos = Vector3.new(cx + d[1] * (CELL / 2 - inset), y, cz + d[2] * (CELL / 2 - inset))
				local axis = if d[1] ~= 0 then "x" else "z"
				local ei, ej = c[1], c[2]
				if d[1] &lt; 0 or d[2] &lt; 0 then
					ei, ej = ni, nj
				end
				local opening = nil
				if outside then
					if extraOpenings[edgeKey(level, c[1], c[2], axis .. (if d[1] + d[2] &gt; 0 then "+" else "-"))] then
						opening = "door"
					elseif level ~= "U" then
						opening = "window"
					end
				elseif doorsAt[edgeKey(level, ei, ej, axis)] or extraOpenings[edgeKey(level, ei, ej, axis)] then
					opening = "door"
				end
				table.insert(info.segs, { pos = pos, inward = n, tangent = Vector3.new(n.Z, 0, -n.X), opening = opening })
			end
		end
	end
	info.x0, info.x1, info.z0, info.z1 = x0, x1, z0, z1
	return info
end

-- Полы, потолки, лестницы и обстановка одного яруса
local function buildLevel(parent, level, ctx)
	local y = LV[level]
	local plan = plans[level]
	local floors = Props.model(parent, "Floors")
	local decor = Props.model(parent, "Decor")
	buildWalls(parent, level, decor)
	for i = 0, 6 do
		for j = 0, 6 do
			local room, void = roomAt(level, i, j)
			local cx, cz = cellCenter(i, j)
			local holes = {}
			-- дыра над лестницей с нижнего яруса
			local below, belowLevel = nil, nil
			if level == "F1" then
				below, belowLevel = plans.G.rooms[plans.G.grid[i][j]], "G"
			elseif level == "F2" then
				local id = plans.F1.grid[i][j]
				below, belowLevel = (if id ~= "void" then plans.F1.rooms[id] else nil), "F1"
			end
			if below and below.kind == "stairs" then
				local sx0, sx1 = stairStrip(belowLevel, cx, cz, "stairs")
				table.insert(holes, { sx0, sx1, cz - 13.5, cz + 13.5 })
			end
			if room and not void and room.kind == "stairs_down" then
				local sx0, sx1 = stairStrip(level, cx, cz, "stairs_down")
				table.insert(holes, { sx0, sx1, cz - 13.5, cz + 13.5 })
			end
			if type(room) == "table" and not void and not room.special then
				local st = styleOf(room)
				slab(floors, "Floor", cx - CELL / 2, cx + CELL / 2, cz - CELL / 2, cz + CELL / 2, y - 1, y, holes, st.floor or rgb(110, 104, 98), st.mat or M.Slate)
				-- потолок: светлая штукатурка (или камень в подвале), балки или кессоны
				local ceilY = y + (if room.tall then 2 * H else H) - 1
				local ceilHoles = {}
				local aboveDown = level == "U" and plans.G.rooms[plans.G.grid[i][j]].kind == "stairs_down"
				if room.kind == "stairs" then
					local sx0, sx1 = stairStrip(level, cx, cz, "stairs")
					table.insert(ceilHoles, { sx0, sx1, cz - 13.5, cz + 13.5 })
				elseif aboveDown then
					local sx0, sx1 = stairStrip("G", cx, cz, "stairs_down")
					table.insert(ceilHoles, { sx0, sx1, cz - 13.5, cz + 13.5 })
				end
				slab(floors, "Ceiling", cx - CELL / 2, cx + CELL / 2, cz - CELL / 2, cz + CELL / 2, ceilY - 0.25, ceilY, ceilHoles, if level == "U" then rgb(90, 86, 80) else CEIL, if level == "U" then M.Cobblestone else M.SmoothPlastic, { CanCollide = false })
				local k = room.kind
				if aboveDown then
					local _ = 0
				elseif level == "U" or k == "kitchen" or k == "barracks" or k == "servants" or k == "training" then
					for b = -1, 1 do
						box(floors, "Beam", cx - CELL / 2, ceilY - 1.4, cz + b * 10 - 0.6, cx + CELL / 2, ceilY - 0.25, cz + b * 10 + 0.6, if level == "U" then rgb(80, 76, 70) else Props.WOOD_DARK, if level == "U" then M.Slate else M.Wood, { CanCollide = false })
					end
				elseif k ~= "stairs" and k ~= "hall" and k ~= "stairs_down" then
					for b = -1, 1, 2 do
						box(floors, "Coffer", cx - CELL / 2, ceilY - 0.9, cz + b * 8 - 0.4, cx + CELL / 2, ceilY - 0.25, cz + b * 8 + 0.4, CEIL:Lerp(rgb(0, 0, 0), 0.1), M.SmoothPlastic, { CanCollide = false })
						box(floors, "Coffer", cx + b * 8 - 0.4, ceilY - 0.9, cz - CELL / 2, cx + b * 8 + 0.4, ceilY - 0.25, cz + CELL / 2, CEIL:Lerp(rgb(0, 0, 0), 0.1), M.SmoothPlastic, { CanCollide = false })
					end
				end
			end
			-- лестницы
			if type(room) == "table" and not void and (room.kind == "stairs" or room.kind == "stairs_down") then
				local sx0, sx1, west = stairStrip(level, cx, cz, room.kind)
				local col = rgb(196, 188, 176)
				local inner = if west then sx1 else sx0
				local ang = math.atan2(H, 27)
				if room.kind == "stairs" then
					if west then
						buildFlight(decor, sx0, sx1, cz + 13.5, -1, y + H, y, 18, col)
					else
						buildFlight(decor, sx0, sx1, cz - 13.5, 1, y + H, y, 18, col)
					end
					local tilt = if west then -ang else ang
					P(decor, "StairRail", Vector3.new(0.5, 0.35, 32.4), CFrame.new(inner, y + H / 2 + 3.4, cz) * CFrame.Angles(tilt, 0, 0), Props.WOOD_DARK, M.Wood)
				else
					buildFlight(decor, sx0, sx1, cz + 13.5, -1, y, y - H, 18, col)
					P(decor, "StairRail", Vector3.new(0.5, 0.35, 32.4), CFrame.new(inner, y - H / 2 + 3.4, cz) * CFrame.Angles(ang, 0, 0), Props.WOOD_DARK, M.Wood)
					Props.railing(decor, Vector3.new(inner, y, cz - 13.5), Vector3.new(inner, y, cz + 10))
					Props.railing(decor, Vector3.new(sx0, y, cz - 13.7), Vector3.new(sx1, y, cz - 13.7))
				end
			end
			if below and below.kind == "stairs" then
				local sx0, sx1, west = stairStrip(belowLevel, cx, cz, "stairs")
				local inner = if west then sx1 else sx0
				if west then
					Props.railing(decor, Vector3.new(inner, y, cz - 13.5), Vector3.new(inner, y, cz + 10))
					Props.railing(decor, Vector3.new(sx0, y, cz - 13.7), Vector3.new(sx1, y, cz - 13.7))
				else
					Props.railing(decor, Vector3.new(inner, y, cz - 10), Vector3.new(inner, y, cz + 13.5))
					Props.railing(decor, Vector3.new(sx0, y, cz + 13.7), Vector3.new(sx1, y, cz + 13.7))
				end
			end
		end
	end
	-- обстановка комнат
	for id, room in plan.rooms do
		local info = roomInfo(level, room)
		if room.kind == "hall" then
			for _, c in info.cells do
				local hx = (c.i &lt; 6 and plan.grid[c.i + 1][c.j] == id) or (c.i &gt; 0 and plan.grid[c.i - 1][c.j] == id)
				Rooms.hallCell(decor, c, info, ctx, hx == true)
			end
			Rooms.hallWalls(decor, info, id)
		elseif room.kind == "stairs" or room.kind == "stairs_down" or room.kind == "prison_guard" then
			local c = info.cells[1]
			local sx0 = stairStrip(level, c.x, c.z, if room.kind == "prison_guard" then "stairs_down" else room.kind)
			Props.ceilingLamp(decor, Vector3.new(c.x + (if sx0 &lt; c.x then 5 else -5), y + H - 3.5, c.z), 2.5)
			if room.kind == "prison_guard" then
				B.points.dungeon = CFrame.new(c.x + 5, y + 3, c.z + 6)
			end
		elseif not room.special then
			Rooms.decorate(decor, info, ctx)
		end
		room.info = info
	end
end

-- ---------------------------------------------------------------------------
-- тронный зал (G, клетки 2..4 × 4..6), тайный ход и сточный туннель

local function throneRoom(parent)
	local m = Props.model(parent, "ThroneRoom")
	local x0, x1, z0, z1 = -48, 48, 16, 112
	local hx0, hx1, hz0, hz1 = -5, 5, 95, 105
	local tx, tz = 0, 100
	slab(m, "Floor", x0, x1, z0, z1, -1, 0, { { hx0, hx1, hz0, hz1 } }, rgb(206, 198, 186), M.Marble)
	for gx = -4, 3 do
		for gz = 0, 7 do
			if (gx + gz) % 2 == 0 then
				box(m, "Tile", gx * 6, 0, 20 + gz * 6, gx * 6 + 6, 0.05, 26 + gz * 6, rgb(60, 56, 54), M.Marble, { CanCollide = false })
			end
		end
	end
	local ceilY = 2 * H - 1
	box(m, "Ceiling", x0, ceilY - 0.3, z0, x1, ceilY, z1, rgb(110, 30, 36), M.Fabric, { CanCollide = false })
	for k = 0, 5 do
		box(m, "Rib", x0, ceilY - 1.6, z0 + 8 + k * 16 - 0.7, x1, ceilY - 0.3, z0 + 8 + k * 16 + 0.7, Props.GOLD, M.Metal, { CanCollide = false })
	end
	Props.runner(m, CFrame.new(0, 0, 51), 8, 70, rgb(140, 20, 28))
	for _, sx in { -1, 1 } do
		for k = 0, 4 do
			Props.column(m, CFrame.new(sx * 30, 0, 24 + k * 14), ceilY, 2)
			Props.banner(m, CFrame.new(sx * 47.3, 28, 24 + k * 14) * CFrame.Angles(0, if sx &gt; 0 then math.pi / 2 else -math.pi / 2, 0), 16, if k % 2 == 0 then rgb(130, 20, 28) else rgb(30, 46, 110))
		end
		for k = 0, 3 do
			Props.sconce(m, CFrame.new(sx * 47.4, 10, 31 + k * 24) * CFrame.Angles(0, if sx &gt; 0 then math.pi / 2 else -math.pi / 2, 0), k % 2 == 0)
		end
	end
	for k = 0, 2 do
		Props.chandelier(m, Vector3.new(0, ceilY - 9, 34 + k * 26), 8, 8)
	end
	-- помост в две ступени с дырой под люк
	slab(m, "Dais", -20, 20, 86, 111, 0, 1.5, { { hx0, hx1, hz0, hz1 } }, rgb(150, 26, 34), M.Fabric)
	slab(m, "DaisStep", -17, 17, 90, 111, 1.5, 3, { { hx0, hx1, hz0, hz1 } }, rgb(206, 198, 186), M.Marble)
	for _, sx in { -1, 1 } do
		P(m, "DaisTrim", Vector3.new(0.4, 0.3, 25), CFrame.new(sx * 20, 1.6, 98.5), Props.GOLD, M.Metal, { CanCollide = false })
	end
	-- за троном огромный гобелен и витражи
	Props.banner(m, CFrame.new(0, 33, 109.8), 22, rgb(140, 20, 28))
	for _, x in { -18, 18 } do
		Props.stainedGlass(m, CFrame.new(x, 21, 109.8), 7, 14)
	end
	local hatch = box(m, "Hatch", hx0, -1, hz0, hx1, 3.02, hz1, rgb(206, 198, 186), M.Marble)
	B.hatch = hatch
	-- трон
	local throne = Instance.new("Model")
	throne.Name = "Throne"
	local seat = Instance.new("Seat")
	seat.Name = "ThroneSeat"
	seat.Anchored = true
	seat.Size = Vector3.new(4, 1, 4)
	seat.CFrame = CFrame.new(tx, 4.5, tz)
	seat.Color = rgb(150, 20, 30)
	seat.Material = M.Fabric
	seat.Disabled = true
	seat.Parent = throne
	P(throne, "ThroneBase", Vector3.new(5.4, 1.5, 5.4), CFrame.new(tx, 3.75, tz), Props.GOLD, M.Metal)
	P(throne, "ThroneBack", Vector3.new(5.4, 11, 1), CFrame.new(tx, 10, tz + 2.6), Props.GOLD, M.Metal)
	P(throne, "ThroneCushion", Vector3.new(4.2, 7.5, 0.4), CFrame.new(tx, 9.2, tz + 2), rgb(150, 20, 30), M.Fabric)
	for _, x in { -2.8, 2.8 } do
		P(throne, "Arm", Vector3.new(0.8, 2.5, 4.6), CFrame.new(tx + x, 5.6, tz), Props.GOLD, M.Metal)
		S(throne, "ArmKnob", 1, CFrame.new(tx + x, 7, tz - 2.3), Props.GOLD, M.Metal)
		C(throne, "Finial", 2.4, 0.6, CFrame.new(tx + x, 16.6, tz + 2.6), Props.GOLD, M.Metal)
	end
	S(throne, "Crest", 2.4, CFrame.new(tx, 16.4, tz + 2.6), Props.GOLD, M.Neon)
	for k = 0, 4 do
		S(throne, "Gem", 0.5, CFrame.new(tx - 1.6 + k * 0.8, 14.5, tz + 2.05), if k % 2 == 0 then rgb(200, 30, 50) else rgb(40, 90, 220), M.Neon)
	end
	throne.PrimaryPart = seat
	throne.Parent = m
	prompt(seat, "throne", 1, 10)
	prompt(throne:FindFirstChild("ThroneBack"), "passage", 1.5, 10)
	B.throne = throne
	B.throneSeat = seat
	B.throneHome = throne:GetPivot()
	B.throneSlide = Vector3.new(14, 0, 0)
	B.points.statueLeft = CFrame.new(-28, 1.5, 100)
	B.points.statueRight = CFrame.new(28, 1.5, 100)
	for _, x in { -28, 28 } do
		box(m, "StatueBase", x - 4, 0, 96, x + 4, 1.5, 104, rgb(220, 214, 204), M.Marble)
		box(m, "StatueBaseTrim", x - 4.3, 1.3, 95.7, x + 4.3, 1.6, 104.3, Props.GOLD, M.Metal)
	end
	B.points.throneRoom = CFrame.new(0, 3, 30)

	-- винтовая лестница в шахте под люком, вниз до сточного туннеля
	local sh = Props.model(parent, "SecretStair")
	local uy = LV.U
	local wc = rgb(90, 86, 80)
	box(sh, "ShaftWall", -5.5, uy - 1, 94.5, -5, -1, 105.5, wc, M.Cobblestone)
	box(sh, "ShaftWall", -5, uy - 1, 94.5, 5, -1, 95, wc, M.Cobblestone)
	box(sh, "ShaftWall", -5, uy - 1, 105, 5, -1, 105.5, wc, M.Cobblestone)
	-- восточная стенка с проходом в туннель внизу
	box(sh, "ShaftWall", 5, uy + 9, 94.5, 5.5, -1, 105.5, wc, M.Cobblestone)
	box(sh, "ShaftWall", 5, uy - 1, 94.5, 5.5, uy + 9, 97.5, wc, M.Cobblestone)
	box(sh, "ShaftWall", 5, uy - 1, 102.5, 5.5, uy + 9, 105.5, wc, M.Cobblestone)
	C(sh, "Newel", 3 - uy, 1.8, CFrame.new(tx, (3 + uy) / 2, tz), rgb(120, 114, 106), M.Slate)
	local steps = 28
	for k = 0, steps - 1 do
		local a = k * math.rad(22.5)
		local top = 3 - (k + 1) * (3 - uy) / steps
		P(sh, "SpiralStep", Vector3.new(3.9, 0.5, 1.9), CFrame.new(tx, top - 0.25, tz) * CFrame.Angles(0, a, 0) * CFrame.new(2.85, 0, 0), rgb(150, 144, 134), M.Slate)
		if k % 7 == 3 then
			local tp = (CFrame.new(tx, top + 5, tz) * CFrame.Angles(0, a + 0.4, 0) * CFrame.new(4.9, 0, 0)).Position
			torch(sh, CFrame.lookAt(tp, Vector3.new(tx, tp.Y, tz)))
		end
	end
	local lever = Props.model(sh, "Lever")
	P(lever, "Plate", Vector3.new(0.3, 1.8, 1.2), CFrame.new(5.6, uy + 4, 106.2), Props.IRON, M.Metal)
	local handle = P(lever, "Handle", Vector3.new(0.25, 2, 0.25), CFrame.new(6, uy + 4.8, 106.2) * CFrame.Angles(0, 0, math.rad(-25)), rgb(150, 150, 156), M.Metal)
	S(lever, "Grip", 0.6, CFrame.new(6.4, uy + 5.7, 106.2), rgb(120, 22, 30), M.SmoothPlastic)
	prompt(handle, "lever", 0.5)
	B.points.tunnel = CFrame.new(20, uy + 3, 96)
end

-- Сточный туннель (U, клетки 3..6 × 6) и выход в грот на краю острова
local function sewer(parent)
	local m = Props.model(parent, "Sewer")
	local uy = LV.U
	local x0, x1, z0, z1 = -15.5, HALF - 2, 80.5, 110
	box(m, "Floor", x0, uy - 1, z0, x1, uy, 93, rgb(86, 82, 76), M.Cobblestone)
	box(m, "Floor", x0, uy - 1, 99, x1, uy, z1, rgb(86, 82, 76), M.Cobblestone)
	box(m, "Floor", x0, uy - 1, 93, 8, uy, 99, rgb(86, 82, 76), M.Cobblestone)
	box(m, "Channel", 8, uy - 2.5, 93, x1, uy - 1, 99, rgb(60, 56, 52), M.Slate)
	box(m, "Water", 8, uy - 1.6, 93.1, x1, uy - 1.2, 98.9, rgb(70, 82, 60), M.Glass, { Transparency = 0.3, CanCollide = false })
	-- мостки над каналом
	for x = 20, x1 - 10, 24 do
		box(m, "Plank", x - 2, uy - 0.2, 93, x + 2, uy, 99, Props.WOOD, M.WoodPlanks)
	end
	-- арки-рёбра через каждые 8 studs, решётки, трубы, факелы
	for x = 12, x1 - 4, 8 do
		box(m, "Rib", x - 0.8, uy, z0, x + 0.8, -1.5, z0 + 1.5, rgb(110, 104, 96), M.Slate)
		box(m, "Rib", x - 0.8, uy, z1 - 1.5, x + 0.8, -1.5, z1, rgb(110, 104, 96), M.Slate)
		box(m, "Rib", x - 0.8, -3.2, z0, x + 0.8, -1.5, z1, rgb(110, 104, 96), M.Slate, { CanCollide = false })
		if (x - x0) % 24 &lt; 8 then
			torch(m, CFrame.new(x + 4, uy + 7, z0 + 0.1) * CFrame.Angles(0, math.pi, 0))
		end
		P(m, "Pipe", Vector3.new(8, 1.2, 1.2), CFrame.new(x - 4, uy + 12, z1 - 1.2), rgb(110, 80, 50), M.Metal, { CanCollide = false, Shape = Enum.PartType.Cylinder })
	end
	for k = 0, 8 do
		Props.barrel(m, CFrame.new(x0 + 26 + k * 10, uy, z0 + 3.5), k % 3 == 0)
	end
	-- туннель под двором и лестница наверх, в грот
	local t = Props.model(parent, "EscapeTunnel")
	local wc = rgb(90, 86, 80)
	box(t, "Floor", HALF, uy - 1, 93, 130, uy, 99, rgb(86, 82, 76), M.Cobblestone)
	box(t, "Wall", HALF, uy - 1, 92, 158, -2, 93, wc, M.Cobblestone)
	box(t, "Wall", HALF, uy - 1, 99, 158, -2, 100, wc, M.Cobblestone)
	box(t, "Ceiling", HALF, uy + 10, 93, 145, uy + 11, 99, rgb(80, 76, 70), M.Cobblestone)
	for k = 0, 17 do
		local xa = 130 + k * 1.5
		box(t, "Step", xa, uy - 1, 93, xa + 1.5, uy + (k + 1), 99, rgb(110, 104, 96), M.Slate)
	end
	torch(t, CFrame.new(121, uy + 6, 93.1))
	torch(t, CFrame.new(140, uy + 9, 98.9) * CFrame.Angles(0, math.pi, 0))
	-- грот: камни вокруг выхода, арка, плющ
	local g = Props.model(parent, "Grotto")
	for k = 0, 4 do
		for _, z in { 89.5, 102.5 } do
			S(g, "Rock", 5 + (k % 3) * 1.2, CFrame.new(145 + k * 3.2, 1.5 + (k % 2), z), ROCK:Lerp(rgb(130, 124, 116), (k % 4) / 5), M.Rock)
		end
	end
	P(g, "Arch", Vector3.new(12, 3, 16), CFrame.new(150, 8.5, 96), ROCK, M.Rock)
	for k = 0, 5 do
		P(g, "Ivy", Vector3.new(0.3, 4, 1.2), CFrame.new(156.2, 5, 91.5 + k * 1.8), rgb(60, 100, 50), M.Grass, { CanCollide = false })
	end
	B.points.tunnelExit = CFrame.new(163, 3, 96)
end

-- ---------------------------------------------------------------------------
-- огромная библиотека под главным залом (U, клетки 2..6 × 0..4, три яруса)

local function library(parent)
	local m = Props.model(parent, "Library")
	local x0, x1, z0, z1 = -47.5, HALF - 2, -HALF + 2, 47.5
	local fy = -54
	local G1, G2 = -36, LV.U
	local W = 12
	box(m, "Floor", x0, fy - 1, z0, x1, fy, z1, rgb(70, 64, 60), M.Slate)
	for gx = 0, 9 do
		for gz = 0, 9 do
			if (gx + gz) % 2 == 0 then
				box(m, "FloorTile", x0 + W + gx * 11.4, fy, z0 + W + gz * 11.4, x0 + W + gx * 11.4 + 11.4, fy + 0.04, z0 + W + gz * 11.4 + 11.4, rgb(96, 88, 80), M.Marble, { CanCollide = false })
			end
		end
	end
	-- стены от пола до верхней галереи (выше — стены подземного яруса)
	local wc, wm = rgb(84, 74, 66), M.Slate
	box(m, "Wall", x0 - 1, fy - 1, z0 - 1, x0, G2, z1 + 1, wc, wm)
	box(m, "Wall", x1, fy - 1, z0 - 1, x1 + 1, G2, z1 + 1, wc, wm)
	box(m, "Wall", x0, fy - 1, z0 - 1, x1, G2, z0, wc, wm)
	box(m, "Wall", x0, fy - 1, z1, x1, G2, z1 + 1, wc, wm)
	-- галереи: кольцо шириной 12 на двух уровнях, с проёмами под лестницы
	local flight1 = { x0 + 1, x0 + 7, -10, 17 } -- с верхней галереи на среднюю (запад)
	local flight2 = { x1 - 7, x1 - 1, -10, 17 } -- со средней на пол (восток)
	local inner = { x0 + W, x1 - W, z0 + W, z1 - W }
	for _, gy in { G1, G2 } do
		local holes = { inner, if gy == G2 then flight1 else flight2 }
		slab(m, "Gallery", x0, x1, z0, z1, gy - 1, gy, holes, rgb(96, 70, 50), M.Slate)
		Props.railing(m, Vector3.new(inner[1], gy, inner[3]), Vector3.new(inner[2], gy, inner[3]))
		Props.railing(m, Vector3.new(inner[1], gy, inner[4]), Vector3.new(inner[2], gy, inner[4]))
		Props.railing(m, Vector3.new(inner[1], gy, inner[3]), Vector3.new(inner[1], gy, inner[4]))
		Props.railing(m, Vector3.new(inner[2], gy, inner[3]), Vector3.new(inner[2], gy, inner[4]))
		local fl = if gy == G2 then flight1 else flight2
		Props.railing(m, Vector3.new(fl[2], gy, fl[3]), Vector3.new(fl[2], gy, fl[4] - 3))
	end
	for k = 0, 17 do
		box(m, "Step", flight1[1], G1, 17 - (k + 1) * 1.5, flight1[2], G2 - k, 17 - k * 1.5, rgb(110, 84, 60), M.Slate)
		box(m, "Step", flight2[1], fy, 17 - (k + 1) * 1.5, flight2[2], G1 - k, 17 - k * 1.5, rgb(110, 84, 60), M.Slate)
	end
	-- колонны по внутреннему краю галерей
	local dx = (inner[2] - inner[1]) / 5
	local dz = (inner[4] - inner[3]) / 5
	for k = 0, 5 do
		for _, z in { inner[3], inner[4] } do
			Props.column(m, CFrame.new(inner[1] + k * dx, fy, z), G2 - fy - 1, 1.3, rgb(120, 108, 96))
		end
	end
	for k = 1, 4 do
		for _, x in { inner[1], inner[2] } do
			Props.column(m, CFrame.new(x, fy, inner[3] + k * dz), G2 - fy - 1, 1.3, rgb(120, 108, 96))
		end
	end
	-- шкафы вдоль стен на всех трёх уровнях
	local seed = 1
	local function run(a0, a1, place)
		local a = a0
		while a + 8 &lt;= a1 do
			place(a + 4)
			a += 8.4
		end
	end
	local function wallShelves(level)
		run(z0 + 1, z1 - 1, function(z)
			local blocked = level ~= fy and z &gt; flight1[3] - 2 and z &lt; flight1[4] + 2 and false
			if not blocked then
				Props.bookshelf(m, CFrame.new(x0 + 1.1, level, z) * CFrame.Angles(0, -math.pi / 2, 0), 8, 14, seed, true)
			end
			seed += 1
		end)
		run(z0 + 1, z1 - 1, function(z)
			local blocked = level == G2 and z &gt; -48 and z &lt; -16
			if not blocked then
				Props.bookshelf(m, CFrame.new(x1 - 1.1, level, z) * CFrame.Angles(0, math.pi / 2, 0), 8, 14, seed, true)
			end
			seed += 1
		end)
		run(x0 + 3, x1 - 3, function(x)
			Props.bookshelf(m, CFrame.new(x, level, z0 + 1.1) * CFrame.Angles(0, math.pi, 0), 8, 14, seed, true)
			seed += 1
		end)
		run(x0 + 3, x1 - 3, function(x)
			local blocked = level == G2 and x &gt; 22 and x &lt; 42 -- дверь в погреб
			if not blocked then
				Props.bookshelf(m, CFrame.new(x, level, z1 - 1.1), 8, 14, seed, true)
			end
			seed += 1
		end)
	end
	wallShelves(fy)
	wallShelves(G1)
	wallShelves(G2)
	-- нижний зал: ряды двусторонних стеллажей на западе, читальный зал на востоке
	local midZ = (inner[3] + inner[4]) / 2
	for row = 0, 4 do
		local x = inner[1] + 8 + row * 9
		for k = 0, 9 do
			local z = inner[3] + 6 + k * 8.6
			if math.abs(z - midZ) &gt; 7 and z &lt; inner[4] - 6 then
				Props.bookshelf(m, CFrame.new(x - 1.05, fy, z) * CFrame.Angles(0, math.pi / 2, 0), 8, 12, seed, true)
				Props.bookshelf(m, CFrame.new(x + 1.05, fy, z) * CFrame.Angles(0, -math.pi / 2, 0), 8, 12, seed + 50, true)
				seed += 1
			end
		end
		P(m, "Ladder", Vector3.new(0.3, 12, 2), CFrame.new(x - 2.4, fy + 6, midZ + 9) * CFrame.Angles(0, 0, math.rad(-10)), Props.WOOD, M.Wood)
	end
	local cxm = (inner[1] + inner[2]) / 2
	local readX = cxm + 30
	Props.rug(m, CFrame.new(readX, fy, midZ), 30, 64, rgb(40, 60, 46))
	for row = -1, 1 do
		for col = 0, 1 do
			local cf = CFrame.new(readX - 7 + col * 14, fy, midZ + row * 20)
			Props.table(m, cf, 8, 4)
			for _, s in { -1, 1 } do
				for _, ox in { -2.2, 2.2 } do
					Props.chair(m, cf * CFrame.new(ox, 0, s * 3.4) * CFrame.Angles(0, if s &gt; 0 then 0 else math.pi, 0), rgb(40, 70, 50))
				end
			end
			for _, ox in { -2, 2 } do
				C(m, "LampFoot", 0.2, 0.6, cf * CFrame.new(ox, 3.45, 0), Props.GOLD, M.Metal, { CanCollide = false })
				C(m, "LampStem", 1, 0.12, cf * CFrame.new(ox, 4, 0), Props.GOLD, M.Metal, { CanCollide = false })
				local shade = P(m, "LampShade", Vector3.new(1.6, 0.5, 0.7), cf * CFrame.new(ox, 4.6, 0), rgb(40, 140, 80), M.Glass, { CanCollide = false, Transparency = 0.15 })
				if ox &lt; 0 then
					Props.light(shade, 12, 0.9, rgb(255, 230, 170))
				end
			end
			local book = P(m, "OpenBook", Vector3.new(2, 0.2, 1.4), cf * CFrame.new(0, 3.45, 0), rgb(245, 236, 210), M.SmoothPlastic)
			prompt(book, "book")
		end
	end
	Props.globe(m, CFrame.new(readX + 10, fy, inner[3] + 6))
	Props.grandfatherClock(m, CFrame.new(inner[2] - 3, fy, inner[4] - 3) * CFrame.Angles(0, math.pi * 0.75, 0))
	-- люстры и парящий жрец над круглой площадкой
	local px = cxm + 4
	for _, ox in { -30, 30 } do
		for _, oz in { -30, 30 } do
			Props.chandelier(m, Vector3.new(cxm + ox, -10, midZ + oz), 7, 8)
		end
	end
	Props.chandelier(m, Vector3.new(px, -10, midZ), 10, 8)
	C(m, "Dais", 1, 18, CFrame.new(px, fy + 0.5, midZ), rgb(150, 140, 126), M.Marble)
	C(m, "DaisRing", 1.1, 14, CFrame.new(px, fy + 0.55, midZ), rgb(120, 22, 30), M.Fabric)
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2
		Props.candelabra(m, Vector3.new(px + math.cos(a) * 7.5, fy + 1, midZ + math.sin(a) * 7.5))
	end
	B.points.priest = CFrame.new(px, fy + 12, midZ)
	B.points.library = CFrame.new(px, fy + 3, midZ + 14)
	for _, gy in { fy, G1, G2 } do
		for z = z0 + 24, z1 - 20, 40 do
			Props.sconce(m, CFrame.new(x0 + 2.3, gy + 15.5, z) * CFrame.Angles(0, -math.pi / 2, 0), true)
		end
	end
end

-- ---------------------------------------------------------------------------
-- тюрьма (U, клетки 0..1 × 3..6): камеры по краям, двор для работ, ворота с решёткой

local function prison(parent)
	local m = Props.model(parent, "Prison")
	local uy = LV.U
	local x0, x1, z0, z1 = -HALF + 2, -48 - 0.5, -16 + 0.5, HALF - 2
	box(m, "Floor", x0, uy - 1, z0, x1, uy, z1, rgb(80, 76, 70), M.Cobblestone)
	box(m, "Ceiling", x0, -1.4, z0, x1, -1, z1, rgb(70, 66, 62), M.Cobblestone, { CanCollide = false })
	B.cells = {}
	local cellDepth, cellW = 11, 9
	local n = math.floor((z1 - z0 - 14) / cellW)
	for side = 0, 1 do
		local wx = if side == 0 then x0 else x1
		local dir = if side == 0 then 1 else -1
		local front = wx + dir * cellDepth
		for k = 0, n - 1 do
			local za = z0 + 14 + k * cellW
			local zb = za + cellW
			box(m, "CellWall", math.min(wx, front), uy, za - 0.4, math.max(wx, front), uy + 12, za + 0.4, rgb(96, 90, 84), M.Slate)
			-- решётка с проходом посередине: узники свободно ходят по тюрьме, но не выходят из неё
			for b = 0, 7 do
				if b &lt; 3 or b &gt; 5 then
					P(m, "Bar", Vector3.new(0.35, 12, 0.35), CFrame.new(front, uy + 6, za + 0.8 + b * 1.05), Props.IRON, M.Metal)
				end
			end
			box(m, "BarTop", front - 0.3, uy + 11.5, za, front + 0.3, uy + 12, zb, Props.IRON, M.Metal)
			Props.bunk(m, CFrame.new(wx + dir * 2.2, uy, za + cellW / 2))
			Props.bucket(m, CFrame.new(wx + dir * 6.5, uy, zb - 1.2))
			P(m, "Chain", Vector3.new(0.2, 4, 0.2), CFrame.new(wx + dir * 0.4, uy + 8, za + cellW / 2 + 3), Props.IRON, M.Metal, { CanCollide = false })
			table.insert(B.cells, { inside = CFrame.new(wx + dir * (cellDepth - 3), uy + 3, za + cellW / 2) })
		end
		box(m, "CellWall", math.min(wx, front), uy, z0 + 14 + n * cellW - 0.4, math.max(wx, front), uy + 12, z0 + 14 + n * cellW + 0.4, rgb(96, 90, 84), M.Slate)
		box(m, "CellBlockTop", math.min(wx, front), uy + 12, z0 + 13.6, math.max(wx, front), uy + 12.6, z0 + 14.4 + n * cellW, rgb(96, 90, 84), M.Slate)
	end
	-- двор для работ: камень, точильные круги, стирка
	local yx0, yx1 = x0 + cellDepth + 2, x1 - cellDepth - 2
	local ymid = (yx0 + yx1) / 2
	B.points.prisonYard = CFrame.new(ymid, uy + 3, z0 + 10)
	local stations = { Props.rockPile, Props.grindstone, Props.washtub }
	local k = 0
	for z = z0 + 24, z1 - 14, 16 do
		for _, x in { yx0 + 5, yx1 - 5 } do
			k += 1
			local st = stations[k % 3 + 1](m, CFrame.new(x, uy, z))
			prompt(st:FindFirstChildWhichIsA("BasePart"), "work", 2, 10)
		end
	end
	for z = z0 + 32, z1 - 14, 32 do
		Props.crate(m, CFrame.new(ymid - 2, uy, z))
		Props.sack(m, CFrame.new(ymid + 2, uy, z + 1))
	end
	box(m, "Overseer", ymid - 5, uy, z1 - 9, ymid + 5, uy + 4, z1 - 1, Props.WOOD, M.WoodPlanks)
	Props.railing(m, Vector3.new(ymid - 5, uy + 4, z1 - 9), Vector3.new(ymid + 5, uy + 4, z1 - 9))
	for z = z0 + 18, z1 - 8, 24 do
		torch(m, CFrame.new(x0 + cellDepth + 0.25, uy + 9, z) * CFrame.Angles(0, math.pi / 2, 0))
		torch(m, CFrame.new(x1 - cellDepth - 0.25, uy + 9, z) * CFrame.Angles(0, -math.pi / 2, 0))
	end
	for _, z in { z0 + 40, z1 - 40 } do
		Props.ceilingLamp(m, Vector3.new(ymid, uy + 13, z), 2.5)
	end
	-- ворота: решётка в проёме между караульной и тюрьмой
	local gx, gz = -96, -16
	local gate = Props.model(m, "PrisonGate")
	for b = -3, 3 do
		P(gate, "GateBar", Vector3.new(0.4, 10, 0.4), CFrame.new(gx + b * 1.15, uy + 5, gz), Props.IRON, M.Metal)
	end
	for _, y in { uy + 1, uy + 5, uy + 9.6 } do
		P(gate, "GateRail", Vector3.new(8, 0.4, 0.4), CFrame.new(gx, y, gz), Props.IRON, M.Metal)
	end
	local lock = P(gate, "Lock", Vector3.new(1, 1.2, 0.8), CFrame.new(gx + 3, uy + 4.5, gz - 0.5), Props.GOLD, M.Metal)
	P(gate, "GateBlock", Vector3.new(8, 10, 1), CFrame.new(gx, uy + 5, gz), rgb(0, 0, 0), M.SmoothPlastic, { Transparency = 1 })
	prompt(lock, "prisongate", 0.8, 10)
	B.points.prisonInside = CFrame.new(gx, uy + 3, gz + 6)
	B.points.prisonOutside = CFrame.new(gx, uy + 3, gz - 6)
end

-- ---------------------------------------------------------------------------
-- двор, крепостная стена, ворота, смотровая терраса

local function courtyard(parent)
	local m = Props.model(parent, "Courtyard")
	local W = 6
	local WH = 24
	local inner = ISLAND - W
	rect(m, "CurtainWall", "z", -ISLAND + W / 2, W, -ISLAND, ISLAND, -2, WH, { { 0, 14, -3, 18 } }, FACADE_DARK, M.Slate)
	rect(m, "CurtainWall", "z", ISLAND - W / 2, W, -ISLAND, ISLAND, -2, WH, nil, FACADE_DARK, M.Slate)
	rect(m, "CurtainWall", "x", -ISLAND + W / 2, W, -ISLAND + W, ISLAND - W, -2, WH, nil, FACADE_DARK, M.Slate)
	rect(m, "CurtainWall", "x", ISLAND - W / 2, W, -ISLAND + W, ISLAND - W, -2, WH, nil, FACADE_DARK, M.Slate)
	for a = -ISLAND + 3, ISLAND - 3, 5 do
		if math.abs(a) &gt; 17 then
			box(m, "Merlon", a - 1.2, WH, -ISLAND, a + 1.2, WH + 3.5, -ISLAND + 1.5, FACADE_DARK, M.Slate)
		end
		box(m, "Merlon", a - 1.2, WH, ISLAND - 1.5, a + 1.2, WH + 3.5, ISLAND, FACADE_DARK, M.Slate)
		box(m, "Merlon", -ISLAND, WH, a - 1.2, -ISLAND + 1.5, WH + 3.5, a + 1.2, FACADE_DARK, M.Slate)
		box(m, "Merlon", ISLAND - 1.5, WH, a - 1.2, ISLAND, WH + 3.5, a + 1.2, FACADE_DARK, M.Slate)
	end
	for _, c in { { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } } do
		local x, z = c[1] * (ISLAND - 4), c[2] * (ISLAND - 4)
		C(m, "WallTower", 48, 22, CFrame.new(x, 22, z), FACADE, M.Slate)
		C(m, "WallTowerTop", 3, 25, CFrame.new(x, 47.5, z), FACADE_DARK, M.Slate)
		for k = 0, 6 do
			local roof = C(m, "WallTowerRoof", 2.6, 26 - k * 3.6, CFrame.new(x, 50 + k * 2.6, z), rgb(66, 48, 58), M.RoofShingles)
			roof:SetAttribute("Roof", true)
		end
		S(m, "Finial", 1.6, CFrame.new(x, 68.5, z), Props.GOLD, M.Metal)
	end
	-- надвратная башня и подъёмная решётка
	local gz0, gz1 = -ISLAND - 4, -ISLAND + W + 4
	box(m, "Gatehouse", -16, 18, gz0, 16, 42, gz1, FACADE, M.Slate)
	for _, x in { -11.5, 11.5 } do
		box(m, "GateTower", x - 4.5, -2, gz0, x + 4.5, 42, gz1, FACADE, M.Slate)
	end
	for a = -15, 15, 5 do
		box(m, "Merlon", a - 1.2, 42, gz0, a + 1.2, 45.5, gz0 + 1.5, FACADE_DARK, M.Slate)
	end
	Props.banner(m, CFrame.new(0, 38, gz0 - 0.1) * CFrame.Angles(0, math.pi, 0), 12, rgb(130, 20, 28))
	local gateBody = box(m, "Portcullis", -7, 0, -ISLAND + 2.4, 7, 18, -ISLAND + 3.6, rgb(45, 42, 40), M.DiamondPlate, { Transparency = 0.15 })
	B.gate = gateBody
	B.gateLift = 19
	for _, x in { -9.5, 9.5 } do
		torch(m, CFrame.new(x, 12, gz0) * CFrame.Angles(0, math.pi, 0))
	end
	-- смотровая терраса над пустотой за воротами
	box(m, "Terrace", -26, -2, -ISLAND - 30, 26, 0, gz0, rgb(130, 126, 118), M.Slate)
	P(m, "TerraceRock", Vector3.new(50, 26, 24), CFrame.new(0, -16, -ISLAND - 17) * CFrame.Angles(0.25, 0, 0), ROCK, M.Rock)
	Props.railing(m, Vector3.new(-26, 0, -ISLAND - 29.7), Vector3.new(26, 0, -ISLAND - 29.7), FACADE_DARK)
	Props.railing(m, Vector3.new(-25.7, 0, -ISLAND - 30), Vector3.new(-25.7, 0, gz0), FACADE_DARK)
	Props.railing(m, Vector3.new(25.7, 0, -ISLAND - 30), Vector3.new(25.7, 0, gz0), FACADE_DARK)
	Props.telescope(m, CFrame.new(-18, 0, -ISLAND - 25))
	Props.lamppost(m, CFrame.new(-22, 0, gz0 - 3))
	Props.lamppost(m, CFrame.new(22, 0, gz0 - 3))
	Props.bench(m, CFrame.new(12, 0, -ISLAND - 25) * CFrame.Angles(0, math.pi, 0), 8)
	B.points.outside = CFrame.new(0, 3, -ISLAND - 16)

	-- парадный двор: фонтан со статуей короля, дорожки, скамьи, фонари, клумбы
	local fz = -140
	box(m, "Path", -4, 0, -inner, 4, 0.08, fz - 18, rgb(170, 162, 150), M.Slate, { CanCollide = false })
	box(m, "Path", -4, 0, fz + 18, 4, 0.08, -HALF - 12, rgb(170, 162, 150), M.Slate, { CanCollide = false })
	for k = 0, 15 do
		local a = k / 16 * math.pi * 2
		P(m, "RingPath", Vector3.new(7.5, 0.08, 3), CFrame.new(math.cos(a) * 16.5, 0.04, fz + math.sin(a) * 16.5) * CFrame.Angles(0, -a + math.pi / 2, 0), rgb(170, 162, 150), M.Slate, { CanCollide = false })
	end
	local basin = C(m, "Fountain", 2.4, 28, CFrame.new(0, 1.2, fz), rgb(196, 190, 180), M.Marble)
	C(m, "FountainLip", 0.6, 28.6, CFrame.new(0, 2.5, fz), rgb(176, 170, 160), M.Marble)
	C(m, "FountainWater", 0.4, 25.6, CFrame.new(0, 2.3, fz), rgb(70, 130, 170), M.Glass, { Transparency = 0.35, CanCollide = false })
	box(m, "StatuePlinth", -5, 0, fz - 5, 5, 8, fz + 5, rgb(196, 190, 180), M.Marble)
	box(m, "PlinthCap", -5.6, 7.4, fz - 5.6, 5.6, 8, fz + 5.6, rgb(176, 170, 160), M.Marble)
	for k = 0, 3 do
		local a = k / 4 * math.pi * 2 + math.pi / 4
		local jet = S(m, "Spout", 1, CFrame.new(math.cos(a) * 6.5, 2.6, fz + math.sin(a) * 6.5), Props.GOLD, M.Metal)
		local spray = Instance.new("ParticleEmitter")
		spray.Rate = 25
		spray.Speed = NumberRange.new(9, 12)
		spray.SpreadAngle = Vector2.new(8, 8)
		spray.Lifetime = NumberRange.new(1, 1.3)
		spray.Acceleration = Vector3.new(0, -32, 0)
		spray.Size = NumberSequence.new(0.35)
		spray.Color = ColorSequence.new(rgb(190, 220, 255))
		spray.Transparency = NumberSequence.new(0.3)
		spray.EmissionDirection = Enum.NormalId.Top
		spray.Parent = jet
	end
	prompt(basin, "water", 0, 18)
	B.points.statue = CFrame.new(0, 8, fz)
	for k = 0, 3 do
		local a = k / 4 * math.pi * 2 + math.pi / 4
		local p = Vector3.new(math.cos(a) * 24, 0, fz + math.sin(a) * 24)
		Props.bench(m, CFrame.lookAt(p, Vector3.new(0, 0, fz)), 8)
	end
	for _, p in { { -10, -165 }, { 10, -165 }, { -10, -126 }, { 10, -126 }, { -44, -140 }, { 44, -140 }, { -140, -60 }, { 140, -60 }, { -140, 60 }, { 140, 60 }, { -40, 145 }, { 40, 145 } } do
		Props.lamppost(m, CFrame.new(p[1], 0, p[2]))
	end
	for _, p in { { -80, -152 }, { 80, -152 }, { -80, -126 }, { 80, -126 } } do
		Props.flowerbed(m, CFrame.new(p[1], 0, p[2]), 20, 8, p[1] + p[2])
	end
	Props.well(m, CFrame.new(-135, 0, -145))
	-- живые изгороди и беседка в западном саду
	for _, z in { -90, -50, 50, 90 } do
		Props.hedge(m, CFrame.new(-144, 0, z), 40)
	end
	local gp = CFrame.new(-144, 0, 0)
	C(m, "GazeboFloor", 1, 22, gp * CFrame.new(0, 0.5, 0), rgb(196, 190, 180), M.Marble)
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2
		Props.column(m, gp * CFrame.new(math.cos(a) * 9, 1, math.sin(a) * 9), 11, 0.7)
	end
	for k = 0, 4 do
		C(m, "GazeboRoof", 1.2, 24 - k * 5, gp * CFrame.new(0, 12.6 + k * 1.2, 0), rgb(66, 48, 58), M.RoofShingles)
	end
	S(m, "GazeboFinial", 1.4, gp * CFrame.new(0, 19, 0), Props.GOLD, M.Metal)
	Props.bench(m, gp * CFrame.new(0, 1, 4), 8)
	Props.bench(m, gp * CFrame.new(0, 1, -4) * CFrame.Angles(0, math.pi, 0), 8)
	-- восточный двор: мишени и стойка с оружием
	for k = 0, 3 do
		local cf = CFrame.new(150, 0, -80 + k * 20) * CFrame.Angles(0, -math.pi / 2, 0)
		P(m, "TargetStand", Vector3.new(0.4, 5, 0.4), cf * CFrame.new(0, 2.5, 0.3), Props.WOOD, M.Wood)
		for r = 0, 3 do
			C(m, "Target", 0.2 + r * 0.02, 4 - r, cf * CFrame.new(0, 5, -r * 0.06) * CFrame.Angles(math.pi / 2, 0, 0), if r % 2 == 0 then rgb(230, 225, 210) else rgb(170, 30, 30), M.Fabric)
		end
	end
	Props.weaponRack(m, CFrame.new(167, 0, -10) * CFrame.Angles(0, math.pi / 2, 0))
	-- задний двор: старое кладбище с оградой
	for k = 0, 9 do
		local x, z = -110 + (k % 5) * 9, 140 + math.floor(k / 5) * 12
		P(m, "Gravestone", Vector3.new(2.6, 3.6, 0.6), CFrame.new(x, 1.8, z) * CFrame.Angles(0, 0, math.rad((k % 3 - 1) * 4)), rgb(130, 126, 120), M.Slate)
		C(m, "GraveTop", 0.6, 2.6, CFrame.new(x, 3.6, z) * CFrame.Angles(math.pi / 2, 0, 0), rgb(130, 126, 120), M.Slate)
		P(m, "GraveMound", Vector3.new(2.6, 0.6, 5), CFrame.new(x, 0.3, z - 3), rgb(80, 70, 50), M.Ground)
	end
	for x = -120, -66, 3 do
		P(m, "Fence", Vector3.new(0.2, 4, 0.2), CFrame.new(x, 2, 128), Props.IRON, M.Metal)
	end
	P(m, "FenceRail", Vector3.new(54, 0.2, 0.2), CFrame.new(-93, 3.6, 128), Props.IRON, M.Metal)
	-- деревья (вид меняется со временем года)
	B.trees = {}
	for _, t in { { -60, -128 }, { 60, -128 }, { -60, -162 }, { 60, -162 }, { -120, -162 }, { 120, -162 }, { -160, -120 }, { 160, -120 }, { -160, 30 }, { -160, -30 }, { 140, 30 }, { 160, 140 }, { 130, 158 }, { 100, 160 }, { 60, 130 }, { 0, 150 }, { -30, 160 }, { -150, 150 }, { 150, -150 }, { -150, -150 } } do
		table.insert(B.trees, Vector3.new(t[1], 0, t[2]))
	end
	-- факелы на внутренней стороне стены
	for a = -ISLAND + 30, ISLAND - 30, 48 do
		torch(m, CFrame.new(a, 12, inner) * CFrame.Angles(0, math.pi, 0))
		torch(m, CFrame.new(-inner, 12, a) * CFrame.Angles(0, math.pi / 2, 0))
		torch(m, CFrame.new(inner, 12, a) * CFrame.Angles(0, -math.pi / 2, 0))
	end
	local spawn = Instance.new("SpawnLocation")
	spawn.Anchored = true
	spawn.Size = Vector3.new(12, 1, 6)
	spawn.CFrame = CFrame.new(0, 0.5, -160)
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = m
	B.points.yard = CFrame.new(0, 3, -160)
	B.yard = { x0 = -inner, x1 = inner, z0 = -inner, z1 = -HALF - 14 }
end

-- ---------------------------------------------------------------------------
-- фасад главного здания, башни и крыши

local function exterior(parent)
	local m = Props.model(parent, "Exterior")
	local E = HALF
	for _, y in { -1, LV.F1 - 1, LV.F2 - 1 } do
		local h = if y == -1 then 2 else 1
		box(m, "Band", -E - 0.8, y, -E - 0.8, E + 0.8, y + h, -E, FACADE_DARK, M.Slate)
		box(m, "Band", -E - 0.8, y, E, E + 0.8, y + h, E + 0.8, FACADE_DARK, M.Slate)
		box(m, "Band", -E - 0.8, y, -E, -E, y + h, E, FACADE_DARK, M.Slate)
		box(m, "Band", E, y, -E, E + 0.8, y + h, E, FACADE_DARK, M.Slate)
	end
	for k = 1, N - 1 do
		local a = -E + k * CELL
		box(m, "Pilaster", a - 1.2, -1, -E - 1, a + 1.2, ROOF, -E, FACADE_DARK, M.Slate)
		box(m, "Pilaster", a - 1.2, -1, E, a + 1.2, ROOF, E + 1, FACADE_DARK, M.Slate)
		box(m, "Pilaster", -E - 1, -1, a - 1.2, -E, ROOF, a + 1.2, FACADE_DARK, M.Slate)
		box(m, "Pilaster", E, -1, a - 1.2, E + 1, ROOF, a + 1.2, FACADE_DARK, M.Slate)
	end
	box(m, "Roof", -E, ROOF - 1, -E, E, ROOF, E, rgb(90, 86, 80), M.Slate)
	box(m, "Parapet", -E - 1, ROOF, -E - 1, E + 1, ROOF + 2, -E, FACADE, M.Slate)
	box(m, "Parapet", -E - 1, ROOF, E, E + 1, ROOF + 2, E + 1, FACADE, M.Slate)
	box(m, "Parapet", -E - 1, ROOF, -E, -E, ROOF + 2, E, FACADE, M.Slate)
	box(m, "Parapet", E, ROOF, -E, E + 1, ROOF + 2, E, FACADE, M.Slate)
	for a = -E + 2, E - 2, 5 do
		box(m, "Merlon", a - 1.2, ROOF + 2, -E - 1, a + 1.2, ROOF + 5, -E + 0.5, FACADE, M.Slate)
		box(m, "Merlon", a - 1.2, ROOF + 2, E - 0.5, a + 1.2, ROOF + 5, E + 1, FACADE, M.Slate)
		box(m, "Merlon", -E - 1, ROOF + 2, a - 1.2, -E + 0.5, ROOF + 5, a + 1.2, FACADE, M.Slate)
		box(m, "Merlon", E - 0.5, ROOF + 2, a - 1.2, E + 1, ROOF + 5, a + 1.2, FACADE, M.Slate)
	end
	-- скатные крыши над крыльями
	for _, wx in { -80, 80 } do
		for k = 0, 9 do
			local w = 44 - k * 4.4
			local roof = box(m, "WingRoof", wx - w / 2, ROOF + k * 2.2, -E + 8, wx + w / 2, ROOF + 2.2 + k * 2.2, E - 8, rgb(66, 48, 58), M.RoofShingles)
			if roof then
				roof:SetAttribute("Roof", true)
			end
		end
	end
	for _, c in { { -40, -60 }, { 40, -60 }, { -40, 20 }, { 40, 20 } } do
		box(m, "Chimney", c[1] - 3, ROOF, c[2] - 3, c[1] + 3, ROOF + 16, c[2] + 3, rgb(120, 70, 56), M.Brick)
		box(m, "ChimneyCap", c[1] - 3.6, ROOF + 16, c[2] - 3.6, c[1] + 3.6, ROOF + 17, c[2] + 3.6, FACADE_DARK, M.Slate)
	end
	-- угловые башни
	for _, c in { { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } } do
		local x, z = c[1] * E, c[2] * E
		C(m, "Tower", ROOF + 30, 30, CFrame.new(x, (ROOF + 30) / 2 - 1, z), FACADE, M.Slate)
		C(m, "TowerBand", 2, 32, CFrame.new(x, ROOF + 29, z), FACADE_DARK, M.Slate)
		for k = 0, 9 do
			local a = k / 10 * math.pi * 2
			P(m, "TowerMerlon", Vector3.new(3, 3.5, 2), CFrame.new(x, ROOF + 31.7, z) * CFrame.Angles(0, a, 0) * CFrame.new(0, 0, 15), FACADE, M.Slate)
		end
		for k = 0, 9 do
			local roof = C(m, "TowerRoof", 3.2, 30 - k * 3, CFrame.new(x, ROOF + 32 + k * 3.2, z), rgb(66, 48, 58), M.RoofShingles)
			roof:SetAttribute("Roof", true)
		end
		S(m, "Finial", 1.8, CFrame.new(x, ROOF + 66, z), Props.GOLD, M.Metal)
		local out = Vector3.new(c[1], 0, c[2]).Unit
		for _, y in { 10, 28, 46, 66 } do
			local wp = Vector3.new(x, y, z) + out * 14.6
			Props.window(m, CFrame.lookAt(wp, wp + out), 3, 6, 1)
		end
	end
	-- главная башня над тронным залом
	local tz = 64
	box(m, "Keep", -24, ROOF - 1, tz - 24, 24, ROOF + 56, tz + 24, FACADE, M.Slate)
	for a = -22, 22, 5 do
		box(m, "KeepMerlon", a - 1.2, ROOF + 56, tz - 25, a + 1.2, ROOF + 60, tz - 23.5, FACADE, M.Slate)
		box(m, "KeepMerlon", a - 1.2, ROOF + 56, tz + 23.5, a + 1.2, ROOF + 60, tz + 25, FACADE, M.Slate)
	end
	for k = 0, 11 do
		local w = 44 - k * 3.6
		local r = box(m, "KeepRoof", -w / 2, ROOF + 56 + k * 3, tz - w / 2, w / 2, ROOF + 59 + k * 3, tz + w / 2, rgb(66, 48, 58), M.RoofShingles)
		if r then
			r:SetAttribute("Roof", true)
		end
	end
	P(m, "Spire", Vector3.new(0.6, 14, 0.6), CFrame.new(0, ROOF + 99, tz), Props.GOLD, M.Metal)
	for _, y in { ROOF + 12, ROOF + 32 } do
		for _, x in { -12, 0, 12 } do
			Props.window(m, CFrame.lookAt(Vector3.new(x, y, tz - 24), Vector3.new(x, y, tz - 30)), 4, 9, 1)
		end
	end
	-- портик главного входа
	for _, x in { -12, 12 } do
		Props.column(m, CFrame.new(x, 0, -E - 9), 22, 1.6)
	end
	box(m, "Portico", -16, 22, -E - 12, 16, 24, -E, FACADE, M.Slate)
	box(m, "Pediment", -14, 24, -E - 11, 14, 27, -E - 1, FACADE_DARK, M.Slate)
	box(m, "Steps", -16, -0.6, -E - 12, 16, 0.3, -E, rgb(170, 162, 150), M.Slate)
	Props.banner(m, CFrame.new(0, 22, -E - 12.2) * CFrame.Angles(0, math.pi, 0), 8, rgb(130, 20, 28))
	for _, x in { -18, 18 } do
		Props.lamppost(m, CFrame.new(x, 0, -E - 14))
	end
end

-- ---------------------------------------------------------------------------

function B.build()
	local old = workspace:FindFirstChild("TheCastle")
	if old then
		old:Destroy()
	end
	table.clear(prompts)
	workspace.Terrain:Clear()
	root = Instance.new("Folder")
	root.Name = "TheCastle"
	B.root = root
	for _, level in Layout.ORDER do
		plans[level] = Layout.build(level)
	end
	B.plans = plans
	table.clear(doorsAt)
	table.clear(extraOpenings)
	for _, level in Layout.ORDER do
		for _, d in plans[level].doors do
			doorsAt[edgeKey(level, d.i, d.j, d.axis)] = d
		end
	end
	-- особые проёмы: парадный вход, ворота тюрьмы, выход сточного туннеля
	extraOpenings[edgeKey("G", 3, 0, "z-")] = { w = 12, h = 15, door = true }
	extraOpenings[edgeKey("U", 0, 2, "z")] = { w = 8, h = 10 }
	extraOpenings[edgeKey("U", 6, 6, "x+")] = { w = 6, h = 9 }

	local ctx = { prompt = prompt, points = B.points }
	island(root)
	courtyard(root)
	exterior(root)
	for _, level in Layout.ORDER do
		local f = Instance.new("Folder")
		f.Name = "Level_" .. level
		f.Parent = root
		buildLevel(f, level, ctx)
		task.wait()
	end
	throneRoom(root)
	sewer(root)
	library(root)
	prison(root)
	B.points.dummies = B.points.dummies or {}
	root.Parent = workspace

	-- атмосфера: тёплый полумрак в комнатах, как в DOORS
	Lighting.Ambient = rgb(58, 52, 48)
	Lighting.OutdoorAmbient = rgb(118, 116, 120)
	Lighting.Brightness = 2
	Lighting.ExposureCompensation = 0
	Lighting.EnvironmentDiffuseScale = 0.35
	Lighting.EnvironmentSpecularScale = 0.4
	Lighting.GlobalShadows = true
	local cc = Lighting:FindFirstChild("CastleColor") or Instance.new("ColorCorrectionEffect")
	cc.Name = "CastleColor"
	cc.TintColor = rgb(255, 244, 232)
	cc.Contrast = 0.1
	cc.Saturation = 0.05
	cc.Parent = Lighting
	local bloom = Lighting:FindFirstChild("CastleBloom") or Instance.new("BloomEffect")
	bloom.Name = "CastleBloom"
	bloom.Intensity = 0.6
	bloom.Size = 28
	bloom.Threshold = 1.3
	bloom.Parent = Lighting
	B.partCount = Props.count()
	return B
end

return B
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000030">
          <Properties>
            <string name="Name">CastleGame</string>
            <ProtectedString name="Source">--!nonstrict
-- Игра «The Castle»: роли, король и трон, голод и жажда, инвентарь, оружие и темница,
-- стража короля, казино, магазин, тайный ход, времена года. Все права проверяются здесь

local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")
local TextChatService = game:GetService("TextChatService")
local Debris = game:GetService("Debris")

local Shared = game:GetService("ReplicatedStorage").Workshop.Shared
local Rules = require(Shared.CastleRules)
local Remotes = require(Shared.Roblox.Remotes)

local Builder = require(script.Parent.CastleBuilder)
local Seasons = require(script.Parent.Seasons)
local Npc = require(script.Parent.Npc)
local Outfits = require(script.Parent.Outfits)
local Statue = require(script.Parent.Parent.Statue)
local CurrencyService = require(script.Parent.Parent.CurrencyService)

local G = {}

local SOUND = {
	slash = "rbxasset://sounds/swordslash.wav",
	unsheath = "rbxasset://sounds/unsheath.wav",
	eat = "rbxasset://sounds/action_get_up.mp3",
	coin = "rbxasset://sounds/electronicpingshort.wav",
	stone = "rbxasset://sounds/action_falling.mp3",
	click = "rbxasset://sounds/clickfast.wav",
	chime = "rbxasset://sounds/electronicpingshort.wav",
}

local state = {
	players = {} :: { [Player]: any },
	king = nil :: Player?,
	minionTarget = nil :: Player?,
	lastSummon = nil :: number?,
	cells = {} :: { [number]: Player },
	passage = false,
	gates = true,
	world = { season = "summer", weather = "Clear", needs = true, pvp = true, guardsPassage = false },
	clockBase = 9,
	clockAt = 0,
}
G.state = state

local event: RemoteEvent
local store: any
local npcFolder: Folder
local decor: Folder
local kingStatue: Model? = nil
local dummies = {}

-- ---------------------------------------------------------------------------
-- сообщения клиентам (каждый переводит ключи на свой язык)

local function send(p: Player, msg)
	if p.Parent then
		event:FireClient(p, msg)
	end
end

local function sendAll(msg)
	for p in state.players do
		send(p, msg)
	end
end

local function toast(p: Player, key: string, ...)
	send(p, { type = "toast", key = key, args = { ... } })
end
G.toast = toast

local function announce(key: string?, text: string?, ...)
	sendAll({ type = "announce", key = key, text = text, args = { ... } })
end
G.announce = announce

local function playSound(at: Instance?, id: string, volume: number?)
	if not at then
		return
	end
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = volume or 0.6
	s.RollOffMaxDistance = 60
	s.Parent = at
	s:Play()
	Debris:AddItem(s, 4)
end
G.playSound = playSound

local function rootOf(p: Player): BasePart?
	return p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
end
local function humOf(p: Player): Humanoid?
	return p.Character and p.Character:FindFirstChildOfClass("Humanoid")
end
G.rootOf = rootOf
G.humOf = humOf

local function teleport(p: Player, cf: CFrame)
	local char = p.Character
	if not char then
		return
	end
	local hum = humOf(p)
	if hum and hum.SeatPart then
		hum.Sit = false
		task.wait()
	end
	local r = rootOf(p)
	if r then
		r.AssemblyLinearVelocity = Vector3.zero
	end
	-- при потоковой загрузке мира сначала подгружаем место назначения
	pcall(function()
		p:RequestStreamAroundAsync(cf.Position, 3)
	end)
	char:PivotTo(cf + Vector3.new(math.random(-1, 1), 0, math.random(-1, 1)))
end
G.teleport = teleport

-- ---------------------------------------------------------------------------
-- состояние игрока: атрибуты на объекте Player видит его клиент (и только чтение)

local function hasBackpack(info): boolean
	return info.backpackItem == true or (info.owned and info.owned.backpack == true)
end

local function worn(info)
	local w = table.clone(info.worn or {})
	if info.backpackItem then
		w.backpack = true
	end
	return w
end

local function sync(p: Player)
	local info = state.players[p]
	if not info then
		p:SetAttribute("InCastle", false)
		return
	end
	p:SetAttribute("InCastle", true)
	p:SetAttribute("CastleRole", info.role)
	p:SetAttribute("Food", math.floor(info.food + 0.5))
	p:SetAttribute("Drink", math.floor(info.drink + 0.5))
	p:SetAttribute("Inv", table.concat(info.inv, ","))
	p:SetAttribute("Slots", Rules.capacity(hasBackpack(info)))
	p:SetAttribute("Jailed", info.jailed ~= nil)
	local owned, wornList = {}, {}
	for id in info.owned do
		table.insert(owned, id)
	end
	for id in info.worn do
		table.insert(wornList, id)
	end
	p:SetAttribute("Owned", table.concat(owned, ","))
	p:SetAttribute("Worn", table.concat(wornList, ","))
end
G.sync = sync

local function syncWorld()
	workspace:SetAttribute("CastleSeason", state.world.season)
	workspace:SetAttribute("CastleWeather", state.world.weather)
	workspace:SetAttribute("CastleNeeds", state.world.needs)
	workspace:SetAttribute("CastlePvp", state.world.pvp)
	workspace:SetAttribute("CastlePassage", state.passage)
	workspace:SetAttribute("CastleGuardsPassage", state.world.guardsPassage)
	workspace:SetAttribute("CastleKing", if state.king then state.king.UserId else 0)
	workspace:SetAttribute("CastleKingName", if state.king then state.king.DisplayName else "")
	workspace:SetAttribute("CastleMinions", Npc.aliveCount())
	workspace:SetAttribute("CastleSummonAt", state.lastSummon or 0)
	local counts = {}
	for _, info in state.players do
		counts[info.role] = (counts[info.role] or 0) + 1
	end
	for _, r in Rules.ROLE_ORDER do
		workspace:SetAttribute("CastleCount_" .. r, counts[r] or 0)
	end
end
G.syncWorld = syncWorld

-- ---------------------------------------------------------------------------
-- профиль: купленные украшения, надетое, язык, настройки

local function profileKey(p: Player)
	return string.format("u%d:castle", p.UserId)
end

local function saveProfile(p: Player)
	local info = state.players[p]
	local prof = G.profiles[p]
	if not prof or not prof.loaded then
		return
	end
	if info then
		prof.owned = info.owned
		prof.worn = info.worn
	end
	local data = { owned = prof.owned, worn = prof.worn, lang = prof.lang, settings = prof.settings }
	pcall(function()
		store:_update(profileKey(p), function()
			return data
		end)
	end)
	prof.dirty = false
end

G.profiles = {} :: { [Player]: any }

local function markDirty(p: Player)
	local prof = G.profiles[p]
	if prof then
		prof.dirty = true
	end
end
G.markDirty = markDirty

local dress -- объявлено ниже

local function loadProfile(p: Player)
	local prof = { owned = {}, worn = {}, lang = nil, settings = nil, loaded = false }
	G.profiles[p] = prof
	for _ = 1, 3 do
		local ok, rec = store:_get(profileKey(p))
		if ok then
			if type(rec) == "table" then
				prof.owned = type(rec.owned) == "table" and rec.owned or {}
				prof.worn = type(rec.worn) == "table" and rec.worn or {}
				prof.lang = rec.lang
				prof.settings = rec.settings
			end
			prof.loaded = true
			local info = state.players[p]
			if info then
				-- профиль пришёл после входа: купленное становится видно сразу
				for id in info.owned do
					prof.owned[id] = true
				end
				info.owned, info.worn = prof.owned, prof.worn
				dress(p)
				sync(p)
			end
			break
		end
		task.wait(2)
	end
	return prof
end

-- ---------------------------------------------------------------------------
-- одежда, инвентарь и предметы в руках

function dress(p: Player)
	local info = state.players[p]
	local char = p.Character
	if info and char then
		Outfits.apply(char, info.role, worn(info))
	end
end
G.dress = dress

local ITEM_LOOK = {
	bread = { size = Vector3.new(1.2, 0.6, 0.8), color = Color3.fromRGB(196, 140, 70), mat = Enum.Material.Sand },
	apple = { size = Vector3.new(0.7, 0.7, 0.7), color = Color3.fromRGB(190, 40, 40), shape = Enum.PartType.Ball },
	meat = { size = Vector3.new(1.2, 0.7, 0.7), color = Color3.fromRGB(140, 70, 40) },
	soup = { size = Vector3.new(0.5, 1.2, 1.2), color = Color3.fromRGB(150, 100, 60), shape = Enum.PartType.Cylinder },
	cake = { size = Vector3.new(1, 0.7, 1), color = Color3.fromRGB(250, 220, 230) },
	water = { size = Vector3.new(1.2, 0.6, 0.6), color = Color3.fromRGB(80, 140, 200), shape = Enum.PartType.Cylinder, mat = Enum.Material.Glass },
	juice = { size = Vector3.new(1.2, 0.6, 0.6), color = Color3.fromRGB(240, 150, 40), shape = Enum.PartType.Cylinder, mat = Enum.Material.Glass },
	spoon = { size = Vector3.new(0.15, 1.3, 0.25), color = Color3.fromRGB(200, 200, 210), mat = Enum.Material.Metal },
	broom = { size = Vector3.new(0.2, 4.5, 0.2), color = Color3.fromRGB(120, 85, 50), mat = Enum.Material.Wood, extra = "broom" },
	book = { size = Vector3.new(1, 0.3, 1.3), color = Color3.fromRGB(110, 40, 40), mat = Enum.Material.Fabric },
	scepter = { size = Vector3.new(0.25, 3, 0.25), color = Color3.fromRGB(214, 172, 80), mat = Enum.Material.Metal, extra = "scepter" },
	sword = { size = Vector3.new(0.25, 4, 0.5), color = Color3.fromRGB(200, 202, 210), mat = Enum.Material.Metal, extra = "sword" },
	cuffs = { size = Vector3.new(0.8, 0.3, 0.8), color = Color3.fromRGB(70, 66, 62), mat = Enum.Material.Metal, shape = Enum.PartType.Cylinder },
}

local onActivate -- объявлено ниже

local function makeTool(p: Player, item: string, slot: number): Tool
	local look = ITEM_LOOK[item] or ITEM_LOOK.bread
	local tool = Instance.new("Tool")
	tool.Name = item
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool:SetAttribute("Item", item)
	tool:SetAttribute("Slot", slot)
	local h = Instance.new("Part")
	h.Name = "Handle"
	h.Size = look.size
	h.Color = look.color
	h.Material = look.mat or Enum.Material.SmoothPlastic
	if look.shape then
		h.Shape = look.shape
	end
	h.CanCollide = false
	h.Massless = true
	h.Parent = tool
	if look.extra == "sword" then
		tool.GripPos = Vector3.new(0, -1.6, 0)
		local guard = Instance.new("Part")
		guard.Size = Vector3.new(1, 0.2, 0.3)
		guard.Color = Color3.fromRGB(214, 172, 80)
		guard.Material = Enum.Material.Metal
		guard.CanCollide = false
		guard.Massless = true
		guard.CFrame = h.CFrame * CFrame.new(0, -1.3, 0)
		local w = Instance.new("WeldConstraint")
		w.Part0, w.Part1 = h, guard
		w.Parent = guard
		guard.Parent = tool
	elseif look.extra == "scepter" then
		tool.GripPos = Vector3.new(0, -0.6, 0)
		local gem = Instance.new("Part")
		gem.Shape = Enum.PartType.Ball
		gem.Size = Vector3.new(0.6, 0.6, 0.6)
		gem.Color = Color3.fromRGB(200, 30, 50)
		gem.Material = Enum.Material.Neon
		gem.CanCollide = false
		gem.Massless = true
		gem.CFrame = h.CFrame * CFrame.new(0, 1.6, 0)
		local w = Instance.new("WeldConstraint")
		w.Part0, w.Part1 = h, gem
		w.Parent = gem
		gem.Parent = tool
	elseif look.extra == "broom" then
		tool.GripPos = Vector3.new(0, 0.5, 0)
		local b = Instance.new("Part")
		b.Size = Vector3.new(1.2, 1, 0.4)
		b.Color = Color3.fromRGB(200, 170, 100)
		b.Material = Enum.Material.Grass
		b.CanCollide = false
		b.Massless = true
		b.CFrame = h.CFrame * CFrame.new(0, -2.6, 0)
		local w = Instance.new("WeldConstraint")
		w.Part0, w.Part1 = h, b
		w.Parent = b
		b.Parent = tool
	end
	tool.Activated:Connect(function()
		onActivate(p, item, tool)
	end)
	return tool
end

local function rebuildTools(p: Player)
	local info = state.players[p]
	local hum = humOf(p)
	local equipped: string? = nil
	if p.Character then
		local t = p.Character:FindFirstChildOfClass("Tool")
		if t then
			equipped = t:GetAttribute("Item")
			t:Destroy()
		end
	end
	local bp = p:FindFirstChildOfClass("Backpack")
	if bp then
		bp:ClearAllChildren()
	end
	if not info or not bp then
		return
	end
	local equipTool: Tool? = nil
	for i, item in info.inv do
		local t = makeTool(p, item, i)
		t.Parent = bp
		if equipped == item and not equipTool then
			equipTool = t
		end
	end
	if equipTool and hum then
		hum:EquipTool(equipTool)
	end
end

function G.giveItem(p: Player, item: string, quiet: boolean?): boolean
	local info = state.players[p]
	if not info or not Rules.ITEMS[item] then
		return false
	end
	if not Rules.canHold(item, info.role) then
		if not quiet then
			toast(p, "NotForRole")
		end
		return false
	end
	if item == "backpack" then
		info.backpackItem = true
		dress(p)
		sync(p)
		return true
	end
	local ok = Rules.addItem(info.inv, item, hasBackpack(info))
	if not ok then
		if not quiet then
			toast(p, "InventoryFull")
		end
		return false
	end
	rebuildTools(p)
	sync(p)
	playSound(rootOf(p), SOUND.click, 0.4)
	return true
end

function G.clearItems(p: Player)
	local info = state.players[p]
	if info then
		table.clear(info.inv)
		rebuildTools(p)
		sync(p)
	end
end

-- предметы, которые роль больше не может держать, исчезают
local function dropForbidden(p: Player)
	local info = state.players[p]
	if not info then
		return
	end
	for i = #info.inv, 1, -1 do
		if not Rules.canHold(info.inv[i], info.role) then
			table.remove(info.inv, i)
		end
	end
	rebuildTools(p)
end

-- ---------------------------------------------------------------------------
-- роли и король

local function counts()
	local c = {}
	for _, info in state.players do
		c[info.role] = (c[info.role] or 0) + 1
	end
	return c
end

local function updateKingStatue(userId: number)
	task.spawn(function()
		local m = Statue.spawn(userId, "stand", false, Builder.points.statue, decor, { scale = 2.2 })
		if m then
			if kingStatue then
				kingStatue:Destroy()
			end
			kingStatue = m
		end
	end)
end

local function kingFell()
	if not state.king then
		return
	end
	state.king = nil
	state.minionTarget = nil
	Npc.clearMinions()
	announce("KingFell")
	syncWorld()
end

function G.setRole(p: Player, role: string)
	local info = state.players[p]
	if not info or not Rules.ROLES[role] then
		return
	end
	if info.role == role then
		return
	end
	if role == "king" and state.king and state.king ~= p then
		G.setRole(state.king, "peasant")
	end
	if (role == "queen" or role == "commander") then
		for q, other in state.players do
			if q ~= p and other.role == role then
				other.role = "peasant"
				dress(q)
				dropForbidden(q)
				sync(q)
			end
		end
	end
	local wasKing = info.role == "king"
	info.role = role
	if wasKing and role ~= "king" then
		kingFell()
	end
	if role == "king" then
		state.king = p
		info.food, info.drink = Rules.MAX, Rules.MAX
		announce("NewKing", nil, p.DisplayName)
		updateKingStatue(p.UserId)
		G.giveItem(p, "scepter", true)
	end
	dress(p)
	dropForbidden(p)
	sync(p)
	syncWorld()
end

-- ---------------------------------------------------------------------------
-- темница

G.SENTENCE = 180 -- секунд в тюрьме; работа сокращает срок
G.WORK_CUT = 15

function G.jail(p: Player, seconds: number?)
	local info = state.players[p]
	if not info or info.jailed then
		return false
	end
	local cell = nil
	for i = 1, #Builder.cells do
		if not state.cells[i] then
			cell = i
			break
		end
	end
	cell = cell or math.random(1, #Builder.cells)
	state.cells[cell] = p
	info.jailed = cell
	info.jailUntil = os.time() + (seconds or G.SENTENCE)
	p:SetAttribute("JailUntil", info.jailUntil)
	if info.role == "king" then
		G.setRole(p, "peasant")
	end
	for i = #info.inv, 1, -1 do
		local def = Rules.ITEMS[info.inv[i]]
		if def.kind == "weapon" or info.inv[i] == "cuffs" then
			table.remove(info.inv, i)
		end
	end
	rebuildTools(p)
	teleport(p, Builder.cells[cell].inside)
	toast(p, "Jailed")
	sync(p)
	return true
end

function G.free(p: Player, toYard: boolean?)
	local info = state.players[p]
	if not info or not info.jailed then
		return false
	end
	state.cells[info.jailed] = nil
	info.jailed = nil
	info.jailUntil = nil
	p:SetAttribute("JailUntil", nil)
	teleport(p, if toYard then Builder.points.yard else Builder.points.dungeon)
	toast(p, "FreedMsg")
	sync(p)
	return true
end

-- работа узника: срок короче, немного золота
function G.work(p: Player)
	local info = state.players[p]
	if not info or not info.jailed then
		toast(p, "WorkOnlyPrisoners")
		return
	end
	info.jailUntil = (info.jailUntil or os.time()) - G.WORK_CUT
	p:SetAttribute("JailUntil", info.jailUntil)
	CurrencyService.add(p, 1)
	playSound(rootOf(p), SOUND.click, 0.6)
	if info.jailUntil &lt;= os.time() then
		G.free(p)
	end
end

-- ---------------------------------------------------------------------------
-- тайный ход и ворота

local passageBusy = false
function G.setPassage(open: boolean)
	if passageBusy or state.passage == open then
		return
	end
	passageBusy = true
	state.passage = open
	syncWorld()
	local throne = Builder.throne
	local home = Builder.throneHome
	local v = Instance.new("NumberValue")
	v.Value = if open then 0 else 1
	v.Changed:Connect(function(a)
		throne:PivotTo(home + (Builder.throneSlide or Vector3.new(14, 0, 0)) * a)
	end)
	playSound(Builder.throneSeat, SOUND.stone, 1)
	if open then
		Builder.hatch.Transparency = 1
		Builder.hatch.CanCollide = false
	end
	local t = TweenService:Create(v, TweenInfo.new(2.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Value = if open then 1 else 0 })
	t:Play()
	t.Completed:Wait()
	if not open then
		Builder.hatch.Transparency = 0
		Builder.hatch.CanCollide = true
	end
	v:Destroy()
	passageBusy = false
end

function G.setGates(open: boolean)
	if state.gates == open then
		return
	end
	state.gates = open
	local g = Builder.gate
	local base = g:GetAttribute("BaseY") or g.Position.Y
	g:SetAttribute("BaseY", base)
	playSound(g, SOUND.stone, 1)
	TweenService:Create(g, TweenInfo.new(2.5, Enum.EasingStyle.Sine), { CFrame = CFrame.new(g.Position.X, base + (if open then (Builder.gateLift or 20) else 0), g.Position.Z) }):Play()
end

-- ---------------------------------------------------------------------------
-- время суток, погода и времена года

function G.setClock(hour: number)
	state.clockBase = hour
	state.clockAt = os.clock()
	Lighting.ClockTime = hour
end

function G.setWeather(w: string)
	state.world.weather = w
	syncWorld()
end

function G.setSeason(season: string)
	state.world.season = season
	Seasons.apply(season, Builder.trees)
	state.world.weather = Seasons.defaultWeather(season)
	syncWorld()
end

function G.setNeeds(on: boolean)
	state.world.needs = on
	syncWorld()
end

function G.setPvp(on: boolean)
	state.world.pvp = on
	syncWorld()
end

-- ---------------------------------------------------------------------------
-- бой

local function attackFrom(p: Player, range: number, damage: number)
	local root = rootOf(p)
	if not root then
		return
	end
	local look = root.CFrame.LookVector
	local best = {}
	local function consider(model: Model, kind: string)
		local r = model:FindFirstChild("HumanoidRootPart") :: BasePart?
		local h = model:FindFirstChildOfClass("Humanoid")
		if not r or not h or h.Health &lt;= 0 or model == p.Character then
			return
		end
		local off = r.Position - root.Position
		local d = off.Magnitude
		if d &gt; range then
			return
		end
		if d &gt; 2 and off.Unit:Dot(look) &lt; 0.2 then
			return
		end
		table.insert(best, { model = model, hum = h, kind = kind })
	end
	for q in state.players do
		if q.Character then
			consider(q.Character, "player")
		end
	end
	for _, m in Npc.minions do
		consider(m.model, "minion")
	end
	for _, d in dummies do
		consider(d.model, "dummy")
	end
	for _, t in best do
		if t.kind == "dummy" then
			t.hum.Health = math.max(1, t.hum.Health - damage)
			for _, d in dummies do
				if d.model == t.model then
					d.onHit(p.Character)
				end
			end
		elseif t.kind == "minion" then
			t.hum:TakeDamage(damage)
		elseif state.world.pvp then
			local target = Players:GetPlayerFromCharacter(t.model)
			local tInfo = target and state.players[target]
			if tInfo and not tInfo.jailed then
				t.hum:TakeDamage(damage)
				-- стража короля защищает короля
				if target == state.king and Npc.aliveCount() &gt; 0 then
					state.minionTarget = p
				end
			end
		end
	end
end

local function nearestPlayer(p: Player, range: number): Player?
	local root = rootOf(p)
	if not root then
		return nil
	end
	local best, bestD = nil, range
	for q in state.players do
		local r = q ~= p and rootOf(q)
		if r then
			local d = (r.Position - root.Position).Magnitude
			if d &lt; bestD then
				best, bestD = q, d
			end
		end
	end
	return best
end

local lastUse: { [Player]: { [string]: number } } = {}

local function cooldown(p: Player, key: string, sec: number): boolean
	lastUse[p] = lastUse[p] or {}
	local now = os.clock()
	if now - (lastUse[p][key] or 0) &lt; sec then
		return false
	end
	lastUse[p][key] = now
	return true
end

onActivate = function(p: Player, item: string, tool: Tool)
	local info = state.players[p]
	if not info or tool.Parent ~= p.Character then
		return
	end
	local def = Rules.ITEMS[item]
	if item == "sword" then
		if not cooldown(p, "sword", def.cooldown) then
			return
		end
		local anim = Instance.new("StringValue")
		anim.Name = "toolanim"
		anim.Value = "Slash"
		anim.Parent = tool
		Debris:AddItem(anim, 0.5)
		playSound(tool:FindFirstChild("Handle"), SOUND.slash, 0.7)
		attackFrom(p, 7, def.damage)
	elseif item == "cuffs" then
		if not cooldown(p, "cuffs", 2) then
			return
		end
		local target = nearestPlayer(p, 8)
		if target and target ~= state.king then
			G.jail(target)
		end
	elseif item == "broom" then
		if not cooldown(p, "broom", 1) then
			return
		end
		local h = tool:FindFirstChild("Handle")
		local e = Instance.new("ParticleEmitter")
		e.Rate = 0
		e.Speed = NumberRange.new(2, 5)
		e.Lifetime = NumberRange.new(0.6, 1)
		e.Size = NumberSequence.new(0.4, 0)
		e.Color = ColorSequence.new(Color3.fromRGB(200, 190, 170))
		e.Parent = h
		e:Emit(12)
		Debris:AddItem(e, 2)
		-- работа прислуги оплачивается
		if (info.role == "servant" or info.role == "cook") and cooldown(p, "broomPay", 20) then
			CurrencyService.add(p, 2)
		end
	elseif item == "scepter" then
		if not cooldown(p, "scepter", 1.5) then
			return
		end
		local h = tool:FindFirstChild("Handle")
		local s = Instance.new("Sparkles")
		s.SparkleColor = Color3.fromRGB(255, 220, 120)
		s.Parent = h
		Debris:AddItem(s, 2)
		playSound(h, SOUND.chime, 0.5)
	elseif item == "book" then
		if info.role == "librarian" and cooldown(p, "bookPay", 30) then
			CurrencyService.add(p, 3)
		end
		send(p, { type = "book" })
	elseif item == "spoon" then
		if cooldown(p, "spoon", 1) then
			playSound(tool:FindFirstChild("Handle"), SOUND.click, 0.5)
		end
	end
end

-- ---------------------------------------------------------------------------
-- стража короля

local function summon(p: Player, count: number?)
	local alive = Npc.aliveCount()
	local n = math.min(count or Rules.MINION_BATCH, Rules.MINION_MAX - alive)
	local base = if p then rootOf(p) else nil
	local at = if base then base.CFrame else Builder.points.throneRoom
	for i = 1, n do
		Npc.spawnMinion(at * CFrame.new((i - 1.5) * 4, 2, 6), npcFolder)
	end
	syncWorld()
	return n
end
G.summon = summon

-- ---------------------------------------------------------------------------
-- вход и выход из замка

local function addToGeneral(p: Player, on: boolean)
	local tc = TextChatService:FindFirstChild("TextChannels")
	local general = tc and tc:FindFirstChild("RBXGeneral")
	if not general then
		return
	end
	local src = nil
	for _, s in general:GetChildren() do
		if s:IsA("TextSource") and s.UserId == p.UserId then
			src = s
		end
	end
	if on and not src then
		pcall(function()
			src = (general :: TextChannel):AddUserAsync(p.UserId)
		end)
	elseif not on and src then
		src:Destroy()
		src = nil
	end
	if src then
		local info = state.players[p]
		src.CanSend = not (info and info.muted)
	end
end
G.addToGeneral = addToGeneral

function G.enter(p: Player)
	local info = state.players[p]
	local prof = G.profiles[p] or { owned = {}, worn = {} }
	if not info then
		info = { role = "peasant", food = Rules.MAX, drink = Rules.MAX, inv = {}, owned = prof.owned, worn = prof.worn, backpackItem = false }
		state.players[p] = info
	end
	addToGeneral(p, true)
	if not p.Character then
		p:LoadCharacter()
	end
	teleport(p, Builder.points.yard)
	dress(p)
	rebuildTools(p)
	sync(p)
	syncWorld()
	return { ok = true }
end

function G.leave(p: Player)
	local info = state.players[p]
	if not info then
		return
	end
	if info.jailed then
		state.cells[info.jailed] = nil
	end
	if state.minionTarget == p then
		state.minionTarget = nil
	end
	local wasKing = state.king == p
	state.players[p] = nil
	if wasKing then
		kingFell()
	end
	if p.Character then
		local o = p.Character:FindFirstChild("CastleOutfit")
		if o then
			o:Destroy()
		end
	end
	local bp = p:FindFirstChildOfClass("Backpack")
	if bp then
		bp:ClearAllChildren()
	end
	sync(p)
	syncWorld()
end

function G.inCastle(p: Player): boolean
	return state.players[p] ~= nil
end

-- ---------------------------------------------------------------------------
-- подсказки взаимодействия у объектов

local function prompts(kind: string, fn: (Player, ProximityPrompt) -&gt; ())
	for _, pr in Builder.prompts[kind] or {} do
		pr.Triggered:Connect(function(p)
			if state.players[p] then
				fn(p, pr)
			end
		end)
	end
end

local function canPassage(p: Player): boolean
	local info = state.players[p]
	if not info then
		return false
	end
	if info.role == "king" then
		return true
	end
	return state.world.guardsPassage and (info.role == "guard" or info.role == "commander")
end
G.canPassage = canPassage

local function sitOnThrone(p: Player)
	local hum = humOf(p)
	local seat = Builder.throneSeat
	if hum and not seat.Occupant then
		seat.Disabled = false
		seat:Sit(hum)
	end
end

local function wirePrompts()
	prompts("throne", function(p)
		local info = state.players[p]
		if info.jailed then
			return
		end
		if not state.king then
			G.setRole(p, "king")
			sitOnThrone(p)
		elseif state.king == p then
			sitOnThrone(p)
		else
			toast(p, "OnlyKing")
		end
	end)
	Builder.throneSeat:GetPropertyChangedSignal("Occupant"):Connect(function()
		local seat = Builder.throneSeat
		if not seat.Occupant then
			seat.Disabled = true
		else
			local p = Players:GetPlayerFromCharacter(seat.Occupant.Parent)
			if p ~= state.king then
				seat.Occupant.Sit = false
			end
		end
	end)
	prompts("passage", function(p)
		if canPassage(p) then
			task.spawn(G.setPassage, not state.passage)
		else
			toast(p, "OnlyKing")
		end
	end)
	prompts("lever", function(_p)
		task.spawn(G.setPassage, false)
	end)
	prompts("bread", function(p)
		G.giveItem(p, "bread")
	end)
	prompts("apple", function(p)
		G.giveItem(p, "apple")
	end)
	prompts("spoon", function(p)
		G.giveItem(p, "spoon")
	end)
	prompts("water", function(p)
		G.giveItem(p, "water")
	end)
	prompts("book", function(p)
		G.giveItem(p, "book")
	end)
	prompts("broom", function(p)
		G.giveItem(p, "broom")
	end)
	prompts("sword", function(p)
		if G.giveItem(p, "sword") then
			playSound(rootOf(p), SOUND.unsheath, 0.6)
		end
	end)
	prompts("cuffs", function(p)
		G.giveItem(p, "cuffs")
	end)
	prompts("scepter", function(p)
		G.giveItem(p, "scepter")
	end)
	prompts("cook", function(p)
		local info = state.players[p]
		if info.role ~= "cook" and info.role ~= "king" and info.role ~= "queen" then
			toast(p, "NotForRole")
			return
		end
		local dishes = { "meat", "soup", "cake", "juice" }
		if G.giveItem(p, dishes[math.random(1, #dishes)]) and info.role == "cook" and cooldown(p, "cookPay", 15) then
			CurrencyService.add(p, 3)
		end
	end)
	prompts("rest", function(p)
		local hum = humOf(p)
		if hum then
			hum.Health = math.min(hum.MaxHealth, hum.Health + 30)
		end
	end)
	prompts("roles", function(p)
		send(p, { type = "open", panel = "roles" })
	end)
	prompts("shop", function(p)
		send(p, { type = "open", panel = "shop" })
	end)
	prompts("slots", function(p)
		send(p, { type = "open", panel = "slots" })
	end)
	prompts("coin", function(p)
		send(p, { type = "open", panel = "coin" })
	end)
	-- ворота тюрьмы: проходит только стража, король и военачальник
	prompts("prisongate", function(p)
		local info = state.players[p]
		if info.jailed then
			toast(p, "JailedNo")
			return
		end
		if info.role ~= "king" and info.role ~= "commander" and info.role ~= "guard" then
			toast(p, "NotForRole")
			return
		end
		local r = rootOf(p)
		if not r then
			return
		end
		local inside = Builder.points.prisonInside
		local outside = Builder.points.prisonOutside
		local isInside = (r.Position - inside.Position).Magnitude &lt; (r.Position - outside.Position).Magnitude
		playSound(r, SOUND.stone, 0.6)
		teleport(p, if isInside then outside else inside)
	end)
	prompts("work", function(p)
		if cooldown(p, "work", 3) then
			G.work(p)
		end
	end)
end

-- ---------------------------------------------------------------------------
-- запросы клиента

local handlers = {}

handlers.Enter = function(p)
	return G.enter(p)
end

handlers.Leave = function(p)
	G.leave(p)
	return { ok = true }
end

handlers.Profile = function(p)
	local prof = G.profiles[p]
	return { ok = true, lang = prof and prof.lang, settings = prof and prof.settings }
end

handlers.SetLang = function(p, lang)
	local prof = G.profiles[p]
	if prof and (lang == "en" or lang == "ru") then
		prof.lang = lang
		prof.dirty = true
	end
	return { ok = true }
end

handlers.SaveSettings = function(p, settings)
	local prof = G.profiles[p]
	if prof and type(settings) == "table" then
		local clean = {}
		for k, v in settings do
			if type(k) == "string" and #k &lt; 24 and (type(v) == "number" or type(v) == "boolean") then
				clean[k] = v
			end
		end
		prof.settings = clean
		prof.dirty = true
	end
	return { ok = true }
end

handlers.TakeRole = function(p, role)
	local info = state.players[p]
	if not info or type(role) ~= "string" or not Rules.ROLES[role] then
		return { ok = false }
	end
	if info.jailed then
		return { ok = false, error = "jailed" }
	end
	if info.role == role then
		return { ok = true }
	end
	local c = counts()
	if not Rules.canTake(role, c) then
		return { ok = false, error = if Rules.APPOINTED[role] then "appointed" else "taken" }
	end
	G.setRole(p, role)
	return { ok = true }
end

handlers.Use = function(p, slot)
	local info = state.players[p]
	if not info or type(slot) ~= "number" then
		return { ok = false }
	end
	local item = info.inv[slot]
	if not item then
		return { ok = false }
	end
	local def = Rules.ITEMS[item]
	if def.kind == "food" or def.kind == "drink" then
		local ok, err = Rules.consume(info, item, info.role == "king")
		if not ok then
			if err == "full" then
				toast(p, "Full")
			end
			return { ok = false, error = err }
		end
		table.remove(info.inv, slot)
		rebuildTools(p)
		playSound(p.Character and p.Character:FindFirstChild("Head"), SOUND.eat, 0.6)
		sync(p)
		return { ok = true, ate = true }
	end
	local hum = humOf(p)
	if not hum or not p.Character then
		return { ok = false }
	end
	local current = p.Character:FindFirstChildOfClass("Tool")
	if current and current:GetAttribute("Slot") == slot then
		hum:UnequipTools()
		return { ok = true, equipped = false }
	end
	local bp = p:FindFirstChildOfClass("Backpack")
	for _, t in (if bp then bp:GetChildren() else {}) do
		if t:IsA("Tool") and t:GetAttribute("Slot") == slot then
			hum:EquipTool(t)
			return { ok = true, equipped = true }
		end
	end
	return { ok = false }
end

handlers.Drop = function(p, slot)
	local info = state.players[p]
	if not info or type(slot) ~= "number" or not info.inv[slot] then
		return { ok = false }
	end
	table.remove(info.inv, slot)
	rebuildTools(p)
	sync(p)
	return { ok = true }
end

local rng = Random.new()
local function rand(a, b)
	return rng:NextInteger(a, b)
end

local function validBet(bet)
	return type(bet) == "number" and table.find(Rules.BETS, bet) ~= nil
end

handlers.Slots = function(p, bet)
	if not state.players[p] or not validBet(bet) then
		return { ok = false }
	end
	local gold = CurrencyService.get(p)
	if not gold or gold &lt; bet then
		return { ok = false, error = "gold" }
	end
	if not cooldown(p, "slots", 1.2) then
		return { ok = false, error = "rate" }
	end
	local symbols, win = Rules.slots(bet, rand)
	CurrencyService.add(p, win - bet)
	return { ok = true, symbols = symbols, win = win }
end

handlers.Coin = function(p, bet)
	if not state.players[p] or not validBet(bet) then
		return { ok = false }
	end
	local gold = CurrencyService.get(p)
	if not gold or gold &lt; bet then
		return { ok = false, error = "gold" }
	end
	if not cooldown(p, "coin", 1.2) then
		return { ok = false, error = "rate" }
	end
	local won, pay = Rules.coinFlip(bet, rand)
	CurrencyService.add(p, pay - bet)
	return { ok = true, won = won, win = pay }
end

handlers.Buy = function(p, id)
	local info = state.players[p]
	local item = type(id) == "string" and Rules.SHOP_BY_ID[id]
	if not info or not item then
		return { ok = false }
	end
	local prof = G.profiles[p]
	if not prof or not prof.loaded then
		return { ok = false, error = "load" }
	end
	if info.owned[id] then
		return { ok = true }
	end
	if not CurrencyService.add(p, -item.price) then
		return { ok = false, error = "gold" }
	end
	info.owned[id] = true
	info.worn[id] = true
	markDirty(p)
	dress(p)
	sync(p)
	return { ok = true }
end

handlers.Wear = function(p, id, on)
	local info = state.players[p]
	if not info or type(id) ~= "string" or not info.owned[id] then
		return { ok = false }
	end
	info.worn[id] = if on then true else nil
	if on and (id == "cape_red" or id == "cape_blue") then
		info.worn[if id == "cape_red" then "cape_blue" else "cape_red"] = nil
	end
	markDirty(p)
	dress(p)
	sync(p)
	return { ok = true }
end

-- король
local function isKing(p: Player)
	return state.king == p and state.players[p] ~= nil
end

handlers.KingSummon = function(p)
	if not isKing(p) then
		return { ok = false, error = "king" }
	end
	local now = os.time()
	local ok, why = Rules.canSummon(Npc.aliveCount(), state.lastSummon, now)
	if not ok then
		return { ok = false, error = why, left = if state.lastSummon then Rules.MINION_COOLDOWN - (now - state.lastSummon) else 0 }
	end
	state.lastSummon = now
	summon(p)
	toast(p, "Summoned")
	return { ok = true }
end

handlers.KingOrder = function(p, userId)
	if not isKing(p) then
		return { ok = false }
	end
	local target = if type(userId) == "number" then Players:GetPlayerByUserId(userId) else nil
	if target and (target == p or not state.players[target]) then
		target = nil
	end
	state.minionTarget = target
	return { ok = true }
end

handlers.KingAppoint = function(p, userId, role)
	if not isKing(p) or type(userId) ~= "number" then
		return { ok = false }
	end
	local target = Players:GetPlayerByUserId(userId)
	if not target or target == p or not state.players[target] then
		return { ok = false }
	end
	if role == "queen" or role == "commander" or role == "guard" then
		if role == "guard" and not Rules.canTake("guard", counts()) then
			return { ok = false, error = "taken" }
		end
		G.setRole(target, role)
	elseif role == "dismiss" then
		G.setRole(target, "peasant")
	elseif role == "jail" then
		G.jail(target)
	elseif role == "free" then
		G.free(target)
	else
		return { ok = false }
	end
	return { ok = true }
end

handlers.KingPassage = function(p, open)
	if not canPassage(p) then
		return { ok = false }
	end
	task.spawn(G.setPassage, open == true)
	return { ok = true }
end

handlers.KingGuardsPassage = function(p, on)
	if not isKing(p) then
		return { ok = false }
	end
	state.world.guardsPassage = on == true
	syncWorld()
	return { ok = true }
end

handlers.Abdicate = function(p)
	if not isKing(p) then
		return { ok = false }
	end
	G.setRole(p, "peasant")
	return { ok = true }
end

G.handlers = handlers

-- ---------------------------------------------------------------------------

function G.init(projectStore)
	store = projectStore
	event = Remotes.event("Castle")
	Builder.build()
	npcFolder = Instance.new("Folder")
	npcFolder.Name = "CastleNpcs"
	npcFolder.Parent = workspace
	decor = Instance.new("Folder")
	decor.Name = "CastleDecor"
	decor.Parent = workspace
	G.npcFolder = npcFolder
	G.setSeason("summer")
	G.setClock(9)
	state.gates = false
	G.setGates(true)
	wirePrompts()
	for _, cf in Builder.points.dummies or {} do
		table.insert(dummies, Npc.buildDummy(cf, decor))
	end
	Npc.buildPriest(Builder.points.priest, decor)
	-- статуи создателей у трона, по умолчанию во дворе статуя владельца
	task.spawn(function()
		for _, s in { { "Saren45hil", Builder.points.statueLeft }, { "Nataliaavira13", Builder.points.statueRight } } do
			local m = Statue.spawn(s[1], "stand", false, s[2], decor, { scale = 1.5 })
			if m then
				local hand = m:FindFirstChild("RightHand") or m:FindFirstChild("Right Arm")
				if hand and hand:IsA("BasePart") then
					local sc = Instance.new("Part")
					sc.Name = "StoneScepter"
					sc.Anchored = true
					sc.CanCollide = false
					sc.Size = Vector3.new(0.35, 4.5, 0.35)
					sc.Color = Color3.fromRGB(196, 194, 190)
					sc.Material = Enum.Material.Marble
					sc.CFrame = hand.CFrame * CFrame.new(0, 0.3, -0.4)
					sc.Parent = m
				end
			end
		end
		if not kingStatue then
			kingStatue = Statue.spawn("Saren45hil", "stand", false, Builder.points.statue, decor, { scale = 2.2 })
		end
	end)

	Remotes.fn("CastleRequest").OnServerInvoke = function(p: Player, action: any, ...)
		if type(action) ~= "string" or not handlers[action] then
			return { ok = false, error = "unknown" }
		end
		if not cooldown(p, "req" .. action, 0.15) then
			return { ok = false, error = "rate" }
		end
		local ok, res = pcall(handlers[action], p, ...)
		if not ok then
			warn("[Castle] " .. action .. ": " .. tostring(res))
			return { ok = false, error = "server_error" }
		end
		return res
	end

	local function onCharacter(p: Player, char: Model)
		local info = state.players[p]
		if not info then
			return
		end
		info.food, info.drink = Rules.MAX, Rules.MAX
		local hum = char:WaitForChild("Humanoid", 5) :: Humanoid?
		task.wait(0.2)
		-- срок не закончился: узник появляется снова в тюрьме
		if info.jailed and Builder.cells[info.jailed] then
			teleport(p, Builder.cells[info.jailed].inside)
		end
		dress(p)
		rebuildTools(p)
		sync(p)
		if hum then
			hum.Died:Connect(function()
				local i = state.players[p]
				if not i then
					return
				end
				table.clear(i.inv)
				i.backpackItem = false
				if state.king == p then
					i.role = "peasant"
					kingFell()
				end
				if state.minionTarget == p then
					state.minionTarget = nil
				end
				sync(p)
			end)
		end
	end

	Players.PlayerAdded:Connect(function(p)
		p.CharacterAdded:Connect(function(char)
			onCharacter(p, char)
		end)
		task.spawn(loadProfile, p)
		sync(p)
	end)
	for _, p in Players:GetPlayers() do
		p.CharacterAdded:Connect(function(char)
			onCharacter(p, char)
		end)
		task.spawn(loadProfile, p)
	end
	Players.PlayerRemoving:Connect(function(p)
		G.leave(p)
		saveProfile(p)
		G.profiles[p] = nil
		lastUse[p] = nil
	end)
	game:BindToClose(function()
		for p in G.profiles do
			task.spawn(saveProfile, p)
		end
		task.wait(2)
	end)

	-- голод и жажда, зарплата, сохранение профилей
	task.spawn(function()
		local tick = 0
		while true do
			task.wait(1)
			tick += 1
			for p, info in state.players do
				local hum = humOf(p)
				if hum and hum.Health &gt; 0 then
					if state.world.needs then
						local dmg = Rules.tick(info, 1, info.role == "king")
						if dmg &gt; 0 then
							hum:TakeDamage(dmg)
							if cooldown(p, "starve", 30) then
								toast(p, "Starving")
							end
						end
					end
					sync(p)
					-- срок вышел — на свободу; сбежавшего узника возвращаем
					if info.jailed then
						if (info.jailUntil or 0) &lt;= os.time() then
							G.free(p)
						else
							local r = rootOf(p)
							if r and (r.Position.X &gt; -47 or r.Position.X &lt; -113 or r.Position.Z &lt; -17 or r.Position.Z &gt; 113 or r.Position.Y &gt; 0 or r.Position.Y &lt; -25) then
								teleport(p, Builder.cells[info.jailed].inside)
							end
						end
					end
				end
				if tick % 60 == 0 and not info.jailed then
					local pay = ({ king = 15, queen = 12, commander = 10, guard = 8, cook = 7, servant = 7, librarian = 7, peasant = 5 })[info.role] or 5
					CurrencyService.add(p, pay)
				end
			end
			if tick % 20 == 0 then
				for p, prof in G.profiles do
					if prof.dirty then
						task.spawn(saveProfile, p)
					end
				end
			end
			-- сутки длятся 24 минуты
			Lighting.ClockTime = (state.clockBase + (os.clock() - state.clockAt) / 60) % 24
		end
	end)

	-- стража: поведение и цель
	task.spawn(function()
		while true do
			task.wait(0.3)
			local target = state.minionTarget
			if target and (not state.players[target] or not humOf(target) or (humOf(target) :: Humanoid).Health &lt;= 0) then
				state.minionTarget = nil
				target = nil
			end
			if #Npc.minions &gt; 0 then
				Npc.stepMinions(state.king, target and target.Character, function(_model, hum)
					hum:TakeDamage(15)
				end)
			end
			if os.clock() % 3 &lt; 0.31 then
				workspace:SetAttribute("CastleMinions", Npc.aliveCount())
			end
		end
	end)
	syncWorld()
end

return G
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000031">
          <Properties>
            <string name="Name">Npc</string>
            <ProtectedString name="Source">--!nonstrict
-- NPC замка: стражники короля (идут за королём, по приказу атакуют игрока),
-- тренировочный манекен, который отвечает ударом, и парящая статуя жреца с книгой

local Players = game:GetService("Players")
local PathfindingService = game:GetService("PathfindingService")
local TweenService = game:GetService("TweenService")

local Npc = {}

local WALK_ANIM = "rbxassetid://507777826"
local IDLE_ANIM = "rbxassetid://507766388"
local SLASH_ANIM = "rbxassetid://522635514"

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local function weldPart(parent: Instance, to: BasePart, props, offset: CFrame)
	local p = Instance.new(props.Class or "Part")
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in props do
		if k ~= "Class" then
			(p :: any)[k] = v
		end
	end
	p.CFrame = to.CFrame * offset
	local w = Instance.new("WeldConstraint")
	w.Part0 = to
	w.Part1 = p
	w.Parent = p
	p.Parent = parent
	return p
end
Npc.weldPart = weldPart

-- ---------------------------------------------------------------------------
-- Стражники короля

Npc.minions = {} :: { any }

local function rootOf(model: Model?): BasePart?
	return model and model:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function aliveHum(model: Model?): Humanoid?
	local h = model and model:FindFirstChildOfClass("Humanoid")
	if h and h.Health &gt; 0 then
		return h
	end
	return nil
end

function Npc.aliveCount(): number
	local n = 0
	for _, m in Npc.minions do
		if aliveHum(m.model) then
			n += 1
		end
	end
	return n
end

local function dressMinion(model: Model)
	local head = model:FindFirstChild("Head") :: BasePart?
	local torso = model:FindFirstChild("UpperTorso") :: BasePart?
	local hand = model:FindFirstChild("RightHand") :: BasePart?
	if head then
		weldPart(model, head, { Name = "Helmet", Size = Vector3.new(1.35, 0.9, 1.35), Color = rgb(170, 172, 180), Material = Enum.Material.Metal }, CFrame.new(0, 0.35, 0))
		weldPart(model, head, { Name = "Plume", Size = Vector3.new(0.25, 0.9, 1.1), Color = rgb(214, 172, 80), Material = Enum.Material.Fabric }, CFrame.new(0, 1.1, 0.1))
	end
	if torso then
		weldPart(model, torso, { Name = "Tabard", Size = Vector3.new(1.7, 1.9, 0.15), Color = rgb(150, 20, 30), Material = Enum.Material.Fabric }, CFrame.new(0, -0.2, -0.55))
		weldPart(model, torso, { Name = "Emblem", Size = Vector3.new(0.6, 0.6, 0.05), Color = rgb(214, 172, 80), Material = Enum.Material.Metal }, CFrame.new(0, 0.1, -0.65))
	end
	if hand then
		weldPart(model, hand, { Name = "Blade", Size = Vector3.new(0.2, 3.2, 0.4), Color = rgb(200, 202, 210), Material = Enum.Material.Metal }, CFrame.new(0, -0.3, -1.6) * CFrame.Angles(math.rad(90), 0, 0))
		weldPart(model, hand, { Name = "Guard", Size = Vector3.new(0.9, 0.2, 0.2), Color = rgb(214, 172, 80), Material = Enum.Material.Metal }, CFrame.new(0, -0.3, 0))
	end
end

function Npc.spawnMinion(at: CFrame, parent: Instance)
	local desc = Instance.new("HumanoidDescription")
	local skin = ({ rgb(234, 184, 146), rgb(204, 142, 105), rgb(160, 110, 80), rgb(110, 75, 55) })[math.random(1, 4)]
	desc.HeadColor = skin
	desc.LeftArmColor = skin
	desc.RightArmColor = skin
	desc.TorsoColor = rgb(60, 60, 70)
	desc.LeftLegColor = rgb(40, 40, 46)
	desc.RightLegColor = rgb(40, 40, 46)
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		return nil
	end
	model.Name = "RoyalGuard"
	local hum = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.DisplayWhenDamaged
	hum.MaxHealth = 120
	hum.Health = 120
	hum.WalkSpeed = 15
	for _, s in model:GetDescendants() do
		if s:IsA("Script") or s:IsA("LocalScript") then
			s:Destroy()
		end
	end
	dressMinion(model)
	model:SetAttribute("Minion", true)
	model:PivotTo(at)
	model.Parent = parent
	local root = rootOf(model)
	if root then
		pcall(function()
			root:SetNetworkOwner(nil)
		end)
	end
	local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum)
	local function load(id)
		local a = Instance.new("Animation")
		a.AnimationId = id
		local ok2, track = pcall(function()
			return animator:LoadAnimation(a)
		end)
		return if ok2 then track else nil
	end
	local m = { model = model, hum = hum, walk = load(WALK_ANIM), idle = load(IDLE_ANIM), slash = load(SLASH_ANIM), lastHit = 0, path = nil, pathAt = 0, wp = 1 }
	if m.idle then
		m.idle.Looped = true
		m.idle:Play()
	end
	if m.walk then
		m.walk.Looped = true
	end
	hum.Running:Connect(function(speed)
		if not m.walk then
			return
		end
		if speed &gt; 0.5 then
			if not m.walk.IsPlaying then
				m.walk:Play(0.15)
			end
			m.walk:AdjustSpeed(speed / 14)
		elseif m.walk.IsPlaying then
			m.walk:Stop(0.2)
		end
	end)
	hum.Died:Connect(function()
		task.delay(4, function()
			model:Destroy()
		end)
	end)
	table.insert(Npc.minions, m)
	return m
end

function Npc.clearMinions()
	for _, m in Npc.minions do
		if m.model then
			m.model:Destroy()
		end
	end
	table.clear(Npc.minions)
end

-- идти к точке: напрямую, если путь свободен, иначе по навигационной сетке
local function goTo(m, goal: Vector3)
	local root = rootOf(m.model)
	if not root then
		return
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { m.model }
	local dir = goal - root.Position
	local hit = workspace:Raycast(root.Position, dir, params)
	if not hit or (hit.Position - goal).Magnitude &lt; 4 then
		m.path = nil
		m.hum:MoveTo(goal)
		return
	end
	local now = os.clock()
	if not m.path or now - m.pathAt &gt; 1.5 then
		m.pathAt = now
		local path = PathfindingService:CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = true })
		local ok = pcall(function()
			path:ComputeAsync(root.Position, goal)
		end)
		if ok and path.Status == Enum.PathStatus.Success then
			m.path = path:GetWaypoints()
			m.wp = 2
		else
			m.path = nil
			m.hum:MoveTo(goal)
			return
		end
	end
	local wps = m.path
	if wps and wps[m.wp] then
		local w = wps[m.wp]
		if (Vector3.new(w.Position.X, root.Position.Y, w.Position.Z) - root.Position).Magnitude &lt; 3 then
			m.wp += 1
			w = wps[m.wp] or w
		end
		if w.Action == Enum.PathWaypointAction.Jump then
			m.hum.Jump = true
		end
		m.hum:MoveTo(w.Position)
	end
end

-- Один шаг поведения всех стражников. leader — король (или nil), target — цель атаки
function Npc.stepMinions(leader: Player?, target: Model?, onHit: (Model, Humanoid) -&gt; ())
	local leaderRoot = leader and rootOf(leader.Character)
	local i = 0
	for k = #Npc.minions, 1, -1 do
		local m = Npc.minions[k]
		if not m.model.Parent or m.hum.Health &lt;= 0 then
			table.remove(Npc.minions, k)
		end
	end
	for _, m in Npc.minions do
		i += 1
		local root = rootOf(m.model)
		if not root then
			continue
		end
		local tRoot = target and aliveHum(target) and rootOf(target)
		if tRoot then
			local d = (tRoot.Position - root.Position).Magnitude
			if d &gt; 4.5 then
				goTo(m, tRoot.Position)
			else
				m.hum:MoveTo(root.Position)
				root.CFrame = CFrame.lookAt(root.Position, Vector3.new(tRoot.Position.X, root.Position.Y, tRoot.Position.Z))
			end
			if d &lt; 6 and os.clock() - m.lastHit &gt; 1 then
				m.lastHit = os.clock()
				if m.slash then
					m.slash:Play()
				end
				onHit(target :: Model, aliveHum(target) :: Humanoid)
			end
		elseif leaderRoot then
			-- строй позади короля
			local side = if i % 2 == 0 then 1 else -1
			local row = math.ceil(i / 2)
			local spot = (leaderRoot.CFrame * CFrame.new(side * 3, 0, 4 + row * 3.5)).Position
			if (spot - root.Position).Magnitude &gt; 3 then
				goTo(m, spot)
			end
		end
	end
end

-- ---------------------------------------------------------------------------
-- Тренировочный манекен: принимает удары и отвечает

function Npc.buildDummy(at: CFrame, parent: Instance)
	local m = Instance.new("Model")
	m.Name = "TrainingDummy"
	local function p(name, size, cf, color, mat)
		local x = Instance.new("Part")
		x.Name = name
		x.Size = size
		x.CFrame = at * cf
		x.Color = color
		x.Material = mat
		x.Anchored = true
		x.Parent = m
		return x
	end
	local root = p("HumanoidRootPart", Vector3.new(2, 2, 1), CFrame.new(0, 0, 0), rgb(150, 120, 80), Enum.Material.Fabric)
	root.Transparency = 1
	p("Post", Vector3.new(0.6, 6, 0.6), CFrame.new(0, -1, 0), rgb(90, 62, 40), Enum.Material.Wood)
	p("Base", Vector3.new(3, 0.6, 3), CFrame.new(0, -3.7, 0), rgb(70, 50, 34), Enum.Material.Wood)
	p("Torso", Vector3.new(2, 2.4, 1.1), CFrame.new(0, 0.6, 0), rgb(196, 168, 120), Enum.Material.Fabric)
	local head = p("Head", Vector3.new(1.3, 1.3, 1.3), CFrame.new(0, 2.5, 0), rgb(196, 168, 120), Enum.Material.Fabric)
	head.Shape = Enum.PartType.Ball
	local arm = p("Arm", Vector3.new(3.6, 0.5, 0.5), CFrame.new(0, 1.2, -0.2), rgb(90, 62, 40), Enum.Material.Wood)
	p("Target", Vector3.new(1.2, 1.2, 0.1), CFrame.new(0, 0.7, -0.6), rgb(170, 30, 30), Enum.Material.Fabric)
	local hum = Instance.new("Humanoid")
	hum.MaxHealth = 400
	hum.Health = 400
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOn
	hum.BreakJointsOnDeath = false
	hum.Parent = m
	m.PrimaryPart = root
	m:SetAttribute("Dummy", true)
	m.Parent = parent
	local home = arm.CFrame
	local busy = false
	local dummy = { model = m, hum = hum }
	-- удар в ответ: рука-палка разворачивается в сторону обидчика
	function dummy.onHit(attacker: Model)
		hum.Health = math.max(1, hum.Health)
		if busy then
			return
		end
		busy = true
		task.delay(0.35, function()
			local aRoot = rootOf(attacker)
			if aRoot then
				local swing = TweenService:Create(arm, TweenInfo.new(0.18, Enum.EasingStyle.Back), { CFrame = home * CFrame.Angles(0, math.rad(80), 0) })
				swing:Play()
				swing.Completed:Wait()
				local d = (aRoot.Position - root.Position).Magnitude
				local ah = aliveHum(attacker)
				if ah and d &lt; 8 then
					ah:TakeDamage(6)
					aRoot.AssemblyLinearVelocity = (aRoot.Position - root.Position).Unit * 30 + Vector3.new(0, 15, 0)
				end
				TweenService:Create(arm, TweenInfo.new(0.4), { CFrame = home }):Play()
			end
			busy = false
		end)
	end
	task.spawn(function()
		while m.Parent do
			task.wait(2)
			if hum.Health &lt; hum.MaxHealth then
				hum.Health = math.min(hum.MaxHealth, hum.Health + 40)
			end
		end
	end)
	return dummy
end

-- ---------------------------------------------------------------------------
-- Парящая статуя жреца в мантии с книгой; покачивание делает клиент (атрибут Float)

function Npc.buildPriest(at: CFrame, parent: Instance)
	local m = Instance.new("Model")
	m.Name = "FloatingPriest"
	local STONE = rgb(190, 186, 178)
	local function p(name, shape, size, cf, color, mat)
		local x = Instance.new("Part")
		x.Name = name
		x.Shape = shape or Enum.PartType.Block
		x.Size = size
		x.CFrame = at * cf
		x.Color = color or STONE
		x.Material = mat or Enum.Material.Marble
		x.Anchored = true
		x.CanCollide = false
		x.Parent = m
		return x
	end
	local Cyl, Ball = Enum.PartType.Cylinder, Enum.PartType.Ball
	-- мантия: расширяется книзу
	for k = 0, 4 do
		local r = 4.2 - k * 0.55
		p("Robe", Cyl, Vector3.new(1.3, r, r), CFrame.new(0, k * 1.2, 0) * CFrame.Angles(0, 0, math.pi / 2))
	end
	p("Shoulders", Ball, Vector3.new(3.2, 1.4, 2.2), CFrame.new(0, 6, 0))
	p("Head", Ball, Vector3.new(1.5, 1.6, 1.5), CFrame.new(0, 7.2, 0))
	p("Hood", Ball, Vector3.new(2, 2.1, 2), CFrame.new(0, 7.35, 0.25))
	p("Beard", nil, Vector3.new(0.9, 1.2, 0.3), CFrame.new(0, 6.6, -0.7))
	for _, s in { -1, 1 } do
		p("Sleeve", nil, Vector3.new(0.8, 0.8, 2.4), CFrame.new(s * 1.1, 5.3, -1) * CFrame.Angles(math.rad(-15), 0, 0))
		p("Hand", Ball, Vector3.new(0.6, 0.6, 0.6), CFrame.new(s * 0.9, 5.1, -2.2))
	end
	-- раскрытая книга со светящимися страницами
	p("Cover", nil, Vector3.new(2.6, 0.15, 1.7), CFrame.new(0, 5.3, -2.4) * CFrame.Angles(math.rad(-25), 0, 0), rgb(120, 40, 40), Enum.Material.Fabric)
	local pages = p("Pages", nil, Vector3.new(2.4, 0.12, 1.5), CFrame.new(0, 5.42, -2.42) * CFrame.Angles(math.rad(-25), 0, 0), rgb(255, 236, 190), Enum.Material.Neon)
	local light = Instance.new("PointLight")
	light.Color = rgb(255, 220, 160)
	light.Range = 16
	light.Brightness = 1.4
	light.Parent = pages
	local dust = Instance.new("ParticleEmitter")
	dust.Rate = 6
	dust.Lifetime = NumberRange.new(2, 3)
	dust.Speed = NumberRange.new(0.5, 1)
	dust.Size = NumberSequence.new(0.15)
	dust.LightEmission = 1
	dust.Color = ColorSequence.new(rgb(255, 230, 170))
	dust.Parent = pages
	m:SetAttribute("Float", true)
	m.Parent = parent
	return m
end

return Npc
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000032">
          <Properties>
            <string name="Name">Outfits</string>
            <ProtectedString name="Source">--!nonstrict
-- Одежда ролей и украшения из магазина. Всё — простые детали, приваренные к персонажу,
-- поэтому работает с любым аватаром (R15 и R6) и не требует загрузки ассетов

local Npc = require(script.Parent.Npc)

local Outfits = {}

local weld = Npc.weldPart

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end
local GOLD = rgb(214, 172, 80)
local STEEL = rgb(170, 172, 180)

local function partOf(char: Model, ...): BasePart?
	for _, n in { ... } do
		local p = char:FindFirstChild(n)
		if p and p:IsA("BasePart") then
			return p
		end
	end
	return nil
end

local function headTop(head: BasePart, h: number): CFrame
	return CFrame.new(0, head.Size.Y / 2 + h / 2 - 0.05, 0)
end

local function crown(f, head, big)
	local s = if big then 1 else 0.8
	weld(f, head, { Name = "CrownBand", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.45 * s, 1.25 * s, 1.25 * s), Color = GOLD, Material = Enum.Material.Metal }, headTop(head, 0.45) * CFrame.Angles(0, 0, math.pi / 2))
	for k = 0, 4 do
		local a = k / 5 * math.pi * 2
		weld(f, head, { Name = "CrownSpike", Size = Vector3.new(0.18, 0.45 * s, 0.18), Color = GOLD, Material = Enum.Material.Metal }, headTop(head, 0.45) * CFrame.new(math.cos(a) * 0.55 * s, 0.4 * s, math.sin(a) * 0.55 * s))
		weld(f, head, { Name = "Gem", Shape = Enum.PartType.Ball, Size = Vector3.new(0.16, 0.16, 0.16), Color = if k % 2 == 0 then rgb(200, 30, 50) else rgb(40, 90, 220), Material = Enum.Material.Neon }, headTop(head, 0.45) * CFrame.new(math.cos(a) * 0.63 * s, 0, math.sin(a) * 0.63 * s))
	end
end

local function cape(f, torso, color)
	weld(f, torso, { Name = "Cape", Size = Vector3.new(1.9, 3.6, 0.12), Color = color, Material = Enum.Material.Fabric }, CFrame.new(0, -0.9, 0.62) * CFrame.Angles(math.rad(6), 0, 0))
	weld(f, torso, { Name = "CapeCollar", Size = Vector3.new(2.1, 0.3, 1.2), Color = rgb(240, 236, 228), Material = Enum.Material.Fabric }, CFrame.new(0, torso.Size.Y / 2, 0))
end

local function front(f, torso, color, h)
	weld(f, torso, { Name = "Front", Size = Vector3.new(torso.Size.X * 0.85, h or torso.Size.Y * 0.95, 0.1), Color = color, Material = Enum.Material.Fabric }, CFrame.new(0, -0.1, -torso.Size.Z / 2 - 0.05))
end

local function hat(f, head, color, r, h, mat)
	weld(f, head, { Name = "Hat", Shape = Enum.PartType.Cylinder, Size = Vector3.new(h, r, r), Color = color, Material = mat or Enum.Material.Fabric }, headTop(head, h) * CFrame.Angles(0, 0, math.pi / 2))
end

-- role: одежда роли; worn: { [id] = true } — украшения из магазина
function Outfits.apply(char: Model, role: string?, worn: { [string]: boolean }?)
	local old = char:FindFirstChild("CastleOutfit")
	if old then
		old:Destroy()
	end
	local f = Instance.new("Folder")
	f.Name = "CastleOutfit"
	f.Parent = char
	local head = partOf(char, "Head")
	local torso = partOf(char, "UpperTorso", "Torso")
	if not head or not torso then
		return
	end
	if role == "king" then
		crown(f, head, true)
		cape(f, torso, rgb(150, 20, 30))
	elseif role == "queen" then
		crown(f, head, false)
		cape(f, torso, rgb(110, 40, 140))
	elseif role == "commander" then
		weld(f, head, { Name = "Helmet", Size = Vector3.new(head.Size.X * 1.1, 0.8, head.Size.Z * 1.1), Color = STEEL, Material = Enum.Material.Metal }, headTop(head, 0.8) * CFrame.new(0, -0.35, 0))
		weld(f, head, { Name = "Plume", Size = Vector3.new(0.2, 0.9, 1.2), Color = rgb(170, 20, 30), Material = Enum.Material.Fabric }, headTop(head, 0.9) * CFrame.new(0, 0.35, 0.1))
		cape(f, torso, rgb(30, 40, 80))
		front(f, torso, rgb(150, 20, 30))
	elseif role == "guard" then
		weld(f, head, { Name = "Helmet", Size = Vector3.new(head.Size.X * 1.1, 0.8, head.Size.Z * 1.1), Color = STEEL, Material = Enum.Material.Metal }, headTop(head, 0.8) * CFrame.new(0, -0.35, 0))
		front(f, torso, rgb(150, 20, 30))
		weld(f, torso, { Name = "Emblem", Size = Vector3.new(0.6, 0.6, 0.05), Color = GOLD, Material = Enum.Material.Metal }, CFrame.new(0, 0.2, -torso.Size.Z / 2 - 0.12))
	elseif role == "cook" then
		hat(f, head, rgb(250, 250, 250), 1.3, 1.2)
		front(f, torso, rgb(245, 245, 240))
	elseif role == "servant" then
		hat(f, head, rgb(80, 80, 90), 1.25, 0.35)
		front(f, torso, rgb(230, 225, 215), torso.Size.Y * 0.7)
	elseif role == "librarian" then
		weld(f, head, { Name = "Hood", Shape = Enum.PartType.Ball, Size = head.Size * 1.25, Color = rgb(70, 50, 90), Material = Enum.Material.Fabric }, CFrame.new(0, 0.1, 0.12))
		front(f, torso, rgb(70, 50, 90))
	elseif role == "peasant" then
		hat(f, head, rgb(214, 186, 110), 2.4, 0.2, Enum.Material.Grass)
		hat(f, head, rgb(214, 186, 110), 1.2, 0.5, Enum.Material.Grass)
	end
	worn = worn or {}
	if worn.flower_crown and role ~= "king" and role ~= "queen" then
		for k = 0, 7 do
			local a = k / 8 * math.pi * 2
			weld(f, head, { Name = "Flower", Shape = Enum.PartType.Ball, Size = Vector3.new(0.3, 0.3, 0.3), Color = Color3.fromHSV(k / 8, 0.5, 1), Material = Enum.Material.SmoothPlastic }, headTop(head, 0.3) * CFrame.new(math.cos(a) * 0.62, -0.1, math.sin(a) * 0.62))
		end
	end
	if worn.cape_red and role ~= "king" then
		cape(f, torso, rgb(170, 30, 40))
	elseif worn.cape_blue and role ~= "king" then
		cape(f, torso, rgb(40, 70, 160))
	end
	if worn.halo then
		weld(f, head, { Name = "Halo", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.12, 1.5, 1.5), Color = rgb(255, 230, 140), Material = Enum.Material.Neon, Transparency = 0.15 }, headTop(head, 0.1) * CFrame.new(0, 0.9, 0) * CFrame.Angles(0, 0, math.pi / 2))
	end
	if worn.glasses then
		for _, s in { -1, 1 } do
			weld(f, head, { Name = "Lens", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.06, 0.4, 0.4), Color = rgb(30, 30, 34), Material = Enum.Material.Glass, Transparency = 0.2 }, CFrame.new(s * 0.25, 0.15, -head.Size.Z / 2 - 0.03) * CFrame.Angles(0, math.pi / 2, 0))
		end
		weld(f, head, { Name = "Bridge", Size = Vector3.new(0.12, 0.05, 0.05), Color = rgb(30, 30, 34), Material = Enum.Material.Metal }, CFrame.new(0, 0.2, -head.Size.Z / 2 - 0.03))
	end
	if worn.feather_hat and role ~= "king" and role ~= "queen" and role ~= "guard" and role ~= "commander" then
		hat(f, head, rgb(60, 40, 90), 1.9, 0.6)
		weld(f, head, { Name = "Feather", Size = Vector3.new(0.12, 1.5, 0.4), Color = rgb(240, 240, 255), Material = Enum.Material.Fabric }, headTop(head, 0.6) * CFrame.new(0.5, 0.7, 0.2) * CFrame.Angles(0, 0, math.rad(-25)))
	end
	if worn.backpack then
		weld(f, torso, { Name = "Backpack", Size = Vector3.new(1.4, 1.6, 0.8), Color = rgb(120, 85, 50), Material = Enum.Material.Fabric }, CFrame.new(0, 0, torso.Size.Z / 2 + 0.45))
	end
	if worn.wings then
		for _, s in { -1, 1 } do
			weld(f, torso, { Name = "Wing", Size = Vector3.new(2.6, 3, 0.1), Color = rgb(250, 250, 255), Material = Enum.Material.SmoothPlastic, Transparency = 0.1 }, CFrame.new(s * 1.4, 0.5, torso.Size.Z / 2 + 0.3) * CFrame.Angles(0, s * math.rad(30), s * math.rad(-15)))
		end
	end
end

return Outfits
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000033">
          <Properties>
            <string name="Name">Props</string>
            <ProtectedString name="Source">--!nonstrict
-- Детализированные модели замка, собранные из деталей: двери с филёнками и номерами,
-- окна со шторами, бра, люстры, ковры, картины, комоды, шкафы, кровати, столы, стулья,
-- камины, доспехи, растения, часы, пианино и многое другое.
-- Правило координат: cf — центр основания на полу, LookVector смотрит «лицом» в комнату

local CollectionService = game:GetService("CollectionService")

local Props = {}

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end
Props.rgb = rgb

local M = Enum.Material
local CYL = Enum.PartType.Cylinder
local BALL = Enum.PartType.Ball

Props.WOOD = rgb(86, 56, 36)
Props.WOOD_DARK = rgb(52, 34, 24)
Props.WOOD_LIGHT = rgb(132, 92, 58)
Props.GOLD = rgb(206, 166, 82)
Props.IRON = rgb(46, 44, 42)
Props.STONE = rgb(148, 142, 132)
Props.STONE_DARK = rgb(96, 92, 88)
Props.CLOTH = rgb(236, 230, 214)

local count = 0
function Props.count()
	return count
end

-- Основная деталь: всё закреплено, без лишних поверхностей
local function P(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, mat: Enum.Material?, extra)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = mat or M.SmoothPlastic
	if extra then
		for k, v in extra do
			(p :: any)[k] = v
		end
	end
	p.Parent = parent
	count += 1
	return p
end
Props.P = P

-- цилиндр стоя (ось Y)
local function C(parent, name, h: number, d: number, cf: CFrame, color, mat, extra)
	local p = P(parent, name, Vector3.new(h, d, d), cf * CFrame.Angles(0, 0, math.pi / 2), color, mat, extra)
	p.Shape = CYL
	return p
end
Props.C = C

local function S(parent, name, d: number, cf: CFrame, color, mat, extra)
	local p = P(parent, name, Vector3.new(d, d, d), cf, color, mat, extra)
	p.Shape = BALL
	return p
end
Props.S = S

local function model(parent: Instance, name: string): Model
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end
Props.model = model

local function light(at: Instance, range: number, brightness: number, color: Color3?)
	local l = Instance.new("PointLight")
	l.Range = range
	l.Brightness = brightness
	l.Color = color or rgb(255, 196, 130)
	l.Shadows = false
	l.Parent = at
	return l
end
Props.light = light

local NOCOL = { CanCollide = false }
local function nc(extra)
	local t = { CanCollide = false, CanQuery = false, CastShadow = false }
	for k, v in extra or {} do
		t[k] = v
	end
	return t
end

-- ---------------------------------------------------------------------------
-- двери, окна, свет

local doorNumber = 0

-- Дверной проём с рамой и одной или двумя створками. cf — центр проёма на полу,
-- LookVector перпендикулярен стене. Створки не мешают проходу: открываются у игрока
function Props.door(parent, cf: CFrame, w: number, h: number, color: Color3?, double: boolean?)
	local m = model(parent, "Door")
	local wood = color or Props.WOOD
	local frame = Props.WOOD_DARK
	P(m, "Jamb", Vector3.new(0.7, h + 0.7, 1.6), cf * CFrame.new(-w / 2 - 0.35, (h + 0.7) / 2, 0), frame, M.Wood)
	P(m, "Jamb", Vector3.new(0.7, h + 0.7, 1.6), cf * CFrame.new(w / 2 + 0.35, (h + 0.7) / 2, 0), frame, M.Wood)
	P(m, "Head", Vector3.new(w + 2.2, 0.8, 1.7), cf * CFrame.new(0, h + 0.4, 0), frame, M.Wood)
	P(m, "Cap", Vector3.new(w + 2.8, 0.3, 1.9), cf * CFrame.new(0, h + 0.95, 0), frame, M.Wood)
	local leaves = if double then { { -w / 2, w / 2, 1 }, { w / 2, w / 2, -1 } } else { { -w / 2, w, 1 } }
	for _, lf in leaves do
		local hingeX, lw, dir = lf[1], lf[2], lf[3]
		local leaf = model(m, "Leaf")
		local base = cf * CFrame.new(hingeX + dir * lw / 2, 0, 0)
		P(leaf, "Slab", Vector3.new(lw - 0.1, h - 0.1, 0.32), base * CFrame.new(0, h / 2, 0), wood, M.Wood, nc())
		-- филёнки с обеих сторон: две высокие и две низкие
		for _, side in { -1, 1 } do
			for _, pz in { { 0.62, 0.42 }, { 0.2, 0.3 } } do
				for _, px in { -0.22, 0.22 } do
					local pw = lw * 0.36
					local ph = h * pz[2]
					P(leaf, "Panel", Vector3.new(pw, ph, 0.08), base * CFrame.new(px * lw, h * pz[1] + (if pz[1] &gt; 0.5 then 0 else 0.4), side * 0.19), wood:Lerp(Props.WOOD_DARK, 0.3), M.Wood, nc())
				end
			end
			S(leaf, "Knob", 0.36, base * CFrame.new(-dir * (lw / 2 - 0.5), h * 0.45, side * 0.3), Props.GOLD, M.Metal, nc())
		end
		for _, hy in { 0.2, 0.8 } do
			P(leaf, "Hinge", Vector3.new(0.15, 0.6, 0.4), base * CFrame.new(-dir * lw / 2, h * hy, 0), Props.IRON, M.Metal, nc())
		end
		leaf.WorldPivot = cf * CFrame.new(hingeX, 0, 0)
		leaf:SetAttribute("Dir", dir)
	end
	-- табличка с номером, как в старом отеле
	doorNumber += 1
	local plate = P(m, "Plate", Vector3.new(1.6, 0.6, 0.06), cf * CFrame.new(0, h + 0.4, -0.88), Props.GOLD, M.Metal, nc())
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.CanvasSize = Vector2.new(160, 60)
	gui.LightInfluence = 1
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Text = string.format("%04d", doorNumber)
	t.Font = Enum.Font.Garamond
	t.TextScaled = true
	t.TextColor3 = rgb(40, 28, 16)
	t.Parent = gui
	gui.Parent = plate
	pcall(function()
		m.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	end)
	CollectionService:AddTag(m, "CastleDoor")
	return m
end

-- Окно на внешней стене: каменный откос, рама с переплётом, стекло, подоконник,
-- внутри шторы. cf — центр окна, LookVector смотрит наружу
function Props.window(parent, cf: CFrame, w: number, h: number, thick: number)
	local m = model(parent, "Window")
	local stone = Props.STONE_DARK
	P(m, "Sill", Vector3.new(w + 1.4, 0.5, thick + 1.2), cf * CFrame.new(0, -h / 2 - 0.25, 0), stone, M.Slate)
	P(m, "Lintel", Vector3.new(w + 1.4, 0.9, thick + 0.6), cf * CFrame.new(0, h / 2 + 0.45, 0), stone, M.Slate)
	-- полукруглый верх из ступенек
	for k = 1, 3 do
		local ww = w * (1 - k * 0.22)
		P(m, "Arch", Vector3.new(ww, 0.5, thick + 0.2), cf * CFrame.new(0, h / 2 - 0.25 - (3 - k) * 0, 0) * CFrame.new(0, -0.5 * k + 0.5, 0), stone, M.Slate, nc())
	end
	P(m, "Glass", Vector3.new(w, h, 0.15), cf, rgb(150, 182, 206), M.Glass, nc({ Transparency = 0.55 }))
	P(m, "FrameL", Vector3.new(0.35, h, 0.5), cf * CFrame.new(-w / 2, 0, 0), Props.WOOD_DARK, M.Wood)
	P(m, "FrameR", Vector3.new(0.35, h, 0.5), cf * CFrame.new(w / 2, 0, 0), Props.WOOD_DARK, M.Wood)
	P(m, "Mullion", Vector3.new(0.2, h, 0.35), cf, Props.WOOD_DARK, M.Wood, nc())
	for _, y in { -h / 4, h / 4 } do
		P(m, "Transom", Vector3.new(w, 0.2, 0.35), cf * CFrame.new(0, y, 0), Props.WOOD_DARK, M.Wood, nc())
	end
	return m
end

-- Шторы с внутренней стороны окна. cf — центр окна, LookVector в комнату
function Props.curtains(parent, cf: CFrame, w: number, h: number, color: Color3)
	local m = model(parent, "Curtains")
	P(m, "Rod", Vector3.new(w + 3, 0.2, 0.2), cf * CFrame.new(0, h / 2 + 1, -0.4), Props.GOLD, M.Metal, nc())
	for _, s in { -1, 1 } do
		for k = 0, 2 do
			P(m, "Drape", Vector3.new(0.7, h + 1.6, 0.25), cf * CFrame.new(s * (w / 2 + 0.3 + k * 0.45), -0.2, -0.45 - (k % 2) * 0.12), color:Lerp(rgb(0, 0, 0), k * 0.08), M.Fabric, nc())
		end
		P(m, "Tie", Vector3.new(1.6, 0.25, 0.4), cf * CFrame.new(s * (w / 2 + 0.75), -h * 0.15, -0.6), Props.GOLD, M.Fabric, nc())
	end
	P(m, "Valance", Vector3.new(w + 3, 1, 0.3), cf * CFrame.new(0, h / 2 + 0.5, -0.55), color:Lerp(rgb(0, 0, 0), 0.15), M.Fabric, nc())
	return m
end

-- Бра на стене: подложка, кронштейн, стеклянный плафон и тёплый свет.
-- cf — точка на стене, LookVector от стены
function Props.sconce(parent, cf: CFrame, withLight: boolean?)
	local m = model(parent, "Sconce")
	P(m, "Plate", Vector3.new(0.8, 1.4, 0.12), cf * CFrame.new(0, 0, -0.06), Props.GOLD, M.Metal, nc())
	P(m, "Arm", Vector3.new(0.18, 0.18, 1), cf * CFrame.new(0, -0.2, -0.55), Props.GOLD, M.Metal, nc())
	C(m, "Cup", 0.25, 0.6, cf * CFrame.new(0, 0, -1.05), Props.GOLD, M.Metal, nc())
	local shade = C(m, "Shade", 0.9, 0.75, cf * CFrame.new(0, 0.55, -1.05), rgb(255, 214, 160), M.Neon, nc({ Transparency = 0.25 }))
	if withLight ~= false then
		light(shade, 16, 1.1)
	end
	return m
end

-- Подвесной светильник в духе старого отеля: штанга, абажур-колокол, лампа
function Props.ceilingLamp(parent, pos: Vector3, drop: number?)
	local m = model(parent, "CeilingLamp")
	local d = drop or 3
	P(m, "Rod", Vector3.new(0.15, d, 0.15), CFrame.new(pos + Vector3.new(0, d / 2, 0)), Props.IRON, M.Metal, nc())
	C(m, "Canopy", 0.3, 1, CFrame.new(pos + Vector3.new(0, d - 0.15, 0)), Props.GOLD, M.Metal, nc())
	for k = 0, 2 do
		C(m, "Shade", 0.45, 1.6 + k * 0.7, CFrame.new(pos - Vector3.new(0, k * 0.4, 0)), rgb(70, 40, 30), M.Fabric, nc())
	end
	local bulb = S(m, "Bulb", 0.7, CFrame.new(pos - Vector3.new(0, 1, 0)), rgb(255, 220, 170), M.Neon, nc())
	light(bulb, 26, 1.4)
	return m
end

-- Люстра со свечами. size — радиус кольца
function Props.chandelier(parent, pos: Vector3, size: number?, drop: number?)
	local r = size or 3
	local d = drop or 4
	local m = model(parent, "Chandelier")
	P(m, "Chain", Vector3.new(0.2, d, 0.2), CFrame.new(pos + Vector3.new(0, d / 2, 0)), Props.IRON, M.Metal, nc())
	C(m, "Hub", 1.2, 1, CFrame.new(pos), Props.GOLD, M.Metal, nc())
	S(m, "Finial", 0.8, CFrame.new(pos - Vector3.new(0, 1, 0)), Props.GOLD, M.Metal, nc())
	for ring = 1, (if r &gt; 4 then 2 else 1) do
		local rr = r * ring / (if r &gt; 4 then 2 else 1)
		local y = -0.2 - (ring - 1) * 1.2
		local n = math.max(6, math.floor(rr * 2.5))
		P(m, "Ring", Vector3.new(0.25, rr * 2, rr * 2), CFrame.new(pos + Vector3.new(0, y, 0)) * CFrame.Angles(0, 0, math.pi / 2), Props.GOLD, M.Metal, nc({ Shape = CYL }))
		for k = 0, n - 1 do
			local a = k / n * math.pi * 2
			local cp = pos + Vector3.new(math.cos(a) * rr, y + 0.35, math.sin(a) * rr)
			C(m, "Cup", 0.2, 0.45, CFrame.new(cp), Props.GOLD, M.Metal, nc())
			C(m, "Candle", 0.6, 0.22, CFrame.new(cp + Vector3.new(0, 0.4, 0)), rgb(245, 238, 220), M.SmoothPlastic, nc())
			S(m, "Flame", 0.22, CFrame.new(cp + Vector3.new(0, 0.82, 0)), rgb(255, 190, 90), M.Neon, nc())
		end
	end
	local core = S(m, "Glow", 0.4, CFrame.new(pos), rgb(255, 210, 150), M.Neon, nc({ Transparency = 1 }))
	light(core, math.clamp(r * 9, 26, 60), 1.6)
	return m
end

-- Свеча на подсвечнике (без источника света)
function Props.candle(parent, pos: Vector3, h: number?)
	local m = model(parent, "Candle")
	local hh = h or 0.8
	C(m, "Dish", 0.12, 0.7, CFrame.new(pos + Vector3.new(0, 0.06, 0)), Props.GOLD, M.Metal, nc())
	C(m, "Wax", hh, 0.26, CFrame.new(pos + Vector3.new(0, 0.12 + hh / 2, 0)), rgb(245, 238, 220), M.SmoothPlastic, nc())
	S(m, "Flame", 0.24, CFrame.new(pos + Vector3.new(0, 0.3 + hh, 0)), rgb(255, 190, 90), M.Neon, nc())
	return m
end

-- Канделябр на три свечи
function Props.candelabra(parent, pos: Vector3)
	local m = model(parent, "Candelabra")
	C(m, "Foot", 0.2, 1, CFrame.new(pos + Vector3.new(0, 0.1, 0)), Props.GOLD, M.Metal, nc())
	C(m, "Stem", 1.6, 0.18, CFrame.new(pos + Vector3.new(0, 0.9, 0)), Props.GOLD, M.Metal, nc())
	P(m, "Arms", Vector3.new(1.8, 0.14, 0.14), CFrame.new(pos + Vector3.new(0, 1.6, 0)), Props.GOLD, M.Metal, nc())
	for _, x in { -0.9, 0, 0.9 } do
		C(m, "Wax", 0.7, 0.2, CFrame.new(pos + Vector3.new(x, 2.05, 0)), rgb(245, 238, 220), M.SmoothPlastic, nc())
		S(m, "Flame", 0.22, CFrame.new(pos + Vector3.new(x, 2.55, 0)), rgb(255, 190, 90), M.Neon, nc())
	end
	return m
end

-- ---------------------------------------------------------------------------
-- текстиль и стены

-- Ковёр: основа, кайма, поле и медальон в центре
function Props.rug(parent, cf: CFrame, w: number, d: number, color: Color3, accent: Color3?)
	local m = model(parent, "Rug")
	local a = accent or Props.GOLD
	P(m, "Base", Vector3.new(w, 0.1, d), cf * CFrame.new(0, 0.05, 0), color, M.Fabric, nc())
	P(m, "Border", Vector3.new(w - 1, 0.11, d - 1), cf * CFrame.new(0, 0.06, 0), a:Lerp(color, 0.35), M.Fabric, nc())
	P(m, "Field", Vector3.new(w - 1.8, 0.12, d - 1.8), cf * CFrame.new(0, 0.07, 0), color:Lerp(rgb(0, 0, 0), 0.15), M.Fabric, nc())
	local md = math.min(w, d) * 0.4
	C(m, "Medallion", 0.13, md, cf * CFrame.new(0, 0.075, 0), a:Lerp(color, 0.5), M.Fabric, nc())
	C(m, "Center", 0.14, md * 0.45, cf * CFrame.new(0, 0.08, 0), color, M.Fabric, nc())
	return m
end

-- Дорожка вдоль коридора с узором из ромбов
function Props.runner(parent, cf: CFrame, w: number, len: number, color: Color3)
	local m = model(parent, "Runner")
	P(m, "Base", Vector3.new(w, 0.1, len), cf * CFrame.new(0, 0.05, 0), color, M.Fabric, nc())
	for _, s in { -1, 1 } do
		P(m, "Stripe", Vector3.new(0.35, 0.11, len), cf * CFrame.new(s * (w / 2 - 0.5), 0.06, 0), Props.GOLD:Lerp(color, 0.3), M.Fabric, nc())
	end
	local n = math.floor(len / 5)
	for k = 0, n - 1 do
		local z = -len / 2 + 2.5 + k * 5
		P(m, "Diamond", Vector3.new(1.2, 0.11, 1.2), cf * CFrame.new(0, 0.06, z) * CFrame.Angles(0, math.pi / 4, 0), Props.GOLD:Lerp(color, 0.45), M.Fabric, nc())
	end
	return m
end

-- Картина в золочёной раме. cf — центр на стене, LookVector в комнату
function Props.painting(parent, cf: CFrame, w: number, h: number, seed: number)
	local m = model(parent, "Painting")
	local f = 0.35
	local base = cf * CFrame.new(0, 0, -0.12)
	P(m, "Back", Vector3.new(w, h, 0.12), base, Props.WOOD_DARK, M.Wood, nc())
	P(m, "FrameT", Vector3.new(w + f * 2, f, 0.3), base * CFrame.new(0, h / 2 + f / 2, -0.05), Props.GOLD, M.Metal, nc())
	P(m, "FrameB", Vector3.new(w + f * 2, f, 0.3), base * CFrame.new(0, -h / 2 - f / 2, -0.05), Props.GOLD, M.Metal, nc())
	P(m, "FrameL", Vector3.new(f, h, 0.3), base * CFrame.new(-w / 2 - f / 2, 0, -0.05), Props.GOLD, M.Metal, nc())
	P(m, "FrameR", Vector3.new(f, h, 0.3), base * CFrame.new(w / 2 + f / 2, 0, -0.05), Props.GOLD, M.Metal, nc())
	local c = base * CFrame.new(0, 0, -0.08)
	local kind = seed % 3
	if kind == 0 then
		-- пейзаж: небо, холмы, солнце
		local sky = Color3.fromHSV(0.55 + (seed % 5) * 0.02, 0.35, 0.75)
		P(m, "Sky", Vector3.new(w, h * 0.55, 0.04), c * CFrame.new(0, h * 0.225, 0), sky, M.SmoothPlastic, nc())
		P(m, "Land", Vector3.new(w, h * 0.45, 0.04), c * CFrame.new(0, -h * 0.275, 0), rgb(70, 96, 52), M.SmoothPlastic, nc())
		P(m, "Hill", Vector3.new(w * 0.6, h * 0.3, 0.05), c * CFrame.new(-w * 0.15, -h * 0.05, -0.01) * CFrame.Angles(0, 0, math.rad(12)), rgb(58, 82, 44), M.SmoothPlastic, nc())
		P(m, "Castle", Vector3.new(w * 0.12, h * 0.22, 0.05), c * CFrame.new(w * 0.22, h * 0.05, -0.02), rgb(120, 116, 110), M.SmoothPlastic, nc())
		S(m, "Sun", math.min(w, h) * 0.18, c * CFrame.new(w * 0.3, h * 0.3, -0.02), rgb(255, 220, 140), M.SmoothPlastic, nc())
	elseif kind == 1 then
		-- портрет на тёмном фоне
		P(m, "Bg", Vector3.new(w, h, 0.04), c, rgb(34, 30, 28), M.SmoothPlastic, nc())
		P(m, "Body", Vector3.new(w * 0.6, h * 0.35, 0.05), c * CFrame.new(0, -h * 0.32, -0.01), Color3.fromHSV((seed % 7) / 7, 0.5, 0.45), M.SmoothPlastic, nc())
		S(m, "Face", math.min(w * 0.36, h * 0.3), c * CFrame.new(0, h * 0.08, -0.02), rgb(214, 176, 140), M.SmoothPlastic, nc())
		P(m, "Hair", Vector3.new(w * 0.4, h * 0.1, 0.05), c * CFrame.new(0, h * 0.24, -0.03), rgb(60, 40, 30), M.SmoothPlastic, nc())
	else
		-- натюрморт
		P(m, "Bg", Vector3.new(w, h, 0.04), c, rgb(60, 44, 34), M.SmoothPlastic, nc())
		P(m, "Table", Vector3.new(w, h * 0.25, 0.05), c * CFrame.new(0, -h * 0.375, -0.01), rgb(90, 60, 40), M.SmoothPlastic, nc())
		S(m, "Fruit", math.min(w, h) * 0.18, c * CFrame.new(-w * 0.15, -h * 0.15, -0.02), rgb(180, 50, 40), M.SmoothPlastic, nc())
		S(m, "Fruit", math.min(w, h) * 0.15, c * CFrame.new(w * 0.05, -h * 0.17, -0.02), rgb(200, 160, 50), M.SmoothPlastic, nc())
		P(m, "Vase", Vector3.new(w * 0.14, h * 0.4, 0.05), c * CFrame.new(w * 0.25, -h * 0.05, -0.02), rgb(60, 90, 130), M.SmoothPlastic, nc())
	end
	return m
end

-- Флаг-гобелен с гербом. cf — точка крепления на стене, LookVector в комнату
function Props.banner(parent, cf: CFrame, h: number, color: Color3?)
	local m = model(parent, "Banner")
	local col = color or rgb(120, 22, 30)
	P(m, "Rod", Vector3.new(5.2, 0.3, 0.3), cf * CFrame.new(0, 0, -0.4), Props.GOLD, M.Metal, nc())
	P(m, "Cloth", Vector3.new(4.4, h, 0.12), cf * CFrame.new(0, -h / 2, -0.35), col, M.Fabric, nc())
	P(m, "Tip", Vector3.new(3.1, 3.1, 0.12), cf * CFrame.new(0, -h, -0.35) * CFrame.Angles(0, 0, math.pi / 4), col, M.Fabric, nc())
	P(m, "Trim", Vector3.new(4.4, 0.35, 0.14), cf * CFrame.new(0, -0.4, -0.37), Props.GOLD, M.Fabric, nc())
	C(m, "Crest", 0.14, 2.2, cf * CFrame.new(0, -h * 0.4, -0.45) * CFrame.Angles(math.pi / 2, 0, 0), Props.GOLD, M.Metal, nc())
	P(m, "Crown", Vector3.new(1.2, 0.6, 0.14), cf * CFrame.new(0, -h * 0.4, -0.5), col, M.Fabric, nc())
	return m
end

-- ---------------------------------------------------------------------------
-- мебель

function Props.bookshelf(parent, cf: CFrame, w: number, h: number, seed: number, coarse: boolean?)
	local m = model(parent, "Bookshelf")
	local d = 2
	local wood = Props.WOOD_DARK
	P(m, "Back", Vector3.new(w, h, 0.2), cf * CFrame.new(0, h / 2, d / 2 - 0.1), wood, M.Wood)
	for _, s in { -1, 1 } do
		P(m, "Side", Vector3.new(0.35, h, d), cf * CFrame.new(s * (w / 2 - 0.175), h / 2, 0), wood, M.Wood)
	end
	P(m, "Crown", Vector3.new(w + 0.6, 0.5, d + 0.4), cf * CFrame.new(0, h + 0.25, 0), wood, M.Wood)
	P(m, "Plinth", Vector3.new(w, 0.6, d + 0.1), cf * CFrame.new(0, 0.3, 0), wood, M.Wood)
	local rows = math.floor((h - 0.6) / 2.4)
	local rnd = Random.new(seed)
	for r = 0, rows - 1 do
		local y = 0.6 + r * 2.4
		P(m, "Board", Vector3.new(w - 0.7, 0.18, d - 0.2), cf * CFrame.new(0, y, 0), Props.WOOD, M.Wood)
		local x = -w / 2 + 0.45
		while x &lt; w / 2 - 0.9 do
			local bw = if coarse then rnd:NextNumber(1, 1.9) else rnd:NextNumber(0.25, 0.55)
			local bh = rnd:NextNumber(1.3, 2)
			if rnd:NextNumber() &lt; 0.08 then
				x += 0.8 -- пустое место на полке
			else
				local hue = ({ 0, 0.05, 0.33, 0.6, 0.75, 0.1 })[rnd:NextInteger(1, 6)]
				local tilt = if rnd:NextNumber() &lt; 0.06 then math.rad(14) else 0
				P(m, "Book", Vector3.new(bw, bh, d * 0.7), cf * CFrame.new(x + bw / 2, y + 0.09 + bh / 2, 0.05) * CFrame.Angles(0, 0, tilt), Color3.fromHSV(hue, rnd:NextNumber(0.35, 0.7), rnd:NextNumber(0.25, 0.55)), M.Fabric, nc())
				x += bw + 0.03
			end
		end
	end
	P(m, "Board", Vector3.new(w - 0.7, 0.18, d - 0.2), cf * CFrame.new(0, 0.6 + rows * 2.4, 0), Props.WOOD, M.Wood)
	return m
end

-- Комод с тремя ящиками и вещами сверху
function Props.dresser(parent, cf: CFrame, w: number, seed: number)
	local m = model(parent, "Dresser")
	local d, h = 1.8, 3.2
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			C(m, "Foot", 0.5, 0.35, cf * CFrame.new(sx * (w / 2 - 0.3), 0.25, sz * (d / 2 - 0.3)), Props.WOOD_DARK, M.Wood)
		end
	end
	P(m, "Body", Vector3.new(w, h - 0.5, d), cf * CFrame.new(0, 0.5 + (h - 0.5) / 2, 0), Props.WOOD, M.Wood)
	P(m, "Top", Vector3.new(w + 0.3, 0.2, d + 0.2), cf * CFrame.new(0, h + 0.1, 0), Props.WOOD_DARK, M.Wood)
	for k = 0, 2 do
		local y = 0.95 + k * 0.85
		P(m, "Drawer", Vector3.new(w - 0.4, 0.7, 0.1), cf * CFrame.new(0, y, -d / 2 - 0.05), Props.WOOD_LIGHT, M.Wood, nc())
		for _, x in { -w / 4, w / 4 } do
			S(m, "Pull", 0.2, cf * CFrame.new(x, y, -d / 2 - 0.15), Props.GOLD, M.Metal, nc())
		end
	end
	local top = cf * CFrame.new(0, h + 0.2, 0)
	if seed % 3 == 0 then
		Props.candle(m, (top * CFrame.new(-w / 4, 0, 0)).Position)
		C(m, "Vase", 1.2, 0.7, top * CFrame.new(w / 4, 0.6, 0), Color3.fromHSV((seed % 5) / 5, 0.4, 0.6), M.Glass)
	elseif seed % 3 == 1 then
		for k = 0, 2 do
			P(m, "Book", Vector3.new(1.3, 0.25, 1), top * CFrame.new(-w / 5, 0.125 + k * 0.26, 0) * CFrame.Angles(0, k * 0.2, 0), Color3.fromHSV(k * 0.3, 0.5, 0.4), M.Fabric, nc())
		end
		S(m, "Globe", 0.8, top * CFrame.new(w / 4, 0.4, 0), rgb(70, 110, 150), M.SmoothPlastic, nc())
	else
		P(m, "Mirror", Vector3.new(w * 0.6, 2.4, 0.15), top * CFrame.new(0, 1.3, d / 2 - 0.2), rgb(190, 205, 215), M.Glass, nc({ Reflectance = 0.4 }))
		P(m, "MirrorFrame", Vector3.new(w * 0.6 + 0.3, 2.7, 0.1), top * CFrame.new(0, 1.3, d / 2 - 0.1), Props.GOLD, M.Metal, nc())
	end
	return m
end

-- Шкаф с двумя дверцами, как в DOORS
function Props.wardrobe(parent, cf: CFrame, color: Color3?)
	local m = model(parent, "Wardrobe")
	local w, h, d = 4.6, 8.6, 2.4
	local wood = color or Props.WOOD
	P(m, "Body", Vector3.new(w, h, d), cf * CFrame.new(0, 0.4 + h / 2, 0), wood, M.Wood)
	P(m, "Crown", Vector3.new(w + 0.5, 0.5, d + 0.4), cf * CFrame.new(0, h + 0.65, 0), Props.WOOD_DARK, M.Wood)
	P(m, "Base", Vector3.new(w + 0.3, 0.4, d + 0.2), cf * CFrame.new(0, 0.2, 0), Props.WOOD_DARK, M.Wood)
	for _, s in { -1, 1 } do
		local x = s * w / 4
		P(m, "Door", Vector3.new(w / 2 - 0.2, h - 0.4, 0.1), cf * CFrame.new(x, 0.4 + h / 2, -d / 2 - 0.05), wood:Lerp(Props.WOOD_DARK, 0.2), M.Wood, nc())
		P(m, "PanelHi", Vector3.new(w / 2 - 0.8, h * 0.45, 0.08), cf * CFrame.new(x, 0.4 + h * 0.68, -d / 2 - 0.12), wood:Lerp(Props.WOOD_DARK, 0.4), M.Wood, nc())
		P(m, "PanelLo", Vector3.new(w / 2 - 0.8, h * 0.3, 0.08), cf * CFrame.new(x, 0.4 + h * 0.22, -d / 2 - 0.12), wood:Lerp(Props.WOOD_DARK, 0.4), M.Wood, nc())
		P(m, "Handle", Vector3.new(0.12, 0.8, 0.12), cf * CFrame.new(-s * 0.3, 0.4 + h * 0.5, -d / 2 - 0.2), Props.GOLD, M.Metal, nc())
	end
	return m
end

function Props.nightstand(parent, cf: CFrame)
	local m = model(parent, "Nightstand")
	P(m, "Body", Vector3.new(1.8, 2.2, 1.6), cf * CFrame.new(0, 1.3, 0), Props.WOOD, M.Wood)
	P(m, "Top", Vector3.new(2, 0.15, 1.8), cf * CFrame.new(0, 2.45, 0), Props.WOOD_DARK, M.Wood)
	P(m, "Drawer", Vector3.new(1.5, 0.6, 0.08), cf * CFrame.new(0, 1.9, -0.84), Props.WOOD_LIGHT, M.Wood, nc())
	S(m, "Pull", 0.18, cf * CFrame.new(0, 1.9, -0.92), Props.GOLD, M.Metal, nc())
	for _, sx in { -0.75, 0.75 } do
		for _, sz in { -0.65, 0.65 } do
			P(m, "Leg", Vector3.new(0.2, 0.2, 0.2), cf * CFrame.new(sx, 0.1, sz), Props.WOOD_DARK, M.Wood)
		end
	end
	-- лампа с абажуром
	C(m, "LampBase", 0.2, 0.7, cf * CFrame.new(0, 2.63, 0.1), Props.GOLD, M.Metal, nc())
	C(m, "LampStem", 1, 0.15, cf * CFrame.new(0, 3.2, 0.1), Props.GOLD, M.Metal, nc())
	local shade = C(m, "LampShade", 0.8, 1, cf * CFrame.new(0, 3.9, 0.1), rgb(240, 214, 170), M.Neon, nc({ Transparency = 0.35 }))
	light(shade, 9, 0.6)
	return m
end

-- Кровать: рама, резное изголовье, матрас, одеяло с отворотом, подушки; royal — с балдахином
function Props.bed(parent, cf: CFrame, blanket: Color3, royal: boolean?)
	local m = model(parent, "Bed")
	local w, len = if royal then 7 else 5, if royal then 9.5 else 8.5
	local wood = if royal then Props.WOOD_DARK else Props.WOOD
	-- изголовье у стены (локально +Z), изножье в комнату
	P(m, "Frame", Vector3.new(w, 1.2, len), cf * CFrame.new(0, 1.1, 0), wood, M.Wood)
	for _, s in { -1, 1 } do
		for _, e in { -1, 1 } do
			local postH = if royal then 10 else (if e &gt; 0 then 4.6 else 2.6)
			C(m, "Post", postH, 0.45, cf * CFrame.new(s * (w / 2 - 0.2), postH / 2, e * (len / 2 - 0.2)), wood, M.Wood)
			S(m, "Knob", 0.6, cf * CFrame.new(s * (w / 2 - 0.2), postH + 0.2, e * (len / 2 - 0.2)), if royal then Props.GOLD else wood, if royal then M.Metal else M.Wood)
		end
	end
	P(m, "Headboard", Vector3.new(w - 0.4, 3.2, 0.3), cf * CFrame.new(0, 2.6, len / 2 - 0.2), wood, M.Wood)
	for k = -1, 1 do
		P(m, "HeadPanel", Vector3.new((w - 1.2) / 3 - 0.2, 2, 0.1), cf * CFrame.new(k * (w - 1.2) / 3, 2.7, len / 2 - 0.4), wood:Lerp(rgb(0, 0, 0), 0.2), M.Wood, nc())
	end
	P(m, "Footboard", Vector3.new(w - 0.4, 1.4, 0.25), cf * CFrame.new(0, 1.7, -len / 2 + 0.2), wood, M.Wood)
	P(m, "Mattress", Vector3.new(w - 0.6, 0.8, len - 0.7), cf * CFrame.new(0, 2.1, 0), Props.CLOTH, M.Fabric)
	local b = P(m, "Blanket", Vector3.new(w - 0.4, 0.3, len * 0.62), cf * CFrame.new(0, 2.6, -len * 0.16), blanket, M.Fabric)
	P(m, "Fold", Vector3.new(w - 0.4, 0.34, 0.9), cf * CFrame.new(0, 2.65, len * 0.13), Props.CLOTH, M.Fabric, nc())
	for _, x in (if royal then { -1.6, 1.6 } else { -1.1, 1.1 }) do
		P(m, "Pillow", Vector3.new(if royal then 2.6 else 1.8, 0.6, 1.3), cf * CFrame.new(x, 2.8, len / 2 - 1.3) * CFrame.Angles(math.rad(-12), 0, 0), rgb(248, 246, 240), M.Fabric, nc())
	end
	if royal then
		P(m, "Canopy", Vector3.new(w + 0.3, 0.5, len + 0.3), cf * CFrame.new(0, 10.1, 0), blanket:Lerp(rgb(0, 0, 0), 0.2), M.Fabric)
		for _, s in { -1, 1 } do
			for _, e in { -1, 1 } do
				P(m, "Curtain", Vector3.new(0.6, 7, 1.2), cf * CFrame.new(s * (w / 2 - 0.1), 6.3, e * (len / 2 - 0.9)), blanket, M.Fabric, nc())
			end
		end
		P(m, "Valance", Vector3.new(w + 0.4, 1, 0.2), cf * CFrame.new(0, 9.5, -len / 2 - 0.1), Props.GOLD, M.Fabric, nc())
	end
	return m, b
end

-- Стол с резными ножками; cloth — скатерть
function Props.table(parent, cf: CFrame, w: number, d: number, cloth: Color3?)
	local m = model(parent, "Table")
	local h = 3.2
	P(m, "Top", Vector3.new(w, 0.3, d), cf * CFrame.new(0, h, 0), Props.WOOD, M.Wood)
	P(m, "Apron", Vector3.new(w - 0.6, 0.5, d - 0.6), cf * CFrame.new(0, h - 0.4, 0), Props.WOOD_DARK, M.Wood)
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			local lp = cf * CFrame.new(sx * (w / 2 - 0.45), 0, sz * (d / 2 - 0.45))
			C(m, "Leg", h - 0.6, 0.4, lp * CFrame.new(0, (h - 0.6) / 2, 0), Props.WOOD_DARK, M.Wood)
			S(m, "Turn", 0.6, lp * CFrame.new(0, h * 0.55, 0), Props.WOOD_DARK, M.Wood, nc())
			C(m, "Foot", 0.3, 0.6, lp * CFrame.new(0, 0.15, 0), Props.WOOD_DARK, M.Wood)
		end
	end
	if cloth then
		P(m, "Cloth", Vector3.new(w + 0.4, 0.06, d + 0.4), cf * CFrame.new(0, h + 0.18, 0), cloth, M.Fabric, nc())
		for _, s in { -1, 1 } do
			P(m, "Drop", Vector3.new(w + 0.4, 1, 0.06), cf * CFrame.new(0, h - 0.3, s * (d / 2 + 0.2)), cloth, M.Fabric, nc())
		end
	end
	return m, h + 0.15
end

-- Стул: ножки, сиденье с подушкой, спинка из реек
function Props.chair(parent, cf: CFrame, color: Color3?)
	local m = model(parent, "Chair")
	for _, sx in { -0.75, 0.75 } do
		for _, sz in { -0.75, 0.75 } do
			P(m, "Leg", Vector3.new(0.25, 1.9, 0.25), cf * CFrame.new(sx, 0.95, sz), Props.WOOD_DARK, M.Wood)
		end
	end
	P(m, "Seat", Vector3.new(1.9, 0.25, 1.9), cf * CFrame.new(0, 1.95, 0), Props.WOOD, M.Wood)
	P(m, "Cushion", Vector3.new(1.6, 0.22, 1.6), cf * CFrame.new(0, 2.17, 0), color or rgb(120, 30, 36), M.Fabric, nc())
	for _, sx in { -0.75, 0.75 } do
		P(m, "BackPost", Vector3.new(0.25, 2.4, 0.25), cf * CFrame.new(sx, 3.25, 0.8), Props.WOOD_DARK, M.Wood)
	end
	P(m, "TopRail", Vector3.new(1.9, 0.35, 0.28), cf * CFrame.new(0, 4.4, 0.8), Props.WOOD_DARK, M.Wood)
	for _, x in { -0.35, 0, 0.35 } do
		P(m, "Slat", Vector3.new(0.16, 2, 0.12), cf * CFrame.new(x, 3.2, 0.8), Props.WOOD, M.Wood, nc())
	end
	return m
end

-- Кресло с подлокотниками
function Props.armchair(parent, cf: CFrame, color: Color3)
	local m = model(parent, "Armchair")
	P(m, "Base", Vector3.new(3, 1.2, 2.8), cf * CFrame.new(0, 0.9, 0), color, M.Fabric)
	P(m, "Cushion", Vector3.new(2.2, 0.5, 2.2), cf * CFrame.new(0, 1.75, -0.2), color:Lerp(rgb(255, 255, 255), 0.08), M.Fabric)
	P(m, "Back", Vector3.new(3, 3, 0.6), cf * CFrame.new(0, 2.6, 1.1), color, M.Fabric)
	for _, s in { -1, 1 } do
		P(m, "Arm", Vector3.new(0.5, 1, 2.8), cf * CFrame.new(s * 1.35, 2, 0), color:Lerp(rgb(0, 0, 0), 0.1), M.Fabric)
		S(m, "ArmRoll", 0.6, cf * CFrame.new(s * 1.35, 2.5, -1.3), color, M.Fabric, nc())
	end
	for _, sx in { -1.3, 1.3 } do
		for _, sz in { -1.2, 1.2 } do
			C(m, "Foot", 0.3, 0.3, cf * CFrame.new(sx, 0.15, sz), Props.WOOD_DARK, M.Wood)
		end
	end
	return m
end

-- Диван на троих
function Props.sofa(parent, cf: CFrame, color: Color3)
	local m = model(parent, "Sofa")
	local w = 7
	P(m, "Base", Vector3.new(w, 1.2, 2.8), cf * CFrame.new(0, 0.9, 0), color, M.Fabric)
	for k = -1, 1 do
		P(m, "Cushion", Vector3.new(w / 3 - 0.3, 0.5, 2.1), cf * CFrame.new(k * w / 3, 1.75, -0.25), color:Lerp(rgb(255, 255, 255), 0.06), M.Fabric)
		P(m, "BackCushion", Vector3.new(w / 3 - 0.3, 2, 0.5), cf * CFrame.new(k * w / 3, 2.7, 0.75), color:Lerp(rgb(255, 255, 255), 0.04), M.Fabric, nc())
	end
	P(m, "Back", Vector3.new(w, 3.2, 0.5), cf * CFrame.new(0, 2.4, 1.15), color:Lerp(rgb(0, 0, 0), 0.1), M.Fabric)
	for _, s in { -1, 1 } do
		P(m, "Arm", Vector3.new(0.6, 1.4, 2.8), cf * CFrame.new(s * (w / 2 + 0.3), 1.6, 0), color:Lerp(rgb(0, 0, 0), 0.1), M.Fabric)
	end
	for _, sx in { -w / 2, w / 2 } do
		for _, sz in { -1.2, 1.2 } do
			C(m, "Foot", 0.3, 0.3, cf * CFrame.new(sx, 0.15, sz), Props.WOOD_DARK, M.Wood)
		end
	end
	return m
end

-- Низкий столик перед диваном
function Props.coffeeTable(parent, cf: CFrame)
	local m = model(parent, "CoffeeTable")
	P(m, "Top", Vector3.new(4, 0.25, 2.2), cf * CFrame.new(0, 1.6, 0), Props.WOOD, M.Wood)
	for _, sx in { -1.7, 1.7 } do
		for _, sz in { -0.85, 0.85 } do
			P(m, "Leg", Vector3.new(0.3, 1.5, 0.3), cf * CFrame.new(sx, 0.75, sz), Props.WOOD_DARK, M.Wood)
		end
	end
	P(m, "Tray", Vector3.new(1.6, 0.1, 1), cf * CFrame.new(-0.6, 1.78, 0), Props.GOLD, M.Metal, nc())
	C(m, "Teapot", 0.7, 0.6, cf * CFrame.new(-0.8, 2.15, 0), rgb(235, 235, 240), M.SmoothPlastic, nc())
	C(m, "Cup", 0.3, 0.35, cf * CFrame.new(-0.2, 1.98, 0.2), rgb(235, 235, 240), M.SmoothPlastic, nc())
	P(m, "Book", Vector3.new(1, 0.2, 1.3), cf * CFrame.new(1.1, 1.82, 0) * CFrame.Angles(0, 0.3, 0), rgb(90, 30, 30), M.Fabric, nc())
	return m
end

-- Камин: каменный портал, полка, топка с поленьями и огнём, дымоход до потолка
function Props.fireplace(parent, cf: CFrame, ceiling: number)
	local m = model(parent, "Fireplace")
	local stone = rgb(160, 152, 140)
	P(m, "Breast", Vector3.new(6, ceiling, 2), cf * CFrame.new(0, ceiling / 2, 0.6), stone:Lerp(rgb(0, 0, 0), 0.08), M.Slate)
	P(m, "Hearth", Vector3.new(8, 0.4, 2.5), cf * CFrame.new(0, 0.2, -0.9), rgb(110, 104, 98), M.Slate)
	for _, s in { -1, 1 } do
		P(m, "Pier", Vector3.new(1.2, 4.6, 1.2), cf * CFrame.new(s * 3, 2.3, -0.9), stone, M.Marble)
		P(m, "Corbel", Vector3.new(1.4, 0.6, 1.5), cf * CFrame.new(s * 3, 4.9, -1), stone, M.Marble)
	end
	P(m, "Mantel", Vector3.new(8, 0.5, 1.9), cf * CFrame.new(0, 5.4, -1), stone, M.Marble)
	P(m, "Lintel", Vector3.new(4.8, 0.9, 1.2), cf * CFrame.new(0, 4.25, -0.9), stone, M.Marble)
	local box = P(m, "Firebox", Vector3.new(4.8, 3.8, 0.3), cf * CFrame.new(0, 2.3, -0.25), rgb(26, 20, 18), M.Slate)
	P(m, "Grate", Vector3.new(3.4, 0.2, 1), cf * CFrame.new(0, 0.7, -0.9), Props.IRON, M.Metal, nc())
	for k = -1, 1 do
		C(m, "Log", 2.8, 0.45, cf * CFrame.new(k * 0.6, 1, -0.9) * CFrame.Angles(0, 0, math.pi / 2) * CFrame.Angles(math.pi / 2, 0, 0), rgb(80, 52, 34), M.Wood, nc())
	end
	local ember = P(m, "Embers", Vector3.new(2.6, 0.3, 0.8), cf * CFrame.new(0, 0.95, -0.9), rgb(255, 110, 40), M.Neon, nc())
	local fire = Instance.new("Fire")
	fire.Size = 3.5
	fire.Heat = 4
	fire.Color = rgb(255, 140, 50)
	fire.SecondaryColor = rgb(255, 60, 20)
	fire.Parent = ember
	light(ember, 22, 1.6, rgb(255, 150, 70))
	-- на полке подсвечники и часы
	Props.candelabra(m, (cf * CFrame.new(-3, 5.65, -1)).Position)
	Props.candelabra(m, (cf * CFrame.new(3, 5.65, -1)).Position)
	P(m, "Clock", Vector3.new(1.4, 1.4, 0.6), cf * CFrame.new(0, 6.35, -1), Props.GOLD, M.Metal, nc())
	C(m, "Dial", 0.1, 1, cf * CFrame.new(0, 6.4, -1.32) * CFrame.Angles(math.pi / 2, 0, 0), rgb(245, 240, 225), M.SmoothPlastic, nc())
	local _ = box
	return m
end

-- Рыцарские доспехи на постаменте
function Props.armor(parent, cf: CFrame)
	local m = model(parent, "Armor")
	local steel = rgb(176, 178, 186)
	P(m, "Pedestal", Vector3.new(2.6, 0.6, 2.6), cf * CFrame.new(0, 0.3, 0), Props.STONE_DARK, M.Marble)
	for _, s in { -1, 1 } do
		P(m, "Leg", Vector3.new(0.7, 2.8, 0.7), cf * CFrame.new(s * 0.45, 2, 0), steel, M.Metal)
		P(m, "Knee", Vector3.new(0.85, 0.5, 0.85), cf * CFrame.new(s * 0.45, 2, -0.05), steel:Lerp(rgb(0, 0, 0), 0.1), M.Metal)
		P(m, "Boot", Vector3.new(0.8, 0.5, 1.1), cf * CFrame.new(s * 0.45, 0.85, -0.15), steel, M.Metal)
		P(m, "Arm", Vector3.new(0.6, 2.4, 0.6), cf * CFrame.new(s * 1.35, 4.3, 0), steel, M.Metal)
		S(m, "Pauldron", 1.1, cf * CFrame.new(s * 1.3, 5.5, 0), steel, M.Metal)
		P(m, "Gauntlet", Vector3.new(0.65, 0.6, 0.65), cf * CFrame.new(s * 1.35, 2.9, -0.05), steel:Lerp(rgb(0, 0, 0), 0.15), M.Metal)
	end
	P(m, "Torso", Vector3.new(2, 2.6, 1.2), cf * CFrame.new(0, 4.6, 0), steel, M.Metal)
	P(m, "Breast", Vector3.new(1.7, 1.6, 0.25), cf * CFrame.new(0, 4.9, -0.65), steel:Lerp(rgb(255, 255, 255), 0.1), M.Metal)
	P(m, "Belt", Vector3.new(2.1, 0.35, 1.3), cf * CFrame.new(0, 3.4, 0), rgb(70, 50, 34), M.Fabric)
	P(m, "Helmet", Vector3.new(1.2, 1.4, 1.3), cf * CFrame.new(0, 6.6, 0), steel, M.Metal)
	P(m, "Visor", Vector3.new(1.05, 0.2, 0.1), cf * CFrame.new(0, 6.65, -0.68), rgb(20, 20, 22), M.Metal, nc())
	P(m, "Plume", Vector3.new(0.2, 1, 1.4), cf * CFrame.new(0, 7.6, 0.2), rgb(150, 20, 30), M.Fabric, nc())
	P(m, "Sword", Vector3.new(0.2, 4.4, 0.4), cf * CFrame.new(1.6, 2.4, -0.6), rgb(200, 202, 210), M.Metal, nc())
	P(m, "Guard", Vector3.new(1, 0.2, 0.3), cf * CFrame.new(1.6, 4.5, -0.6), Props.GOLD, M.Metal, nc())
	P(m, "Shield", Vector3.new(1.8, 2.4, 0.2), cf * CFrame.new(-1.75, 3.6, -0.5), rgb(120, 22, 30), M.Metal, nc())
	C(m, "Boss", 0.1, 0.8, cf * CFrame.new(-1.75, 3.7, -0.62) * CFrame.Angles(math.pi / 2, 0, 0), Props.GOLD, M.Metal, nc())
	return m
end

-- Растение в кадке
function Props.plant(parent, cf: CFrame, big: boolean?)
	local m = model(parent, "Plant")
	local s = if big then 1.5 else 1
	C(m, "Pot", 1.6 * s, 1.6 * s, cf * CFrame.new(0, 0.8 * s, 0), rgb(150, 82, 56), M.Slate)
	C(m, "Rim", 0.25 * s, 1.9 * s, cf * CFrame.new(0, 1.6 * s, 0), rgb(130, 70, 48), M.Slate)
	C(m, "Soil", 0.1, 1.5 * s, cf * CFrame.new(0, 1.62 * s, 0), rgb(60, 42, 30), M.Ground, nc())
	for k = 0, 6 do
		local a = k / 7 * math.pi * 2
		local len = (2 + (k % 3) * 0.6) * s
		P(m, "Leaf", Vector3.new(0.6 * s, len, 0.1), cf * CFrame.new(0, 1.7 * s, 0) * CFrame.Angles(0, a, math.rad(28 + (k % 2) * 12)) * CFrame.new(0, len / 2, 0), rgb(60, 110 + (k % 3) * 15, 50), M.Grass, nc())
	end
	S(m, "Bush", 1.6 * s, cf * CFrame.new(0, 2.4 * s, 0), rgb(56, 100, 46), M.Grass, nc())
	return m
end

-- Напольные часы с маятником
function Props.grandfatherClock(parent, cf: CFrame)
	local m = model(parent, "Clock")
	P(m, "Base", Vector3.new(2.2, 1.2, 1.6), cf * CFrame.new(0, 0.6, 0), Props.WOOD_DARK, M.Wood)
	P(m, "Case", Vector3.new(1.8, 5, 1.4), cf * CFrame.new(0, 3.7, 0), Props.WOOD, M.Wood)
	P(m, "Window", Vector3.new(1.1, 3.4, 0.1), cf * CFrame.new(0, 3.7, -0.72), rgb(40, 34, 30), M.Glass, nc({ Transparency = 0.3 }))
	P(m, "Pendulum", Vector3.new(0.08, 2.4, 0.05), cf * CFrame.new(0, 3.9, -0.6), Props.GOLD, M.Metal, nc())
	C(m, "Bob", 0.08, 0.6, cf * CFrame.new(0, 2.7, -0.6) * CFrame.Angles(math.pi / 2, 0, 0), Props.GOLD, M.Metal, nc())
	P(m, "Head", Vector3.new(2.2, 2.4, 1.6), cf * CFrame.new(0, 7.4, 0), Props.WOOD_DARK, M.Wood)
	C(m, "Face", 0.1, 1.7, cf * CFrame.new(0, 7.4, -0.82) * CFrame.Angles(math.pi / 2, 0, 0), rgb(240, 232, 210), M.SmoothPlastic, nc())
	P(m, "HandH", Vector3.new(0.08, 0.5, 0.05), cf * CFrame.new(0.1, 7.55, -0.9) * CFrame.Angles(0, 0, math.rad(-35)), rgb(20, 20, 20), M.Metal, nc())
	P(m, "HandM", Vector3.new(0.06, 0.7, 0.05), cf * CFrame.new(-0.05, 7.7, -0.9) * CFrame.Angles(0, 0, math.rad(10)), rgb(20, 20, 20), M.Metal, nc())
	P(m, "Pediment", Vector3.new(2.4, 0.5, 1.8), cf * CFrame.new(0, 8.85, 0), Props.WOOD_DARK, M.Wood)
	S(m, "Finial", 0.5, cf * CFrame.new(0, 9.3, 0), Props.GOLD, M.Metal, nc())
	return m
end

-- Пианино с клавиатурой и банкеткой
function Props.piano(parent, cf: CFrame)
	local m = model(parent, "Piano")
	local black = rgb(22, 20, 22)
	P(m, "Body", Vector3.new(6, 4.6, 2), cf * CFrame.new(0, 2.8, 0.4), black, M.SmoothPlastic, { Reflectance = 0.1 })
	P(m, "Lid", Vector3.new(6.2, 0.2, 2.2), cf * CFrame.new(0, 5.2, 0.4), black, M.SmoothPlastic)
	P(m, "KeyBed", Vector3.new(5.6, 0.4, 1.2), cf * CFrame.new(0, 3, -1.1), black, M.SmoothPlastic)
	P(m, "WhiteKeys", Vector3.new(5.2, 0.12, 0.9), cf * CFrame.new(0, 3.26, -1.15), rgb(245, 242, 232), M.SmoothPlastic, nc())
	for k = 0, 17 do
		if k % 7 ~= 2 and k % 7 ~= 6 then
			P(m, "BlackKey", Vector3.new(0.14, 0.14, 0.5), cf * CFrame.new(-2.5 + k * 0.29, 3.36, -1.0), black, M.SmoothPlastic, nc())
		end
	end
	P(m, "MusicStand", Vector3.new(2.4, 1.2, 0.1), cf * CFrame.new(0, 4.2, -0.65) * CFrame.Angles(math.rad(-10), 0, 0), black, M.SmoothPlastic, nc())
	P(m, "Sheet", Vector3.new(1.8, 1, 0.05), cf * CFrame.new(0, 4.25, -0.72) * CFrame.Angles(math.rad(-10), 0, 0), rgb(245, 240, 225), M.SmoothPlastic, nc())
	for _, s in { -1, 1 } do
		P(m, "Leg", Vector3.new(0.5, 2.8, 0.5), cf * CFrame.new(s * 2.7, 1.4, -1.3), black, M.SmoothPlastic)
	end
	-- банкетка
	P(m, "BenchSeat", Vector3.new(3, 0.5, 1.4), cf * CFrame.new(0, 1.8, -3.2), rgb(90, 24, 30), M.Fabric)
	for _, sx in { -1.3, 1.3 } do
		P(m, "BenchLeg", Vector3.new(0.25, 1.6, 1.2), cf * CFrame.new(sx, 0.8, -3.2), black, M.SmoothPlastic)
	end
	return m
end

-- Письменный стол с бумагами, чернильницей, пером и стулом
function Props.desk(parent, cf: CFrame)
	local m = model(parent, "Desk")
	local w, d = 5, 2.6
	P(m, "Top", Vector3.new(w, 0.3, d), cf * CFrame.new(0, 3.2, 0), Props.WOOD, M.Wood)
	for _, s in { -1, 1 } do
		P(m, "Pedestal", Vector3.new(1.4, 3.05, d - 0.2), cf * CFrame.new(s * (w / 2 - 0.8), 1.53, 0), Props.WOOD_DARK, M.Wood)
		for k = 0, 2 do
			P(m, "Drawer", Vector3.new(1.2, 0.8, 0.08), cf * CFrame.new(s * (w / 2 - 0.8), 0.6 + k * 0.95, -d / 2 + 0.04), Props.WOOD_LIGHT, M.Wood, nc())
			S(m, "Pull", 0.16, cf * CFrame.new(s * (w / 2 - 0.8), 0.6 + k * 0.95, -d / 2 - 0.05), Props.GOLD, M.Metal, nc())
		end
	end
	P(m, "Blotter", Vector3.new(2.4, 0.04, 1.4), cf * CFrame.new(0, 3.37, 0), rgb(40, 70, 50), M.Fabric, nc())
	for k = 0, 2 do
		P(m, "Paper", Vector3.new(0.85, 0.02, 1.1), cf * CFrame.new(-0.4 + k * 0.25, 3.4 + k * 0.01, 0) * CFrame.Angles(0, k * 0.25 - 0.2, 0), rgb(240, 232, 210), M.SmoothPlastic, nc())
	end
	C(m, "Inkwell", 0.4, 0.4, cf * CFrame.new(1.4, 3.55, 0.6), rgb(20, 20, 30), M.Glass, nc())
	P(m, "Quill", Vector3.new(0.06, 1.2, 0.2), cf * CFrame.new(1.45, 3.95, 0.6) * CFrame.Angles(math.rad(20), 0, math.rad(15)), rgb(245, 245, 245), M.Fabric, nc())
	Props.candle(m, (cf * CFrame.new(-1.9, 3.35, 0.7)).Position)
	for k = 0, 3 do
		P(m, "Book", Vector3.new(0.3, 1.2, 0.9), cf * CFrame.new(-2 + k * 0.32, 3.95, 0.8), Color3.fromHSV(k * 0.21, 0.5, 0.4), M.Fabric, nc())
	end
	Props.chair(m, cf * CFrame.new(0, 0, -2.2) * CFrame.Angles(0, math.pi, 0))
	return m
end

-- Глобус на подставке
function Props.globe(parent, cf: CFrame)
	local m = model(parent, "Globe")
	for k = 0, 2 do
		local a = k / 3 * math.pi * 2
		P(m, "Leg", Vector3.new(0.2, 2.6, 0.2), cf * CFrame.new(math.cos(a) * 0.6, 1.3, math.sin(a) * 0.6) * CFrame.Angles(math.cos(a) * 0.2, 0, -math.sin(a) * 0.2), Props.WOOD_DARK, M.Wood)
	end
	P(m, "Meridian", Vector3.new(0.12, 2.6, 2.6), cf * CFrame.new(0, 3.6, 0) * CFrame.Angles(0, 0, math.rad(23)), Props.GOLD, M.Metal, { Shape = CYL, CanCollide = false })
	S(m, "Sphere", 2.2, cf * CFrame.new(0, 3.6, 0), rgb(70, 110, 150), M.SmoothPlastic)
	for k = 0, 3 do
		S(m, "Land", 0.9, cf * CFrame.new(0, 3.6, 0) * CFrame.Angles(k, k * 1.7, 0) * CFrame.new(0, 0, -0.75), rgb(120, 150, 80), M.SmoothPlastic, nc())
	end
	return m
end

-- Бочка (стоя или лёжа)
function Props.barrel(parent, cf: CFrame, lying: boolean?)
	local m = model(parent, "Barrel")
	local base = if lying then cf * CFrame.new(0, 1.4, 0) * CFrame.Angles(math.pi / 2, 0, 0) else cf * CFrame.new(0, 1.6, 0)
	C(m, "Staves", 3.2, 2.6, base, Props.WOOD_LIGHT, M.Wood)
	C(m, "Belly", 1.6, 2.8, base, Props.WOOD_LIGHT, M.Wood)
	for _, y in { -1.2, 1.2, 0.3, -0.3 } do
		C(m, "Hoop", 0.2, (if math.abs(y) &gt; 1 then 2.7 else 2.9), base * CFrame.new(0, y, 0), Props.IRON, M.Metal, nc())
	end
	return m
end

function Props.crate(parent, cf: CFrame, s: number?)
	local m = model(parent, "Crate")
	local z = s or 2.6
	P(m, "Box", Vector3.new(z, z, z), cf * CFrame.new(0, z / 2, 0), Props.WOOD_LIGHT, M.WoodPlanks)
	for _, a in { 0, math.pi / 2 } do
		P(m, "Brace", Vector3.new(0.25, z * 1.3, z + 0.1), cf * CFrame.new(0, z / 2, 0) * CFrame.Angles(a, 0, math.pi / 4), Props.WOOD, M.Wood, nc())
	end
	return m
end

function Props.sack(parent, cf: CFrame)
	local m = model(parent, "Sack")
	S(m, "Bag", 2, cf * CFrame.new(0, 1, 0), rgb(176, 150, 106), M.Fabric)
	C(m, "Neck", 0.6, 0.8, cf * CFrame.new(0, 2.1, 0), rgb(160, 136, 96), M.Fabric, nc())
	return m
end

-- Сундук с золотом
function Props.chest(parent, cf: CFrame, open: boolean?)
	local m = model(parent, "Chest")
	P(m, "Box", Vector3.new(3.4, 1.8, 2), cf * CFrame.new(0, 0.9, 0), Props.WOOD, M.Wood)
	for _, x in { -1.3, 0, 1.3 } do
		P(m, "Band", Vector3.new(0.2, 1.85, 2.05), cf * CFrame.new(x, 0.9, 0), Props.IRON, M.Metal, nc())
	end
	if open then
		P(m, "Lid", Vector3.new(3.4, 0.25, 2), cf * CFrame.new(0, 2.6, 1.1) * CFrame.Angles(math.rad(70), 0, 0), Props.WOOD, M.Wood, nc())
		for k = 0, 6 do
			C(m, "Coin", 0.08, 0.5, cf * CFrame.new(-1.2 + k * 0.4, 1.85, (k % 2) * 0.3 - 0.1) * CFrame.Angles(k, 0, 0.2), Props.GOLD, M.Neon, nc())
		end
		P(m, "Gold", Vector3.new(3, 0.3, 1.6), cf * CFrame.new(0, 1.75, 0), Props.GOLD, M.Metal, nc())
	else
		P(m, "Lid", Vector3.new(3.5, 0.5, 2.1), cf * CFrame.new(0, 2.05, 0), Props.WOOD_DARK, M.Wood)
		P(m, "Lock", Vector3.new(0.5, 0.6, 0.15), cf * CFrame.new(0, 1.6, -1.05), Props.GOLD, M.Metal, nc())
	end
	return m
end

-- Стойка с оружием и щитами
function Props.weaponRack(parent, cf: CFrame)
	local m = model(parent, "WeaponRack")
	P(m, "Back", Vector3.new(6, 6, 0.4), cf * CFrame.new(0, 3.4, 0.6), Props.WOOD_DARK, M.Wood)
	P(m, "Base", Vector3.new(6.4, 0.6, 1.8), cf * CFrame.new(0, 0.3, 0), Props.WOOD_DARK, M.Wood)
	P(m, "Rail", Vector3.new(6, 0.3, 0.8), cf * CFrame.new(0, 4.6, 0.2), Props.WOOD, M.Wood)
	for k = 0, 4 do
		local x = -2.4 + k * 1.2
		P(m, "Blade", Vector3.new(0.18, 4.2, 0.4), cf * CFrame.new(x, 2.7, 0.15), rgb(196, 198, 206), M.Metal, nc())
		P(m, "Hilt", Vector3.new(0.7, 0.18, 0.25), cf * CFrame.new(x, 4.9, 0.15), Props.GOLD, M.Metal, nc())
		P(m, "Grip", Vector3.new(0.18, 0.8, 0.18), cf * CFrame.new(x, 5.4, 0.15), rgb(60, 40, 28), M.Fabric, nc())
	end
	for _, x in { -2, 2 } do
		C(m, "Shield", 0.2, 2.2, cf * CFrame.new(x, 6.9, 0.35) * CFrame.Angles(math.pi / 2, 0, 0), rgb(120, 22, 30), M.Metal, nc())
		C(m, "Boss", 0.25, 0.7, cf * CFrame.new(x, 6.9, 0.25) * CFrame.Angles(math.pi / 2, 0, 0), Props.GOLD, M.Metal, nc())
	end
	return m
end

-- Скамья в часовне
function Props.pew(parent, cf: CFrame, w: number)
	local m = model(parent, "Pew")
	P(m, "Seat", Vector3.new(w, 0.3, 1.6), cf * CFrame.new(0, 1.9, 0), Props.WOOD, M.Wood)
	P(m, "Back", Vector3.new(w, 2.4, 0.25), cf * CFrame.new(0, 3.1, 0.75), Props.WOOD, M.Wood)
	P(m, "Rail", Vector3.new(w, 0.25, 0.4), cf * CFrame.new(0, 4.35, 0.75), Props.WOOD_DARK, M.Wood)
	for _, s in { -1, 1 } do
		P(m, "End", Vector3.new(0.3, 4, 1.8), cf * CFrame.new(s * (w / 2 + 0.1), 2, 0.1), Props.WOOD_DARK, M.Wood)
	end
	P(m, "Kneeler", Vector3.new(w, 0.35, 0.6), cf * CFrame.new(0, 0.45, -1.1), rgb(110, 30, 36), M.Fabric, nc())
	return m
end

-- Алтарь со свечами
function Props.altar(parent, cf: CFrame)
	local m = model(parent, "Altar")
	P(m, "Step", Vector3.new(9, 0.6, 5), cf * CFrame.new(0, 0.3, 0), Props.STONE, M.Marble)
	P(m, "Table", Vector3.new(6, 3.4, 2.4), cf * CFrame.new(0, 2.3, 0.5), rgb(220, 214, 204), M.Marble)
	P(m, "Cloth", Vector3.new(6.3, 0.1, 2.7), cf * CFrame.new(0, 4.05, 0.5), Props.CLOTH, M.Fabric, nc())
	P(m, "Runner", Vector3.new(1.4, 2, 0.1), cf * CFrame.new(0, 3.1, -0.75), rgb(120, 22, 30), M.Fabric, nc())
	for _, x in { -2.2, 2.2 } do
		Props.candelabra(m, (cf * CFrame.new(x, 4.1, 0.5)).Position)
	end
	P(m, "Book", Vector3.new(1.4, 0.3, 1), cf * CFrame.new(0, 4.25, 0.4), rgb(110, 30, 30), M.Fabric, nc())
	return m
end

-- Витраж: цветные стёкла в свинцовой сетке (на стене, LookVector в комнату)
function Props.stainedGlass(parent, cf: CFrame, w: number, h: number)
	local m = model(parent, "StainedGlass")
	local cols = { rgb(170, 40, 50), rgb(40, 70, 170), rgb(200, 160, 40), rgb(40, 130, 70), rgb(120, 50, 140) }
	local n, k = 4, 0
	for ix = 0, n - 1 do
		for iy = 0, n * 2 - 1 do
			k += 1
			P(m, "Pane", Vector3.new(w / n - 0.12, h / (n * 2) - 0.12, 0.1), cf * CFrame.new(-w / 2 + (ix + 0.5) * w / n, -h / 2 + (iy + 0.5) * h / (n * 2), -0.1), cols[(ix * 3 + iy) % #cols + 1], M.Neon, nc({ Transparency = 0.35 }))
		end
	end
	P(m, "Lead", Vector3.new(w + 0.4, h + 0.4, 0.06), cf * CFrame.new(0, 0, -0.03), rgb(30, 28, 26), M.Metal, nc())
	return m
end

-- Колонна с базой и капителью
function Props.column(parent, cf: CFrame, h: number, r: number, color: Color3?)
	local m = model(parent, "Column")
	local c = color or rgb(196, 190, 180)
	P(m, "Plinth", Vector3.new(r * 2.8, 0.8, r * 2.8), cf * CFrame.new(0, 0.4, 0), c:Lerp(rgb(0, 0, 0), 0.15), M.Marble)
	C(m, "Torus", 0.6, r * 2.5, cf * CFrame.new(0, 1.1, 0), c, M.Marble)
	C(m, "Shaft", h - 2.8, r * 2, cf * CFrame.new(0, 1.4 + (h - 2.8) / 2, 0), c, M.Marble)
	C(m, "Echinus", 0.6, r * 2.5, cf * CFrame.new(0, h - 1.1, 0), c, M.Marble)
	P(m, "Abacus", Vector3.new(r * 2.9, 0.8, r * 2.9), cf * CFrame.new(0, h - 0.4, 0), c:Lerp(rgb(0, 0, 0), 0.15), M.Marble)
	return m
end

-- Перила между двумя точками на высоте y (балясины и поручень)
function Props.railing(parent, a: Vector3, b: Vector3, color: Color3?)
	local m = model(parent, "Railing")
	local c = color or Props.WOOD_DARK
	local len = (b - a).Magnitude
	local cf = CFrame.lookAt((a + b) / 2, b)
	P(m, "Handrail", Vector3.new(0.5, 0.35, len), cf * CFrame.new(0, 3.3, 0), c, M.Wood)
	P(m, "BottomRail", Vector3.new(0.4, 0.3, len), cf * CFrame.new(0, 0.3, 0), c, M.Wood)
	local n = math.max(1, math.floor(len / 1.2))
	for k = 0, n do
		local z = -len / 2 + k * len / n
		local post = k % 6 == 0 or k == n
		P(m, if post then "Post" else "Baluster", Vector3.new(if post then 0.6 else 0.25, 3.2, if post then 0.6 else 0.25), cf * CFrame.new(0, 1.75, z), c, M.Wood, if post then nil else NOCOL)
	end
	return m
end

-- ---------------------------------------------------------------------------
-- кухня, магазин, казино, тюрьма, работа

function Props.stove(parent, cf: CFrame)
	local m = model(parent, "Stove")
	P(m, "Body", Vector3.new(7, 4, 3), cf * CFrame.new(0, 2, 0), rgb(120, 62, 48), M.Brick)
	P(m, "Top", Vector3.new(7.4, 0.4, 3.4), cf * CFrame.new(0, 4.2, 0), Props.IRON, M.Metal)
	for _, x in { -2.2, 0, 2.2 } do
		C(m, "Hob", 0.1, 1.4, cf * CFrame.new(x, 4.45, 0), rgb(30, 28, 26), M.Metal, nc())
	end
	local mouth = P(m, "Mouth", Vector3.new(3, 1.8, 0.2), cf * CFrame.new(0, 1.6, -1.5), rgb(30, 18, 12), M.Slate, nc())
	local fire = Instance.new("Fire")
	fire.Size = 2.5
	fire.Heat = 2
	fire.Parent = mouth
	light(mouth, 18, 1.4, rgb(255, 140, 60))
	P(m, "Hood", Vector3.new(7.6, 1.2, 3.6), cf * CFrame.new(0, 9.2, 0.2), rgb(110, 104, 98), M.Slate)
	P(m, "Flue", Vector3.new(3, 5, 2.4), cf * CFrame.new(0, 12.3, 0.4), rgb(110, 104, 98), M.Slate)
	-- котёл и сковороды
	C(m, "Pot", 1.4, 1.8, cf * CFrame.new(-2.2, 5.15, 0), Props.IRON, M.Metal, nc())
	C(m, "Soup", 0.1, 1.5, cf * CFrame.new(-2.2, 5.8, 0), rgb(170, 110, 60), M.SmoothPlastic, nc())
	C(m, "Pan", 0.3, 1.6, cf * CFrame.new(2.2, 4.65, 0), Props.IRON, M.Metal, nc())
	P(m, "PanHandle", Vector3.new(1.6, 0.15, 0.25), cf * CFrame.new(3.6, 4.7, 0), Props.IRON, M.Metal, nc())
	return m, mouth
end

-- Разделочный стол с овощами, ножом и доской
function Props.prepTable(parent, cf: CFrame)
	local m, top = Props.table(parent, cf, 6, 3)
	P(m, "Board", Vector3.new(2, 0.2, 1.4), cf * CFrame.new(-1, top + 0.1, 0), Props.WOOD_LIGHT, M.Wood, nc())
	P(m, "Knife", Vector3.new(1.2, 0.05, 0.15), cf * CFrame.new(-1, top + 0.23, 0.2), rgb(200, 202, 210), M.Metal, nc())
	for k, c in { rgb(220, 110, 40), rgb(110, 160, 60), rgb(200, 40, 40), rgb(230, 210, 120) } do
		S(m, "Veg", 0.5, cf * CFrame.new(0.6 + (k % 2) * 0.6, top + 0.25, -0.4 + math.floor(k / 2) * 0.6), c, M.SmoothPlastic, nc())
	end
	C(m, "Bowl", 0.4, 1.1, cf * CFrame.new(2, top + 0.2, 0), rgb(230, 225, 215), M.SmoothPlastic, nc())
	return m, top
end

-- Полка с банками и посудой (на стене)
function Props.shelfJars(parent, cf: CFrame, w: number)
	local m = model(parent, "Shelves")
	for k = 0, 2 do
		local y = 5 + k * 2
		P(m, "Board", Vector3.new(w, 0.2, 1.2), cf * CFrame.new(0, y, 0.6), Props.WOOD, M.Wood)
		for x = -w / 2 + 0.6, w / 2 - 0.6, 0.9 do
			local h = 0.6 + ((x * 3 + k) % 3) * 0.25
			C(m, "Jar", h, 0.55, cf * CFrame.new(x, y + 0.1 + h / 2, 0.6), Color3.fromHSV(((x + k) * 0.13) % 1, 0.4, 0.7), M.Glass, nc({ Transparency = 0.2 }))
		end
	end
	for _, x in { -w / 2 + 0.3, w / 2 - 0.3 } do
		P(m, "Bracket", Vector3.new(0.2, 4.4, 1.2), cf * CFrame.new(x, 7, 0.6), Props.WOOD_DARK, M.Wood)
	end
	return m
end

-- Вешалка с медной посудой
function Props.panRack(parent, cf: CFrame)
	local m = model(parent, "PanRack")
	P(m, "Bar", Vector3.new(5, 0.3, 0.3), cf * CFrame.new(0, 7.5, 0.4), Props.IRON, M.Metal, nc())
	for k = 0, 4 do
		local x = -2 + k
		P(m, "Hook", Vector3.new(0.08, 0.6, 0.08), cf * CFrame.new(x, 7.1, 0.4), Props.IRON, M.Metal, nc())
		C(m, "Pan", 0.15, 0.9 + (k % 2) * 0.3, cf * CFrame.new(x, 6.3, 0.3) * CFrame.Angles(math.pi / 2, 0, 0), rgb(184, 115, 70), M.Metal, nc())
	end
	return m
end

-- Прилавок магазина с товарами и весами
function Props.counter(parent, cf: CFrame, w: number)
	local m = model(parent, "Counter")
	P(m, "Body", Vector3.new(w, 3.2, 2), cf * CFrame.new(0, 1.6, 0), Props.WOOD, M.Wood)
	P(m, "Top", Vector3.new(w + 0.3, 0.25, 2.3), cf * CFrame.new(0, 3.3, 0), Props.WOOD_DARK, M.Wood)
	for x = -w / 2 + 1, w / 2 - 1, 1.6 do
		P(m, "Panel", Vector3.new(1.3, 2.2, 0.08), cf * CFrame.new(x, 1.6, -1.04), Props.WOOD_LIGHT, M.Wood, nc())
	end
	-- весы
	C(m, "ScaleBase", 0.2, 0.8, cf * CFrame.new(w / 2 - 1.2, 3.52, 0), Props.GOLD, M.Metal, nc())
	P(m, "ScalePost", Vector3.new(0.12, 1.3, 0.12), cf * CFrame.new(w / 2 - 1.2, 4.1, 0), Props.GOLD, M.Metal, nc())
	P(m, "ScaleBeam", Vector3.new(1.6, 0.08, 0.08), cf * CFrame.new(w / 2 - 1.2, 4.75, 0), Props.GOLD, M.Metal, nc())
	for _, s in { -0.75, 0.75 } do
		C(m, "Pan", 0.06, 0.6, cf * CFrame.new(w / 2 - 1.2 + s, 4.3, 0), Props.GOLD, M.Metal, nc())
	end
	-- шляпы и ткани на прилавке
	C(m, "Hat", 0.5, 1.2, cf * CFrame.new(-w / 2 + 1.3, 3.67, 0), rgb(60, 40, 90), M.Fabric, nc())
	C(m, "HatTop", 0.6, 0.7, cf * CFrame.new(-w / 2 + 1.3, 4.1, 0), rgb(60, 40, 90), M.Fabric, nc())
	for k = 0, 2 do
		P(m, "Cloth", Vector3.new(1.4, 0.2, 1), cf * CFrame.new(-0.5 + k * 0.1, 3.52 + k * 0.2, 0), Color3.fromHSV(k * 0.3, 0.6, 0.7), M.Fabric, nc())
	end
	return m
end

-- Игровой автомат
function Props.slotMachine(parent, cf: CFrame)
	local m = model(parent, "SlotMachine")
	local red = rgb(150, 26, 34)
	P(m, "Base", Vector3.new(3, 3, 2.4), cf * CFrame.new(0, 1.5, 0), red, M.SmoothPlastic)
	P(m, "Cabinet", Vector3.new(3, 3.6, 2), cf * CFrame.new(0, 4.8, 0.2), red, M.SmoothPlastic)
	P(m, "Screen", Vector3.new(2.4, 1.4, 0.1), cf * CFrame.new(0, 4.7, -0.82), rgb(250, 240, 210), M.Neon, nc())
	for k = -1, 1 do
		P(m, "Reel", Vector3.new(0.6, 1.1, 0.06), cf * CFrame.new(k * 0.75, 4.7, -0.9), Color3.fromHSV((k + 1) * 0.3, 0.8, 0.9), M.Neon, nc())
	end
	P(m, "Topper", Vector3.new(3.2, 0.9, 2.2), cf * CFrame.new(0, 7, 0.2), Props.GOLD, M.Metal)
	local lamp = P(m, "Lamp", Vector3.new(2.6, 0.4, 0.1), cf * CFrame.new(0, 7, -0.92), rgb(255, 200, 80), M.Neon, nc())
	light(lamp, 8, 0.8, rgb(255, 120, 80))
	P(m, "Lever", Vector3.new(0.2, 1.8, 0.2), cf * CFrame.new(1.7, 4.5, 0), rgb(200, 202, 210), M.Metal, nc())
	S(m, "LeverBall", 0.5, cf * CFrame.new(1.7, 5.5, 0), red, M.SmoothPlastic, nc())
	P(m, "Tray", Vector3.new(2, 0.2, 0.6), cf * CFrame.new(0, 2.9, -1.4), Props.GOLD, M.Metal, nc())
	return m
end

-- Стол для монетки / карт с зелёным сукном
function Props.feltTable(parent, cf: CFrame)
	local m = model(parent, "FeltTable")
	P(m, "Base", Vector3.new(2, 2.6, 2), cf * CFrame.new(0, 1.3, 0), Props.WOOD_DARK, M.Wood)
	C(m, "Rim", 0.4, 7.4, cf * CFrame.new(0, 3, 0), Props.WOOD, M.Wood)
	C(m, "Felt", 0.42, 6.6, cf * CFrame.new(0, 3.02, 0), rgb(26, 96, 56), M.Fabric)
	for k = 0, 5 do
		C(m, "Chip", 0.25, 0.45, cf * CFrame.new(-1 + k * 0.3, 3.3 + (k % 2) * 0.25, 1), Color3.fromHSV(k * 0.17, 0.8, 0.8), M.SmoothPlastic, nc())
	end
	for k = 0, 3 do
		local a = k / 4 * math.pi * 2
		local cp = (cf * CFrame.new(math.cos(a) * 5, 0, math.sin(a) * 5)).Position
		Props.chair(m, CFrame.lookAt(cp, Vector3.new(cf.Position.X, cp.Y, cf.Position.Z)), rgb(26, 70, 46))
	end
	return m
end

-- Рулетка
function Props.roulette(parent, cf: CFrame)
	local m = model(parent, "Roulette")
	P(m, "Table", Vector3.new(8, 3, 4), cf * CFrame.new(0, 1.5, 0), Props.WOOD_DARK, M.Wood)
	P(m, "Felt", Vector3.new(7.6, 0.1, 3.6), cf * CFrame.new(0, 3.05, 0), rgb(26, 96, 56), M.Fabric)
	C(m, "Bowl", 0.5, 3, cf * CFrame.new(-2, 3.3, 0), Props.WOOD, M.Wood)
	for k = 0, 11 do
		local a = k / 12 * math.pi * 2
		P(m, "Pocket", Vector3.new(0.4, 0.1, 0.4), cf * CFrame.new(-2 + math.cos(a) * 1.1, 3.58, math.sin(a) * 1.1), if k % 2 == 0 then rgb(170, 30, 30) else rgb(20, 20, 20), M.SmoothPlastic, nc())
	end
	C(m, "Spindle", 0.5, 0.4, cf * CFrame.new(-2, 3.8, 0), Props.GOLD, M.Metal, nc())
	for x = 0, 3 do
		for z = 0, 2 do
			P(m, "Number", Vector3.new(0.8, 0.12, 0.8), cf * CFrame.new(0.6 + x * 0.9, 3.1, -1 + z * 0.9), if (x + z) % 2 == 0 then rgb(170, 30, 30) else rgb(20, 20, 20), M.SmoothPlastic, nc())
		end
	end
	return m
end

-- Двухъярусные нары в камере
function Props.bunk(parent, cf: CFrame)
	local m = model(parent, "Bunk")
	for _, sx in { -1.6, 1.6 } do
		for _, sz in { -3.4, 3.4 } do
			P(m, "Post", Vector3.new(0.3, 7, 0.3), cf * CFrame.new(sx, 3.5, sz), Props.IRON, M.Metal)
		end
	end
	for _, y in { 1.6, 5 } do
		P(m, "Frame", Vector3.new(3.4, 0.3, 7.2), cf * CFrame.new(0, y, 0), Props.IRON, M.Metal)
		P(m, "Straw", Vector3.new(3, 0.4, 6.8), cf * CFrame.new(0, y + 0.35, 0), rgb(176, 150, 96), M.Fabric)
		P(m, "Blanket", Vector3.new(3, 0.12, 3), cf * CFrame.new(0, y + 0.6, -1.5), rgb(90, 84, 70), M.Fabric, nc())
	end
	return m
end

-- Работа для узников: груда камня с киркой
function Props.rockPile(parent, cf: CFrame)
	local m = model(parent, "RockPile")
	for k = 0, 7 do
		local a = k * 0.9
		S(m, "Rock", 1.6 + (k % 3) * 0.7, cf * CFrame.new(math.cos(a) * 1.4, 0.6 + (k % 2) * 0.6, math.sin(a) * 1.4), rgb(110 + k * 4, 106, 100), M.Slate)
	end
	S(m, "Top", 2.4, cf * CFrame.new(0, 1.8, 0), rgb(120, 116, 110), M.Slate)
	P(m, "Handle", Vector3.new(0.2, 3, 0.2), cf * CFrame.new(2.6, 1.4, -1) * CFrame.Angles(0, 0, math.rad(-30)), Props.WOOD, M.Wood, nc())
	P(m, "Pick", Vector3.new(2, 0.25, 0.25), cf * CFrame.new(3.3, 2.7, -1) * CFrame.Angles(0, 0, math.rad(-20)), Props.IRON, M.Metal, nc())
	-- тачка
	P(m, "Cart", Vector3.new(2.4, 1, 3), cf * CFrame.new(-3.4, 1.2, 0), Props.WOOD, M.WoodPlanks)
	C(m, "Wheel", 0.3, 1.2, cf * CFrame.new(-3.4, 0.6, -1.8) * CFrame.Angles(0, 0, math.pi / 2), Props.IRON, M.Metal, nc())
	for k = 0, 2 do
		S(m, "Load", 0.9, cf * CFrame.new(-3.4 + (k - 1) * 0.6, 1.9, (k % 2) * 0.5), rgb(120, 116, 110), M.Slate, nc())
	end
	return m
end

-- Точильный круг
function Props.grindstone(parent, cf: CFrame)
	local m = model(parent, "Grindstone")
	P(m, "Frame", Vector3.new(1, 3, 3), cf * CFrame.new(-1, 1.5, 0), Props.WOOD, M.Wood)
	P(m, "Frame", Vector3.new(1, 3, 3), cf * CFrame.new(1, 1.5, 0), Props.WOOD, M.Wood)
	C(m, "Wheel", 0.8, 3, cf * CFrame.new(0, 3, 0) * CFrame.Angles(0, 0, math.pi / 2), rgb(150, 146, 140), M.Slate)
	P(m, "Axle", Vector3.new(3.4, 0.25, 0.25), cf * CFrame.new(0, 3, 0), Props.IRON, M.Metal, nc())
	P(m, "Crank", Vector3.new(0.2, 1, 0.2), cf * CFrame.new(1.8, 2.6, 0), Props.IRON, M.Metal, nc())
	C(m, "Trough", 0.6, 2.2, cf * CFrame.new(0, 0.3, -1.8), Props.WOOD, M.Wood)
	return m
end

-- Корыто для стирки с бельём
function Props.washtub(parent, cf: CFrame)
	local m = model(parent, "Washtub")
	C(m, "Tub", 1.6, 3.2, cf * CFrame.new(0, 0.8, 0), Props.WOOD_LIGHT, M.Wood)
	C(m, "Water", 0.1, 2.8, cf * CFrame.new(0, 1.55, 0), rgb(150, 170, 180), M.Glass, nc({ Transparency = 0.3 }))
	P(m, "Board", Vector3.new(1.2, 2.4, 0.15), cf * CFrame.new(0.6, 1.8, 0) * CFrame.Angles(0, 0, math.rad(-20)), Props.WOOD, M.Wood, nc())
	for k = 0, 2 do
		P(m, "Linen", Vector3.new(1.4, 0.1, 1), cf * CFrame.new(-0.7 + k * 0.2, 1.62, (k - 1) * 0.5) * CFrame.Angles(0, k, 0), rgb(230, 225, 210), M.Fabric, nc())
	end
	return m
end

-- Ведро
function Props.bucket(parent, cf: CFrame)
	local m = model(parent, "Bucket")
	C(m, "Pail", 1.2, 1.2, cf * CFrame.new(0, 0.6, 0), Props.WOOD_LIGHT, M.Wood)
	C(m, "Hoop", 0.15, 1.25, cf * CFrame.new(0, 0.9, 0), Props.IRON, M.Metal, nc())
	return m
end

-- Ванна на ножках
function Props.bathtub(parent, cf: CFrame)
	local m = model(parent, "Bathtub")
	P(m, "Tub", Vector3.new(3.4, 2.2, 6.4), cf * CFrame.new(0, 1.7, 0), rgb(240, 238, 232), M.SmoothPlastic)
	P(m, "Rim", Vector3.new(3.6, 0.3, 6.6), cf * CFrame.new(0, 2.9, 0), rgb(240, 238, 232), M.SmoothPlastic)
	P(m, "Water", Vector3.new(2.8, 0.1, 5.8), cf * CFrame.new(0, 2.6, 0), rgb(150, 190, 210), M.Glass, nc({ Transparency = 0.3 }))
	for _, sx in { -1.4, 1.4 } do
		for _, sz in { -2.6, 2.6 } do
			S(m, "ClawFoot", 0.7, cf * CFrame.new(sx, 0.35, sz), Props.GOLD, M.Metal)
		end
	end
	P(m, "Faucet", Vector3.new(0.3, 1.2, 0.3), cf * CFrame.new(0, 3.5, 3), Props.GOLD, M.Metal, nc())
	P(m, "Spout", Vector3.new(0.25, 0.25, 0.8), cf * CFrame.new(0, 4, 2.7), Props.GOLD, M.Metal, nc())
	return m
end

-- Умывальник с зеркалом
function Props.washstand(parent, cf: CFrame)
	local m = model(parent, "Washstand")
	P(m, "Cabinet", Vector3.new(3.4, 3, 1.8), cf * CFrame.new(0, 1.5, 0), Props.WOOD, M.Wood)
	P(m, "Top", Vector3.new(3.6, 0.25, 2), cf * CFrame.new(0, 3.12, 0), rgb(220, 214, 204), M.Marble)
	C(m, "Basin", 0.5, 1.6, cf * CFrame.new(0, 3.4, -0.1), rgb(245, 242, 236), M.SmoothPlastic)
	C(m, "Pitcher", 1, 0.6, cf * CFrame.new(1.2, 3.75, 0.1), rgb(245, 242, 236), M.SmoothPlastic, nc())
	P(m, "Mirror", Vector3.new(2.6, 3, 0.12), cf * CFrame.new(0, 5.8, 0.85), rgb(190, 205, 215), M.Glass, { Reflectance = 0.45, CanCollide = false })
	P(m, "MirrorFrame", Vector3.new(3, 3.4, 0.1), cf * CFrame.new(0, 5.8, 0.92), Props.GOLD, M.Metal, nc())
	return m
end

-- Телескоп на треноге
function Props.telescope(parent, cf: CFrame)
	local m = model(parent, "Telescope")
	for k = 0, 2 do
		local a = k / 3 * math.pi * 2
		P(m, "Leg", Vector3.new(0.2, 4, 0.2), cf * CFrame.new(math.cos(a) * 0.9, 2, math.sin(a) * 0.9) * CFrame.Angles(math.cos(a) * 0.25, 0, -math.sin(a) * 0.25), Props.WOOD_DARK, M.Wood)
	end
	C(m, "Tube", 5, 0.8, cf * CFrame.new(0, 4.6, 0) * CFrame.Angles(math.rad(-50), 0, 0) * CFrame.Angles(math.pi / 2, 0, 0), Props.GOLD, M.Metal)
	C(m, "Lens", 0.2, 1.1, cf * CFrame.new(0, 6.5, -1.6) * CFrame.Angles(math.rad(-50), 0, 0) * CFrame.Angles(math.pi / 2, 0, 0), Props.IRON, M.Metal, nc())
	return m
end

-- Карта на столе с фигурками
function Props.mapTable(parent, cf: CFrame)
	local m, top = Props.table(parent, cf, 8, 5)
	P(m, "Map", Vector3.new(7, 0.05, 4.2), cf * CFrame.new(0, top + 0.05, 0), rgb(220, 200, 150), M.Fabric, nc())
	for k = 0, 4 do
		P(m, "Land", Vector3.new(1.4, 0.06, 1), cf * CFrame.new(-2.5 + k * 1.3, top + 0.08, (k % 2) * 1.2 - 0.6) * CFrame.Angles(0, k, 0), rgb(150, 170, 110), M.Fabric, nc())
	end
	for k = 0, 5 do
		C(m, "Pin", 0.5, 0.25, cf * CFrame.new(-2.8 + k * 1.1, top + 0.3, (k % 3) - 1), if k % 2 == 0 then rgb(170, 30, 30) else rgb(30, 60, 160), M.SmoothPlastic, nc())
	end
	Props.candle(m, (cf * CFrame.new(3.2, top, 1.8)).Position)
	return m
end

-- Длинный стол трапезной с посудой и канделябрами
function Props.feastTable(parent, cf: CFrame, len: number, chairs: boolean)
	local m, top = Props.table(parent, cf, 5, len, rgb(236, 228, 210))
	local per = math.floor((len - 2) / 3)
	for k = 0, per - 1 do
		local z = -len / 2 + 2 + k * 3
		for _, s in { -1, 1 } do
			C(m, "Plate", 0.1, 1.3, cf * CFrame.new(s * 1.5, top + 0.08, z), rgb(245, 242, 236), M.SmoothPlastic, nc())
			C(m, "Goblet", 0.6, 0.35, cf * CFrame.new(s * 1.1, top + 0.35, z + 0.9), Props.GOLD, M.Metal, nc())
			P(m, "Fork", Vector3.new(0.1, 0.04, 0.9), cf * CFrame.new(s * 1.5 - 0.9, top + 0.05, z), rgb(200, 202, 210), M.Metal, nc())
			if chairs then
				Props.chair(m, cf * CFrame.new(s * 3.6, 0, z) * CFrame.Angles(0, if s &gt; 0 then -math.pi / 2 else math.pi / 2, 0))
			end
		end
		if k % 2 == 1 then
			Props.candelabra(m, (cf * CFrame.new(0, top, z)).Position)
		end
	end
	-- блюда в центре
	C(m, "Platter", 0.15, 2, cf * CFrame.new(0, top + 0.1, -len / 4), rgb(200, 202, 210), M.Metal, nc())
	S(m, "Roast", 1.3, cf * CFrame.new(0, top + 0.6, -len / 4), rgb(150, 80, 40), M.SmoothPlastic, nc())
	C(m, "Fruitbowl", 0.5, 1.8, cf * CFrame.new(0, top + 0.3, len / 4), Props.GOLD, M.Metal, nc())
	for k = 0, 3 do
		S(m, "Fruit", 0.6, cf * CFrame.new(-0.4 + (k % 2) * 0.8, top + 0.7, len / 4 - 0.3 + math.floor(k / 2) * 0.6), Color3.fromHSV(k * 0.08, 0.8, 0.8), M.SmoothPlastic, nc())
	end
	return m, top
end

-- Скамья для улицы / зала
function Props.bench(parent, cf: CFrame, w: number)
	local m = model(parent, "Bench")
	P(m, "Seat", Vector3.new(w, 0.4, 1.8), cf * CFrame.new(0, 1.9, 0), Props.WOOD, M.Wood)
	P(m, "Back", Vector3.new(w, 1.8, 0.3), cf * CFrame.new(0, 3, 0.8) * CFrame.Angles(math.rad(-8), 0, 0), Props.WOOD, M.Wood)
	for _, s in { -1, 1 } do
		P(m, "Leg", Vector3.new(0.4, 1.8, 1.6), cf * CFrame.new(s * (w / 2 - 0.5), 0.9, 0), Props.IRON, M.Metal)
	end
	return m
end

-- Фонарь на столбе (улица)
function Props.lamppost(parent, cf: CFrame)
	local m = model(parent, "Lamppost")
	C(m, "Foot", 0.6, 1.4, cf * CFrame.new(0, 0.3, 0), Props.IRON, M.Metal)
	C(m, "Pole", 9, 0.4, cf * CFrame.new(0, 5, 0), Props.IRON, M.Metal)
	P(m, "Cage", Vector3.new(1.4, 1.8, 1.4), cf * CFrame.new(0, 10.4, 0), Props.IRON, M.Metal, nc({ Transparency = 0.6 }))
	local glow = P(m, "Glow", Vector3.new(1, 1.3, 1), cf * CFrame.new(0, 10.4, 0), rgb(255, 210, 140), M.Neon, nc())
	P(m, "Cap", Vector3.new(1.8, 0.4, 1.8), cf * CFrame.new(0, 11.5, 0), Props.IRON, M.Metal, nc())
	light(glow, 24, 1.5)
	return m
end

-- Живая изгородь
function Props.hedge(parent, cf: CFrame, len: number)
	local m = model(parent, "Hedge")
	P(m, "Body", Vector3.new(len, 3.4, 2.4), cf * CFrame.new(0, 1.7, 0), rgb(54, 94, 46), M.Grass)
	for x = -len / 2 + 1, len / 2 - 1, 2.4 do
		S(m, "Bump", 2.4, cf * CFrame.new(x, 3.3, 0), rgb(60, 104, 50), M.Grass, nc())
	end
	return m
end

-- Клумба с цветами
function Props.flowerbed(parent, cf: CFrame, w: number, d: number, seed: number)
	local m = model(parent, "Flowerbed")
	P(m, "Edge", Vector3.new(w, 0.8, d), cf * CFrame.new(0, 0.4, 0), rgb(150, 145, 136), M.Slate)
	P(m, "Soil", Vector3.new(w - 0.8, 0.85, d - 0.8), cf * CFrame.new(0, 0.43, 0), rgb(70, 50, 36), M.Ground, nc())
	local rnd = Random.new(seed)
	for _ = 1, math.floor(w * d / 3) do
		local x, z = rnd:NextNumber(-w / 2 + 0.8, w / 2 - 0.8), rnd:NextNumber(-d / 2 + 0.8, d / 2 - 0.8)
		P(m, "Stem", Vector3.new(0.1, 0.9, 0.1), cf * CFrame.new(x, 1.3, z), rgb(60, 110, 50), M.Grass, nc())
		S(m, "Bloom", 0.5, cf * CFrame.new(x, 1.8, z), Color3.fromHSV(rnd:NextNumber(), 0.55, 1), M.SmoothPlastic, nc())
	end
	return m
end

-- Колодец
function Props.well(parent, cf: CFrame)
	local m = model(parent, "Well")
	for k = 0, 11 do
		local a = k / 12 * math.pi * 2
		P(m, "Stone", Vector3.new(1.4, 2.6, 0.8), cf * CFrame.new(math.cos(a) * 2.4, 1.3, math.sin(a) * 2.4) * CFrame.Angles(0, -a, 0), rgb(140 + (k % 3) * 8, 134, 126), M.Slate)
	end
	C(m, "Water", 0.2, 4, cf * CFrame.new(0, 0.6, 0), rgb(40, 70, 90), M.Glass, nc({ Transparency = 0.2 }))
	for _, s in { -1, 1 } do
		P(m, "Post", Vector3.new(0.5, 5, 0.5), cf * CFrame.new(s * 2.6, 3.5, 0), Props.WOOD, M.Wood)
	end
	P(m, "Beam", Vector3.new(6, 0.4, 0.4), cf * CFrame.new(0, 5.6, 0), Props.WOOD_DARK, M.Wood)
	P(m, "Roof", Vector3.new(6.6, 0.3, 3.6), cf * CFrame.new(0, 6.7, -0.9) * CFrame.Angles(math.rad(-30), 0, 0), rgb(110, 60, 50), M.WoodPlanks)
	P(m, "Roof", Vector3.new(6.6, 0.3, 3.6), cf * CFrame.new(0, 6.7, 0.9) * CFrame.Angles(math.rad(30), 0, 0), rgb(110, 60, 50), M.WoodPlanks)
	P(m, "Rope", Vector3.new(0.1, 3, 0.1), cf * CFrame.new(0, 4, 0), rgb(160, 130, 90), M.Fabric, nc())
	Props.bucket(m, cf * CFrame.new(0, 1.6, 0))
	return m
end

return Props
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000034">
          <Properties>
            <string name="Name">Rooms</string>
            <ProtectedString name="Source">--!nonstrict
-- Обстановка комнат по их назначению. Мебель ставится в «слоты» вдоль стен: по два на
-- каждый 32-studs участок стены, в стороне от середины, где двери и окна. Центр комнаты
-- свободен для ковра и стола, поэтому предметы не налезают друг на друга и на проходы

local Props = require(script.Parent.Props)

local Rooms = {}

local rgb = Props.rgb
local P, C = Props.P, Props.C

-- Стили: обои, пол, низ стены. Пол везде каменный, дерево только в отделке
Rooms.STYLE = {
	hall = { paper = rgb(92, 40, 42), floor = rgb(150, 140, 126), mat = Enum.Material.Marble, rug = rgb(120, 22, 30) },
	grand_hall = { paper = rgb(110, 96, 74), floor = rgb(196, 188, 176), mat = Enum.Material.Marble, rug = rgb(120, 22, 30) },
	throne = { paper = rgb(120, 30, 36), floor = rgb(206, 198, 186), mat = Enum.Material.Marble, rug = rgb(140, 20, 28) },
	bedroom = { paper = rgb(52, 74, 62), floor = rgb(128, 120, 110), mat = Enum.Material.Slate, rug = rgb(110, 40, 40) },
	guest_suite = { paper = rgb(66, 58, 90), floor = rgb(128, 120, 110), mat = Enum.Material.Slate, rug = rgb(60, 50, 100) },
	study = { paper = rgb(60, 48, 36), floor = rgb(120, 112, 102), mat = Enum.Material.Slate, rug = rgb(90, 30, 30) },
	sitting = { paper = rgb(110, 84, 54), floor = rgb(150, 140, 126), mat = Enum.Material.Marble, rug = rgb(40, 60, 90) },
	lounge = { paper = rgb(70, 34, 50), floor = rgb(150, 140, 126), mat = Enum.Material.Marble, rug = rgb(90, 30, 60) },
	music = { paper = rgb(44, 58, 84), floor = rgb(176, 168, 156), mat = Enum.Material.Marble, rug = rgb(120, 22, 30) },
	reading = { paper = rgb(56, 70, 50), floor = rgb(120, 112, 102), mat = Enum.Material.Slate, rug = rgb(40, 70, 50) },
	trophy = { paper = rgb(80, 30, 30), floor = rgb(110, 104, 98), mat = Enum.Material.Slate, rug = rgb(60, 40, 30) },
	gallery = { paper = rgb(36, 50, 70), floor = rgb(196, 188, 176), mat = Enum.Material.Marble, rug = rgb(120, 22, 30) },
	nursery = { paper = rgb(150, 170, 186), floor = rgb(176, 168, 156), mat = Enum.Material.Marble, rug = rgb(200, 150, 170) },
	wardrobe = { paper = rgb(100, 70, 90), floor = rgb(150, 140, 126), mat = Enum.Material.Marble, rug = rgb(110, 50, 80) },
	bath = { paper = rgb(170, 190, 196), floor = rgb(220, 218, 212), mat = Enum.Material.Marble, rug = rgb(70, 110, 140) },
	kitchen = { paper = rgb(168, 150, 120), floor = rgb(120, 110, 98), mat = Enum.Material.Cobblestone, rug = nil },
	dining = { paper = rgb(100, 28, 32), floor = rgb(150, 140, 126), mat = Enum.Material.Marble, rug = rgb(120, 22, 30) },
	servants = { paper = rgb(140, 128, 108), floor = rgb(110, 104, 98), mat = Enum.Material.Slate, rug = rgb(100, 80, 60) },
	barracks = { paper = rgb(96, 90, 82), floor = rgb(100, 96, 90), mat = Enum.Material.Slate, rug = nil },
	training = { paper = rgb(110, 104, 96), floor = rgb(120, 114, 106), mat = Enum.Material.Slate, rug = nil },
	chapel = { paper = rgb(200, 190, 170), floor = rgb(206, 198, 186), mat = Enum.Material.Marble, rug = rgb(120, 22, 30) },
	chapel_small = { paper = rgb(200, 190, 170), floor = rgb(206, 198, 186), mat = Enum.Material.Marble, rug = rgb(120, 22, 30) },
	shop = { paper = rgb(126, 100, 62), floor = rgb(150, 140, 126), mat = Enum.Material.Marble, rug = rgb(60, 80, 40) },
	casino = { paper = rgb(60, 20, 50), floor = rgb(40, 34, 40), mat = Enum.Material.Marble, rug = rgb(110, 20, 60) },
	stairs = { paper = rgb(92, 40, 42), floor = rgb(150, 140, 126), mat = Enum.Material.Marble, rug = rgb(120, 22, 30) },
	stairs_down = { paper = rgb(80, 74, 66), floor = rgb(120, 114, 106), mat = Enum.Material.Slate, rug = nil },
	landing = { paper = rgb(92, 40, 42), floor = rgb(150, 140, 126), mat = Enum.Material.Marble, rug = rgb(120, 22, 30) },
	observatory = { paper = rgb(30, 34, 60), floor = rgb(120, 112, 102), mat = Enum.Material.Slate, rug = rgb(30, 40, 80) },
	treasury = { paper = rgb(110, 84, 30), floor = rgb(196, 188, 176), mat = Enum.Material.Marble, rug = rgb(120, 22, 30) },
	council = { paper = rgb(40, 46, 66), floor = rgb(150, 140, 126), mat = Enum.Material.Marble, rug = rgb(120, 22, 30) },
	map_room = { paper = rgb(90, 80, 56), floor = rgb(150, 140, 126), mat = Enum.Material.Marble, rug = rgb(60, 50, 30) },
	royal_dining = { paper = rgb(100, 28, 32), floor = rgb(196, 188, 176), mat = Enum.Material.Marble, rug = rgb(120, 22, 30) },
	king = { paper = rgb(110, 22, 30), floor = rgb(206, 198, 186), mat = Enum.Material.Marble, rug = rgb(150, 20, 28) },
	queen = { paper = rgb(84, 46, 100), floor = rgb(206, 198, 186), mat = Enum.Material.Marble, rug = rgb(110, 50, 130) },
	storeroom = { paper = rgb(90, 86, 80), floor = rgb(96, 92, 88), mat = Enum.Material.Cobblestone, rug = nil },
	guardroom = { paper = rgb(90, 86, 80), floor = rgb(96, 92, 88), mat = Enum.Material.Cobblestone, rug = nil },
	prison_guard = { paper = rgb(90, 86, 80), floor = rgb(96, 92, 88), mat = Enum.Material.Cobblestone, rug = nil },
	cellar = { paper = rgb(84, 70, 60), floor = rgb(96, 88, 80), mat = Enum.Material.Cobblestone, rug = nil },
	storage = { paper = rgb(90, 86, 80), floor = rgb(96, 92, 88), mat = Enum.Material.Cobblestone, rug = nil },
}
Rooms.STYLE.default = Rooms.STYLE.hall

function Rooms.style(kind: string)
	return Rooms.STYLE[kind] or Rooms.STYLE.default
end

-- Слоты у стен: два на каждый участок, на расстоянии 9.5 от середины участка
local function slots(room)
	local list = {}
	for si, seg in room.segs do
		for _, off in { -9, 9 } do
			local p = seg.pos + seg.tangent * off
			table.insert(list, { cf = CFrame.lookAt(p, p + seg.inward), seg = seg, used = false, room = room, index = si * 2 + (if off &gt; 0 then 1 else 0) })
		end
	end
	-- порядок перемешан, но одинаковый при каждом запуске
	table.sort(list, function(a, b)
		return (a.index * 7919) % 101 &lt; (b.index * 7919) % 101
	end)
	return list
end

-- Участки стен без дверей и окон (для каминов, алтарей, больших картин)
local function solidWalls(room)
	local list = {}
	for _, seg in room.segs do
		if not seg.opening then
			table.insert(list, seg)
		end
	end
	return list
end

-- прямоугольник на полу (XZ), занятый предметом шириной w и глубиной d, центр cf
local function rectOf(cf: CFrame, w: number, d: number)
	local lv, rv = cf.LookVector, cf.RightVector
	local ex = math.abs(rv.X) * w / 2 + math.abs(lv.X) * d / 2
	local ez = math.abs(rv.Z) * w / 2 + math.abs(lv.Z) * d / 2
	return { cf.X - ex, cf.Z - ez, cf.X + ex, cf.Z + ez }
end

local function hits(occ, r)
	for _, o in occ do
		if r[1] + 0.15 &lt; o[3] and o[1] + 0.15 &lt; r[3] and r[2] + 0.15 &lt; o[4] and o[2] + 0.15 &lt; r[4] then
			return true
		end
	end
	return false
end

-- занять место в центре комнаты (столы, диваны), чтобы мебель у стен туда не заходила
local function occupy(room, cf: CFrame, w: number, d: number)
	room.occ = room.occ or {}
	table.insert(room.occ, rectOf(cf, w, d))
end

-- первый свободный слот, куда помещается предмет w × d (спиной к стене)
local function take(list, w: number?, d: number?)
	local ww, dd = w or 6, d or 3
	for _, s in list do
		if not s.used then
			local room = s.room
			room.occ = room.occ or {}
			local r = rectOf(s.cf * CFrame.new(0, 0, -(dd / 2 + 0.35)), ww, dd)
			if not hits(room.occ, r) then
				s.used = true
				table.insert(room.occ, r)
				return s
			end
		end
	end
	return nil
end

-- поставить предмет глубиной d в слот (спиной к стене)
local function at(slot, depth: number, extra: CFrame?)
	return slot.cf * CFrame.new(0, 0, -(depth / 2 + 0.35)) * (extra or CFrame.new())
end

local function onWall(slot, y: number)
	return slot.cf * CFrame.new(0, y, -0.3)
end

local function center(room): CFrame
	return CFrame.new((room.x0 + room.x1) / 2, room.y, (room.z0 + room.z1) / 2)
end

local function size(room)
	return room.x1 - room.x0, room.z1 - room.z0
end

-- картина над низкой мебелью
local function paintingAbove(parent, slot, seed)
	Props.painting(parent, onWall(slot, 8.5), 5, 4, seed)
end

-- свет комнаты: люстра или лампа в центре каждой клетки (не больше четырёх)
local function lights(parent, room, chandelier: boolean?)
	local n = 0
	for _, c in room.cells do
		n += 1
		if n &gt; 4 then
			break
		end
		local pos = Vector3.new(c.x, room.y + room.h - 4, c.z)
		if chandelier then
			Props.chandelier(parent, pos, 3, 3)
		else
			Props.ceilingLamp(parent, pos + Vector3.new(0, 0.5, 0), 3)
		end
	end
end

-- бра на двух участках стены по сторонам от проёма
local function sconces(parent, room, count: number)
	local n = 0
	for _, seg in room.segs do
		if n &gt;= count then
			break
		end
		for _, off in { -6.8, 6.8 } do
			local p = seg.pos + seg.tangent * off + Vector3.new(0, 8, 0)
			Props.sconce(parent, CFrame.lookAt(p, p + seg.inward), n &lt; 2)
			n += 1
		end
	end
end

local function rugCenter(parent, room, st, w, d)
	if st.rug then
		local rw, rd = size(room)
		Props.rug(parent, center(room), math.min(w or rw - 12, rw - 12), math.min(d or rd - 12, rd - 12), st.rug)
	end
end

-- ---------------------------------------------------------------------------

local D = {}

D.bedroom = function(parent, room, ctx)
	local st = Rooms.style(room.kind)
	local s = slots(room)
	rugCenter(parent, room, st, 14, 10)
	local slot = take(s, 5.8, 9)
	if slot then
		local _, blanket = Props.bed(parent, at(slot, 8.5), Color3.fromHSV((room.id * 0.13) % 1, 0.45, 0.5))
		ctx.prompt(blanket, "rest", 1.5)
	end
	slot = take(s, 5.2, 2.8)
	if slot then
		Props.wardrobe(parent, at(slot, 2.4))
	end
	slot = take(s, 5.6, 2.2)
	if slot then
		Props.dresser(parent, at(slot, 1.8), 5, room.id)
		paintingAbove(parent, slot, room.id)
	end
	slot = take(s, 5.4, 5.6)
	if slot then
		Props.desk(parent, at(slot, 2.6))
	end
	slot = take(s, 9, 3)
	if slot then
		Props.armchair(parent, at(slot, 2.8), rgb(110, 40, 40))
		Props.nightstand(parent, at(slot, 1.6, CFrame.new(3.2, 0, 0)))
	end
	slot = take(s, 2.2, 2.2)
	if slot then
		Props.plant(parent, at(slot, 1.8))
		paintingAbove(parent, slot, room.id + 3)
	end
	local walls = solidWalls(room)
	if walls[1] then
		local p = walls[1].pos
		Props.fireplace(parent, CFrame.lookAt(p, p + walls[1].inward) * CFrame.new(0, 0, -1.7), room.h)
	end
	lights(parent, room)
	sconces(parent, room, 2)
end
D.guest_suite = function(parent, room, ctx)
	local c = center(room)
	occupy(room, c * CFrame.new(0, 0, 2), 9, 7)
	Props.sofa(parent, c * CFrame.new(0, 0, 4), rgb(70, 60, 110))
	Props.coffeeTable(parent, c)
	D.bedroom(parent, room, ctx)
end

D.study = function(parent, room, ctx)
	local st = Rooms.style(room.kind)
	local s = slots(room)
	rugCenter(parent, room, st, 12, 10)
	occupy(room, center(room) * CFrame.new(0, 0, 0), 6, 6)
	Props.desk(parent, center(room) * CFrame.new(0, 0, 1))
	for k = 1, 3 do
		local slot = take(s, 6.8, 2.4)
		if slot then
			Props.bookshelf(parent, at(slot, 2), 6, 12, room.id * 10 + k)
		end
	end
	local slot = take(s, 2.6, 2)
	if slot then
		Props.grandfatherClock(parent, at(slot, 1.6))
	end
	slot = take(s, 2.8, 2.8)
	if slot then
		Props.globe(parent, at(slot, 2.4))
		paintingAbove(parent, slot, room.id)
	end
	slot = take(s, 3.4, 3)
	if slot then
		Props.armchair(parent, at(slot, 2.8), rgb(60, 40, 30))
	end
	slot = take(s, 2.2, 2.2)
	if slot then
		Props.plant(parent, at(slot, 1.8))
	end
	local book = P(parent, "BookProp", Vector3.new(1.2, 0.3, 0.9), center(room) * CFrame.new(1.2, 3.52, 1.2), rgb(110, 30, 30), Enum.Material.Fabric)
	ctx.prompt(book, "book")
	lights(parent, room)
	sconces(parent, room, 2)
end
D.map_room = function(parent, room, ctx)
	occupy(room, center(room), 9, 6)
	Props.mapTable(parent, center(room))
	local s = slots(room)
	for k = 1, 3 do
		local slot = take(s, 6.8, 2.4)
		if slot then
			Props.bookshelf(parent, at(slot, 2), 6, 12, room.id * 10 + k)
		end
	end
	local slot = take(s, 2.8, 2.8)
	if slot then
		Props.globe(parent, at(slot, 2.4))
	end
	slot = take(s, 5.6, 2.2)
	if slot then
		Props.dresser(parent, at(slot, 1.8), 5, room.id)
		paintingAbove(parent, slot, room.id)
	end
	lights(parent, room, true)
	sconces(parent, room, 2)
	local _ = ctx
end
D.observatory = function(parent, room, ctx)
	local st = Rooms.style(room.kind)
	rugCenter(parent, room, st, 12, 12)
	occupy(room, center(room) * CFrame.new(0, 0, 3), 4, 4)
	Props.telescope(parent, center(room) * CFrame.new(0, 0, 3))
	local s = slots(room)
	local slot = take(s, 5.4, 5.6)
	if slot then
		Props.desk(parent, at(slot, 2.6))
	end
	slot = take(s, 2.8, 2.8)
	if slot then
		Props.globe(parent, at(slot, 2.4))
		paintingAbove(parent, slot, 2)
	end
	for k = 1, 2 do
		slot = take(s, 6.8, 2.4)
		if slot then
			Props.bookshelf(parent, at(slot, 2), 6, 12, room.id + k)
		end
	end
	lights(parent, room)
	sconces(parent, room, 2)
	local _ = ctx
end

local function sittingArea(parent, room, color)
	local c = center(room)
	occupy(room, c * CFrame.new(0, 0, 2), 14, 11)
	Props.sofa(parent, c * CFrame.new(0, 0, 4.5), color)
	Props.coffeeTable(parent, c * CFrame.new(0, 0, 0.5))
	Props.armchair(parent, c * CFrame.new(-5, 0, 0) * CFrame.Angles(0, -math.pi / 2, 0), color)
	Props.armchair(parent, c * CFrame.new(5, 0, 0) * CFrame.Angles(0, math.pi / 2, 0), color)
end

D.sitting = function(parent, room, ctx, withArmor)
	local st = Rooms.style(room.kind)
	rugCenter(parent, room, st, 16, 14)
	sittingArea(parent, room, rgb(120, 90, 50))
	local s = slots(room)
	local walls = solidWalls(room)
	if walls[1] then
		local p = walls[1].pos
		Props.fireplace(parent, CFrame.lookAt(p, p + walls[1].inward) * CFrame.new(0, 0, -1.7), room.h)
	end
	local slot = take(s, 2.6, 2)
	if slot then
		Props.grandfatherClock(parent, at(slot, 1.6))
	end
	slot = take(s, 5.6, 2.2)
	if slot then
		Props.dresser(parent, at(slot, 1.8), 5, room.id)
		paintingAbove(parent, slot, room.id)
	end
	for _ = 1, 2 do
		slot = take(s, 3, 3)
		if slot then
			Props.plant(parent, at(slot, 1.8), true)
			paintingAbove(parent, slot, room.id + 1)
		end
	end
	slot = take(s, 6.8, 2.4)
	if slot then
		Props.bookshelf(parent, at(slot, 2), 6, 12, room.id)
	end
	if withArmor then
		for _ = 1, 2 do
			slot = take(s, 3, 2.8)
			if slot then
				Props.armor(parent, at(slot, 2.6))
			end
		end
	end
	lights(parent, room, true)
	sconces(parent, room, 2)
	local _ = ctx
end
D.lounge = function(parent, room, ctx)
	D.sitting(parent, room, ctx, true)
end

D.music = function(parent, room, ctx)
	local st = Rooms.style(room.kind)
	rugCenter(parent, room, st)
	local c = center(room)
	occupy(room, c * CFrame.new(0, 0, 2), 16, 22)
	Props.piano(parent, c * CFrame.new(0, 0, 8))
	for row = 0, 1 do
		for k = -2, 2 do
			Props.chair(parent, c * CFrame.new(k * 3.2, 0, -4 - row * 4) * CFrame.Angles(0, math.pi, 0), rgb(40, 50, 90))
		end
	end
	local s = slots(room)
	for k = 1, 4 do
		local slot = take(s, 6.8, 3)
		if slot then
			if k % 2 == 0 then
				Props.plant(parent, at(slot, 1.8), true)
			else
				Props.dresser(parent, at(slot, 1.8), 5, room.id + k)
			end
			paintingAbove(parent, slot, room.id + k)
		end
	end
	lights(parent, room, true)
	sconces(parent, room, 4)
	local _ = ctx
end

D.reading = function(parent, room, ctx)
	local st = Rooms.style(room.kind)
	rugCenter(parent, room, st, 12, 12)
	local c = center(room)
	Props.armchair(parent, c * CFrame.new(-3, 0, 0) * CFrame.Angles(0, -math.pi / 2, 0), rgb(40, 70, 50))
	Props.armchair(parent, c * CFrame.new(3, 0, 0) * CFrame.Angles(0, math.pi / 2, 0), rgb(40, 70, 50))
	Props.coffeeTable(parent, c * CFrame.Angles(0, math.pi / 2, 0))
	local s = slots(room)
	for k = 1, 5 do
		local slot = take(s, 6.8, 2.4)
		if slot then
			Props.bookshelf(parent, at(slot, 2), 6, 13, room.id * 7 + k)
		end
	end
	local book = P(parent, "BookProp", Vector3.new(1.2, 0.3, 0.9), c * CFrame.new(0.8, 1.86, 0.4), rgb(40, 60, 110), Enum.Material.Fabric)
	ctx.prompt(book, "book")
	lights(parent, room)
	sconces(parent, room, 2)
end

D.trophy = function(parent, room, ctx)
	local s = slots(room)
	for k = 1, 6 do
		local slot = take(s, 7.2, 2.8)
		if slot then
			if k % 3 == 0 then
				Props.weaponRack(parent, at(slot, 1.8))
			else
				Props.armor(parent, at(slot, 2.6))
				Props.banner(parent, onWall(slot, 15), 7, Color3.fromHSV((k * 0.17) % 1, 0.6, 0.45))
			end
		end
	end
	Props.chest(parent, center(room), true)
	lights(parent, room, true)
	sconces(parent, room, 2)
	local _ = ctx
end

D.gallery = function(parent, room, ctx)
	local st = Rooms.style(room.kind)
	rugCenter(parent, room, st)
	local c = center(room)
	local w = size(room)
	for k = -1, 1, 2 do
		Props.bench(parent, c * CFrame.new(k * w / 6, 0, 0) * CFrame.Angles(0, math.pi / 2, 0), 6)
	end
	for i, seg in room.segs do
		for _, off in { -9.5, 9.5 } do
			local p = seg.pos + seg.tangent * off
			Props.painting(parent, CFrame.lookAt(p, p + seg.inward) * CFrame.new(0, 8, -0.3), 7, 6, i * 3 + (if off &gt; 0 then 1 else 0))
			Props.plant(parent, CFrame.lookAt(p, p + seg.inward) * CFrame.new(0, 0, -1.6))
		end
	end
	lights(parent, room, true)
	local _ = ctx
end

D.nursery = function(parent, room, ctx)
	local st = Rooms.style(room.kind)
	rugCenter(parent, room, st, 12, 12)
	local s = slots(room)
	for k = 1, 2 do
		local slot = take(s, 5.8, 9)
		if slot then
			local _, blanket = Props.bed(parent, at(slot, 8.5), Color3.fromHSV(k * 0.3, 0.3, 0.85))
			ctx.prompt(blanket, "rest", 1.5)
		end
	end
	local slot = take(s, 5.2, 2.8)
	if slot then
		Props.wardrobe(parent, at(slot, 2.4), rgb(200, 190, 170))
	end
	slot = take(s, 3.8, 2.4)
	if slot then
		Props.chest(parent, at(slot, 2))
		paintingAbove(parent, slot, 4)
	end
	-- кубики в центре
	local c = center(room)
	occupy(room, c, 4, 3)
	for k = 0, 5 do
		Props.P(parent, "ToyBlock", Vector3.new(1, 1, 1), c * CFrame.new(-1.5 + (k % 3), 0.5 + math.floor(k / 3), (k % 2) * 0.3) * CFrame.Angles(0, k * 0.3, 0), Color3.fromHSV(k / 6, 0.7, 0.9), Enum.Material.SmoothPlastic)
	end
	lights(parent, room)
	sconces(parent, room, 2)
end

D.wardrobe = function(parent, room, ctx)
	local st = Rooms.style(room.kind)
	rugCenter(parent, room, st, 10, 10)
	local s = slots(room)
	for k = 1, 5 do
		local slot = take(s, 5.6, 2.8)
		if slot then
			if k == 3 then
				Props.dresser(parent, at(slot, 1.8), 5, 2)
			else
				Props.wardrobe(parent, at(slot, 2.4), Color3.fromHSV(0.07, 0.45, 0.35 + k * 0.03))
			end
		end
	end
	-- вешалка с платьями
	local c = center(room)
	occupy(room, c * CFrame.new(0, 0, -2), 9, 9)
	P(parent, "Rail", Vector3.new(8, 0.25, 0.25), c * CFrame.new(0, 6.5, 0), Props.GOLD, Enum.Material.Metal)
	for _, x in { -3.8, 3.8 } do
		P(parent, "RailPost", Vector3.new(0.3, 6.5, 0.3), c * CFrame.new(x, 3.25, 0), Props.GOLD, Enum.Material.Metal)
	end
	for k = 0, 5 do
		P(parent, "Gown", Vector3.new(0.6, 4, 2), c * CFrame.new(-3 + k * 1.2, 4.2, 0), Color3.fromHSV(k * 0.15, 0.5, 0.6), Enum.Material.Fabric)
	end
	local chest = Props.chest(parent, c * CFrame.new(0, 0, -5))
	ctx.prompt(chest:FindFirstChild("Box"), "shop", 0, 10)
	lights(parent, room, true)
	sconces(parent, room, 2)
end

D.bath = function(parent, room, ctx)
	local st = Rooms.style(room.kind)
	rugCenter(parent, room, st, 8, 6)
	local s = slots(room)
	local slot = take(s, 6.8, 3.8)
	if slot then
		Props.bathtub(parent, at(slot, 6.4, CFrame.Angles(0, math.pi / 2, 0)))
	end
	slot = take(s, 3.8, 2.2)
	if slot then
		Props.washstand(parent, at(slot, 1.8))
		local basin = slot.cf
		local _ = basin
	end
	slot = take(s, 3, 3)
	if slot then
		Props.plant(parent, at(slot, 1.8), true)
	end
	slot = take(s, 5.6, 2.2)
	if slot then
		local m = Props.dresser(parent, at(slot, 1.8), 5, 2)
		for k = 0, 2 do
			P(m, "Towel", Vector3.new(1.6, 0.3, 1.2), at(slot, 1.8, CFrame.new(-1 + k, 3.5, 0)), rgb(240, 240, 236), Enum.Material.Fabric)
		end
	end
	lights(parent, room)
	sconces(parent, room, 2)
	local _ = ctx
end

D.kitchen = function(parent, room, ctx)
	local s = slots(room)
	local c = center(room)
	local stoves = 0
	for _, seg in solidWalls(room) do
		if stoves &gt;= 2 then
			break
		end
		local p = seg.pos
		local _, mouth = Props.stove(parent, CFrame.lookAt(p, p + seg.inward) * CFrame.new(0, 0, -1.9))
		ctx.prompt(mouth, "cook", 2)
		stoves += 1
	end
	occupy(room, c, 22, 6)
	local _, top = Props.prepTable(parent, c * CFrame.new(-6, 0, 0))
	local bread = P(parent, "BreadLoaves", Vector3.new(2.2, 0.8, 1.2), c * CFrame.new(-8.2, top + 0.4, 0.6), rgb(196, 140, 70), Enum.Material.Sand)
	ctx.prompt(bread, "bread")
	Props.prepTable(parent, c * CFrame.new(6, 0, 0))
	local basket = C(parent, "AppleBasket", 0.9, 1.8, c * CFrame.new(7.8, top + 0.45, 0.6), rgb(150, 110, 60), Enum.Material.Fabric)
	for k = 0, 4 do
		Props.S(parent, "Apple", 0.55, c * CFrame.new(7.4 + (k % 3) * 0.4, top + 1, 0.3 + math.floor(k / 3) * 0.5), rgb(190, 40, 40), Enum.Material.SmoothPlastic, { CanCollide = false })
	end
	ctx.prompt(basket, "apple")
	local k = 0
	for _ = 1, 8 do
		local slot = take(s, 6.2, 3.6)
		if not slot then
			break
		end
		k += 1
		if k == 1 then
			local m = Props.dresser(parent, at(slot, 1.8), 5, 1)
			ctx.prompt(m:FindFirstChild("Body"), "spoon")
		elseif k == 2 then
			local m = Props.washtub(parent, at(slot, 3.2))
			ctx.prompt(m:FindFirstChild("Tub"), "water")
		elseif k % 3 == 0 then
			Props.barrel(parent, at(slot, 2.8))
			Props.barrel(parent, at(slot, 2.8, CFrame.new(3, 0, 0)))
			Props.shelfJars(parent, onWall(slot, 0), 6)
		elseif k % 3 == 1 then
			Props.sack(parent, at(slot, 2))
			Props.sack(parent, at(slot, 2, CFrame.new(2.2, 0, 0)))
			Props.panRack(parent, onWall(slot, 0))
		else
			Props.crate(parent, at(slot, 2.6))
			Props.shelfJars(parent, onWall(slot, 0), 6)
		end
	end
	lights(parent, room)
end

D.dining = function(parent, room, ctx)
	local st = Rooms.style(room.kind)
	rugCenter(parent, room, st)
	local c = center(room)
	local w, d = size(room)
	local long = math.max(w, d) - 18
	local rot = if w &gt; d then CFrame.Angles(0, math.pi / 2, 0) else CFrame.new()
	occupy(room, c * rot, 10, long + 1)
	Props.feastTable(parent, c * rot, long, true)
	local s = slots(room)
	local walls = solidWalls(room)
	if walls[1] then
		local p = walls[1].pos
		Props.fireplace(parent, CFrame.lookAt(p, p + walls[1].inward) * CFrame.new(0, 0, -1.7), room.h)
	end
	for k = 1, 6 do
		local slot = if k % 2 == 0 then take(s, 3, 2.8) else take(s, 6.6, 2.2)
		if slot then
			if k % 2 == 0 then
				Props.armor(parent, at(slot, 2.6))
			else
				Props.dresser(parent, at(slot, 1.8), 6, k)
				paintingAbove(parent, slot, room.id + k)
			end
		end
	end
	lights(parent, room, true)
	sconces(parent, room, 4)
	local _ = ctx
end
D.royal_dining = D.dining

D.servants = function(parent, room, ctx)
	local s = slots(room)
	for k = 1, 4 do
		local slot = take(s, 5.8, 9)
		if slot then
			local _, blanket = Props.bed(parent, at(slot, 8.5), rgb(120, 110, 90))
			ctx.prompt(blanket, "rest", 1.5)
		end
	end
	local slot = take(s, 6.8, 2.2)
	if slot then
		local m = Props.weaponRack(parent, at(slot, 1.8))
		for _, d in m:GetChildren() do
			if d.Name == "Blade" then
				d.Color = rgb(150, 110, 60)
				d.Material = Enum.Material.Wood
			end
		end
		ctx.prompt(m:FindFirstChild("Back"), "broom")
	end
	slot = take(s, 3.6, 3.6)
	if slot then
		Props.washtub(parent, at(slot, 3.2))
	end
	slot = take(s, 3.8, 2.4)
	if slot then
		Props.chest(parent, at(slot, 2))
	end
	local c = center(room)
	occupy(room, c, 7, 7)
	Props.table(parent, c, 6, 3)
	Props.chair(parent, c * CFrame.new(-2, 0, -2.4) * CFrame.Angles(0, math.pi, 0))
	Props.chair(parent, c * CFrame.new(2, 0, 2.4))
	Props.candle(parent, (c * CFrame.new(0, 3.35, 0)).Position)
	lights(parent, room)
end

D.barracks = function(parent, room, ctx)
	occupy(room, center(room), 9, 6)
	Props.mapTable(parent, center(room))
	local s = slots(room)
	local k = 0
	for _ = 1, 10 do
		local nextK = k + 1
		local slot = if nextK == 1 then take(s, 6.8, 2.2) elseif nextK == 2 then take(s, 3.8, 2.4) elseif nextK % 3 == 0 then take(s, 3, 2.8) else take(s, 3.8, 7.6)
		if not slot then
			break
		end
		k += 1
		if k == 1 then
			local m = Props.weaponRack(parent, at(slot, 1.8))
			ctx.prompt(m:FindFirstChild("Back"), "sword")
		elseif k == 2 then
			local m = Props.chest(parent, at(slot, 2))
			ctx.prompt(m:FindFirstChild("Box"), "cuffs")
			P(parent, "ShacklesHook", Vector3.new(2, 0.3, 0.3), onWall(slot, 6), Props.IRON, Enum.Material.Metal)
		elseif k % 3 == 0 then
			Props.armor(parent, at(slot, 2.6))
			Props.banner(parent, onWall(slot, 15), 6)
		else
			Props.bunk(parent, at(slot, 7.2))
		end
	end
	lights(parent, room)
	sconces(parent, room, 2)
end

D.training = function(parent, room, ctx)
	local c = center(room)
	P(parent, "Mat", Vector3.new(18, 0.2, 18), c * CFrame.new(0, 0.1, 0), rgb(110, 96, 70), Enum.Material.Fabric)
	occupy(room, c, 16, 6)
	ctx.points.dummies = ctx.points.dummies or {}
	table.insert(ctx.points.dummies, c * CFrame.new(-5, 3, 0))
	table.insert(ctx.points.dummies, c * CFrame.new(5, 3, 0))
	local s = slots(room)
	for k = 1, 6 do
		local slot = take(s, 7.2, 2.2)
		if slot then
			if k == 1 then
				local m = Props.weaponRack(parent, at(slot, 1.8))
				ctx.prompt(m:FindFirstChild("Back"), "sword")
			elseif k % 2 == 0 then
				Props.bench(parent, at(slot, 1.8), 6)
			else
				-- мишень для стрельбы
				local cf = at(slot, 1)
				P(parent, "TargetStand", Vector3.new(0.4, 5, 0.4), cf * CFrame.new(0, 2.5, 0.3), Props.WOOD, Enum.Material.Wood)
				for r = 0, 3 do
					C(parent, "Target", 0.2 + r * 0.02, 4 - r, cf * CFrame.new(0, 5, -r * 0.06) * CFrame.Angles(math.pi / 2, 0, 0), if r % 2 == 0 then rgb(230, 225, 210) else rgb(170, 30, 30), Enum.Material.Fabric)
				end
			end
		end
	end
	lights(parent, room)
end

D.chapel = function(parent, room, ctx)
	local st = Rooms.style(room.kind)
	local c = center(room)
	local w, d = size(room)
	local walls = solidWalls(room)
	local altarSeg = walls[1]
	local forward = if altarSeg then altarSeg.inward else Vector3.new(0, 0, -1)
	if altarSeg then
		local p = altarSeg.pos
		Props.altar(parent, CFrame.lookAt(p, p + altarSeg.inward) * CFrame.new(0, 0, -3))
		Props.stainedGlass(parent, CFrame.lookAt(p, p + altarSeg.inward) * CFrame.new(0, 10, -0.3), 6, 8)
	end
	local base = CFrame.lookAt(c.Position, c.Position + forward)
	Props.runner(parent, base, 3, math.min(w, d) - 6, st.rug)
	local rows = math.floor((math.min(w, d) - 14) / 3.6)
	for r = 0, rows - 1 do
		for _, sx in { -1, 1 } do
			Props.pew(parent, base * CFrame.new(sx * 5.5, 0, -2 + r * 3.6), 7)
		end
	end
	local s = slots(room)
	for _ = 1, 4 do
		local slot = take(s, 1.4, 1.4)
		if slot then
			Props.candelabra(parent, at(slot, 1).Position)
			Props.painting(parent, onWall(slot, 9), 4, 6, 1)
		end
	end
	lights(parent, room, true)
	local _ = ctx
end
D.chapel_small = D.chapel

D.shop = function(parent, room, ctx)
	local st = Rooms.style(room.kind)
	rugCenter(parent, room, st, 10, 8)
	local c = center(room)
	occupy(room, c * CFrame.new(0, 0, 3), 11, 3)
	local counter = Props.counter(parent, c * CFrame.new(0, 0, 3), 10)
	ctx.prompt(counter:FindFirstChild("Body"), "shop", 0, 12)
	local s = slots(room)
	for k = 1, 6 do
		local slot = take(s, 6.2, 3)
		if slot then
			if k % 2 == 1 then
				Props.shelfJars(parent, onWall(slot, -2), 6)
				Props.crate(parent, at(slot, 2.2), 2.2)
			else
				Props.wardrobe(parent, at(slot, 2.4), rgb(110, 80, 50))
			end
		end
	end
	lights(parent, room)
	sconces(parent, room, 2)
end

D.casino = function(parent, room, ctx)
	local st = Rooms.style(room.kind)
	rugCenter(parent, room, st)
	occupy(room, center(room), 13, 13)
	local felt = Props.feltTable(parent, center(room))
	ctx.prompt(felt:FindFirstChild("Felt"), "coin")
	local s = slots(room)
	for k = 1, 4 do
		local slot = take(s, 3.6, 2.8)
		if slot then
			local m = Props.slotMachine(parent, at(slot, 2.4))
			ctx.prompt(m:FindFirstChild("Cabinet"), "slots")
		end
	end
	lights(parent, room, true)
end

D.treasury = function(parent, room, ctx)
	local st = Rooms.style(room.kind)
	rugCenter(parent, room, st)
	local c = center(room)
	occupy(room, c, 16, 16)
	for k = 0, 3 do
		local a = k / 4 * math.pi * 2
		local p = c * CFrame.new(math.cos(a) * 6, 0, math.sin(a) * 6)
		P(parent, "Pedestal", Vector3.new(2, 3.4, 2), p * CFrame.new(0, 1.7, 0), rgb(220, 214, 204), Enum.Material.Marble)
		if k % 2 == 0 then
			C(parent, "CrownBand", 0.6, 1.4, p * CFrame.new(0, 3.7, 0), Props.GOLD, Enum.Material.Metal)
			Props.S(parent, "Jewel", 0.4, p * CFrame.new(0, 4.2, 0), rgb(200, 30, 50), Enum.Material.Neon)
		else
			for g = 0, 3 do
				P(parent, "GoldBar", Vector3.new(1, 0.4, 0.5), p * CFrame.new(0, 3.6 + g * 0.4, (g % 2) * 0.2 - 0.1), Props.GOLD, Enum.Material.Metal)
			end
		end
	end
	Props.chest(parent, c, true)
	local s = slots(room)
	for k = 1, 8 do
		local slot = take(s, 3.8, 2.8)
		if slot then
			if k % 3 == 0 then
				Props.armor(parent, at(slot, 2.6))
			else
				Props.chest(parent, at(slot, 2), k % 2 == 0)
			end
		end
	end
	lights(parent, room, true)
	local _ = ctx
end

D.council = function(parent, room, ctx)
	local st = Rooms.style(room.kind)
	rugCenter(parent, room, st)
	local c = center(room)
	occupy(room, c, 22, 22)
	C(parent, "RoundTable", 0.5, 16, c * CFrame.new(0, 3.2, 0), Props.WOOD, Enum.Material.Wood)
	C(parent, "TableBase", 3, 3, c * CFrame.new(0, 1.5, 0), Props.WOOD_DARK, Enum.Material.Wood)
	for k = 0, 9 do
		local a = k / 10 * math.pi * 2
		local cp = (c * CFrame.new(math.cos(a) * 9.5, 0, math.sin(a) * 9.5)).Position
		Props.chair(parent, CFrame.lookAt(cp, Vector3.new(c.Position.X, cp.Y, c.Position.Z)), rgb(40, 50, 90))
	end
	for k = 0, 4 do
		Props.candle(parent, (c * CFrame.new(math.cos(k) * 4, 3.45, math.sin(k) * 4)).Position)
	end
	local walls = solidWalls(room)
	if walls[1] then
		local p = walls[1].pos
		Props.fireplace(parent, CFrame.lookAt(p, p + walls[1].inward) * CFrame.new(0, 0, -1.7), room.h)
	end
	local s = slots(room)
	for k = 1, 6 do
		local slot = if k % 2 == 0 then take(s, 3, 2.8) else take(s, 6.8, 2.4)
		if slot then
			Props.banner(parent, onWall(slot, 15), 8, Color3.fromHSV(k * 0.15, 0.6, 0.4))
			if k % 2 == 0 then
				Props.armor(parent, at(slot, 2.6))
			else
				Props.bookshelf(parent, at(slot, 2), 6, 10, k)
			end
		end
	end
	lights(parent, room, true)
	local _ = ctx
end

local function royal(parent, room, ctx, color, isKing)
	local st = Rooms.style(room.kind)
	rugCenter(parent, room, st)
	local s = slots(room)
	local slot = take(s, 7.8, 10)
	if slot then
		local _, blanket = Props.bed(parent, at(slot, 9.5), color, true)
		ctx.prompt(blanket, "rest", 1.5)
	end
	local walls = solidWalls(room)
	if walls[1] then
		local p = walls[1].pos
		Props.fireplace(parent, CFrame.lookAt(p, p + walls[1].inward) * CFrame.new(0, 0, -1.7), room.h)
	end
	sittingArea(parent, room, color)
	local dims = { { 5.2, 2.8 }, { 6.6, 2.2 }, { 5.4, 5.6 }, { 1.8, 1.8 }, { 3, 2.8 }, { 3, 3 }, { 3, 3 }, { 3, 3 } }
	for k = 1, 8 do
		slot = take(s, dims[k][1], dims[k][2])
		if not slot then
			break
		end
		if k == 1 then
			Props.wardrobe(parent, at(slot, 2.4), Props.WOOD_DARK)
		elseif k == 2 then
			Props.dresser(parent, at(slot, 1.8), 6, 2)
			paintingAbove(parent, slot, room.id)
		elseif k == 3 then
			Props.desk(parent, at(slot, 2.6))
		elseif k == 4 and isKing then
			local stand = P(parent, "ScepterStand", Vector3.new(1.6, 4, 1.6), at(slot, 1.6, CFrame.new(0, 2, 0)), rgb(220, 214, 204), Enum.Material.Marble)
			P(parent, "Scepter", Vector3.new(0.3, 3, 0.3), at(slot, 1.6, CFrame.new(0, 5.5, 0)), Props.GOLD, Enum.Material.Metal, { CanCollide = false })
			Props.S(parent, "Gem", 0.6, at(slot, 1.6, CFrame.new(0, 7.2, 0)), rgb(200, 30, 50), Enum.Material.Neon, { CanCollide = false })
			ctx.prompt(stand, "scepter")
		elseif k == 5 then
			Props.armor(parent, at(slot, 2.6))
		else
			Props.plant(parent, at(slot, 1.8), true)
			paintingAbove(parent, slot, room.id + k)
		end
	end
	lights(parent, room, true)
	sconces(parent, room, 4)
end
D.king = function(parent, room, ctx)
	royal(parent, room, ctx, rgb(140, 18, 28), true)
end
D.queen = function(parent, room, ctx)
	royal(parent, room, ctx, rgb(100, 40, 120), false)
	local c = center(room)
	Props.piano(parent, c * CFrame.new(-8, 0, -8) * CFrame.Angles(0, math.pi / 4, 0))
end

D.landing = function(parent, room, ctx)
	-- в клетке есть проём лестницы у восточной стены: обставляем только западную стену
	for _, seg in room.segs do
		if seg.inward.X &gt; 0.5 then
			local cf = CFrame.lookAt(seg.pos, seg.pos + seg.inward)
			Props.bench(parent, cf * CFrame.new(0, 0, -1.3), 7)
			Props.painting(parent, cf * CFrame.new(0, 8.5, -0.3), 7, 5, room.id)
			Props.plant(parent, cf * CFrame.new(-8, 0, -1.4), true)
			Props.plant(parent, cf * CFrame.new(8, 0, -1.4), true)
		end
	end
	lights(parent, room)
	local _ = ctx
end

D.storeroom = function(parent, room, ctx)
	local s = slots(room)
	local k = 0
	for _ = 1, 16 do
		local slot = take(s, 6.2, 3)
		if not slot then
			break
		end
		k += 1
		if k % 3 == 0 then
			Props.barrel(parent, at(slot, 2.8))
			Props.barrel(parent, at(slot, 2.8, CFrame.new(3, 0, 0)))
		elseif k % 3 == 1 then
			Props.crate(parent, at(slot, 2.6))
			Props.crate(parent, at(slot, 2.6, CFrame.new(0, 2.6, 0)), 2.2)
			Props.crate(parent, at(slot, 2.6, CFrame.new(2.9, 0, 0)))
		else
			Props.sack(parent, at(slot, 2))
			Props.sack(parent, at(slot, 2, CFrame.new(2.2, 0, 0)))
			Props.shelfJars(parent, onWall(slot, 0), 6)
		end
	end
	for _, c in room.cells do
		Props.ceilingLamp(parent, Vector3.new(c.x, room.y + room.h - 3.5, c.z), 2.5)
	end
	local _ = ctx
end
D.storage = D.storeroom

D.cellar = function(parent, room, ctx)
	local s = slots(room)
	for _ = 1, 20 do
		local slot = take(s, 5.4, 3.4)
		if not slot then
			break
		end
		-- стеллаж с лежащими бочками в два яруса и бутылками сбоку
		local cf = at(slot, 3)
		local rack = Props.model(parent, "WineRack")
		P(rack, "Shelf", Vector3.new(5, 0.4, 3), cf * CFrame.new(0, 3.2, 0), Props.WOOD_DARK, Enum.Material.Wood)
		P(rack, "Top", Vector3.new(5, 0.4, 3), cf * CFrame.new(0, 6.6, 0), Props.WOOD_DARK, Enum.Material.Wood)
		for _, x in { -2.3, 2.3 } do
			P(rack, "Post", Vector3.new(0.4, 6.8, 3), cf * CFrame.new(x, 3.4, 0), Props.WOOD_DARK, Enum.Material.Wood)
		end
		Props.barrel(rack, cf * CFrame.new(0, -0.1, 0), true)
		Props.barrel(rack, cf * CFrame.new(0, 3.3, 0), true)
		for k = 0, 2 do
			C(rack, "Bottle", 1.1, 0.32, cf * CFrame.new(-1.5 + k * 1.5, 7.35, 0), rgb(40, 70, 40), Enum.Material.Glass, { CanCollide = false })
		end
	end
	local c = center(room)
	occupy(room, c, 7, 4)
	Props.table(parent, c, 6, 3)
	for k = 0, 4 do
		C(parent, "Bottle", 1.2, 0.35, c * CFrame.new(-2 + k, 4, 0), rgb(40, 70, 40), Enum.Material.Glass)
	end
	for _, cell in room.cells do
		Props.ceilingLamp(parent, Vector3.new(cell.x, room.y + room.h - 3.5, cell.z), 2.5)
	end
	local _ = ctx
end

D.guardroom = function(parent, room, ctx)
	local c = center(room)
	occupy(room, c, 10, 5)
	Props.table(parent, c, 6, 4)
	for _, s in { -1, 1 } do
		Props.chair(parent, c * CFrame.new(s * 4, 0, 0) * CFrame.Angles(0, s * math.pi / 2, 0))
	end
	Props.candle(parent, (c * CFrame.new(0, 3.35, 0)).Position)
	P(parent, "Keys", Vector3.new(0.8, 0.1, 0.5), c * CFrame.new(1, 3.4, 0.5), Props.GOLD, Enum.Material.Metal)
	local s = slots(room)
	for k = 1, 4 do
		local slot = take(s, 6.8, 3)
		if slot then
			if k == 1 then
				local m = Props.weaponRack(parent, at(slot, 1.8))
				ctx.prompt(m:FindFirstChild("Back"), "sword")
			elseif k == 2 then
				local m = Props.chest(parent, at(slot, 2))
				ctx.prompt(m:FindFirstChild("Box"), "cuffs")
			else
				Props.barrel(parent, at(slot, 2.8))
			end
		end
	end
	for _, cell in room.cells do
		Props.ceilingLamp(parent, Vector3.new(cell.x, room.y + room.h - 3.5, cell.z), 2.5)
	end
end
D.prison_guard = function(parent, room, ctx)
	for _, cell in room.cells do
		Props.ceilingLamp(parent, Vector3.new(cell.x, room.y + room.h - 3.5, cell.z), 2.5)
	end
	local _ = ctx
	local _ = parent
end

D.grand_hall = function(parent, room, ctx)
	local c = center(room)
	local w, d = size(room)
	local st = Rooms.style(room.kind)
	Props.rug(parent, c, w - 30, d - 20, st.rug)
	-- два ряда колонн
	for _, sx in { -1, 1 } do
		for k = -2, 2 do
			Props.column(parent, c * CFrame.new(sx * (w / 2 - 12), 0, k * (d / 5)), room.h, 1.6)
		end
	end
	for k = -1, 1 do
		Props.chandelier(parent, Vector3.new(c.X + k * 26, room.y + room.h - 9, c.Z), 7, 8)
	end
	local s = slots(room)
	for k = 1, 10 do
		local slot = take(s, 7.2, 3)
		if slot then
			if k % 2 == 0 then
				Props.armor(parent, at(slot, 2.6))
			else
				Props.plant(parent, at(slot, 1.8), true)
			end
			Props.banner(parent, onWall(slot, room.h - 4), 12, if k % 3 == 0 then rgb(30, 50, 110) else rgb(120, 22, 30))
		end
	end
	-- доска ролей у входа
	local board = P(parent, "RoleBoard", Vector3.new(8, 6, 0.4), c * CFrame.new(-14, 5, -d / 2 + 9) * CFrame.Angles(0, math.pi, 0), Props.WOOD, Enum.Material.WoodPlanks)
	for _, x in { -3.6, 3.6 } do
		P(parent, "BoardLeg", Vector3.new(0.4, 8, 0.4), c * CFrame.new(-14 + x, 4, -d / 2 + 9), Props.WOOD_DARK, Enum.Material.Wood)
	end
	for k = 0, 5 do
		P(parent, "Notice", Vector3.new(1.6, 2, 0.05), c * CFrame.new(-16.5 + (k % 3) * 2.4, 5.8 - math.floor(k / 3) * 2.4, -d / 2 + 8.75), rgb(240, 230, 200), Enum.Material.SmoothPlastic)
	end
	ctx.prompt(board, "roles", 0, 12)
	Props.bench(parent, c * CFrame.new(14, 0, -d / 2 + 9), 8)
	Props.grandfatherClock(parent, c * CFrame.new(w / 2 - 2.3, 0, d / 2 - 2.3) * CFrame.Angles(0, math.pi * 0.75, 0))
end

-- клетка коридора: дорожка, бра, картины, столики, доспехи
function Rooms.hallCell(parent, cell, room, ctx, alongX: boolean)
	local cf = CFrame.new(cell.x, room.y, cell.z) * (if alongX then CFrame.Angles(0, math.pi / 2, 0) else CFrame.new())
	Props.runner(parent, cf, 6, 32, Rooms.STYLE.hall.rug)
	Props.ceilingLamp(parent, Vector3.new(cell.x, room.y + room.h - 3, cell.z), 2.5)
	local _ = ctx
end

function Rooms.hallWalls(parent, room, seed)
	-- по сторонам коридора: у каждого участка стены картина с бра или доспехи
	for i, seg in room.segs do
		for _, off in { -9.5, 9.5 } do
			local p = seg.pos + seg.tangent * off
			local cf = CFrame.lookAt(p, p + seg.inward)
			local k = (i * 2 + (if off &gt; 0 then 1 else 0) + seed) % 5
			if k == 0 then
				Props.armor(parent, cf * CFrame.new(0, 0, -1.7))
			elseif k == 1 then
				Props.plant(parent, cf * CFrame.new(0, 0, -1.2), true)
				Props.painting(parent, cf * CFrame.new(0, 8.5, -0.3), 5, 4, i)
			elseif k == 2 then
				-- консольный столик с вазой
				P(parent, "Console", Vector3.new(4, 0.3, 1.4), cf * CFrame.new(0, 3, -1), Props.WOOD, Enum.Material.Wood)
				for _, x in { -1.7, 1.7 } do
					P(parent, "ConsoleLeg", Vector3.new(0.25, 2.85, 0.25), cf * CFrame.new(x, 1.43, -1), Props.WOOD_DARK, Enum.Material.Wood)
				end
				C(parent, "Vase", 1.4, 0.8, cf * CFrame.new(0, 3.85, -1), Color3.fromHSV((i * 0.17) % 1, 0.45, 0.6), Enum.Material.Glass)
				Props.painting(parent, cf * CFrame.new(0, 8.5, -0.3), 5, 4, i + 1)
			elseif k == 3 then
				Props.painting(parent, cf * CFrame.new(0, 8, -0.3), 4, 6, i + 2)
				Props.bench(parent, cf * CFrame.new(0, 0, -1.2), 5)
			else
				Props.grandfatherClock(parent, cf * CFrame.new(0, 0, -1))
			end
			if (i + seed) % 2 == 0 then
				local sp = seg.pos + seg.tangent * (off * 0.55) + Vector3.new(0, 8, 0)
				Props.sconce(parent, CFrame.lookAt(sp, sp + seg.inward), false)
			end
		end
	end
end

function Rooms.decorate(parent: Instance, room, ctx)
	local fn = D[room.kind]
	if fn then
		fn(parent, room, ctx)
	end
end

Rooms.slots = slots
return Rooms
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000035">
          <Properties>
            <string name="Name">Seasons</string>
            <ProtectedString name="Source">--!nonstrict
-- Времена года и праздники замка: деревья (зимой без листьев), цвет травы, снег,
-- украшения. Меняется командой админа, всё старое убирается перед новым

local Lighting = game:GetService("Lighting")

local Seasons = {}

local terrain = workspace.Terrain
local folder: Folder?

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local LOOK = {
	summer = { grass = rgb(88, 140, 60), leaves = { rgb(70, 125, 50), rgb(90, 140, 60) }, tint = rgb(255, 240, 222) },
	spring = { grass = rgb(110, 165, 80), leaves = { rgb(120, 175, 90), rgb(240, 190, 210) }, tint = rgb(255, 244, 236), flowers = true },
	april = { grass = rgb(110, 165, 80), leaves = { rgb(120, 175, 90), rgb(255, 120, 200), rgb(120, 200, 255) }, tint = rgb(255, 236, 246), flowers = true, balloons = true },
	autumn = { grass = rgb(140, 130, 70), leaves = { rgb(200, 110, 40), rgb(220, 160, 50), rgb(160, 60, 30) }, tint = rgb(255, 228, 200), fallen = true },
	halloween = { grass = rgb(95, 100, 60), leaves = { rgb(150, 70, 30), rgb(90, 60, 40) }, tint = rgb(235, 210, 255), pumpkins = true, spooky = true },
	winter = { grass = rgb(235, 240, 245), leaves = nil, tint = rgb(225, 235, 255), snow = true },
	newyear = { grass = rgb(235, 240, 245), leaves = nil, tint = rgb(225, 235, 255), snow = true, tree = true },
}
Seasons.LIST = { "summer", "spring", "april", "autumn", "halloween", "winter", "newyear" }

local function part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in props do
		(p :: any)[k] = v
	end
	p.Parent = props.Parent or folder
	return p
end

local function tree(pos: Vector3, look, rnd: Random)
	local h = rnd:NextNumber(10, 15)
	part({ Name = "Trunk", Shape = Enum.PartType.Cylinder, Size = Vector3.new(h, 1.6, 1.6), CFrame = CFrame.new(pos + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color = rgb(90, 64, 44), Material = Enum.Material.Wood })
	if look.leaves then
		for i = 1, 4 do
			local d = rnd:NextNumber(5, 8)
			local off = Vector3.new(rnd:NextNumber(-2.5, 2.5), h + rnd:NextNumber(-1, 2.5), rnd:NextNumber(-2.5, 2.5))
			local c = look.leaves[rnd:NextInteger(1, #look.leaves)]
			part({ Name = "Leaves", Shape = Enum.PartType.Ball, Size = Vector3.new(d, d, d), CFrame = CFrame.new(pos + off), Color = c, Material = Enum.Material.LeafyGrass, CanCollide = i == 1, CastShadow = true })
		end
	else
		-- голые ветки
		for i = 1, 5 do
			local a = i / 5 * math.pi * 2
			local len = rnd:NextNumber(3, 5)
			part({ Name = "Branch", Size = Vector3.new(0.5, len, 0.5), CFrame = CFrame.new(pos + Vector3.new(0, h - 1, 0)) * CFrame.Angles(0, a, math.rad(35)) * CFrame.new(0, len / 2, 0), Color = rgb(80, 58, 40), Material = Enum.Material.Wood, CanCollide = false })
		end
		if look.snow then
			part({ Name = "SnowCap", Shape = Enum.PartType.Ball, Size = Vector3.new(2.4, 1.2, 2.4), CFrame = CFrame.new(pos + Vector3.new(0, h + 0.2, 0)), Color = rgb(250, 252, 255), Material = Enum.Material.Snow, CanCollide = false })
		end
	end
	if look.fallen then
		for _ = 1, 6 do
			local c = look.leaves[rnd:NextInteger(1, #look.leaves)]
			part({ Name = "FallenLeaf", Size = Vector3.new(0.8, 0.05, 0.6), CFrame = CFrame.new(pos + Vector3.new(rnd:NextNumber(-5, 5), 0.05, rnd:NextNumber(-5, 5))) * CFrame.Angles(0, rnd:NextNumber(0, 6.28), 0), Color = c, Material = Enum.Material.Fabric, CanCollide = false })
		end
	end
	if look.flowers then
		for _ = 1, 5 do
			local c = Color3.fromHSV(rnd:NextNumber(), 0.6, 1)
			part({ Name = "Flower", Shape = Enum.PartType.Ball, Size = Vector3.new(0.6, 0.6, 0.6), CFrame = CFrame.new(pos + Vector3.new(rnd:NextNumber(-4, 4), 0.4, rnd:NextNumber(-4, 4))), Color = c, Material = Enum.Material.SmoothPlastic, CanCollide = false })
		end
	end
end

local function pumpkin(pos: Vector3, glow: boolean)
	local p = part({ Name = "Pumpkin", Shape = Enum.PartType.Ball, Size = Vector3.new(2.6, 2, 2.6), CFrame = CFrame.new(pos + Vector3.new(0, 1, 0)), Color = rgb(230, 120, 30), Material = Enum.Material.SmoothPlastic })
	part({ Name = "Stem", Size = Vector3.new(0.3, 0.7, 0.3), CFrame = CFrame.new(pos + Vector3.new(0, 2.2, 0)), Color = rgb(70, 90, 40), Material = Enum.Material.Wood, CanCollide = false })
	if glow then
		local l = Instance.new("PointLight")
		l.Color = rgb(255, 140, 40)
		l.Range = 10
		l.Brightness = 1.5
		l.Parent = p
	end
end

local function newYearTree(pos: Vector3)
	part({ Name = "Trunk", Size = Vector3.new(2, 4, 2), CFrame = CFrame.new(pos + Vector3.new(0, 2, 0)), Color = rgb(90, 64, 44), Material = Enum.Material.Wood })
	for k = 0, 5 do
		local r = 16 - k * 2.5
		part({ Name = "Fir", Shape = Enum.PartType.Cylinder, Size = Vector3.new(3, r, r), CFrame = CFrame.new(pos + Vector3.new(0, 5 + k * 3, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color = rgb(30, 90, 50), Material = Enum.Material.LeafyGrass })
		for j = 0, 7 - k do
			local a = j / (8 - k) * math.pi * 2 + k
			local b = part({ Name = "Ornament", Shape = Enum.PartType.Ball, Size = Vector3.new(0.9, 0.9, 0.9), CFrame = CFrame.new(pos + Vector3.new(math.cos(a) * r / 2, 4.2 + k * 3, math.sin(a) * r / 2)), Color = Color3.fromHSV((j * 0.13 + k * 0.2) % 1, 0.8, 1), Material = Enum.Material.Neon, CanCollide = false })
			local _ = b
		end
	end
	local star = part({ Name = "Star", Shape = Enum.PartType.Ball, Size = Vector3.new(2.2, 2.2, 2.2), CFrame = CFrame.new(pos + Vector3.new(0, 23.5, 0)), Color = rgb(255, 220, 90), Material = Enum.Material.Neon, CanCollide = false })
	local l = Instance.new("PointLight")
	l.Color = rgb(255, 220, 140)
	l.Range = 30
	l.Brightness = 2
	l.Parent = star
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2
		part({ Name = "Gift", Size = Vector3.new(2, 1.6, 2), CFrame = CFrame.new(pos + Vector3.new(math.cos(a) * 9, 0.8, math.sin(a) * 9)) * CFrame.Angles(0, a, 0), Color = Color3.fromHSV(k / 6, 0.7, 0.9), Material = Enum.Material.SmoothPlastic })
	end
end

local function balloon(pos: Vector3, c: Color3)
	part({ Name = "Balloon", Shape = Enum.PartType.Ball, Size = Vector3.new(2, 2.4, 2), CFrame = CFrame.new(pos), Color = c, Material = Enum.Material.SmoothPlastic, CanCollide = false })
	part({ Name = "String", Size = Vector3.new(0.05, 6, 0.05), CFrame = CFrame.new(pos - Vector3.new(0, 4, 0)), Color = rgb(240, 240, 240), CanCollide = false })
end

-- trees — точки деревьев из постройки, roofs — крыши (зимой их присыпает снегом)
function Seasons.apply(season: string, trees: { Vector3 })
	local look = LOOK[season] or LOOK.summer
	if folder then
		folder:Destroy()
	end
	local f = Instance.new("Folder")
	f.Name = "Season"
	folder = f
	local rnd = Random.new(7)
	for _, pos in trees do
		tree(pos, look, rnd)
	end
	pcall(function()
		terrain:SetMaterialColor(Enum.Material.Grass, look.grass)
		terrain:SetMaterialColor(Enum.Material.Mud, if look.snow then rgb(220, 225, 232) else rgb(90, 70, 50))
		terrain:SetMaterialColor(Enum.Material.Cobblestone, if look.snow then rgb(200, 205, 212) else rgb(130, 126, 120))
	end)
	if look.snow then
		-- снежные шапки на зубцах и сугробы во дворе
		for i = 1, 30 do
			part({ Name = "Snowdrift", Shape = Enum.PartType.Ball, Size = Vector3.new(rnd:NextNumber(4, 8), 1.2, rnd:NextNumber(4, 8)), CFrame = CFrame.new(rnd:NextNumber(-160, 160), 0.1, rnd:NextNumber(-168, -120)), Color = rgb(250, 252, 255), Material = Enum.Material.Snow, CanCollide = false })
			local _ = i
		end
	end
	if look.pumpkins then
		for i = 0, 15 do
			local x = if i % 2 == 0 then -30 else 30
			pumpkin(Vector3.new(x, 0, -168 + i * 3), true)
		end
		for _, pos in trees do
			pumpkin(pos + Vector3.new(3, 0, 2), false)
		end
		-- паутина в углах двора и летучие мыши
		for k = 0, 7 do
			local bat = part({ Name = "Bat", Size = Vector3.new(2, 0.2, 0.8), CFrame = CFrame.new(math.cos(k) * 60, 60 + k * 3, -140 + math.sin(k) * 40), Color = rgb(20, 18, 22), Material = Enum.Material.SmoothPlastic, CanCollide = false })
			local _ = bat
		end
	end
	if look.tree then
		newYearTree(Vector3.new(110, 0, -140))
		for z = -160, 160, 16 do
			for _, x in { -169, 169 } do
				local p = part({ Name = "Garland", Shape = Enum.PartType.Ball, Size = Vector3.new(0.8, 0.8, 0.8), CFrame = CFrame.new(x, 20, z), Color = Color3.fromHSV(((z + 160) / 320) % 1, 0.8, 1), Material = Enum.Material.Neon, CanCollide = false })
				local _ = p
			end
		end
	end
	if look.balloons then
		for k = 0, 19 do
			balloon(Vector3.new(math.cos(k) * 50, 16 + (k % 4) * 3, -142 + math.sin(k * 1.7) * 22), Color3.fromHSV(k / 20, 0.7, 1))
		end
	end
	f.Parent = workspace
	local cc = Lighting:FindFirstChild("CastleColor")
	if cc then
		(cc :: ColorCorrectionEffect).TintColor = look.tint
	end
	return look
end

-- погода по умолчанию для времени года
function Seasons.defaultWeather(season: string): string
	if season == "winter" or season == "newyear" then
		return "Snow"
	elseif season == "autumn" then
		return "Rain"
	elseif season == "halloween" then
		return "Fog"
	end
	return "Clear"
end

return Seasons
</ProtectedString>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="RBX00000036">
        <Properties>
          <string name="Name">Config</string>
          <ProtectedString name="Source">--!nonstrict
-- Настройки сервера мастерской

local Config = {}

-- Администраторы: ID пользователей Roblox. Владелец плейса — администратор всегда
Config.ADMIN_USER_IDS = {} :: { number }
-- Создатели: могут открывать меню создателя, когда включена «Витрина», включать и
-- выключать её. Владелец игры — создатель всегда. Имена проверяются по ID аккаунта
Config.CREATOR_USERNAMES = { "Saren45hil", "Nataliaavira13" } :: { string }
Config.CREATOR_USER_IDS = {} :: { number }
-- Группа: { id = 123, minRank = 200 } или nil
Config.ADMIN_GROUP = nil :: { id: number, minRank: number }?

-- Отдельное имя хранилища мастерской. Office DataStore не использует (проверено по
-- исходникам 0.2.0-test), но имя выбрано так, чтобы не совпасть с будущими данными Office
Config.DATASTORE_NAME = "CreatorWorkshop_Projects_v1"
Config.AUTOSAVE_SECONDS = 20
Config.SAVE_RETRY_SECONDS = 8
Config.READONLY_RETRY_SECONDS = 10

-- Сессии игры размещаются далеко друг от друга, чтобы карты не пересекались
Config.SLOT_SPACING = 4000
-- Предпросмотр редактора строится на клиенте в этой точке
Config.EDITOR_ORIGIN = Vector3.new(0, 0, -6000)
Config.LOBBY_ORIGIN = Vector3.new(0, 0, 0)

Config.EDIT_OPS_PER_SECOND = 40
Config.REQUESTS_PER_SECOND = 6
Config.CLOSET_DISTANCE = 10
Config.CLOSET_TAP_COOLDOWN = 0.3
Config.NPC_GREET_COOLDOWN = 10

return Config
</ProtectedString>
        </Properties>
      </Item>
      <Item class="Folder" referent="RBX00000037">
        <Properties>
          <string name="Name">Core</string>
        </Properties>
        <Item class="ModuleScript" referent="RBX00000038">
          <Properties>
            <string name="Name">ProjectStore</string>
            <ProtectedString name="Source">--!nonstrict
-- Хранилище проектов поверх адаптера DataStore
--
-- Правила:
--  * ошибка чтения никогда не превращается в пустую карту и не приводит к записи;
--  * «Сохранено» означает подтверждённую запись (UpdateAsync вернул новую ревизию);
--  * черновик пишет только сервер, который держит блокировку сессии;
--  * публикация — неизменяемый снимок с номером версии, правка черновика её не меняет
--
-- Адаптер: { get = function(key) -&gt; value, update = function(key, fn) -&gt; newValue }
-- Обе функции могут бросать ошибку (сбой DataStore); fn может вернуть nil для отмены

local Shared = game:GetService("ReplicatedStorage").Workshop.Shared
local Util = require(Shared.Util)
local Format = require(Shared.Format)
local Demo = require(Shared.Demo)
local Prefabs = require(Shared.Prefabs)

local ProjectStore = {}
ProjectStore.__index = ProjectStore

local CODE_ALPHABET = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789"
local CATALOG_SIZE = 100
-- сохранений (карт) у каждого игрока не больше десяти, названия у одного игрока не повторяются
local MAX_PROJECTS = 10
ProjectStore.MAX_PROJECTS = MAX_PROJECTS

local function draftKey(userId: number, projectId: string)
	return string.format("u%d:draft:%s", userId, projectId)
end
local function indexKey(userId: number)
	return string.format("u%d:index", userId)
end
local function libKey(userId: number)
	return string.format("u%d:lib", userId)
end
local function pubKey(code: string)
	return "pub:" .. code
end
local function pubVersionKey(code: string, v: number)
	return string.format("pubv:%s:%d", code, v)
end

function ProjectStore.new(adapter, opts)
	local self = setmetatable({}, ProjectStore)
	self.adapter = adapter
	self.jobId = (opts and opts.jobId) or "local"
	self.now = (opts and opts.now) or os.time
	self.lockTimeout = (opts and opts.lockTimeout) or 120
	self.random = (opts and opts.random) or Random.new()
	return self
end

function ProjectStore:_get(key: string)
	local ok, res = pcall(self.adapter.get, key)
	if not ok then
		return false, "read_failed: " .. tostring(res)
	end
	return true, res
end

function ProjectStore:_update(key: string, fn)
	local abortReason = nil
	local ok, res = pcall(self.adapter.update, key, function(old)
		local okFn, newValue, reason = pcall(fn, old)
		if not okFn then
			abortReason = "update_fn: " .. tostring(newValue)
			return nil
		end
		if newValue == nil then
			abortReason = reason or "aborted"
		end
		return newValue
	end)
	if not ok then
		return false, "write_failed: " .. tostring(res)
	end
	if abortReason then
		return false, abortReason
	end
	return true, res
end

function ProjectStore:_newProjectId(): string
	return string.format("p%x%04x", self.now(), self.random:NextInteger(0, 0xffff))
end

local function normName(s: string): string
	return Util.lower(Util.trim(s))
end

-- Название уже есть у этого игрока (у других игроков такое же название разрешено)
function ProjectStore.nameTaken(index, name: string, exceptId: string?): boolean
	if not index or not index.projects then
		return false
	end
	local n = normName(name)
	for pid, e in index.projects do
		if pid ~= exceptId and type(e.name) == "string" and normName(e.name) == n then
			return true
		end
	end
	return false
end

-- Удаление сохранения: карта убирается из списка, черновик помечается удалённым
-- (опубликованные версии по коду остаются доступны)
function ProjectStore:deleteProject(userId: number, projectId: string)
	local ok, err = self:_update(indexKey(userId), function(index)
		if not index or not index.projects[projectId] then
			return nil, "not_found"
		end
		index.projects[projectId] = nil
		return index
	end)
	if not ok then
		return false, err
	end
	self:_update(draftKey(userId, projectId), function(old)
		if old == nil then
			return nil
		end
		old.deleted = true
		old.lock = nil
		return old
	end)
	return true
end

-- Проверка перед переименованием карты
function ProjectStore:canRename(userId: number, projectId: string, name: string)
	local ok, index = self:_get(indexKey(userId))
	if not ok then
		return false, "load_failed"
	end
	if ProjectStore.nameTaken(index, name, projectId) then
		return false, "name_taken"
	end
	return true
end

-- Список карт автора. При ошибке чтения возвращает false, а не пустой список
function ProjectStore:listProjects(userId: number)
	local ok, index = self:_get(indexKey(userId))
	if not ok then
		return false, index
	end
	local out = {}
	for pid, entry in (index and index.projects) or {} do
		local e = Util.deepCopy(entry)
		e.id = pid
		table.insert(out, e)
	end
	table.sort(out, function(a, b)
		return (a.updatedAt or 0) &gt; (b.updatedAt or 0)
	end)
	return true, out
end

function ProjectStore:createProject(userId: number, name: string, template: string?)
	local pid = self:_newProjectId()
	local project
	if template == "demo" then
		project = Demo.build(pid, userId)
		project.meta.name = name

	else
		project = Format.newProject(pid, name, userId)
		-- новая карта сразу с платформой: на неё удобно ставить блоки, в игре это пол
		for _, o in Prefabs.baseplate(project) do
			project.map.objects[o.id] = o
		end
	end
	local e = Format.validateProject(project)
	if e then
		return false, "invalid: " .. e
	end
	-- сначала индекс (с проверкой лимита), потом черновик
	local ok, err = self:_update(indexKey(userId), function(index)
		index = index or { projects = {} }
		if Util.count(index.projects) &gt;= MAX_PROJECTS then
			return nil, "too_many_projects"
		end
		if ProjectStore.nameTaken(index, name, nil) then
			return nil, "name_taken"
		end
		index.projects[pid] = { name = name, updatedAt = self.now(), publishCode = nil }
		return index
	end)
	if not ok then
		return false, err
	end
	local now = self.now()
	ok, err = self:_update(draftKey(userId, pid), function(old)
		if old ~= nil then
			return nil, "exists"
		end
		return { rev = 1, savedAt = now, lock = { job = self.jobId, at = now }, data = project }
	end)
	if not ok then
		return false, err
	end
	return true, project, 1
end

-- Открытие черновика с захватом блокировки сессии
-- Возвращает ok, project, rev, readOnly
function ProjectStore:openDraft(userId: number, projectId: string)
	local now = self.now()
	local result, rev, readOnly = nil, 0, false
	local ok, err = self:_update(draftKey(userId, projectId), function(old)
		if old == nil or old.deleted then
			return nil, "not_found"
		end
		local okM, data = Format.migrate(Util.deepCopy(old.data))
		if not okM then
			return nil, "cannot_open: " .. tostring(data)
		end
		result = data
		rev = old.rev
		local lock = old.lock
		if lock and lock.job ~= self.jobId and now - lock.at &lt; self.lockTimeout then
			readOnly = true
			return nil, "locked"
		end
		old.lock = { job = self.jobId, at = now }
		return old
	end)
	if not ok then
		if err == "locked" then
			return true, result, rev, true
		end
		return false, err
	end
	return true, result, rev, readOnly
end

-- Запись черновика. baseRev — ревизия, на которой основаны правки
function ProjectStore:saveDraft(userId: number, project, baseRev: number)
	local e = Format.validateProject(project)
	if e then
		return false, "invalid: " .. e
	end
	local now = self.now()
	local snapshot = Util.deepCopy(project)
	local newRev = 0
	local ok, err = self:_update(draftKey(userId, project.id), function(old)
		if old == nil then
			return nil, "not_found"
		end
		if old.rev ~= baseRev then
			return nil, "conflict"
		end
		local lock = old.lock
		if lock and lock.job ~= self.jobId and now - lock.at &lt; self.lockTimeout then
			return nil, "locked"
		end
		newRev = old.rev + 1
		return { rev = newRev, savedAt = now, lock = { job = self.jobId, at = now }, data = snapshot }
	end)
	if not ok then
		return false, err
	end
	-- индекс обновляем после подтверждённой записи черновика; его сбой не отменяет сохранение
	self:_update(indexKey(userId), function(index)
		if not index or not index.projects[project.id] then
			return nil
		end
		index.projects[project.id].name = project.meta.name
		index.projects[project.id].updatedAt = now
		return index
	end)
	return true, newRev
end

function ProjectStore:releaseLock(userId: number, projectId: string)
	return self:_update(draftKey(userId, projectId), function(old)
		if old == nil or not old.lock or old.lock.job ~= self.jobId then
			return nil, "not_owner"
		end
		old.lock = nil
		return old
	end)
end

function ProjectStore:_newCode(): string
	local chars = {}
	for i = 1, 6 do
		local k = self.random:NextInteger(1, #CODE_ALPHABET)
		chars[i] = string.sub(CODE_ALPHABET, k, k)
	end
	return table.concat(chars)
end

-- Публикация: snapshot уже проверен и отфильтрован вызывающим кодом
-- Возвращает ok, code, version
function ProjectStore:publish(userId: number, project, snapshot)
	local e = Format.validateProject(snapshot)
	if e then
		return false, "invalid: " .. e
	end
	local code = project.meta.publishCode
	local now = self.now()
	if not code then
		for _ = 1, 8 do
			local candidate = self:_newCode()
			local ok = self:_update(pubKey(candidate), function(old)
				if old ~= nil then
					return nil, "taken"
				end
				return { projectId = project.id, ownerId = userId, name = project.meta.name, latest = 0, createdAt = now }
			end)
			if ok then
				code = candidate
				break
			end
		end
		if not code then
			return false, "no_code"
		end
	end
	local okPtr, ptr = self:_get(pubKey(code :: string))
	if not okPtr then
		return false, ptr
	end
	if not ptr or ptr.ownerId ~= userId or ptr.projectId ~= project.id then
		return false, "not_owner"
	end
	local version = (ptr.latest or 0) + 1
	local frozen = Util.deepCopy(snapshot)
	frozen.meta.publishCode = code
	frozen.meta.publishedVersion = version
	-- сначала неизменяемая версия, потом указатель на неё
	local ok, err = self:_update(pubVersionKey(code :: string, version), function(old)
		if old ~= nil then
			return nil, "version_exists"
		end
		return { version = version, publishedAt = now, data = frozen }
	end)
	if not ok then
		return false, err
	end
	ok, err = self:_update(pubKey(code :: string), function(old)
		if not old or old.ownerId ~= userId then
			return nil, "not_owner"
		end
		if (old.latest or 0) &gt;= version then
			return nil, "stale"
		end
		old.latest = version
		old.name = project.meta.name
		old.updatedAt = now
		old.unlisted = false
		return old
	end)
	if not ok then
		return false, err
	end
	self:_update(indexKey(userId), function(index)
		if not index or not index.projects[project.id] then
			return nil
		end
		index.projects[project.id].publishCode = code
		index.projects[project.id].publishedVersion = version
		return index
	end)
	self:_update("catalog", function(cat)
		cat = cat or { entries = {} }
		for i = #cat.entries, 1, -1 do
			if cat.entries[i].code == code then
				table.remove(cat.entries, i)
			end
		end
		table.insert(cat.entries, 1, { code = code, name = project.meta.name, ownerId = userId, version = version, at = now })
		while #cat.entries &gt; CATALOG_SIZE do
			table.remove(cat.entries)
		end
		return cat
	end)
	return true, code, version
end

-- Загрузка опубликованной карты по коду (последняя или указанная версия)
function ProjectStore:loadPublished(code: string, version: number?)
	code = string.upper(Util.trim(code))
	if not string.match(code, "^[A-Z0-9]+$") or #code ~= 6 then
		return false, "bad_code"
	end
	local ok, ptr = self:_get(pubKey(code))
	if not ok then
		return false, ptr
	end
	if not ptr or (ptr.latest or 0) &lt; 1 or ptr.unlisted then
		return false, "not_found"
	end
	local v = version or ptr.latest
	local okV, rec = self:_get(pubVersionKey(code, v))
	if not okV then
		return false, rec
	end
	if not rec then
		return false, "not_found"
	end
	local okM, data = Format.migrate(Util.deepCopy(rec.data))
	if not okM then
		return false, "cannot_open"
	end
	return true, data, v, ptr
end

function ProjectStore:catalog()
	local ok, cat = self:_get("catalog")
	if not ok then
		return false, cat
	end
	return true, (cat and cat.entries) or {}
end

-- Снятие с публикации (админ-панель или автор)
function ProjectStore:unlist(code: string)
	local ok, err = self:_update(pubKey(code), function(old)
		if not old then
			return nil, "not_found"
		end
		old.unlisted = true
		return old
	end)
	if not ok then
		return false, err
	end
	self:_update("catalog", function(cat)
		if not cat then
			return nil
		end
		for i = #cat.entries, 1, -1 do
			if cat.entries[i].code == code then
				table.remove(cat.entries, i)
			end
		end
		return cat
	end)
	return true
end

-- «Витрина»: опубликованная карта, которую видят все вместо меню создателя
function ProjectStore:getShowcase()
	local ok, rec = self:_get("showcase")
	if not ok then
		return false, rec
	end
	if rec and rec.enabled and type(rec.code) == "string" then
		return true, rec
	end
	return true, nil
end

function ProjectStore:setShowcase(code: string?, userId: number)
	if code == "MAFIA" then
		-- особая витрина: все сразу попадают в «Мафию»
		return self:_update("showcase", function()
			return { enabled = true, code = "MAFIA", name = "Мафия", setBy = userId, at = self.now() }
		end)
	end
	if code then
		local okP, data = self:loadPublished(code)
		if not okP then
			return false, data
		end
		code = data.meta.publishCode
		local name = data.meta.name
		return self:_update("showcase", function()
			return { enabled = true, code = code, name = name, setBy = userId, at = self.now() }
		end)
	end
	return self:_update("showcase", function()
		return { enabled = false, setBy = userId, at = self.now() }
	end)
end

-- «Мои модели»
function ProjectStore:saveLibraryModel(userId: number, asset)
	if Util.approxSize(asset) &gt; 200000 then
		return false, "too_large"
	end
	local assetId = string.format("m%x%04x", self.now(), self.random:NextInteger(0, 0xffff))
	local ok, err = self:_update(libKey(userId), function(lib)
		lib = lib or { models = {} }
		if Util.count(lib.models) &gt;= 60 then
			return nil, "library_full"
		end
		lib.models[assetId] = asset
		return lib
	end)
	if not ok then
		return false, err
	end
	return true, assetId
end

function ProjectStore:listLibrary(userId: number)
	local ok, lib = self:_get(libKey(userId))
	if not ok then
		return false, lib
	end
	local out = {}
	for id, a in (lib and lib.models) or {} do
		table.insert(out, { id = id, name = a.name, savedAt = a.savedAt })
	end
	table.sort(out, function(a, b)
		return (a.savedAt or 0) &gt; (b.savedAt or 0)
	end)
	return true, out
end

function ProjectStore:getLibraryModel(userId: number, assetId: string)
	local ok, lib = self:_get(libKey(userId))
	if not ok then
		return false, lib
	end
	local a = lib and lib.models[assetId]
	if not a then
		return false, "not_found"
	end
	return true, a
end

return ProjectStore
</ProtectedString>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="RBX00000039">
        <Properties>
          <string name="Name">CurrencyService</string>
          <ProtectedString name="Source">--!nonstrict
-- Монеты игрока: общая валюта Creator, сохраняется между заходами
-- В DataStore записывается только приращение (+5, −3), а не итог, поэтому
-- ошибка загрузки или второй сервер не могут затереть баланс

local Players = game:GetService("Players")


local CurrencyService = {}

-- название в таблице игроков; новичок получает стартовое золото один раз
local GOLD = "Gold"
local START_GOLD = 100

local store: any
local wallets: { [Player]: { base: number, delta: number, loaded: boolean, value: IntValue } } = {}

local function key(userId: number): string
	return string.format("u%d:coins", userId)
end

local function valueOf(player: Player): IntValue
	local stats = player:FindFirstChild("leaderstats")
	if not stats then
		stats = Instance.new("Folder")
		stats.Name = "leaderstats"
		stats.Parent = player
	end
	local v = stats:FindFirstChild(GOLD) :: IntValue?
	if not v then
		local nv = Instance.new("IntValue")
		nv.Name = GOLD
		nv.Parent = stats
		v = nv
	end
	return v :: IntValue
end

local function show(player: Player)
	local w = wallets[player]
	if w then
		w.value.Value = w.base + w.delta
	end
end

local function flush(player: Player): boolean
	local w = wallets[player]
	if not w or w.delta == 0 then
		return true
	end
	local delta = w.delta
	local ok, res = store:_update(key(player.UserId), function(old)
		local cur = (type(old) == "table" and old.coins) or 0
		return { coins = math.max(0, cur + delta) }
	end)
	if ok then
		w.delta -= delta
		w.base = res.coins - w.delta
		w.loaded = true
		show(player)
		return true
	end
	return false
end

function CurrencyService.get(player: Player): number?
	local w = wallets[player]
	if not w or not w.loaded then
		return nil
	end
	return w.base + w.delta
end

function CurrencyService.add(player: Player, amount: number): boolean
	local w = wallets[player]
	if not w then
		return false
	end
	if amount &lt; 0 then
		-- списывать можно только при известном балансе
		local cur = CurrencyService.get(player)
		if not cur or cur + amount &lt; 0 then
			return false
		end
	end
	w.delta += math.floor(amount)
	show(player)
	return true
end

function CurrencyService.init(projectStore)
	store = projectStore
	local function join(player: Player)
		local w = { base = 0, delta = 0, loaded = false, value = valueOf(player) }
		wallets[player] = w
		local ok, rec = store:_get(key(player.UserId))
		if ok then
			w.base = (type(rec) == "table" and rec.coins) or 0
			w.loaded = true
			if rec == nil then
				w.delta += START_GOLD
				task.spawn(flush, player)
			end
		else
			warn("[Creator] монеты не загрузились, баланс не меняется до следующей попытки")
		end
		show(player)
	end
	Players.PlayerAdded:Connect(join)
	for _, p in Players:GetPlayers() do
		task.spawn(join, p)
	end
	Players.PlayerRemoving:Connect(function(player)
		flush(player)
		wallets[player] = nil
	end)
	task.spawn(function()
		while true do
			task.wait(30)
			for p, w in wallets do
				if w.delta ~= 0 then
					task.spawn(flush, p)
				elseif not w.loaded then
					local ok, rec = store:_get(key(p.UserId))
					if ok then
						w.base = (type(rec) == "table" and rec.coins) or 0
						w.loaded = true
						show(p)
					end
				end
			end
		end
	end)
	game:BindToClose(function()
		for p in wallets do
			task.spawn(flush, p)
		end
		task.wait(3)
	end)
end

return CurrencyService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0000003A">
        <Properties>
          <string name="Name">DataStoreAdapter</string>
          <ProtectedString name="Source">--!nonstrict
-- Адаптер DataStore для ProjectStore
-- В Studio без доступа к API используется память сервера с предупреждением в выводе

local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")

local Config = require(script.Parent.Config)

local Adapter = {}

local function waitBudget(kind: Enum.DataStoreRequestType)
	local deadline = os.clock() + 15
	while DataStoreService:GetRequestBudgetForRequestType(kind) &lt; 1 and os.clock() &lt; deadline do
		task.wait(0.5)
	end
end

local function deepCopy(v: any): any
	if type(v) ~= "table" then
		return v
	end
	local o = {}
	for k, x in v do
		o[k] = deepCopy(x)
	end
	return o
end

function Adapter.memory()
	local data = {}
	return {
		kind = "memory",
		get = function(key: string)
			return deepCopy(data[key])
		end,
		update = function(key: string, fn)
			local nv = fn(deepCopy(data[key]))
			if nv ~= nil then
				data[key] = deepCopy(nv)
			end
			return deepCopy(nv)
		end,
	}
end

function Adapter.create()
	local ok, store = pcall(function()
		return DataStoreService:GetDataStore(Config.DATASTORE_NAME)
	end)
	if ok and RunService:IsStudio() then
		-- проверяем доступ к API в Studio
		local probe = pcall(function()
			return store:GetAsync("probe")
		end)
		if not probe then
			ok = false
		end
	end
	if not ok then
		warn("[Workshop] DataStore недоступен, поэтому данные хранятся только в памяти этого сервера (включите Studio Access to API Services)")
		return Adapter.memory()
	end
	local ds = store :: DataStore
	return {
		kind = "datastore",
		get = function(key: string)
			waitBudget(Enum.DataStoreRequestType.GetAsync)
			return ds:GetAsync(key)
		end,
		update = function(key: string, fn)
			waitBudget(Enum.DataStoreRequestType.UpdateAsync)
			return ds:UpdateAsync(key, function(old)
				return fn(old)
			end)
		end,
	}
end

return Adapter
</ProtectedString>
        </Properties>
      </Item>
      <Item class="Folder" referent="RBX0000003B">
        <Properties>
          <string name="Name">Mafia</string>
        </Properties>
        <Item class="ModuleScript" referent="RBX0000003C">
          <Properties>
            <string name="Name">MafiaGame</string>
            <ProtectedString name="Source">--!nonstrict
-- Игра «Мафия»: лобби, раздача ролей, ночь и день, голосования, призраки, ведущий, чаты
-- Права проверяются только здесь, на сервере; клиент получает лишь то, что ему можно знать

local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")
local HttpService = game:GetService("HttpService")

local Shared = game:GetService("ReplicatedStorage").Workshop.Shared
local Rules = require(Shared.MafiaRules)
local UiText = require(Shared.UiText)
local Remotes = require(Shared.Roblox.Remotes)
local Village = require(script.Parent.Village)
local Access = require(script.Parent.Parent.Access)

local L = UiText.L

local Game = {}

local DURATION = { reveal = 8, dusk = 20, night = 40, morning = 7, day = 120, vote = 40, verdict = 7, ended = 25 }

local state = {
	phase = "idle", -- idle | lobby | reveal | dusk | night | morning | day | vote | verdict | ended
	endsAt = 0,
	players = {} :: { [Player]: any }, -- { role, alive, house, seat }
	host = nil :: Player?,
	settings = { style = "spring", theme = "plain", auto = true, counts = { mafia = 2, doctor = 1, sheriff = 1 } },
	world = nil,
	votes = {},
	mafiaVotes = {},
	heals = {},
	checks = {},
	lastHeal = {},
	round = 0,
	winner = nil,
}
Game.state = state

local event: RemoteEvent
local channels = {}

local function inGame(p: Player): boolean
	return state.players[p] ~= nil
end

local function participants(): { Player }
	local out = {}
	for p in state.players do
		if p ~= state.host then
			table.insert(out, p)
		end
	end
	table.sort(out, function(a, b)
		return a.UserId &lt; b.UserId
	end)
	return out
end

local function aliveMap()
	local alive = {}
	for p, info in state.players do
		if info.role and info.alive then
			alive[p] = true
		end
	end
	return alive
end

local function rolesMap()
	local roles = {}
	for p, info in state.players do
		if info.role then
			roles[p] = info.role
		end
	end
	return roles
end

local function send(p: Player, msg)
	if p.Parent then
		event:FireClient(p, msg)
	end
end

local function sendAll(msg)
	for p in state.players do
		send(p, msg)
	end
end

local function announce(text: string, sound: string?)
	sendAll({ type = "announce", text = text, sound = sound })
end

-- Публичный список игроков: имена и кто жив; роли не раскрываются до конца игры
local function publicPlayers()
	local list = {}
	for _, p in participants() do
		local info = state.players[p]
		table.insert(list, {
			userId = p.UserId,
			name = p.DisplayName,
			alive = info.alive ~= false,
			house = info.house,
			role = if state.phase == "ended" then info.role else nil,
		})
	end
	return list
end

-- Личное состояние: своя роль, свои действия; мафии — выбор остальных мафиози
local function sync(p: Player)
	local info = state.players[p]
	if not info then
		return
	end
	local isHost = p == state.host
	local msg = {
		type = "state",
		phase = state.phase,
		endsAt = state.endsAt,
		round = state.round,
		players = publicPlayers(),
		hostId = state.host and state.host.UserId,
		youHost = isHost,
		canStart = isHost or state.host == nil,
		creator = Access.isCreator(p),
		settings = state.settings,
		role = info.role,
		alive = info.alive ~= false,
		house = info.house,
		vote = state.votes[p] and (if state.votes[p] == "skip" then "skip" else state.votes[p].UserId),
		winner = state.winner,
		chat = {},
	}
	-- голоса днём видят все (открытое голосование)
	if state.phase == "vote" then
		local tally = {}
		for voter, target in state.votes do
			local key = if target == "skip" then "skip" else tostring(target.UserId)
			tally[key] = (tally[key] or 0) + 1
			local _ = voter
		end
		msg.tally = tally
	end
	if info.role == "mafia" or isHost then
		local mv = {}
		for voter, target in state.mafiaVotes do
			mv[tostring(voter.UserId)] = target.UserId
		end
		msg.mafiaVotes = mv
		local team = {}
		for q, qi in state.players do
			if qi.role == "mafia" then
				table.insert(team, q.UserId)
			end
		end
		msg.mafiaTeam = team
	end
	if isHost then
		local all = {}
		for q, qi in state.players do
			all[tostring(q.UserId)] = qi.role
		end
		msg.allRoles = all
	end
	if info.role == "sheriff" then
		msg.checks = info.checks or {}
	end
	if info.role == "doctor" then
		msg.lastHeal = state.lastHeal[p] and state.lastHeal[p].UserId
		msg.heal = state.heals[p] and state.heals[p].UserId
	end
	for _, ch in { "general", "mafia", "ghost" } do
		local canSend, canSee = Rules.chat(ch, { role = info.role, alive = info.alive ~= false, host = isHost }, state.phase)
		msg.chat[ch] = { send = canSend, see = canSee }
	end
	send(p, msg)
end

local function syncAll()
	for p in state.players do
		sync(p)
	end
end

-- ---------------------------------------------------------------------------
-- чаты: свой общий канал игры, канал мафии и канал призраков

local function channel(name: string): TextChannel
	if channels[name] then
		return channels[name]
	end
	local folder = TextChatService:FindFirstChild("TextChannels") or TextChatService
	local c = folder:FindFirstChild(name) :: TextChannel?
	if not c then
		local nc = Instance.new("TextChannel")
		nc.Name = name
		nc.Parent = folder
		c = nc
	end
	channels[name] = c
	return c :: TextChannel
end

local NAMES = { general = "MafiaTown", mafia = "MafiaRoom", ghost = "GhostRoom" }

local function sourceOf(c: TextChannel, p: Player): TextSource?
	for _, s in c:GetChildren() do
		if s:IsA("TextSource") and s.UserId == p.UserId then
			return s
		end
	end
	return nil
end

local function applyChat(p: Player)
	local info = state.players[p]
	for key, name in NAMES do
		local c = channel(name)
		local canSend, canSee = false, false
		if info then
			canSend, canSee = Rules.chat(key, { role = info.role, alive = info.alive ~= false, host = p == state.host }, state.phase)
			if state.phase == "lobby" or state.phase == "idle" then
				canSend, canSee = key == "general", key == "general"
			end
		end
		local src = sourceOf(c, p)
		if canSee then
			if not src then
				local ok, res = pcall(function()
					return c:AddUserAsync(p.UserId)
				end)
				src = if ok then res else nil
			end
			if src then
				src.CanSend = canSend
			end
		elseif src then
			src:Destroy()
		end
	end
	-- общий канал Roblox для игроков мафии закрыт, чтобы не было подсказок мимо правил
	local general = TextChatService:FindFirstChild("TextChannels") and TextChatService.TextChannels:FindFirstChild("RBXGeneral")
	if general then
		local src = sourceOf(general, p)
		if src then
			src.CanSend = info == nil
		end
	end
end

local function applyChatAll()
	for p in state.players do
		applyChat(p)
	end
end

-- ---------------------------------------------------------------------------
-- перемещения

local function root(p: Player): BasePart?
	return p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function hideName(p: Player)
	local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		hum.NameDisplayDistance = 0
	end
end

local function teleport(p: Player, cf: CFrame)
	if p.Character then
		local hrp = root(p)
		if hrp then
			hrp.Anchored = false
			hrp.AssemblyLinearVelocity = Vector3.zero
		end
		p.Character:PivotTo(cf)
	end
end

local function toLobby(p: Player)
	if state.world then
		local i = 0
		for q in state.players do
			i += 1
			if q == p then
				break
			end
		end
		teleport(p, state.world.lobby * CFrame.new(((i - 1) % 5 - 2) * 4, 0, ((i - 1) // 5 - 1) * 4))
	end
end

local function toSeat(p: Player)
	local info = state.players[p]
	if state.world and info and info.seat then
		teleport(p, state.world.seats[info.seat])
	end
end

local function toHouse(p: Player)
	local info = state.players[p]
	if state.world and info and info.house then
		teleport(p, state.world.houses[info.house].inside)
	end
end

local function makeGhost(p: Player)
	if not state.world then
		return
	end
	local char = p.Character
	if char then
		for _, d in char:GetDescendants() do
			if d:IsA("BasePart") then
				d.Transparency = 1
				d.CanCollide = false
			elseif d:IsA("Decal") then
				d.Transparency = 1
			end
		end
		teleport(p, state.world.sky)
		local hrp = root(p)
		if hrp then
			hrp.Anchored = true
		end
	end
end

local function everyone(fn)
	for p, info in state.players do
		if p ~= state.host and info.alive ~= false then
			fn(p)
		end
	end
end

local function setDoors(open: boolean)
	if state.world then
		for _, h in state.world.houses do
			Village.setDoor(h, open)
		end
	end
end

-- ---------------------------------------------------------------------------
-- фазы

local function setPhase(phase: string, duration: number?)
	state.phase = phase
	state.endsAt = workspace:GetServerTimeNow() + (duration or DURATION[phase] or 30)
	applyChatAll()
	syncAll()
	sendAll({ type = "phase", phase = phase, endsAt = state.endsAt, world = state.world and { sky = state.world.sky, center = state.world.center, weather = state.world.weather, style = state.world.style } })
end

local function checkWin(): boolean
	local w = Rules.winner(rolesMap(), aliveMap())
	if w then
		state.winner = w
		setPhase("ended")
		announce(if w == "mafia" then L.MafiaWins else L.TownWins, "win")
		return true
	end
	return false
end

local function kill(p: Player, cause: string)
	local info = state.players[p]
	if not info or info.alive == false then
		return
	end
	info.alive = false
	makeGhost(p)
	send(p, { type = "ghost" })
	announce(string.format(if cause == "vote" then L.ExiledFormat else L.KilledFormat, p.DisplayName), "death")
end

local startNight

local function startDay()
	state.votes = {}
	setDoors(true)
	everyone(toSeat)
	setPhase("day")
end

local function startVote()
	state.votes = {}
	setPhase("vote")
	announce(L.VoteNow, "vote")
end

local function finishVote()
	if state.phase ~= "vote" then
		return
	end
	local alive = aliveMap()
	local votes = {}
	for voter, target in state.votes do
		votes[voter] = target
	end
	local exiled = Rules.dayResult(votes, alive)
	if exiled then
		kill(exiled, "vote")
	else
		announce(L.NobodyExiled)
	end
	if not checkWin() then
		setPhase("verdict")
	end
end

function startNight()
	state.round += 1
	state.mafiaVotes = {}
	state.heals = {}
	state.checks = {}
	setPhase("dusk")
	announce(L.GoHome, "night")
end

local function nightActions()
	-- по домам: кто не дошёл, переносится сам
	everyone(toHouse)
	setDoors(false)
	setPhase("night")
end

local function finishNight()
	local target = Rules.mafiaTarget((function()
		local v = {}
		for voter, t in state.mafiaVotes do
			v[voter] = t
		end
		return v
	end)(), rolesMap(), aliveMap())
	local heals = {}
	for doctor, healed in state.heals do
		table.insert(heals, healed)
		state.lastHeal[doctor] = healed
	end
	local victim, saved = Rules.nightResult(target, heals)
	setPhase("morning")
	if victim then
		kill(victim, "night")
	elseif saved then
		announce(L.DoctorSaved, "save")
	else
		announce(L.QuietNight)
	end
	checkWin()
end

local function advance()
	local p = state.phase
	if p == "reveal" then
		startNight()
	elseif p == "dusk" then
		nightActions()
	elseif p == "night" then
		finishNight()
	elseif p == "morning" then
		startDay()
	elseif p == "day" then
		startVote()
	elseif p == "vote" then
		finishVote()
	elseif p == "verdict" then
		startNight()
	elseif p == "ended" then
		Game.backToLobby()
	end
end
Game.advance = advance

-- ---------------------------------------------------------------------------
-- лобби и старт

local function buildWorld()
	state.world = Village.build(state.settings.style, state.settings.theme)
end

function Game.backToLobby()
	state.winner = nil
	state.round = 0
	for p, info in state.players do
		info.role = nil
		info.alive = true
		info.checks = nil
		if p.Parent then
			p:LoadCharacter()
		end
	end
	state.lastHeal = {}
	if state.world and state.world.lobbyModel then
		state.world.lobbyModel.Parent = state.world.folder
	end
	setPhase("lobby", 3600)
	for p in state.players do
		task.delay(1, function()
			hideName(p)
			toLobby(p)
		end)
	end
end

function Game.join(p: Player)
	if state.players[p] then
		return { ok = true }
	end
	local count = 0
	for _ in state.players do
		count += 1
	end
	if count &gt;= Rules.MAX_PLAYERS + 1 then
		return { ok = false, error = "full" }
	end
	if state.phase == "idle" then
		buildWorld()
		state.phase = "lobby"
		state.endsAt = workspace:GetServerTimeNow() + 3600
	end
	state.players[p] = { role = nil, alive = true }
	if not p.Character then
		p.CharacterAdded:Wait()
	end
	hideName(p)
	p.CharacterAdded:Connect(function()
		task.wait()
		hideName(p)
		local info = state.players[p]
		if not info then
			return
		end
		if state.phase == "lobby" or state.phase == "idle" then
			toLobby(p)
		elseif info.alive == false or info.role == nil then
			makeGhost(p)
		elseif state.phase == "day" or state.phase == "vote" or state.phase == "verdict" or state.phase == "morning" then
			toSeat(p)
		else
			toHouse(p)
		end
	end)
	if state.phase == "lobby" then
		toLobby(p)
	else
		-- игра уже идёт: новичок смотрит сверху и ждёт следующей партии
		state.players[p].alive = false
		makeGhost(p)
	end
	applyChat(p)
	sendAll({ type = "joined", name = p.DisplayName })
	syncAll()
	sendAll({ type = "phase", phase = state.phase, endsAt = state.endsAt, world = { sky = state.world.sky, center = state.world.center, weather = state.world.weather, style = state.world.style } })
	return { ok = true }
end

function Game.leave(p: Player)
	local info = state.players[p]
	if not info then
		return
	end
	state.players[p] = nil
	if state.host == p then
		state.host = nil
		announce(L.HostLeft)
	end
	applyChat(p)
	if info.role and info.alive ~= false and state.phase ~= "lobby" and state.phase ~= "ended" then
		announce(string.format(L.LeftFormat, p.DisplayName))
		checkWin()
	end
	local any = next(state.players) ~= nil
	if not any then
		state.phase = "idle"
		if state.world then
			state.world.folder:Destroy()
			state.world = nil
		end
	else
		syncAll()
	end
end

local function canControl(p: Player): boolean
	return p == state.host or (state.host == nil and state.players[p] ~= nil)
end

local function start(p: Player)
	if state.phase ~= "lobby" or not canControl(p) then
		return { ok = false, error = "forbidden" }
	end
	local ids = participants()
	if #ids &lt; Rules.MIN_PLAYERS then
		return { ok = false, error = "few" }
	end
	local counts = if state.settings.auto then Rules.autoCounts(#ids) else state.settings.counts
	local bad = Rules.checkCounts(#ids, counts)
	if bad then
		return { ok = false, error = bad }
	end
	local rng = Random.new()
	local roles = Rules.assign(ids, counts, function(a, b)
		return rng:NextInteger(a, b)
	end)
	-- дома и места у стола тоже по жребию
	local order = table.clone(ids)
	for i = #order, 2, -1 do
		local j = rng:NextInteger(1, i)
		order[i], order[j] = order[j], order[i]
	end
	for i, q in order do
		local info = state.players[q]
		info.role = roles[q]
		info.alive = true
		info.house = i
		info.seat = i
		info.checks = {}
	end
	if state.host then
		state.players[state.host].role = nil
		state.players[state.host].alive = false
	end
	if state.world and state.world.lobbyModel then
		state.world.lobbyModel.Parent = nil
	end
	for _, q in ids do
		toSeat(q)
	end
	if state.host then
		teleport(state.host, state.world.seats[1] * CFrame.new(0, 0, 4))
	end
	setPhase("reveal")
	announce(L.GameStarts, "start")
	return { ok = true }
end

-- ---------------------------------------------------------------------------
-- запросы клиента

local function playerById(id): Player?
	if type(id) ~= "number" then
		return nil
	end
	local p = Players:GetPlayerByUserId(id)
	if p and state.players[p] and p ~= state.host then
		return p
	end
	return nil
end

local handlers = {}

handlers.Join = function(p)
	return Game.join(p)
end

handlers.Leave = function(p)
	Game.leave(p)
	return { ok = true }
end

handlers.BecomeHost = function(p, on)
	if state.phase ~= "lobby" then
		return { ok = false }
	end
	if on and state.host == nil then
		state.host = p
	elseif not on and state.host == p then
		state.host = nil
	elseif on and state.host and Access.isCreator(p) then
		-- создатель может забрать роль ведущего
		state.host = p
	else
		return { ok = false }
	end
	syncAll()
	return { ok = true }
end

handlers.Settings = function(p, s)
	if state.phase ~= "lobby" or not canControl(p) or type(s) ~= "table" then
		return { ok = false }
	end
	local themes = { summer = { plain = true }, spring = { plain = true, april = true }, autumn = { plain = true, halloween = true }, winter = { plain = true, newyear = true } }
	local style = if themes[s.style] then s.style else state.settings.style
	local theme = if themes[style][s.theme] then s.theme else "plain"
	local rebuild = style ~= state.settings.style or theme ~= state.settings.theme
	state.settings.style = style
	state.settings.theme = theme
	state.settings.auto = s.auto ~= false
	if type(s.counts) == "table" then
		local c = {}
		for _, k in { "mafia", "doctor", "sheriff" } do
			local lim = Rules.LIMITS[k]
			c[k] = math.clamp(math.floor(tonumber(s.counts[k]) or lim[1]), lim[1], lim[2])
		end
		state.settings.counts = c
	end
	if rebuild then
		buildWorld()
		for q in state.players do
			toLobby(q)
		end
		sendAll({ type = "phase", phase = state.phase, endsAt = state.endsAt, world = { sky = state.world.sky, center = state.world.center, weather = state.world.weather, style = state.world.style } })
	end
	syncAll()
	return { ok = true }
end

handlers.Start = function(p)
	return start(p)
end

-- дневной голос
handlers.Vote = function(p, targetId)
	local info = state.players[p]
	if state.phase ~= "vote" or not info or not info.role or info.alive == false then
		return { ok = false }
	end
	if targetId == "skip" then
		state.votes[p] = "skip"
	else
		local t = playerById(targetId)
		if not t or state.players[t].alive == false then
			return { ok = false }
		end
		state.votes[p] = t
	end
	syncAll()
	-- все проголосовали: подводим итог раньше времени
	local need, have = 0, 0
	for q, qi in state.players do
		if qi.role and qi.alive ~= false then
			need += 1
			if state.votes[q] then
				have += 1
			end
		end
	end
	if have &gt;= need then
		task.defer(finishVote)
	end
	return { ok = true }
end

-- ночные действия
handlers.Night = function(p, targetId)
	local info = state.players[p]
	if state.phase ~= "night" or not info or info.alive == false then
		return { ok = false }
	end
	local t = playerById(targetId)
	if not t or state.players[t].alive == false then
		return { ok = false }
	end
	if info.role == "mafia" then
		if state.players[t].role == "mafia" then
			return { ok = false }
		end
		state.mafiaVotes[p] = t
		for q, qi in state.players do
			if qi.role == "mafia" or q == state.host then
				sync(q)
			end
		end
	elseif info.role == "doctor" then
		if state.lastHeal[p] == t then
			return { ok = false, error = "same" }
		end
		state.heals[p] = t
		sync(p)
	elseif info.role == "sheriff" then
		if state.checks[p] or t == p then
			return { ok = false, error = "once" }
		end
		state.checks[p] = t
		local isMafia = state.players[t].role == "mafia"
		info.checks = info.checks or {}
		table.insert(info.checks, { name = t.DisplayName, mafia = isMafia, round = state.round })
		sync(p)
	else
		return { ok = false }
	end
	return { ok = true }
end

-- ведущий
handlers.Host = function(p, action, arg)
	if p ~= state.host and not (state.host == nil and Access.isCreator(p)) then
		return { ok = false, error = "forbidden" }
	end
	if action == "next" then
		advance()
	elseif action == "more" then
		state.endsAt += 30
		syncAll()
		sendAll({ type = "phase", phase = state.phase, endsAt = state.endsAt })
	elseif action == "home" then
		everyone(toHouse)
		sendAll({ type = "sound", sound = "whoosh" })
	elseif action == "table" then
		everyone(toSeat)
	elseif action == "toss" or action == "bring" or action == "sendHome" then
		local t = playerById(arg)
		local hrp = t and root(t)
		if not t or not hrp then
			return { ok = false }
		end
		if action == "toss" then
			-- «пинок»: игрока подбрасывает в сторону его дома
			local info = state.players[t]
			local target = if info.house and state.world then state.world.houses[info.house].porch.Position else hrp.Position
			local dir = target - hrp.Position
			dir = Vector3.new(dir.X, 0, dir.Z)
			dir = if dir.Magnitude &gt; 1 then dir.Unit else Vector3.new(0, 0, 1)
			hrp.AssemblyLinearVelocity = dir * 70 + Vector3.new(0, 55, 0)
			send(t, { type = "sound", sound = "whoosh" })
		elseif action == "bring" then
			local mine = root(p)
			if mine then
				teleport(t, mine.CFrame * CFrame.new(0, 0, -5))
			end
		else
			toHouse(t)
		end
	end
	return { ok = true }
end

-- ---------------------------------------------------------------------------

-- hooks: { beforeJoin = fn(p), afterLeave = fn(p) } — переход из замка и обратно
function Game.init(hooks)
	hooks = hooks or {}
	event = Remotes.event("Mafia")
	Remotes.fn("MafiaRequest").OnServerInvoke = function(p: Player, action: any, ...: any)
		local h = type(action) == "string" and handlers[action]
		if not h then
			return { ok = false }
		end
		if action == "Join" and hooks.beforeJoin then
			hooks.beforeJoin(p)
		end
		local ok, res = pcall(h, p, ...)
		if action == "Leave" and hooks.afterLeave then
			hooks.afterLeave(p)
		end
		if not ok then
			warn("[Mafia] " .. tostring(action) .. ": " .. tostring(res))
			return { ok = false }
		end
		return res
	end
	-- таймер фаз
	task.spawn(function()
		while true do
			task.wait(0.5)
			if state.phase ~= "idle" and state.phase ~= "lobby" and workspace:GetServerTimeNow() &gt;= state.endsAt then
				local ok, err = pcall(advance)
				if not ok then
					warn("[Mafia] phase: " .. tostring(err))
				end
			end
		end
	end)
	Players.PlayerRemoving:Connect(Game.leave)
	local _ = HttpService
end

function Game.inGame(p: Player): boolean
	return inGame(p)
end

return Game
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX0000003D">
          <Properties>
            <string name="Name">Village</string>
            <ProtectedString name="Source">--!nonstrict
-- Деревня для «Мафии»: настоящий рельеф Roblox (песок, трава, снег, вода), 13 домиков
-- по кругу дверями к центру, стол для обсуждения, деревья и оформление сезона
-- Стили: summer (песок и море), spring (трава, деревья, озеро), autumn (непроходимый лес),
-- winter (снег). Темы: winter — newyear | plain, autumn — halloween | plain,
-- spring — april | plain (в обычной весне четыре статуи держат купол), summer — plain

local Lighting = game:GetService("Lighting")

local Statue = require(script.Parent.Parent.Statue)

local Village = {}

Village.ORIGIN = Vector3.new(0, 0, 9000)
Village.HOUSES = 13
Village.RING = 64
Village.STATUE_USER = "Nataliaavira13"

local V = Village.ORIGIN
local terrain = workspace.Terrain

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local function part(parent: Instance, props): BasePart
	local cls = props.Class or "Part"
	local p = Instance.new(cls)
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in props do
		if k ~= "Class" and k ~= "Sphere" then
			(p :: any)[k] = v
		end
	end
	if props.Sphere then
		local m = Instance.new("SpecialMesh")
		m.MeshType = Enum.MeshType.Sphere
		m.Parent = p
	end
	p.Parent = parent
	return p
end

local function rnd(seed: number)
	local s = seed
	return function(a: number, b: number): number
		s = (s * 1103515245 + 12345) % 2147483648
		return a + (b - a) * ((s // 65536) % 10000) / 10000
	end
end

-- ---------------------------------------------------------------------------
-- деревья

local function deciduous(parent, pos: Vector3, h: number, leaf: Color3, r)
	local m = Instance.new("Model")
	m.Name = "Tree"
	part(m, { Name = "Trunk", Shape = Enum.PartType.Cylinder, Size = Vector3.new(h, 1.4, 1.4), CFrame = CFrame.new(pos + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color = rgb(95, 68, 45), Material = Enum.Material.Wood })
	for i = 1, 4 do
		local d = r(5, 8)
		local off = Vector3.new(r(-2.2, 2.2), h + r(-1, 2.2), r(-2.2, 2.2))
		part(m, { Name = "Leaves", Shape = Enum.PartType.Ball, Size = Vector3.new(d, d, d), CFrame = CFrame.new(pos + off), Color = leaf:Lerp(rgb(0, 0, 0), r(0, 0.18)), Material = Enum.Material.LeafyGrass, CanCollide = i == 1 })
	end
	m.Parent = parent
	return m
end

local function pine(parent, pos: Vector3, h: number, snowy: boolean, r)
	local m = Instance.new("Model")
	m.Name = "Pine"
	part(m, { Name = "Trunk", Shape = Enum.PartType.Cylinder, Size = Vector3.new(h * 0.35, 1.1, 1.1), CFrame = CFrame.new(pos + Vector3.new(0, h * 0.175, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color = rgb(85, 60, 40), Material = Enum.Material.Wood })
	local tiers = 5
	for i = 0, tiers - 1 do
		local w = (1 - i / tiers) * h * 0.55 + 1
		local y = h * 0.25 + i * h * 0.15
		part(m, { Name = "Needles", Shape = Enum.PartType.Cylinder, Size = Vector3.new(h * 0.16, w, w), CFrame = CFrame.new(pos + Vector3.new(0, y, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color = rgb(35, 85, 50), Material = Enum.Material.Grass, CanCollide = i == 0 })
		if snowy then
			part(m, { Name = "Snow", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.35, w * 0.8, w * 0.8), CFrame = CFrame.new(pos + Vector3.new(0, y + h * 0.08, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color = rgb(245, 248, 255), Material = Enum.Material.Snow, CanCollide = false })
		end
	end
	m.Parent = parent
	return m
end

local function palm(parent, pos: Vector3, h: number, r)
	local m = Instance.new("Model")
	m.Name = "Palm"
	local lean = r(-0.25, 0.25)
	local top = pos
	local seg = h / 5
	for i = 1, 5 do
		local a = lean * i / 5
		local cf = CFrame.new(top) * CFrame.Angles(a, 0, a * 0.6) * CFrame.new(0, seg / 2, 0)
		part(m, { Name = "Trunk", Shape = Enum.PartType.Cylinder, Size = Vector3.new(seg + 0.2, 1.1 - i * 0.08, 1.1 - i * 0.08), CFrame = cf * CFrame.Angles(0, 0, math.pi / 2), Color = rgb(150, 115, 75), Material = Enum.Material.Wood })
		top = (cf * CFrame.new(0, seg / 2, 0)).Position
	end
	for k = 0, 6 do
		local yaw = k / 7 * math.pi * 2
		local leaf = CFrame.new(top) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(-0.45, 0, 0) * CFrame.new(0, 0, -3.2)
		part(m, { Name = "Leaf", Size = Vector3.new(1.6, 0.2, 6.5), CFrame = leaf, Color = rgb(60, 140, 60), Material = Enum.Material.LeafyGrass, CanCollide = false })
	end
	for k = 0, 2 do
		part(m, { Name = "Coconut", Shape = Enum.PartType.Ball, Size = Vector3.new(0.9, 0.9, 0.9), CFrame = CFrame.new(top + Vector3.new(math.cos(k * 2.1) * 0.7, -0.6, math.sin(k * 2.1) * 0.7)), Color = rgb(90, 60, 35), CanCollide = false })
	end
	m.Parent = parent
	return m
end

local function pumpkin(parent, cf: CFrame, s: number)
	local m = Instance.new("Model")
	m.Name = "Pumpkin"
	part(m, { Name = "Body", Size = Vector3.new(2.2, 1.6, 2.2) * s, CFrame = cf, Color = rgb(230, 120, 25), Material = Enum.Material.SmoothPlastic, Sphere = true })
	part(m, { Name = "Stem", Size = Vector3.new(0.25, 0.6, 0.25) * s, CFrame = cf * CFrame.new(0, 0.95 * s, 0), Color = rgb(70, 110, 40) })
	for _, x in { -0.45, 0.45 } do
		part(m, { Name = "Eye", Size = Vector3.new(0.35, 0.35, 0.1) * s, CFrame = cf * CFrame.new(x * s, 0.2 * s, -1.05 * s), Color = rgb(255, 210, 80), Material = Enum.Material.Neon, CanCollide = false })
	end
	part(m, { Name = "Mouth", Size = Vector3.new(1, 0.22, 0.1) * s, CFrame = cf * CFrame.new(0, -0.3 * s, -1.05 * s), Color = rgb(255, 210, 80), Material = Enum.Material.Neon, CanCollide = false })
	local l = Instance.new("PointLight")
	l.Color = rgb(255, 160, 60)
	l.Range = 10
	l.Brightness = 1.5
	l.Parent = m:FindFirstChild("Body")
	m.Parent = parent
end

-- ---------------------------------------------------------------------------
-- стили

local STYLES = {
	summer = {
		ground = Enum.Material.Sand, groundColor = rgb(232, 214, 160), path = Enum.Material.Sandstone,
		wall = rgb(245, 236, 215), wallMat = Enum.Material.WoodPlanks, roof = rgb(205, 175, 95), roofMat = Enum.Material.Fabric,
		clock = 14, ambient = rgb(140, 130, 120), weather = "Clear",
	},
	spring = {
		ground = Enum.Material.Grass, groundColor = rgb(92, 160, 70), path = Enum.Material.Cobblestone,
		wall = rgb(240, 236, 228), wallMat = Enum.Material.Plaster, roof = rgb(175, 80, 60), roofMat = Enum.Material.ClayRoofTiles,
		clock = 13, ambient = rgb(120, 130, 120), weather = "Clear",
	},
	autumn = {
		ground = Enum.Material.Grass, groundColor = rgb(160, 120, 55), path = Enum.Material.Ground,
		wall = rgb(120, 85, 58), wallMat = Enum.Material.WoodPlanks, roof = rgb(75, 62, 60), roofMat = Enum.Material.RoofShingles,
		clock = 16.5, ambient = rgb(130, 110, 95), weather = "Clear",
	},
	winter = {
		ground = Enum.Material.Snow, groundColor = rgb(240, 244, 250), path = Enum.Material.Pavement,
		wall = rgb(150, 105, 72), wallMat = Enum.Material.WoodPlanks, roof = rgb(245, 248, 255), roofMat = Enum.Material.Snow,
		clock = 12, ambient = rgb(140, 145, 160), weather = "Snow",
	},
}
Village.STYLES = STYLES

-- ---------------------------------------------------------------------------
-- дом: стены, окна, двускатная крыша, дверь к центру, номер, кровать, фонарь

local function house(parent, cf: CFrame, index: number, st, theme: string, r)
	local m = Instance.new("Model")
	m.Name = "House" .. index
	local wall = st.wall
	if theme == "april" then
		wall = Color3.fromHSV((index * 0.137) % 1, 0.45, 1)
	end
	local W, D, H = 14, 12, 8
	local function at(x, y, z)
		return cf * CFrame.new(x, y, z)
	end
	part(m, { Name = "Floor", Size = Vector3.new(W, 0.6, D), CFrame = at(0, 0.3, 0), Color = rgb(120, 86, 60), Material = Enum.Material.WoodPlanks })
	part(m, { Name = "Wall", Size = Vector3.new(W, H, 0.6), CFrame = at(0, H / 2, D / 2), Color = wall, Material = st.wallMat })
	part(m, { Name = "Wall", Size = Vector3.new(0.6, H, D), CFrame = at(-W / 2, H / 2, 0), Color = wall, Material = st.wallMat })
	part(m, { Name = "Wall", Size = Vector3.new(0.6, H, D), CFrame = at(W / 2, H / 2, 0), Color = wall, Material = st.wallMat })
	-- передняя стена с проёмом под дверь
	part(m, { Name = "Wall", Size = Vector3.new(5.3, H, 0.6), CFrame = at(-4.35, H / 2, -D / 2), Color = wall, Material = st.wallMat })
	part(m, { Name = "Wall", Size = Vector3.new(5.3, H, 0.6), CFrame = at(4.35, H / 2, -D / 2), Color = wall, Material = st.wallMat })
	part(m, { Name = "Wall", Size = Vector3.new(3.4, 1.5, 0.6), CFrame = at(0, H - 0.75, -D / 2), Color = wall, Material = st.wallMat })
	-- угловые брусья
	for _, x in { -W / 2, W / 2 } do
		for _, z in { -D / 2, D / 2 } do
			part(m, { Name = "Beam", Size = Vector3.new(0.9, H, 0.9), CFrame = at(x, H / 2, z), Color = rgb(90, 64, 44), Material = Enum.Material.Wood })
		end
	end
	-- окна: рама и стекло, ночью светятся изнутри
	local function window(x, y, z, yaw)
		local wcf = at(x, y, z) * CFrame.Angles(0, yaw, 0)
		part(m, { Name = "Frame", Size = Vector3.new(2.6, 2.4, 0.25), CFrame = wcf, Color = rgb(70, 50, 35), Material = Enum.Material.Wood, CanCollide = false })
		local g = part(m, { Name = "Window", Size = Vector3.new(2.1, 1.9, 0.3), CFrame = wcf, Color = rgb(255, 214, 140), Material = Enum.Material.Glass, Transparency = 0.25, CanCollide = false })
		g:SetAttribute("NightGlow", true)
		part(m, { Name = "Mullion", Size = Vector3.new(0.12, 1.9, 0.34), CFrame = wcf, Color = rgb(70, 50, 35), CanCollide = false })
	end
	window(-4.35, 4.6, -D / 2 - 0.3, 0)
	window(4.35, 4.6, -D / 2 - 0.3, 0)
	window(-W / 2 - 0.3, 4.6, 0, math.pi / 2)
	window(W / 2 + 0.3, 4.6, 0, math.pi / 2)
	-- двускатная крыша из клиньев: конёк вдоль дома
	local RH = 4.6
	for _, s in { -1, 1 } do
		local roof = part(m, {
			Class = "WedgePart", Name = "Roof", Size = Vector3.new(W + 1.6, RH, D / 2 + 1),
			CFrame = at(0, H + RH / 2, s * (D / 4 + 0.5)) * CFrame.Angles(0, if s &gt; 0 then math.pi else 0, 0),
			Color = st.roof, Material = st.roofMat,
		})
		roof:SetAttribute("Roof", true)
	end
	local chimney = part(m, { Name = "Chimney", Size = Vector3.new(1.4, 4, 1.4), CFrame = at(W / 2 - 3, H + RH - 0.5, D / 4), Color = rgb(140, 70, 55), Material = Enum.Material.Brick })
	chimney:SetAttribute("Roof", true)
	-- дверь на петлях, открывается кнопкой
	local door = part(m, { Name = "Door", Size = Vector3.new(3.2, 6.4, 0.3), CFrame = at(0, 3.5, -D / 2), Color = rgb(110, 70, 45), Material = Enum.Material.Wood })
	part(m, { Name = "Handle", Shape = Enum.PartType.Ball, Size = Vector3.new(0.3, 0.3, 0.3), CFrame = at(1.1, 3.4, -D / 2 - 0.25), Color = rgb(200, 170, 80), Material = Enum.Material.Metal, CanCollide = false })
	-- номер дома (имена игроков скрыты)
	local plate = part(m, { Name = "Plate", Size = Vector3.new(1.6, 1, 0.15), CFrame = at(0, H - 0.75, -D / 2 - 0.4), Color = rgb(40, 40, 46), CanCollide = false })
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Front
	sg.PixelsPerStud = 60
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Text = tostring(index)
	t.TextScaled = true
	t.Font = Enum.Font.GothamBold
	t.TextColor3 = rgb(240, 225, 190)
	t.Parent = sg
	sg.Parent = plate
	-- фонарь у двери и свет в доме
	local lamp = part(m, { Name = "Lantern", Size = Vector3.new(0.6, 0.9, 0.6), CFrame = at(2.4, 5.6, -D / 2 - 0.5), Color = rgb(255, 210, 140), Material = Enum.Material.Neon, CanCollide = false })
	local ll = Instance.new("PointLight")
	ll.Range = 14
	ll.Brightness = 1.4
	ll.Color = rgb(255, 200, 130)
	ll.Parent = lamp
	local inside = part(m, { Name = "Inside", Size = Vector3.new(0.2, 0.2, 0.2), CFrame = at(0, H - 1, 0), Transparency = 1, CanCollide = false })
	local il = Instance.new("PointLight")
	il.Range = 16
	il.Brightness = 1.2
	il.Color = rgb(255, 210, 150)
	il.Parent = inside
	-- кровать и тумбочка
	part(m, { Name = "Bed", Size = Vector3.new(4, 1, 6.5), CFrame = at(-4, 1.1, 2), Color = rgb(90, 60, 40), Material = Enum.Material.Wood })
	part(m, { Name = "Mattress", Size = Vector3.new(3.7, 0.6, 6.2), CFrame = at(-4, 1.9, 2), Color = rgb(235, 235, 240), Material = Enum.Material.Fabric })
	part(m, { Name = "Blanket", Size = Vector3.new(3.8, 0.3, 4), CFrame = at(-4, 2.25, 1), Color = Color3.fromHSV((index * 0.21) % 1, 0.5, 0.8), Material = Enum.Material.Fabric })
	part(m, { Name = "Table", Size = Vector3.new(3, 0.3, 2), CFrame = at(4, 2.8, 3.5), Color = rgb(110, 80, 55), Material = Enum.Material.Wood })
	-- украшения тем
	if theme == "newyear" then
		for k = 0, 10 do
			local x = -W / 2 - 0.4 + k * (W + 0.8) / 10
			local bulb = part(m, { Name = "Garland", Shape = Enum.PartType.Ball, Size = Vector3.new(0.45, 0.45, 0.45), CFrame = at(x, H + 0.1, -D / 2 - 1.05), Color = ({ rgb(255, 60, 60), rgb(60, 220, 90), rgb(70, 140, 255), rgb(255, 210, 60) })[k % 4 + 1], Material = Enum.Material.Neon, CanCollide = false })
			bulb:SetAttribute("Roof", true)
		end
	elseif theme == "halloween" then
		pumpkin(m, at(-2.5, 1.2, -D / 2 - 1.6), 0.9)
	elseif theme == "april" then
		for k = 0, 2 do
			local b = part(m, { Name = "Balloon", Size = Vector3.new(1.4, 1.8, 1.4), CFrame = at(-2 + k * 2, H + 6 + k * 0.6, -D / 2 - 1.2), Color = Color3.fromHSV(r(0, 1), 0.8, 1), Material = Enum.Material.SmoothPlastic, Sphere = true, CanCollide = false })
			b:SetAttribute("Roof", true)
			part(m, { Name = "String", Size = Vector3.new(0.05, 5.5, 0.05), CFrame = at(-2 + k * 2, H + 2.5 + k * 0.3, -D / 2 - 1.2), Color = rgb(250, 250, 250), CanCollide = false })
		end
	end
	m.Parent = parent
	return {
		model = m,
		door = door,
		doorClosed = door.CFrame,
		hinge = at(-1.6, 3.5, -D / 2),
		inside = at(0, 3, -1) * CFrame.Angles(0, math.pi, 0),
		porch = at(0, 3, -D / 2 - 4),
	}
end

-- ---------------------------------------------------------------------------
-- рельеф

local function clear()
	terrain:FillBlock(CFrame.new(V + Vector3.new(0, 30, 0)), Vector3.new(620, 140, 620), Enum.Material.Air)
end

local function ground(st, style: string, theme: string)
	terrain:SetMaterialColor(Enum.Material.Grass, st.groundColor)
	terrain:SetMaterialColor(Enum.Material.Sand, rgb(232, 214, 160))
	if style == "summer" then
		-- море вокруг песчаного острова
		terrain:FillBlock(CFrame.new(V + Vector3.new(0, -9, 0)), Vector3.new(600, 16, 600), Enum.Material.Water)
		terrain:FillCylinder(CFrame.new(V + Vector3.new(0, -6, 0)), 12, 168, Enum.Material.Sand)
		terrain:FillCylinder(CFrame.new(V + Vector3.new(0, -4, 0)), 8, 150, Enum.Material.Sand)
	else
		terrain:FillCylinder(CFrame.new(V + Vector3.new(0, -5, 0)), 10, 290, st.ground)
		if style == "spring" then
			terrain:FillCylinder(CFrame.new(V + Vector3.new(0, -0.6, 0)), 1.2, 175, Enum.Material.LeafyGrass)
			terrain:FillCylinder(CFrame.new(V + Vector3.new(0, -0.5, 0)), 1.2, 120, Enum.Material.Grass)
			-- озеро за деревней
			local lake = V + Vector3.new(118, 0, -88)
			terrain:FillCylinder(CFrame.new(lake + Vector3.new(0, -0.4, 0)), 1.2, 34, Enum.Material.Sand)
			terrain:FillCylinder(CFrame.new(lake + Vector3.new(0, 0, 0)), 9, 30, Enum.Material.Air)
			terrain:FillCylinder(CFrame.new(lake + Vector3.new(0, -2.8, 0)), 3.6, 30, Enum.Material.Water)
		elseif style == "winter" then
			-- замёрзший пруд
			local pond = V + Vector3.new(-100, 0, 70)
			terrain:FillCylinder(CFrame.new(pond + Vector3.new(0, -0.3, 0)), 1, 22, Enum.Material.Ice)
		elseif style == "autumn" then
			terrain:FillCylinder(CFrame.new(V + Vector3.new(0, -0.5, 0)), 1.2, 260, Enum.Material.Ground)
			terrain:FillCylinder(CFrame.new(V + Vector3.new(0, -0.45, 0)), 1.2, 95, Enum.Material.Grass)
			terrain:SetMaterialColor(Enum.Material.Ground, rgb(120, 85, 50))
		end
	end
	-- дорожки от центра к домам
	for i = 0, Village.HOUSES - 1 do
		local a = i / Village.HOUSES * math.pi * 2
		local dir = Vector3.new(math.sin(a), 0, math.cos(a))
		local mid = V + dir * (Village.RING / 2 + 6)
		terrain:FillBlock(CFrame.lookAt(mid + Vector3.new(0, -0.35, 0), mid + dir + Vector3.new(0, -0.35, 0)), Vector3.new(4, 1, Village.RING - 20), st.path)
	end
	terrain:FillCylinder(CFrame.new(V + Vector3.new(0, -0.35, 0)), 1, 17, st.path)
	local _ = theme
end

-- невидимая стена по кругу, чтобы не уйти с карты
local function barrier(parent, radius: number, height: number)
	local n = 36
	for i = 0, n - 1 do
		local a = (i + 0.5) / n * math.pi * 2
		local p = V + Vector3.new(math.sin(a) * radius, height / 2, math.cos(a) * radius)
		local w = 2 * math.pi * radius / n + 2
		part(parent, { Name = "Barrier", Size = Vector3.new(w, height, 2), CFrame = CFrame.lookAt(p, Vector3.new(V.X, p.Y, V.Z)), Transparency = 1, CanQuery = false })
	end
end

-- ---------------------------------------------------------------------------
-- сборка

-- Возвращает описание мира для игры: дома, места у стола, лобби, небо для призраков
function Village.build(style: string, theme: string)
	local st = STYLES[style] or STYLES.spring
	local old = workspace:FindFirstChild("MafiaVillage")
	if old then
		old:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "MafiaVillage"
	folder.Parent = workspace
	local r = rnd(1234)
	clear()
	ground(st, style, theme)

	-- центр: круглый стол и 13 табуретов
	local center = Instance.new("Model")
	center.Name = "Center"
	part(center, { Name = "Table", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1, 14, 14), CFrame = CFrame.new(V + Vector3.new(0, 3, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color = rgb(115, 80, 52), Material = Enum.Material.WoodPlanks })
	part(center, { Name = "Leg", Shape = Enum.PartType.Cylinder, Size = Vector3.new(2.6, 2.4, 2.4), CFrame = CFrame.new(V + Vector3.new(0, 1.3, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color = rgb(90, 64, 44), Material = Enum.Material.Wood })
	local candle = part(center, { Name = "Candle", Size = Vector3.new(0.6, 1.2, 0.6), CFrame = CFrame.new(V + Vector3.new(0, 4.1, 0)), Color = rgb(255, 200, 120), Material = Enum.Material.Neon })
	local cl = Instance.new("PointLight")
	cl.Range = 22
	cl.Brightness = 2
	cl.Color = rgb(255, 190, 120)
	cl.Parent = candle
	local seats = {}
	for i = 0, Village.HOUSES - 1 do
		local a = i / Village.HOUSES * math.pi * 2
		local p = V + Vector3.new(math.sin(a) * 10, 0, math.cos(a) * 10)
		part(center, { Name = "Stool", Shape = Enum.PartType.Cylinder, Size = Vector3.new(2, 2.2, 2.2), CFrame = CFrame.new(p + Vector3.new(0, 1, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color = rgb(125, 90, 60), Material = Enum.Material.Wood })
		seats[i + 1] = CFrame.lookAt(p + Vector3.new(0, 4, 0) + (p - V).Unit * 1.6, Vector3.new(V.X, p.Y + 4, V.Z))
	end
	center.Parent = folder

	-- дома по кругу, дверью к центру
	local houses = {}
	for i = 0, Village.HOUSES - 1 do
		local a = i / Village.HOUSES * math.pi * 2
		local p = V + Vector3.new(math.sin(a) * Village.RING, 0, math.cos(a) * Village.RING)
		local cf = CFrame.lookAt(p, Vector3.new(V.X, 0, V.Z))
		houses[i + 1] = house(folder, cf, i + 1, st, theme, r)
	end

	-- деревья и украшения
	local deco = Instance.new("Folder")
	deco.Name = "Nature"
	deco.Parent = folder
	local function ringPos(radius: number, a: number)
		return V + Vector3.new(math.sin(a) * radius, 0, math.cos(a) * radius)
	end
	if style == "summer" then
		for i = 0, 33 do
			local a = i / 34 * math.pi * 2 + r(-0.05, 0.05)
			palm(deco, ringPos(r(96, 138), a), r(14, 20), r)
		end
		-- лодка у берега и зонтики
		for i = 0, 5 do
			local a = i / 6 * math.pi * 2 + 0.3
			local p = ringPos(118, a)
			part(deco, { Name = "Umbrella", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 7, 7), CFrame = CFrame.new(p + Vector3.new(0, 5, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color = ({ rgb(230, 70, 70), rgb(70, 150, 230), rgb(250, 210, 60) })[i % 3 + 1], Material = Enum.Material.Fabric })
			part(deco, { Name = "Pole", Size = Vector3.new(0.25, 5, 0.25), CFrame = CFrame.new(p + Vector3.new(0, 2.5, 0)), Color = rgb(240, 240, 240) })
			part(deco, { Name = "Towel", Size = Vector3.new(2.4, 0.1, 5), CFrame = CFrame.new(p + Vector3.new(2.5, 0.1, 0)) * CFrame.Angles(0, a, 0), Color = Color3.fromHSV(i / 6, 0.5, 0.95), Material = Enum.Material.Fabric, CanCollide = false })
		end
		barrier(folder, 175, 60)
	elseif style == "spring" then
		for i = 0, 23 do
			local a = i / 24 * math.pi * 2 + r(-0.1, 0.1)
			deciduous(deco, ringPos(r(90, 160), a), r(9, 13), rgb(70, 150, 60), r)
		end
		-- цветы
		for _ = 1, 140 do
			local a = r(0, math.pi * 2)
			local p = ringPos(r(22, 150), a)
			if (p - V).Magnitude &lt; 52 or (p - V).Magnitude &gt; 78 then
				part(deco, { Name = "Flower", Shape = Enum.PartType.Ball, Size = Vector3.new(0.6, 0.6, 0.6), CFrame = CFrame.new(p + Vector3.new(0, 0.5, 0)), Color = Color3.fromHSV(r(0, 1), 0.65, 1), CanCollide = false })
			end
		end
		if theme == "april" then
			local c = part(folder, { Name = "Confetti", Size = Vector3.new(60, 1, 60), CFrame = CFrame.new(V + Vector3.new(0, 40, 0)), Transparency = 1, CanCollide = false, CanQuery = false })
			local e = Instance.new("ParticleEmitter")
			e.Rate = 40
			e.Speed = NumberRange.new(4, 8)
			e.EmissionDirection = Enum.NormalId.Bottom
			e.Lifetime = NumberRange.new(6, 9)
			e.Size = NumberSequence.new(0.35)
			e.Rotation = NumberRange.new(0, 360)
			e.RotSpeed = NumberRange.new(-180, 180)
			e.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, rgb(255, 80, 80)), ColorSequenceKeypoint.new(0.33, rgb(80, 220, 120)), ColorSequenceKeypoint.new(0.66, rgb(80, 140, 255)), ColorSequenceKeypoint.new(1, rgb(255, 220, 60)) })
			e.Parent = c
			barrier(folder, 175, 60)
		end
	elseif style == "autumn" then
		-- густой лес, через который не пройти
		local leaves = { rgb(210, 110, 40), rgb(190, 60, 40), rgb(225, 170, 50), rgb(150, 90, 40) }
		local n = 0
		for ring = 0, 4 do
			local radius = 100 + ring * 14
			local count = 34 + ring * 6
			for i = 0, count - 1 do
				n += 1
				local a = (i + ring * 0.5) / count * math.pi * 2 + r(-0.03, 0.03)
				deciduous(deco, ringPos(radius + r(-3, 3), a), r(11, 16), leaves[n % 4 + 1], r)
			end
		end
		barrier(folder, 98, 60)
		if theme == "halloween" then
			for i = 0, 11 do
				local a = i / 12 * math.pi * 2 + 0.13
				pumpkin(deco, CFrame.lookAt(ringPos(30, a) + Vector3.new(0, 1, 0), V + Vector3.new(0, 1, 0)), 1.3)
			end
		end
	elseif style == "winter" then
		for i = 0, 29 do
			local a = i / 30 * math.pi * 2 + r(-0.08, 0.08)
			pine(deco, ringPos(r(92, 150), a), r(14, 22), true, r)
		end
		if theme == "newyear" then
			-- нарядная ёлка у центра
			local treePos = V + Vector3.new(0, 0, -24)
			local t = pine(deco, treePos, 26, true, r)
			for k = 0, 40 do
				local h = 5 + k * 0.45
				local w = (1 - (h - 4) / 22) * 8
				local a = k * 2.4
				local ball = part(t, { Name = "Ornament", Shape = Enum.PartType.Ball, Size = Vector3.new(0.7, 0.7, 0.7), CFrame = CFrame.new(treePos + Vector3.new(math.sin(a) * w, h, math.cos(a) * w)), Color = ({ rgb(255, 60, 60), rgb(255, 215, 60), rgb(70, 140, 255), rgb(240, 240, 255) })[k % 4 + 1], Material = Enum.Material.Neon, CanCollide = false })
				local _ = ball
			end
			local star = part(t, { Name = "Star", Shape = Enum.PartType.Ball, Size = Vector3.new(1.8, 1.8, 1.8), CFrame = CFrame.new(treePos + Vector3.new(0, 27.5, 0)), Color = rgb(255, 220, 80), Material = Enum.Material.Neon, CanCollide = false })
			local sl = Instance.new("PointLight")
			sl.Range = 30
			sl.Brightness = 2
			sl.Color = rgb(255, 220, 120)
			sl.Parent = star
			for k = 0, 5 do
				local a = k / 6 * math.pi * 2
				local g = treePos + Vector3.new(math.sin(a) * 5, 0.8, math.cos(a) * 5)
				part(deco, { Name = "Gift", Size = Vector3.new(1.6, 1.4, 1.6), CFrame = CFrame.new(g) * CFrame.Angles(0, a, 0), Color = Color3.fromHSV(k / 6, 0.7, 0.9) })
				part(deco, { Name = "Ribbon", Size = Vector3.new(1.7, 1.45, 0.3), CFrame = CFrame.new(g) * CFrame.Angles(0, a, 0), Color = rgb(250, 230, 120), CanCollide = false })
			end
		end
		barrier(folder, 160, 60)
	end

	-- статуи Натальи: в три раза больше обычного роста
	local statues = Instance.new("Folder")
	statues.Name = "Statues"
	statues.Parent = folder
	local domeMode = style == "spring" and theme == "plain"
	local lobbyCF
	local function pedestal(cf: CFrame)
		local stone = rgb(200, 198, 194)
		part(statues, { Name = "Step", Size = Vector3.new(16, 1.2, 16), CFrame = cf * CFrame.new(0, 0.6, 0), Color = stone, Material = Enum.Material.Marble })
		part(statues, { Name = "Step", Size = Vector3.new(12.5, 1.2, 12.5), CFrame = cf * CFrame.new(0, 1.8, 0), Color = stone, Material = Enum.Material.Marble })
		part(statues, { Name = "Plinth", Size = Vector3.new(9, 3, 9), CFrame = cf * CFrame.new(0, 3.9, 0), Color = stone, Material = Enum.Material.Marble })
		part(statues, { Name = "Cornice", Size = Vector3.new(10, 0.6, 10), CFrame = cf * CFrame.new(0, 5.7, 0), Color = stone, Material = Enum.Material.Marble })
		return cf * CFrame.new(0, 6, 0)
	end
	local beamAnchor
	if domeMode then
		-- четыре статуи по сторонам света, сферы светятся и лучами держат купол
		local apex = part(folder, { Name = "DomeApex", Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(V + Vector3.new(0, 95, 0)), Transparency = 1, CanCollide = false, CanQuery = false })
		beamAnchor = Instance.new("Attachment")
		beamAnchor.Parent = apex
		local dome = part(folder, { Name = "Dome", Shape = Enum.PartType.Ball, Size = Vector3.new(212, 212, 212), CFrame = CFrame.new(V), Color = rgb(150, 200, 255), Material = Enum.Material.ForceField, Transparency = 0.2, CanCollide = false, CanQuery = false, CastShadow = false })
		local _ = dome
		barrier(folder, 102, 110)
		local colors = { rgb(60, 130, 255), rgb(150, 70, 230), rgb(60, 220, 110), Color3.new(0, 0, 0) }
		for k = 0, 3 do
			local a = k * math.pi / 2
			local p = V + Vector3.new(math.sin(a) * 86, 0, math.cos(a) * 86)
			local face = CFrame.lookAt(p, p + (p - V))
			local top = pedestal(face)
			local color = colors[k + 1]
			task.spawn(function()
				local model = Statue.spawn(Village.STATUE_USER, "admire", true, top, statues, { scale = 3, orbColor = color })
				local orb = model and model:FindFirstChild("Orb")
				if orb and beamAnchor then
					local a0 = Instance.new("Attachment")
					a0.Parent = orb
					local beam = Instance.new("Beam")
					beam.Attachment0 = a0
					beam.Attachment1 = beamAnchor
					beam.Color = ColorSequence.new(if color == Color3.new(0, 0, 0) then rgb(90, 40, 140) else color)
					beam.LightEmission = 1
					beam.Width0 = 2
					beam.Width1 = 0.6
					beam.FaceCamera = true
					beam.Transparency = NumberSequence.new(0.15)
					beam.Parent = orb
				end
			end)
			if k == 0 then
				lobbyCF = face * CFrame.new(0, 0, -30)
			end
		end
	else
		-- одна статуя у центра, не мешая столу
		local p = V + Vector3.new(0, 0, if style == "winter" and theme == "newyear" then 30 else -30)
		local face = CFrame.lookAt(p, Vector3.new(V.X, 0, V.Z))
		local top = pedestal(face)
		task.spawn(function()
			Statue.spawn(Village.STATUE_USER, "admire", true, top, statues, { scale = 3 })
		end)
		lobbyCF = CFrame.lookAt(V + Vector3.new(0, 0, (p - V).Z * -0.1), p)
	end

	-- лобби: стеклянная комната перед статуей, где все ждут начала
	local lobby = Instance.new("Model")
	lobby.Name = "Lobby"
	local function lobbyPart(props)
		props.Parent = nil
		local pp = part(lobby, props)
		pp:SetAttribute("Lobby", true)
		return pp
	end
	lobbyPart({ Name = "Floor", Size = Vector3.new(34, 0.6, 26), CFrame = lobbyCF * CFrame.new(0, 0.3, 0), Color = rgb(225, 225, 230), Material = Enum.Material.Marble })
	for _, s in { { 0, 13, 34, 0.6 }, { 0, -13, 34, 0.6 }, { 17, 0, 0.6, 26 }, { -17, 0, 0.6, 26 } } do
		lobbyPart({ Name = "Glass", Size = Vector3.new(s[3], 12, s[4]), CFrame = lobbyCF * CFrame.new(s[1], 6, s[2]), Color = rgb(200, 230, 255), Material = Enum.Material.Glass, Transparency = 0.6 })
	end
	lobbyPart({ Name = "Roof", Size = Vector3.new(34, 0.6, 26), CFrame = lobbyCF * CFrame.new(0, 12.3, 0), Color = rgb(200, 230, 255), Material = Enum.Material.Glass, Transparency = 0.7 })
	lobby.Parent = folder

	-- освещение сезона
	Lighting.ClockTime = st.clock
	Lighting.Ambient = st.ambient
	Lighting.FogEnd = if style == "autumn" then 420 else 2000
	Lighting.FogColor = if theme == "halloween" then rgb(60, 40, 80) else rgb(190, 200, 210)
	if theme == "halloween" then
		Lighting.Ambient = rgb(90, 70, 110)
	end

	return {
		folder = folder,
		houses = houses,
		seats = seats,
		lobby = lobbyCF * CFrame.new(0, 3, 0),
		lobbyModel = lobby,
		sky = CFrame.new(V + Vector3.new(0, 150, 0)),
		center = V,
		weather = st.weather,
		style = style,
		theme = theme,
	}
end

-- дверь дома: открыть или закрыть
function Village.setDoor(h, open: boolean)
	local hinge = h.hinge
	local rel = hinge:ToObjectSpace(h.doorClosed)
	h.door.CFrame = if open then hinge * CFrame.Angles(0, math.rad(-100), 0) * rel else h.doorClosed
	h.door.CanCollide = not open
end

return Village
</ProtectedString>
          </Properties>
        </Item>
      </Item>
      <Item class="Script" referent="RBX0000003E">
        <Properties>
          <string name="Name">Main</string>
          <ProtectedString name="Source">--!nonstrict
-- Точка входа сервера «The Castle»: замок (RP) и отдельный режим «Мафия»

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")

local Shared = game:GetService("ReplicatedStorage").Workshop.Shared
local Remotes = require(Shared.Roblox.Remotes)

local Adapter = require(script.Parent.DataStoreAdapter)
local ProjectStore = require(script.Parent.Core.ProjectStore)
local Access = require(script.Parent.Access)
local CurrencyService = require(script.Parent.CurrencyService)
local MafiaGame = require(script.Parent.Mafia.MafiaGame)
local CastleGame = require(script.Parent.Castle.CastleGame)
local Admin = require(script.Parent.Castle.Admin)

-- сеть создаётся до всего остального, чтобы клиенты могли подключиться сразу
Remotes.event("Castle")

local adapter = Adapter.create()
local store = ProjectStore.new(adapter, { jobId = if game.JobId ~= "" then game.JobId else HttpService:GenerateGUID(false) })

CurrencyService.init(store)
CastleGame.init(store)
Admin.init()
-- переход между замком и мафией: игрок в один момент только в одном режиме,
-- чат и сообщения на экране у режимов раздельные
MafiaGame.init({
	beforeJoin = function(p)
		CastleGame.leave(p)
		CastleGame.addToGeneral(p, false)
	end,
	afterLeave = function(p)
		CastleGame.addToGeneral(p, true)
	end,
})

Players.PlayerRemoving:Connect(function(p)
	Access.forget(p)
end)

-- старые запросы мастерской больше не поддерживаются
Remotes.fn("Request").OnServerInvoke = function()
	return { ok = false, error = "unknown" }
end
</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0000003F">
        <Properties>
          <string name="Name">Statue</string>
          <ProtectedString name="Source">--!nonstrict
-- Каменная статуя из аватара Roblox: настоящая внешность игрока, всё в камне,
-- поза «восхищения»: правая рука поднята вверх, левая ниже и отведена назад,
-- голова запрокинута, ноги в шаге. Углы позы можно подправить в POSE

local Players = game:GetService("Players")

local Statue = {}

local STONE = Color3.fromRGB(196, 194, 190)

-- углы в градусах для суставов R15 (X — вперёд/назад, Z — в сторону)
Statue.POSE = {
	admire = {
		RightShoulder = { 165, 0, -12 },
		LeftShoulder = { -35, 0, 25 },
		RightElbow = { 15, 0, 0 },
		LeftElbow = { 25, 0, 0 },
		Neck = { 28, 0, 0 },
		Waist = { 8, 0, 0 },
		RightHip = { 18, 0, 0 },
		LeftHip = { -16, 0, 0 },
		RightKnee = { -10, 0, 0 },
		LeftKnee = { -22, 0, 0 },
	},
	stand = {},
}
-- для старых аватаров R6
Statue.POSE_R6 = {
	admire = {
		["Right Shoulder"] = { 0, 0, 165 },
		["Left Shoulder"] = { 0, 0, -35 },
		["Neck"] = { -25, 0, 0 },
		["Right Hip"] = { 0, 0, 15 },
		["Left Hip"] = { 0, 0, 15 },
	},
	stand = {},
}

local nameCache: { [string]: number } = {}

local function userIdOf(username: any): number?
	if type(username) == "number" then
		return username
	end
	if nameCache[username] then
		return nameCache[username]
	end
	local ok, id = pcall(function()
		return Players:GetUserIdFromNameAsync(username)
	end)
	if ok and type(id) == "number" then
		nameCache[username] = id
		return id
	end
	return nil
end

local function petrify(model: Model)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Material = Enum.Material.Marble
			d.Color = STONE
			d.CastShadow = true
			if d:IsA("MeshPart") then
				pcall(function()
					(d :: any).TextureID = ""
				end)
			end
		elseif d:IsA("SpecialMesh") then
			d.TextureId = ""
			d.VertexColor = Vector3.new(0.77, 0.76, 0.75)
		elseif d:IsA("Shirt") or d:IsA("Pants") or d:IsA("ShirtGraphic") or d:IsA("Decal") or d:IsA("Texture") then
			d:Destroy()
		elseif d:IsA("SurfaceAppearance") or d:IsA("Script") or d:IsA("LocalScript") or d:IsA("Sound") then
			d:Destroy()
		elseif d:IsA("BodyColors") then
			for _, prop in { "HeadColor3", "TorsoColor3", "LeftArmColor3", "RightArmColor3", "LeftLegColor3", "RightLegColor3" } do
				(d :: any)[prop] = STONE
			end
		end
	end
end

-- Строит статую и ставит её так, чтобы ступни стояли в точке feetCF
-- opts: { scale = 1, orbColor = Color3? } — orbColor делает сферу светящейся
function Statue.spawn(username: string, pose: string, orb: boolean, feetCF: CFrame, parent: Instance, opts): Model?
	opts = opts or {}
	local userId = userIdOf(username)
	if not userId then
		return nil
	end
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromUserId(userId)
	end)
	if not ok or not model then
		return nil
	end
	model.Name = "Statue_" .. username
	local hum = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not hum or not root then
		model:Destroy()
		return nil
	end
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	hum.BreakJointsOnDeath = false
	local animator = hum:FindFirstChildOfClass("Animator")
	if animator then
		animator:Destroy()
	end
	petrify(model)
	-- поза: поворачиваем C0 суставов, пока детали держатся только на суставах
	local r15 = hum.RigType == Enum.HumanoidRigType.R15
	local angles = (if r15 then Statue.POSE else Statue.POSE_R6)[pose] or {}
	for _, j in model:GetDescendants() do
		if j:IsA("Motor6D") and angles[j.Name] then
			local a = angles[j.Name]
			j.C0 = j.C0 * CFrame.Angles(math.rad(a[1]), math.rad(a[2]), math.rad(a[3]))
		end
	end
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = d == root
			d.CanCollide = false
		end
	end
	model.Parent = parent
	model:PivotTo(feetCF * CFrame.new(0, 3, 0))
	local scale = opts.scale or 1
	if scale ~= 1 then
		pcall(function()
			model:ScaleTo(scale)
		end)
	end
	-- то, на что смотрит статуя: сфера в поднятой руке
	local ball: BasePart? = nil
	if orb then
		local hand = model:FindFirstChild(if r15 then "RightHand" else "Right Arm") :: BasePart?
		if hand then
			local b = Instance.new("Part")
			b.Name = "Orb"
			b.Shape = Enum.PartType.Ball
			local d = 1.3 * scale
			b.Size = Vector3.new(d, d, d)
			b.CanCollide = false
			b.Massless = true
			if opts.orbColor then
				b.Material = Enum.Material.Neon
				b.Color = opts.orbColor
				local light = Instance.new("PointLight")
				light.Color = if opts.orbColor == Color3.new(0, 0, 0) then Color3.fromRGB(120, 60, 180) else opts.orbColor
				light.Range = 30
				light.Brightness = 3
				light.Parent = b
			else
				b.Material = Enum.Material.Marble
				b.Color = STONE
			end
			b.CFrame = hand.CFrame * CFrame.new(0, -hand.Size.Y / 2 - d * 0.4, 0)
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = hand
			weld.Part1 = b
			weld.Parent = b
			b.Parent = model
			ball = b
		end
	end
	-- суставы расставили детали: закрепляем всё и ставим ступни ровно на постамент
	task.wait(0.3)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = true
		end
	end
	local cf, size = model:GetBoundingBox()
	local bottom = cf.Position.Y - size.Y / 2
	model:PivotTo(model:GetPivot() + Vector3.new(0, feetCF.Position.Y - bottom, 0))
	if ball then
		model:SetAttribute("HasOrb", true)
	end
	return model
end

return Statue
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBX00000040">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CharacterWalkSpeed">16</float>
      <float name="CameraMaxZoomDistance">40</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBX00000041">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="RBX00000042">
        <Properties>
          <string name="Name">Workshop</string>
        </Properties>
        <Item class="Folder" referent="RBX00000043">
          <Properties>
            <string name="Name">Castle</string>
          </Properties>
          <Item class="ModuleScript" referent="RBX00000044">
            <Properties>
              <string name="Name">AdminPanel</string>
              <ProtectedString name="Source">--!nonstrict
-- Маленькая кнопка «Админ» и панель команд. Видна только создателям; каждую команду
-- сервер всё равно проверяет сам

local Players = game:GetService("Players")
local GuiService = game:GetService("GuiService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Workshop"):WaitForChild("Shared")
local Commands = require(Shared.AdminCommands)
local Remotes = require(Shared.Roblox.Remotes)
local Util = require(Shared.Util)

local Ui = require(script.Parent.Ui)

local AdminPanel = {}

local function request(...)
	local ok, res = pcall(function(...)
		return Remotes.fn("AdminRequest"):InvokeServer(...)
	end, ...)
	return if ok then res else nil
end

function AdminPanel.mount(app)
	local res = request("Status")
	if not res or not res.admin then
		return
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = "CastleAdmin"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 30
	gui.Parent = app.playerGui
	local inset = GuiService.TopbarInset
	-- небольшая, но удобная для пальца кнопка рядом с верхней панелью Roblox
	local btn = Ui.button(gui, "", nil, {
		Size = UDim2.fromOffset(64, 30),
		-- справа вверху: слева кнопки Roblox, там кнопка пряталась под ними
		Position = UDim2.new(1, -76, 0, math.max(6, inset.Min.Y + (inset.Height - 30) / 2)),
		TextSize = 13,
		Font = Ui.FONT_BOLD,
		TextColor3 = Ui.C.gold,
		BackgroundTransparency = 0.2,
	})
	local function label()
		btn.Text = app.T("Admin")
	end
	label()
	app.onLangChanged = app.onLangChanged or {}
	table.insert(app.onLangChanged, label)

	local function run(cmd, targetId, arg)
		local r = request("Run", cmd.id, targetId, arg)
		Ui.toast(gui, if r and r.ok then app.T("Done") else app.T("Failed"), if r and r.ok then Ui.C.good else Ui.C.red, 2)
	end

	local function title(cmd)
		return if app.lang == "ru" then cmd.ru else cmd.en
	end

	local function argTitle(cmd, v)
		if cmd.id == "season" then
			return app.T("season_" .. v)
		elseif cmd.id == "weather" then
			return app.T("weather_" .. v)
		elseif cmd.id == "set_role" then
			return app.T("role_" .. v)
		elseif cmd.id == "give_item" then
			return app.T("item_" .. v)
		end
		return v
	end

	local function withArg(cmd, targetId)
		if cmd.arg == nil then
			run(cmd, targetId, nil)
		elseif type(cmd.arg) == "table" then
			local opts = {}
			for _, v in cmd.arg do
				table.insert(opts, { id = v, title = argTitle(cmd, v) })
			end
			Ui.choose(gui, title(cmd), opts, function(v)
				run(cmd, targetId, v)
			end)
		else
			Ui.prompt(gui, title(cmd) .. "\n" .. app.T("Value"), app.T("Run"), function(text)
				run(cmd, targetId, if cmd.arg == "number" then tonumber(text) else text)
			end)
		end
	end

	local function start(cmd)
		if cmd.target == "player" then
			local opts = {}
			for _, p in Players:GetPlayers() do
				table.insert(opts, { id = p.UserId, title = p.DisplayName .. "  @" .. p.Name })
			end
			Ui.choose(gui, app.T("ChoosePlayer"), opts, function(id)
				withArg(cmd, id)
			end)
		else
			withArg(cmd, nil)
		end
	end

	btn.Activated:Connect(function()
		if app.castle then
			app.castle.camera:setFreeCursor(true)
		end
		local _, content = Ui.sheet(gui, app.T("AdminTitle"), function()
			if app.castle then
				app.castle.camera:setFreeCursor(false)
			end
		end, 460)
		local search = Instance.new("TextBox")
		search.PlaceholderText = app.T("Search")
		search.Text = ""
		search.ClearTextOnFocus = false
		search.Font = Ui.FONT
		search.TextSize = 16
		search.TextColor3 = Ui.C.text
		search.PlaceholderColor3 = Ui.C.dim
		search.BackgroundColor3 = Ui.C.panel
		search.Size = UDim2.new(1, 0, 0, Ui.TAP)
		search.LayoutOrder = 0
		search.ZIndex = 43
		Ui.corner(search, 6)
		Ui.stroke(search)
		search.Parent = content
		-- разделы: мир, игроки, порядок, веселье, силы Бога
		local tabs = Ui.frame(content, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, Ui.TAP), LayoutOrder = 1, ZIndex = 43 })
		local tl = Ui.list(tabs, 4, true)
		tl.HorizontalAlignment = Enum.HorizontalAlignment.Center
		local current = "world"
		local tabButtons = {}
		local buttons = {}
		local function filter()
			local q = Util.lower(search.Text)
			for cmd, b in buttons do
				local match = q ~= "" and (string.find(string.lower(cmd.en), q, 1, true) ~= nil or string.find(Util.lower(cmd.ru), q, 1, true) ~= nil or string.find(cmd.id, q, 1, true) ~= nil)
				b.Visible = if q ~= "" then match else cmd.cat == current
			end
			for cat, tb in tabButtons do
				Ui.setActive(tb, cat == current and q == "")
			end
		end
		local n = #Commands.CATEGORIES
		for i, cat in Commands.CATEGORIES do
			local tb = Ui.button(tabs, app.T("cat_" .. cat), function()
				current = cat
				search.Text = ""
				filter()
			end, { Size = UDim2.new(1 / n, -4, 1, 0), LayoutOrder = i, TextSize = 13, ZIndex = 44, TextColor3 = if cat == "god" then Ui.C.gold else Ui.C.text })
			tabButtons[cat] = tb
		end
		for i, cmd in Commands.LIST do
			local b = Ui.button(content, title(cmd), function()
				start(cmd)
			end, { LayoutOrder = 10 + i, ZIndex = 43, TextXAlignment = Enum.TextXAlignment.Left })
			Ui.pad(b, 10)
			if cmd.cat == "god" then
				b.TextColor3 = Ui.C.gold
				b.BackgroundColor3 = Color3.fromRGB(60, 46, 26)
			end
			buttons[cmd] = b
		end
		search:GetPropertyChangedSignal("Text"):Connect(filter)
		filter()
	end)
end

return AdminPanel
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00000045">
            <Properties>
              <string name="Name">CastleClient</string>
              <ProtectedString name="Source">--!nonstrict
-- Игра в замке на клиенте: камера от первого лица, шкалы здоровья, еды и воды,
-- инвентарь, роли, панель короля, казино, магазин, шаги по материалу, погода и эффекты

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local StarterGui = game:GetService("StarterGui")
local TextChatService = game:GetService("TextChatService")
local Lighting = game:GetService("Lighting")
local Debris = game:GetService("Debris")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Workshop"):WaitForChild("Shared")
local Rules = require(Shared.CastleRules)
local Remotes = require(Shared.Roblox.Remotes)
local Sounds = require(Shared.CastleSounds)

local Ui = require(script.Parent.Ui)
local Menu = require(script.Parent.Menu)
local CameraController = require(script.Parent.Parent.Common.CameraController)
local WeatherFx = require(script.Parent.Parent.Common.WeatherFx)

local player = Players.LocalPlayer

local Client = {}
Client.__index = Client

local function request(...)
	local ok, res = pcall(function(...)
		return Remotes.fn("CastleRequest"):InvokeServer(...)
	end, ...)
	return if ok then res else nil
end

local ITEM_COLOR = {
	bread = Color3.fromRGB(196, 140, 70), apple = Color3.fromRGB(190, 40, 40), meat = Color3.fromRGB(140, 70, 40),
	soup = Color3.fromRGB(150, 100, 60), cake = Color3.fromRGB(250, 200, 220), water = Color3.fromRGB(80, 140, 200),
	juice = Color3.fromRGB(240, 150, 40), spoon = Color3.fromRGB(200, 200, 210), broom = Color3.fromRGB(150, 110, 60),
	book = Color3.fromRGB(110, 40, 40), scepter = Color3.fromRGB(214, 172, 80), sword = Color3.fromRGB(190, 192, 200),
	cuffs = Color3.fromRGB(90, 86, 82),
}
local SYMBOL = { crown = "👑", sword = "⚔️", apple = "🍎", bell = "🔔", skull = "💀" }

-- материал под ногами -&gt; скорость и громкость шагов
local STEP = {
	[Enum.Material.Carpet] = { 0.7, 0.22 },
	[Enum.Material.Fabric] = { 0.72, 0.25 },
	[Enum.Material.Wood] = { 0.95, 0.5 },
	[Enum.Material.WoodPlanks] = { 0.95, 0.5 },
	[Enum.Material.Grass] = { 0.85, 0.32 },
	[Enum.Material.LeafyGrass] = { 0.85, 0.32 },
	[Enum.Material.Mud] = { 0.8, 0.35 },
	[Enum.Material.Snow] = { 0.7, 0.4 },
	[Enum.Material.Sand] = { 0.8, 0.3 },
	[Enum.Material.Metal] = { 1.3, 0.55 },
	[Enum.Material.DiamondPlate] = { 1.3, 0.55 },
}
local STONE_STEP = { 1.15, 0.6 }

function Client.new(app)
	local self = setmetatable({}, Client)
	self.app = app
	self.conns = {}
	local gui = Instance.new("ScreenGui")
	gui.Name = "CastleHud"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 10
	gui.Parent = app.playerGui
	self.gui = gui
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
	end)
	self.camera = CameraController.new({ camera = { mode = "first", sensitivity = app.settings.sensitivity, fov = app.settings.fov, bob = app.settings.bob } })
	self.weather = WeatherFx.new()
	self:buildHud()
	self:localizePrompts()
	self:buildSounds()
	self:watch()
	self:applySettings()
	return self
end

function Client:T(key, ...)
	return self.app.T(key, ...)
end

function Client:toast(text: string, color: Color3?)
	Ui.toast(self.gui, text, color)
end

-- окно открыто: на компьютере освобождаем курсор
function Client:sheet(title, onClose, width)
	self.camera:setFreeCursor(true)
	return Ui.sheet(self.gui, title, function()
		self.camera:setFreeCursor(false)
		if onClose then
			onClose()
		end
	end, width)
end

-- ---------------------------------------------------------------------------
-- HUD

local function bar(parent, order, color)
	local f = Ui.frame(parent, { Size = UDim2.new(1, 0, 0, 16), BackgroundColor3 = Ui.C.bg, BackgroundTransparency = 0.25, LayoutOrder = order })
	Ui.corner(f, 4)
	Ui.stroke(f, Ui.C.line, 1)
	local fill = Ui.frame(f, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = color })
	Ui.corner(fill, 4)
	local l = Ui.label(f, "", { Size = UDim2.new(1, -8, 1, 0), Position = UDim2.fromOffset(6, 0), TextSize = 12, Font = Ui.FONT_BOLD, ZIndex = 2 })
	return fill, l
end

function Client:buildHud()
	local gui = self.gui
	local inset = game:GetService("GuiService").TopbarInset
	local top = math.max(inset.Height, 36) + 8
	local box = Ui.frame(gui, { BackgroundTransparency = 1, Size = UDim2.fromOffset(170, 120), Position = UDim2.fromOffset(12, top) })
	Ui.list(box, 4)
	self.hpFill, self.hpLabel = bar(box, 1, Ui.C.health)
	self.foodFill, self.foodLabel = bar(box, 2, Ui.C.food)
	self.drinkFill, self.drinkLabel = bar(box, 3, Ui.C.drink)
	self.roleLabel = Ui.label(box, "", { TextSize = 14, Font = Ui.FONT_BOLD, TextColor3 = Ui.C.gold, LayoutOrder = 4, Size = UDim2.new(1, 0, 0, 18) })
	self.goldLabel = Ui.label(box, "", { TextSize = 14, TextColor3 = Ui.C.text, LayoutOrder = 5, Size = UDim2.new(1, 0, 0, 18) })
	self.jailLabel = Ui.label(box, "", { TextSize = 14, Font = Ui.FONT_BOLD, TextColor3 = Ui.C.red, LayoutOrder = 6, Size = UDim2.new(1, 0, 0, 18), Visible = false })
	-- кнопки справа: компактные, чтобы не закрывать обзор
	local right = Ui.frame(gui, { BackgroundTransparency = 1, Size = UDim2.fromOffset(110, 200), Position = UDim2.new(1, -122, 0, top) })
	Ui.list(right, 6)
	local function small(text, order, fn)
		return Ui.button(right, text, fn, { Size = UDim2.new(1, 0, 0, 34), TextSize = 14, LayoutOrder = order, BackgroundTransparency = 0.2 })
	end
	self.menuBtn = small(self:T("Menu"), 1, function()
		self:openMenu()
	end)
	self.rolesBtn = small(self:T("Roles"), 2, function()
		self:openRoles()
	end)
	self.kingBtn = small(self:T("KingPanel"), 3, function()
		self:openKing()
	end)
	self.kingBtn.TextColor3 = Ui.C.gold
	self.kingBtn.Visible = false
	-- инвентарь внизу по центру, над джойстиком не заходит
	self.inv = Ui.frame(gui, { BackgroundTransparency = 1, Size = UDim2.fromOffset(5 * 64, 70), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -12) })
	local l = Ui.list(self.inv, 6, true)
	l.HorizontalAlignment = Enum.HorizontalAlignment.Center
	-- точка прицела в центре, как в DOORS
	local dot = Ui.frame(gui, { Size = UDim2.fromOffset(4, 4), Position = UDim2.new(0.5, -2, 0.5, -2), BackgroundColor3 = Ui.C.text, BackgroundTransparency = 0.4 })
	Ui.corner(dot, 2)
	-- объявления для всего замка
	self.banner = Ui.label(gui, "", { Font = Ui.TITLE, TextSize = 34, TextColor3 = Ui.C.gold, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, -40, 0, 90), Position = UDim2.new(0, 20, 0.2, 0), Visible = false, TextStrokeTransparency = 0.4 })
	self:refresh()
end

-- подписи у объектов замка на языке игрока (сервер оставляет их пустыми)
function Client:localizePrompts()
	local castle = workspace:FindFirstChild("TheCastle")
	if not castle then
		return
	end
	local function one(d)
		if d:IsA("ProximityPrompt") then
			local kind = d:GetAttribute("Kind")
			if kind then
				d.ActionText = self:T("p_" .. kind)
			end
		end
	end
	for _, d in castle:GetDescendants() do
		one(d)
	end
	if not self.promptConn then
		-- мир подгружается частями по мере движения игрока
		self.promptConn = castle.DescendantAdded:Connect(one)
		table.insert(self.conns, self.promptConn)
	end
end

function Client:refresh()
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	local hp = if hum then math.clamp(hum.Health / math.max(1, hum.MaxHealth), 0, 1) else 0
	self.hpFill.Size = UDim2.fromScale(hp, 1)
	self.hpLabel.Text = string.format("%s  %d", self:T("Health"), math.floor(hp * 100 + 0.5))
	local food = player:GetAttribute("Food") or 100
	local drink = player:GetAttribute("Drink") or 100
	self.foodFill.Size = UDim2.fromScale(food / 100, 1)
	self.foodLabel.Text = string.format("%s  %d", self:T("Food"), food)
	self.drinkFill.Size = UDim2.fromScale(drink / 100, 1)
	self.drinkLabel.Text = string.format("%s  %d", self:T("Drink"), drink)
	local role = player:GetAttribute("CastleRole") or "peasant"
	self.roleLabel.Text = self:T("role_" .. role)
	local stats = player:FindFirstChild("leaderstats")
	local gold = stats and stats:FindFirstChild("Gold")
	self.goldLabel.Text = string.format("%s  %d", self:T("Gold"), if gold then gold.Value else 0)
	self.kingBtn.Visible = role == "king"
	local until_ = player:GetAttribute("JailUntil")
	if until_ then
		self.jailLabel.Visible = true
		self.jailLabel.Text = self:T("JailFormat", math.max(0, until_ - os.time()))
	else
		self.jailLabel.Visible = false
	end
end

function Client:refreshInventory()
	for _, c in self.inv:GetChildren() do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
	local inv = string.split(player:GetAttribute("Inv") or "", ",")
	local slots = player:GetAttribute("Slots") or 3
	local equipped = player.Character and player.Character:FindFirstChildOfClass("Tool")
	local eqSlot = equipped and equipped:GetAttribute("Slot")
	for i = 1, slots do
		local item = inv[i]
		if item == "" then
			item = nil
		end
		local b = Ui.button(self.inv, if item then self:T("item_" .. item) else "", function()
			if item then
				request("Use", i)
			end
		end, { Size = UDim2.fromOffset(58, 58), TextSize = 11, LayoutOrder = i, BackgroundTransparency = 0.15, TextYAlignment = Enum.TextYAlignment.Bottom })
		if item then
			local icon = Ui.frame(b, { Size = UDim2.fromOffset(22, 22), Position = UDim2.new(0.5, -11, 0, 7), BackgroundColor3 = ITEM_COLOR[item] or Ui.C.dim })
			Ui.corner(icon, 11)
			-- маленькая кнопка «выбросить» в углу
			Ui.button(b, "x", function()
				request("Drop", i)
			end, { Size = UDim2.fromOffset(18, 18), Position = UDim2.new(1, -19, 0, 1), TextSize = 11, BackgroundColor3 = Ui.C.red, ZIndex = 3 })
		end
		if eqSlot == i then
			Ui.stroke(b, Ui.C.gold, 2)
		end
	end
end

-- ---------------------------------------------------------------------------
-- окна

function Client:openMenu()
	local _, c, close = self:sheet(self:T("Menu"), nil, 360)
	Ui.button(c, self:T("Settings"), function()
		close()
		self.camera:setFreeCursor(true)
		Menu.settingsSheet(self.app, self.gui)
	end, { LayoutOrder = 1, ZIndex = 43 })
	Ui.button(c, self:T("HowToPlay"), function()
		close()
		self.camera:setFreeCursor(true)
		Menu.tutorialSheet(self.app, self.gui)
	end, { LayoutOrder = 2, ZIndex = 43 })
	Ui.button(c, self:T("Casino"), function()
		close()
		self:openSlots()
	end, { LayoutOrder = 3, ZIndex = 43 })
	Ui.button(c, self:T("MainMenu"), function()
		close()
		self.app:backToMenu()
	end, { LayoutOrder = 4, ZIndex = 43, BackgroundColor3 = Ui.C.red })
end

function Client:openRoles()
	local _, c, close = self:sheet(self:T("Roles"))
	local mine = player:GetAttribute("CastleRole")
	for i, role in Rules.ROLE_ORDER do
		local max = Rules.ROLES[role].max
		local n = workspace:GetAttribute("CastleCount_" .. role) or 0
		local text = if max &gt;= 99 then self:T("role_" .. role) else string.format("%s   %d / %d", self:T("role_" .. role), n, max)
		local b = Ui.button(c, text, function()
			if Rules.APPOINTED[role] then
				self:toast(self:T(if role == "king" then "p_throne" else "Appointed"))
				return
			end
			local res = request("TakeRole", role)
			if res and res.ok then
				close()
			elseif res and res.error == "jailed" then
				self:toast(self:T("JailedNo"), Ui.C.red)
			else
				self:toast(self:T("RoleTaken"), Ui.C.red)
			end
		end, { LayoutOrder = i, ZIndex = 43 })
		if role == mine then
			Ui.setActive(b, true)
		end
		if Rules.APPOINTED[role] then
			b.TextColor3 = Ui.C.dim
		end
	end
end

function Client:openShop()
	local f, c, close = self:sheet(self:T("Shop"))
	local _ = f
	local owned = {}
	for _, id in string.split(player:GetAttribute("Owned") or "", ",") do
		owned[id] = true
	end
	local worn = {}
	for _, id in string.split(player:GetAttribute("Worn") or "", ",") do
		worn[id] = true
	end
	for i, s in Rules.SHOP do
		local row = Ui.frame(c, { BackgroundColor3 = Ui.C.panel, Size = UDim2.new(1, 0, 0, Ui.TAP + 8), LayoutOrder = i, ZIndex = 43 })
		Ui.corner(row, 6)
		Ui.label(row, self:T("shop_" .. s.id), { Size = UDim2.new(0.5, 0, 0, 22), Position = UDim2.fromOffset(10, 4), ZIndex = 44 })
		Ui.label(row, if owned[s.id] then self:T("Owned") else self:T("PriceFormat", s.price), { Size = UDim2.new(0.5, 0, 0, 18), Position = UDim2.fromOffset(10, 26), TextSize = 13, TextColor3 = Ui.C.gold, ZIndex = 44 })
		local text = if not owned[s.id] then self:T("Buy") elseif worn[s.id] then self:T("TakeOff") else self:T("Wear")
		Ui.button(row, text, function()
			local res
			if not owned[s.id] then
				res = request("Buy", s.id)
				if res and res.ok then
					self:toast(self:T("Bought"), Ui.C.good)
				elseif res and res.error == "gold" then
					self:toast(self:T("NotEnoughGold"), Ui.C.red)
				end
			else
				res = request("Wear", s.id, not worn[s.id])
			end
			close()
			task.wait(0.2)
			self:openShop()
		end, { Size = UDim2.new(0.42, 0, 1, -12), Position = UDim2.new(0.56, 0, 0, 6), ZIndex = 44, BackgroundColor3 = if owned[s.id] then Ui.C.panel2 else Ui.C.line })
	end
end

local function betRow(self, parent, order, onBet)
	local row = Ui.frame(parent, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, Ui.TAP), LayoutOrder = order, ZIndex = 43 })
	local buttons = {}
	local current = Rules.BETS[1]
	for i, bet in Rules.BETS do
		local b = Ui.button(row, string.format("%d", bet), function()
			current = bet
			for j, x in buttons do
				Ui.setActive(x, Rules.BETS[j] == bet)
			end
			onBet(bet)
		end, { Size = UDim2.new(1 / #Rules.BETS, -6, 1, 0), Position = UDim2.new((i - 1) / #Rules.BETS, 3, 0, 0), ZIndex = 44 })
		buttons[i] = b
	end
	Ui.setActive(buttons[1], true)
	onBet(current)
end

function Client:openSlots()
	local _, c = self:sheet(self:T("p_slots"), nil, 400)
	Ui.label(c, self:T("Bet"), { TextColor3 = Ui.C.dim, LayoutOrder = 1, ZIndex = 43 })
	local bet = Rules.BETS[1]
	betRow(self, c, 2, function(b)
		bet = b
	end)
	local reels = Ui.label(c, "👑  ⚔️  🍎", { TextSize = 46, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 70), LayoutOrder = 3, ZIndex = 43 })
	local result = Ui.label(c, "", { TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = 4, ZIndex = 43, TextColor3 = Ui.C.gold })
	local spinning = false
	Ui.button(c, self:T("Spin"), function()
		if spinning then
			return
		end
		spinning = true
		local res = request("Slots", bet)
		if not res or not res.ok then
			spinning = false
			result.Text = if res and res.error == "gold" then self:T("NotEnoughGold") else self:T("Failed")
			return
		end
		local syms = Rules.SLOT_SYMBOLS
		for k = 1, 12 do
			reels.Text = string.format("%s  %s  %s", SYMBOL[syms[math.random(1, 5)]], SYMBOL[syms[math.random(1, 5)]], SYMBOL[syms[math.random(1, 5)]])
			task.wait(0.05 + k * 0.01)
		end
		reels.Text = string.format("%s  %s  %s", SYMBOL[res.symbols[1]], SYMBOL[res.symbols[2]], SYMBOL[res.symbols[3]])
		result.Text = if res.win &gt; 0 then self:T("SlotsWin", res.win) else self:T("SlotsLose")
		self:sound(Sounds.coin, 0.5)
		spinning = false
	end, { LayoutOrder = 5, ZIndex = 43, BackgroundColor3 = Ui.C.line, Font = Ui.FONT_BOLD })
end

function Client:openCoin()
	local _, c = self:sheet(self:T("p_coin"), nil, 400)
	Ui.label(c, self:T("Bet"), { TextColor3 = Ui.C.dim, LayoutOrder = 1, ZIndex = 43 })
	local bet = Rules.BETS[1]
	betRow(self, c, 2, function(b)
		bet = b
	end)
	local result = Ui.label(c, "", { TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = 3, ZIndex = 43, TextColor3 = Ui.C.gold, Size = UDim2.new(1, 0, 0, 40) })
	Ui.button(c, self:T("Flip"), function()
		local res = request("Coin", bet)
		if not res or not res.ok then
			result.Text = if res and res.error == "gold" then self:T("NotEnoughGold") else self:T("Failed")
			return
		end
		result.Text = if res.won then self:T("CoinWin", res.win) else self:T("CoinLose")
		self:sound(Sounds.coin, 0.5)
	end, { LayoutOrder = 4, ZIndex = 43, BackgroundColor3 = Ui.C.line, Font = Ui.FONT_BOLD })
end

local function otherPlayers()
	local list = {}
	for _, p in Players:GetPlayers() do
		if p ~= player and p:GetAttribute("InCastle") then
			table.insert(list, { id = p.UserId, title = p.DisplayName .. "  @" .. p.Name })
		end
	end
	return list
end

function Client:openKing()
	local _, c, close = self:sheet(self:T("KingPanel"))
	local o = 0
	local function n()
		o += 1
		return o
	end
	local alive = workspace:GetAttribute("CastleMinions") or 0
	Ui.label(c, self:T("GuardsFormat", alive, Rules.MINION_MAX), { TextColor3 = Ui.C.dim, LayoutOrder = n(), ZIndex = 43 })
	local last = workspace:GetAttribute("CastleSummonAt") or 0
	local left = Rules.MINION_COOLDOWN - (workspace:GetServerTimeNow() - last)
	local summonText = if last &gt; 0 and left &gt; 0 then self:T("Summon") .. "\n" .. self:T("CooldownFormat", math.ceil(left)) else self:T("Summon")
	Ui.button(c, summonText, function()
		local res = request("KingSummon")
		if res and not res.ok then
			if res.error == "cooldown" then
				self:toast(self:T("CooldownFormat", math.max(1, res.left or 0)), Ui.C.red)
			elseif res.error == "max" then
				self:toast(self:T("MaxGuards"), Ui.C.red)
			end
		end
		close()
	end, { LayoutOrder = n(), ZIndex = 43, BackgroundColor3 = Ui.C.line, Size = UDim2.new(1, 0, 0, Ui.TAP + 12) })
	Ui.button(c, self:T("Order"), function()
		close()
		self.orderMode = true
		self:toast(self:T("OrderHint"))
	end, { LayoutOrder = n(), ZIndex = 43 })
	Ui.button(c, self:T("Recall"), function()
		request("KingOrder", nil)
		close()
	end, { LayoutOrder = n(), ZIndex = 43 })
	local open = workspace:GetAttribute("CastlePassage") == true
	Ui.button(c, if open then self:T("ClosePassage") else self:T("PassageOpen"), function()
		request("KingPassage", not open)
		close()
	end, { LayoutOrder = n(), ZIndex = 43 })
	Ui.toggle(c, self:T("AllowGuards"), workspace:GetAttribute("CastleGuardsPassage") == true, self:T("On"), self:T("Off"), function(x)
		request("KingGuardsPassage", x)
	end, n())
	Ui.label(c, self:T("Appoint"), { TextColor3 = Ui.C.gold, Font = Ui.FONT_BOLD, LayoutOrder = n(), ZIndex = 43 })
	for _, entry in otherPlayers() do
		Ui.button(c, entry.title, function()
			Ui.choose(self.gui, entry.title, {
				{ id = "queen", title = self:T("MakeQueen") },
				{ id = "commander", title = self:T("MakeCommander") },
				{ id = "guard", title = self:T("MakeGuard") },
				{ id = "dismiss", title = self:T("Dismiss") },
				{ id = "jail", title = self:T("SendToJail") },
				{ id = "free", title = self:T("Release") },
			}, function(action)
				local res = request("KingAppoint", entry.id, action)
				self:toast(if res and res.ok then self:T("Done") else self:T("Failed"), if res and res.ok then Ui.C.good else Ui.C.red)
			end)
		end, { LayoutOrder = n(), ZIndex = 43 })
	end
	Ui.button(c, self:T("Abdicate"), function()
		request("Abdicate")
		close()
	end, { LayoutOrder = n(), ZIndex = 43, BackgroundColor3 = Ui.C.red })
end

-- ---------------------------------------------------------------------------
-- звуки: шаги по материалу, дождь, музыка

function Client:sound(id: string, volume: number?)
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = (volume or 0.5) * self.app.settings.volume
	s.Parent = workspace.CurrentCamera
	s:Play()
	Debris:AddItem(s, 5)
end

function Client:buildSounds()
	local steps = Instance.new("Sound")
	steps.Name = "CastleSteps"
	steps.SoundId = Sounds.steps
	steps.Looped = true
	steps.Volume = 0
	steps.Parent = workspace.CurrentCamera
	self.steps = steps
	local rain = Instance.new("Sound")
	rain.SoundId = Sounds.rain
	rain.Looped = true
	rain.Volume = 0
	rain.Parent = workspace.CurrentCamera
	rain:Play()
	self.rain = rain
	local music = Instance.new("Sound")
	music.Looped = true
	music.Parent = workspace.CurrentCamera
	self.music = music
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	table.insert(self.conns, RunService.Heartbeat:Connect(function()
		local s = self.app.settings
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		-- стандартный звук бега заменяем своим
		local running = root and root:FindFirstChild("Running")
		if running and running:IsA("Sound") then
			running.Volume = 0
		end
		local speed = if root then Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z).Magnitude else 0
		if hum and root and s.footsteps and speed &gt; 1 and hum.FloorMaterial ~= Enum.Material.Air and hum.FloorMaterial ~= Enum.Material.Water then
			params.FilterDescendantsInstances = { char }
			local hit = workspace:Raycast(root.Position, Vector3.new(0, -6, 0), params)
			local mat = if hit then hit.Material else hum.FloorMaterial
			local st = STEP[mat] or STONE_STEP
			steps.PlaybackSpeed = st[1] * math.clamp(speed / 16, 0.6, 1.4)
			steps.Volume = st[2] * s.volume
			if not steps.IsPlaying then
				steps:Play()
			end
		elseif steps.IsPlaying then
			steps:Stop()
		end
		-- дождь слышно на улице, в замке тише
		local w = workspace:GetAttribute("CastleWeather")
		local wet = w == "Rain" or w == "Storm"
		local inside = false
		if wet and root then
			params.FilterDescendantsInstances = { char }
			inside = workspace:Raycast(root.Position, Vector3.new(0, 80, 0), params) ~= nil
		end
		local target = if wet then (if inside then 0.15 else 0.6) * (if w == "Storm" then 1.3 else 1) * s.volume else 0
		rain.Volume += (target - rain.Volume) * 0.05
		self.music.Volume = 0.5 * s.music
	end))
end

-- ---------------------------------------------------------------------------
-- события сервера, атрибуты, ввод

function Client:onMessage(msg)
	if type(msg) ~= "table" then
		return
	end
	if msg.type == "toast" then
		self:toast(self:T(msg.key, table.unpack(msg.args or {})))
	elseif msg.type == "announce" then
		local text = if msg.key then self:T(msg.key, table.unpack(msg.args or {})) else tostring(msg.text or "")
		self.banner.Text = text
		self.banner.Visible = true
		local token = {}
		self.bannerToken = token
		task.delay(5, function()
			if self.bannerToken == token then
				self.banner.Visible = false
			end
		end)
		local tc = TextChatService:FindFirstChild("TextChannels")
		local general = tc and tc:FindFirstChild("RBXGeneral")
		if general then
			pcall(function()
				(general :: TextChannel):DisplaySystemMessage((string.gsub(text, "\n", " ")))
			end)
		end
		self:sound(Sounds.open, 0.6)
	elseif msg.type == "open" then
		if msg.panel == "roles" then
			self:openRoles()
		elseif msg.panel == "shop" then
			self:openShop()
		elseif msg.panel == "slots" then
			self:openSlots()
		elseif msg.panel == "coin" then
			self:openCoin()
		end
	elseif msg.type == "book" then
		self:toast(self:T("Book" .. math.random(1, 3)), nil)
	elseif msg.type == "fx" then
		self:fx(msg.kind)
	end
end

function Client:fx(kind: string)
	if kind == "lightning" then
		local cc = Instance.new("ColorCorrectionEffect")
		cc.Brightness = 0.7
		cc.Parent = Lighting
		Debris:AddItem(cc, 0.15)
		task.delay(0.6, function()
			self:sound(Sounds.thunder, 0.8)
		end)
		return
	end
	if kind == "quake" then
		local t0 = os.clock()
		pcall(function()
			RunService:UnbindFromRenderStep("CastleQuake")
		end)
		RunService:BindToRenderStep("CastleQuake", Enum.RenderPriority.Camera.Value + 5, function()
			local e = os.clock() - t0
			if e &gt; 5 then
				RunService:UnbindFromRenderStep("CastleQuake")
				return
			end
			local a = (1 - e / 5) * 0.35
			local cam = workspace.CurrentCamera
			cam.CFrame = cam.CFrame * CFrame.new(math.random() * a - a / 2, math.random() * a - a / 2, 0)
		end)
		self:sound(Sounds.thunder, 1)
		return
	elseif kind == "rainbow" or kind == "dawn" or kind == "voice" then
		local cc = Instance.new("ColorCorrectionEffect")
		cc.Parent = Lighting
		local t0 = os.clock()
		local dur = if kind == "rainbow" then 12 else 3
		local conn
		conn = game:GetService("RunService").RenderStepped:Connect(function()
			local e = os.clock() - t0
			if e &gt; dur then
				conn:Disconnect()
				cc:Destroy()
				return
			end
			if kind == "rainbow" then
				cc.TintColor = Color3.fromHSV((e * 0.25) % 1, 0.35, 1)
			else
				cc.Brightness = 0.5 * (1 - e / dur)
				cc.TintColor = Color3.fromRGB(255, 240, 200)
			end
		end)
		return
	end
	if not self.app.settings.effects then
		return
	end
	if kind == "fireworks" then
		for k = 1, 10 do
			task.delay(k * 0.4, function()
				local p = Instance.new("Part")
				p.Anchored = true
				p.CanCollide = false
				p.Transparency = 1
				p.Size = Vector3.one
				p.Position = Vector3.new(math.random(-60, 60), math.random(70, 110), math.random(-140, -40))
				p.Parent = workspace
				local e = Instance.new("ParticleEmitter")
				e.Color = ColorSequence.new(Color3.fromHSV(math.random(), 0.8, 1))
				e.LightEmission = 1
				e.Speed = NumberRange.new(30, 45)
				e.SpreadAngle = Vector2.new(180, 180)
				e.Lifetime = NumberRange.new(1.2, 1.8)
				e.Drag = 3
				e.Acceleration = Vector3.new(0, -10, 0)
				e.Size = NumberSequence.new(0.8, 0)
				e.Rate = 0
				e.Parent = p
				e:Emit(120)
				self:sound("rbxasset://sounds/collide.wav", 0.4)
				Debris:AddItem(p, 3)
			end)
		end
	elseif kind == "confetti" then
		local cam = workspace.CurrentCamera
		local p = Instance.new("Part")
		p.Anchored = true
		p.CanCollide = false
		p.Transparency = 1
		p.Size = Vector3.new(30, 1, 30)
		p.CFrame = CFrame.new(cam.CFrame.Position + Vector3.new(0, 15, 0))
		p.Parent = workspace
		local e = Instance.new("ParticleEmitter")
		e.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)), ColorSequenceKeypoint.new(0.5, Color3.fromRGB(80, 200, 255)), ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 220, 80)) })
		e.EmissionDirection = Enum.NormalId.Bottom
		e.Speed = NumberRange.new(5, 10)
		e.Lifetime = NumberRange.new(3, 4)
		e.RotSpeed = NumberRange.new(-200, 200)
		e.Size = NumberSequence.new(0.3)
		e.Rate = 0
		e.Parent = p
		e:Emit(250)
		Debris:AddItem(p, 5)
	end
end

-- Двери: створки поворачиваются на петлях, когда игрок рядом (только у себя на экране)
function Client:watchDoors()
	local CollectionService = game:GetService("CollectionService")
	local doors = {}
	local function add(m)
		local leaves = {}
		for _, l in m:GetChildren() do
			if l:IsA("Model") and l.Name == "Leaf" then
				table.insert(leaves, { model = l, base = l:GetPivot(), dir = l:GetAttribute("Dir") or 1, angle = 0 })
			end
		end
		local jamb = m:FindFirstChild("Head")
		if jamb then
			doors[m] = { leaves = leaves, pos = jamb.Position }
		end
	end
	for _, m in CollectionService:GetTagged("CastleDoor") do
		add(m)
	end
	table.insert(self.conns, CollectionService:GetInstanceAddedSignal("CastleDoor"):Connect(function(m)
		task.defer(add, m)
	end))
	table.insert(self.conns, CollectionService:GetInstanceRemovedSignal("CastleDoor"):Connect(function(m)
		doors[m] = nil
	end))
	table.insert(self.conns, RunService.RenderStepped:Connect(function(dt)
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not root then
			return
		end
		for _, d in doors do
			local dist = (d.pos - root.Position).Magnitude
			if dist &lt; 60 then
				local want = if dist &lt; 13 then math.rad(85) else 0
				for _, lf in d.leaves do
					if math.abs(lf.angle - want) &gt; 0.001 then
						lf.angle += (want - lf.angle) * math.min(1, dt * 7)
						if math.abs(lf.angle - want) &lt; 0.01 then
							lf.angle = want
						end
						lf.model:PivotTo(lf.base * CFrame.Angles(0, lf.angle * lf.dir, 0))
					end
				end
			end
		end
	end))
end

function Client:watch()
	self:watchDoors()
	local function upd()
		self:refresh()
	end
	for _, a in { "Food", "Drink", "CastleRole", "JailUntil" } do
		table.insert(self.conns, player:GetAttributeChangedSignal(a):Connect(upd))
	end
	for _, a in { "Inv", "Slots" } do
		table.insert(self.conns, player:GetAttributeChangedSignal(a):Connect(function()
			self:refreshInventory()
		end))
	end
	table.insert(self.conns, workspace:GetAttributeChangedSignal("CastleWeather"):Connect(function()
		self.weather:set({ weather = workspace:GetAttribute("CastleWeather") or "Clear", at = 0, auto = false, minutes = 5 })
	end))
	self.weather:set({ weather = workspace:GetAttribute("CastleWeather") or "Clear", at = 0, auto = false, minutes = 5 })
	local function music()
		local id = workspace:GetAttribute("CastleMusic") or ""
		if id == "" then
			self.music:Stop()
		else
			self.music.SoundId = id
			self.music:Play()
		end
	end
	table.insert(self.conns, workspace:GetAttributeChangedSignal("CastleMusic"):Connect(music))
	music()
	table.insert(self.conns, Remotes.event("Castle").OnClientEvent:Connect(function(msg)
		self:onMessage(msg)
	end))
	-- инвентарь: подсветка взятого в руку предмета
	local function charConns(char)
		table.insert(self.conns, char.ChildAdded:Connect(function(c)
			if c:IsA("Tool") then
				self:refreshInventory()
			end
		end))
		table.insert(self.conns, char.ChildRemoved:Connect(function(c)
			if c:IsA("Tool") then
				self:refreshInventory()
			end
		end))
		local hum = char:WaitForChild("Humanoid", 5)
		if hum then
			table.insert(self.conns, hum.HealthChanged:Connect(upd))
		end
		upd()
		self:refreshInventory()
	end
	if player.Character then
		task.spawn(charConns, player.Character)
	end
	table.insert(self.conns, player.CharacterAdded:Connect(charConns))
	-- золото
	task.spawn(function()
		local stats = player:WaitForChild("leaderstats", 30)
		local gold = stats and stats:WaitForChild("Gold", 30)
		if gold and self.gui.Parent then
			table.insert(self.conns, gold.Changed:Connect(upd))
			upd()
		end
	end)
	-- приказ стражникам: касание игрока
	table.insert(self.conns, UserInputService.InputBegan:Connect(function(input, processed)
		if not self.orderMode or processed then
			return
		end
		if input.UserInputType ~= Enum.UserInputType.Touch and input.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end
		local cam = workspace.CurrentCamera
		local pos = if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter then cam.ViewportSize / 2 else Vector2.new(input.Position.X, input.Position.Y)
		local ray = cam:ViewportPointToRay(pos.X, pos.Y)
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { player.Character }
		local hit = workspace:Raycast(ray.Origin, ray.Direction * 300, params)
		local model = hit and hit.Instance:FindFirstAncestorOfClass("Model")
		local target = model and Players:GetPlayerFromCharacter(model)
		if target then
			self.orderMode = false
			request("KingOrder", target.UserId)
			self:toast(target.DisplayName, Ui.C.red)
		end
	end))
	-- полёт по команде админа и парящий жрец
	local flyVel: LinearVelocity? = nil
	local floatT = 0
	table.insert(self.conns, RunService.RenderStepped:Connect(function(dt)
		floatT += dt
		local decor = workspace:FindFirstChild("CastleDecor")
		if decor then
			for _, m in decor:GetChildren() do
				if m:IsA("Model") and m:GetAttribute("Float") then
					local base = m:GetAttribute("BaseCF")
					if not base then
						base = m:GetPivot()
						m:SetAttribute("BaseCF", base)
					end
					m:PivotTo(base * CFrame.new(0, math.sin(floatT * 0.8) * 0.8, 0) * CFrame.Angles(0, math.sin(floatT * 0.3) * 0.1, 0))
				end
			end
		end
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if player:GetAttribute("Fly") and root and hum then
			if not flyVel or flyVel.Parent == nil then
				local att = root:FindFirstChild("FlyAtt") or Instance.new("Attachment", root)
				att.Name = "FlyAtt"
				flyVel = Instance.new("LinearVelocity")
				flyVel.Attachment0 = att :: Attachment
				flyVel.MaxForce = 1e6
				flyVel.Parent = root
			end
			local cam = workspace.CurrentCamera
			local move = hum.MoveDirection
			local v = Vector3.zero
			if move.Magnitude &gt; 0.05 then
				local look = cam.CFrame.LookVector
				local flat = Vector3.new(look.X, 0, look.Z)
				local up = if flat.Magnitude &gt; 0.01 and move:Dot(flat.Unit) &gt; 0.3 then look.Y else 0
				v = (move + Vector3.new(0, up, 0)).Unit * 40
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) or hum.Jump then
				v += Vector3.new(0, 25, 0)
			end
			flyVel.VectorVelocity = v
		elseif flyVel then
			flyVel:Destroy()
			flyVel = nil
		end
	end))
end

function Client:applySettings()
	local s = self.app.settings
	if self.camera then
		self.camera.settings.sensitivity = s.sensitivity
		self.camera.settings.fov = s.fov
		self.camera.settings.bob = s.bob
	end
	Lighting.GlobalShadows = s.shadows
	local bloom = Lighting:FindFirstChild("CastleBloom")
	if bloom then
		(bloom :: BloomEffect).Enabled = s.effects
	end
end

function Client:destroy()
	for _, c in self.conns do
		c:Disconnect()
	end
	self.camera:destroy()
	self.weather:destroy()
	self.steps:Destroy()
	self.rain:Destroy()
	self.music:Destroy()
	self.gui:Destroy()
end

return Client
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00000046">
            <Properties>
              <string name="Name">Menu</string>
              <ProtectedString name="Source">--!nonstrict
-- Главное меню «The Castle»: название, маленькое RP в углу, Играть, Мафия, Настройки,
-- Как играть; переключатель EN и RU справа вверху. За меню камера медленно облетает замок

local RunService = game:GetService("RunService")

local Ui = require(script.Parent.Ui)

local Menu = {}
Menu.__index = Menu

function Menu.new(app)
	local self = setmetatable({}, Menu)
	self.app = app
	local gui = Instance.new("ScreenGui")
	gui.Name = "CastleMenu"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 20
	gui.Parent = app.playerGui
	self.gui = gui
	self.t = 0
	self:build()
	self.conn = RunService.RenderStepped:Connect(function(dt)
		if not gui.Enabled then
			return
		end
		self.t += dt
		local cam = workspace.CurrentCamera
		cam.CameraType = Enum.CameraType.Scriptable
		local a = self.t * 0.04
		local pos = Vector3.new(math.sin(a) * 260, 95 + math.sin(self.t * 0.1) * 8, math.cos(a) * 300 - 20)
		cam.CFrame = CFrame.lookAt(pos, Vector3.new(0, 30, 10))
		cam.FieldOfView = 60
	end)
	return self
end

function Menu:build()
	local app = self.app
	local T = app.T
	self.gui:ClearAllChildren()
	local gui = self.gui
	-- затемнение снизу, чтобы кнопки читались поверх замка
	local fade = Ui.frame(gui, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Ui.C.shade, BackgroundTransparency = 0.25 })
	local grad = Instance.new("UIGradient")
	grad.Rotation = 90
	grad.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.85), NumberSequenceKeypoint.new(0.5, 0.45), NumberSequenceKeypoint.new(1, 0.1) })
	grad.Parent = fade
	local v = Ui.viewport()
	local small = v.Y &lt; 500
	local title = Ui.label(gui, T("Title"), {
		Font = Ui.TITLE,
		TextSize = if small then 52 else 78,
		TextColor3 = Ui.C.gold,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, if small then 64 else 96),
		Position = UDim2.new(0, 0, if small then 0.08 else 0.14, 0),
	})
	local st = Instance.new("UIStroke")
	st.Color = Color3.new(0, 0, 0)
	st.Transparency = 0.4
	st.Thickness = 2
	st.Parent = title
	local col = Ui.frame(gui, { BackgroundTransparency = 1, Size = UDim2.fromOffset(math.min(300, v.X - 40), 4 * (Ui.TAP + 10)), Position = UDim2.new(0.5, -math.min(300, v.X - 40) / 2, if small then 0.34 else 0.42, 0) })
	Ui.list(col, 10)
	local function big(text, order, fn, accent)
		local b = Ui.button(col, text, fn, { LayoutOrder = order, TextSize = 19, Font = Ui.FONT_BOLD, BackgroundTransparency = 0.15, BackgroundColor3 = if accent then Ui.C.line else Ui.C.panel })
		return b
	end
	big(T("Play"), 1, function()
		app:play()
	end, true)
	big(T("Mafia"), 2, function()
		app:openMafia()
	end)
	big(T("Settings"), 3, function()
		self:openSettings()
	end)
	big(T("HowToPlay"), 4, function()
		self:openTutorial()
	end)
	-- язык: сначала английский, потом русский
	local langBox = Ui.frame(gui, { BackgroundTransparency = 1, Size = UDim2.fromOffset(2 * 56 + 6, 40), Position = UDim2.new(1, -2 * 56 - 18, 0, 12 + 36) })
	Ui.list(langBox, 6, true)
	for i, l in { "en", "ru" } do
		local b = Ui.button(langBox, string.upper(l), function()
			app:setLang(l)
		end, { Size = UDim2.fromOffset(56, 40), LayoutOrder = i, Font = Ui.FONT_BOLD })
		Ui.setActive(b, app.lang == l)
	end
	Ui.label(gui, T("Rp"), { Font = Ui.TITLE, TextSize = 22, TextColor3 = Ui.C.gold, TextXAlignment = Enum.TextXAlignment.Right, Size = UDim2.fromOffset(80, 30), Position = UDim2.new(1, -96, 1, -42) })
end

function Menu:setVisible(on: boolean)
	self.gui.Enabled = on
	if not on then
		local cam = workspace.CurrentCamera
		cam.CameraType = Enum.CameraType.Custom
		cam.FieldOfView = 70
	end
end

-- Настройки звука, камеры и графики; сохраняются в профиле игрока
function Menu.settingsSheet(app, gui: Instance)
	local T = app.T
	local s = app.settings
	local _, c = Ui.sheet(gui, T("Settings"), function()
		app:saveSettings()
		app:sheetClosed()
	end)
	local o = 0
	local function n()
		o += 1
		return o
	end
	Ui.slider(c, T("Volume"), s.volume, 0, 1, function(x)
		s.volume = x
		app:applySettings()
	end, n())
	Ui.slider(c, T("MusicVolume"), s.music, 0, 1, function(x)
		s.music = x
		app:applySettings()
	end, n())
	Ui.toggle(c, T("Footsteps"), s.footsteps, T("On"), T("Off"), function(x)
		s.footsteps = x
		app:applySettings()
	end, n())
	Ui.slider(c, T("CameraSway"), s.bob, 0, 1, function(x)
		s.bob = x
		app:applySettings()
	end, n())
	Ui.slider(c, T("Sensitivity"), s.sensitivity, 0.2, 2, function(x)
		s.sensitivity = x
		app:applySettings()
	end, n())
	Ui.slider(c, T("Fov"), s.fov, 60, 100, function(x)
		s.fov = x
		app:applySettings()
	end, n())
	Ui.toggle(c, T("Shadows"), s.shadows, T("On"), T("Off"), function(x)
		s.shadows = x
		app:applySettings()
	end, n())
	Ui.toggle(c, T("Effects"), s.effects, T("On"), T("Off"), function(x)
		s.effects = x
		app:applySettings()
	end, n())
	Ui.toggle(c, T("Language"), app.lang == "ru", "RU", "EN", function(x)
		app:setLang(if x then "ru" else "en")
	end, n())
end

function Menu:openSettings()
	Menu.settingsSheet(self.app, self.gui)
end

-- Обучение: несколько страниц на выбранном языке
function Menu.tutorialSheet(app, gui: Instance)
	local T = app.T
	local pages = {
		{ T("Title"), T("Welcome") },
		{ T("Roles"), T("Roles") },
		{ T("Food") .. " · " .. T("Drink"), T("Needs") },
		{ T("Take"), T("Inventory") },
		{ T("King"), T("KingTip") },
		{ T("Rp"), T("RulesTip") },
	}
	local i = 1
	local frame, content, close = Ui.sheet(gui, T("Tutorial"), function()
		app:sheetClosed()
	end, 460)
	local _ = frame
	local head = Ui.label(content, "", { Font = Ui.TITLE, TextSize = 24, TextColor3 = Ui.C.gold, Size = UDim2.new(1, 0, 0, 34), LayoutOrder = 1, ZIndex = 43 })
	local body = Ui.label(content, "", { TextSize = 17, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, ZIndex = 43, TextYAlignment = Enum.TextYAlignment.Top })
	local counter = Ui.label(content, "", { TextColor3 = Ui.C.dim, TextSize = 14, LayoutOrder = 3, ZIndex = 43, TextXAlignment = Enum.TextXAlignment.Center })
	local row = Ui.frame(content, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, Ui.TAP), LayoutOrder = 4, ZIndex = 43 })
	local function show()
		head.Text = pages[i][1]
		body.Text = pages[i][2]
		counter.Text = string.format("%d / %d", i, #pages)
	end
	Ui.button(row, T("Back"), function()
		i = math.max(1, i - 1)
		show()
	end, { Size = UDim2.new(0.5, -4, 1, 0), ZIndex = 43 })
	Ui.button(row, T("Next"), function()
		if i == #pages then
			close()
			return
		end
		i += 1
		show()
	end, { Size = UDim2.new(0.5, -4, 1, 0), Position = UDim2.new(0.5, 4, 0, 0), ZIndex = 43, BackgroundColor3 = Ui.C.line })
	show()
end

function Menu:openTutorial()
	Menu.tutorialSheet(self.app, self.gui)
end

function Menu:destroy()
	self.conn:Disconnect()
	self.gui:Destroy()
end

return Menu
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00000047">
            <Properties>
              <string name="Name">Ui</string>
              <ProtectedString name="Source">--!nonstrict
-- Оформление интерфейса замка: тёмное дерево, тёплое золото, крупные кнопки для пальца.
-- Все надписи приходят из Lang, здесь только элементы

local TextService = game:GetService("TextService")
local UserInputService = game:GetService("UserInputService")

local Ui = {}

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

Ui.C = {
	shade = rgb(8, 6, 5),
	bg = rgb(18, 14, 12),
	panel = rgb(30, 24, 20),
	panel2 = rgb(48, 38, 30),
	line = rgb(120, 92, 56),
	text = rgb(242, 230, 208),
	dim = rgb(176, 160, 134),
	gold = rgb(226, 184, 96),
	red = rgb(176, 46, 46),
	health = rgb(196, 58, 58),
	food = rgb(214, 140, 60),
	drink = rgb(70, 140, 214),
	good = rgb(96, 170, 104),
}
Ui.FONT = Enum.Font.GothamMedium
Ui.FONT_BOLD = Enum.Font.GothamBold
Ui.TITLE = Enum.Font.Garamond
Ui.TAP = if UserInputService.TouchEnabled then 50 else 42

function Ui.viewport(): Vector2
	local cam = workspace.CurrentCamera
	return if cam then cam.ViewportSize else Vector2.new(1024, 768)
end

function Ui.corner(parent: Instance, r: number?)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 8)
	c.Parent = parent
	return c
end

function Ui.stroke(parent: Instance, color: Color3?, t: number?)
	local s = Instance.new("UIStroke")
	s.Color = color or Ui.C.line
	s.Thickness = t or 1
	s.Transparency = 0.2
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
	return s
end

function Ui.pad(parent: Instance, p: number)
	local u = Instance.new("UIPadding")
	u.PaddingLeft = UDim.new(0, p)
	u.PaddingRight = UDim.new(0, p)
	u.PaddingTop = UDim.new(0, p)
	u.PaddingBottom = UDim.new(0, p)
	u.Parent = parent
	return u
end

function Ui.list(parent: Instance, gap: number?, horizontal: boolean?)
	local l = Instance.new("UIListLayout")
	l.Padding = UDim.new(0, gap or 6)
	l.SortOrder = Enum.SortOrder.LayoutOrder
	if horizontal then
		l.FillDirection = Enum.FillDirection.Horizontal
	end
	l.Parent = parent
	return l
end

function Ui.frame(parent: Instance?, props): Frame
	local f = Instance.new("Frame")
	f.BackgroundColor3 = Ui.C.panel
	f.BorderSizePixel = 0
	for k, v in props or {} do
		(f :: any)[k] = v
	end
	f.Parent = parent
	return f
end

function Ui.label(parent: Instance?, text: string, props): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Font = Ui.FONT
	l.TextColor3 = Ui.C.text
	l.TextSize = 16
	l.TextWrapped = true
	l.Text = text
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.Size = UDim2.new(1, 0, 0, 22)
	for k, v in props or {} do
		(l :: any)[k] = v
	end
	l.Parent = parent
	return l
end

function Ui.button(parent: Instance?, text: string, onClick: (() -&gt; ())?, props): TextButton
	local b = Instance.new("TextButton")
	b.AutoButtonColor = true
	b.BackgroundColor3 = Ui.C.panel2
	b.BorderSizePixel = 0
	b.Font = Ui.FONT
	b.TextColor3 = Ui.C.text
	b.TextSize = 16
	b.TextWrapped = true
	b.Text = text
	b.Size = UDim2.new(1, 0, 0, Ui.TAP)
	Ui.corner(b, 6)
	Ui.stroke(b)
	for k, v in props or {} do
		(b :: any)[k] = v
	end
	if onClick then
		b.Activated:Connect(onClick)
	end
	b.Parent = parent
	return b
end

function Ui.setActive(b: GuiObject, on: boolean)
	b.BackgroundColor3 = if on then Ui.C.line else Ui.C.panel2
end

-- Окно по центру экрана с заголовком и прокруткой. Возвращает (окно, содержимое, закрыть)
function Ui.sheet(gui: Instance, title: string, onClose: (() -&gt; ())?, width: number?)
	local v = Ui.viewport()
	local w = math.min(width or 440, v.X - 24)
	local h = math.min(560, v.Y - 70)
	local shade = Instance.new("TextButton")
	shade.Name = "Sheet"
	shade.Text = ""
	shade.AutoButtonColor = false
	shade.BackgroundColor3 = Ui.C.shade
	shade.BackgroundTransparency = 0.4
	shade.Size = UDim2.fromScale(1, 1)
	shade.ZIndex = 40
	shade.Parent = gui
	local f = Ui.frame(shade, { Size = UDim2.fromOffset(w, h), Position = UDim2.new(0.5, -w / 2, 0.5, -h / 2), BackgroundColor3 = Ui.C.bg, ZIndex = 41 })
	Ui.corner(f, 10)
	Ui.stroke(f, Ui.C.gold, 1.5)
	Ui.label(f, title, { Font = Ui.TITLE, TextSize = 28, TextColor3 = Ui.C.gold, Size = UDim2.new(1, -70, 0, 44), Position = UDim2.fromOffset(16, 6), ZIndex = 42 })
	local function close()
		shade:Destroy()
		if onClose then
			onClose()
		end
	end
	Ui.button(f, "X", close, { Size = UDim2.fromOffset(Ui.TAP, Ui.TAP - 6), Position = UDim2.new(1, -Ui.TAP - 8, 0, 8), ZIndex = 43, Font = Ui.FONT_BOLD })
	local s = Instance.new("ScrollingFrame")
	s.BackgroundTransparency = 1
	s.BorderSizePixel = 0
	s.Size = UDim2.new(1, -24, 1, -64)
	s.Position = UDim2.fromOffset(12, 56)
	s.ScrollBarThickness = 5
	s.ScrollBarImageColor3 = Ui.C.line
	s.AutomaticCanvasSize = Enum.AutomaticSize.Y
	s.CanvasSize = UDim2.new()
	s.ZIndex = 42
	s.Parent = f
	Ui.list(s, 8)
	Ui.pad(s, 2)
	return f, s, close
end

-- Выбор из списка поверх всего (игрок, вариант аргумента)
function Ui.choose(gui: Instance, title: string, options: { { id: any, title: string } }, onPick: (any) -&gt; ())
	local _, content, close = Ui.sheet(gui, title, nil, 380)
	for i, o in options do
		Ui.button(content, o.title, function()
			close()
			onPick(o.id)
		end, { LayoutOrder = i, ZIndex = 43 })
	end
end

-- Ввод текста или числа
function Ui.prompt(gui: Instance, title: string, okText: string, onDone: (string) -&gt; ())
	local _, content, close = Ui.sheet(gui, title, nil, 380)
	local box = Instance.new("TextBox")
	box.Text = ""
	box.PlaceholderText = ""
	box.ClearTextOnFocus = false
	box.Font = Ui.FONT
	box.TextSize = 16
	box.TextColor3 = Ui.C.text
	box.BackgroundColor3 = Ui.C.panel
	box.Size = UDim2.new(1, 0, 0, Ui.TAP)
	box.ZIndex = 43
	box.LayoutOrder = 1
	Ui.corner(box, 6)
	Ui.stroke(box)
	box.Parent = content
	Ui.button(content, okText, function()
		local t = box.Text
		close()
		onDone(t)
	end, { LayoutOrder = 2, ZIndex = 43, BackgroundColor3 = Ui.C.line })
end

-- Короткое сообщение вверху экрана
function Ui.toast(gui: Instance, text: string, color: Color3?, seconds: number?)
	local v = Ui.viewport()
	local w = math.min(480, v.X - 32)
	local size = TextService:GetTextSize(text, 16, Ui.FONT, Vector2.new(w - 24, 1000))
	local f = Ui.frame(gui, { Size = UDim2.fromOffset(w, size.Y + 20), Position = UDim2.new(0.5, -w / 2, 0, 70), BackgroundColor3 = color or Ui.C.panel, BackgroundTransparency = 0.1, ZIndex = 90 })
	Ui.corner(f, 8)
	Ui.stroke(f, Ui.C.line)
	Ui.label(f, text, { Size = UDim2.new(1, -24, 1, -20), Position = UDim2.fromOffset(12, 10), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 91 })
	task.delay(seconds or 3, function()
		f:Destroy()
	end)
	return f
end

-- Слайдер 0..1 (или lo..hi) для пальца
function Ui.slider(parent: Instance, title: string, value: number, lo: number, hi: number, onChange: (number) -&gt; (), order: number)
	local row = Ui.frame(parent, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, Ui.TAP), LayoutOrder = order })
	Ui.label(row, title, { Size = UDim2.new(0.42, -4, 1, 0), TextColor3 = Ui.C.dim, TextSize = 15, ZIndex = 43 })
	local bar = Ui.frame(row, { BackgroundColor3 = Ui.C.panel2, Size = UDim2.new(0.58, -50, 0, 8), Position = UDim2.new(0.42, 0, 0.5, -4), ZIndex = 43 })
	Ui.corner(bar, 4)
	local fill = Ui.frame(bar, { BackgroundColor3 = Ui.C.gold, Size = UDim2.fromScale(0, 1), ZIndex = 44 })
	Ui.corner(fill, 4)
	local val = Ui.label(row, "", { Size = UDim2.new(0, 46, 1, 0), Position = UDim2.new(1, -46, 0, 0), TextXAlignment = Enum.TextXAlignment.Right, TextSize = 14, ZIndex = 43 })
	local function show(v)
		fill.Size = UDim2.fromScale(math.clamp((v - lo) / (hi - lo), 0, 1), 1)
		val.Text = if hi &gt; 10 then string.format("%d", v) else string.format("%.1f", v)
	end
	show(value)
	local hit = Instance.new("TextButton")
	hit.BackgroundTransparency = 1
	hit.Text = ""
	hit.Size = UDim2.new(0.58, -50, 1, 0)
	hit.Position = UDim2.new(0.42, 0, 0, 0)
	hit.ZIndex = 45
	hit.Parent = row
	local dragging, last = false, value
	local function at(x)
		local a = math.clamp((x - bar.AbsolutePosition.X) / math.max(1, bar.AbsoluteSize.X), 0, 1)
		local v = lo + (hi - lo) * a
		v = if hi &gt; 10 then math.floor(v + 0.5) else math.floor(v * 10 + 0.5) / 10
		show(v)
		return v
	end
	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			last = at(input.Position.X)
		end
	end)
	local c1 = UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			last = at(input.Position.X)
		end
	end)
	local c2 = UserInputService.InputEnded:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			dragging = false
			onChange(last)
		end
	end)
	row.Destroying:Connect(function()
		c1:Disconnect()
		c2:Disconnect()
	end)
	return row
end

function Ui.toggle(parent: Instance, title: string, value: boolean, onText: string, offText: string, onChange: (boolean) -&gt; (), order: number)
	local row = Ui.frame(parent, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, Ui.TAP), LayoutOrder = order })
	Ui.label(row, title, { Size = UDim2.new(0.42, -4, 1, 0), TextColor3 = Ui.C.dim, TextSize = 15, ZIndex = 43 })
	local state = value
	local b
	b = Ui.button(row, if state then onText else offText, function()
		state = not state
		b.Text = if state then onText else offText
		Ui.setActive(b, state)
		onChange(state)
	end, { Size = UDim2.new(0.58, 0, 1, -4), Position = UDim2.new(0.42, 0, 0, 2), ZIndex = 43 })
	Ui.setActive(b, state)
	return row
end

return Ui
</ProtectedString>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="RBX00000048">
          <Properties>
            <string name="Name">Common</string>
          </Properties>
          <Item class="ModuleScript" referent="RBX00000049">
            <Properties>
              <string name="Name">Bubble</string>
              <ProtectedString name="Source">--!nonstrict
-- Пузырь реплики. Один и тот же код рисует реплику в игре и в предпросмотре
-- редактора, поэтому автор видит на маленьком экране ровно то, что увидят игроки

local TextService = game:GetService("TextService")

local Bubble = {}

Bubble.FONT = Enum.Font.GothamMedium

-- Размер текста подстраивается под экран: не меньше 16 на телефоне
function Bubble.textSize(authorSize: number, viewport: Vector2): number
	local scale = math.clamp(math.min(viewport.X, viewport.Y) / 600, 0.75, 1.25)
	return math.clamp(math.floor(authorSize * scale + 0.5), 16, 40)
end

function Bubble.maxWidth(viewport: Vector2): number
	return math.floor(math.clamp(viewport.X * 0.62, 220, 460))
end

function Bubble.make(parent: Instance, text: string, textSize: number, maxWidth: number, wrap: boolean?): Frame
	local pad = 12
	local bounds = TextService:GetTextSize(text, textSize, Bubble.FONT, Vector2.new(if wrap == false then 10000 else maxWidth - pad * 2, 10000))
	local w = math.min(bounds.X + pad * 2 + 2, if wrap == false then 10000 else maxWidth)
	local h = bounds.Y + pad * 2
	local f = Instance.new("Frame")
	f.Name = "Bubble"
	f.BackgroundColor3 = Color3.fromRGB(250, 250, 252)
	f.BackgroundTransparency = 0.04
	f.BorderSizePixel = 0
	f.Size = UDim2.fromOffset(w, h)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 12)
	c.Parent = f
	local s = Instance.new("UIStroke")
	s.Color = Color3.fromRGB(30, 30, 40)
	s.Transparency = 0.6
	s.Parent = f
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = UDim2.new(1, -pad * 2, 1, -pad * 2)
	l.Position = UDim2.fromOffset(pad, pad)
	l.Font = Bubble.FONT
	l.TextSize = textSize
	l.TextColor3 = Color3.fromRGB(20, 22, 30)
	l.TextWrapped = wrap ~= false
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.TextYAlignment = Enum.TextYAlignment.Top
	l.Text = text
	l.Parent = f
	f.Parent = parent
	return f
end

return Bubble
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX0000004A">
            <Properties>
              <string name="Name">CameraController</string>
              <ProtectedString name="Source">--!nonstrict
-- Камера игры: от первого лица в духе DOORS с настраиваемой чувствительностью,
-- полем зрения и покачиванием (до нуля). Для шкафов и кат-сцен камера временно
-- идёт по заданной траектории, затем возвращается к управлению игрока

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Workshop"):WaitForChild("Shared")
local Anim = require(Shared.Anim)
local Convert = require(Shared.Roblox.Convert)

local CameraController = {}
CameraController.__index = CameraController

local player = Players.LocalPlayer

function CameraController.new(settings)
	local self = setmetatable({}, CameraController)
	self.settings = settings.camera
	self.mode = "player" -- player | track | inside
	self.yaw = 0
	self.pitch = 0
	self.bobT = 0
	self.track = nil
	self.inside = nil
	self.lookTouch = nil :: InputObject?
	self.conns = {}
	local cam = workspace.CurrentCamera
	self.firstPerson = self.settings.mode == "first"

	if self.firstPerson then
		cam.CameraType = Enum.CameraType.Scriptable
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if hrp then
			local _, y = hrp.CFrame:ToOrientation()
			self.yaw = y
		end
	else
		cam.CameraType = Enum.CameraType.Custom
	end
	cam.FieldOfView = self.settings.fov

	-- поворот взгляда: мышь (центр зафиксирован) или палец на свободной части экрана
	table.insert(self.conns, UserInputService.InputChanged:Connect(function(input, processed)
		if not self.firstPerson or self.mode == "track" then
			return
		end
		local sens = self.settings.sensitivity
		if input.UserInputType == Enum.UserInputType.MouseMovement and not self.freeCursor then
			self:look(input.Delta.X * 0.0035 * sens, input.Delta.Y * 0.0035 * sens)
		elseif input.UserInputType == Enum.UserInputType.Touch and input == self.lookTouch and not processed then
			self:look(input.Delta.X * 0.006 * sens, input.Delta.Y * 0.006 * sens)
		end
	end))
	table.insert(self.conns, UserInputService.TouchStarted:Connect(function(input, processed)
		if processed or self.lookTouch then
			return
		end
		-- левая нижняя часть экрана занята джойстиком движения
		local v = workspace.CurrentCamera.ViewportSize
		if input.Position.X &lt; v.X * 0.4 and input.Position.Y &gt; v.Y * 0.45 then
			return
		end
		self.lookTouch = input
	end))
	table.insert(self.conns, UserInputService.TouchEnded:Connect(function(input)
		if input == self.lookTouch then
			self.lookTouch = nil
		end
	end))

	RunService:BindToRenderStep("WsCamera", Enum.RenderPriority.Camera.Value + 1, function(dt)
		self:update(dt)
	end)
	return self
end

function CameraController:look(dx: number, dy: number)
	self.yaw -= dx
	local limit = if self.mode == "inside" then math.rad(35) else math.rad(80)
	self.pitch = math.clamp(self.pitch - dy, -limit, limit)
	if self.mode == "inside" and self.inside then
		self.yaw = math.clamp(self.yaw, self.inside.yaw - math.rad(55), self.inside.yaw + math.rad(55))
	end
end

-- Голова и всё, что на ней (волосы, шляпы, корона), скрыты от первого лица,
-- а тело, руки, ноги и предметы в руках видны — можно посмотреть вниз на свой скин
local function onHead(part: BasePart, head: BasePart?): boolean
	if not head then
		return false
	end
	if part == head then
		return true
	end
	for _, w in part:GetChildren() do
		if (w:IsA("Weld") or w:IsA("WeldConstraint") or w:IsA("Motor6D")) and ((w :: any).Part0 == head or (w :: any).Part1 == head) then
			return true
		end
	end
	local acc = part.Parent
	if acc and acc:IsA("Accessory") then
		local h = acc:FindFirstChild("Handle")
		local weld = h and h:FindFirstChild("AccessoryWeld")
		if weld and ((weld :: any).Part1 == head or (weld :: any).Part0 == head) then
			return true
		end
	end
	return false
end

local lastVisible, lastAt = nil, 0
local function setCharacterVisible(visible: boolean)
	local char = player.Character
	if not char then
		return
	end
	-- пересчёт не чаще 5 раз в секунду: новые вещи в руках подхватятся быстро
	local now = os.clock()
	if lastVisible == visible and now - lastAt &lt; 0.2 then
		return
	end
	lastVisible, lastAt = visible, now
	local head = char:FindFirstChild("Head") :: BasePart?
	for _, d in char:GetDescendants() do
		if d:IsA("BasePart") then
			d.LocalTransparencyModifier = if visible or not onHead(d, head) then 0 else 1
		elseif d:IsA("Decal") then
			local parent = d.Parent
			d.LocalTransparencyModifier = if visible or not (parent and parent:IsA("BasePart") and onHead(parent, head)) then 0 else 1
		end
	end
end

function CameraController:update(dt: number)
	local cam = workspace.CurrentCamera
	if self.mode == "track" and self.track then
		local tr = self.track
		tr.elapsed += dt
		local t = math.min(tr.elapsed, tr.clip.length)
		local s = Anim.sample(tr.clip, t).Camera
		cam.CameraType = Enum.CameraType.Scriptable
		if s then
			cam.CFrame = tr.base * Convert.cfFrom(s.pos, s.rot)
		end
		if tr.elapsed &gt;= tr.clip.length then
			self.track = nil
			self.mode = tr.after or "player"
			if tr.done then
				task.spawn(tr.done)
			end
		end
		if self.firstPerson then
			setCharacterVisible(false)
		end
		return
	end
	if self.mode == "inside" and self.inside then
		cam.CameraType = Enum.CameraType.Scriptable
		local eye = self.inside.eye
		cam.CFrame = CFrame.new(eye.Position) * CFrame.fromOrientation(self.pitch, self.yaw, 0)
		if self.firstPerson then
			setCharacterVisible(false)
		end
		return
	end
	if not self.firstPerson then
		if cam.CameraType ~= Enum.CameraType.Custom then
			cam.CameraType = Enum.CameraType.Custom
		end
		return
	end
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum then
		return
	end
	cam.CameraType = Enum.CameraType.Scriptable
	cam.FieldOfView = self.settings.fov
	-- заставка: игрока ведут к дому, камера плавно идёт сзади и чуть сбоку
	if self.walkMode then
		hum.AutoRotate = true
		local look = hrp.CFrame.LookVector
		local flatLook = Vector3.new(look.X, 0, look.Z)
		flatLook = if flatLook.Magnitude &gt; 0.01 then flatLook.Unit else Vector3.new(0, 0, -1)
		local right = Vector3.new(-flatLook.Z, 0, flatLook.X)
		local want = CFrame.lookAt(hrp.Position - flatLook * 10 + Vector3.new(0, 4.5, 0) + right * 2.5, hrp.Position + flatLook * 8 + Vector3.new(0, 2.5, 0))
		self.walkCF = if self.walkCF then self.walkCF:Lerp(want, 1 - math.exp(-dt * 3)) else want
		cam.CFrame = self.walkCF
		setCharacterVisible(true)
		return
	end
	self.walkCF = nil
	if UserInputService.MouseEnabled and not UserInputService.TouchEnabled then
		-- курсор свободен, пока открыто окно (магазин, роли, админ-панель)
		UserInputService.MouseBehavior = if self.freeCursor then Enum.MouseBehavior.Default else Enum.MouseBehavior.LockCenter
		UserInputService.MouseIconEnabled = self.freeCursor == true
	end
	-- мягкая камера от первого лица: взгляд догоняет поворот, шаги дают плавное
	-- покачивание вверх-вниз и из стороны в сторону, при шаге вбок камера слегка
	-- наклоняется, на месте едва заметно «дышит». Интенсивность 0 всё отключает
	local vel = hrp.AssemblyLinearVelocity
	local speed = Vector3.new(vel.X, 0, vel.Z).Magnitude
	local bob = self.settings.bob
	local onGround = hum.FloorMaterial ~= Enum.Material.Air
	local moving = speed &gt; 0.5 and onGround
	self.bobAmp = (self.bobAmp or 0) + ((if moving then 1 else 0) - (self.bobAmp or 0)) * math.min(1, dt * 6)
	self.bobT += dt * math.clamp(speed / 14, 0.5, 1.7) * 8.5
	self.idleT = (self.idleT or 0) + dt
	local amp = self.bobAmp * bob
	local offset = Vector3.new(
		math.sin(self.bobT * 0.5) * 0.08 * amp,
		(math.abs(math.sin(self.bobT * 0.5)) * 0.16 - 0.08) * amp + math.sin(self.idleT * 1.6) * 0.015 * bob,
		0
	)
	-- наклон при шаге и при движении вбок
	local localVel = CFrame.fromOrientation(0, self.yaw, 0):VectorToObjectSpace(vel)
	local strafe = math.clamp(localVel.X / 16, -1, 1)
	local rollTarget = (-strafe * math.rad(2.2) + math.sin(self.bobT * 0.5) * math.rad(0.6) * self.bobAmp) * bob
	self.roll = (self.roll or 0) + (rollTarget - (self.roll or 0)) * math.min(1, dt * 8)
	-- сглаживание взгляда
	self.viewYaw = self.viewYaw or self.yaw
	self.viewPitch = self.viewPitch or self.pitch
	local k = 1 - math.exp(-dt * 22)
	local dy = (self.yaw - self.viewYaw + math.pi) % (2 * math.pi) - math.pi
	self.viewYaw += dy * k
	self.viewPitch += (self.pitch - self.viewPitch) * k
	local headY = if hum.RigType == Enum.HumanoidRigType.R6 then 1.5 else hum.HipHeight * 0.75
	local eye = hrp.Position + Vector3.new(0, headY, 0) + CFrame.fromOrientation(0, self.viewYaw, 0).LookVector * 0.45
	local rot = CFrame.fromOrientation(self.viewPitch, self.viewYaw, 0) * CFrame.Angles(0, 0, self.roll)
	cam.CFrame = CFrame.new(eye) * rot * CFrame.new(offset)
	-- персонаж поворачивается вслед за взглядом
	if not hrp.Anchored then
		hum.AutoRotate = false
		local flat = CFrame.fromOrientation(0, self.yaw, 0)
		hrp.CFrame = CFrame.new(hrp.Position) * flat
	end
	setCharacterVisible(false)
end

-- Режим заставки при проводке по маршруту
function CameraController:setWalk(on: boolean)
	self.walkMode = on
	if not on then
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if hrp then
			local _, y = hrp.CFrame:ToOrientation()
			self.yaw = y
			self.viewYaw = y
			self.pitch = 0
			self.viewPitch = 0
		end
	end
end

-- Временная траектория камеры (дорожка Camera клипа в системе координат base)
function CameraController:playTrack(base: CFrame, clip, after: string?, done: (() -&gt; ())?)
	if not clip.tracks.Camera then
		if done then
			task.spawn(done)
		end
		return
	end
	self.mode = "track"
	self.track = { base = base, clip = clip, elapsed = 0, after = after, done = done }
end

function CameraController:enterInside(eye: CFrame)
	local _, y = eye:ToOrientation()
	self.inside = { eye = eye, yaw = y }
	self.yaw = y
	self.pitch = 0
	if self.mode ~= "track" then
		self.mode = "inside"
	elseif self.track then
		self.track.after = "inside"
	end
end

-- Возврат управления игроку (после выхода, прерывания или смерти)
function CameraController:restore()
	self.track = nil
	self.inside = nil
	self.mode = "player"
	self.pitch = 0
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if hrp then
		local _, y = hrp.CFrame:ToOrientation()
		self.yaw = y
	end
end

function CameraController:setFreeCursor(on: boolean)
	self.freeCursor = on
end

function CameraController:destroy()
	RunService:UnbindFromRenderStep("WsCamera")
	for _, c in self.conns do
		c:Disconnect()
	end
	UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	UserInputService.MouseIconEnabled = true
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.AutoRotate = true
	end
	setCharacterVisible(true)
	local cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Custom
	cam.FieldOfView = 70
end

return CameraController
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX0000004B">
            <Properties>
              <string name="Name">FreeCamera</string>
              <ProtectedString name="Source">--!nonstrict
-- Камера редактора. Касание: один палец вращает, два пальца двигают и приближают
-- Мышь: правая кнопка вращает, средняя двигает, колесо приближает; WASD, Q и E летают
-- Камера никогда не двигает объекты: объект меняется только ручками

local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local FreeCamera = {}
FreeCamera.__index = FreeCamera

function FreeCamera.new(focus: Vector3)
	local self = setmetatable({}, FreeCamera)
	self.focus = focus
	self.yaw = math.rad(30)
	self.pitch = math.rad(-35)
	self.dist = 45
	self.enabled = true
	self.blockDrag = false -- выставляет Gizmo, пока тянут ручку
	self.padMove = Vector3.zero -- полёт с экранных кнопок
	self.onTap = nil :: ((Vector2) -&gt; ())?
	self.touches = {} :: { [InputObject]: Vector2 }
	self.touchStart = {} :: { [InputObject]: { pos: Vector2, t: number, moved: boolean } }
	self.mouseDown = nil :: { pos: Vector2, t: number, moved: boolean }?
	self.rmb = false
	self.mmb = false
	self.conns = {}
	local cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Scriptable

	local function overGui(pos: Vector2): boolean
		local player = game:GetService("Players").LocalPlayer
		local gui = player:FindFirstChildOfClass("PlayerGui")
		if not gui then
			return false
		end
		for _, g in gui:GetGuiObjectsAtPosition(pos.X, pos.Y) do
			if g.Visible and g:FindFirstAncestorOfClass("ScreenGui") and (g:IsA("GuiButton") or g:IsA("TextBox") or g:IsA("ScrollingFrame") or (g:IsA("Frame") and g.BackgroundTransparency &lt; 1)) then
				return true
			end
		end
		return false
	end

	table.insert(self.conns, UserInputService.InputBegan:Connect(function(input, processed)
		if not self.enabled then
			return
		end
		local t = input.UserInputType
		if t == Enum.UserInputType.Touch then
			local p = Vector2.new(input.Position.X, input.Position.Y)
			if processed or overGui(p) then
				return
			end
			self.touches[input] = p
			self.touchStart[input] = { pos = p, t = os.clock(), moved = false }
		elseif processed then
			return
		elseif t == Enum.UserInputType.MouseButton1 then
			self.mouseDown = { pos = Vector2.new(input.Position.X, input.Position.Y), t = os.clock(), moved = false }
		elseif t == Enum.UserInputType.MouseButton2 then
			self.rmb = true
		elseif t == Enum.UserInputType.MouseButton3 then
			self.mmb = true
		end
	end))

	table.insert(self.conns, UserInputService.InputChanged:Connect(function(input, processed)
		if not self.enabled then
			return
		end
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseWheel and not processed then
			self.dist = math.clamp(self.dist * (1 - input.Position.Z * 0.12), 4, 400)
		elseif t == Enum.UserInputType.MouseMovement then
			local d = input.Delta
			if self.mouseDown and (Vector2.new(input.Position.X, input.Position.Y) - self.mouseDown.pos).Magnitude &gt; 6 then
				self.mouseDown.moved = true
			end
			if self.rmb then
				self:orbit(d.X, d.Y)
			elseif self.mmb then
				self:pan(d.X, d.Y)
			end
		elseif t == Enum.UserInputType.Touch and self.touches[input] then
			local p = Vector2.new(input.Position.X, input.Position.Y)
			local prev = self.touches[input]
			local st = self.touchStart[input]
			if st and (p - st.pos).Magnitude &gt; 10 then
				st.moved = true
			end
			local count = 0
			local other: InputObject? = nil
			for k in self.touches do
				count += 1
				if k ~= input then
					other = k
				end
			end
			if count == 1 then
				if not self.blockDrag then
					local d = p - prev
					self:orbit(d.X, d.Y)
				end
			elseif count &gt;= 2 and other then
				local op = self.touches[other]
				local before = (prev - op).Magnitude
				local after = (p - op).Magnitude
				if before &gt; 1 then
					self.dist = math.clamp(self.dist * before / math.max(after, 1), 4, 400)
				end
				local d = (p - prev) / 2
				self:pan(d.X, d.Y)
			end
			self.touches[input] = p
		end
	end))

	table.insert(self.conns, UserInputService.InputEnded:Connect(function(input)
		local t = input.UserInputType
		if t == Enum.UserInputType.Touch then
			local st = self.touchStart[input]
			local count = 0
			for _ in self.touches do
				count += 1
			end
			self.touches[input] = nil
			self.touchStart[input] = nil
			if st and not st.moved and count == 1 and os.clock() - st.t &lt; 0.35 and self.onTap and not self.blockDrag then
				self.onTap(st.pos)
			end
		elseif t == Enum.UserInputType.MouseButton1 then
			local md = self.mouseDown
			self.mouseDown = nil
			if md and not md.moved and os.clock() - md.t &lt; 0.5 and self.onTap and not self.blockDrag then
				self.onTap(md.pos)
			end
		elseif t == Enum.UserInputType.MouseButton2 then
			self.rmb = false
		elseif t == Enum.UserInputType.MouseButton3 then
			self.mmb = false
		end
	end))

	table.insert(self.conns, RunService.RenderStepped:Connect(function(dt)
		if not self.enabled then
			return
		end
		local move = Vector3.zero
		if not UserInputService:GetFocusedTextBox() then
			local k = UserInputService
			if k:IsKeyDown(Enum.KeyCode.W) then move += Vector3.new(0, 0, -1) end
			if k:IsKeyDown(Enum.KeyCode.S) then move += Vector3.new(0, 0, 1) end
			if k:IsKeyDown(Enum.KeyCode.A) then move += Vector3.new(-1, 0, 0) end
			if k:IsKeyDown(Enum.KeyCode.D) then move += Vector3.new(1, 0, 0) end
			if k:IsKeyDown(Enum.KeyCode.E) then move += Vector3.new(0, 1, 0) end
			if k:IsKeyDown(Enum.KeyCode.Q) then move += Vector3.new(0, -1, 0) end
		end
		move += self.padMove
		if move.Magnitude &gt; 0 then
			local rot = CFrame.Angles(0, self.yaw, 0)
			self.focus += rot:VectorToWorldSpace(move) * dt * math.max(12, self.dist * 0.8)
		end
		self:apply()
	end))
	self:apply()
	return self
end

function FreeCamera:orbit(dx: number, dy: number)
	self.yaw -= dx * 0.008
	self.pitch = math.clamp(self.pitch - dy * 0.008, math.rad(-88), math.rad(88))
end

function FreeCamera:pan(dx: number, dy: number)
	local cam = workspace.CurrentCamera
	local scale = self.dist * 0.0025
	self.focus += cam.CFrame.RightVector * (-dx * scale) + cam.CFrame.UpVector * (dy * scale)
end

function FreeCamera:apply()
	local cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Scriptable
	local rot = CFrame.Angles(0, self.yaw, 0) * CFrame.Angles(self.pitch, 0, 0)
	cam.CFrame = CFrame.new(self.focus) * rot * CFrame.new(0, 0, self.dist)
	cam.FieldOfView = 70
end

function FreeCamera:focusOn(pos: Vector3)
	self.focus = pos
end

function FreeCamera:destroy()
	for _, c in self.conns do
		c:Disconnect()
	end
end

return FreeCamera
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX0000004C">
            <Properties>
              <string name="Name">WeatherFx</string>
              <ProtectedString name="Source">--!nonstrict
-- Погода на клиенте: дождь, снег, туман, гроза. Частицы летят вокруг камеры,
-- а под крышей дождь и снег выключаются, чтобы в помещении было сухо

local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Workshop"):WaitForChild("Shared")
local Format = require(Shared.Format)

local WeatherFx = {}
WeatherFx.__index = WeatherFx

local PRESETS = {
	Clear = { rate = 0, density = 0, haze = 0, dim = 0 },
	Rain = { rate = 700, speed = NumberRange.new(70, 90), life = NumberRange.new(0.6, 0.8), size = 0.07, squash = 8, color = Color3.fromRGB(170, 190, 210), density = 0.32, haze = 1.2, dim = 0.15 },
	Snow = { rate = 260, speed = NumberRange.new(5, 9), life = NumberRange.new(5, 7), size = 0.28, squash = 0, color = Color3.fromRGB(255, 255, 255), density = 0.3, haze = 1, dim = 0.05, spread = 35 },
	Fog = { rate = 0, density = 0.62, haze = 2.6, dim = 0.1 },
	Storm = { rate = 1400, speed = NumberRange.new(90, 110), life = NumberRange.new(0.5, 0.7), size = 0.08, squash = 10, color = Color3.fromRGB(160, 175, 200), density = 0.45, haze = 1.8, dim = 0.3, lightning = true },
}

function WeatherFx.new()
	local self = setmetatable({}, WeatherFx)
	self.state = { weather = "Clear", at = 0, auto = false, minutes = 5 }
	self.current = nil
	local emitterPart = Instance.new("Part")
	emitterPart.Name = "WsWeather"
	emitterPart.Anchored = true
	emitterPart.CanCollide = false
	emitterPart.CanQuery = false
	emitterPart.CanTouch = false
	emitterPart.Transparency = 1
	emitterPart.Size = Vector3.new(90, 1, 90)
	emitterPart.Parent = workspace
	self.part = emitterPart
	local e = Instance.new("ParticleEmitter")
	e.EmissionDirection = Enum.NormalId.Bottom
	e.Rate = 0
	e.LightInfluence = 0.6
	e.Parent = emitterPart
	self.emitter = e
	self.atmosphere = Instance.new("Atmosphere")
	self.atmosphere.Density = 0
	self.atmosphere.Parent = Lighting
	self.flash = Instance.new("ColorCorrectionEffect")
	self.flash.Parent = Lighting
	self.nextFlash = 0
	self.conn = RunService.RenderStepped:Connect(function()
		self:update()
	end)
	return self
end

function WeatherFx:set(state)
	self.state = state
end

function WeatherFx:apply(name: string)
	local p = PRESETS[name] or PRESETS.Clear
	self.current = name
	self.preset = p
	local e = self.emitter
	if p.rate &gt; 0 then
		e.Speed = p.speed
		e.Lifetime = p.life
		e.Size = NumberSequence.new(p.size)
		e.Squash = NumberSequence.new(p.squash)
		e.Color = ColorSequence.new(p.color)
		e.Transparency = NumberSequence.new(0.35)
		local spread = p.spread or 4
		e.SpreadAngle = Vector2.new(spread, spread)
	end
	self.atmosphere.Density = p.density
	self.atmosphere.Haze = p.haze
	self.atmosphere.Color = Color3.fromRGB(190, 195, 205)
	self.flash.Brightness = -p.dim
	self.flash.Saturation = -p.dim
end

function WeatherFx:update()
	local s = self.state
	local name = Format.weatherAt({ auto = s.auto, minutes = s.minutes }, s.weather, s.at, workspace:GetServerTimeNow())
	if name ~= self.current then
		self:apply(name)
	end
	local p = self.preset
	local cam = workspace.CurrentCamera
	if not cam or not p then
		return
	end
	local pos = cam.CFrame.Position
	self.part.CFrame = CFrame.new(pos + Vector3.new(0, 30, 0))
	-- под крышей осадков нет
	local covered = false
	if p.rate &gt; 0 then
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		local char = game:GetService("Players").LocalPlayer.Character
		params.FilterDescendantsInstances = { self.part, char }
		covered = workspace:Raycast(pos, Vector3.new(0, 80, 0), params) ~= nil
	end
	self.emitter.Rate = if covered then 0 else p.rate
	-- молния в грозу
	if p.lightning then
		local now = os.clock()
		if now &gt;= self.nextFlash then
			self.nextFlash = now + 6 + math.random() * 9
			self.flash.Brightness = 0.6
			task.delay(0.12, function()
				self.flash.Brightness = -p.dim
			end)
		end
	end
end

function WeatherFx:destroy()
	self.conn:Disconnect()
	self.part:Destroy()
	self.atmosphere:Destroy()
	self.flash:Destroy()
end

return WeatherFx
</ProtectedString>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="RBX0000004D">
          <Properties>
            <string name="Name">Mafia</string>
          </Properties>
          <Item class="ModuleScript" referent="RBX0000004E">
            <Properties>
              <string name="Name">MafiaClient</string>
              <ProtectedString name="Source">--!nonstrict
-- Клиент «Мафии»: лобби с выбором стиля, своя роль, таймер фаз, голосования,
-- ночные действия, блокнот шерифа, переключатель чатов, панель ведущего, вид призрака

local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TextChatService = game:GetService("TextChatService")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Workshop"):WaitForChild("Shared")
local UiText = require(Shared.UiText)
local Remotes = require(Shared.Roblox.Remotes)
local MafiaSounds = require(Shared.MafiaSounds)

local Kit = require(script.Parent.Parent.UI.Kit)
local FreeCamera = require(script.Parent.Parent.Common.FreeCamera)
local WeatherFx = require(script.Parent.Parent.Common.WeatherFx)

local L, H = UiText.L, UiText.H

local MafiaClient = {}
MafiaClient.__index = MafiaClient

local player = Players.LocalPlayer

local PHASE_TITLE = {
	lobby = L.PhaseLobby, reveal = L.PhaseReveal, dusk = L.PhaseDusk, night = L.PhaseNight,
	morning = L.PhaseMorning, day = L.PhaseDay, vote = L.PhaseVote, verdict = L.PhaseVerdict, ended = L.PhaseEnded,
}
local ROLE_TITLE = { mafia = L.RoleMafia, doctor = L.RoleDoctor, sheriff = L.RoleSheriff, civilian = L.RoleCivilian }
local ROLE_HINT = { mafia = H.MafiaRoleHint, doctor = H.DoctorRoleHint, sheriff = H.SheriffRoleHint, civilian = H.CivilianRoleHint }
local ROLE_COLOR = {
	mafia = Color3.fromRGB(170, 40, 50), doctor = Color3.fromRGB(60, 160, 110),
	sheriff = Color3.fromRGB(70, 110, 200), civilian = Color3.fromRGB(110, 110, 120),
}
local CLOCK = { lobby = 14, reveal = 19, dusk = 19.5, night = 0, morning = 6.5, day = 13, vote = 16, verdict = 17.5, ended = 14 }

local function request(...)
	local ok, res = pcall(function(...)
		return Remotes.fn("MafiaRequest"):InvokeServer(...)
	end, ...)
	return if ok then res else nil
end

function MafiaClient.new(app)
	local self = setmetatable({}, MafiaClient)
	self.app = app
	self.state = {}
	self.notes = ""
	local gui = Instance.new("ScreenGui")
	gui.Name = "WsMafia"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = app.playerGui
	self.gui = gui
	self.weather = WeatherFx.new()

	-- фаза и таймер: название и время двумя строками
	self.phaseBox = Kit.frame(gui, { Size = UDim2.fromOffset(170, 52), Position = UDim2.new(0.5, -85, 0, 6), BackgroundTransparency = 0.25, BackgroundColor3 = Kit.C.bg })
	Kit.corner(self.phaseBox, 12)
	self.phaseLabel = Kit.label(self.phaseBox, "", { Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, Font = Kit.FONT_BOLD, TextSize = 16 })
	-- своя роль
	self.roleChip = Kit.button(gui, "", function()
		self:showRoleCard()
	end, { Size = UDim2.fromOffset(150, 40), Position = UDim2.new(0.5, -75, 0, 62), TextSize = 14, Visible = false })
	-- крупное объявление
	self.banner = Kit.label(gui, "", {
		Size = UDim2.new(0.8, 0, 0, 90), Position = UDim2.new(0.1, 0, 0.22, 0), TextXAlignment = Enum.TextXAlignment.Center,
		Font = Kit.FONT_BOLD, TextSize = 28, TextStrokeTransparency = 0.3, Visible = false,
	})
	-- переключатель чатов слева
	self.chatBar = Kit.frame(gui, { BackgroundTransparency = 1, Size = UDim2.fromOffset(110, 3 * (Kit.TAP + 4)), Position = UDim2.new(0, 6, 0.42, 0) })
	Kit.list(self.chatBar, 4)
	self.chatButtons = {}
	for i, ch in { { "general", L.ChatTown, "MafiaTown" }, { "mafia", L.ChatMafia, "MafiaRoom" }, { "ghost", L.ChatGhost, "GhostRoom" } } do
		self.chatButtons[ch[1]] = Kit.button(self.chatBar, ch[2], function()
			self:setChannel(ch[3], ch[1])
		end, { Size = UDim2.new(1, 0, 0, Kit.TAP), LayoutOrder = i, TextSize = 13, Visible = false, BackgroundTransparency = 0.2 })
	end
	-- нижняя панель: лобби, голосование, ночные действия
	self.sheet = Kit.frame(gui, { Size = UDim2.new(0, math.min(520, Kit.viewport().X - 24), 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Position = UDim2.new(0.5, 0, 1, -8), AnchorPoint = Vector2.new(0.5, 1), BackgroundTransparency = 0.08 })
	Kit.corner(self.sheet, 14)
	Kit.pad(self.sheet, 10)
	-- кнопки справа: блокнот шерифа и панель ведущего
	self.side = Kit.frame(gui, { BackgroundTransparency = 1, Size = UDim2.fromOffset(120, 2 * (Kit.TAP + 4)), Position = UDim2.new(1, -126, 0.42, 0) })
	Kit.list(self.side, 4)
	self.noteButton = Kit.button(self.side, L.Notebook, function()
		self:openNotebook()
	end, { Size = UDim2.new(1, 0, 0, Kit.TAP), LayoutOrder = 1, Visible = false, TextSize = 13 })
	self.hostButton = Kit.button(self.side, L.HostPanel, function()
		self:openHostPanel()
	end, { Size = UDim2.new(1, 0, 0, Kit.TAP), LayoutOrder = 2, Visible = false, TextSize = 13, BackgroundColor3 = Kit.C.accentDim })

	self.conn = Remotes.event("Mafia").OnClientEvent:Connect(function(msg)
		self:onMessage(msg)
	end)
	self.tick = RunService.Heartbeat:Connect(function()
		self:updateTimer()
	end)
	return self
end

-- ---------------------------------------------------------------------------

function MafiaClient:sound(key: string?)
	local id = key and MafiaSounds[key]
	if not id or id == "" then
		return
	end
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = 0.6
	s.Parent = SoundService
	s.Ended:Once(function()
		s:Destroy()
	end)
	s:Play()
	task.delay(15, function()
		if s.Parent then
			s:Destroy()
		end
	end)
end

function MafiaClient:announce(text: string)
	self.banner.Text = text
	self.banner.Visible = true
	local token = {}
	self.bannerToken = token
	task.delay(4, function()
		if self.bannerToken == token then
			self.banner.Visible = false
		end
	end)
	-- то же сообщение в чате как системное
	local tc = TextChatService:FindFirstChild("TextChannels")
	local town = tc and tc:FindFirstChild("MafiaTown")
	if town then
		pcall(function()
			(town :: TextChannel):DisplaySystemMessage((string.gsub(text, "\n", " ")))
		end)
	end
end

function MafiaClient:updateTimer()
	local st = self.state
	local title = PHASE_TITLE[st.phase or "lobby"] or ""
	if st.phase and st.phase ~= "lobby" and st.endsAt then
		local left = math.max(0, math.floor(st.endsAt - workspace:GetServerTimeNow()))
		self.phaseLabel.Text = string.format("%s\n%d:%02d", title, left // 60, left % 60)
	else
		self.phaseLabel.Text = title
	end
end

function MafiaClient:setChannel(name: string, key: string)
	local tc = TextChatService:FindFirstChild("TextChannels")
	local c = tc and tc:FindFirstChild(name)
	if c then
		pcall(function()
			TextChatService.ChatInputBarConfiguration.TargetTextChannel = c
		end)
	end
	self.channel = key
	for k, b in self.chatButtons do
		Kit.setActive(b, k == key)
	end
end

function MafiaClient:applyChat()
	local chat = self.state.chat or {}
	local firstSend = nil
	for key, b in self.chatButtons do
		local rights = chat[key]
		b.Visible = rights ~= nil and rights.see == true
		if rights and rights.send and not firstSend then
			firstSend = key
		end
	end
	pcall(function()
		TextChatService.ChannelTabsConfiguration.Enabled = true
	end)
	local cur = self.channel and chat[self.channel]
	if not cur or not cur.send then
		local key = firstSend or "general"
		local names = { general = "MafiaTown", mafia = "MafiaRoom", ghost = "GhostRoom" }
		self:setChannel(names[key], key)
	end
end

-- ---------------------------------------------------------------------------
-- мир: время суток, окна, погода, крыши для призраков

function MafiaClient:applyWorld()
	local st = self.state
	local clock = CLOCK[st.phase or "lobby"] or 14
	TweenService:Create(Lighting, TweenInfo.new(3), { ClockTime = clock }):Play()
	local village = workspace:FindFirstChild("MafiaVillage")
	local night = clock &lt; 6 or clock &gt; 18.5
	if village then
		for _, d in village:GetDescendants() do
			if d:IsA("BasePart") and d:GetAttribute("NightGlow") then
				d.Material = if night then Enum.Material.Neon else Enum.Material.Glass
			end
		end
	end
	local ghost = st.role ~= nil and st.alive == false or (st.alive == false and st.phase ~= "lobby")
	-- призракам крыши прозрачны, чтобы видеть всё сверху
	if village then
		for _, d in village:GetDescendants() do
			if d:IsA("BasePart") and d:GetAttribute("Roof") then
				d.LocalTransparencyModifier = if ghost then 0.85 else 0
			end
		end
	end
	if ghost and not self.ghostCam and self.world then
		self.ghostCam = FreeCamera.new(self.world.center + Vector3.new(0, 4, 0))
		self.ghostCam.dist = 150
		self.ghostCam.pitch = math.rad(-62)
	elseif not ghost and self.ghostCam then
		self.ghostCam:destroy()
		self.ghostCam = nil
		workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
	end
	if self.world then
		self.weather:set({ weather = self.world.weather or "Clear", at = 0, auto = false, minutes = 5 })
		-- фоновый звук сезона, если указан в MafiaSounds
		local style = self.world.style or "spring"
		local id = MafiaSounds["ambient" .. string.upper(string.sub(style, 1, 1)) .. string.sub(style, 2)]
		if self.ambientStyle ~= style then
			self.ambientStyle = style
			if self.ambient then
				self.ambient:Destroy()
				self.ambient = nil
			end
			if id and id ~= "" then
				local s = Instance.new("Sound")
				s.SoundId = id
				s.Looped = true
				s.Volume = 0.35
				s.Parent = SoundService
				s:Play()
				self.ambient = s
			end
		end
	end
end

-- ---------------------------------------------------------------------------
-- сообщения сервера

function MafiaClient:onMessage(msg)
	local t = msg.type
	if t == "state" then
		local prevRole = self.state.role
		self.state = msg
		self.roleChip.Visible = msg.role ~= nil or msg.youHost
		if msg.youHost then
			self.roleChip.Text = L.RoleHost
			self.roleChip.BackgroundColor3 = Kit.C.accentDim
		elseif msg.role then
			self.roleChip.Text = if msg.alive then ROLE_TITLE[msg.role] else L.RoleGhost
			self.roleChip.BackgroundColor3 = if msg.alive then ROLE_COLOR[msg.role] else Kit.C.panel2
		end
		self.noteButton.Visible = msg.role == "sheriff"
		self.hostButton.Visible = msg.youHost == true or (msg.hostId == nil and msg.creator == true and msg.phase ~= "lobby")
		if not self.hostButton.Visible and self.hostPanel then
			self.hostPanel:Destroy()
			self.hostPanel = nil
		end
		if msg.role and msg.role ~= prevRole then
			self:showRoleCard()
		end
		self:applyChat()
		self:applyWorld()
		self:renderSheet()
		if self.hostPanel then
			self:openHostPanel(true)
		end
	elseif t == "phase" then
		self.state.phase = msg.phase
		self.state.endsAt = msg.endsAt
		if msg.world then
			self.world = msg.world
		end
		if msg.phase == "night" then
			self:announce(H.NightSilenceHint)
		end
		self:applyWorld()
		self:renderSheet()
	elseif t == "announce" then
		self:announce(msg.text)
		self:sound(msg.sound)
	elseif t == "sound" then
		self:sound(msg.sound)
	elseif t == "ghost" then
		self:announce(H.GhostHint)
	elseif t == "joined" then
		self:sound("join")
	end
end

-- ---------------------------------------------------------------------------
-- карточка роли

function MafiaClient:showRoleCard()
	local st = self.state
	if self.card then
		self.card:Destroy()
	end
	local role = st.role
	local title = if st.youHost then L.RoleHost elseif role then ROLE_TITLE[role] else nil
	if not title then
		return
	end
	local hint = if st.youHost then H.HostRoleHint else ROLE_HINT[role]
	local w = math.min(360, Kit.viewport().X - 32)
	local card = Kit.frame(self.gui, { Size = UDim2.fromOffset(w, 0), AutomaticSize = Enum.AutomaticSize.Y, Position = UDim2.new(0.5, -w / 2, 0.2, 0), BackgroundColor3 = if role then ROLE_COLOR[role] else Kit.C.accentDim, ZIndex = 40 })
	Kit.corner(card, 16)
	Kit.pad(card, 16)
	Kit.list(card, 8)
	Kit.label(card, title, { Font = Kit.FONT_BOLD, TextSize = 30, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 40), ZIndex = 41, LayoutOrder = 1 })
	Kit.label(card, hint or "", { TextSize = 16, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, ZIndex = 41, LayoutOrder = 2 })
	if st.house then
		Kit.label(card, string.format(L.YourHouse, st.house), { TextSize = 15, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 41, LayoutOrder = 3 })
	end
	if role == "mafia" and st.mafiaTeam then
		local names = {}
		for _, p in st.players or {} do
			if table.find(st.mafiaTeam, p.userId) and p.userId ~= player.UserId then
				table.insert(names, p.name)
			end
		end
		if #names &gt; 0 then
			Kit.label(card, table.concat(names, ", "), { TextSize = 15, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 41, LayoutOrder = 4 })
		end
	end
	Kit.button(card, L.GotIt, function()
		card:Destroy()
		self.card = nil
	end, { ZIndex = 42, LayoutOrder = 10, BackgroundColor3 = Kit.C.bg })
	self.card = card
end

-- ---------------------------------------------------------------------------
-- нижняя панель по фазе

local function clear(f: Instance)
	for _, c in f:GetChildren() do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
end

function MafiaClient:playerGrid(order: number, filter, onPick, marked, labelOf)
	local grid = Kit.frame(self.sheet, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order })
	local g = Instance.new("UIGridLayout")
	g.CellSize = UDim2.new(0.5, -4, 0, Kit.TAP)
	g.CellPadding = UDim2.fromOffset(6, 6)
	g.SortOrder = Enum.SortOrder.LayoutOrder
	g.Parent = grid
	for i, p in self.state.players or {} do
		if filter(p) then
			local b = Kit.button(grid, if labelOf then labelOf(p) else p.name, function()
				self:sound("click")
				onPick(p)
			end, { LayoutOrder = i, TextSize = 14 })
			if marked and marked(p) then
				Kit.setActive(b, true)
			end
		end
	end
	return grid
end

function MafiaClient:renderSheet()
	local st = self.state
	clear(self.sheet)
	Kit.list(self.sheet, 8)
	local phase = st.phase
	self.sheet.Visible = true
	if phase == "lobby" then
		self:renderLobby()
		return
	end
	local me = nil
	for _, p in st.players or {} do
		if p.userId == player.UserId then
			me = p
		end
	end
	if phase == "ended" then
		Kit.label(self.sheet, L.AllRoles, { Font = Kit.FONT_BOLD, LayoutOrder = 1 })
		for i, p in st.players or {} do
			Kit.label(self.sheet, p.name .. "   " .. (ROLE_TITLE[p.role] or ""), { TextSize = 14, LayoutOrder = 1 + i, TextColor3 = ROLE_COLOR[p.role] or Kit.C.text })
		end
		return
	end
	if not st.alive or not st.role then
		self.sheet.Visible = false
		return
	end
	if phase == "vote" then
		Kit.label(self.sheet, L.ChooseExile, { Font = Kit.FONT_BOLD, LayoutOrder = 1 })
		local tally = st.tally or {}
		self:playerGrid(2, function(p)
			return p.alive
		end, function(p)
			request("Vote", p.userId)
		end, function(p)
			return st.vote == p.userId
		end, function(p)
			local n = tally[tostring(p.userId)]
			return if n then p.name .. "   " .. tostring(n) else p.name
		end)
		local skip = Kit.button(self.sheet, L.VoteSkip .. (if tally.skip then "   " .. tally.skip else ""), function()
			request("Vote", "skip")
		end, { LayoutOrder = 3 })
		Kit.setActive(skip, st.vote == "skip")
	elseif phase == "night" then
		local role = st.role
		if role == "mafia" then
			Kit.label(self.sheet, L.ChooseVictim, { Font = Kit.FONT_BOLD, LayoutOrder = 1 })
			local myPick = st.mafiaVotes and st.mafiaVotes[tostring(player.UserId)]
			self:playerGrid(2, function(p)
				return p.alive and not table.find(st.mafiaTeam or {}, p.userId)
			end, function(p)
				request("Night", p.userId)
			end, function(p)
				return myPick == p.userId
			end)
			-- выбор остальных мафиози, чтобы договориться
			local byId = {}
			for _, p in st.players do
				byId[tostring(p.userId)] = p.name
			end
			local order = 3
			for voter, target in st.mafiaVotes or {} do
				order += 1
				Kit.label(self.sheet, string.format(L.MafiaVotesFormat, byId[voter] or "?", byId[tostring(target)] or "?"), { TextSize = 13, TextColor3 = Kit.C.dim, LayoutOrder = order })
			end
		elseif role == "doctor" then
			Kit.label(self.sheet, L.ChooseHeal, { Font = Kit.FONT_BOLD, LayoutOrder = 1 })
			self:playerGrid(2, function(p)
				return p.alive and p.userId ~= st.lastHeal
			end, function(p)
				request("Night", p.userId)
			end, function(p)
				return st.heal == p.userId
			end)
		elseif role == "sheriff" then
			Kit.label(self.sheet, L.ChooseCheck, { Font = Kit.FONT_BOLD, LayoutOrder = 1 })
			local checked = false
			for _, c in st.checks or {} do
				if c.round == st.round then
					checked = true
					Kit.label(self.sheet, string.format(if c.mafia then L.IsMafia else L.NotMafia, c.name), { Font = Kit.FONT_BOLD, TextSize = 18, LayoutOrder = 3, Size = UDim2.new(1, 0, 0, 48), TextColor3 = if c.mafia then Kit.C.bad else Kit.C.good })
				end
			end
			if not checked then
				self:playerGrid(2, function(p)
					return p.alive and p.userId ~= player.UserId
				end, function(p)
					request("Night", p.userId)
				end)
			end
		else
			self.sheet.Visible = false
		end
	else
		self.sheet.Visible = false
	end
	local _ = me
end

function MafiaClient:renderLobby()
	local st = self.state
	local s = st.settings or {}
	local n = #(st.players or {})
	local order = 0
	local function o()
		order += 1
		return order
	end
	Kit.label(self.sheet, string.format(L.PlayersFormat, n), { Font = Kit.FONT_BOLD, LayoutOrder = o() })
	local hostName = nil
	for _, p in Players:GetPlayers() do
		if p.UserId == st.hostId then
			hostName = p.DisplayName
		end
	end
	Kit.label(self.sheet, if hostName then string.format(L.HostFormat, hostName) else L.NoHost, { TextSize = 14, TextColor3 = Kit.C.dim, LayoutOrder = o(), Size = UDim2.new(1, 0, 0, 40) })
	Kit.button(self.sheet, if st.youHost then L.StopHosting else L.BecomeHost, function()
		request("BecomeHost", not st.youHost)
	end, { LayoutOrder = o(), Visible = st.youHost or st.hostId == nil or st.creator })
	if st.canStart then
		-- стиль деревни
		local row = Kit.frame(self.sheet, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, Kit.TAP), LayoutOrder = o() })
		Kit.list(row, 4, true)
		for i, sty in { { "summer", L.StyleSummer }, { "spring", L.StyleSpring }, { "autumn", L.StyleAutumn }, { "winter", L.StyleWinter } } do
			local b = Kit.button(row, sty[2], function()
				request("Settings", { style = sty[1], theme = "plain", auto = s.auto, counts = s.counts })
			end, { Size = UDim2.new(0.25, -3, 1, 0), LayoutOrder = i, TextSize = 14 })
			Kit.setActive(b, s.style == sty[1])
		end
		local themes = ({
			summer = {},
			spring = { { "april", L.ThemeApril } },
			autumn = { { "halloween", L.ThemeHalloween } },
			winter = { { "newyear", L.ThemeNewYear } },
		})[s.style or "spring"] or {}
		if #themes &gt; 0 then
			local trow = Kit.frame(self.sheet, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, Kit.TAP), LayoutOrder = o() })
			Kit.list(trow, 4, true)
			local plain = Kit.button(trow, L.ThemePlain, function()
				request("Settings", { style = s.style, theme = "plain", auto = s.auto, counts = s.counts })
			end, { Size = UDim2.new(0.5, -2, 1, 0), LayoutOrder = 1, TextSize = 14 })
			Kit.setActive(plain, s.theme == "plain")
			for i, th in themes do
				local b = Kit.button(trow, th[2], function()
					request("Settings", { style = s.style, theme = th[1], auto = s.auto, counts = s.counts })
				end, { Size = UDim2.new(0.5, -2, 1, 0), LayoutOrder = 1 + i, TextSize = 14 })
				Kit.setActive(b, s.theme == th[1])
			end
		end
		-- роли: сами или вручную
		local rrow = Kit.frame(self.sheet, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, Kit.TAP), LayoutOrder = o() })
		Kit.list(rrow, 4, true)
		local auto = Kit.button(rrow, L.RolesAuto, function()
			request("Settings", { style = s.style, theme = s.theme, auto = true, counts = s.counts })
		end, { Size = UDim2.new(0.5, -2, 1, 0), LayoutOrder = 1, TextSize = 14 })
		local manual = Kit.button(rrow, L.RolesManual, function()
			request("Settings", { style = s.style, theme = s.theme, auto = false, counts = s.counts })
		end, { Size = UDim2.new(0.5, -2, 1, 0), LayoutOrder = 2, TextSize = 14 })
		Kit.setActive(auto, s.auto ~= false)
		Kit.setActive(manual, s.auto == false)
		if s.auto == false then
			for _, k in { { "mafia", L.CountMafia, 1, 6 }, { "doctor", L.CountDoctor, 1, 3 }, { "sheriff", L.CountSheriff, 1, 3 } } do
				Kit.stepper(self.sheet, k[2], (s.counts or {})[k[1]] or k[3], 1, k[3], k[4], function(v)
					local c = table.clone(s.counts or {})
					c[k[1]] = v
					request("Settings", { style = s.style, theme = s.theme, auto = false, counts = c })
				end, o())
			end
		end
		Kit.button(self.sheet, L.StartGame, function()
			local res = request("Start")
			if res and not res.ok then
				Kit.toast(self.gui, if res.error == "few" then H.FewPlayersHint else tostring(res.error), Kit.C.bad)
			end
		end, { LayoutOrder = o(), BackgroundColor3 = Kit.C.accent, Font = Kit.FONT_BOLD })
	end
	if not (self.app.mode and self.app.mode.showcase and self.app.mode.showcase.code == "MAFIA" and not self.app.mode.creator) then
		Kit.button(self.sheet, L.LeaveMafia, function()
			request("Leave")
			self.app:leaveMafia()
		end, { LayoutOrder = o(), BackgroundColor3 = Kit.C.panel2 })
	end
end

-- ---------------------------------------------------------------------------
-- блокнот шерифа: только у себя на устройстве

function MafiaClient:openNotebook()
	if self.notebook then
		self.notebook:Destroy()
		self.notebook = nil
		return
	end
	local w = math.min(380, Kit.viewport().X - 24)
	local box = Kit.frame(self.gui, { Size = UDim2.fromOffset(w, 320), Position = UDim2.new(0.5, -w / 2, 0.15, 0), ZIndex = 30 })
	Kit.corner(box, 12)
	Kit.pad(box, 10)
	Kit.label(box, L.Notebook, { Font = Kit.FONT_BOLD, ZIndex = 31, Size = UDim2.new(1, -50, 0, 28) })
	Kit.button(box, "✕", function()
		box:Destroy()
		self.notebook = nil
	end, { Size = UDim2.fromOffset(40, 32), Position = UDim2.new(1, -40, 0, -2), ZIndex = 31 })
	local history = {}
	for _, c in self.state.checks or {} do
		table.insert(history, (string.gsub(string.format(if c.mafia then L.IsMafia else L.NotMafia, c.name), "\n", " — ")))
	end
	local t = Kit.textbox(box, self.notes, "…", function(text)
		self.notes = text
	end, { MultiLine = true, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, Position = UDim2.fromOffset(0, 34), Size = UDim2.new(1, 0, 1, -34 - (#history &gt; 0 and 60 or 0)), ZIndex = 31 })
	t:GetPropertyChangedSignal("Text"):Connect(function()
		self.notes = t.Text
	end)
	if #history &gt; 0 then
		Kit.label(box, table.concat(history, "\n"), { Position = UDim2.new(0, 0, 1, -56), Size = UDim2.new(1, 0, 0, 56), TextSize = 13, ZIndex = 31, TextColor3 = Kit.C.dim })
	end
	self.notebook = box
end

-- ---------------------------------------------------------------------------
-- панель ведущего

function MafiaClient:openHostPanel(refresh: boolean?)
	if self.hostPanel then
		self.hostPanel:Destroy()
		self.hostPanel = nil
		if not refresh then
			return
		end
	elseif refresh then
		return
	end
	local st = self.state
	local w = math.min(420, Kit.viewport().X - 24)
	local box = Kit.frame(self.gui, { Size = UDim2.fromOffset(w, math.min(460, Kit.viewport().Y - 140)), Position = UDim2.new(1, -w - 12, 0, 110), ZIndex = 30 })
	Kit.corner(box, 12)
	Kit.pad(box, 10)
	Kit.label(box, L.HostPanel, { Font = Kit.FONT_BOLD, ZIndex = 31, Size = UDim2.new(1, -50, 0, 28) })
	Kit.button(box, "✕", function()
		box:Destroy()
		self.hostPanel = nil
	end, { Size = UDim2.fromOffset(40, 32), Position = UDim2.new(1, -40, 0, -2), ZIndex = 31 })
	local list = Kit.scroll(box, { Position = UDim2.fromOffset(0, 34), Size = UDim2.new(1, 0, 1, -34), ZIndex = 31 })
	Kit.list(list, 6)
	local row = Kit.frame(list, { BackgroundTransparency = 1, Size = UDim2.new(1, -6, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, ZIndex = 31 })
	local g = Instance.new("UIGridLayout")
	g.CellSize = UDim2.new(0.5, -4, 0, Kit.TAP)
	g.CellPadding = UDim2.fromOffset(6, 6)
	g.Parent = row
	for _, a in { { "next", L.HostNext }, { "more", L.HostMore }, { "home", L.HostHome }, { "table", L.HostTable } } do
		Kit.button(row, a[2], function()
			request("Host", a[1])
		end, { ZIndex = 32, TextSize = 14 })
	end
	local roles = st.allRoles or {}
	for i, p in st.players or {} do
		local card = Kit.frame(list, { BackgroundColor3 = Kit.C.panel2, Size = UDim2.new(1, -6, 0, Kit.TAP * 2 + 14), LayoutOrder = 10 + i, ZIndex = 31 })
		Kit.corner(card, 8)
		Kit.pad(card, 4)
		local role = roles[tostring(p.userId)]
		Kit.label(card, p.name .. "   " .. (if role then ROLE_TITLE[role] else "") .. (if p.alive then "" else "   " .. L.RoleGhost), { Size = UDim2.new(1, 0, 0, Kit.TAP), ZIndex = 32, TextSize = 14, TextColor3 = if role then ROLE_COLOR[role]:Lerp(Color3.new(1, 1, 1), 0.35) else Kit.C.text })
		local br = Kit.frame(card, { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, Kit.TAP + 4), Size = UDim2.new(1, 0, 0, Kit.TAP), ZIndex = 32 })
		Kit.list(br, 4, true)
		for j, a in { { "toss", L.HostToss }, { "bring", L.HostBring }, { "sendHome", L.HostSendHome } } do
			Kit.button(br, a[2], function()
				request("Host", a[1], p.userId)
			end, { Size = UDim2.new(1 / 3, -3, 1, 0), LayoutOrder = j, ZIndex = 33, TextSize = 13 })
		end
	end
	self.hostPanel = box
end

function MafiaClient:destroy()
	self.conn:Disconnect()
	self.tick:Disconnect()
	self.weather:destroy()
	if self.ambient then
		self.ambient:Destroy()
	end
	if self.ghostCam then
		self.ghostCam:destroy()
	end
	workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
	self.gui:Destroy()
	pcall(function()
		TextChatService.ChatInputBarConfiguration.TargetTextChannel = nil
	end)
end

return MafiaClient
</ProtectedString>
