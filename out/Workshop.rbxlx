      <Item class="Script" referent="RBX00000017">
        <Properties>
          <string name="Name">Main</string>
          <ProtectedString name="Source">--!nonstrict
-- Точка входа сервера «The Labyrinth»

local Players = game:GetService("Players")
local Remotes = require(game:GetService("ReplicatedStorage").Workshop.Shared.Roblox.Remotes)
local Access = require(script.Parent.Access)
local G = require(script.Parent.Game.Game)
local Admin = require(script.Parent.Game.Admin)

-- сеть создаётся до всего остального, чтобы клиенты могли подключиться сразу
Remotes.event("Game")
G.init()
Admin.init()

Players.PlayerRemoving:Connect(function(p)
	Access.forget(p)
end)
</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="Folder" referent="RBX00000018">
        <Properties>
          <string name="Name">World</string>
        </Properties>
        <Item class="ModuleScript" referent="RBX00000019">
          <Properties>
            <string name="Name">Props</string>
            <ProtectedString name="Source">--!nonstrict
-- Простые модели лабиринта-отеля: стены с проёмами, двери с номером, шкафы, кровати,
-- комоды, столы, лампы, картины, растения, лифт, генераторы. Все размеры в studs

local CollectionService = game:GetService("CollectionService")
local M = require(game:GetService("ReplicatedStorage").Workshop.Shared.Materials)

local Props = {}

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end
Props.rgb = rgb

Props.WOOD = rgb(110, 76, 50)
Props.WOOD_DARK = rgb(70, 46, 32)
Props.BRASS = rgb(196, 160, 90)
Props.IRON = rgb(60, 60, 64)

local function P(parent, name, size: Vector3, cf: CFrame, color, mat, extra)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = mat or M.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if extra then
		for k, v in extra do
			(p :: any)[k] = v
		end
	end
	p.Parent = parent
	return p
end
Props.P = P

-- без столкновений (мелкие детали)
local function nc(extra)
	local t = { CanCollide = false, CanQuery = false, CastShadow = false }
	if extra then
		for k, v in extra do
			t[k] = v
		end
	end
	return t
end
Props.nc = nc

local function model(parent, name)
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end
Props.model = model

local function light(part, range, brightness, color)
	local l = Instance.new("PointLight")
	l.Range = range
	l.Brightness = brightness
	l.Color = color or rgb(255, 214, 160)
	l.Shadows = true
	l.Parent = part
	return l
end
Props.light = light

-- кнопка взаимодействия; подпись ставит клиент по атрибуту Kind
function Props.prompt(part: Instance, kind: string, hold: number?, dist: number?)
	local pr = Instance.new("ProximityPrompt")
	pr.Name = kind
	pr.ActionText = ""
	pr.ObjectText = ""
	pr.HoldDuration = hold or 0
	pr.MaxActivationDistance = dist or 8
	pr.RequiresLineOfSight = false
	pr:SetAttribute("Kind", kind)
	pr.Parent = part
	return pr
end

-- Стена вдоль оси X локального кадра cf (cf — середина стены на полу, LookVector в комнату)
-- с проёмами holes = { { x = центр, w = ширина, h = высота } }
function Props.wall(parent, cf: CFrame, length: number, height: number, thick: number, holes, color, mat)
	table.sort(holes, function(a, b)
		return a.x &lt; b.x
	end)
	local x = -length / 2
	local function seg(x0, x1, y0, y1)
		if x1 - x0 &gt; 0.05 and y1 - y0 &gt; 0.05 then
			P(parent, "Wall", Vector3.new(x1 - x0, y1 - y0, thick), cf * CFrame.new((x0 + x1) / 2, (y0 + y1) / 2, 0), color, mat)
		end
	end
	for _, h in holes do
		seg(x, h.x - h.w / 2, 0, height)
		seg(h.x - h.w / 2, h.x + h.w / 2, h.h, height)
		x = h.x + h.w / 2
	end
	seg(x, length / 2, 0, height)
end

-- Дверь: рама, створка на петлях, табличка с номером. cf — середина проёма на полу,
-- LookVector — в следующую комнату. Возвращает модель, створку и кнопку
function Props.door(parent, cf: CFrame, number: number?, locked: boolean?)
	local m = model(parent, "Door")
	local w, h = 5, 9
	local frame = Props.WOOD_DARK
	P(m, "Jamb", Vector3.new(0.6, h + 0.6, 1.2), cf * CFrame.new(-w / 2 - 0.3, (h + 0.6) / 2, 0), frame, M.Wood)
	P(m, "Jamb", Vector3.new(0.6, h + 0.6, 1.2), cf * CFrame.new(w / 2 + 0.3, (h + 0.6) / 2, 0), frame, M.Wood)
	P(m, "Head", Vector3.new(w + 1.2, 0.6, 1.2), cf * CFrame.new(0, h + 0.3, 0), frame, M.Wood)
	local leaf = model(m, "Leaf")
	local slab = P(leaf, "Slab", Vector3.new(w - 0.1, h - 0.05, 0.3), cf * CFrame.new(0, h / 2, 0), Props.WOOD, M.WoodPlanks)
	for _, y in { 2.6, 6.4 } do
		P(leaf, "Panel", Vector3.new(w - 1.4, 2.6, 0.1), cf * CFrame.new(0, y, 0.18), Props.WOOD_DARK, M.Wood, nc())
		P(leaf, "Panel", Vector3.new(w - 1.4, 2.6, 0.1), cf * CFrame.new(0, y, -0.18), Props.WOOD_DARK, M.Wood, nc())
	end
	local knob = P(leaf, "Knob", Vector3.new(0.35, 0.35, 0.9), cf * CFrame.new(w / 2 - 0.6, 4.3, 0), Props.BRASS, M.Metal, nc({ Shape = Enum.PartType.Ball }))
	local _ = knob
	leaf.WorldPivot = cf * CFrame.new(-w / 2, 0, 0)
	if number then
		-- латунная табличка с номером со стороны входа
		local plate = P(m, "NumberPlate", Vector3.new(2.2, 1, 0.1), cf * CFrame.new(0, h + 1.4, 0.65), Props.BRASS, M.Metal, nc())
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Back
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 60
		gui.Parent = plate
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Size = UDim2.fromScale(1, 1)
		t.Font = Enum.Font.Antique
		t.TextScaled = true
		t.TextColor3 = rgb(40, 28, 16)
		t.Text = string.format("%04d", number)
		t.Parent = gui
	end
	local lock
	if locked then
		lock = model(m, "Padlock")
		P(lock, "Body", Vector3.new(0.9, 1, 0.4), cf * CFrame.new(w / 2 - 0.7, 3.4, 0.5), rgb(150, 140, 120), M.Metal, nc())
		P(lock, "Shackle", Vector3.new(0.6, 0.6, 0.15), cf * CFrame.new(w / 2 - 0.7, 4.1, 0.5), rgb(120, 120, 126), M.Metal, nc())
	end
	-- кнопка открытия по середине проёма
	local trig = P(m, "Trigger", Vector3.new(1, 1, 1), cf * CFrame.new(0, 4, 0), rgb(0, 0, 0), M.SmoothPlastic, nc({ Transparency = 1 }))
	local pr = Props.prompt(trig, "door", 0.5, 9)
	CollectionService:AddTag(m, "LabDoor")
	return m, leaf, pr, slab
end

-- Шкаф для пряток. cf — у стены, LookVector в комнату
function Props.closet(parent, cf: CFrame)
	local m = model(parent, "Closet")
	local w, d, h = 4.4, 3, 8.6
	local body = P(m, "Body", Vector3.new(w, h, d), cf * CFrame.new(0, h / 2, -d / 2), Props.WOOD_DARK, M.Wood, { CanCollide = false })
	-- стенки с полостью внутри, чтобы игрок помещался
	P(m, "Back", Vector3.new(w, h, 0.3), cf * CFrame.new(0, h / 2, -0.15), Props.WOOD_DARK, M.Wood)
	for _, s in { -1, 1 } do
		P(m, "Side", Vector3.new(0.3, h, d), cf * CFrame.new(s * (w / 2 - 0.15), h / 2, -d / 2), Props.WOOD_DARK, M.Wood)
		P(m, "DoorLeaf", Vector3.new(w / 2 - 0.2, h - 0.8, 0.2), cf * CFrame.new(s * (w / 4), h / 2, -d + 0.1), Props.WOOD, M.Wood)
		P(m, "Handle", Vector3.new(0.15, 0.8, 0.15), cf * CFrame.new(s * 0.35, h / 2, -d - 0.05), Props.BRASS, M.Metal, nc())
	end
	P(m, "Top", Vector3.new(w + 0.3, 0.4, d + 0.15), cf * CFrame.new(0, h + 0.2, -d / 2 - 0.075), Props.WOOD_DARK, M.Wood)
	P(m, "Base", Vector3.new(w, 0.5, d), cf * CFrame.new(0, 0.25, -d / 2), Props.WOOD_DARK, M.Wood)
	-- щель между дверцами светится изнутри чуть-чуть
	P(m, "Gap", Vector3.new(0.1, h - 1.2, 0.05), cf * CFrame.new(0, h / 2, -d - 0.01), rgb(10, 8, 6), M.SmoothPlastic, nc())
	body.Transparency = 1
	Props.prompt(body, "hide", 0.3, 7)
	CollectionService:AddTag(body, "Closet")
	return m, body
end

-- Комод с ящиком для обыска
function Props.dresser(parent, cf: CFrame)
	local m = model(parent, "Dresser")
	local body = P(m, "Body", Vector3.new(4.6, 3.2, 1.8), cf * CFrame.new(0, 1.7, -0.9), Props.WOOD, M.Wood)
	P(m, "Top", Vector3.new(4.9, 0.2, 2), cf * CFrame.new(0, 3.4, -1), Props.WOOD_DARK, M.Wood)
	for k = 0, 1 do
		P(m, "Drawer", Vector3.new(4, 1.1, 0.1), cf * CFrame.new(0, 1.1 + k * 1.3, -1.85), Props.WOOD_DARK, M.Wood, nc())
		P(m, "Pull", Vector3.new(0.6, 0.15, 0.15), cf * CFrame.new(0, 1.1 + k * 1.3, -1.95), Props.BRASS, M.Metal, nc())
	end
	Props.prompt(body, "search", 0.6, 7)
	return m, body
end

function Props.bed(parent, cf: CFrame, color: Color3)
	local m = model(parent, "Bed")
	P(m, "Frame", Vector3.new(5, 1.4, 8), cf * CFrame.new(0, 0.9, -4), Props.WOOD_DARK, M.Wood)
	P(m, "Mattress", Vector3.new(4.6, 0.7, 7.6), cf * CFrame.new(0, 1.9, -4), rgb(220, 214, 200), M.SmoothPlastic)
	P(m, "Blanket", Vector3.new(4.8, 0.3, 5), cf * CFrame.new(0, 2.35, -5.2), color, M.Fabric)
	P(m, "Pillow", Vector3.new(3.2, 0.6, 1.4), cf * CFrame.new(0, 2.5, -1.1), rgb(236, 232, 224), M.SmoothPlastic, nc())
	P(m, "Headboard", Vector3.new(5, 3.6, 0.4), cf * CFrame.new(0, 1.8, -0.2), Props.WOOD_DARK, M.Wood)
	return m
end

function Props.table(parent, cf: CFrame, w: number, d: number)
	local m = model(parent, "Table")
	P(m, "Top", Vector3.new(w, 0.3, d), cf * CFrame.new(0, 3, 0), Props.WOOD, M.Wood)
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			P(m, "Leg", Vector3.new(0.3, 2.85, 0.3), cf * CFrame.new(sx * (w / 2 - 0.4), 1.43, sz * (d / 2 - 0.4)), Props.WOOD_DARK, M.Wood)
		end
	end
	return m
end

function Props.chair(parent, cf: CFrame)
	local m = model(parent, "Chair")
	P(m, "Seat", Vector3.new(1.8, 0.25, 1.8), cf * CFrame.new(0, 1.8, 0), Props.WOOD, M.Wood)
	P(m, "Back", Vector3.new(1.8, 2.2, 0.2), cf * CFrame.new(0, 3, 0.8), Props.WOOD, M.Wood)
	for _, sx in { -0.75, 0.75 } do
		for _, sz in { -0.75, 0.75 } do
			P(m, "Leg", Vector3.new(0.2, 1.7, 0.2), cf * CFrame.new(sx, 0.85, sz), Props.WOOD_DARK, M.Wood, nc())
		end
	end
	return m
end

-- Настольная или напольная лампа с абажуром; возвращает абажур со светом
function Props.lamp(parent, pos: Vector3, tall: boolean?)
	local m = model(parent, "Lamp")
	local h = if tall then 6 else 1.8
	P(m, "Base", Vector3.new(1, 0.2, 1), CFrame.new(pos + Vector3.new(0, 0.1, 0)), Props.BRASS, M.Metal, nc())
	P(m, "Stem", Vector3.new(0.2, h, 0.2), CFrame.new(pos + Vector3.new(0, h / 2, 0)), Props.BRASS, M.Metal, nc())
	local shade = P(m, "Shade", Vector3.new(1.6, 1.2, 1.6), CFrame.new(pos + Vector3.new(0, h + 0.5, 0)), rgb(240, 214, 160), M.Neon, nc({ Transparency = 0.2 }))
	light(shade, 18, 1.1)
	CollectionService:AddTag(shade, "LabLight")
	return m, shade
end

-- Люстра на потолке. pos — точка крепления под потолком
function Props.ceilingLight(parent, pos: Vector3)
	local m = model(parent, "CeilingLight")
	P(m, "Rod", Vector3.new(0.15, 1.6, 0.15), CFrame.new(pos - Vector3.new(0, 0.8, 0)), Props.IRON, M.Metal, nc())
	local bulb = P(m, "Bulb", Vector3.new(1.6, 0.8, 1.6), CFrame.new(pos - Vector3.new(0, 1.9, 0)), rgb(255, 226, 180), M.Neon, nc())
	P(m, "Rim", Vector3.new(2.2, 0.2, 2.2), CFrame.new(pos - Vector3.new(0, 1.5, 0)), Props.BRASS, M.Metal, nc())
	light(bulb, 26, 1.2)
	CollectionService:AddTag(bulb, "LabLight")
	return m, bulb
end

function Props.painting(parent, cf: CFrame, w: number, h: number, seed: number)
	local m = model(parent, "Painting")
	P(m, "Frame", Vector3.new(w + 0.5, h + 0.5, 0.2), cf, Props.BRASS:Lerp(rgb(0, 0, 0), 0.3), M.Wood, nc())
	local hue = (seed * 0.137) % 1
	P(m, "Canvas", Vector3.new(w, h, 0.05), cf * CFrame.new(0, 0, -0.12), Color3.fromHSV(hue, 0.35, 0.35), M.SmoothPlastic, nc())
	P(m, "Shape", Vector3.new(w * 0.4, h * 0.4, 0.05), cf * CFrame.new(((seed % 3) - 1) * w * 0.2, 0, -0.15), Color3.fromHSV((hue + 0.5) % 1, 0.3, 0.5), M.SmoothPlastic, nc())
	return m
end

function Props.plantPot(parent, cf: CFrame)
	local m = model(parent, "PlantPot")
	P(m, "Pot", Vector3.new(1.6, 1.6, 1.6), cf * CFrame.new(0, 0.8, 0), rgb(150, 80, 56), M.Brick)
	for k = 0, 4 do
		local a = k / 5 * math.pi * 2
		P(m, "Leaf", Vector3.new(0.5, 2.6, 0.12), cf * CFrame.new(math.cos(a) * 0.5, 2.6, math.sin(a) * 0.5) * CFrame.Angles(math.sin(a) * 0.4, 0, math.cos(a) * 0.4), rgb(60, 120, 60), M.Grass, nc())
	end
	return m
end

function Props.shelf(parent, cf: CFrame, seed: number)
	local m = model(parent, "Shelf")
	P(m, "Back", Vector3.new(6, 8, 0.3), cf * CFrame.new(0, 4, -0.15), Props.WOOD_DARK, M.Wood)
	for _, s in { -1, 1 } do
		P(m, "Side", Vector3.new(0.3, 8, 1.8), cf * CFrame.new(s * 2.85, 4, -0.9), Props.WOOD_DARK, M.Wood)
	end
	for r = 0, 3 do
		P(m, "Board", Vector3.new(5.4, 0.2, 1.6), cf * CFrame.new(0, 0.3 + r * 2.4, -0.9), Props.WOOD, M.Wood)
		if r &lt; 3 then
			for b = 0, 2 do
				P(m, "Books", Vector3.new(1.5, 1.6, 1.2), cf * CFrame.new(-1.8 + b * 1.8, 1.2 + r * 2.4, -0.9), Color3.fromHSV(((seed + r * 3 + b) * 0.21) % 1, 0.45, 0.4), M.SmoothPlastic, nc())
			end
		end
	end
	return m
end

function Props.desk(parent, cf: CFrame)
	local m = model(parent, "Desk")
	P(m, "Top", Vector3.new(5, 0.3, 2.6), cf * CFrame.new(0, 3, -1.3), Props.WOOD, M.Wood)
	for _, s in { -1, 1 } do
		P(m, "Pedestal", Vector3.new(1.4, 2.85, 2.4), cf * CFrame.new(s * 1.7, 1.43, -1.3), Props.WOOD_DARK, M.Wood)
	end
	P(m, "Papers", Vector3.new(1.2, 0.05, 1.6), cf * CFrame.new(-0.8, 3.18, -1.2) * CFrame.Angles(0, 0.3, 0), rgb(230, 226, 210), M.SmoothPlastic, nc())
	return m
end

function Props.bench(parent, cf: CFrame, w: number)
	local m = model(parent, "Bench")
	P(m, "Seat", Vector3.new(w, 0.4, 1.8), cf * CFrame.new(0, 1.8, -0.9), Props.WOOD, M.Wood)
	for _, s in { -1, 1 } do
		P(m, "Leg", Vector3.new(0.4, 1.6, 1.6), cf * CFrame.new(s * (w / 2 - 0.4), 0.8, -0.9), Props.IRON, M.Metal)
	end
	return m
end

function Props.pillar(parent, cf: CFrame, h: number)
	local m = model(parent, "Pillar")
	P(m, "Shaft", Vector3.new(2.4, h, 2.4), cf * CFrame.new(0, h / 2, 0), rgb(150, 140, 126), M.Limestone)
	P(m, "Base", Vector3.new(3.2, 0.8, 3.2), cf * CFrame.new(0, 0.4, 0), rgb(120, 112, 100), M.Limestone)
	P(m, "Cap", Vector3.new(3.2, 0.8, 3.2), cf * CFrame.new(0, h - 0.4, 0), rgb(120, 112, 100), M.Limestone)
	return m
end

function Props.crate(parent, cf: CFrame, s: number?)
	local size = s or 3
	local m = model(parent, "Crate")
	P(m, "Box", Vector3.new(size, size, size), cf * CFrame.new(0, size / 2, 0), rgb(130, 98, 62), M.WoodPlanks)
	return m
end

-- Предмет на полу или столе (батарейка, ключ, растение, деталь)
function Props.pickup(parent, cf: CFrame, item: string)
	local m = model(parent, "Pickup")
	local root
	if item == "battery" then
		root = P(m, "Battery", Vector3.new(0.5, 1, 0.5), cf * CFrame.new(0, 0.5, 0), rgb(40, 140, 60), M.Metal)
		P(m, "Tip", Vector3.new(0.25, 0.15, 0.25), cf * CFrame.new(0, 1.07, 0), rgb(200, 200, 200), M.Metal, nc())
	elseif item == "key" then
		root = P(m, "Key", Vector3.new(1.4, 0.15, 0.45), cf * CFrame.new(0, 0.1, 0), Props.BRASS, M.Metal)
		P(m, "Bow", Vector3.new(0.6, 0.16, 0.6), cf * CFrame.new(-0.8, 0.1, 0), Props.BRASS, M.Metal, nc())
		light(root, 6, 0.6, rgb(255, 220, 140))
	elseif item == "fuse" then
		root = P(m, "Fuse", Vector3.new(0.8, 1.6, 0.8), cf * CFrame.new(0, 0.8, 0), rgb(60, 110, 170), M.Glass)
		P(m, "Cap", Vector3.new(0.9, 0.3, 0.9), cf * CFrame.new(0, 1.7, 0), Props.BRASS, M.Metal, nc())
		light(root, 8, 0.8, rgb(120, 180, 255))
	elseif item == "plant" then
		root = P(m, "Sprout", Vector3.new(0.8, 0.8, 0.8), cf * CFrame.new(0, 0.4, 0), rgb(150, 80, 56), M.Brick)
		P(m, "Leaves", Vector3.new(1, 1, 1), cf * CFrame.new(0, 1.2, 0), rgb(80, 170, 80), M.Grass, nc({ Shape = Enum.PartType.Ball }))
	else
		root = P(m, "Coins", Vector3.new(1, 0.3, 1), cf * CFrame.new(0, 0.15, 0), rgb(230, 190, 70), M.Metal, { Shape = Enum.PartType.Cylinder })
		root.CFrame = cf * CFrame.new(0, 0.15, 0) * CFrame.Angles(0, 0, math.pi / 2)
	end
	root:SetAttribute("Item", item)
	Props.prompt(root, "pick", 0, 7)
	return m, root
end

-- Генератор для зала Слепого
function Props.generator(parent, cf: CFrame)
	local m = model(parent, "Generator")
	local body = P(m, "Body", Vector3.new(5, 4, 3.4), cf * CFrame.new(0, 2, 0), rgb(90, 96, 92), M.DiamondPlate)
	P(m, "Panel", Vector3.new(3, 2, 0.2), cf * CFrame.new(0, 2.4, -1.8), rgb(40, 42, 40), M.Metal, nc())
	local lamp = P(m, "StatusLamp", Vector3.new(0.6, 0.6, 0.6), cf * CFrame.new(1.8, 4.3, -1.2), rgb(220, 40, 30), M.Neon, nc({ Shape = Enum.PartType.Ball }))
	light(lamp, 10, 1, rgb(255, 60, 40))
	for _, s in { -1, 1 } do
		P(m, "Pipe", Vector3.new(0.5, 3, 0.5), cf * CFrame.new(s * 2, 5.5, 0.8), rgb(70, 70, 74), M.Metal)
	end
	local sparks = Instance.new("ParticleEmitter")
	sparks.Name = "Sparks"
	sparks.Rate = 0
	sparks.Speed = NumberRange.new(6, 12)
	sparks.Lifetime = NumberRange.new(0.2, 0.5)
	sparks.Size = NumberSequence.new(0.2, 0)
	sparks.Color = ColorSequence.new(rgb(255, 210, 120))
	sparks.LightEmission = 1
	sparks.Parent = body
	Props.prompt(body, "repair", 3, 8)
	return m, body, lamp
end

return Props
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX0000001A">
          <Properties>
            <string name="Name">RoomBuilder</string>
            <ProtectedString name="Source">--!nonstrict
-- Сборка одной комнаты лабиринта по описанию из RoomPlan. Кадр комнаты: вход в
-- точке origin, комната уходит вперёд (LookVector). Мебель ставится зеркально
-- у левой и правой стен, проходы к дверям всегда свободны

local Shared = game:GetService("ReplicatedStorage").Workshop.Shared
local M = require(Shared.Materials)
local Plan = require(Shared.RoomPlan)
local Props = require(script.Parent.Props)

local P, nc, rgb = Props.P, Props.nc, Props.rgb

local Builder = {}

-- оформление сектора: обои, пол, плинтус (сектора чередуются)
Builder.THEMES = {
	{ wall = rgb(70, 82, 62), wallMat = M.Plaster, floor = rgb(96, 66, 44), floorMat = M.WoodPlanks, trim = rgb(54, 38, 28), ceil = rgb(186, 178, 160) },
	{ wall = rgb(110, 52, 46), wallMat = M.Plaster, floor = rgb(150, 146, 136), floorMat = M.CeramicTiles, trim = rgb(60, 34, 30), ceil = rgb(170, 160, 150) },
	{ wall = rgb(112, 112, 108), wallMat = M.Concrete, floor = rgb(80, 80, 78), floorMat = M.Concrete, trim = rgb(56, 56, 56), ceil = rgb(120, 120, 118) },
	{ wall = rgb(44, 54, 86), wallMat = M.Plaster, floor = rgb(170, 164, 156), floorMat = M.Marble, trim = rgb(30, 30, 44), ceil = rgb(160, 160, 170) },
}

function Builder.theme(sector: number)
	return Builder.THEMES[((sector - 1) % #Builder.THEMES) + 1]
end

local WALL_T = 1
local DOOR_HOLE = { w = 5.6, h = 9.4 }

-- мировой кадр по локальным координатам комнаты
local function at(origin: CFrame, x: number, y: number, z: number)
	return origin * CFrame.new(x, y, z)
end

-- место у боковой стены: side = -1 левая, 1 правая; LookVector в комнату
local function sideSlot(origin, w, side, z)
	return origin * CFrame.new(side * w / 2, 0, z) * CFrame.Angles(0, if side &gt; 0 then math.pi / 2 else -math.pi / 2, 0)
end

-- место у дальней стены (её внутренняя сторона на -l + 0.5), LookVector в комнату
local function frontSlot(origin, l, x)
	return origin * CFrame.new(x, 0, -l + 0.5) * CFrame.Angles(0, math.pi, 0)
end

-- место у стены входа (она толще: внутренняя сторона на -0.6)
local function backSlot(origin, x)
	return origin * CFrame.new(x, 0, -0.6)
end

-- Голые стены, пол, потолок, плинтус. Вход в задней стене, выход по плану
local function shell(m, d, origin, th)
	local w, l, h = d.w, d.l, d.h
	P(m, "Floor", Vector3.new(w + 2, 1, l), at(origin, 0, -0.5, -l / 2), th.floor, th.floorMat)
	P(m, "Ceiling", Vector3.new(w + 2, 1, l), at(origin, 0, h + 0.5, -l / 2), th.ceil, M.SmoothPlastic)
	local ex, ez, rot = Plan.exitOf(d)
	local hasEntrance = d.kind ~= "start"
	-- задняя стена (толще, чтобы не мерцала со стеной прошлой комнаты)
	Props.wall(m, at(origin, 0, 0, 0), w + 2, h, WALL_T + 0.2, if hasEntrance then { { x = 0, w = DOOR_HOLE.w, h = DOOR_HOLE.h } } else {}, th.wall, th.wallMat)
	-- дальняя стена
	Props.wall(m, at(origin, 0, 0, -l) * CFrame.Angles(0, math.pi, 0), w + 2, h, WALL_T, if rot == 0 then { { x = 0, w = DOOR_HOLE.w, h = DOOR_HOLE.h } } else {}, th.wall, th.wallMat)
	-- боковые стены: локальная ось стены идёт вдоль Z комнаты
	for _, side in { -1, 1 } do
		local holes = {}
		if rot ~= 0 and math.sign(ex) == side then
			-- x стены = -z комнаты (для левой) или z (для правой)
			holes = { { x = if side &lt; 0 then -(ez + l / 2) else (ez + l / 2), w = DOOR_HOLE.w, h = DOOR_HOLE.h } }
		end
		local cf = at(origin, side * (w / 2 + WALL_T / 2), 0, -l / 2) * CFrame.Angles(0, if side &lt; 0 then math.pi / 2 else -math.pi / 2, 0)
		Props.wall(m, cf, l, h, WALL_T, holes, th.wall, th.wallMat)
	end
	-- плинтус вдоль боковых стен
	for _, side in { -1, 1 } do
		P(m, "Baseboard", Vector3.new(0.2, 0.6, l), at(origin, side * (w / 2 - 0.1), 0.3, -l / 2), th.trim, M.Wood, nc())
	end
	local exitCF = origin * CFrame.new(ex, 0, ez) * CFrame.Angles(0, rot * math.pi / 2, 0)
	return exitCF
end

-- свет под потолком вдоль середины комнаты
local function ceilingLights(m, d, origin, info, count: number)
	for k = 1, count do
		local z = -d.l * k / (count + 1)
		local _, bulb = Props.ceilingLight(m, at(origin, 0, d.h, z).Position)
		table.insert(info.lights, bulb)
	end
end

-- зеркальная пара у боковых стен на глубине z (если там не выход)
local function pair(info, d, origin, z, fn)
	local _, ez, rot = Plan.exitOf(d)
	if rot ~= 0 and math.abs(z - ez) &lt; 5.5 then
		return false
	end
	if z &gt; -4 then
		return false
	end
	for _, side in { -1, 1 } do
		fn(sideSlot(origin, d.w, side, z), side)
	end
	local _ = info
	return true
end

local function addCloset(m, info, cf)
	local _, body = Props.closet(m, cf)
	table.insert(info.closets, body)
end

local function addDresser(m, info, cf)
	local _, body = Props.dresser(m, cf)
	table.insert(info.searchables, body)
	-- место для предмета на крышке
	table.insert(info.tops, cf * CFrame.new(1.2, 3.5, -0.9))
	return body
end

-- обстановка по типу комнаты ---------------------------------------------------

local furnish = {}

furnish.start = function(m, d, origin, info)
	-- холл-приёмная: стойка, диваны-скамьи, растения, табличка лабиринта
	Props.table(m, at(origin, 0, 0, -8), 10, 2.4)
	for _, side in { -1, 1 } do
		Props.bench(m, sideSlot(origin, d.w, side, -16), 8)
		Props.plantPot(m, sideSlot(origin, d.w, side, -4) * CFrame.new(0, 0, -1.2))
		Props.plantPot(m, sideSlot(origin, d.w, side, -27) * CFrame.new(0, 0, -1.2))
		Props.painting(m, sideSlot(origin, d.w, side, -16) * CFrame.new(0, 7, -0.15), 6, 4, side + 3)
		addCloset(m, info, frontSlot(origin, d.l, side * 9))
	end
	Props.lamp(m, at(origin, -3.5, 3.15, -8).Position)
	Props.lamp(m, at(origin, 3.5, 3.15, -8).Position)
	ceilingLights(m, d, origin, info, 2)
end

furnish.corridor = function(m, d, origin, info)
	local k = 0
	for z = -8, -d.l + 6, -8 do
		k += 1
		pair(info, d, origin, z, function(cf, side)
			if k == 2 and side &lt; 0 then
				addCloset(m, info, cf)
			elseif k == 2 then
				addDresser(m, info, cf)
			else
				Props.painting(m, cf * CFrame.new(0, 6.5, -0.15), 3.6, 2.6, k + side)
			end
		end)
	end
	ceilingLights(m, d, origin, info, 3)
end

furnish.room = function(m, d, origin, info)
	-- выход сбоку: кровать по центру дальней стены; выход прямо: две кровати у боковых стен
	local blanket = Color3.fromHSV((d.door * 0.17) % 1, 0.4, 0.45)
	if d.turn ~= 0 then
		Props.bed(m, frontSlot(origin, d.l, 0), blanket)
	else
		for _, side in { -1, 1 } do
			Props.bed(m, sideSlot(origin, d.w, side, -d.l / 2), blanket)
		end
	end
	pair(info, d, origin, -6, function(cf)
		addCloset(m, info, cf)
	end)
	pair(info, d, origin, -d.l + 4, function(cf)
		addDresser(m, info, cf)
		Props.lamp(m, (cf * CFrame.new(-1.4, 3.5, -0.9)).Position)
	end)
	Props.table(m, at(origin, 0, 0, -d.l / 2), 4, 3)
	table.insert(info.tops, at(origin, 0.8, 3.2, -d.l / 2))
	Props.chair(m, at(origin, -2.8, 0, -d.l / 2) * CFrame.Angles(0, -math.pi / 2, 0))
	Props.chair(m, at(origin, 2.8, 0, -d.l / 2) * CFrame.Angles(0, math.pi / 2, 0))
	for _, x in { -7, 7 } do
		Props.painting(m, backSlot(origin, x) * CFrame.new(0, 7, -0.15), 4, 3, d.door + x)
	end
	ceilingLights(m, d, origin, info, 1)
end

furnish.office = function(m, d, origin, info)
	pair(info, d, origin, -5.5, function(cf)
		addCloset(m, info, cf)
	end)
	pair(info, d, origin, -12, function(cf, side)
		Props.shelf(m, cf, d.door + side)
	end)
	pair(info, d, origin, -18, function(cf)
		addDresser(m, info, cf)
	end)
	for _, x in { -5, 5 } do
		Props.desk(m, at(origin, x, 0, -10) * CFrame.Angles(0, math.pi, 0))
		Props.chair(m, at(origin, x, 0, -6.2))
		table.insert(info.tops, at(origin, x + 1.2, 3.2, -8.7))
	end
	ceilingLights(m, d, origin, info, 2)
end

furnish.hall = function(m, d, origin, info)
	for _, x in { -8, 8 } do
		for _, z in { -10, -24 } do
			Props.pillar(m, at(origin, x, 0, z), d.h)
		end
	end
	pair(info, d, origin, -6, function(cf)
		addCloset(m, info, cf)
	end)
	pair(info, d, origin, -17, function(cf)
		Props.bench(m, cf, 7)
		Props.painting(m, cf * CFrame.new(0, 8, -0.15), 6, 4, d.door)
	end)
	pair(info, d, origin, -28, function(cf)
		addCloset(m, info, cf)
	end)
	if d.turn == 0 then
		for _, x in { -11, 11 } do
			addDresser(m, info, frontSlot(origin, d.l, x))
		end
	else
		for _, x in { -11, 11 } do
			addDresser(m, info, backSlot(origin, x))
		end
	end
	for _, x in { -14, 14 } do
		Props.plantPot(m, at(origin, x, 0, -17))
	end
	ceilingLights(m, d, origin, info, 3)
end

-- Построить комнату. Возвращает сведения для игры: выход, шкафы, ящики, свет, путь
function Builder.build(parent: Instance, d, origin: CFrame)
	local th = Builder.theme(d.sector)
	local m = Props.model(parent, string.format("Room_%04d", d.door))
	local info = { desc = d, model = m, origin = origin, closets = {}, searchables = {}, tops = {}, lights = {} }
	local exitCF = shell(m, d, origin, th)
	info.exitCF = exitCF
	local f = furnish[d.kind] or furnish.room
	f(m, d, origin, info)
	-- путь сквозь комнату для Гула: вход, середина, перед выходом
	info.path = {
		at(origin, 0, 4, -2).Position,
		at(origin, 0, 4, -d.l / 2).Position,
		(exitCF * CFrame.new(0, 4, 2.5)).Position,
	}
	-- угол для Смотрителя: дальний от входа
	info.watcherSpawn = at(origin, (if d.door % 2 == 0 then 1 else -1) * (d.w / 2 - 3), 0, -d.l + 3)
	info.center = at(origin, 0, d.h / 2, -d.l / 2)
	info.size = Vector3.new(d.w, d.h, d.l)
	-- темнота: свет выключен
	if d.dark then
		for _, bulb in info.lights do
			bulb:SetAttribute("Dark", true)
			local l = bulb:FindFirstChildOfClass("PointLight")
			if l then
				l.Enabled = false
			end
			bulb.Material = M.Glass
			bulb.Color = rgb(60, 56, 50)
		end
		for _, d2 in m:GetDescendants() do
			if d2:IsA("PointLight") then
				d2.Enabled = false
			end
		end
	end
	return info
end

-- Игрок внутри комнаты (по прямоугольнику пола)
function Builder.contains(info, pos: Vector3): boolean
	local lp = info.origin:PointToObjectSpace(pos)
	local d = info.desc
	return math.abs(lp.X) &lt;= d.w / 2 + 0.5 and lp.Z &lt;= 0.5 and lp.Z &gt;= -d.l - 0.5 and lp.Y &gt; -3 and lp.Y &lt; d.h + 2
end

Builder.sideSlot = sideSlot
Builder.frontSlot = frontSlot
Builder.at = at
Builder.shell = shell
Builder.ceilingLights = ceilingLights
Builder.addCloset = addCloset
Builder.addDresser = addDresser

return Builder
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX0000001B">
          <Properties>
            <string name="Name">Special</string>
            <ProtectedString name="Source">--!nonstrict
-- Особые места: рабочий лифт с кнопками секторов и автоматом-лавкой, зал Слепого
-- с генераторами, деталями и воротами, Сборщик платы у двери

local CollectionService = game:GetService("CollectionService")
local Shared = game:GetService("ReplicatedStorage").Workshop.Shared
local M = require(Shared.Materials)
local Rules = require(Shared.Rules)
local Props = require(script.Parent.Props)
local Builder = require(script.Parent.RoomBuilder)

local P, nc, rgb = Props.P, Props.nc, Props.rgb
local at = Builder.at

local Special = {}

local METAL = rgb(92, 94, 98)

-- Лифт: зал ожидания с автоматом и кабина с решёткой и кнопками. Выход кабины —
-- обычная дверь следующего номера, она открывается сама после поездки
function Special.elevator(parent, d, origin: CFrame)
	local th = Builder.theme(d.sector)
	local m = Props.model(parent, string.format("Room_%04d", d.door))
	local info = { desc = d, model = m, origin = origin, closets = {}, searchables = {}, tops = {}, lights = {}, elevator = true }
	info.exitCF = Builder.shell(m, d, origin, th)
	local cz0 = -16 -- граница кабины
	-- стенки кабины из металла поверх обоев
	for _, side in { -1, 1 } do
		P(m, "CabinWall", Vector3.new(0.4, d.h, d.l + cz0), at(origin, side * 6.2, d.h / 2, (cz0 - d.l) / 2), METAL, M.DiamondPlate)
		P(m, "CabinFront", Vector3.new(5, d.h, 0.4), at(origin, side * 8.7, d.h / 2, cz0), METAL, M.DiamondPlate)
	end
	P(m, "CabinFloor", Vector3.new(12, 0.2, d.l + cz0), at(origin, 0, 0.1, (cz0 - d.l) / 2), rgb(70, 72, 76), M.DiamondPlate)
	P(m, "CabinTop", Vector3.new(17.4, 0.6, 0.6), at(origin, 0, 11.4, cz0), METAL, M.Metal)
	-- раздвижная решётка (поднимается)
	local gate = Props.model(m, "CabinGate")
	local bars = {}
	for k = -5, 5 do
		table.insert(bars, P(gate, "Bar", Vector3.new(0.25, 11, 0.25), at(origin, k * 1.1, 5.5, cz0), rgb(150, 150, 156), M.Metal))
	end
	local gateBlock = P(gate, "Block", Vector3.new(12, 11, 0.4), at(origin, 0, 5.5, cz0), rgb(0, 0, 0), M.SmoothPlastic, { Transparency = 1 })
	info.gate = gate
	info.gateBlock = gateBlock
	gate.WorldPivot = at(origin, 0, 0, cz0)
	-- поднята в начале: лифт ждёт игроков
	gate:PivotTo(at(origin, 0, 10.5, cz0))
	gateBlock.CanCollide = false
	-- кнопки: текущий сектор, следующий, остальные недоступны
	local panelCF = at(origin, 5.9, 4.5, cz0 - 4) * CFrame.Angles(0, math.pi / 2, 0)
	P(m, "Panel", Vector3.new(2.2, 4.2, 0.2), panelCF, rgb(40, 40, 44), M.Metal)
	info.buttons = {}
	for k = 0, 2 do
		local s = d.sector + k
		local b = P(m, "Button", Vector3.new(1.2, 0.9, 0.25), panelCF * CFrame.new(0, 1.3 - k * 1.3, -0.15), if k == 1 then rgb(240, 190, 80) else rgb(90, 90, 96), M.Neon)
		if k ~= 1 then
			b.Material = M.Metal
		end
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Front
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 60
		gui.Parent = b
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Size = UDim2.fromScale(1, 1)
		t.TextScaled = true
		t.Font = Enum.Font.GothamBold
		t.TextColor3 = rgb(20, 20, 20)
		t.Text = tostring(s)
		t.Parent = gui
		if Rules.canRide(d.sector, s) then
			info.rideButton = b
			Props.prompt(b, "ride", 1, 7)
		end
	end
	-- автомат-лавка и скамья в зале ожидания
	local vend = Props.model(m, "Vending")
	local body = P(vend, "Body", Vector3.new(4, 7.5, 2.6), at(origin, -d.w / 2 + 2, 3.75, -8) * CFrame.Angles(0, -math.pi / 2, 0), rgb(120, 30, 34), M.Metal)
	P(vend, "Glass", Vector3.new(2.6, 4, 0.1), body.CFrame * CFrame.new(-0.4, 0.8, -1.32), rgb(200, 220, 230), M.Glass, nc({ Transparency = 0.4 }))
	local glow = P(vend, "Glow", Vector3.new(2.4, 3.8, 0.05), body.CFrame * CFrame.new(-0.4, 0.8, -1.25), rgb(255, 230, 180), M.Neon, nc())
	Props.light(glow, 12, 0.8)
	Props.prompt(body, "shop", 0, 8)
	Props.bench(m, Builder.sideSlot(origin, d.w, 1, -8), 7)
	Props.plantPot(m, Builder.sideSlot(origin, d.w, 1, -3) * CFrame.new(0, 0, -1.2))
	Props.plantPot(m, Builder.sideSlot(origin, d.w, -1, -3) * CFrame.new(0, 0, -1.2))
	Builder.ceilingLights(m, d, origin, info, 1)
	local _, cabinLamp = Props.ceilingLight(m, at(origin, 0, d.h, (cz0 - d.l) / 2).Position)
	table.insert(info.lights, cabinLamp)
	info.cabinCenter = at(origin, 0, 3, (cz0 - d.l) / 2)
	info.cabinZ = { cz0, -d.l }
	info.path = { at(origin, 0, 4, -2).Position, at(origin, 0, 4, -10).Position }
	info.center = at(origin, 0, d.h / 2, -d.l / 2)
	info.size = Vector3.new(d.w, d.h, d.l)
	info.watcherSpawn = at(origin, 0, 0, -6)
	return info
end

-- игрок в кабине лифта
function Special.inCabin(info, pos: Vector3): boolean
	local lp = info.origin:PointToObjectSpace(pos)
	return math.abs(lp.X) &lt; 6 and lp.Z &lt; info.cabinZ[1] - 0.3 and lp.Z &gt; info.cabinZ[2]
end

-- Зал Слепого: колонны, ящики для укрытия, шкафы, три генератора, детали и ворота.
-- За воротами сразу лифт (строится отдельно от exitCF)
function Special.boss(parent, d, origin: CFrame, rand)
	local th = Builder.theme(d.sector)
	local m = Props.model(parent, string.format("Room_%04d", d.door))
	local info = { desc = d, model = m, origin = origin, closets = {}, searchables = {}, tops = {}, lights = {}, boss = true }
	local w, l, h = d.w, d.l, d.h
	P(m, "Floor", Vector3.new(w + 2, 1, l), at(origin, 0, -0.5, -l / 2), rgb(70, 70, 68), M.Concrete)
	P(m, "Ceiling", Vector3.new(w + 2, 1, l), at(origin, 0, h + 0.5, -l / 2), rgb(50, 50, 50), M.Concrete)
	local wallC = th.wall:Lerp(rgb(40, 40, 40), 0.5)
	Props.wall(m, at(origin, 0, 0, 0), w + 2, h, 1.2, { { x = 0, w = 5.6, h = 9.4 } }, wallC, M.Concrete)
	Props.wall(m, at(origin, 0, 0, -l) * CFrame.Angles(0, math.pi, 0), w + 2, h, 1, { { x = 0, w = 12, h = 14 } }, wallC, M.Concrete)
	for _, side in { -1, 1 } do
		Props.wall(m, at(origin, side * (w / 2 + 0.5), 0, -l / 2) * CFrame.Angles(0, if side &lt; 0 then math.pi / 2 else -math.pi / 2, 0), l, h, 1, {}, wallC, M.Concrete)
	end
	-- колонны сеткой (между ними удобно прятаться от Слепого)
	for _, x in { -22, 0, 22 } do
		for _, z in { -20, -44, -68 } do
			if not (x == 0 and z == -44) then
				Props.pillar(m, at(origin, x, 0, z), h)
			end
		end
	end
	-- ящики-укрытия
	local crates = { { -12, -30 }, { 12, -30 }, { -30, -56 }, { 30, -56 }, { -10, -78 }, { 10, -78 }, { 0, -12 } }
	for i, c in crates do
		Props.crate(m, at(origin, c[1], 0, c[2]) * CFrame.Angles(0, i * 0.4, 0), 3.5)
	end
	-- шкафы вдоль стен
	for _, side in { -1, 1 } do
		for _, z in { -14, -44, -74 } do
			Builder.addCloset(m, info, Builder.sideSlot(origin, w, side, z))
		end
	end
	-- генераторы
	info.generators = {}
	for _, g in { { -30, -30 }, { 30, -30 }, { 0, -60 } } do
		local gm, body, lamp = Props.generator(m, at(origin, g[1], 0, g[2]) * CFrame.Angles(0, math.pi, 0))
		table.insert(info.generators, { model = gm, body = body, lamp = lamp, progress = 0, fused = false, done = false })
	end
	-- детали: случайные места из списка
	local spots = { { -34, -12 }, { 34, -12 }, { -20, -50 }, { 20, -50 }, { -34, -80 }, { 34, -80 }, { 0, -30 }, { -8, -68 }, { 8, -84 } }
	for i = #spots, 2, -1 do
		local j = math.floor(rand() * i) + 1
		spots[i], spots[j] = spots[j], spots[i]
	end
	info.fuses = {}
	for i = 1, Rules.FUSES do
		local s = spots[i]
		local _, part = Props.pickup(m, at(origin, s[1], 0, s[2]), "fuse")
		table.insert(info.fuses, part)
	end
	-- аварийный красный свет
	for _, x in { -26, 26 } do
		for _, z in { -24, -64 } do
			local lamp = P(m, "EmergencyLamp", Vector3.new(1.4, 0.6, 1.4), at(origin, x, h - 0.4, z), rgb(200, 40, 30), M.Neon, nc())
			Props.light(lamp, 34, 0.9, rgb(255, 50, 40))
			table.insert(info.lights, lamp)
		end
	end
	-- ворота: тяжёлая решётка, поднимается, когда починены все генераторы
	local gate = Props.model(m, "BigGate")
	for k = -5, 5 do
		P(gate, "Bar", Vector3.new(0.5, 14, 0.5), at(origin, k * 1.1, 7, -l), rgb(70, 70, 74), M.Metal)
	end
	for _, y in { 2, 7, 12 } do
		P(gate, "Rail", Vector3.new(12, 0.6, 0.6), at(origin, 0, y, -l), rgb(70, 70, 74), M.Metal)
	end
	info.bigGate = gate
	info.bigGateHome = gate:GetPivot()
	-- середина зала и границы для проверок
	info.exitCF = at(origin, 0, 0, -l)
	info.center = at(origin, 0, h / 2, -l / 2)
	info.size = Vector3.new(w, h, l)
	info.path = { at(origin, 0, 4, -2).Position }
	info.watcherSpawn = at(origin, 0, 0, -10)
	info.blindSpawn = at(origin, 0, 3, -44)
	info.wander = {}
	for _, p in { { -30, -12 }, { 30, -12 }, { -34, -44 }, { 34, -44 }, { -30, -80 }, { 30, -80 }, { 0, -24 }, { 0, -70 }, { -12, -44 }, { 12, -44 } } do
		table.insert(info.wander, at(origin, p[1], 3, p[2]).Position)
	end
	return info
end

-- Сборщик платы: высокая фигура в плаще с фонарём и весами. Стоит перед выходом
function Special.tollKeeper(parent, cf: CFrame, price: number)
	local m = Props.model(parent, "TollKeeper")
	local robe = rgb(30, 26, 34)
	P(m, "Robe", Vector3.new(3.4, 7, 2.2), cf * CFrame.new(0, 3.5, 0), robe, M.SmoothPlastic)
	P(m, "Hood", Vector3.new(2.6, 2.4, 2.4), cf * CFrame.new(0, 8.1, 0.1), robe, M.SmoothPlastic)
	P(m, "Face", Vector3.new(1.6, 1.4, 0.1), cf * CFrame.new(0, 8, -1.2), rgb(10, 8, 10), M.SmoothPlastic, nc())
	for _, x in { -0.4, 0.4 } do
		local eye = P(m, "Eye", Vector3.new(0.25, 0.25, 0.05), cf * CFrame.new(x, 8.2, -1.27), rgb(255, 200, 80), M.Neon, nc())
		local _ = eye
	end
	local lantern = P(m, "Lantern", Vector3.new(0.8, 1, 0.8), cf * CFrame.new(-2.2, 3.6, -0.6), rgb(255, 190, 90), M.Neon, nc())
	Props.light(lantern, 16, 1.2, rgb(255, 180, 90))
	P(m, "Chain", Vector3.new(0.1, 1.6, 0.1), cf * CFrame.new(-2.2, 4.9, -0.6), Props.IRON, M.Metal, nc())
	-- чаша для монет
	local bowl = P(m, "Bowl", Vector3.new(1.8, 0.4, 1.8), cf * CFrame.new(1.9, 4.2, -0.8), rgb(200, 170, 80), M.Metal, nc())
	local payCoins = P(m, "PayCoins", Vector3.new(1.5, 1.5, 1.5), cf * CFrame.new(1.9, 4.6, -0.8), rgb(0, 0, 0), M.SmoothPlastic, nc({ Transparency = 1 }))
	local payBlood = P(m, "PayBlood", Vector3.new(1.5, 1.5, 1.5), cf * CFrame.new(-0.6, 5, -1), rgb(0, 0, 0), M.SmoothPlastic, nc({ Transparency = 1 }))
	local _ = bowl
	-- блок, чтобы нельзя было пройти мимо
	P(m, "Block", Vector3.new(7, 10, 1), cf * CFrame.new(0, 5, 0.6), rgb(0, 0, 0), M.SmoothPlastic, { Transparency = 1 })
	local pc = Props.prompt(payCoins, "paycoins", 0.4, 9)
	pc:SetAttribute("Price", price)
	-- обе кнопки видны одновременно (разные клавиши)
	pc.Exclusivity = Enum.ProximityPromptExclusivity.AlwaysShow
	pc.KeyboardKeyCode = Enum.KeyCode.E
	pc.UIOffset = Vector2.new(0, 40)
	local pb = Props.prompt(payBlood, "payblood", 1.2, 9)
	pb.Exclusivity = Enum.ProximityPromptExclusivity.AlwaysShow
	pb.KeyboardKeyCode = Enum.KeyCode.F
	pb.GamepadKeyCode = Enum.KeyCode.ButtonY
	pb.UIOffset = Vector2.new(0, -40)
	CollectionService:AddTag(m, "TollKeeper")
	return m, pc, pb
end

return Special
</ProtectedString>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBX0000001C">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CharacterWalkSpeed">16</float>
      <float name="CameraMaxZoomDistance">40</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBX0000001D">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="RBX0000001E">
        <Properties>
          <string name="Name">Workshop</string>
        </Properties>
        <Item class="LocalScript" referent="RBX0000001F">
          <Properties>
            <string name="Name">Main</string>
            <ProtectedString name="Source">--!nonstrict
-- Клиент «The Labyrinth»: меню, интерфейс забега, фонарик, крадущийся шаг, предметы,
-- камера в шкафу, взгляд на Смотрителя, эффекты Гула, смерть и наблюдение, лавка, админ

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")
local StarterGui = game:GetService("StarterGui")
local Lighting = game:GetService("Lighting")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Workshop"):WaitForChild("Shared")
local Remotes = require(Shared.Roblox.Remotes)
local Lang = require(Shared.Lang)
local Rules = require(Shared.Rules)
local AdminCommands = require(Shared.AdminCommands)
local Ui = require(script.Parent.Ui)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local app = {
	lang = if string.sub(player.LocaleId or "", 1, 2) == "ru" then "ru" else "en",
	inMenu = true,
	coins = 0,
	inv = {},
	sneaking = false,
	dead = false,
	spectating = nil :: Player?,
	shake = 0,
	lastHp = 100,
}

local function T(key: string, ...)
	return Lang.t(app.lang, key, ...)
end

local function request(...)
	local ok, res = pcall(function(...)
		return Remotes.fn("Request"):InvokeServer(...)
	end, ...)
	return if ok then res else nil
end

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
end)

-- тёмный отель: свет только от ламп и фонарика
Lighting.Ambient = Color3.fromRGB(14, 12, 12)
Lighting.OutdoorAmbient = Color3.fromRGB(0, 0, 0)
Lighting.Brightness = 0
Lighting.ClockTime = 0
Lighting.FogColor = Color3.fromRGB(4, 4, 5)
Lighting.FogStart = 30
Lighting.FogEnd = 150
pcall(function()
	Lighting.EnvironmentDiffuseScale = 0
	Lighting.EnvironmentSpecularScale = 0
end)
local tint = Instance.new("ColorCorrectionEffect")
tint.Name = "LabTint"
tint.Saturation = -0.15
tint.Contrast = 0.1
tint.Parent = Lighting

-- ---------------------------------------------------------------------------
-- экраны

local gui = Instance.new("ScreenGui")
gui.Name = "Labyrinth"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = playerGui

local hud = Ui.frame(gui, { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false })
local overlay = Ui.frame(gui, { BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 5, Active = false })
local redFlash = Ui.frame(gui, { BackgroundColor3 = Color3.fromRGB(150, 0, 0), BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 6 })

local toastBox = Ui.frame(gui, { BackgroundTransparency = 1, Size = UDim2.new(0.9, 0, 0, 200), Position = UDim2.new(0.05, 0, 0.62, 0), ZIndex = 20 })
Ui.list(toastBox, 6)

local function toast(text: string, color: Color3?, seconds: number?)
	local l = Ui.label(toastBox, text, {
		Size = UDim2.new(0, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.XY,
		BackgroundTransparency = 0.25,
		BackgroundColor3 = Ui.C.panel,
		TextColor3 = color or Ui.C.text,
		TextSize = 17,
		ZIndex = 21,
	})
	Ui.corner(l, 6)
	Ui.pad(l, 8)
	task.delay(seconds or 3, function()
		l:Destroy()
	end)
end

local banner = Ui.label(gui, "", { Font = Ui.TITLE, TextSize = 34, TextColor3 = Ui.C.gold, Size = UDim2.new(1, 0, 0, 60), Position = UDim2.new(0, 0, 0.22, 0), TextTransparency = 1, ZIndex = 22 })
local bannerStroke = Instance.new("UIStroke")
bannerStroke.Thickness = 2
bannerStroke.Transparency = 1
bannerStroke.Parent = banner
local function showBanner(text: string, seconds: number?)
	banner.Text = text
	banner.TextTransparency = 0
	bannerStroke.Transparency = 0.3
	task.delay(seconds or 3, function()
		if banner.Text == text then
			TweenService:Create(banner, TweenInfo.new(0.8), { TextTransparency = 1 }):Play()
			TweenService:Create(bannerStroke, TweenInfo.new(0.8), { Transparency = 1 }):Play()
		end
	end)
end

local function flashRed(strength: number)
	redFlash.BackgroundTransparency = 1 - strength
	TweenService:Create(redFlash, TweenInfo.new(0.9), { BackgroundTransparency = 1 }):Play()
end

-- ---------------------------------------------------------------------------
-- интерфейс забега

local top = Ui.label(hud, "", { Font = Ui.TITLE, TextSize = 24, TextColor3 = Ui.C.gold, Size = UDim2.new(1, 0, 0, 30), Position = UDim2.new(0, 0, 0, 44) })

local statusBox = Ui.frame(hud, { BackgroundTransparency = 0.35, Size = UDim2.fromOffset(210, 98), Position = UDim2.new(0, 12, 0, 44) })
Ui.corner(statusBox)
Ui.pad(statusBox, 8)
Ui.list(statusBox, 4)
local function bar(order: number, color: Color3)
	local back = Ui.frame(statusBox, { BackgroundColor3 = Color3.fromRGB(40, 36, 32), Size = UDim2.new(1, 0, 0, 20), LayoutOrder = order })
	Ui.corner(back, 4)
	local fill = Ui.frame(back, { BackgroundColor3 = color, Size = UDim2.fromScale(1, 1) })
	Ui.corner(fill, 4)
	local text = Ui.label(back, "", { Size = UDim2.fromScale(1, 1), TextSize = 13, Font = Ui.BOLD, ZIndex = 2 })
	return fill, text
end
local hpFill, hpText = bar(1, Color3.fromRGB(170, 40, 40))
local flFill, flText = bar(2, Color3.fromRGB(220, 200, 110))
local coinText = Ui.label(statusBox, "", { TextSize = 15, Font = Ui.BOLD, TextColor3 = Ui.C.gold, LayoutOrder = 3, Size = UDim2.new(1, 0, 0, 20), TextXAlignment = Enum.TextXAlignment.Left })

-- кнопки справа внизу: свет и крадущийся шаг
local actions = Ui.frame(hud, { BackgroundTransparency = 1, Size = UDim2.fromOffset(120, 2 * 64 + 10), Position = UDim2.new(1, -132, 1, -220) })
Ui.list(actions, 10)
local flashBtn, sneakBtn
local function refreshButtons()
	flashBtn.Text = T("Flash") .. (if player:GetAttribute("FlashOn") then "  ●" else "")
	sneakBtn.Text = if app.sneaking then T("Sneaking") else T("Sneak")
	sneakBtn.BackgroundColor3 = if app.sneaking then Ui.C.line else Ui.C.panel
end
flashBtn = Ui.button(actions, "", function()
	request("Flash")
end, { Size = UDim2.new(1, 0, 0, 60), TextSize = 18 })
local function setSneak(on: boolean)
	app.sneaking = on
	request("Sneak", on)
	refreshButtons()
end
sneakBtn = Ui.button(actions, "", function()
	setSneak(not app.sneaking)
end, { Size = UDim2.new(1, 0, 0, 60), TextSize = 18 })

-- предметы внизу слева: нажатие — использовать
local slotsBox = Ui.frame(hud, { BackgroundTransparency = 1, Size = UDim2.new(0, 6 * 76, 0, 70), Position = UDim2.new(0, 12, 1, -86) })
Ui.list(slotsBox, 6, true).HorizontalAlignment = Enum.HorizontalAlignment.Left
local SLOT_ORDER = { "battery", "plant", "whistle", "lockpick", "key", "fuse" }
local USABLE = { battery = true, plant = true, whistle = true }
local slotButtons = {}
for i, item in SLOT_ORDER do
	local b = Ui.button(slotsBox, "", function()
		if USABLE[item] and (app.inv[item] or 0) &gt; 0 then
			request("Use", item)
		end
	end, { Size = UDim2.fromOffset(70, 66), TextSize = 12, LayoutOrder = i, TextWrapped = true, Visible = false })
	slotButtons[item] = b
end
local function refreshInv()
	for item, b in slotButtons do
		local n = app.inv[item] or 0
		b.Visible = n &gt; 0
		b.Text = T("item_" .. item) .. "\n×" .. n
		b.TextColor3 = if USABLE[item] then Ui.C.text else Ui.C.dim
	end
	coinText.Text = T("Coins", app.coins)
end

local function refreshTop()
	local door = workspace:GetAttribute("Door") or 0
	local sector = workspace:GetAttribute("Sector") or 1
	top.Text = T("Door", door) .. "   ·   " .. T("Sector", sector)
end
workspace:GetAttributeChangedSignal("Door"):Connect(refreshTop)
workspace:GetAttributeChangedSignal("Sector"):Connect(refreshTop)

local function refreshBars()
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hp = if hum then math.clamp(hum.Health / math.max(1, hum.MaxHealth), 0, 1) else 0
	hpFill.Size = UDim2.fromScale(hp, 1)
	hpText.Text = T("Health") .. "  " .. math.floor(hp * 100 + 0.5)
	local fl = (player:GetAttribute("Flash") or Rules.FLASH_MAX) / Rules.FLASH_MAX
	flFill.Size = UDim2.fromScale(math.clamp(fl, 0, 1), 1)
	flText.Text = T("Flash") .. "  " .. math.floor(fl * 100 + 0.5) .. "%"
end
player:GetAttributeChangedSignal("Flash"):Connect(refreshBars)
player:GetAttributeChangedSignal("FlashOn"):Connect(function()
	refreshBars()
	refreshButtons()
end)

-- ---------------------------------------------------------------------------
-- подписи кнопок у предметов на языке игрока

local function localizePrompt(d: Instance)
	if d:IsA("ProximityPrompt") then
		local kind = d:GetAttribute("Kind")
		if kind then
			d.ActionText = T("p_" .. kind, d:GetAttribute("Price") or 0)
		end
	end
end
local function localizeAll()
	for _, d in workspace:GetDescendants() do
		localizePrompt(d)
	end
end
workspace.DescendantAdded:Connect(localizePrompt)

-- ---------------------------------------------------------------------------
-- камера: от первого лица; в шкафу — сквозь щель; после смерти — за другими

local camera = workspace.CurrentCamera
local function firstPerson()
	player.CameraMode = Enum.CameraMode.LockFirstPerson
	camera.CameraType = Enum.CameraType.Custom
	camera.FieldOfView = 75
end

local hiddenEye = nil
player:GetAttributeChangedSignal("HiddenEye"):Connect(function()
	local eye = player:GetAttribute("HiddenEye")
	hiddenEye = if typeof(eye) == "CFrame" then eye else nil
	if not hiddenEye and not app.inMenu and not app.dead then
		firstPerson()
	end
end)

-- тело в первом лице скрыто (кроме рук), чтобы шляпы и волосы не лезли в камеру
local function hideHead(char: Model)
	for _, d in char:GetDescendants() do
		if d:IsA("BasePart") and (d.Name == "Head" or d.Parent:IsA("Accessory")) then
			d.LocalTransparencyModifier = 1
		end
	end
end

-- ---------------------------------------------------------------------------
-- взгляд на Смотрителя: сервер знает, что на него смотрят

local seenAt: { [number]: number } = {}
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
local function checkWatchers()
	if app.dead or app.inMenu then
		return
	end
	local now = os.clock()
	for _, m in CollectionService:GetTagged("Watcher") do
		local id = m:GetAttribute("WatcherId")
		local head = m:FindFirstChild("Head")
		if id and head then
			local pos = head.Position
			local vp, onScreen = camera:WorldToViewportPoint(pos)
			local body = m:FindFirstChild("Body")
			local vp2, onScreen2 = camera:WorldToViewportPoint(body and body.Position or pos)
			if (onScreen and vp.Z &gt; 0) or (onScreen2 and vp2.Z &gt; 0) then
				local from = camera.CFrame.Position
				rayParams.FilterDescendantsInstances = { player.Character, m }
				local hit = workspace:Raycast(from, pos - from, rayParams)
				if not hit and (pos - from).Magnitude &lt; 90 and now - (seenAt[id] or 0) &gt; 0.12 then
					seenAt[id] = now
					task.spawn(request, "Seen", id)
				end
			end
		end
	end
end

-- ---------------------------------------------------------------------------
-- смерть и наблюдение

local deathBox = Ui.frame(gui, { BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.35, Size = UDim2.fromScale(1, 1), Visible = false, ZIndex = 30 })
local deathTitle = Ui.label(deathBox, "", { Font = Ui.TITLE, TextSize = 48, TextColor3 = Ui.C.red, Size = UDim2.new(1, 0, 0, 60), Position = UDim2.new(0, 0, 0.25, 0), ZIndex = 31 })
local deathCause = Ui.label(deathBox, "", { TextSize = 20, Size = UDim2.new(0.9, 0, 0, 50), Position = UDim2.new(0.05, 0, 0.25, 70), ZIndex = 31 })
local spectBox = Ui.frame(gui, { BackgroundTransparency = 0.3, Size = UDim2.fromOffset(280, 96), Position = UDim2.new(0.5, -140, 1, -120), Visible = false, ZIndex = 30 })
Ui.corner(spectBox)
Ui.pad(spectBox, 6)
Ui.list(spectBox, 6)
local spectName = Ui.label(spectBox, "", { TextSize = 16, ZIndex = 31 })
local function alivePlayers()
	local list = {}
	for _, q in Players:GetPlayers() do
		if q ~= player and q:GetAttribute("Alive") and q.Character then
			table.insert(list, q)
		end
	end
	return list
end
local function spectate(step: number)
	local list = alivePlayers()
	if #list == 0 then
		spectName.Text = T("NewRun")
		return
	end
	local idx = table.find(list, app.spectating) or 0
	idx = (idx + step - 1) % #list + 1
	local q = list[idx]
	app.spectating = q
	local hum = q.Character:FindFirstChildOfClass("Humanoid")
	player.CameraMode = Enum.CameraMode.Classic
	camera.CameraType = Enum.CameraType.Custom
	if hum then
		camera.CameraSubject = hum
	end
	spectName.Text = T("Spectating", q.DisplayName)
end
Ui.button(spectBox, T("SpectateNext"), function()
	spectate(1)
end, { Size = UDim2.new(1, 0, 0, 44), ZIndex = 31 })

local function onDead(msg)
	app.dead = true
	hiddenEye = nil
	deathTitle.Text = T("Died")
	deathCause.Text = T("cause_" .. (msg.cause or "unknown")) .. "\n" .. T("DiedAt", msg.door or 0)
	deathBox.Visible = true
	hud.Visible = false
	task.delay(4, function()
		if app.dead then
			deathBox.Visible = false
			spectBox.Visible = true
			spectate(1)
		end
	end)
end

-- ---------------------------------------------------------------------------
-- лавка в лифте

local shopBox = Ui.frame(gui, { BackgroundTransparency = 0.05, Size = UDim2.fromOffset(320, 330), Position = UDim2.new(0.5, -160, 0.5, -165), Visible = false, ZIndex = 40 })
Ui.corner(shopBox, 10)
Ui.pad(shopBox, 12)
Ui.list(shopBox, 8)
local shopTitle = Ui.label(shopBox, "", { Font = Ui.TITLE, TextSize = 24, TextColor3 = Ui.C.gold, Size = UDim2.new(1, 0, 0, 30), ZIndex = 41 })
local shopRows = {}
for i, item in Rules.SHOP do
	local b = Ui.button(shopBox, "", function()
		local r = request("Buy", item)
		if r and r.ok then
			toast(T("Found_" .. item, 1), Ui.C.good, 2)
		end
	end, { LayoutOrder = i + 1, ZIndex = 41 })
	shopRows[item] = b
end
local shopClose = Ui.button(shopBox, "", function()
	shopBox.Visible = false
end, { LayoutOrder = 10, ZIndex = 41, BackgroundColor3 = Ui.C.line })
local function openShop()
	shopTitle.Text = T("Shop") .. "   " .. T("Coins", app.coins)
	for item, b in shopRows do
		b.Text = T("item_" .. item) .. "   " .. T("Price", Rules.PRICES[item])
	end
	shopClose.Text = T("Close")
	shopBox.Visible = true
end

-- ---------------------------------------------------------------------------
-- сообщения сервера

Remotes.event("Game").OnClientEvent:Connect(function(msg)
	if msg.type == "toast" then
		toast(T(msg.key, table.unpack(msg.args or {})))
	elseif msg.type == "announce" then
		showBanner(T(msg.key, table.unpack(msg.args or {})), 3.5)
	elseif msg.type == "inv" then
		app.coins = msg.coins or 0
		app.inv = msg.inv or {}
		refreshInv()
		if shopBox.Visible then
			openShop()
		end
	elseif msg.type == "hum" then
		if msg.phase == "warn" then
			showBanner(T("HumWarn"), 3)
			app.shake = math.max(app.shake, 0.25)
			flashRed(0.2)
		elseif msg.phase == "rush" then
			app.shake = 1.2
		else
			app.shake = 0
		end
	elseif msg.type == "fx" then
		if msg.kind == "scare" then
			flashRed(0.6)
			app.shake = 0.6
			task.delay(0.5, function()
				app.shake = 0
			end)
		elseif msg.kind == "blood" then
			flashRed(0.75)
		end
	elseif msg.type == "ride" then
		app.shake = 0.35
		overlay.BackgroundTransparency = 0.4
		task.delay(7, function()
			app.shake = 0
			TweenService:Create(overlay, TweenInfo.new(1), { BackgroundTransparency = 1 }):Play()
		end)
	elseif msg.type == "dead" then
		onDead(msg)
	elseif msg.type == "results" then
		showBanner(T("Results", msg.door or 0), 6)
	elseif msg.type == "shop" then
		openShop()
	end
end)

-- ---------------------------------------------------------------------------
-- меню

local menu = Ui.frame(gui, { BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.35, Size = UDim2.fromScale(1, 1), ZIndex = 50 })
local menuCol = Ui.frame(menu, { BackgroundTransparency = 1, Size = UDim2.fromOffset(300, 420), Position = UDim2.new(0.5, -150, 0.5, -210), ZIndex = 51 })
Ui.list(menuCol, 10)
local sheet = Ui.frame(gui, { BackgroundTransparency = 0.05, Size = UDim2.fromOffset(340, 360), Position = UDim2.new(0.5, -170, 0.5, -180), Visible = false, ZIndex = 60 })
Ui.corner(sheet, 10)
Ui.pad(sheet, 14)

local buildMenu
local function openHelp()
	sheet:ClearAllChildren()
	Ui.corner(sheet, 10)
	Ui.pad(sheet, 14)
	Ui.list(sheet, 8)
	local page = 1
	local head = Ui.label(sheet, "", { Font = Ui.TITLE, TextSize = 26, TextColor3 = Ui.C.gold, Size = UDim2.new(1, 0, 0, 34), LayoutOrder = 1, ZIndex = 61 })
	local body = Ui.label(sheet, "", { TextSize = 17, Size = UDim2.new(1, 0, 0, 200), LayoutOrder = 2, ZIndex = 61, TextYAlignment = Enum.TextYAlignment.Top })
	local function show()
		head.Text = T("H" .. page .. "t")
		body.Text = T("H" .. page) .. "\n\n" .. page .. " / 6"
	end
	local row = Ui.frame(sheet, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 46), LayoutOrder = 3, ZIndex = 61 })
	Ui.button(row, T("Back"), function()
		if page == 1 then
			sheet.Visible = false
		else
			page -= 1
			show()
		end
	end, { Size = UDim2.new(0.5, -4, 1, 0), ZIndex = 62 })
	Ui.button(row, T("Next"), function()
		if page == 6 then
			sheet.Visible = false
		else
			page += 1
			show()
		end
	end, { Size = UDim2.new(0.5, -4, 1, 0), Position = UDim2.new(0.5, 4, 0, 0), ZIndex = 62, BackgroundColor3 = Ui.C.line })
	show()
	sheet.Visible = true
end

local function openSettings()
	sheet:ClearAllChildren()
	Ui.corner(sheet, 10)
	Ui.pad(sheet, 14)
	Ui.list(sheet, 10)
	Ui.label(sheet, T("Settings"), { Font = Ui.TITLE, TextSize = 26, TextColor3 = Ui.C.gold, Size = UDim2.new(1, 0, 0, 34), ZIndex = 61, LayoutOrder = 1 })
	Ui.label(sheet, T("Language"), { ZIndex = 61, LayoutOrder = 2 })
	local langRow = Ui.frame(sheet, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 46), ZIndex = 61, LayoutOrder = 3 })
	for i, l in { "en", "ru" } do
		Ui.button(langRow, string.upper(l), function()
			app.lang = l
			localizeAll()
			refreshInv()
			refreshTop()
			refreshBars()
			refreshButtons()
			buildMenu()
			openSettings()
		end, { Size = UDim2.new(0.5, -4, 1, 0), Position = UDim2.new((i - 1) * 0.5, (i - 1) * 4, 0, 0), ZIndex = 62, BackgroundColor3 = if app.lang == l then Ui.C.line else Ui.C.panel })
	end
	Ui.label(sheet, T("Shadows"), { ZIndex = 61, LayoutOrder = 4 })
	Ui.button(sheet, if Lighting.GlobalShadows then T("On") else T("Off"), function()
		Lighting.GlobalShadows = not Lighting.GlobalShadows
		openSettings()
	end, { ZIndex = 62, LayoutOrder = 5 })
	Ui.button(sheet, T("Close"), function()
		sheet.Visible = false
	end, { ZIndex = 62, LayoutOrder = 6, BackgroundColor3 = Ui.C.line })
	sheet.Visible = true
end

local function play()
	app.inMenu = false
	menu.Visible = false
	sheet.Visible = false
	hud.Visible = not app.dead
	request("Play")
	if not app.dead then
		firstPerson()
	end
	refreshTop()
	refreshBars()
	refreshButtons()
	refreshInv()
end

function buildMenu()
	menuCol:ClearAllChildren()
	Ui.list(menuCol, 10)
	local title = Ui.label(menuCol, T("Title"), { Font = Ui.TITLE, TextSize = 56, TextColor3 = Ui.C.gold, Size = UDim2.new(1, 0, 0, 70), ZIndex = 52, LayoutOrder = 1 })
	local st = Instance.new("UIStroke")
	st.Thickness = 2
	st.Parent = title
	Ui.label(menuCol, T("Subtitle"), { TextColor3 = Ui.C.dim, ZIndex = 52, LayoutOrder = 2 })
	local status = request("Status")
	local best = if status and status.best then status.best else 0
	Ui.label(menuCol, T("Best", best), { Font = Ui.BOLD, TextColor3 = Ui.C.gold, ZIndex = 52, LayoutOrder = 3 })
	Ui.button(menuCol, T("Play"), play, { ZIndex = 52, LayoutOrder = 4, BackgroundColor3 = Ui.C.line, TextSize = 20 })
	Ui.button(menuCol, T("HowToPlay"), openHelp, { ZIndex = 52, LayoutOrder = 5 })
	Ui.button(menuCol, T("Settings"), openSettings, { ZIndex = 52, LayoutOrder = 6 })
	local langRow = Ui.frame(menuCol, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 40), ZIndex = 52, LayoutOrder = 7 })
	for i, l in { "en", "ru" } do
		Ui.button(langRow, string.upper(l), function()
			app.lang = l
			localizeAll()
			buildMenu()
		end, { Size = UDim2.new(0.5, -4, 1, 0), Position = UDim2.new((i - 1) * 0.5, (i - 1) * 4, 0, 0), ZIndex = 53, BackgroundColor3 = if app.lang == l then Ui.C.line else Ui.C.panel })
	end
end

local menuBtn = Ui.button(hud, "≡", function()
	app.inMenu = true
	menu.Visible = true
	hud.Visible = false
	buildMenu()
end, { Size = UDim2.fromOffset(46, 40), Position = UDim2.new(1, -58, 0, 44), TextSize = 22 })
local _ = menuBtn

-- ---------------------------------------------------------------------------
-- админ-панель (только создателям)

task.spawn(function()
	local ok, res = pcall(function()
		return Remotes.fn("AdminRequest"):InvokeServer("Status")
	end)
	if not ok or not res or not res.admin then
		return
	end
	local panel = Ui.frame(gui, { BackgroundTransparency = 0.05, Size = UDim2.fromOffset(300, 420), Position = UDim2.new(1, -312, 0, 92), Visible = false, ZIndex = 70 })
	Ui.corner(panel, 10)
	local scroll = Instance.new("ScrollingFrame")
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.Size = UDim2.fromScale(1, 1)
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.CanvasSize = UDim2.new()
	scroll.ScrollBarThickness = 6
	scroll.ZIndex = 71
	scroll.Parent = panel
	Ui.pad(scroll, 8)
	Ui.list(scroll, 6)
	local function fill()
		for _, c in scroll:GetChildren() do
			if c:IsA("TextButton") then
				c:Destroy()
			end
		end
		for i, c in AdminCommands.LIST do
			Ui.button(scroll, if app.lang == "ru" then c.ru else c.en, function()
				local r = Remotes.fn("AdminRequest"):InvokeServer("Run", c.id)
				toast(if r and r.ok then T("Done") else T("Failed"), if r and r.ok then Ui.C.good else Ui.C.red, 2)
			end, { LayoutOrder = i, ZIndex = 72, Size = UDim2.new(1, -4, 0, 42), TextSize = 15 })
		end
	end
	local btn = Ui.button(gui, T("Admin"), function()
		panel.Visible = not panel.Visible
		if panel.Visible then
			fill()
		end
	end, { Size = UDim2.fromOffset(70, 32), Position = UDim2.new(1, -82, 0, 6), TextSize = 13, ZIndex = 75, TextColor3 = Ui.C.gold })
	local _ = btn
end)

-- ---------------------------------------------------------------------------
-- клавиатура: F — свет, C — тихо, 1/2/3 — батарейка, растение, свисток

UserInputService.InputBegan:Connect(function(input, processed)
	if processed or app.inMenu or app.dead then
		return
	end
	local k = input.KeyCode
	if k == Enum.KeyCode.F then
		request("Flash")
	elseif k == Enum.KeyCode.C or k == Enum.KeyCode.LeftControl then
		setSneak(not app.sneaking)
	elseif k == Enum.KeyCode.One then
		request("Use", "battery")
	elseif k == Enum.KeyCode.Two then
		request("Use", "plant")
	elseif k == Enum.KeyCode.Three then
		request("Use", "whistle")
	end
end)

-- ---------------------------------------------------------------------------
-- новый персонаж (начало забега)

local function onCharacter(char: Model)
	app.dead = false
	app.spectating = nil
	app.sneaking = false
	hiddenEye = nil
	deathBox.Visible = false
	spectBox.Visible = false
	shopBox.Visible = false
	local hum = char:WaitForChild("Humanoid", 5) :: Humanoid?
	if hum then
		camera.CameraSubject = hum
		hum.HealthChanged:Connect(function(h)
			refreshBars()
			if h &lt; (app.lastHp or 100) - 1 then
				flashRed(0.35)
			end
			app.lastHp = h
		end)
		app.lastHp = hum.Health
	end
	if not app.inMenu then
		hud.Visible = true
		firstPerson()
	end
	char.DescendantAdded:Connect(function()
		task.defer(hideHead, char)
	end)
	hideHead(char)
	refreshBars()
	refreshButtons()
end
player.CharacterAdded:Connect(onCharacter)
if player.Character then
	task.spawn(onCharacter, player.Character)
end

-- кадр: меню, шкаф, тряска, Смотритель
local watchT = 0
RunService.RenderStepped:Connect(function(dt)
	if app.inMenu then
		camera.CameraType = Enum.CameraType.Scriptable
		local t = os.clock() * 0.15
		camera.CFrame = CFrame.new(math.sin(t) * 6, 7, -6) * CFrame.Angles(0, math.sin(t * 0.7) * 0.25, 0) * CFrame.Angles(-0.08, 0, 0)
		camera.FieldOfView = 70
		return
	end
	if hiddenEye then
		camera.CameraType = Enum.CameraType.Scriptable
		camera.CFrame = hiddenEye
	elseif camera.CameraType == Enum.CameraType.Scriptable and not app.dead then
		firstPerson()
	end
	if app.shake &gt; 0 then
		local a = app.shake * 0.04
		camera.CFrame *= CFrame.Angles((math.random() - 0.5) * a, (math.random() - 0.5) * a, 0)
	end
	watchT += dt
	if watchT &gt; 0.1 then
		watchT = 0
		checkWatchers()
	end
	if app.dead and app.spectating and not app.spectating:GetAttribute("Alive") then
		spectate(1)
	end
end)

buildMenu()
localizeAll()
refreshInv()
refreshTop()
</ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000020">
          <Properties>
            <string name="Name">Ui</string>
            <ProtectedString name="Source">--!nonstrict
-- Мелкие помощники интерфейса: рамки, подписи, кнопки (крупные, удобные для пальца)

local Ui = {}

Ui.FONT = Enum.Font.Gotham
Ui.BOLD = Enum.Font.GothamBold
Ui.TITLE = Enum.Font.Antique
Ui.C = {
	panel = Color3.fromRGB(18, 16, 14),
	line = Color3.fromRGB(120, 86, 46),
	text = Color3.fromRGB(236, 226, 206),
	dim = Color3.fromRGB(160, 150, 136),
	gold = Color3.fromRGB(230, 190, 110),
	red = Color3.fromRGB(190, 40, 40),
	good = Color3.fromRGB(80, 170, 90),
}

function Ui.corner(parent, r: number?)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 8)
	c.Parent = parent
	return c
end

function Ui.frame(parent, props)
	local f = Instance.new("Frame")
	f.BorderSizePixel = 0
	f.BackgroundColor3 = Ui.C.panel
	for k, v in props or {} do
		(f :: any)[k] = v
	end
	f.Parent = parent
	return f
end

function Ui.label(parent, text: string, props)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Font = Ui.FONT
	l.TextSize = 16
	l.TextColor3 = Ui.C.text
	l.TextWrapped = true
	l.Text = text
	l.Size = UDim2.new(1, 0, 0, 24)
	for k, v in props or {} do
		(l :: any)[k] = v
	end
	l.Parent = parent
	return l
end

function Ui.button(parent, text: string, fn, props)
	local b = Instance.new("TextButton")
	b.AutoButtonColor = true
	b.BorderSizePixel = 0
	b.BackgroundColor3 = Ui.C.panel
	b.BackgroundTransparency = 0.1
	b.Font = Ui.BOLD
	b.TextSize = 17
	b.TextColor3 = Ui.C.text
	b.Text = text
	b.Size = UDim2.new(1, 0, 0, 46)
	for k, v in props or {} do
		(b :: any)[k] = v
	end
	Ui.corner(b)
	local st = Instance.new("UIStroke")
	st.Color = Ui.C.line
	st.Thickness = 1.5
	st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	st.Parent = b
	if fn then
		b.Activated:Connect(fn)
	end
	b.Parent = parent
	return b
end

function Ui.list(parent, pad: number?, horizontal: boolean?)
	local l = Instance.new("UIListLayout")
	l.Padding = UDim.new(0, pad or 8)
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.FillDirection = if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical
	l.HorizontalAlignment = Enum.HorizontalAlignment.Center
	l.Parent = parent
	return l
end

function Ui.pad(parent, px: number)
	local p = Instance.new("UIPadding")
	p.PaddingTop = UDim.new(0, px)
	p.PaddingBottom = UDim.new(0, px)
	p.PaddingLeft = UDim.new(0, px)
	p.PaddingRight = UDim.new(0, px)
	p.Parent = parent
	return p
end

function Ui.viewport(): Vector2
	local cam = workspace.CurrentCamera
	return if cam then cam.ViewportSize else Vector2.new(800, 600)
end

return Ui
</ProtectedString>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>