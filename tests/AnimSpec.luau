local Shared = game:GetService("ReplicatedStorage").Workshop.Shared
local Anim = require(Shared.Anim)
local Format = require(Shared.Format)

return function(T)
	T.suite("Anim")
	local Z = { 0, 0, 0 }
	local function clip()
		local c = Format.newClip("c1", "Ходьба")
		c.length = 2
		Anim.setKey(c, "leg", 0, Z, Z, "linear")
		Anim.setKey(c, "leg", 2, { 0, 2, 0 }, { 90, 0, 0 }, "linear")
		return c
	end
	T.test("in-between frame is interpolated", function()
		local c = clip()
		local pos, rot = Anim.sampleTrack(c.tracks.leg, 1)
		T.vnear(pos, { 0, 1, 0 })
		T.near(rot[1], 45, 1e-3)
	end)
	T.test("add, copy, move, remove keys", function()
		local c = clip()
		Anim.setKey(c, "leg", 1, { 0, 5, 0 }, Z)
		T.eq(#c.tracks.leg.keys, 3)
		T.ok(Anim.copyKey(c, "leg", 1, 1.5))
		T.eq(#c.tracks.leg.keys, 4)
		T.ok(Anim.moveKey(c, "leg", 1.5, 0.5))
		T.eq(c.tracks.leg.keys[2].t, 0.5)
		T.vnear(c.tracks.leg.keys[2].pos, { 0, 5, 0 })
		T.ok(Anim.removeKey(c, "leg", 0.5))
		T.eq(#c.tracks.leg.keys, 3)
		T.ok(not Anim.removeKey(c, "leg", 0.77))
		-- ключ в той же точке заменяется, а не дублируется
		Anim.setKey(c, "leg", 1, { 0, 6, 0 }, Z)
		T.eq(#c.tracks.leg.keys, 3)
	end)
	T.test("once and loop modes", function()
		local c = clip()
		local t, done = Anim.wrapTime(c, 2.5)
		T.eq(t, 2)
		T.ok(done)
		c.loop = true
		t, done = Anim.wrapTime(c, 2.5)
		T.near(t, 0.5)
		T.ok(not done)
	end)
	T.test("markers fire once per crossing", function()
		local c = clip()
		Anim.addMarker(c, "m1", 1, "Погасить")
		T.eq(#Anim.markersCrossed(c, 0, 0.9), 0)
		T.eq(#Anim.markersCrossed(c, 0.9, 1.1), 1)
		T.eq(#Anim.markersCrossed(c, 1.1, 1.9), 0)
		c.loop = true
		T.eq(#Anim.markersCrossed(c, 1.5, 3.2), 1, "loop crossing")
		T.eq(#Anim.markersCrossed(c, 1.5, 5.2), 2, "two loops")
	end)
	T.test("missing part track is reported and kept", function()
		local c = clip()
		Anim.setKey(c, "tail", 0, Z, Z)
		local missing = Anim.validate(c, { leg = true })
		T.eq(#missing, 1)
		T.eq(missing[1], "tail")
		T.eq(#c.tracks.tail.keys, 1, "keys of missing part are kept")
		T.eq(#Anim.validate(c, { leg = true, tail = true }), 0)
		T.ok(Anim.retarget(c, "tail", "tail2"))
		T.eq(#Anim.validate(c, { leg = true, tail2 = true }), 0)
	end)
	T.test("closet tracks are special", function()
		local c = clip()
		Anim.setKey(c, "PlayerRoot", 0, Z, Z)
		T.eq(#Anim.validate(c, { leg = true }, true), 0)
	end)
	T.test("shortening clip clamps keys", function()
		local c = clip()
		Anim.setLength(c, 1)
		T.eq(c.length, 1)
		T.eq(c.tracks.leg.keys[#c.tracks.leg.keys].t, 1)
	end)
end
