local Shared = game:GetService("ReplicatedStorage").Workshop.Shared
local Closet = require(Shared.Closet)
local MathX = require(Shared.MathX)
local Anim = require(Shared.Anim)

return function(T)
	T.suite("Closet")
	local lens = { enter = 0.9, exit = 0.8 }

	T.test("enter and exit", function()
		local c = Closet.new()
		local ok, action, token = Closet.request(c, 1, 0, lens)
		T.ok(ok)
		T.eq(action, "enter")
		T.eq(c.state, Closet.ENTERING)
		T.ok(Closet.complete(c, token, 1))
		T.eq(c.state, Closet.INSIDE)
		ok, action, token = Closet.request(c, 1, 2, lens)
		T.eq(action, "exit")
		T.ok(Closet.complete(c, token, 3))
		T.eq(c.state, Closet.FREE)
		T.eq(c.occupant, nil)
	end)

	T.test("fast double tap does not stack clips", function()
		local c = Closet.new()
		local ok1 = Closet.request(c, 1, 0, lens)
		local ok2, reason = Closet.request(c, 1, 0.05, lens)
		T.ok(ok1)
		T.ok(not ok2)
		T.eq(reason, "busy")
		T.eq(c.token, 1, "only one clip started")
	end)

	T.test("other player cannot take an occupied closet", function()
		local c = Closet.new()
		local _, _, token = Closet.request(c, 1, 0, lens)
		Closet.complete(c, token, 1)
		local ok, reason = Closet.request(c, 2, 1.5, lens)
		T.ok(not ok)
		T.eq(reason, "occupied")
	end)

	T.test("death during clip frees closet; stale completion is ignored", function()
		local c = Closet.new()
		local _, _, token = Closet.request(c, 1, 0, lens)
		local who, was = Closet.release(c, 0.3)
		T.eq(who, 1)
		T.eq(was, Closet.ENTERING)
		T.eq(c.state, Closet.FREE)
		T.ok(not Closet.complete(c, token, 0.9), "old clip callback must not change state")
		T.eq(c.state, Closet.FREE)
		local ok = Closet.request(c, 2, 1, lens)
		T.ok(ok, "free again for another player")
	end)

	T.test("watchdog detects interrupted clip", function()
		local c = Closet.new()
		Closet.request(c, 1, 0, lens)
		T.ok(not Closet.isStuck(c, 1))
		T.ok(Closet.isStuck(c, 3.5))
	end)

	T.test("points are relative and follow rotation", function()
		local role = Closet.newRole(3)
		-- шкаф без поворота: вход перед шкафом по -Z
		local w0 = Closet.worldPose({ 0, 0, 0 }, { 0, 0, 0 }, role.entry)
		T.vnear(w0.p, { 0, 0, -3.5 })
		-- шкаф повёрнут на 90 и сдвинут: вход переехал вместе с ним
		local w1 = Closet.worldPose({ 10, 0, 5 }, { 0, 90, 0 }, role.entry)
		T.vnear(w1.p, { 10 - 3.5, 0, 5 })
		-- игрок у входа смотрит на шкаф при любом повороте
		for _, yaw in { 0, 90, 180, -90, 37 } do
			local w = Closet.worldPose({ 3, 0, 3 }, { 0, yaw, 0 }, role.entry)
			local look = MathX.matApply(w.m, { 0, 0, -1 })
			local toCloset = MathX.sub({ 3, 0, 3 }, w.p)
			local l = MathX.len(toCloset)
			local dot = (look[1] * toCloset[1] + look[3] * toCloset[3]) / l
			T.near(dot, 1, 1e-3, "faces closet at yaw " .. yaw)
		end
	end)

	T.test("enter clip ends inside, exit clip ends at exit point", function()
		local role = Closet.newRole(3)
		local endIn = Closet.sampleWorld({ 4, 0, 0 }, { 0, 180, 0 }, role.enterClip, role.enterClip.length)
		T.vnear(endIn.PlayerRoot.p, Closet.worldPose({ 4, 0, 0 }, { 0, 180, 0 }, role.inside).p)
		local endOut = Closet.sampleWorld({ 4, 0, 0 }, { 0, 180, 0 }, role.exitClip, role.exitClip.length)
		T.vnear(endOut.PlayerRoot.p, Closet.worldPose({ 4, 0, 0 }, { 0, 180, 0 }, role.exit).p)
		T.ok(endIn.Camera ~= nil, "camera track present")
		T.eq(#Anim.validate(role.enterClip, {}, true), 0)
	end)
end
