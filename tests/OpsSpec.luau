local Shared = game:GetService("ReplicatedStorage").Workshop.Shared
local Format = require(Shared.Format)
local Ops = require(Shared.Ops)
local Prefabs = require(Shared.Prefabs)
local Util = require(Shared.Util)

return function(T)
	T.suite("Ops")
	local function project()
		local p = Format.newProject("p", "Карта", 1)
		return p
	end
	T.test("add, move, undo, redo", function()
		local p = project()
		local h = Ops.newHistory()
		local part = Prefabs.shape(p, "Block", { 0, 0, 0 })
		local fwd = { op = "add", obj = part }
		local ok, inv = Ops.apply(p, fwd)
		T.ok(ok, tostring(inv))
		Ops.record(h, inv, fwd)
		local move = { op = "set", id = part.id, path = { "pos" }, value = { 4, 2, 0 } }
		ok, inv = Ops.apply(p, move)
		T.ok(ok)
		Ops.record(h, inv, move)
		T.eq(p.map.objects[part.id].pos[1], 4)
		T.ok(Ops.apply(p, Ops.popUndo(h)))
		T.eq(p.map.objects[part.id].pos[1], 0)
		T.ok(Ops.apply(p, Ops.popUndo(h)))
		T.eq(p.map.objects[part.id], nil)
		T.ok(Ops.apply(p, Ops.popRedo(h)))
		T.ok(Ops.apply(p, Ops.popRedo(h)))
		T.eq(p.map.objects[part.id].pos[1], 4)
	end)
	T.test("frozen blocks move and rotate but not resize", function()
		local p = project()
		local part = Prefabs.shape(p, "Block", { 0, 0, 0 })
		part.frozen = true
		T.ok(Ops.apply(p, { op = "add", obj = part }))
		local ok, err = Ops.apply(p, { op = "set", id = part.id, path = { "pos" }, value = { 1, 1, 1 } })
		T.ok(not ok)
		T.eq(err, "frozen")
		ok = Ops.apply(p, { op = "set", id = part.id, path = { "rot" }, value = { 0, 45, 0 } })
		T.ok(not ok)
		ok = Ops.apply(p, { op = "set", id = part.id, path = { "size" }, value = { 8, 1, 1 } })
		T.ok(ok, "size handles keep working")
		ok = Ops.apply(p, { op = "set", id = part.id, path = { "physics", "anchored" }, value = false })
		T.ok(ok, "physics is separate from freeze")
	end)
	T.test("invalid change is rolled back", function()
		local p = project()
		local part = Prefabs.shape(p, "Block", { 0, 0, 0 })
		T.ok(Ops.apply(p, { op = "add", obj = part }))
		local ok = Ops.apply(p, { op = "set", id = part.id, path = { "size" }, value = { -1, 1, 1 } })
		T.ok(not ok)
		T.eq(p.map.objects[part.id].size[1], 4)
		ok = Ops.apply(p, { op = "set", id = part.id, path = { "id" }, value = "x" })
		T.ok(not ok, "id is not editable")
	end)
	T.test("batch is atomic", function()
		local p = project()
		local a = Prefabs.shape(p, "Block", { 0, 0, 0 })
		local before = Util.deepCopy(p.map.objects)
		local ok = Ops.apply(p, { op = "batch", ops = {
			{ op = "add", obj = a },
			{ op = "set", id = a.id, path = { "material" }, value = "Lava" },
		} })
		T.ok(not ok)
		T.ok(Util.deepEqual(p.map.objects, before))
	end)
	T.test("latin names are unique", function()
		local p = project()
		local a = Prefabs.shape(p, "Block", { 0, 0, 0 })
		local b = Prefabs.shape(p, "Block", { 0, 0, 0 })
		a.latin = "HallLamp"
		b.latin = "Other"
		T.ok(Ops.apply(p, { op = "add", obj = a }))
		T.ok(Ops.apply(p, { op = "add", obj = b }))
		local ok, err = Ops.apply(p, { op = "set", id = b.id, path = { "latin" }, value = "HallLamp" })
		T.ok(not ok)
		T.eq(err, "latin taken")
	end)
	T.test("project settings are validated", function()
		local p = project()
		T.ok(Ops.apply(p, { op = "setProject", path = { "settings", "camera", "bob" }, value = 0 }))
		local ok = Ops.apply(p, { op = "setProject", path = { "settings", "camera", "fov" }, value = 500 })
		T.ok(not ok)
		T.eq(p.settings.camera.fov, 70)
		ok = Ops.apply(p, { op = "setProject", path = { "meta", "publishCode" }, value = "HACKED" })
		T.ok(not ok, "publish code is server-only")
	end)
end
